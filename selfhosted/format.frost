// What `frost fmt` writes, and it is what the bootstrap's `src/format.rs`
// writes, byte for byte.
//
// Which statement is on which line is the author's. A `+` at a line break
// continues the expression above it and a leading `-` opens a new statement, so
// moving a statement would say something nobody wrote.
//
// Inside a bracket holding a list there is no statement boundary, and where each
// element goes is a question of width. Those breaks are settled here: the run
// goes on one line when it fits in `WIDTH`, and otherwise the bracket opens at
// the end of a line, each element takes one of its own, and the bracket closes a
// line back at the indentation it opened at. So is the space inside a line, the
// indentation in front of it, how many blank lines may sit between two of them,
// the brace that opens a block, and the newline a file ends with.
//
// A token carries the byte range it was read from, so the gaps between one
// token's range and the next are exactly the whitespace and the comments the
// token stream drops.

import "core.frost"
import "lexer.frost"

export format_source

// What a token is doing, where the token alone does not say. `Arena<64>` holds
// the tokens of `a < b > c`, `^` is a pointer type in front of a type and a read
// behind a value, `[N]u8` is a type where `xs[i]` is an index, and `::` declares
// a name where `NodeKind::Var` reaches into a type for one.
ROLE_PLAIN :: 0
ROLE_TYPE_ARG_OPEN :: 1
ROLE_TYPE_ARG_CLOSE :: 2
ROLE_POINTER_TYPE :: 3
ROLE_TYPE_BRACKET_OPEN :: 4
ROLE_TYPE_BRACKET_CLOSE :: 5
ROLE_DECLARES :: 6

// Whether a token can end a value, which separates a read from a type and a
// subtraction from a negation.
ends_a_value :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Ident || kind == TokenKind::Int
        || kind == TokenKind::Float || kind == TokenKind::Str
        || kind == TokenKind::Rparen || kind == TokenKind::Rbracket
        || kind == TokenKind::Rbrace)
}

// Whether a token can begin a type.
begins_a_type :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Ident || kind == TokenKind::Caret
        || kind == TokenKind::Lbracket || kind == TokenKind::KwFn
        || kind == TokenKind::Dollar || kind == TokenKind::KwRef)
}

// Whether a token opens or closes a nesting level.
nesting_of :: fn(kind: TokenKind) -> i64 {
    if (kind == TokenKind::Lbrace || kind == TokenKind::Lparen
        || kind == TokenKind::Lbracket) {
        return 1
    }
    if (kind == TokenKind::Rbrace || kind == TokenKind::Rparen
        || kind == TokenKind::Rbracket) {
        return -1
    }
    0
}

// Where a token's text begins and ends in the source. A string literal records
// the range inside its quotes, and the quotes are part of what was written.
token_start :: fn(mut tokens: Arena<Token>, index: i64) -> i64 {
    token := arena_at(tokens, index)
    if (token.kind == TokenKind::Str) {
        return token.off - 1
    }
    token.off
}

token_end :: fn(mut tokens: Arena<Token>, index: i64) -> i64 {
    token := arena_at(tokens, index)
    if (token.kind == TokenKind::Str) {
        return token.off + token.len + 1
    }
    token.off + token.len
}

kind_at :: fn(mut tokens: Arena<Token>, index: i64) -> TokenKind {
    if (index < 0 || index >= tokens.count) {
        return TokenKind::Eof
    }
    arena_at(tokens, index).kind
}

// How wide a line is laid out to.
//
// The corpus was written to it by hand before anything measured it, and the
// Rust beside it is held to the same number by `rustfmt.toml`.
WIDTH :: 80

// How many elements a bracket holds, counting the commas at its top level. A
// run with one element is one expression, and where a line breaks inside it is
// the author's answer rather than a width's.
element_count :: fn(mut tokens: Arena<Token>, open: i64, close: i64) -> i64 {
    var held: i64 = 0
    var start := open + 1
    var depth: i64 = 0
    var index := open + 1
    while (index < close) {
        depth = depth + nesting_of(kind_at(tokens, index))
        if (depth == 0 && kind_at(tokens, index) == TokenKind::Comma) {
            held = held + 1
            start = index + 1
        }
        index = index + 1
    }
    if (start < close) {
        held = held + 1
    }
    held
}

// Whether every element between these braces is `name = value`, which is what a
// value written out looks like and what no block does.
//
// A comma at the top level is what says this is a list at all. Statements are
// separated by their lines, so a block has none, and without asking for one a
// `for` body opening with `at = report_run(fmt, at)` read as a field and the
// whole body was laid out as a value.
//
// What the name is spelled with is not asked. A field may be called `type`,
// which one lexer hands back as a keyword and the other as an identifier, and a
// rule reading the difference made the two lay `BufferBindingLayout` out
// differently. The second token being `=` is what says this is a field, and the
// grammar says the first is its name.
holds_fields :: fn(mut tokens: Arena<Token>, open: i64, close: i64) -> bool {
    if (element_count(tokens, open, close) < 2) {
        return false
    }
    var start := open + 1
    var depth: i64 = 0
    var index := open + 1
    while (index <= close) {
        if (index == close
            || (depth == 0 && kind_at(tokens, index) == TokenKind::Comma)) {
            if (start < index) {
                if (index <= start + 1
                    || kind_at(tokens, start + 1) != TokenKind::Assign) {
                    return false
                }
            }
            start = index + 1
        }
        if (index < close) {
            depth = depth + nesting_of(kind_at(tokens, index))
        }
        index = index + 1
    }
    true
}

// Where the bracket opened at `open` closes, when what it opens is something a
// layout may break.
//
// A list of things separated by commas is: the arguments of a call, the
// elements of an array, the fields of a value. Where each one goes is a question
// of width, and a comma says where one ends.
//
// Anything else keeps the breaks it was written with. A bracket holding one
// expression has no place to break that the author did not choose, and
// `(a == b\n    || c == d)` reads the way it does because someone decided where
// the `||` goes.
//
// A brace has the further question of whether it holds a value or a block, since
// joining two statements onto one line would say something the author did not.
// That is read off what is inside it rather than off what is in front of it,
// because `match k {` and `Point {` both have a name there.
reflowable :: fn(mut tokens: Arena<Token>, open: i64) -> i64 {
    close := matching_close(tokens, open)
    if (close < 0) {
        return -1
    }
    kind := kind_at(tokens, open)
    if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket) {
        if (element_count(tokens, open, close) > 1) {
            return close
        }
        return -1
    }
    if (kind == TokenKind::Lbrace && holds_fields(tokens, open, close)) {
        return close
    }
    -1
}

// Where the bracket opened at `open` closes.
matching_close :: fn(mut tokens: Arena<Token>, open: i64) -> i64 {
    var depth: i64 = 0
    var index := open
    while (index < tokens.count) {
        depth = depth + nesting_of(kind_at(tokens, index))
        if (depth == 0) {
            return index
        }
        index = index + 1
    }
    -1
}

// Where a run of type arguments opened at `open` closes, or -1 when the run
// holds something no type argument can be.
type_arguments_close :: fn(mut tokens: Arena<Token>, open: i64) -> i64 {
    var depth: i64 = 0
    var index := open
    while (index < tokens.count) {
        kind := kind_at(tokens, index)
        if (kind == TokenKind::Lt) {
            depth = depth + 1
        } else if (kind == TokenKind::Gt) {
            depth = depth - 1
            if (depth == 0) {
                return index
            }
        } else if (kind != TokenKind::Ident && kind != TokenKind::Int
            && kind != TokenKind::Comma && kind != TokenKind::Caret
            && kind != TokenKind::Lbracket && kind != TokenKind::Rbracket
            && kind != TokenKind::Dollar) {
            return -1
        }
        index = index + 1
    }
    -1
}

// Whether a line beginning with this token continues the line above.
continues_a_line :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Plus || kind == TokenKind::Star
        || kind == TokenKind::Slash || kind == TokenKind::Percent
        || kind == TokenKind::Andand || kind == TokenKind::Oror
        || kind == TokenKind::Dot || kind == TokenKind::Eqeq
        || kind == TokenKind::Ne || kind == TokenKind::Lt
        || kind == TokenKind::Le || kind == TokenKind::Gt
        || kind == TokenKind::Ge || kind == TokenKind::Amp
        || kind == TokenKind::Pipe
        || kind == TokenKind::Arrow || kind == TokenKind::Question)
}

// Whether a line opens a declaration, which at the top level is the only thing
// that is not a continuation of the line above.
opens_a_declaration :: fn(kind: TokenKind, next: TokenKind) -> bool {
    if (kind == TokenKind::KwImport || kind == TokenKind::KwExport
        || kind == TokenKind::KwTest) {
        return true
    }
    kind == TokenKind::Ident && next == TokenKind::Coloncolon
}

// Whether these two tokens have a space between them.
spaced :: fn(
    before: TokenKind,
    left: TokenKind,
    left_role: i64,
    right: TokenKind,
    right_role: i64
) -> bool {
    if (left == TokenKind::Coloncolon) {
        return left_role == ROLE_DECLARES
    }
    if (right == TokenKind::Coloncolon) {
        return right_role == ROLE_DECLARES
    }
    if (left_role == ROLE_TYPE_ARG_OPEN || right_role == ROLE_TYPE_ARG_OPEN
        || left_role == ROLE_TYPE_ARG_CLOSE
        || right_role == ROLE_TYPE_ARG_CLOSE) {
        if (left_role == ROLE_TYPE_ARG_CLOSE) {
            if (right == TokenKind::Lparen || right == TokenKind::Lbracket
                || right == TokenKind::Rparen || right == TokenKind::Comma
                || right == TokenKind::Semi || right == TokenKind::Colon
                || right_role == ROLE_TYPE_ARG_OPEN) {
                return false
            }
            return true
        }
        return false
    }
    if (left_role == ROLE_POINTER_TYPE) {
        return false
    }
    if (left == TokenKind::Caret && right_role != ROLE_POINTER_TYPE) {
        if (right == TokenKind::Rparen || right == TokenKind::Rbracket
            || right == TokenKind::Comma || right == TokenKind::Semi
            || right == TokenKind::Colon || right == TokenKind::Lparen
            || right == TokenKind::Lbracket || right == TokenKind::Dot) {
            return false
        }
        return true
    }
    if (right == TokenKind::Caret && right_role != ROLE_POINTER_TYPE) {
        return false
    }
    if (left_role == ROLE_TYPE_BRACKET_OPEN
        || right_role == ROLE_TYPE_BRACKET_CLOSE
        || left_role == ROLE_TYPE_BRACKET_CLOSE) {
        return right == TokenKind::Lbrace
    }
    if (right == TokenKind::Rparen || right == TokenKind::Rbracket
        || right == TokenKind::Comma || right == TokenKind::Semi
        || right == TokenKind::Colon) {
        return false
    }
    // A literal opening directly inside a bracket keeps a space, so the two
    // openers do not run together: `[ { hp = 1 }, { hp = 2 } ]`.
    if (left == TokenKind::Lparen || left == TokenKind::Lbracket) {
        return right == TokenKind::Lbrace
    }
    if (right == TokenKind::Lparen || right == TokenKind::Lbracket) {
        if (left == TokenKind::Ident || left == TokenKind::Rparen
            || left == TokenKind::Rbracket || left == TokenKind::KwFn
            || left == TokenKind::KwStruct) {
            return false
        }
        return true
    }
    if ((left == TokenKind::Minus || left == TokenKind::Bang)
        && ends_a_value(before) == false) {
        return false
    }
    // A dot binds to what is either side of it, so `a.b` and the `.Variant` that
    // takes its enum from the context are both written tight. After `case` it is
    // a pattern rather than a value, and the word and the pattern are two
    // things: `case .Circle { radius }:` is how the book writes one and how a
    // reader reads one.
    if (left == TokenKind::KwCase) {
        return true
    }
    if (left == TokenKind::Dot || right == TokenKind::Dot) {
        return false
    }
    if (left == TokenKind::Dollar) {
        return false
    }
    if (left == TokenKind::Lbrace && right == TokenKind::Rbrace) {
        return false
    }
    true
}

// The column the line holding an offset begins its text at.
line_indent_at :: fn(src: str, off: i64) -> i64 {
    var start := off
    while (start > 0 && src[start - 1] != CH_LF) {
        start = start - 1
    }
    var first := start
    while (first < off && (src[first] == CH_SPACE || src[first] == CH_TAB)) {
        first = first + 1
    }
    first - start
}

emit_spaces :: fn(count: i64) {
    var written: i64 = 0
    while (written < count) {
        emit_text(" ")
        written = written + 1
    }
}

// The one rendering of a source, written to the emit stream.
format_source :: fn(src: str, length: i64) {
    var tokens := arena_make($Token, 262144)
    tokenize(src, length, tokens)
    // The end marker is not a token of the program, and rendering it would put
    // an indent and a line after the last thing written.
    while (tokens.count > 0
        && arena_at(tokens, tokens.count - 1).kind == TokenKind::Eof) {
        tokens.count = tokens.count - 1
    }
    if (tokens.count == 0) {
        emit_trailing_comments(src, 0, length, 0)
        return
    }

    decided := decided_here(src, tokens)
    joined := joined_tokens(src, tokens)

    // Which tokens open their line, and the brace depth in front of each.
    //
    // Read off the breaks this file decides to write rather than off the ones
    // it was handed, since what it says is which `::` declares a name and that
    // is a question about the output. The two agree wherever a declaration can
    // be written, and answering it with something else would be a rule holding
    // by luck.
    var opens_line := arena_make($LocalVar, 262144)
    var index: i64 = 0
    var previous_end: i64 = 0
    var braces_before: i64 = 0
    while (index < tokens.count) {
        token := arena_at(tokens, index)
        var opens: i64 = 0
        if (index == 0
            || (breaks_in(src, previous_end, token_start(tokens, index))
                && arena_at(joined, index).name_off == 0
                && arena_at(decided, index).name_off == 0)) {
            opens = 1
        }
        if (token.kind == TokenKind::Rbrace) {
            braces_before = braces_before - 1
        }
        arena_push(
            opens_line,
            LocalVar {
                name_off = opens,
                name_len = braces_before,
                ty = 0,
                slot = 0
            }
        )
        if (token.kind == TokenKind::Lbrace) {
            braces_before = braces_before + 1
        }
        previous_end = token_end(tokens, index)
        index = index + 1
    }

    roles := settle_roles(tokens, opens_line)

    var braces: i64 = 0
    var brackets: i64 = 0
    var at: i64 = 0
    // The run of tokens waiting to be laid out, what it is indented by, and the
    // span holding the comments that sit at the end of its last line.
    var pending_from: i64 = -1
    var pending_to: i64 = 0
    var pending_indent: i64 = 0
    var trail_from: i64 = 0
    var trail_to: i64 = 0
    index = 0
    while (index < tokens.count) {
        token := arena_at(tokens, index)
        gap_from := at
        gap_to := token_start(tokens, index)
        at = token_end(tokens, index)

        var line_depth := braces
        if (nesting_of(token.kind) < 0) {
            line_depth = braces - 1
        }

        joins := arena_at(joined, index).name_off == 1
        // A comment in front of the first break in the gap sits at the end of
        // the line above rather than on one of its own.
        var rest_from := gap_from
        if (pending_from >= 0) {
            rest_from = first_break_at(src, gap_from, gap_to)
            if (rest_from > gap_from) {
                if (trail_to <= trail_from) {
                    trail_from = gap_from
                }
                trail_to = rest_from
            }
        }
        wrote_break := breaks_in(src, rest_from, gap_to)
        var starts_line: bool = index == 0
        if (wrote_break && joins == false
            && (arena_at(decided, index).name_off == 0 || pending_from < 0)) {
            starts_line = true
        }

        if (starts_line) {
            if (pending_from >= 0) {
                write_run(
                    src,
                    tokens,
                    roles,
                    joined,
                    pending_from,
                    pending_to,
                    pending_indent
                )
                emit_trailing_span(src, trail_from, trail_to)
                emit_text("\n")
                trail_from = 0
                trail_to = 0
            }
            write_between(src, rest_from, gap_to, line_depth)
            var open_braces := braces
            if (token.kind == TokenKind::Rbrace) {
                open_braces = braces - 1
            }
            var open_brackets := brackets
            if (token.kind == TokenKind::Rparen
                || token.kind == TokenKind::Rbracket) {
                open_brackets = brackets - 1
            }
            var running_on: i64 = 0
            if (open_brackets > 0) {
                running_on = open_brackets
            } else if (open_braces == 0) {
                // A brace is a block, not a line running on. Neither is a
                // bracket closing a list the declaration opened: it closes back
                // at the indentation the opener sat at, which at the top level
                // is none. Without the two on the right here, a signature broken
                // over several lines closed its parameter list one level in, and
                // formatting that again indented it further.
                closes := (token.kind == TokenKind::Rbrace
                    || token.kind == TokenKind::Lbrace
                    || token.kind == TokenKind::Rparen
                    || token.kind == TokenKind::Rbracket)
                if (closes == false
                    && opens_a_declaration(
                        token.kind,
                        kind_at(tokens, index + 1)
                    ) == false) {
                    running_on = 1
                }
            } else if (continues_a_line(token.kind)) {
                running_on = 1
            }
            var wanted := open_braces
            if (wanted < 0) {
                wanted = 0
            }
            if (running_on > 0) {
                wanted = wanted + running_on
            }
            pending_indent = wanted * 4
            pending_from = index
            pending_to = index + 1
        } else {
            pending_to = index + 1
        }
        braces = braces + brace_step(token.kind)
        brackets = brackets + bracket_step(token.kind)
        index = index + 1
    }
    if (pending_from >= 0) {
        write_run(
            src,
            tokens,
            roles,
            joined,
            pending_from,
            pending_to,
            pending_indent
        )
        emit_trailing_span(src, trail_from, trail_to)
    }
    // The line the last run sits on is ended by whatever followed it, which is
    // where the newline every file ends with comes from.
    emit_trailing_comments(src, at, length, braces)
}

// Whether the break in front of each token is one a layout decides rather than
// one the author wrote.
//
// A break inside a bracket holding a list is a layout's to make: the tokens
// either side of it are one expression and where it goes is a question of width.
// A break at the top level separates two statements, and which statement is on
// which line is the author's.
//
// A bracket holding a comment keeps every break it was written with. A comment
// says which line it belongs to and a width does not know.
decided_here :: fn(src: str, mut tokens: Arena<Token>) -> Arena<LocalVar> {
    var held := arena_make($LocalVar, 262144)
    var index: i64 = 0
    while (index < tokens.count) {
        arena_push(
            held,
            LocalVar { name_off = 0, name_len = 0, ty = 0, slot = 0 }
        )
        index = index + 1
    }
    var opens := arena_make($LocalVar, 4096)
    index = 0
    while (index < tokens.count) {
        kind := kind_at(tokens, index)
        var inside: i64 = -1
        if (opens.count > 0) {
            inside = arena_at(opens, opens.count - 1).name_off
        }
        if (inside >= 0) {
            arena_at(held, index).name_off = 1
        }
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbrace
            || kind == TokenKind::Lbracket) {
            opens_a_run := reflowable(tokens, index) >= 0
            var opened: i64 = -1
            // Inside a run already, so the whole thing travels together, and a
            // block among it is what stops that.
            if (inside >= 0 || opens_a_run) {
                opened = index
            }
            var blocked: i64 = 0
            if (inside >= 0 && opens_a_run == false) {
                blocked = 1
            }
            arena_push(
                opens,
                LocalVar {
                    name_off = opened,
                    name_len = blocked,
                    ty = 0,
                    slot = 0
                }
            )
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbrace
            || kind == TokenKind::Rbracket) {
            var closed: i64 = -1
            var was_blocked: i64 = 0
            if (opens.count > 0) {
                entry := arena_at(opens, opens.count - 1)
                closed = entry.name_off
                was_blocked = entry.name_len
                opens.count = opens.count - 1
            }
            var outer: i64 = -1
            if (opens.count > 0) {
                outer = arena_at(opens, opens.count - 1).name_off
            }
            // The bracket that closes a run belongs to that run rather than to
            // whatever holds it, so the break in front of it is the same
            // layout's to make. Read off the enclosing run instead, a literal
            // written over several lines had its closing brace on a line of its
            // own, and the run it closed was never a whole group for anything to
            // lay out.
            var decided: i64 = 0
            if (closed >= 0 || outer >= 0) {
                decided = 1
            }
            arena_at(held, index).name_off = decided
            if (closed >= 0) {
                // A comment anywhere inside puts every break back, and so does
                // a block: joining the statements of one onto a line is what a
                // layout may not do.
                var commented: bool = false
                var at := closed + 1
                while (at <= index) {
                    if (comment_in(src, token_end(tokens, at - 1), token_start(tokens, at))) {
                        commented = true
                    }
                    at = at + 1
                }
                if (commented || was_blocked == 1) {
                    at = closed + 1
                    while (at <= index) {
                        arena_at(held, at).name_off = 0
                        at = at + 1
                    }
                    // A run half of whose tokens keep their breaks is no longer
                    // a run anything can lay out, so what holds it is told.
                    if (opens.count > 0) {
                        arena_at(opens, opens.count - 1).name_len = 1
                    }
                }
            }
        }
        index = index + 1
    }
    held
}

// Which tokens sit at the end of the line above whatever they were written on.
//
// A brace that opens a block, and an `else` beside the brace that closes the arm
// above it. A comment in between keeps its own line, so the join only happens
// across whitespace. The space in front of one is what puts it there rather than
// any rule about the pair, so it is carried into the layout beside the tokens.
joined_tokens :: fn(src: str, mut tokens: Arena<Token>) -> Arena<LocalVar> {
    var held := arena_make($LocalVar, 262144)
    var index: i64 = 0
    while (index < tokens.count) {
        var joins: i64 = 0
        if (index > 0
            && comment_in(
                src,
                token_end(tokens, index - 1),
                token_start(tokens, index)
            ) == false) {
            kind := kind_at(tokens, index)
            previous := kind_at(tokens, index - 1)
            if (kind == TokenKind::Lbrace) {
                if (previous != TokenKind::Lbrace
                    && previous != TokenKind::Rbrace
                    && previous != TokenKind::Semi
                    && previous != TokenKind::Comma) {
                    joins = 1
                }
            } else if (kind == TokenKind::KwElse
                && previous == TokenKind::Rbrace) {
                joins = 1
            }
        }
        arena_push(
            held,
            LocalVar { name_off = joins, name_len = 0, ty = 0, slot = 0 }
        )
        index = index + 1
    }
    held
}

// How wide a run of tokens is on one line, spaced the way the corpus spaces
// them. Measured rather than built, since the rendering goes to the emit stream
// and the question is only whether it fits.
flat_width :: fn(
    src: str,
    mut tokens: Arena<Token>,
    mut roles: Arena<LocalVar>,
    mut joined: Arena<LocalVar>,
    from: i64,
    to: i64
) -> i64 {
    var held: i64 = 0
    var index := from
    while (index < to) {
        if (index > from) {
            var before := TokenKind::Eof
            if (index - 1 > from && index >= 2) {
                before = kind_at(tokens, index - 2)
            }
            if (arena_at(joined, index).name_off == 1
                || spaced(
                    before,
                    kind_at(tokens, index - 1),
                    role_at(roles, index - 1),
                    kind_at(tokens, index),
                    role_at(roles, index)
                )) {
                held = held + 1
            }
        }
        held = held + (token_end(tokens, index) - token_start(tokens, index))
        index = index + 1
    }
    held
}

// The same run, written out.
emit_flat :: fn(
    src: str,
    mut tokens: Arena<Token>,
    mut roles: Arena<LocalVar>,
    mut joined: Arena<LocalVar>,
    from: i64,
    to: i64
) {
    var index := from
    while (index < to) {
        if (index > from) {
            var before := TokenKind::Eof
            if (index - 1 > from && index >= 2) {
                before = kind_at(tokens, index - 2)
            }
            if (arena_at(joined, index).name_off == 1
                || spaced(
                    before,
                    kind_at(tokens, index - 1),
                    role_at(roles, index - 1),
                    kind_at(tokens, index),
                    role_at(roles, index)
                )) {
                emit_text(" ")
            }
        }
        start := token_start(tokens, index)
        emit_src(src, start, token_end(tokens, index) - start)
        index = index + 1
    }
}

// The first bracket at the top level of a run that a layout may break, or -1.
breakable_open :: fn(mut tokens: Arena<Token>, from: i64, to: i64) -> i64 {
    var depth: i64 = 0
    var index := from
    while (index < to) {
        if (depth == 0) {
            close := reflowable(tokens, index)
            if (close >= 0 && close < to) {
                return index
            }
        }
        depth = depth + nesting_of(kind_at(tokens, index))
        index = index + 1
    }
    -1
}

// A run written out at `indent`, over as many lines as it takes, with no line
// break after the last of them.
//
// One line when it fits. Otherwise the outermost bracket is opened at the end of
// a line, each of the elements inside it is written at one level further in, and
// the bracket closes a line of its own back at the indentation it opened at. An
// element too long for its own line is asked the same question again, so a call
// inside a call breaks only as far as it has to.
write_run :: fn(
    src: str,
    mut tokens: Arena<Token>,
    mut roles: Arena<LocalVar>,
    mut joined: Arena<LocalVar>,
    from: i64,
    to: i64,
    indent: i64
) {
    if (indent + flat_width(src, tokens, roles, joined, from, to) <= WIDTH) {
        emit_spaces(indent)
        emit_flat(src, tokens, roles, joined, from, to)
        return
    }
    open := breakable_open(tokens, from, to)
    if (open < 0) {
        // Nothing here opens a bracket holding a list, so there is nowhere to
        // break that the author did not write. A long run is left long rather
        // than broken somewhere it would read worse.
        emit_spaces(indent)
        emit_flat(src, tokens, roles, joined, from, to)
        return
    }
    close := reflowable(tokens, open)
    emit_spaces(indent)
    emit_flat(src, tokens, roles, joined, from, open + 1)
    emit_text("\n")
    // Each element carries the comma that ends it, so a run written over several
    // lines has exactly the commas the source had, a trailing one included.
    var start := open + 1
    var depth: i64 = 0
    var index := open + 1
    while (index < close) {
        depth = depth + nesting_of(kind_at(tokens, index))
        if (depth == 0 && kind_at(tokens, index) == TokenKind::Comma) {
            write_run(src, tokens, roles, joined, start, index + 1, indent + 4)
            emit_text("\n")
            start = index + 1
        }
        index = index + 1
    }
    if (start < close) {
        write_run(src, tokens, roles, joined, start, close, indent + 4)
        emit_text("\n")
    }
    // What follows the bracket is asked the same question, so a call written on
    // the answer of another breaks rather than running long: `f(a, b).g(c, d)`
    // puts `).g(` at the head of a line of its own. The run shrinks by at least
    // the head each time, so this settles.
    write_run(src, tokens, roles, joined, close, to, indent)
}

// Where the first line break in a span is, or the end of it when there is none.
first_break_at :: fn(src: str, from: i64, to: i64) -> i64 {
    var index := from
    while (index < to) {
        if (src[index] == CH_LF) {
            return index
        }
        index = index + 1
    }
    to
}

// Whether a comment opens at `pos`. Both spellings are one thing to a walk over
// the gaps between tokens: a run of source the formatter carries rather than
// decides.
comment_opens :: fn(src: str, pos: i64, to: i64) -> bool {
    if (pos + 1 >= to) {
        return false
    }
    if (src[pos] != CH_SLASH) {
        return false
    }
    src[pos + 1] == CH_SLASH || src[pos + 1] == CH_STAR
}

// Where the comment opening at `pos` ends. A line comment ends at its line's
// break; a block comment ends past its close, which the lexer finds the same
// way, at the first `*/`, since these do not nest.
//
// A block comment is kept whole, over as many lines as it was written across.
// Its inside is the writer's: everything the formatter settles is where a line
// starts, and re-indenting the lines inside one would be rewriting what was put
// there. Reading only `//` here left the bytes of one to the step that walks a
// character at a time and keeps nothing, so formatting a file that held one
// wrote the file back without it.
comment_ends :: fn(src: str, pos: i64, to: i64) -> i64 {
    if (pos + 1 < to && src[pos + 1] == CH_STAR) {
        var end := pos + 2
        while (end + 1 < to) {
            if (src[end] == CH_STAR && src[end + 1] == CH_SLASH) {
                return end + 2
            }
            end = end + 1
        }
        return to
    }
    var end := pos
    while (end < to && src[end] != CH_LF) {
        end = end + 1
    }
    end
}

// The comments in a span, each put at the end of the line already written.
emit_trailing_span :: fn(src: str, from: i64, to: i64) {
    var index := from
    while (index + 1 < to) {
        if (comment_opens(src, index, to)) {
            stop := comment_ends(src, index, to)
            emit_text(" ")
            emit_src(src, index, stop - index)
            index = stop
        } else {
            index = index + 1
        }
    }
}

// The blank lines and the whole-line comments between two runs.
write_between :: fn(src: str, from: i64, to: i64, line_depth: i64) {
    var breaks: i64 = 0
    var index := from
    while (index < to) {
        if (src[index] == CH_LF) {
            // One blank line between two lines, never more. Nothing in the
            // corpus separates two things by two.
            if (breaks == 1) {
                emit_text("\n")
            }
            breaks = breaks + 1
            index = index + 1
        } else if (comment_opens(src, index, to)) {
            stop := comment_ends(src, index, to)
            emit_spaces(line_depth * 4)
            emit_src(src, index, stop - index)
            emit_text("\n")
            breaks = 0
            index = stop
        } else {
            index = index + 1
        }
    }
}

brace_step :: fn(kind: TokenKind) -> i64 {
    if (kind == TokenKind::Lbrace) { return 1 }
    if (kind == TokenKind::Rbrace) { return -1 }
    0
}

bracket_step :: fn(kind: TokenKind) -> i64 {
    if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket) { return 1 }
    if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket) { return -1 }
    0
}

role_at :: fn(mut roles: Arena<LocalVar>, index: i64) -> i64 {
    if (index < 0 || index >= roles.count) {
        return ROLE_PLAIN
    }
    arena_at(roles, index).name_off
}

// The job each token is doing.
settle_roles :: fn(mut tokens: Arena<Token>, mut opens: Arena<LocalVar>)
    -> Arena<LocalVar> {
    var roles := arena_make($LocalVar, 262144)
    var index: i64 = 0
    while (index < tokens.count) {
        arena_push(
            roles,
            LocalVar { name_off = ROLE_PLAIN, name_len = 0, ty = 0, slot = 0 }
        )
        index = index + 1
    }
    index = 0
    while (index < tokens.count) {
        kind := kind_at(tokens, index)
        previous := kind_at(tokens, index - 1)
        if (kind == TokenKind::Coloncolon && index >= 1
            && arena_at(opens, index - 1).name_off == 1
            && arena_at(opens, index).name_len == 0
            && previous == TokenKind::Ident) {
            set_role(roles, index, ROLE_DECLARES)
        } else if (kind == TokenKind::Lt && previous == TokenKind::Ident) {
            close := type_arguments_close(tokens, index)
            if (close >= 0) {
                set_role(roles, index, ROLE_TYPE_ARG_OPEN)
                set_role(roles, close, ROLE_TYPE_ARG_CLOSE)
            }
        } else if (kind == TokenKind::Caret && ends_a_value(previous) == false) {
            set_role(roles, index, ROLE_POINTER_TYPE)
        } else if (kind == TokenKind::Lbracket
            && ends_a_value(previous) == false) {
            close := matching_close(tokens, index)
            if (close >= 0 && begins_a_type(kind_at(tokens, close + 1))) {
                set_role(roles, index, ROLE_TYPE_BRACKET_OPEN)
                set_role(roles, close, ROLE_TYPE_BRACKET_CLOSE)
            }
        }
        index = index + 1
    }
    roles
}

set_role :: fn(mut roles: Arena<LocalVar>, index: i64, role: i64) {
    if (index < 0 || index >= roles.count) {
        return
    }
    entry := arena_at(roles, index)
    entry.name_off = role
}

// Whether a line break sits between two offsets.
breaks_in :: fn(src: str, from: i64, to: i64) -> bool {
    var index := from
    while (index < to) {
        if (src[index] == CH_LF) {
            return true
        }
        index = index + 1
    }
    false
}

// Whether a comment sits between two offsets.
comment_in :: fn(src: str, from: i64, to: i64) -> bool {
    var index := from
    while (index + 1 < to) {
        if (comment_opens(src, index, to)) {
            return true
        }
        index = index + 1
    }
    false
}

// A brace that opens a block sits at the end of the line that says what the
// block is for, and an `else` sits beside the brace closing the arm above it.
joins_the_line_above :: fn(
    src: str,
    mut tokens: Arena<Token>,
    index: i64,
    gap_from: i64,
    gap_to: i64
) -> bool {
    if (index == 0 || comment_in(src, gap_from, gap_to)) {
        return false
    }
    if (breaks_in(src, gap_from, gap_to) == false) {
        return false
    }
    kind := kind_at(tokens, index)
    previous := kind_at(tokens, index - 1)
    if (kind == TokenKind::Lbrace) {
        return (previous != TokenKind::Lbrace && previous != TokenKind::Rbrace
            && previous != TokenKind::Semi && previous != TokenKind::Comma)
    }
    if (kind == TokenKind::KwElse) {
        return previous == TokenKind::Rbrace
    }
    false
}

// Where the line stands once a gap has been written.
GapOutcome :: struct {
    at_line_start: bool,
}

// The whitespace and the comments between two tokens: the newlines kept, one
// blank line at most, and each comment on the line it was written on.
write_gap :: fn(
    src: str,
    from: i64,
    to: i64,
    line_depth: i64,
    joins: bool,
    index: i64,
    at_line_start: bool
) -> GapOutcome {
    var outcome := GapOutcome { at_line_start = at_line_start }
    var breaks: i64 = 0
    var starting := at_line_start
    var pos := from
    while (pos < to) {
        if (src[pos] == CH_LF) {
            if (joins == false) {
                if (breaks < 2 || index == 0) {
                    emit_text("\n")
                }
                starting = true
            }
            breaks = breaks + 1
            pos = pos + 1
        } else if (comment_opens(src, pos, to)) {
            end := comment_ends(src, pos, to)
            var stop := end
            while (stop > pos
                && (src[stop - 1] == CH_SPACE || src[stop - 1] == CH_TAB
                    || src[stop - 1] == CH_CR)) {
                stop = stop - 1
            }
            if (starting) {
                emit_spaces(line_depth * 4)
            } else {
                emit_text(" ")
            }
            emit_src(src, pos, stop - pos)
            starting = false
            breaks = 0
            pos = end
        } else {
            pos = pos + 1
        }
    }
    outcome.at_line_start = starting
    outcome
}

// Whatever followed the last token, and the newline every file ends with. The
// region is walked only as far as the last comment in it, so the blank lines
// after that comment are not written and the file ends with one newline.
emit_trailing_comments :: fn(src: str, from: i64, to: i64, braces: i64) {
    stop := last_comment_end(src, from, to)
    var breaks: i64 = 0
    var starting: bool = true
    var pos := from
    while (pos < stop) {
        if (src[pos] == CH_LF) {
            if (breaks < 2) {
                emit_text("
")
            }
            breaks = breaks + 1
            starting = true
            pos = pos + 1
        } else if (comment_opens(src, pos, stop)) {
            end := comment_ends(src, pos, stop)
            var trimmed := end
            while (trimmed > pos
                && (src[trimmed - 1] == CH_SPACE || src[trimmed - 1] == CH_TAB
                    || src[trimmed - 1] == CH_CR)) {
                trimmed = trimmed - 1
            }
            if (starting) {
                emit_spaces(braces * 4)
            } else {
                emit_text(" ")
            }
            emit_src(src, pos, trimmed - pos)
            starting = false
            breaks = 0
            pos = end
        } else {
            pos = pos + 1
        }
    }
    emit_text("
")
}

// Where the last comment in a region ends, or the start of the region when it
// holds none.
last_comment_end :: fn(src: str, from: i64, to: i64) -> i64 {
    var found := from
    var pos := from
    while (pos + 1 < to) {
        if (comment_opens(src, pos, to)) {
            end := comment_ends(src, pos, to)
            found = end
            pos = end
        } else {
            pos = pos + 1
        }
    }
    found
}

// A run of source bytes, written as it stands.
emit_src :: fn(src: str, offset: i64, length: i64) {
    var index: i64 = 0
    while (index < length) {
        emit_char_of(src, offset + index)
        index = index + 1
    }
}

emit_char_of :: fn(src: str, at: i64) {
    frost_rt_emit_char(cast($i64, src[at]))
}
