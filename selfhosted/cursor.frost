// The token cursor. Everything that reads the token stream goes through here.

import "core.frost"
import "lexer.frost"

export joins_line, advance, cur, cur_len, cur_off, cur_val, on_same_line, peek_kind,
    peek_is_word, peek_off, peek_len

// Whether the token `offset` ahead is written as the given word. Reading a
// token's spelling rather than its kind is how a word that is not a keyword,
// `Type` and `value` among them, is recognized where one is expected.
peek_is_word :: fn(mut p: Parser, offset: i64, word: ^i8) -> bool {
    index := p.ti + offset
    if (index >= p.tokens.count) {
        return false
    }
    token := arena_at(p.tokens, index)
    str_range_eq(p.src, token.off, token.len, word)
}

peek_kind :: fn(mut p: Parser, offset: i64) -> TokenKind {
    index := p.ti + offset
    if (index >= p.tokens.count) {
        return TokenKind::Eof
    }
    arena_at(p.tokens, index).kind
}

// The source range of the token `offset` ahead, for a construct decided by
// looking at several tokens at once rather than by consuming them.
peek_off :: fn(mut p: Parser, offset: i64) -> i64 {
    index := p.ti + offset
    if (index >= p.tokens.count) {
        return 0
    }
    arena_at(p.tokens, index).off
}

peek_len :: fn(mut p: Parser, offset: i64) -> i64 {
    index := p.ti + offset
    if (index >= p.tokens.count) {
        return 0
    }
    arena_at(p.tokens, index).len
}

cur :: fn(mut p: Parser) -> TokenKind {
    peek_kind(p, 0)
}

cur_off :: fn(mut p: Parser) -> i64 {
    arena_at(p.tokens, p.ti).off
}

cur_len :: fn(mut p: Parser) -> i64 {
    arena_at(p.tokens, p.ti).len
}

cur_val :: fn(mut p: Parser) -> i64 {
    arena_at(p.tokens, p.ti).value
}

advance :: fn(mut p: Parser) {
    kind := cur(p)
    if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket) {
        p.bracket_depth = p.bracket_depth + 1
    }
    if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket) {
        p.bracket_depth = p.bracket_depth - 1
    }
    p.ti = p.ti + 1
}

// Whether an operator here joins the line above. A line break ends a statement,
// so it joins nothing, unless a bracket is open where a break says nothing.
joins_line :: fn(mut p: Parser) -> bool {
    on_same_line(p) || p.bracket_depth > 0
}

// Whether the token here began on the line the one before it ended on. A `(` or
// a `[` that opens a line is the start of a statement rather than a call or an
// index of what came before it, so
//
//     table := vec_slice($Table, world.tables)[slot.table]
//     (table.mask & mask) != 0
//
// is two statements. Without this the second line reads as calling the first,
// which fails with the parenthesis blamed on a struct.
on_same_line :: fn(mut p: Parser) -> bool {
    if (p.ti == 0) {
        return true
    }
    before := arena_at(p.tokens, p.ti - 1)
    here := arena_at(p.tokens, p.ti)
    var at := before.off + before.len
    while (at < here.off) {
        if (p.src[at] == 10) {
            return false
        }
        at = at + 1
    }
    true
}

// --------------------------------------------------------------------------- // Symbol tables. Identifiers are byte ranges into the source, interned to small // integer indices by comparing bytes. Locals reset per function. Functions are // global. // ---------------------------------------------------------------------------
// --------------------------------------------------------------------------- // Imports. `import "path"` names a file whose declarations join this one's. // Every file's text reaches one buffer, so a name stays what it is everywhere // else in this compiler, an offset and a length into a single source, and the // rest of the compiler never learns that more than one file was involved. // // A file lands in the buffer once however many times it is named, which is what // separates this from a textual include. The second `import` of a file is a // reference to what is already there, not a second copy. Imports are found by // token rather than by scanning the text, so the word `import` inside a string // or a comment is not one. // ---------------------------------------------------------------------------
