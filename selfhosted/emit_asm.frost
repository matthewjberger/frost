// The x86-64 backend: assembly straight from the AST, with its own frames,
// register use and calling convention.

import "core.frost"
import "imports.frost"
import "names.frost"
import "types.frost"
import "parser.frost"
import "emit.frost"
import "layout.frost"

export count_args, count_type_args, count_params, emit_asm_program, unit_owns,
    unit_owns_generic

// Emitting assembly a fragment at a time is noisy, so these write one line:
// `asm` for a plain instruction, `asm_i` for one carrying a number.
asm :: fn(text: str) {
    emit_text("    ")
    emit_text(text)
    emit_text("\n")
}

asm_i :: fn(before: str, value: i64, after: str) {
    emit_text("    ")
    emit_text(before)
    frost_rt_emit_int(value)
    emit_text(after)
    emit_text("\n")
}

abi_arg_regs :: fn(mut p: Parser) -> i64 {
    if (p.abi_windows == 1) {
        return 4
    }
    6
}

abi_shadow :: fn(mut p: Parser) -> i64 {
    if (p.abi_windows == 1) {
        return 32
    }
    0
}

// The bytes reserved below the locals, for the outgoing-argument shadow area a
// call needs and for the alignment the ABI asks of the stack pointer.
ASM_FRAME_PAD :: 64

// The name a function's frame size is written down under. The size is not known
// until the body has been emitted, since a local is recorded as it is reached,
// so the prologue names a symbol and the body is followed by its `.set`. The
// assembler resolves an absolute symbol defined later in the same file, which
// is what lets one streaming pass emit both.
emit_frame_symbol :: fn(mut p: Parser) {
    emit_text("__frost_frame_")
    frost_rt_emit_int(p.frame_id)
}

// Copy a struct. Both addresses arrive in registers. Sixteen bytes travel in
// one register and so in one instruction each way, which is half what moving
// them a word at a time costs, and the odd word at the end goes the old way.
// The wide move does not ask for an aligned address, and a struct's is
// whatever the frame or the allocator gave it.
//
// The register it travels in is only ever live inside this loop: a float
// reaches an SSE register for the arithmetic itself and leaves in %rax, so
// nothing of a program's is held there across a copy.
// The tail is moved in the widest piece that still fits, down to a byte. It
// used to finish with whole words whatever was left, so a four-byte struct was
// copied as eight and wrote four bytes past whatever it was copied into. A
// struct of that size sitting in a heap block ends one element short of the
// end, so the write went off the end of the block, and whether that was noticed
// depended on where the allocator had put it.
emit_asm_copy :: fn(size: i64) {
    mut moved: i64 = 0
    while (size - moved >= 16) {
        asm_i("movups ", moved, "(%r11), %xmm0")
        asm_i("movups %xmm0, ", moved, "(%r10)")
        moved = moved + 16
    }
    while (size - moved >= 8) {
        asm_i("movq ", moved, "(%r11), %rax")
        asm_i("movq %rax, ", moved, "(%r10)")
        moved = moved + 8
    }
    while (size - moved >= 4) {
        asm_i("movl ", moved, "(%r11), %eax")
        asm_i("movl %eax, ", moved, "(%r10)")
        moved = moved + 4
    }
    while (size - moved >= 2) {
        asm_i("movw ", moved, "(%r11), %ax")
        asm_i("movw %ax, ", moved, "(%r10)")
        moved = moved + 2
    }
    while (moved < size) {
        asm_i("movb ", moved, "(%r11), %al")
        asm_i("movb %al, ", moved, "(%r10)")
        moved = moved + 1
    }
}

// Zero `size` bytes at the address in %r10, a word at a time, the way
// emit_asm_copy moves them. Used to build a zeroed columns container for
// `columns_new()`.
emit_asm_zero :: fn(size: i64) {
    asm("xorq %rax, %rax")
    mut cleared: i64 = 0
    while (size - cleared >= 8) {
        asm_i("movq %rax, ", cleared, "(%r10)")
        cleared = cleared + 8
    }
    while (size - cleared >= 4) {
        asm_i("movl %eax, ", cleared, "(%r10)")
        cleared = cleared + 4
    }
    while (size - cleared >= 2) {
        asm_i("movw %ax, ", cleared, "(%r10)")
        cleared = cleared + 2
    }
    while (cleared < size) {
        asm_i("movb %al, ", cleared, "(%r10)")
        cleared = cleared + 1
    }
}

// ---------------------------------------------------------------------------
// What a register may hold
//
// Keeping a name's value in a register rather than reading its slot each time
// is only sound for a name nothing else can reach. Three routes reach one:
//
//   - its address is taken, by `ptr_to` or by a parameter that borrows what it
//     is given, so a store through that address moves the value with nothing
//     here to see it;
//   - it is a borrow itself, a `mut` parameter or a `ref` binding, where the
//     slot holds an address and the name's value is that address. Reading the
//     name is a load of the pointer and reading through it is a second load, so
//     a register holding "the value of the name" holds the wrong one of the two;
//   - it is written as a place rather than read as a value, where what the
//     emitter wants is the slot's own address.
//
// The walk below pins on all three and on any shape it has no rule for, so an
// unrecognised one keeps its names in memory. What survives is a plain scalar
// the body only reads and assigns by name, and `reads` counts those reads so a
// name used once is left alone.
// ---------------------------------------------------------------------------

// The entry for a name, made on first sight.
asm_name_at :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.asm_names.count) {
        entry := arena_at(p.asm_names, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
        i = i + 1
    }
    arena_push(
        p.asm_names,
        AsmName {
            name_off = off,
            name_len = len,
            reads = 0,
            pinned = 0,
            writes = 0,
            binds = 0,
            ty = TY_VOID,
            weight = 0,
            reg = 0
        }
    )
    p.asm_names.count - 1
}

// What one access is worth where the scan is standing. A loop runs its body
// more than once and a loop inside a loop more again, so an access under one
// counts for more than an access beside it. Ten a level, and no further after
// three, since past that the number only says which of two hot names is hotter
// and a wider one buys nothing.
asm_weight_here :: fn(mut p: Parser) -> i64 {
    if (p.asm_loop_depth <= 0) {
        return 1
    }
    if (p.asm_loop_depth == 1) {
        return 10
    }
    if (p.asm_loop_depth == 2) {
        return 100
    }
    1000
}

// The name is bound here, with this type. A second binding of the same spelling
// is a second local, and nothing downstream tells the two apart, so both go to
// memory.
asm_bind :: fn(mut p: Parser, off: i64, len: i64, ty: i64) {
    at := asm_name_at(p, off, len)
    held := arena_at(p.asm_names, at)
    weight := asm_weight_here(p)
    held.ty = ty
    held.binds = held.binds + 1
    held.writes = held.writes + 1
    held.weight = held.weight + weight
    if (held.binds > 1) {
        held.pinned = 1
    }
}

asm_write :: fn(mut p: Parser, off: i64, len: i64) {
    weight := asm_weight_here(p)
    at := asm_name_at(p, off, len)
    held := arena_at(p.asm_names, at)
    held.writes = held.writes + 1
    held.weight = held.weight + weight
}

asm_pin :: fn(mut p: Parser, off: i64, len: i64) {
    at := asm_name_at(p, off, len)
    held := arena_at(p.asm_names, at)
    held.pinned = 1
}

asm_read :: fn(mut p: Parser, off: i64, len: i64) {
    weight := asm_weight_here(p)
    at := asm_name_at(p, off, len)
    held := arena_at(p.asm_names, at)
    held.reads = held.reads + 1
    held.weight = held.weight + weight
}

// One expression. `place` says the emitter wants where this expression lives
// rather than what it holds, which is what `emit_asm_addr` is called for.
asm_scan_expr :: fn(mut p: Parser, id: i64, place: bool) {
    if (id == (-1)) {
        return
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        if (place) {
            asm_pin(p, node.val, node.c)
        } else {
            asm_read(p, node.val, node.c)
        }
        return
    }
    // The address of something is that something as a place. `ptr_to` of a
    // borrow is the address the borrow carries, which is a value read, but the
    // name is handed out either way and pinning it costs one load.
    if (kind == NodeKind::AddrOf || kind == NodeKind::Ref) {
        asm_scan_expr(p, node.a, true)
        return
    }
    // A field or an index reaches its base's storage. A pointer base holds the
    // address rather than being one, so reading it is a value read, but the
    // base counts as a place either way, which costs one load of a pointer.
    if (kind == NodeKind::Field || kind == NodeKind::Index) {
        asm_scan_expr(p, node.a, true)
        if (kind == NodeKind::Index) {
            asm_scan_expr(p, node.b, false)
        }
        return
    }
    if (kind == NodeKind::Deref || kind == NodeKind::Cast
        || kind == NodeKind::PtrCast || kind == NodeKind::SliceLen
        || kind == NodeKind::TrailingZeros
        || kind == NodeKind::Assert) {
        asm_scan_expr(p, node.a, false)
        return
    }
    if (kind == NodeKind::Bin || kind == NodeKind::SliceFrom) {
        asm_scan_expr(p, node.a, false)
        asm_scan_expr(p, node.b, false)
        return
    }
    if (kind == NodeKind::Call) {
        asm_scan_args(p, node.a, node.val)
        return
    }
    if (kind == NodeKind::CallPtr) {
        asm_scan_expr(p, node.a, false)
        asm_scan_args(p, node.b, -1)
        return
    }
    // Every initialiser of a literal, whichever kind of literal it is.
    if (kind == NodeKind::StructLit || kind == NodeKind::ArrayLit) {
        mut entry := node.a
        while (entry != (-1)) {
            enode := arena_at(p.arena, entry)
            asm_scan_expr(p, enode.a, false)
            entry = enode.next
        }
        return
    }
    if (kind == NodeKind::Num || kind == NodeKind::StrLit
        || kind == NodeKind::Float || kind == NodeKind::Sizeof
        || kind == NodeKind::Alignof || kind == NodeKind::TypeVal) {
        return
    }
    // A shape this walk does not read pins every name under it, which is what
    // keeps a form added later from being quietly cached.
    asm_scan_unknown(p, id)
}

// One call's arguments. A parameter that borrows what it is given takes the
// address of its argument, so such an argument is a place however it is written.
asm_scan_args :: fn(mut p: Parser, args: i64, fn_index: i64) {
    mut params: i64 = -1
    if (fn_index >= 0) {
        params = instance_params(p, fn_index, args)
        if (params == (-1)) {
            sym := arena_at(p.fns, fn_index)
            params = sym.params
        }
    }
    mut index: i64 = 0
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            mut borrows: bool = params < 0
            if (params >= 0) {
                borrows = nth_param_auto_borrows(p, params, index)
            }
            asm_scan_expr(p, value, borrows)
            index = index + 1
        }
        id = next_id
    }
}

// Every name under a node the walk has no rule for, pinned. The children are
// reached through the fields a node can hold rather than through its kind,
// since the point is to cover a kind nothing here names.
asm_scan_unknown :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Var) {
        asm_pin(p, node.val, node.c)
        return
    }
    mut i: i64 = 0
    while (i < 4) {
        mut child: i64 = node.a
        if (i == 1) { child = node.b }
        if (i == 2) { child = node.c }
        if (i == 3) { child = node.val }
        // A field is an index into the node arena only when it names one, and
        // nothing here can tell that apart from a number that happens to be in
        // range. Pinning the names under whatever it reaches is safe in the
        // direction that matters: it can only pin more.
        if (child >= 0 && child < p.arena.count) {
            reached := arena_at(p.arena, child)
            if (reached.kind == NodeKind::Var) {
                asm_pin(p, reached.val, reached.c)
            }
        }
        i = i + 1
    }
}

// One statement, and everything under it.
asm_scan_stmt :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Let) {
        asm_scan_expr(p, node.a, false)
        // A name bound to an aggregate lives in memory whatever else is true of
        // it, since naming one answers with its address.
        mut ty := node.b
        if (ty == (-1)) {
            ty = binding_type(p, node.a)
        }
        // The same record the emitter makes at the same point, so a name the
        // scan asks the type of is one it has already seen bound. The table is
        // put back before anything is emitted.
        record_local(p, node.val, node.c, ty)
        asm_bind(p, node.val, node.c, ty)
        if (is_aggregate(ty) || is_borrow(ty)) {
            asm_pin(p, node.val, node.c)
        }
        return
    }
    if (kind == NodeKind::Assign) {
        asm_scan_expr(p, node.b, false)
        // The left side of an assignment is a place. A bare name assigned to is
        // still a name a register could hold, so it is counted as written
        // rather than pinned; anything else reaches storage and pins what it
        // reaches.
        place := arena_at(p.arena, node.a)
        if (place.kind == NodeKind::Var) {
            asm_write(p, place.val, place.c)
        } else {
            asm_scan_expr(p, node.a, true)
        }
        return
    }
    if (kind == NodeKind::Return) {
        p.asm_returns = p.asm_returns + 1
        asm_scan_expr(p, node.a, false)
        return
    }
    if (kind == NodeKind::ExprStmt) {
        asm_scan_expr(p, node.a, false)
        return
    }
    if (kind == NodeKind::If) {
        asm_scan_expr(p, node.a, false)
        asm_scan_block(p, node.b)
        asm_scan_block(p, node.val)
        return
    }
    if (kind == NodeKind::While) {
        // The step, the condition and the body all run once a turn, so all
        // three count as being inside the loop.
        p.asm_loop_depth = p.asm_loop_depth + 1
        asm_scan_block(p, node.c)
        asm_scan_expr(p, node.a, false)
        asm_scan_block(p, node.b)
        p.asm_loop_depth = p.asm_loop_depth - 1
        return
    }
    if (kind == NodeKind::Match) {
        asm_scan_expr(p, node.a, false)
        mut cid := node.b
        while (cid != (-1)) {
            cnode := arena_at(p.arena, cid)
            asm_scan_block(p, cnode.a)
            cid = cnode.next
        }
        return
    }
    // A `with` block names the provider it supplies, and a call inside takes
    // its address, so the name is a place for as long as the block lasts.
    if (kind == NodeKind::With) {
        asm_pin(p, node.val, node.c)
        asm_scan_block(p, node.a)
        return
    }
    if (kind == NodeKind::Break || kind == NodeKind::Continue) {
        return
    }
    asm_scan_unknown(p, id)
}

asm_scan_block :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        asm_scan_stmt(p, id)
        id = next_id
    }
}

// The scan for one function: its parameters, then its body. A parameter that is
// a borrow or an aggregate is pinned on sight, since its slot holds an address
// the body reads through.
//
// The walk binds names as it meets them, the way the emitter does and in the
// same order, so asking a name's type answers what it will answer during
// emission. The table and the frame it grew are put back at the end, and what
// is left is the answer about each name.
asm_scan_function :: fn(mut p: Parser, body: i64, params: i64) {
    p.asm_names.count = 0
    p.locals.count = 0
    p.frame_used = 0
    // One exit for the body running off its end, which every function has
    // whether or not it also returns from inside.
    p.asm_returns = 1
    mut pid := params
    while (pid != (-1)) {
        pnode := arena_at(p.arena, pid)
        ptype := pnode.b
        record_local(p, pnode.val, pnode.c, ptype)
        asm_bind(p, pnode.val, pnode.c, ptype)
        if (is_aggregate(ptype) || is_borrow(ptype)) {
            asm_pin(p, pnode.val, pnode.c)
        }
        pid = pnode.next
    }
    asm_scan_block(p, body)
    p.locals.count = 0
    p.frame_used = 0
    asm_allocate(p)
}

// ---------------------------------------------------------------------------
// The five registers
//
// %rbx, %r12, %r13, %r14 and %r15 are the ones this backend emits nothing else
// into, and the convention says a call leaves them as it found them, so a name
// living in one crosses a call without being written anywhere. They have to be
// put back before the function returns, which is what they cost: one store on
// the way in and one load at every exit.
//
// A name earns one when the accesses it saves outnumber that. Everything the
// scan pinned is out, and so is anything narrower than a register, since the
// register would then hold something the slot does not.
// ---------------------------------------------------------------------------

ASM_REGS_AVAILABLE :: 5

emit_asm_saved_reg :: fn(index: i64) {
    if (index == 0) { emit_text("%rbx") return }
    if (index == 1) { emit_text("%r12") return }
    if (index == 2) { emit_text("%r13") return }
    if (index == 3) { emit_text("%r14") return }
    emit_text("%r15")
}

// Whether a name of this type can live in one. A borrow holds an address the
// body reads through, an aggregate is reached by its address, a float travels
// in an SSE register for its arithmetic, and a proc is loaded from its slot by
// the call that goes through it. What is left is a whole-register integer or
// pointer, where the register holds exactly what the slot would.
asm_type_fits_register :: fn(mut p: Parser, ty: i64) -> bool {
    if (ty == TY_VOID || is_aggregate(ty) || is_borrow(ty) || is_float(ty)
        || is_proc(ty)) {
        return false
    }
    scalar_size(ty) == 8
}

// Which names take the registers. The ones with most to gain go first, and the
// gain has to clear what the register costs: one store entering the function
// and one load at each exit.
asm_allocate :: fn(mut p: Parser) {
    p.asm_save_base = -1
    p.asm_saved = 0
    // What a register costs, counted the way the gain is: one store entering
    // the function and one load at each exit, none of them inside a loop.
    cost := 1 + p.asm_returns
    mut taken: i64 = 0
    while (taken < ASM_REGS_AVAILABLE) {
        mut best: i64 = -1
        mut best_gain: i64 = 0
        mut i: i64 = 0
        while (i < p.asm_names.count) {
            entry := arena_at(p.asm_names, i)
            if (entry.pinned == 0 && entry.reg == 0 && entry.weight > cost
                && entry.weight > best_gain
                && asm_type_fits_register(p, entry.ty)) {
                best = i
                best_gain = entry.weight
            }
            i = i + 1
        }
        if (best < 0) {
            return
        }
        held := arena_at(p.asm_names, best)
        held.reg = taken + 1
        taken = taken + 1
        p.asm_saved = taken
    }
}

// Which register holds the name, or 0 for one that lives in its slot. Asked at
// every mention of a name, so it answers 0 without a search when the function
// took no registers at all.
asm_reg_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    if (p.asm_saved == 0) {
        return 0
    }
    mut i: i64 = 0
    while (i < p.asm_names.count) {
        entry := arena_at(p.asm_names, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.reg
        }
        i = i + 1
    }
    0
}

// The registers this function took, put where it keeps them, and read back. The
// slots are one run, so the prologue and every exit walk the same ground.
emit_asm_save_registers :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.asm_saved) {
        emit_text("    movq ")
        emit_asm_saved_reg(i)
        emit_text(", ")
        frost_rt_emit_int(p.asm_save_base + 8 * i)
        emit_text("(%rbp)\n")
        i = i + 1
    }
}

emit_asm_restore_registers :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.asm_saved) {
        emit_text("    movq ")
        frost_rt_emit_int(p.asm_save_base + 8 * i)
        emit_text("(%rbp), ")
        emit_asm_saved_reg(i)
        emit_text("\n")
        i = i + 1
    }
}

// Where an incoming parameter lands: the register the function is holding it
// in, or its slot. A parameter arrives in a register already, so one that is
// held never reaches memory at all.
emit_asm_home :: fn(mut p: Parser, home: i64, slot: i64) {
    if (home > 0) {
        emit_asm_saved_reg(home - 1)
        return
    }
    frost_rt_emit_int(slot)
    emit_text("(%rbp)")
}

// Leaving the function: whatever it borrowed goes back first.
emit_asm_leave :: fn(mut p: Parser) {
    emit_asm_restore_registers(p)
    asm("leave")
    asm("ret")
}

// What the scan found, written into the assembly as comments, so the sets can
// be read against a function rather than trusted. FROST_ASM_NAMES asks for it.
emit_asm_names :: fn(mut p: Parser) {
    if (p.asm_debug_names != 1) {
        return
    }
    mut i: i64 = 0
    while (i < p.asm_names.count) {
        entry := arena_at(p.asm_names, i)
        emit_text("# name ")
        emit_source(p.src, entry.name_off, entry.name_len)
        if (entry.pinned == 1) {
            emit_text(" pinned")
        } else {
            emit_text(" free")
        }
        emit_text(", reads ")
        frost_rt_emit_int(entry.reads)
        emit_text(", writes ")
        frost_rt_emit_int(entry.writes)
        if (entry.reg > 0) {
            emit_text(", in ")
            emit_asm_saved_reg(entry.reg - 1)
        }
        emit_text("\n")
        i = i + 1
    }
}

new_label :: fn(mut p: Parser) -> i64 {
    id := p.label_id
    p.label_id = id + 1
    id
}

emit_label :: fn(name: str, id: i64) {
    emit_text(name)
    frost_rt_emit_int(id)
}

// Locals are laid end to end from the top of the frame down, so a local sits
// past everything recorded before it. A rebound name takes the slot of its most
// recent binding, matching lookup_local, so the two bindings stay distinct.
// Where a name sits in the frame. Recorded with the local, so this is a search
// for the name and nothing more. The most recent binding wins, which is what
// walking backwards answers with first.
local_slot :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.slot
        }
    }
    -8
}

// Load a scalar into %rax from `slot(base)`, where `base` closes the address
// and opens the destination, as in "(%rbp), ". A narrow type is widened to the
// whole register by its own signedness, so the comparison or the arithmetic
// that follows reads the value the source meant rather than the bits beside it.
emit_asm_load_from :: fn(mut p: Parser, ty: i64, slot: i64, base: str) {
    emit_asm_load_into(p, ty, slot, base, "%rax", "%eax")
}

// The same load into a register the caller names, so the widths are described
// once however many registers a value is loaded into. `wide` is the whole
// register and `narrow` its low 32 bits, which a zero extension writes instead.
emit_asm_load_into :: fn(
    mut p: Parser,
    ty: i64,
    slot: i64,
    base: str,
    wide: str,
    narrow: str
) {
    size := scalar_size(ty)
    mut op: str = "movq "
    mut destination: str = wide
    if (size == 1) {
        op = "movsbq "
        if (is_unsigned(ty)) { op = "movzbq " }
    } else if (size == 2) {
        op = "movswq "
        if (is_unsigned(ty)) { op = "movzwq " }
    } else if (size == 4) {
        op = "movslq "
        // Writing the 32-bit register clears the rest of the 64-bit one, so
        // this is the zero extension rather than an instruction short of it.
        // An f32 takes the same path: its bits are a pattern rather than a
        // number, and extending them by sign would be meaningless.
        if (is_unsigned(ty) || is_float(ty)) {
            op = "movl "
            destination = narrow
        }
    }
    emit_text("    ")
    emit_text(op)
    frost_rt_emit_int(slot)
    emit_text(base)
    emit_text(destination)
    emit_text("\n")
}

// Store %r11 into `slot(base)`, as wide as the place is rather than as wide as
// the register, so a narrow field does not write over the one beside it.
emit_asm_store_to :: fn(mut p: Parser, ty: i64, slot: i64, base: str) {
    size := scalar_size(ty)
    mut op: str = "movq %r11, "
    if (size == 1) {
        op = "movb %r11b, "
    } else if (size == 2) {
        op = "movw %r11w, "
    } else if (size == 4) {
        op = "movl %r11d, "
    }
    emit_text("    ")
    emit_text(op)
    frost_rt_emit_int(slot)
    emit_text(base)
    emit_text("\n")
}

// The same store, out of %rax, which is where every value this backend produces
// already sits. The widths are the register's own low parts, the same rule as
// above.
emit_asm_store_rax_to :: fn(mut p: Parser, ty: i64, slot: i64, base: str) {
    size := scalar_size(ty)
    mut op: str = "movq %rax, "
    if (size == 1) {
        op = "movb %al, "
    } else if (size == 2) {
        op = "movw %ax, "
    } else if (size == 4) {
        op = "movl %eax, "
    }
    emit_text("    ")
    emit_text(op)
    frost_rt_emit_int(slot)
    emit_text(base)
    emit_text("\n")
}

// One two-operand instruction, written out.
emit_asm_move :: fn(op: str, from: str, to: str) {
    emit_text("    ")
    emit_text(op)
    emit_text(" ")
    emit_text(from)
    emit_text(", ")
    emit_text(to)
    emit_text("\n")
}

// A float travels in %rax as its bit pattern, the way every other value here
// does, and moves into an SSE register only for the arithmetic itself. That is
// what keeps slots, loads, stores and the stack discipline the same for every
// type rather than forking each of them on whether a float is in hand.
emit_asm_to_sse :: fn(held: i64, from: str, narrow: str, to: str) {
    ty := distinct_repr(held)
    if (ty == TY_F32) {
        emit_asm_move("movd", narrow, to)
        return
    }
    emit_asm_move("movq", from, to)
}

// Change the kind of number in %rax. Nothing is emitted between two types that
// are already the same kind, which is why this can sit on every assignment,
// argument and return without costing anything in a program with no floats.
emit_asm_convert :: fn(mut p: Parser, held_from: i64, held_to: i64) {
    // A distinct type converts as what it is represented by. Its name is a
    // Frost-side question, settled before any of this runs.
    from := distinct_repr(held_from)
    to := distinct_repr(held_to)
    // An array reached through an address becomes a slice of the whole of
    // itself, which is what a parameter of array type is: a borrow, so %rax
    // already holds where the caller's array sits, and the length is the one
    // the array's type carries. Ahead of the pointer rule below, which would
    // otherwise leave the bare address where a slice belongs.
    if (is_pointer(from) && is_array_ty(to) && is_slice_ty(p, to)) {
        held := pointee(p, from)
        if (is_array_ty(held) && is_slice_ty(p, held) == false) {
            emit_asm_slice_of(p, held)
            return
        }
    }
    // A borrow of a scalar reaching a place of the value's own type. %rax holds
    // where the value sits, and what is wanted is the value. Ahead of the
    // pointer rule below, which is what left the address where a number belongs.
    if (reads_through_borrow(p, from) && is_pointer(to) == false
        && pointee(p, from) == to) {
        emit_asm_load_from(p, to, 0, "(%rax), ")
        return
    }
    if (from == to || is_pointer(from) || is_pointer(to)) {
        return
    }
    // The one conversion between aggregates: an array becomes a slice of the
    // whole of itself. %rax holds its address, and a slice is that address
    // beside a length.
    if (is_array_ty(from) && is_array_ty(to) && is_slice_ty(p, to)
        && is_slice_ty(p, from) == false) {
        emit_asm_slice_of(p, from)
        return
    }
    if (is_aggregate(from) || is_aggregate(to)) {
        return
    }
    if (is_float(from) == false && is_float(to) == false) {
        return
    }
    if (is_float(from) && is_float(to)) {
        if (to == TY_F32) {
            emit_asm_move("movq", "%rax", "%xmm0")
            emit_asm_move("cvtsd2ss", "%xmm0", "%xmm0")
            emit_asm_move("movd", "%xmm0", "%eax")
        } else {
            emit_asm_move("movd", "%eax", "%xmm0")
            emit_asm_move("cvtss2sd", "%xmm0", "%xmm0")
            emit_asm_move("movq", "%xmm0", "%rax")
        }
        return
    }
    if (is_float(to)) {
        if (to == TY_F32) {
            emit_asm_move("cvtsi2ssq", "%rax", "%xmm0")
            emit_asm_move("movd", "%xmm0", "%eax")
        } else {
            emit_asm_move("cvtsi2sdq", "%rax", "%xmm0")
            emit_asm_move("movq", "%xmm0", "%rax")
        }
        return
    }
    if (from == TY_F32) {
        emit_asm_move("movd", "%eax", "%xmm0")
        emit_asm_move("cvttss2siq", "%xmm0", "%rax")
        return
    }
    emit_asm_move("movq", "%rax", "%xmm0")
    emit_asm_move("cvttsd2siq", "%xmm0", "%rax")
}

// The same conversion, where what is being converted is known rather than only
// its type. A string literal reaching a `str` needs that: the length is counted
// from the source, since an escape is two bytes written and one byte held.
emit_asm_coerce :: fn(mut p: Parser, value_in: i64, want: i64) {
    // A constant whose value is a literal stands for that literal here, so a
    // text constant reaching a `str` is coerced the way the literal written in
    // its place would be, length and all, rather than as the name.
    mut value := value_in
    named := arena_at(p.arena, value_in)
    if (named.kind == NodeKind::Var
        && local_exists(p, named.val, named.c) == false) {
        held := value_const_node(p, named.val, named.c)
        if (held >= 0) {
            value = held
        }
    }
    have := type_of(p, value)
    if (is_array_ty(want) && is_slice_ty(p, want) && is_pointer(have)) {
        node := arena_at(p.arena, value)
        if (node.kind == NodeKind::StrLit) {
            slot := alloc_temp(p, 16)
            asm_i("movq %rax, ", slot, "(%rbp)")
            asm_i("movq $", literal_length(p.src, node.val, node.c), ", %r11")
            asm_i("movq %r11, ", slot + 8, "(%rbp)")
            asm_i("leaq ", slot, "(%rbp), %rax")
            return
        }
    }
    emit_asm_convert(p, have, want)
}

// An operand of an operator, at the type the operation reads it as. That is the
// operand's own type for everything but a borrow of a scalar, where it is the
// value borrowed, and the coercion is what does the reading.
emit_asm_operand :: fn(mut p: Parser, value: i64) {
    emit_asm_expr(p, value)
    emit_asm_coerce(p, value, operand_type(p, value))
}

// Both operands arrive as f64 bit patterns, the left in %rax and the right in
// %r11. A comparison answers 0 or 1 in %rax like an integer one does, so
// everything downstream of it is unchanged.
emit_asm_float_binop :: fn(mut p: Parser, op: i64) {
    emit_asm_move("movq", "%rax", "%xmm0")
    emit_asm_move("movq", "%r11", "%xmm1")
    if (op == OP_ADD) {
        emit_asm_move("addsd", "%xmm1", "%xmm0")
    } else if (op == OP_SUB) {
        emit_asm_move("subsd", "%xmm1", "%xmm0")
    } else if (op == OP_MUL) {
        emit_asm_move("mulsd", "%xmm1", "%xmm0")
    } else if (op == OP_DIV) {
        emit_asm_move("divsd", "%xmm1", "%xmm0")
    } else {
        // ucomisd sets the flags the unsigned conditions read, so the below
        // and above forms are the ones that mean less and greater here.
        emit_asm_move("ucomisd", "%xmm1", "%xmm0")
        mut setcc: str = "setne"
        if (op == OP_LT) {
            setcc = "setb"
        } else if (op == OP_GT) {
            setcc = "seta"
        } else if (op == OP_LE) {
            setcc = "setbe"
        } else if (op == OP_GE) {
            setcc = "setae"
        } else if (op == OP_EQ) {
            setcc = "sete"
        }
        emit_text("    ")
        emit_text(setcc)
        emit_text(" %al\n")
        asm("movzbq %al, %rax")
        return
    }
    emit_asm_move("movq", "%xmm0", "%rax")
}

// The address of a place, rather than the value in it.
emit_asm_addr :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        if (local_exists(p, node.val, node.c) == false) {
            // A struct constant has no storage of its own, so the address of
            // one is the address of the copy built here.
            value_node := value_const_node(p, node.val, node.c)
            if (value_node >= 0) {
                emit_asm_addr(p, value_node)
                return
            }
        }
        // A name held in a register has no address worth handing out, and the
        // scan is what says its address is never wanted. Reaching here means
        // the two disagree, which is a fault in this backend rather than in the
        // program, and it is said rather than emitted.
        if (asm_reg_of(p, node.val, node.c) > 0) {
            report_where(p.modules, p.src, node.pos)
            asm_unsupported("the address of a name held in a register")
        }
        asm_i("leaq ", local_slot(p, node.val, node.c), "(%rbp), %rax")
        return
    }
    if (kind == NodeKind::Field) {
        base := node.a
        // A columns element field `c[handle].field`: pick the field's column and
        // index it by the validated slot, one recognized shape (see the C
        // backend's twin).
        base_node := arena_at(p.arena, base)
        if (base_node.kind == NodeKind::Index) {
            cbase := base_node.a
            cindex := base_node.b
            cbase_ty := type_of(p, cbase)
            mut cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(p, cthrough)
            }
            if (type_of(p, cindex) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                emit_asm_columns_addr(
                    p,
                    cbase,
                    cbase_ty,
                    cthrough,
                    node.val,
                    node.c,
                    cindex
                )
                return
            }
        }
        base_ty := type_of(p, base)
        // A pointer base already holds the address. A struct place needs one.
        if (is_pointer(base_ty)) {
            emit_asm_expr(p, base)
        } else {
            emit_asm_addr(p, base)
        }
        offset := field_offset(p, base_ty, node.val, node.c)
        if (offset != 0) {
            asm_i("addq $", offset, ", %rax")
        }
        return
    }
    if (kind == NodeKind::Deref) {
        emit_asm_expr(p, node.a)
        return
    }
    if (kind == NodeKind::Index) {
        base := node.a
        base_ty := type_of(p, base)
        mut through := base_ty
        if (is_pointer(through)) {
            through = pointee(p, through)
        }
        // A handle names a slot in a slab. frost_rt_slot validates it and answers
        // with the checked index, and the storage element at that index is the
        // place. This is the one index whose bound is a generation as well as a
        // length, so a handle to a released slot aborts here.
        if (type_of(p, node.b) == TY_HANDLE && is_slab_ty(p, through)) {
            emit_asm_slab_addr(p, base, base_ty, through, node.b)
            return
        }
        mut element: i64 = TY_I64
        // An array and a slice bound the index. A raw pointer does not, which
        // is what makes reading through one a gated operation.
        mut checked: i64 = 0
        mut length_const: i64 = 0
        mut len_slot: i64 = 0
        // A literal, which is neither: its bytes are in the read-only section
        // and their address is what naming it produces, while how many there
        // are was counted at the source. So the address needs no dereference
        // and the bound is a number written here.
        base_node := arena_at(p.arena, constant_node(p, base))
        if (base_node.kind == NodeKind::StrLit) {
            element = TY_U8
            checked = 1
            length_const = literal_length(p.src, base_node.val, base_node.c)
            emit_asm_expr(p, base)
        } else if (is_array_ty(through)) {
            element = array_element(p, through)
            checked = 1
            // An aggregate is reached by its address, and a slice holds the
            // address of its run in its first word rather than being one.
            if (is_pointer(base_ty)) {
                emit_asm_expr(p, base)
            } else {
                emit_asm_addr(p, base)
            }
            if (is_slice_ty(p, through)) {
                // The length is the word past the run's address. Keep it before
                // the address itself is overwritten by the run's own.
                length_const = -1
                len_slot = alloc_temp(p, 8)
                asm("movq 8(%rax), %r11")
                asm_i("movq %r11, ", len_slot, "(%rbp)")
                asm("movq (%rax), %rax")
            } else {
                length_const = array_length(p, through)
            }
        } else if (is_pointer(base_ty)) {
            element = pointee(p, base_ty)
            emit_asm_expr(p, base)
        } else {
            element = base_ty
            emit_asm_addr(p, base)
        }
        emit_asm_spill(p)
        emit_asm_expr(p, node.b)
        if (checked == 1) {
            if (length_const == (-1)) {
                asm_i("movq ", len_slot, "(%rbp), %r11")
            } else {
                asm_i("movq $", length_const, ", %r11")
            }
            emit_asm_bounds_call(p)
        }
        asm_i("imulq $", type_size(p, element), ", %rax")
        asm("movq %rax, %r11")
        emit_asm_unspill(p)
        asm("addq %r11, %rax")
        return
    }
    // A call answering with an aggregate leaves that value's address, which is
    // what reading a field of the answer needs, so `match f() { case .A: }`
    // reads the tag out of what the call answered with.
    if (kind == NodeKind::Call || kind == NodeKind::CallPtr) {
        emit_asm_expr(p, id)
        return
    }
    // A literal written where an address is wanted is built in a temporary of
    // its own, and that is what the address names. A caller that borrows an
    // argument does this whenever the argument is a literal rather than a
    // place, which an enum variant written at a call is.
    if (kind == NodeKind::StructLit) {
        emit_asm_struct_lit(p, id)
        return
    }
    // The same for an array written out where an address is wanted, which is
    // what a constant that is an array turns into wherever it is indexed.
    if (kind == NodeKind::ArrayLit) {
        emit_asm_array_lit(p, id)
        return
    }
    // Where it was written, since which expression it is, is the whole
    // question when this fires.
    report_where(p.modules, p.src, node.pos)
    asm_unsupported("the address of this expression")
}

asm_unsupported :: fn(what: ^i8) {
    report("frost: the native backend does not handle ")
    report_cstr(what)
    report(" yet")
    frost_rt_die()
}

// Bounds-check an index in %rax against a length in %r11, leaving the checked
// index in %rax. The runtime aborts on an out-of-range one, so what returns is
// always in range. An index inside the run reaches nothing but the comparison:
// the runtime holds the message and the abort, and only an index outside
// reaches them, so a checked read costs a compare and a branch rather than a
// call with its arguments. The comparison is unsigned, which is what makes one
// of them answer for a negative index as well as for one past the end. The
// pushed run pointer sits above the call's frame and is untouched.
emit_asm_bounds_call :: fn(mut p: Parser) {
    shadow := abi_shadow(p)
    inside := new_label(p)
    asm("cmpq %r11, %rax")
    emit_text("    jb .Lidx")
    frost_rt_emit_int(inside)
    emit_text("\n")
    emit_text("    movq %rax, ")
    emit_asm_arg_reg(p, 0)
    emit_text("\n")
    emit_text("    movq %r11, ")
    emit_asm_arg_reg(p, 1)
    emit_text("\n")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_check_index")
    asm_i("addq $", shadow, ", %rsp")
    emit_label(".Lidx", inside)
    emit_text(":\n")
}

// A slice's length in %rax, answered for before the slice is built. The bounds
// check above compares unsigned, which is what makes one comparison answer for a
// negative index as well as for one past the end, and the same cast would read a
// negative length as enormous and leave every access through that slice
// unchecked. A length is settled once where the slice is made while an access
// happens in a loop, so this is where it is asked. The runtime holds the message
// and the abort, and only a negative length reaches them.
emit_asm_length_call :: fn(mut p: Parser) {
    shadow := abi_shadow(p)
    inside := new_label(p)
    asm("cmpq $0, %rax")
    emit_text("    jge .Llen")
    frost_rt_emit_int(inside)
    emit_text("\n")
    emit_text("    movq %rax, ")
    emit_asm_arg_reg(p, 0)
    emit_text("\n")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_check_length")
    asm_i("addq $", shadow, ", %rsp")
    emit_label(".Llen", inside)
    emit_text(":\n")
}

// The address of a slab element named by a handle. The slab's address is kept
// in a frame slot across frost_rt_slot, which unpacks and validates the handle and
// answers with the checked slot index. That index scales into the storage run.
// frost_rt_slot takes the handle, the storage length, and the generations run, and
// aborts on an index out of range or a generation that has moved on.
emit_asm_slab_addr :: fn(
    mut p: Parser,
    base: i64,
    base_ty: i64,
    through: i64,
    index_node: i64
) {
    storage_id := slab_field_id(p, through, "storage")
    generations_id := slab_field_id(p, through, "generations")
    storage_field := arena_at(p.fields, storage_id)
    storage_ty := storage_field.ty
    storage_name_off := storage_field.name_off
    storage_name_len := storage_field.name_len
    generations_field := arena_at(p.fields, generations_id)
    generations_name_off := generations_field.name_off
    generations_name_len := generations_field.name_len
    storage_off := field_offset(p, through, storage_name_off, storage_name_len)
    generations_off := field_offset(
        p,
        through,
        generations_name_off,
        generations_name_len
    )
    count := array_length(p, storage_ty)
    element := array_element(p, storage_ty)
    slot := alloc_temp(p, 8)
    if (is_pointer(base_ty)) {
        emit_asm_expr(p, base)
    } else {
        emit_asm_addr(p, base)
    }
    asm_i("movq %rax, ", slot, "(%rbp)")
    emit_asm_expr(p, index_node)
    shadow := abi_shadow(p)
    emit_text("    movq %rax, ")
    emit_asm_arg_reg(p, 0)
    emit_text("\n")
    emit_text("    movq $")
    frost_rt_emit_int(count)
    emit_text(", ")
    emit_asm_arg_reg(p, 1)
    emit_text("\n")
    asm_i("movq ", slot, "(%rbp), %r11")
    if (generations_off != 0) {
        asm_i("addq $", generations_off, ", %r11")
    }
    emit_text("    movq %r11, ")
    emit_asm_arg_reg(p, 2)
    emit_text("\n")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_slot")
    asm_i("addq $", shadow, ", %rsp")
    asm_i("imulq $", type_size(p, element), ", %rax")
    asm("movq %rax, %r11")
    asm_i("movq ", slot, "(%rbp), %rax")
    if (storage_off != 0) {
        asm_i("addq $", storage_off, ", %rax")
    }
    asm("addq %r11, %rax")
}

// The address of one element of one column of a columns container, named by
// `c[handle].field`. The same frost_rt_slot validation as a slab, but the checked
// index scales into the field's own `[N]field` array rather than one storage
// run, so the field's element size and column offset take the place of the
// slab's storage element size and offset.
emit_asm_columns_addr :: fn(
    mut p: Parser,
    base: i64,
    base_ty: i64,
    through: i64,
    field_off: i64,
    field_len: i64,
    index_node: i64
) {
    generations_id := slab_field_id(p, through, "generations")
    generations_field := arena_at(p.fields, generations_id)
    generations_name_off := generations_field.name_off
    generations_name_len := generations_field.name_len
    generations_ty := generations_field.ty
    generations_off := field_offset(
        p,
        through,
        generations_name_off,
        generations_name_len
    )
    count := array_length(p, generations_ty)
    col_ty := field_type_by_range(p, through, field_off, field_len)
    element := array_element(p, col_ty)
    col_off := field_offset(p, through, field_off, field_len)
    slot := alloc_temp(p, 8)
    if (is_pointer(base_ty)) {
        emit_asm_expr(p, base)
    } else {
        emit_asm_addr(p, base)
    }
    asm_i("movq %rax, ", slot, "(%rbp)")
    emit_asm_expr(p, index_node)
    shadow := abi_shadow(p)
    emit_text("    movq %rax, ")
    emit_asm_arg_reg(p, 0)
    emit_text("\n")
    emit_text("    movq $")
    frost_rt_emit_int(count)
    emit_text(", ")
    emit_asm_arg_reg(p, 1)
    emit_text("\n")
    asm_i("movq ", slot, "(%rbp), %r11")
    if (generations_off != 0) {
        asm_i("addq $", generations_off, ", %r11")
    }
    emit_text("    movq %r11, ")
    emit_asm_arg_reg(p, 2)
    emit_text("\n")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_slot")
    asm_i("addq $", shadow, ", %rsp")
    asm_i("imulq $", type_size(p, element), ", %rax")
    asm("movq %rax, %r11")
    asm_i("movq ", slot, "(%rbp), %rax")
    if (col_off != 0) {
        asm_i("addq $", col_off, ", %rax")
    }
    asm("addq %r11, %rax")
}

// `c[h] = value` scatters the element's fields into the columns' per-field
// arrays at the handle's validated slot, one field at a time: address of the
// column element, then the element loaded out of `value` and stored into it.
emit_asm_columns_scatter :: fn(
    mut p: Parser,
    cbase: i64,
    cbase_ty: i64,
    cthrough: i64,
    cindex: i64,
    value: i64
) {
    value_ty := type_of(p, value)
    mut value_struct := value_ty
    if (is_pointer(value_struct)) {
        value_struct = pointee(p, value_struct)
    }
    def := arena_at(p.structs, struct_index_of(cthrough))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        field_off := field.name_off
        field_len := field.name_len
        field_col_ty := field.ty
        field_next := field.next
        if (is_columns_bookkeeping(p, field_off, field_len) == false) {
            element := array_element(p, field_col_ty)
            emit_asm_columns_addr(
                p,
                cbase,
                cbase_ty,
                cthrough,
                field_off,
                field_len,
                cindex
            )
            emit_asm_spill(p)
            if (is_pointer(value_ty)) {
                emit_asm_expr(p, value)
            } else {
                emit_asm_addr(p, value)
            }
            value_off := field_offset(p, value_struct, field_off, field_len)
            if (value_off != 0) {
                asm_i("addq $", value_off, ", %rax")
            }
            emit_asm_load_from(p, element, 0, "(%rax), ")
            asm("movq %rax, %r11")
            emit_asm_unspill(p)
            emit_asm_store_to(p, element, 0, "(%rax)")
        }
        fid = field_next
    }
}

emit_asm_push :: fn() {
    asm("subq $16, %rsp")
    asm("movq %rax, (%rsp)")
}

// Where an expression leaves its left half while its right half is worked out.
// The stack would do, and did, but moving the stack pointer either side of the
// value costs an instruction each way that the frame does not: the function has
// already reserved its frame in one subtraction, so a slot in it is reached by
// naming it. One slot per depth of nesting, made the first time that depth is
// reached and reused by every expression that reaches it after.
//
// This is for a value the emitter puts back where it took it from. A call's
// arguments pass through here too, because the order they are worked out in and
// the order they are pushed in are opposite ones, and a slot holds one while the
// rest of them are worked out.
emit_asm_spill :: fn(mut p: Parser) {
    if (p.spill_depth >= p.spill_slots.count) {
        p.frame_used = p.frame_used + 8
        arena_push(
            p.spill_slots,
            LocalVar {
                name_off = 0,
                name_len = 0,
                ty = 0,
                slot = -p.frame_used
            }
        )
    }
    held := arena_at(p.spill_slots, p.spill_depth)
    asm_i("movq %rax, ", held.slot, "(%rbp)")
    p.spill_depth = p.spill_depth + 1
}

emit_asm_unspill :: fn(mut p: Parser) {
    p.spill_depth = p.spill_depth - 1
    held := arena_at(p.spill_slots, p.spill_depth)
    asm_i("movq ", held.slot, "(%rbp), %rax")
}

// A comparison leaves 0 or 1 in rax.
emit_asm_compare :: fn(setcc: str) {
    asm("cmpq %r11, %rax")
    emit_text("    ")
    emit_text(setcc)
    emit_text(" %al\n")
    asm("movzbq %al, %rax")
}

// Whether an operation on these two operands is the unsigned one. Only the
// widest unsigned types can carry a top bit that means anything: a narrower one
// is zero-extended into a whole register when it is loaded, so the signed
// sixty-four-bit operation on it answers the same. C converts a mixed pair to
// the unsigned type, and the C backend is the other half of this language, so
// the same rule holds here.
wide_unsigned :: fn(ty: i64) -> bool { ty == TY_U64 || ty == TY_USIZE }

binop_is_unsigned :: fn(left: i64, right: i64) -> bool {
    wide_unsigned(left) || wide_unsigned(right)
}

// The branch that reports arithmetic which cannot answer. `taken` is the jump
// that skips it, so the caller names the condition it wants to survive: `jno`
// after a signed operation, `jae` after an unsigned one.
emit_asm_arith_call :: fn(mut p: Parser, taken: str, code: i64) {
    shadow := abi_shadow(p)
    past := new_label(p)
    emit_text("    ")
    emit_text(taken)
    emit_text(" .Lar")
    frost_rt_emit_int(past)
    emit_text("\n")
    emit_text("    movq $")
    frost_rt_emit_int(code)
    emit_text(", ")
    emit_asm_arg_reg(p, 0)
    emit_text("\n")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_arith_trap")
    asm_i("addq $", shadow, ", %rsp")
    emit_label(".Lar", past)
    emit_text(":\n")
}

// A result narrower than the register it was computed in, held to the range its
// own type means. The arithmetic itself cannot overflow at 64 bits when both
// operands are narrower, so this is the whole of the check for those widths.
emit_asm_narrow_check :: fn(
    mut p: Parser,
    bits: i64,
    unsigned: bool,
    what: i64
) {
    shadow := abi_shadow(p)
    past := new_label(p)
    // A value fits `bits` signed exactly when shifting it up and back recovers
    // it, and fits `bits` unsigned exactly when nothing is left above them. Two
    // shifts and a compare, with no bound to build and no negative immediate.
    asm("movq %rax, %r11")
    if (unsigned) {
        asm_i("shrq $", bits, ", %r11")
    } else {
        asm_i("shlq $", 64 - bits, ", %r11")
        asm_i("sarq $", 64 - bits, ", %r11")
    }
    if (unsigned) {
        asm("cmpq $0, %r11")
    } else {
        asm("cmpq %rax, %r11")
    }
    emit_text("    je .Lar")
    frost_rt_emit_int(past)
    emit_text("
")
    emit_text("    movq $")
    frost_rt_emit_int(what)
    emit_text(", ")
    emit_asm_arg_reg(p, 0)
    emit_text("
")
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_arith_trap")
    asm_i("addq $", shadow, ", %rsp")
    emit_label(".Lar", past)
    emit_text(":
")
}
// What has to be answered for before the operation runs rather than after: a
// divisor of zero faults, and a shift wider than the type is masked by the
// hardware into a different shift. Both read the right operand from %r11, where
// the caller has just put it.
emit_asm_arith_pre :: fn(mut p: Parser, op: i64, ty: i64) {
    if (is_integer(ty) == false) {
        return
    }
    if (op == OP_DIV || op == OP_MOD) {
        code := 3
        if (op == OP_MOD) {
            emit_asm_guard(p, "jne", 4)
            return
        }
        emit_asm_guard(p, "jne", code)
        return
    }
    if (op == OP_SHL || op == OP_SHR) {
        asm_i("cmpq $", scalar_size(ty) * 8, ", %r11")
        emit_asm_arith_call(p, "jb", 7)
    }
}

// A divisor compared against zero, with `taken` the jump that skips the report.
emit_asm_guard :: fn(mut p: Parser, taken: str, code: i64) {
    asm("cmpq $0, %r11")
    emit_asm_arith_call(p, taken, code)
}

// The check an operation's own width and signedness call for, emitted where the
// flags the arithmetic just set are still live.
emit_asm_arith_check :: fn(mut p: Parser, op: i64, ty: i64, unsigned: bool) {
    if (is_integer(ty) == false) {
        return
    }
    wide := scalar_size(ty) == 8
    if (op == OP_ADD || op == OP_SUB || op == OP_MUL) {
        if (wide) {
            if (unsigned) {
                emit_asm_arith_call(p, "jae", op)
            } else {
                emit_asm_arith_call(p, "jno", op)
            }
            return
        }
        // The range is the result type's, so its own signedness is what says
        // where the ends are. The flag above belongs to the instruction that
        // was emitted, which follows the operands.
        emit_asm_narrow_check(p, scalar_size(ty) * 8, is_unsigned(ty), op)
    }
}

// Whether the operation can take its right operand as an immediate written into
// the instruction rather than out of %r11.
//
// What cannot: a divide and a remainder, whose divisor is compared against zero
// in %r11 before the operation runs; a shift, whose count is checked in %r11 and
// then moved to %cl; an unsigned multiply, whose one-operand form takes no
// immediate; and `&&` and `||`, which branch rather than compute and never
// reach here. Everything else reads an immediate in the same instruction that
// does the work, so the move that put it in a register is not emitted.
asm_folds_immediate :: fn(op: i64, unsigned: bool) -> bool {
    if (op == OP_ADD || op == OP_SUB || op == OP_WRAP_ADD || op == OP_WRAP_SUB
        || op == OP_WRAP_MUL || op == OP_BITAND || op == OP_BITOR) {
        return true
    }
    if (op == OP_MUL) {
        return unsigned == false
    }
    (op == OP_LT || op == OP_GT || op == OP_LE || op == OP_GE || op == OP_EQ
        || op == OP_NE)
}

// The comparison against an immediate, answering 0 or 1 in %rax the way
// `emit_asm_compare` does against a register.
emit_asm_compare_imm :: fn(setcc: str, value: i64) {
    asm_i("cmpq $", value, ", %rax")
    emit_text("    ")
    emit_text(setcc)
    emit_text(" %al\n")
    asm("movzbq %al, %rax")
}

// The operation with its right operand written into the instruction. Only
// reached for an operator `asm_folds_immediate` answered for, so every shape
// below is one the assembler encodes with an immediate source.
emit_asm_binop_imm :: fn(op: i64, unsigned: bool, value: i64) {
    if (op == OP_ADD || op == OP_WRAP_ADD) {
        asm_i("addq $", value, ", %rax")
        return
    }
    if (op == OP_SUB || op == OP_WRAP_SUB) {
        asm_i("subq $", value, ", %rax")
        return
    }
    // The signed multiply is the one that takes an immediate, and wrapping
    // keeps the low bits whatever the signedness, so both come here.
    if (op == OP_MUL || op == OP_WRAP_MUL) {
        asm_i("imulq $", value, ", %rax")
        return
    }
    if (op == OP_BITAND) {
        asm_i("andq $", value, ", %rax")
        return
    }
    if (op == OP_BITOR) {
        asm_i("orq $", value, ", %rax")
        return
    }
    if (op == OP_LT) {
        if (unsigned) { emit_asm_compare_imm("setb", value) } else { emit_asm_compare_imm("setl", value) }
        return
    }
    if (op == OP_GT) {
        if (unsigned) { emit_asm_compare_imm("seta", value) } else { emit_asm_compare_imm("setg", value) }
        return
    }
    if (op == OP_LE) {
        if (unsigned) { emit_asm_compare_imm("setbe", value) } else { emit_asm_compare_imm("setle", value) }
        return
    }
    if (op == OP_GE) {
        if (unsigned) { emit_asm_compare_imm("setae", value) } else { emit_asm_compare_imm("setge", value) }
        return
    }
    if (op == OP_EQ) {
        emit_asm_compare_imm("sete", value)
        return
    }
    emit_asm_compare_imm("setne", value)
}

// The value a simple right operand stands for. Only asked of the two kinds that
// are a number rather than a load.
asm_immediate_operand :: fn(mut p: Parser, id: i64, kind: i64) -> i64 {
    node := arena_at(p.arena, id)
    if (kind == SIMPLE_NUMBER) {
        return node.val
    }
    const_value(p, node.val, node.c)
}

// Whether the number fits the four-byte field these instructions carry. A wider
// one has to be built in a register first, which is what moving it to %r11 was
// doing, so it keeps going that way.
asm_immediate_fits :: fn(value: i64) -> bool {
    value >= -2147483648 && value <= 2147483647
}

emit_asm_binop :: fn(op: i64, unsigned: bool) {
    if (op == OP_ADD || op == OP_WRAP_ADD) {
        asm("addq %r11, %rax")
        return
    }
    if (op == OP_SUB || op == OP_WRAP_SUB) {
        asm("subq %r11, %rax")
        return
    }
    // Wrapping keeps the low bits whatever the signedness, so the signed
    // multiply is the one to use: the two agree there and it leaves %rdx alone.
    if (op == OP_WRAP_MUL) {
        asm("imulq %r11, %rax")
        return
    }
    if (op == 2) {
        // `imulq` sets the flags for a signed product. An unsigned one goes
        // through `mulq`, whose carry says the high half is not empty, which is
        // the only form that answers for a full-width unsigned overflow.
        if (unsigned) {
            asm("mulq %r11")
        } else {
            asm("imulq %r11, %rax")
        }
        return
    }
    if (op == 3 || op == 4) {
        // The dividend fills both registers the divide reads, and how it is
        // widened into them is the whole difference: the signed form copies
        // the sign into the high half and the unsigned form clears it.
        if (unsigned) {
            asm("xorq %rdx, %rdx")
            asm("divq %r11")
        } else {
            asm("cqto")
            asm("idivq %r11")
        }
        if (op == 4) {
            asm("movq %rdx, %rax")
        }
        return
    }
    if (op == 5) {
        if (unsigned) { emit_asm_compare("setb") } else { emit_asm_compare("setl") }
        return
    }
    if (op == 6) {
        if (unsigned) { emit_asm_compare("seta") } else { emit_asm_compare("setg") }
        return
    }
    if (op == 7) {
        if (unsigned) { emit_asm_compare("setbe") } else { emit_asm_compare("setle") }
        return
    }
    if (op == 8) {
        if (unsigned) { emit_asm_compare("setae") } else { emit_asm_compare("setge") }
        return
    }
    if (op == 9) {
        emit_asm_compare("sete")
        return
    }
    if (op == 10) {
        emit_asm_compare("setne")
        return
    }
    // A shift takes its count in %cl, so the right operand moves there first. A
    // right shift keeps the sign of a signed operand, which is what a handle's
    // generation is unpacked with, and brings in zeros for an unsigned one.
    if (op == OP_SHL) {
        asm("movq %r11, %rcx")
        asm("shlq %cl, %rax")
        return
    }
    if (op == OP_SHR) {
        asm("movq %r11, %rcx")
        if (unsigned) {
            asm("shrq %cl, %rax")
        } else {
            asm("sarq %cl, %rax")
        }
        return
    }
    if (op == OP_BITAND) {
        asm("andq %r11, %rax")
        return
    }
    if (op == OP_BITOR) {
        asm("orq %r11, %rax")
        return
    }
    // `&&` and `||` never reach here. They branch rather than compute, so that
    // the right side is not evaluated when the left settles the answer.
    asm_unsupported("this operator")
}

abi_sse_regs :: fn(mut p: Parser) -> i64 {
    if (p.abi_windows == 1) {
        return 4
    }
    8
}

emit_asm_sse_reg :: fn(index: i64) {
    emit_text("%xmm")
    frost_rt_emit_int(index)
}

// What a parameter is classified as for the calling convention. A generic's
// parameter is a placeholder with no width of its own, so a specialization
// passes everything in the integer registers on both sides of the call, which
// is consistent because this backend emits both sides.
abi_class_of :: fn(mut p: Parser, params: i64, index: i64) -> i64 {
    declared := nth_param_type(p, params, index)
    if (declared < 0 || declared == TY_PARAM) {
        return TY_I64
    }
    declared
}

// ---------------------------------------------------------------------------
// Passing a struct to C by value
//
// Every other argument this backend emits is one word. A parameter written
// `value` is not: C splits a small struct across registers by a rule of the
// target's and pushes a large one onto the stack, so one argument becomes one
// or several slots. These three answer what those slots are, and the call
// emitter walks slots rather than arguments because of them.
//
// The same classification is in the bootstrap compiler, checked against what
// the host C compiler actually does.
// ---------------------------------------------------------------------------

// Whether every scalar of `ty` reaching the eightbyte numbered `word` is
// floating point, where `at` is the type's own offset from the start of the
// struct. 0 when nothing reaches it, 1 when everything that does is float, and
// 2 when anything is not. An eightbyte no field reaches is padding, and padding
// is not floating point, which is what the 0 says.
classify_eightbyte :: fn(mut p: Parser, ty: i64, at: i64, word: i64) -> i64 {
    if (is_struct_ty(ty)) {
        def := arena_at(p.structs, struct_index_of(ty))
        mut fid := def.field_head
        mut offset: i64 = 0
        mut answer: i64 = 0
        while (fid != (-1)) {
            field := arena_at(p.fields, fid)
            field_ty := field.ty
            next_field := field.next
            offset = align_up(offset, align_of(p, field_ty))
            one := classify_eightbyte(p, field_ty, at + offset, word)
            if (one == 2) {
                answer = 2
            }
            if (one == 1 && answer == 0) {
                answer = 1
            }
            offset = offset + type_size(p, field_ty)
            fid = next_field
        }
        return answer
    }
    if (is_array_ty(ty) && is_slice_ty(p, ty) == false) {
        element := array_element(p, ty)
        stride := type_size(p, element)
        count := array_length(p, ty)
        mut index: i64 = 0
        mut answer: i64 = 0
        while (index < count) {
            one := classify_eightbyte(p, element, at + index * stride, word)
            if (one == 2) {
                answer = 2
            }
            if (one == 1 && answer == 0) {
                answer = 1
            }
            index = index + 1
        }
        return answer
    }
    size := type_size(p, ty)
    first := at / 8
    last := (at + size - 1) / 8
    if (word < first || word > last) {
        return 0
    }
    if (is_float(ty)) {
        return 1
    }
    2
}

// 0: the bytes go in one or two registers, read out of the struct.
// 1: the callee is handed the address of a copy the caller makes.
// 2: the bytes are pushed onto the stack as part of the argument area.
value_abi_kind :: fn(mut p: Parser, ty: i64) -> i64 {
    size := type_size(p, ty)
    if (p.abi_windows == 1) {
        // Microsoft x64: one integer register for a struct of 1, 2, 4 or 8
        // bytes whatever it holds, and the address of a copy for every other
        // size. A copy, because the callee's parameter is its own.
        if (size == 1 || size == 2 || size == 4 || size == 8) {
            return 0
        }
        return 1
    }
    // System V: two eightbytes at most in registers, anything larger in memory,
    // which for an argument means the stack rather than an address.
    if (size > 16) {
        return 2
    }
    0
}

// The bits above a narrow answer are undefined in the C ABI, so an extern's
// answer is widened to the whole register before anything reads it. C answers a
// bool in %al and leaves bits 8 and up holding whatever the callee last had
// there, and Frost keeps a bool in a whole word, so reading the register whole
// reads that leftover as true. The same is true of every type narrower than a
// register: only the low bytes are the answer.
emit_asm_extend_ret :: fn(mut p: Parser, ty: i64) {
    repr := distinct_repr(ty)
    if (repr == TY_VOID || is_float(ty) || is_aggregate(ty)) {
        return
    }
    if (repr == TY_BOOL) {
        asm("movzbq %al, %rax")
        return
    }
    size := scalar_size(ty)
    if (size == 1) {
        if (is_unsigned(ty)) {
            asm("movzbq %al, %rax")
        } else {
            asm("movsbq %al, %rax")
        }
        return
    }
    if (size == 2) {
        if (is_unsigned(ty)) {
            asm("movzwq %ax, %rax")
        } else {
            asm("movswq %ax, %rax")
        }
        return
    }
    if (size == 4) {
        // Writing the 32-bit register clears the rest of the 64-bit one, so
        // the unsigned case is the zero extension rather than short of it.
        if (is_unsigned(ty)) {
            asm("movl %eax, %eax")
        } else {
            asm("movslq %eax, %rax")
        }
    }
}

// A right operand this backend can produce without touching %rax, so the left
// one can stay there while it is produced. 0 is everything else, which needs
// %rax to compute and so needs the left operand spilled around it. Written as
// one classification with one emitter below, since a pair that disagreed would
// spill for a value it then did not clobber, or worse.
SIMPLE_NONE :: 0
SIMPLE_NUMBER :: 1
SIMPLE_CONST :: 2
SIMPLE_LOCAL :: 3

simple_operand_kind :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    kind := node.kind
    // A number written as a bit of a flags type carries that type rather than
    // its own value, so it is not the plain literal this reads. A yes or no
    // carries `bool` and is its own value, so it is one.
    if (kind == NodeKind::Num
        && (node.b == 0 || node.b == TY_BOOL + 1)) {
        return SIMPLE_NUMBER
    }
    if (kind != NodeKind::Var) {
        return SIMPLE_NONE
    }
    off := node.val
    len := node.c
    if (is_const(p, off, len)) {
        return SIMPLE_CONST
    }
    // A name that is not a local is a global function's address or a struct
    // constant built where it is named, and neither is a load.
    if (local_exists(p, off, len) == false) {
        return SIMPLE_NONE
    }
    // A struct is handled by its address, which is a computation rather than a
    // load of the value.
    if (is_aggregate(lookup_local(p, off, len))) {
        return SIMPLE_NONE
    }
    // A borrow of a scalar is the value it borrows, which is a load through the
    // load this path emits rather than the one load it knows how to write.
    if (reads_through_borrow(p, lookup_local(p, off, len))) {
        return SIMPLE_NONE
    }
    SIMPLE_LOCAL
}

// The operand `simple_operand_kind` classified, into %r11, leaving %rax alone.
emit_asm_simple_into_r11 :: fn(mut p: Parser, id: i64, kind: i64) {
    node := arena_at(p.arena, id)
    if (kind == SIMPLE_NUMBER) {
        asm_i("movq $", node.val, ", %r11")
        return
    }
    off := node.val
    len := node.c
    if (kind == SIMPLE_CONST) {
        asm_i("movq $", const_value(p, off, len), ", %r11")
        return
    }
    held_in := asm_reg_of(p, off, len)
    if (held_in > 0) {
        emit_text("    movq ")
        emit_asm_saved_reg(held_in - 1)
        emit_text(", %r11\n")
        return
    }
    emit_asm_load_into(
        p,
        lookup_local(p, off, len),
        local_slot(p, off, len),
        "(%rbp), ",
        "%r11",
        "%r11d"
    )
}

// Whether the call goes through a local of function-pointer type rather than to
// the name it shares. Such a local holds a Frost proc, which answers the way
// Frost does however the global of that name was declared, so the C rules for
// answering do not apply to it.
call_is_indirect :: fn(mut p: Parser, fn_index: i64) -> bool {
    sym := arena_at(p.fns, fn_index)
    if (local_exists(p, sym.off, sym.len) == false) {
        return false
    }
    is_proc(lookup_local(p, sym.off, sym.len))
}

// Whether an `extern` answering with an aggregate does so through a hidden
// pointer. This is the target's rule rather than this compiler's: Microsoft x64
// answers a struct of 1, 2, 4 or 8 bytes in %rax whatever it holds, and takes a
// pointer for every other size. System V answers anything up to two eightbytes
// in registers. A Frost function always takes the pointer, so this is asked
// only of an extern.
extern_ret_indirect :: fn(mut p: Parser, ty: i64) -> bool {
    size := type_size(p, ty)
    if (size == 0) {
        return true
    }
    if (p.abi_windows == 1) {
        if (size == 1 || size == 2 || size == 4 || size == 8) {
            return false
        }
        return true
    }
    size > 16
}

// The eightbytes an extern answered in registers, written into the slot the
// caller keeps the value in. Windows uses %rax alone. System V takes each
// eightbyte from %rax then %rdx when anything in it is an integer, and from
// %xmm0 then %xmm1 when everything reaching it is floating point.
emit_asm_take_ret_registers :: fn(mut p: Parser, ty: i64, slot: i64) {
    size := type_size(p, ty)
    if (p.abi_windows == 1) {
        asm_i("movq %rax, ", slot, "(%rbp)")
        return
    }
    mut word: i64 = 0
    mut ints: i64 = 0
    mut floats: i64 = 0
    while (word * 8 < size) {
        at := slot + word * 8
        if (classify_eightbyte(p, ty, 0, word) == 1) {
            if (floats == 0) {
                asm_i("movq %xmm0, ", at, "(%rbp)")
            } else {
                asm_i("movq %xmm1, ", at, "(%rbp)")
            }
            floats = floats + 1
        } else {
            if (ints == 0) {
                asm_i("movq %rax, ", at, "(%rbp)")
            } else {
                asm_i("movq %rdx, ", at, "(%rbp)")
            }
            ints = ints + 1
        }
        word = word + 1
    }
}

value_abi_slots :: fn(mut p: Parser, ty: i64) -> i64 {
    if (value_abi_kind(p, ty) == 1) {
        return 1
    }
    eightbytes := type_size(p, ty) + 7
    eightbytes / 8
}

// The type a `value` parameter takes, or -1 when this argument is not one. The
// declared type is a borrow of the struct, since the argument still arrives
// here as an address. Only the placement differs.
value_param_type :: fn(mut p: Parser, params: i64, index: i64) -> i64 {
    if (nth_param_by_value(p, params, index) == false) {
        return -1
    }
    declared := nth_param_type(p, params, index)
    if (is_pointer(declared)) {
        return pointee(p, declared)
    }
    declared
}

emit_asm_arg_reg :: fn(mut p: Parser, index: i64) {
    if (p.abi_windows == 1) {
        if (index == 0) { emit_text("%rcx") return }
        if (index == 1) { emit_text("%rdx") return }
        if (index == 2) { emit_text("%r8") return }
        emit_text("%r9")
        return
    }
    if (index == 0) { emit_text("%rdi") return }
    if (index == 1) { emit_text("%rsi") return }
    if (index == 2) { emit_text("%rdx") return }
    if (index == 3) { emit_text("%rcx") return }
    if (index == 4) { emit_text("%r8") return }
    emit_text("%r9")
}

emit_asm_expr :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Num) {
        asm_i("movq $", node.val, ", %rax")
        return
    }
    if (kind == NodeKind::Var) {
        off := node.val
        len := node.c
        if (is_const(p, off, len)) {
            asm_i("movq $", const_value(p, off, len), ", %rax")
            return
        }
        // A name that is a global function, used as a value, is its address.
        if (local_exists(p, off, len) == false) {
            fi := fn_index_of(p, off, len)
            if (fi >= 0) {
                emit_text("    leaq ")
                emit_asm_fn_stem(p, fi)
                emit_text("(%rip), %rax\n")
                return
            }
            // A struct constant is built where it is named.
            value_node := value_const_node(p, off, len)
            if (value_node >= 0) {
                emit_asm_expr(p, value_node)
                return
            }
        }
        // A struct is handled by its address, so naming one yields where it
        // lives rather than the first word inside it.
        local_ty := lookup_local(p, off, len)
        if (is_aggregate(local_ty)) {
            asm_i("leaq ", local_slot(p, off, len), "(%rbp), %rax")
            return
        }
        // A name the function is holding in a register is read from there. Its
        // slot is never written while it is held, so the slot is not where the
        // value is.
        held_in := asm_reg_of(p, off, len)
        if (held_in > 0) {
            emit_text("    movq ")
            emit_asm_saved_reg(held_in - 1)
            emit_text(", %rax\n")
            return
        }
        emit_asm_load_from(p, local_ty, local_slot(p, off, len), "(%rbp), ")
        return
    }
    // The literal's bits, assembled from the digits by the assembler, which
    // already knows how to read a decimal and this compiler does not need to.
    if (kind == NodeKind::Float) {
        mark_asm_used(p, id)
        asm_i("movq .Lflt", asm_label(p, id), "(%rip), %rax")
        // Read at single precision. The digits were laid down as a double, so
        // narrowing is what leaves the number an `f32` holds, and the bits stay
        // in %eax because that is where every other single-precision value in
        // this backend travels. What widens it again is the conversion the
        // context asks for, the same one every other `f32` goes through.
        if (node.a == 1) {
            emit_asm_move("movq", "%rax", "%xmm0")
            emit_asm_move("cvtsd2ss", "%xmm0", "%xmm0")
            emit_asm_move("movd", "%xmm0", "%eax")
        }
        return
    }
    if (kind == NodeKind::Assert) {
        shadow := abi_shadow(p)
        emit_asm_expr(p, node.a)
        emit_text("    movq %rax, ")
        emit_asm_arg_reg(p, 0)
        emit_text("\n")
        mark_asm_used(p, id)
        emit_text("    leaq .Lpos")
        frost_rt_emit_int(asm_label(p, id))
        emit_text("(%rip), ")
        emit_asm_arg_reg(p, 1)
        emit_text("\n")
        asm_i("subq $", shadow, ", %rsp")
        asm("call frost_rt_assert_at")
        asm_i("addq $", shadow, ", %rsp")
        return
    }
    // `bsfq` answers the index of the lowest set bit. The walk that builds this
    // asks it only of a word it has already found to be nonzero, which is the
    // one input the instruction leaves undefined.
    if (kind == NodeKind::TrailingZeros) {
        emit_asm_expr(p, node.a)
        asm("bsfq %rax, %rax")
        return
    }
    if (kind == NodeKind::SliceLen) {
        inner := node.a
        // A literal has no length beside it, so its own is counted here. A name
        // standing for one is the literal, since a constant is written out
        // where it is used and there is nothing else there to read a length off.
        held := arena_at(p.arena, constant_node(p, inner))
        if (held.kind == NodeKind::StrLit) {
            asm_i("movq $", literal_length(p.src, held.val, held.c), ", %rax")
            return
        }
        mut inner_ty := type_of(p, inner)
        if (is_pointer(inner_ty)) {
            inner_ty = pointee(p, inner_ty)
        }
        if (is_array_ty(inner_ty) && is_slice_ty(p, inner_ty) == false) {
            asm_i("movq $", array_length(p, inner_ty), ", %rax")
            return
        }
        // The length is the word after the pointer.
        if (is_pointer(type_of(p, inner))) {
            emit_asm_expr(p, inner)
        } else {
            emit_asm_addr(p, inner)
        }
        asm("movq 8(%rax), %rax")
        return
    }
    if (kind == NodeKind::ArrayLit) {
        emit_asm_array_lit(p, id)
        return
    }
    // `&&` and `||` do not evaluate their right side unless they have to. This
    // is not an optimization. A guard like `is_array(t) && length_of(t) < 0`
    // reads a table only the guard says is safe to read, and evaluating both
    // sides makes that a bounds failure rather than a false.
    if (kind == NodeKind::Bin && (node.val == OP_AND || node.val == OP_OR)) {
        done := new_label(p)
        emit_asm_operand(p, node.a)
        asm("cmpq $0, %rax")
        if (node.val == OP_AND) {
            // The answer is already settled if the left side settled it, and
            // moving a constant leaves the comparison's flags alone.
            asm("movq $0, %rax")
            emit_text("    je ")
        } else {
            asm("movq $1, %rax")
            emit_text("    jne ")
        }
        emit_label(".Lend", done)
        emit_text("\n")
        emit_asm_operand(p, node.b)
        asm("cmpq $0, %rax")
        asm("setne %al")
        asm("movzbq %al, %rax")
        emit_label(".Lend", done)
        emit_text(":\n")
        return
    }
    if (kind == NodeKind::Bin) {
        lower_enum_compare(p, id)
        bin := arena_at(p.arena, id)
        op := bin.val
        // Two vectors of floats, one packed instruction per sixteen bytes.
        // Elementwise arithmetic is what a vector register is for, and this is
        // the one backend that decides its own instructions.
        answered := type_of(p, id)
        if (is_array_ty(answered) && is_slice_ty(p, answered) == false) {
            emit_asm_packed(p, bin.a, op, bin.b, answered)
            return
        }
        left_ty := operand_type(p, bin.a)
        right_ty := operand_type(p, bin.b)
        if (is_float(left_ty) || is_float(right_ty)) {
            // Every float operation is done at f64 and narrowed after, so
            // the arithmetic follows one path rather than one per width.
            emit_asm_operand(p, bin.a)
            emit_asm_convert(p, left_ty, TY_F64)
            emit_asm_spill(p)
            emit_asm_operand(p, bin.b)
            emit_asm_convert(p, right_ty, TY_F64)
            asm("movq %rax, %r11")
            emit_asm_unspill(p)
            emit_asm_float_binop(p, op)
            if (op_answers_truth(op) == false) {
                emit_asm_convert(p, TY_F64, type_of(p, id))
            }
            return
        }
        // A right operand that cannot disturb the left one goes straight into
        // the register the operation reads it from. The spill and reload either
        // side of it are what an operand that could clobber %rax needs, and
        // they are five instructions this way of writing it does not emit.
        // Reading a local, comparing against a literal and stepping by one are
        // most of the arithmetic a program does.
        simple := simple_operand_kind(p, bin.b)
        if (simple != SIMPLE_NONE) {
            unsigned := binop_is_unsigned(left_ty, right_ty)
            // A right operand that is a number, and an operation that reads one
            // where it is written, need no register between the two. Stepping
            // by one and comparing against a bound are most of the arithmetic a
            // program does, and both go this way.
            if (simple != SIMPLE_LOCAL
                && asm_folds_immediate(op, unsigned)) {
                value := asm_immediate_operand(p, bin.b, simple)
                if (asm_immediate_fits(value)) {
                    emit_asm_operand(p, bin.a)
                    emit_asm_binop_imm(op, unsigned, value)
                    emit_asm_arith_check(p, op, type_of(p, id), unsigned)
                    return
                }
            }
            emit_asm_operand(p, bin.a)
            emit_asm_simple_into_r11(p, bin.b, simple)
            emit_asm_arith_pre(p, op, type_of(p, id))
            emit_asm_binop(op, unsigned)
            emit_asm_arith_check(p, op, type_of(p, id), unsigned)
            return
        }
        emit_asm_operand(p, bin.a)
        emit_asm_spill(p)
        emit_asm_operand(p, bin.b)
        asm("movq %rax, %r11")
        emit_asm_unspill(p)
        unsigned := binop_is_unsigned(left_ty, right_ty)
        emit_asm_arith_pre(p, op, type_of(p, id))
        emit_asm_binop(op, unsigned)
        emit_asm_arith_check(p, op, type_of(p, id), unsigned)
        return
    }
    if (kind == NodeKind::Call) {
        emit_asm_call(p, node.a, node.val)
        return
    }
    if (kind == NodeKind::CallPtr) {
        // A call through a constant bundle's field is a call to the function
        // that field names, with nothing loaded and nothing dispatched.
        direct := bundle_field_fn(p, node.a)
        if (direct >= 0) {
            emit_asm_call(p, node.b, direct)
            return
        }
        emit_asm_call_through(p, node.a, node.b)
        return
    }
    if (kind == NodeKind::StrLit) {
        mark_asm_used(p, id)
        asm_i("leaq .Lstr", asm_label(p, id), "(%rip), %rax")
        return
    }
    if (kind == NodeKind::Sizeof) {
        asm_i("movq $", type_size(p, node.val), ", %rax")
        return
    }
    if (kind == NodeKind::Alignof) {
        asm_i("movq $", align_of(p, node.val), ", %rax")
        return
    }
    // A conversion between numbers, which is the same widening and narrowing
    // an assignment does; it is written here so it can be asked for.
    if (kind == NodeKind::Cast) {
        emit_asm_expr(p, node.a)
        emit_asm_convert(p, type_of(p, node.a), node.val)
        return
    }
    // A cast between pointers is a retype, so the value is already right.
    if (kind == NodeKind::PtrCast) {
        emit_asm_expr(p, node.a)
        return
    }
    if (kind == NodeKind::SliceFrom) {
        slot := alloc_temp(p, 16)
        emit_asm_expr(p, node.a)
        asm_i("movq %rax, ", slot, "(%rbp)")
        emit_asm_expr(p, node.b)
        emit_asm_length_call(p)
        asm_i("movq %rax, ", slot + 8, "(%rbp)")
        asm_i("leaq ", slot, "(%rbp), %rax")
        return
    }
    if (kind == NodeKind::AddrOf || kind == NodeKind::Ref) {
        // `ptr_to` of a name that is already an address, a `mut` aggregate
        // parameter or a `ref` binding, answers the address it carries, which
        // is a load of the slot rather than the slot's own address.
        inner_node := arena_at(p.arena, node.a)
        if (kind == NodeKind::AddrOf && inner_node.kind == NodeKind::Var
            && is_borrow(type_of(p, node.a))) {
            emit_asm_expr(p, node.a)
            return
        }
        emit_asm_addr(p, node.a)
        return
    }
    // A struct is handled by its address, so reading one of these yields the
    // address and only a scalar is loaded.
    if (kind == NodeKind::Field || kind == NodeKind::Deref || kind == NodeKind::Index) {
        emit_asm_addr(p, id)
        result := type_of(p, id)
        if (is_aggregate(result) == false) {
            emit_asm_load_from(p, result, 0, "(%rax), ")
        }
        return
    }
    if (kind == NodeKind::StructLit) {
        emit_asm_struct_lit(p, id)
        return
    }
    asm_unsupported("this expression")
}

// Build an array into a temporary and answer with its address, the way a struct
// literal does, since both are aggregates reached by address here.
// Two vectors of floats, sixteen bytes at a time. Both sides are aggregates,
// so each answers with the address of its storage; the left one is put away in
// a slot while the right is worked out, since working it out takes the
// register the address is in.
emit_asm_packed :: fn(
    mut p: Parser,
    left: i64,
    op: i64,
    right: i64,
    vector: i64
) {
    element := array_element(p, vector)
    width := type_size(p, vector)
    held := alloc_temp(p, 8)
    slot := alloc_temp(p, width)
    emit_asm_expr(p, left)
    asm_i("movq %rax, ", held, "(%rbp)")
    emit_asm_expr(p, right)
    asm_i("movq ", held, "(%rbp), %r11")
    mut at: i64 = 0
    while (at < width) {
        asm_i("movups ", at, "(%r11), %xmm0")
        asm_i("movups ", at, "(%rax), %xmm1")
        emit_text("    ")
        emit_packed_op(op, element)
        emit_text(" %xmm1, %xmm0
")
        asm_i("movups %xmm0, ", slot + at, "(%rbp)")
        at = at + 16
    }
    asm_i("leaq ", slot, "(%rbp), %rax")
}

// The packed mnemonic for one operation, written out rather than answered
// with: a `str` a call hands back has no place of its own, and the emitters
// read a name they were given rather than one they made.
emit_packed_op :: fn(op: i64, element: i64) {
    if (element == TY_F32) {
        if (op == OP_ADD) { emit_text("addps") return }
        if (op == OP_SUB) { emit_text("subps") return }
        if (op == OP_MUL) { emit_text("mulps") return }
        emit_text("divps")
        return
    }
    if (op == OP_ADD) { emit_text("addpd") return }
    if (op == OP_SUB) { emit_text("subpd") return }
    if (op == OP_MUL) { emit_text("mulpd") return }
    emit_text("divpd")
}

emit_asm_array_lit :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    array_ty := type_of(p, id)
    element := array_element(p, array_ty)
    stride := type_size(p, element)
    slot := alloc_temp(p, type_size(p, array_ty))
    mut at: i64 = 0
    mut entry := node.a
    while (entry != (-1)) {
        enode := arena_at(p.arena, entry)
        emit_asm_expr(p, enode.a)
        emit_asm_coerce(p, enode.a, element)
        if (is_aggregate(element)) {
            asm("movq %rax, %r11")
            asm_i("leaq ", slot + at, "(%rbp), %r10")
            emit_asm_copy(type_size(p, element))
        } else {
            emit_asm_store_rax_to(p, element, slot + at, "(%rbp)")
        }
        at = at + stride
        entry = enode.next
    }
    asm_i("leaq ", slot, "(%rbp), %rax")
}

// An array reaching a slice becomes one in a temporary, whose address is what
// the callee or the place is handed. %rax holds the array's address on entry.
emit_asm_slice_of :: fn(mut p: Parser, from: i64) {
    slot := alloc_temp(p, 16)
    asm_i("movq %rax, ", slot, "(%rbp)")
    asm_i("movq $", array_length(p, from), ", %r11")
    asm_i("movq %r11, ", slot + 8, "(%rbp)")
    asm_i("leaq ", slot, "(%rbp), %rax")
}

// Build a struct into a temporary and answer with its address.
emit_asm_struct_lit :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    struct_ty := node.val
    inits := node.a
    slot := alloc_temp(p, type_size(p, struct_ty))
    mut fid := inits
    while (fid != (-1)) {
        fnode := arena_at(p.arena, fid)
        value := fnode.a
        next_id := fnode.next
        offset := field_offset(p, struct_ty, fnode.val, fnode.c)
        member := field_type(p, struct_ty, fnode.val, fnode.c)
        emit_asm_expr(p, value)
        emit_asm_coerce(p, value, member)
        if (is_aggregate(member)) {
            asm("movq %rax, %r11")
            asm_i("leaq ", slot + offset, "(%rbp), %r10")
            emit_asm_copy(type_size(p, member))
        } else {
            emit_asm_store_rax_to(p, member, slot + offset, "(%rbp)")
        }
        fid = next_id
    }
    asm_i("leaq ", slot, "(%rbp), %rax")
}

// Arguments evaluate right to left onto the stack and only then move into
// place, so an argument that is itself a call cannot clobber one already
// computed. The first four travel in registers. The rest sit above the shadow
// area the callee is entitled to, and the whole call frame stays 16 byte
// aligned.
// One capability a call is handed, left in %rax ready to be pushed. A forwarded
// one is already a pointer. A region supplies the arena by address.
emit_asm_capability :: fn(mut p: Parser, fn_index: i64, index: i64) {
    found := provider_for(p, fn_index, index)
    if (found < 0) {
        report_missing_capability(p, fn_index, index)
    }
    held := arena_at(p.providers, found)
    slot := local_slot(p, held.off, held.len)
    if (held.borrow == 1) {
        asm_i("leaq ", slot, "(%rbp), %rax")
        return
    }
    asm_i("movq ", slot, "(%rbp), %rax")
}

// A call through a value: `ops.less(a, b)`. The callee is worked out first and
// kept in a slot of its own, because the arguments are evaluated after it and
// would otherwise clobber whatever register held it. What the signature says
// decides how the arguments travel, the same as any other call.
emit_asm_call_through :: fn(mut p: Parser, callee: i64, args: i64) {
    callee_ty := type_of(p, callee)
    if (is_proc(callee_ty) == false) {
        report_where(p.modules, p.src, arena_at(p.arena, callee).pos)
        report("this is called, so it has to be a function, and it is a ")
        report_type_name(p, callee_ty)
        frost_rt_die()
    }
    held := alloc_temp(p, 8)
    emit_asm_expr(p, callee)
    asm_i("movq %rax, ", held, "(%rbp)")

    count := count_args(p, args)
    ret := proc_ret(p, callee_ty)
    mut sret: i64 = 0
    mut result_slot: i64 = 0
    if (is_aggregate(ret)) {
        sret = 1
        result_slot = alloc_temp(p, type_size(p, ret))
    }
    // Arguments are pushed last to first, so an argument that is itself a call
    // cannot disturb one already worked out.
    mut i: i64 = count - 1
    while (i >= 0) {
        argument := nth_value_arg(p, args, i)
        emit_asm_expr(p, argument)
        want := proc_param_at(p, callee_ty, i)
        if (want >= 0) {
            emit_asm_coerce(p, argument, want)
        }
        emit_asm_push()
        i = i - 1
    }
    regs := abi_arg_regs(p)
    shadow := abi_shadow(p)
    total := count + sret
    spill := (total * 8 + 15) / 16 * 16
    frame := shadow + spill
    asm_i("subq $", frame, ", %rsp")
    if (sret == 1) {
        emit_text("    leaq ")
        frost_rt_emit_int(result_slot)
        emit_text("(%rbp), ")
        emit_asm_arg_reg(p, 0)
        emit_text("\n")
    }
    mut r: i64 = 0
    while (r < count) {
        asm_i("movq ", frame + 16 * r, "(%rsp), %r10")
        position := r + sret
        want := proc_param_at(p, callee_ty, r)
        wants_sse := is_float(want)
        if (wants_sse && position < regs) {
            emit_text("    movq %r10, ")
            emit_asm_sse_reg(position)
            emit_text("\n")
        } else if (position < regs) {
            emit_text("    movq %r10, ")
            emit_asm_arg_reg(p, position)
            emit_text("\n")
        } else {
            asm_i("movq %r10, ", shadow + 8 * (position - regs), "(%rsp)")
        }
        r = r + 1
    }
    asm_i("movq ", held, "(%rbp), %r11")
    if (p.abi_windows == 0) {
        asm("movb $0, %al")
    }
    asm("call *%r11")
    asm_i("addq $", frame + 16 * count, ", %rsp")
    if (is_float(ret)) {
        if (distinct_repr(ret) == TY_F32) {
            emit_asm_move("movd", "%xmm0", "%eax")
        } else {
            emit_asm_move("movq", "%xmm0", "%rax")
        }
    }
    if (sret == 1) {
        asm_i("leaq ", result_slot, "(%rbp), %rax")
    }
}

// Whether an argument can be put in its register without going through the
// stack: it has to be produced by one instruction that writes only that
// register, and be a whole register wide, so no narrower destination is needed.
simple_arg_kind :: fn(mut p: Parser, id: i64) -> i64 {
    kind := simple_operand_kind(p, id)
    if (kind == SIMPLE_NONE) {
        return SIMPLE_NONE
    }
    ty := type_of(p, id)
    if (is_float(ty) || is_aggregate(ty) || scalar_size(ty) != 8) {
        return SIMPLE_NONE
    }
    kind
}

// One argument straight into the register it travels in.
emit_asm_simple_into_arg :: fn(mut p: Parser, id: i64, kind: i64, index: i64) {
    node := arena_at(p.arena, id)
    emit_text("    movq ")
    if (kind == SIMPLE_LOCAL) {
        held_in := asm_reg_of(p, node.val, node.c)
        if (held_in > 0) {
            emit_asm_saved_reg(held_in - 1)
        } else {
            frost_rt_emit_int(local_slot(p, node.val, node.c))
            emit_text("(%rbp)")
        }
    } else {
        emit_text("$")
        if (kind == SIMPLE_NUMBER) {
            frost_rt_emit_int(node.val)
        } else {
            frost_rt_emit_int(const_value(p, node.val, node.c))
        }
    }
    emit_text(", ")
    emit_asm_arg_reg(p, index)
    emit_text("\n")
}

// Where a pushed argument is read from when it is placed. One going to a
// register is still in the cell it was pushed to, so it needs no staging
// register. One taken apart on the way is in %r10 by then.
emit_asm_arg_from :: fn(direct: i64, offset: i64) {
    if (direct == 1) {
        frost_rt_emit_int(offset)
        emit_text("(%rsp)")
    } else {
        emit_text("%r10")
    }
}

emit_asm_call :: fn(mut p: Parser, args: i64, fn_index: i64) {
    callee := arena_at(p.fns, fn_index)
    // The instance this call names, when the callee is generic, since the
    // symbol's list belongs to whichever instance was parsed last.
    mut params_of_call: i64 = instance_params(p, fn_index, args)
    // A call inside a template names its enclosing parameters rather than
    // types, so there is no instance to read and nothing here can be trusted
    // to say how an argument travels. That call is emitted again for each
    // instance, where there is.
    mut typed_params: bool = true
    if (params_of_call == (-1)) {
        params_of_call = callee.params
        typed_params = generic_fn_of(p, fn_index) < 0
    }
    capability := cap_count_of(p, fn_index)
    value_count := count_value_args(p, args)
    count := value_count + capability
    ret := call_ret_type(p, args, fn_index)
    mut sret: i64 = 0
    mut result_slot: i64 = 0
    // An extern answering with a small struct hands it back in registers, so
    // there is no hidden pointer and no argument is pushed along by one.
    mut register_ret: i64 = 0
    if (is_aggregate(ret)) {
        result_slot = alloc_temp(p, type_size(p, ret))
        if (callee.is_extern == 1 && call_is_indirect(p, fn_index) == false
            && extern_ret_indirect(p, ret) == false) {
            register_ret = 1
        } else {
            sret = 1
        }
    }

    // A call whose arguments are each one instruction writing one register can
    // put them where they belong directly. Nothing an argument does can disturb
    // an argument already placed, because each writes only its own register, so
    // the stack the other path pushes them through is not needed. Every other
    // shape, and anything that has to be converted, borrowed, taken apart or
    // spilled, takes the path below.
    mut placed_directly: bool = (capability == 0 && sret == 0
        && register_ret == 0 && typed_params
        && value_count == count && value_count <= abi_arg_regs(p))
    mut kinds: Arena<LocalVar> = arena_make($LocalVar, 8)
    mut probe: i64 = 0
    while (probe < value_count && placed_directly) {
        argument := nth_value_arg(p, args, probe)
        kind := simple_arg_kind(p, argument)
        declared := nth_param_type(p, params_of_call, probe)
        if (kind == SIMPLE_NONE
            || nth_param_auto_borrows(p, params_of_call, probe)
            || value_param_type(p, params_of_call, probe) >= 0
            || (declared >= 0 && declared != type_of(p, argument))) {
            placed_directly = false
        }
        arena_push(
            kinds,
            LocalVar { name_off = kind, name_len = 0, ty = 0, slot = 0 }
        )
        probe = probe + 1
    }
    if (placed_directly) {
        shadow_only := abi_shadow(p)
        asm_i("subq $", shadow_only, ", %rsp")
        mut placing: i64 = 0
        while (placing < value_count) {
            held := arena_at(kinds, placing)
            emit_asm_simple_into_arg(
                p,
                nth_value_arg(p, args, placing),
                held.name_off,
                placing
            )
            placing = placing + 1
        }
        emit_asm_call_tail(p, args, fn_index, shadow_only, ret, 0, result_slot)
        return
    }

    // Arguments are pushed last to first, so the capabilities, being last, go
    // first and land in the highest slots, the last one first.
    mut cap: i64 = capability
    while (cap > 0) {
        cap = cap - 1
        emit_asm_capability(p, fn_index, cap)
        emit_asm_push()
    }
    generic := generic_fn_of(p, fn_index) >= 0
    // Two orders, and a call needs both. A program reads its arguments first to
    // last, so that is the order they are worked out in, each one held in a
    // spill slot as soon as it is finished. The stack wants them last to first,
    // since a push moves down and the first argument has to land highest, so the
    // slots are taken back after and pushed then. The slots are a stack
    // themselves, which is why taking them back hands them over in exactly the
    // order the pushes want.
    mut i: i64 = 0
    while (i < value_count) {
        argument := nth_value_arg(p, args, i)
        // A parameter that borrows what it is given takes an address, and a
        // scalar in a slot is not one until it is taken. An aggregate already
        // travels as its address, so naming one is enough.
        arg_ty := type_of(p, argument)
        if (nth_param_auto_borrows(p, params_of_call, i)
            && is_pointer(arg_ty) == false
            && is_aggregate(arg_ty) == false) {
            emit_asm_addr(p, argument)
        } else {
            emit_asm_expr(p, argument)
        }
        // A specialization's parameters carry no width, so nothing is
        // converted into one. Everywhere else the callee's declared type is
        // what the value has to arrive as.
        declared := nth_param_type(p, params_of_call, i)
        // A borrowed parameter's declared type is a pointer to what it
        // takes, and an aggregate is already an address here, so the
        // conversion is against what the pointer points at.
        mut want := declared
        if (is_pointer(want) && is_aggregate(pointee(p, want))) {
            want = pointee(p, want)
        }
        if (declared >= 0 && want != TY_PARAM) {
            // Whether a parameter is a slice holds whatever the type argument
            // is, so the one conversion between aggregates still applies to a
            // generic call: an array reaching a `[]T` becomes a slice of the
            // whole of itself, and without it the callee is handed the array's
            // first two words as a pointer and a length. The C backend reads
            // the parameter list the same way here.
            if (typed_params || (is_array_ty(want) && is_slice_ty(p, want))) {
                emit_asm_coerce(p, argument, want)
            }
        }
        emit_asm_spill(p)
        i = i + 1
    }
    mut back: i64 = value_count
    while (back > 0) {
        back = back - 1
        emit_asm_unspill(p)
        emit_asm_push()
    }

    // A `value` argument is one or several slots rather than one word, so the
    // argument area is measured in slots. Every slot is given room on the
    // stack whether or not it ends up in a register, since a System V struct
    // in memory takes stack space with registers still free, and a frame
    // larger than it needs costs nothing but stack.
    regs := abi_arg_regs(p)
    shadow := abi_shadow(p)
    mut total: i64 = sret
    mut counted: i64 = 0
    while (counted < count) {
        want := -1
        if (counted < value_count && typed_params) {
            want = value_param_type(p, params_of_call, counted)
        }
        if (want >= 0) {
            total = total + value_abi_slots(p, want)
        } else {
            total = total + 1
        }
        counted = counted + 1
    }
    // Room for every slot, whether or not it ends up in a register. A System V
    // struct classed as memory takes stack space with registers still free, so
    // the old rule of allocating only what would not fit wrote the argument
    // below the stack pointer and over the return address.
    spill := (total * 8 + 15) / 16 * 16
    frame := shadow + spill
    asm_i("subq $", frame, ", %rsp")

    // The hidden result pointer, when there is one, occupies the first slot and
    // pushes every real argument along by one.
    if (sret == 1) {
        emit_text("    leaq ")
        frost_rt_emit_int(result_slot)
        emit_text("(%rbp), ")
        emit_asm_arg_reg(p, 0)
        emit_text("\n")
    }
    // Windows indexes both register files by the argument's own position, so a
    // float in slot two is %xmm2 and slot two of the integer file goes unused.
    // System V counts the two files separately, so an argument's register
    // depends on how many of its own kind came before it.
    sse_regs := abi_sse_regs(p)
    mut int_next: i64 = sret
    mut sse_next: i64 = 0
    mut spilled: i64 = 0
    mut position: i64 = sret
    mut r: i64 = 0
    while (r < count) {
        mut want: i64 = -1
        if (r < value_count && typed_params) {
            want = value_param_type(p, params_of_call, r)
        }
        mut slots: i64 = 1
        mut kind: i64 = 0
        if (want >= 0) {
            slots = value_abi_slots(p, want)
            kind = value_abi_kind(p, want)
        }
        // The pushed cell holds the value for an ordinary argument and the
        // struct's address for a `value` one, so a slot of the second is read
        // through that address at its own eightbyte.
        mut slot: i64 = 0
        while (slot < slots) {
            mut wants_sse: bool = false
            // An ordinary argument is asked about before it is read, so one
            // going to a register can be read straight into it. One taken
            // apart on the way goes through %r10 first, and so does one going
            // back to the stack, since nothing moves memory to memory.
            if (want < 0 && r < value_count && typed_params) {
                wants_sse = is_float(abi_class_of(p, params_of_call, r))
            }
            if (want >= 0) {
                asm_i("movq ", frame + 16 * r, "(%rsp), %r10")
                if (kind == 1) {
                    // Windows, and a size no register holds: copy the bytes
                    // somewhere the caller owns and hand over that address, so
                    // a callee writing to its parameter writes to its own.
                    copy := alloc_temp(p, type_size(p, want))
                    asm("movq %r10, %r11")
                    asm_i("leaq ", copy, "(%rbp), %r10")
                    emit_asm_copy(type_size(p, want))
                    asm_i("leaq ", copy, "(%rbp), %r10")
                } else {
                    asm_i("movq ", 8 * slot, "(%r10), %r10")
                    // Only System V asks what the eightbyte holds. Windows puts
                    // a struct of a register's size in an integer register
                    // whatever it holds, so a `struct { float a; }` goes in
                    // %rcx rather than %xmm0.
                    if (p.abi_windows == 0) {
                        wants_sse = classify_eightbyte(p, want, 0, slot) == 1
                    }
                }
            }
            mut int_reg := int_next
            mut sse_reg := sse_next
            if (p.abi_windows == 1) {
                int_reg = position
                sse_reg = position
            }
            // Whether this one lands in a register, which is what decides
            // where it is read from.
            to_register := (kind != 2
                && ((wants_sse && sse_reg < sse_regs)
                    || (wants_sse == false && int_reg < regs)))
            mut direct: i64 = 0
            if (want < 0) {
                if (to_register) {
                    direct = 1
                } else {
                    asm_i("movq ", frame + 16 * r, "(%rsp), %r10")
                }
            }
            // A System V struct classed as memory goes on the stack whatever
            // is free, which is the one case a register is not tried.
            if (kind == 2) {
                asm_i("movq %r10, ", shadow + 8 * spilled, "(%rsp)")
                spilled = spilled + 1
            } else if (wants_sse && sse_reg < sse_regs) {
                emit_text("    movq ")
                emit_asm_arg_from(direct, frame + 16 * r)
                emit_text(", ")
                emit_asm_sse_reg(sse_reg)
                emit_text("\n")
                sse_next = sse_next + 1
            } else if (wants_sse == false && int_reg < regs) {
                emit_text("    movq ")
                emit_asm_arg_from(direct, frame + 16 * r)
                emit_text(", ")
                emit_asm_arg_reg(p, int_reg)
                emit_text("\n")
                int_next = int_next + 1
            } else {
                asm_i("movq %r10, ", shadow + 8 * spilled, "(%rsp)")
                spilled = spilled + 1
                if (wants_sse) {
                    sse_next = sse_next + 1
                } else {
                    int_next = int_next + 1
                }
            }
            position = position + 1
            slot = slot + 1
        }
        r = r + 1
    }

    emit_asm_call_tail(
        p,
        args,
        fn_index,
        frame + 16 * count,
        ret,
        register_ret,
        result_slot
    )
}

// The call itself, the stack given back, and whatever the answer needs doing to
// it. Both ways of placing arguments end here, so how a call is made and how
// its answer is read is written once.
emit_asm_call_tail :: fn(
    mut p: Parser,
    args: i64,
    fn_index: i64,
    restore: i64,
    ret: i64,
    register_ret: i64,
    result_slot: i64
) {
    sym := arena_at(p.fns, fn_index)
    // A call through a local of function-pointer type is indirect. The value is
    // loaded into a scratch register the arguments do not use and called
    // through. The load comes after the arguments are in place so it does not
    // disturb them.
    mut indirect: i64 = 0
    if (call_is_indirect(p, fn_index)) {
        indirect = 1
    }
    if (indirect == 1) {
        asm_i("movq ", local_slot(p, sym.off, sym.len), "(%rbp), %r11")
    }
    if (p.abi_windows == 0 && sym.is_extern == 1 && indirect == 0) {
        asm("movb $0, %al")
    }
    emit_text("    call ")
    if (indirect == 1) {
        emit_text("*%r11")
    } else if (generic_fn_of(p, fn_index) >= 0) {
        arg := call_args_for(p, args, fn_index)
        emit_asm_mono_name(
            p,
            fn_index,
            arg,
            p.call_xarg_start,
            p.call_xarg_count
        )
    } else {
        emit_asm_fn_symbol(p, fn_index)
    }
    emit_text("\n")
    asm_i("addq $", restore, ", %rsp")
    // A float answered in %xmm0, and every value here travels in %rax.
    if (is_float(ret)) {
        if (distinct_repr(ret) == TY_F32) {
            emit_asm_move("movd", "%xmm0", "%eax")
        } else {
            emit_asm_move("movq", "%xmm0", "%rax")
        }
    }
    // An aggregate travels as its address, which a hidden pointer already
    // answered with. One that came back in registers is put in the frame first
    // so there is an address to hand on.
    if (register_ret == 1) {
        emit_asm_take_ret_registers(p, ret, result_slot)
        asm_i("leaq ", result_slot, "(%rbp), %rax")
    }
    // Only a C function leaves the bits above a narrow answer undefined. A
    // Frost function answers with the whole register, and a call through a
    // local is a Frost proc whatever the name it shares was declared as.
    if (sym.is_extern == 1 && indirect == 0) {
        emit_asm_extend_ret(p, ret)
    }
}

emit_asm_stmt :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    emit_asm_loc(p, node.pos)
    if (kind == NodeKind::Let) {
        value := node.a
        annotation := node.b
        off := node.val
        len := node.c
        mut ty := annotation
        if (annotation == (-1)) {
            ty = binding_type(p, value)
        }
        // Storage a branch fills in, and a zeroed slot until one does.
        if (value == (-1)) {
            record_local(p, off, len, ty)
            zeroed := local_slot(p, off, len)
            asm_i("leaq ", zeroed, "(%rbp), %r10")
            emit_asm_zero(type_size(p, ty))
            return
        }
        // `columns_new()` is a zeroed container. There is no call to make, only
        // the local's slot to clear.
        if (is_columns_new_call(p, value)) {
            record_local(p, off, len, ty)
            slot := local_slot(p, off, len)
            asm_i("leaq ", slot, "(%rbp), %r10")
            emit_asm_zero(type_size(p, ty))
            return
        }
        emit_asm_expr(p, value)
        emit_asm_coerce(p, value, ty)
        record_local(p, off, len, ty)
        slot := local_slot(p, off, len)
        if (is_aggregate(ty)) {
            asm("movq %rax, %r11")
            asm_i("leaq ", slot, "(%rbp), %r10")
            emit_asm_copy(type_size(p, ty))
            return
        }
        // A name the function holds in a register is written there, and its
        // slot is left alone for as long as it is held.
        held_in := asm_reg_of(p, off, len)
        if (held_in > 0) {
            emit_text("    movq %rax, ")
            emit_asm_saved_reg(held_in - 1)
            emit_text("\n")
            return
        }
        emit_asm_store_rax_to(p, ty, slot, "(%rbp)")
        return
    }
    if (kind == NodeKind::Assign) {
        place := node.a
        value := node.b
        // `c[h] = value`: scatter the element into the columns' per-field arrays
        // at the handle's slot, recognized before the ordinary place store since
        // the place is not one contiguous value.
        place_node := arena_at(p.arena, place)
        if (place_node.kind == NodeKind::Index) {
            cbase := place_node.a
            cindex := place_node.b
            cbase_ty := type_of(p, cbase)
            mut cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(p, cthrough)
            }
            if (type_of(p, cindex) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                emit_asm_columns_scatter(
                    p,
                    cbase,
                    cbase_ty,
                    cthrough,
                    cindex,
                    value
                )
                return
            }
        }
        // Assigning to a name the function holds in a register is a move into
        // that register. There is no address to work out and nothing to keep
        // across working the value out, so the spill either side goes too.
        if (place_node.kind == NodeKind::Var) {
            into := asm_reg_of(p, place_node.val, place_node.c)
            if (into > 0) {
                emit_asm_expr(p, value)
                emit_asm_coerce(
                    p,
                    value,
                    lookup_local(p, place_node.val, place_node.c)
                )
                emit_text("    movq %rax, ")
                emit_asm_saved_reg(into - 1)
                emit_text("\n")
                return
            }
        }
        place_ty := place_type(p, place)
        // The name of an aggregate `mut` parameter already holds the address
        // the value lives at, so reading the name is taking its address and
        // the slot the name sits in is not what is written.
        if (place_ty != type_of(p, place)) {
            emit_asm_expr(p, place)
        } else {
            emit_asm_addr(p, place)
        }
        emit_asm_spill(p)
        emit_asm_expr(p, value)
        emit_asm_coerce(p, value, place_ty)
        if (is_aggregate(place_ty)) {
            asm("movq %rax, %r11")
            emit_asm_unspill(p)
            asm("movq %rax, %r10")
            emit_asm_copy(type_size(p, place_ty))
            return
        }
        asm("movq %rax, %r11")
        emit_asm_unspill(p)
        emit_asm_store_to(p, place_ty, 0, "(%rax)")
        return
    }
    if (kind == NodeKind::Return) {
        emit_asm_return(p, node.a)
        return
    }
    if (kind == NodeKind::If) {
        else_id := new_label(p)
        end_id := new_label(p)
        emit_asm_expr(p, node.a)
        asm("cmpq $0, %rax")
        emit_text("    je ")
        emit_label(".Lelse", else_id)
        emit_text("\n")
        emit_asm_block(p, node.b)
        emit_text("    jmp ")
        emit_label(".Lend", end_id)
        emit_text("\n")
        emit_label(".Lelse", else_id)
        emit_text(":\n")
        else_head := node.val
        if (else_head != (-1)) {
            emit_asm_block(p, else_head)
        }
        emit_label(".Lend", end_id)
        emit_text(":\n")
        return
    }
    // Both jump to a label of the loop being emitted, so a loop leaves its two
    // labels where a statement inside it can find them and puts back whatever
    // the loop around it left.
    if (kind == NodeKind::Break) {
        if (p.loop_end < 0) {
            report_where(p.modules, p.src, node.pos)
            report("`break` leaves a loop, and this is not inside one")
            frost_rt_die()
        }
        emit_text("    jmp ")
        emit_label(".Lend", p.loop_end)
        emit_text("\n")
        return
    }
    if (kind == NodeKind::Continue) {
        if (p.loop_top < 0) {
            report_where(p.modules, p.src, node.pos)
            report("`continue` goes round a loop again, and this is not inside one")
            frost_rt_die()
        }
        emit_text("    jmp ")
        emit_label(".Ltop", p.loop_top)
        emit_text("\n")
        return
    }
    if (kind == NodeKind::While) {
        top_id := new_label(p)
        end_id := new_label(p)
        held_top := p.loop_top
        held_end := p.loop_end
        p.loop_top = top_id
        p.loop_end = end_id
        emit_label(".Ltop", top_id)
        emit_text(":\n")
        emit_asm_block(p, node.c)
        emit_asm_expr(p, node.a)
        asm("cmpq $0, %rax")
        emit_text("    je ")
        emit_label(".Lend", end_id)
        emit_text("\n")
        emit_asm_block(p, node.b)
        emit_text("    jmp ")
        emit_label(".Ltop", top_id)
        emit_text("\n")
        emit_label(".Lend", end_id)
        emit_text(":\n")
        p.loop_top = held_top
        p.loop_end = held_end
        return
    }
    if (kind == NodeKind::ExprStmt) {
        emit_asm_expr(p, node.a)
        return
    }
    if (kind == NodeKind::With) {
        mark := push_provider(p, node.val, node.c, 1)
        emit_asm_block(p, node.a)
        p.providers.count = mark
        return
    }
    // A match is a chain of comparisons against the scrutinee, which is kept in
    // a temporary because each arm's body may clobber the registers.
    //
    // The comparisons one arm stands for. Each pattern it names jumps to the
    // body where it covers the value and falls through to the next where it
    // does not, so an arm covering nothing runs off the end of the chain and
    // into the jump to the arm below.
    if (kind == NodeKind::Match) {
        scrutinee := node.a
        cases := node.b
        end_id := new_label(p)
        slot := alloc_temp(p, 8)
        emit_asm_expr(p, scrutinee)
        asm_i("movq %rax, ", slot, "(%rbp)")
        mut cid := cases
        while (cid != (-1)) {
            cnode := arena_at(p.arena, cid)
            is_default := cnode.c
            body := cnode.a
            next_case := cnode.next
            if (is_default == 1) {
                emit_asm_block(p, body)
                emit_text("    jmp ")
                emit_label(".Lend", end_id)
                emit_text("\n")
            } else {
                skip_id := new_label(p)
                body_id := new_label(p)
                emit_asm_case_test(p, slot, cid, body_id, skip_id)
                emit_label(".Lbody", body_id)
                emit_text(":\n")
                emit_asm_block(p, body)
                emit_text("    jmp ")
                emit_label(".Lend", end_id)
                emit_text("\n")
                emit_label(".Lcase", skip_id)
                emit_text(":\n")
            }
            cid = next_case
        }
        emit_label(".Lend", end_id)
        emit_text(":\n")
        return
    }
    asm_unsupported("this statement")
}

// The value in %rax against one end of what an arm covers.
//
// A compare carries its immediate in four bytes, read back sign-extended, so a
// bound past that has nowhere to go and travels through a register instead.
// The arithmetic path already made this choice for every operator it folds; a
// case bound was the one number reaching an instruction without asking.
emit_asm_case_compare :: fn(value: i64) {
    if (asm_immediate_fits(value)) {
        asm_i("cmpq $", value, ", %rax")
        return
    }
    asm_i("movq $", value, ", %r11")
    asm("cmpq %r11, %rax")
}

emit_asm_case_test :: fn(
    mut p: Parser,
    slot: i64,
    cid: i64,
    body_id: i64,
    skip_id: i64
) {
    mut alt := case_alts(p, cid)
    while (alt != (-1)) {
        anode := arena_at(p.arena, alt)
        form := anode.c
        low := anode.val
        high := anode.b
        next_alt := anode.next
        asm_i("movq ", slot, "(%rbp), %rax")
        emit_asm_case_compare(low)
        if (form == ALT_VALUE) {
            emit_text("    je ")
            emit_label(".Lbody", body_id)
            emit_text("\n")
        } else {
            past_id := new_label(p)
            emit_text("    jl ")
            emit_label(".Lalt", past_id)
            emit_text("\n")
            emit_asm_case_compare(high)
            if (form == ALT_INCLUSIVE) {
                emit_text("    jle ")
            } else {
                emit_text("    jl ")
            }
            emit_label(".Lbody", body_id)
            emit_text("\n")
            emit_label(".Lalt", past_id)
            emit_text(":\n")
        }
        alt = next_alt
    }
    emit_text("    jmp ")
    emit_label(".Lcase", skip_id)
    emit_text("\n")
}

// Leave a function. A struct result is copied into the buffer the caller
// supplied, because the frame it was built in is about to go away.
emit_asm_return :: fn(mut p: Parser, value_in: i64) {
    if (value_in == (-1)) {
        asm("movq $0, %rax")
        emit_asm_leave(p)
        return
    }
    // Before the expression is written out rather than after: this backend
    // coerces whatever is in %rax, and by then the read through the borrow has
    // already happened.
    value := borrow_kept(p, value_in, p.asm_ret)
    emit_asm_expr(p, value)
    emit_asm_coerce(p, value, p.asm_ret)
    if (is_aggregate(p.asm_ret)) {
        asm("movq %rax, %r11")
        asm_i("movq ", p.sret_slot, "(%rbp), %r10")
        emit_asm_copy(type_size(p, p.asm_ret))
        asm_i("movq ", p.sret_slot, "(%rbp), %rax")
    }
    // A float answers in %xmm0, which is where the convention says to look and
    // so where a C caller of this function would.
    if (is_float(p.asm_ret)) {
        emit_asm_to_sse(p.asm_ret, "%rax", "%eax", "%xmm0")
    }
    emit_asm_leave(p)
}

// A body's last statement, when it is an expression, is its result.
emit_asm_function_body :: fn(mut p: Parser, body: i64) {
    if (body == (-1)) {
        asm("movq $0, %rax")
        emit_asm_leave(p)
        return
    }
    mut id := body
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (next_id == (-1)) {
            if (kind == NodeKind::ExprStmt && type_of(p, node.a) != TY_VOID) {
                emit_asm_return(p, node.a)
            } else {
                emit_asm_stmt(p, id)
                if (kind != NodeKind::Return) {
                    asm("movq $0, %rax")
                    emit_asm_leave(p)
                }
            }
        } else {
            emit_asm_stmt(p, id)
        }
        id = next_id
    }
}

emit_asm_block :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        emit_asm_stmt(p, id)
        id = next_id
    }
}

// The shared shape of every emitted function: frame, incoming arguments, body.
// `ret` is the concrete return type, which decides whether the caller handed in
// a buffer for a struct result.
emit_asm_frame :: fn(mut p: Parser, body: i64, params: i64, ret: i64) {
    asm_scan_function(p, body, params)
    emit_asm_names(p)
    p.locals.count = 0
    p.frame_used = 0
    p.spill_slots.count = 0
    p.spill_depth = 0
    p.asm_ret = ret
    p.frame_id = p.frame_id + 1
    mine := p.frame_id
    asm("pushq %rbp")
    asm("movq %rsp, %rbp")
    emit_text("    subq $")
    emit_frame_symbol(p)
    emit_text(", %rsp\n")
    // A stack grows through a guard page, so a frame wider than one page has to
    // touch each page on the way down. A frame that moves the stack pointer past
    // the guard in one step and then writes below it steps over the guard
    // entirely and lands in whatever is mapped there, which is a write to
    // somebody else's memory rather than the fault the guard exists to raise.
    //
    // Every target, not only Windows. Linux grows the main thread's stack with a
    // wide gap below it, which makes the jump harder from there, but a thread
    // stack is an ordinary mapping with a single guard page and a `spawn` body
    // holding a wide frame reaches that on any of them. A guarantee that holds
    // on one platform is a platform note rather than a guarantee.
    //
    // The size is a symbol rather than a number, so which pages to touch is
    // decided while the program runs: one pass down from the frame pointer, one
    // write per page. A frame of one page, which is almost all of them, leaves
    // the loop after a single turn.
    asm("movq %rbp, %r11")
    emit_text(".Lprobe")
    frost_rt_emit_int(mine)
    emit_text(":\n")
    asm("subq $4096, %r11")
    asm("cmpq %rsp, %r11")
    emit_text("    jbe .Lprobed")
    frost_rt_emit_int(mine)
    emit_text("\n")
    asm("movq $0, (%r11)")
    emit_text("    jmp .Lprobe")
    frost_rt_emit_int(mine)
    emit_text("\n")
    emit_text(".Lprobed")
    frost_rt_emit_int(mine)
    emit_text(":\n")

    // Whatever callee-saved registers this function is about to use, put where
    // it can find them again. One run of slots, so every exit reads them back
    // from the same places.
    if (p.asm_saved > 0) {
        p.asm_save_base = alloc_temp(p, 8 * p.asm_saved)
        emit_asm_save_registers(p)
    }

    // A struct result arrives as a hidden pointer ahead of the real arguments.
    regs := abi_arg_regs(p)
    shadow := abi_shadow(p)
    mut shift: i64 = 0
    if (is_aggregate(ret)) {
        shift = 1
        p.sret_slot = alloc_temp(p, 8)
        emit_text("    movq ")
        emit_asm_arg_reg(p, 0)
        emit_text(", ")
        frost_rt_emit_int(p.sret_slot)
        emit_text("(%rbp)\n")
    }

    // The first four arguments arrive in registers. The rest were left on the
    // stack by the caller, above the saved frame pointer, the return address
    // and the shadow area.
    sse_regs := abi_sse_regs(p)
    mut int_next: i64 = shift
    mut sse_next: i64 = 0
    mut spilled: i64 = 0
    mut pid := params
    mut index: i64 = 0
    while (pid != (-1)) {
        pnode := arena_at(p.arena, pid)
        off := pnode.val
        len := pnode.c
        next_id := pnode.next
        record_local(p, off, len, pnode.b)
        slot := local_slot(p, off, len)
        place := index + shift
        ptype := pnode.b
        // The same classification the caller used, read off the same declared
        // types, so the two sides agree without either consulting the other.
        wants_sse := is_float(ptype)
        mut int_reg := int_next
        mut sse_reg := sse_next
        if (p.abi_windows == 1) {
            int_reg = place
            sse_reg = place
        }
        // A parameter C passed as the struct itself arrives the way that target
        // passes one, so the pieces are put back into storage this function
        // owns and the parameter holds its address, which is the shape the body
        // already reads a borrowed struct through.
        mut want: i64 = -1
        if (param_node_by_value(p, pid)) {
            want = pointee(p, ptype)
        }
        if (want >= 0) {
            kind := value_abi_kind(p, want)
            if (kind == 0) {
                copy := alloc_temp(p, type_size(p, want))
                total := value_abi_slots(p, want)
                mut k: i64 = 0
                while (k < total) {
                    mut sse: bool = false
                    if (p.abi_windows == 0) {
                        sse = classify_eightbyte(p, want, 0, k) == 1
                    }
                    mut ireg := int_next
                    mut sreg := sse_next
                    if (p.abi_windows == 1) {
                        ireg = place
                        sreg = place
                    }
                    if (sse && sreg < sse_regs) {
                        emit_text("    movq ")
                        emit_asm_sse_reg(sreg)
                        emit_text(", %r10\n")
                        sse_next = sse_next + 1
                    } else if (sse == false && ireg < regs) {
                        emit_text("    movq ")
                        emit_asm_arg_reg(p, ireg)
                        emit_text(", %r10\n")
                        int_next = int_next + 1
                    } else {
                        asm_i(
                            "movq ",
                            16 + shadow + 8 * spilled,
                            "(%rbp), %r10"
                        )
                        spilled = spilled + 1
                        if (sse) {
                            sse_next = sse_next + 1
                        } else {
                            int_next = int_next + 1
                        }
                    }
                    asm_i("movq %r10, ", copy + 8 * k, "(%rbp)")
                    k = k + 1
                }
                asm_i("leaq ", copy, "(%rbp), %r10")
                asm_i("movq %r10, ", slot, "(%rbp)")
            } else if (kind == 1) {
                // The caller passed the address of a copy it made, and that
                // copy is this function's own, so it is kept as it is.
                mut ireg := int_next
                if (p.abi_windows == 1) {
                    ireg = place
                }
                if (ireg < regs) {
                    emit_text("    movq ")
                    emit_asm_arg_reg(p, ireg)
                    emit_text(", ")
                    frost_rt_emit_int(slot)
                    emit_text("(%rbp)\n")
                } else {
                    asm_i("movq ", 16 + shadow + 8 * spilled, "(%rbp), %r10")
                    asm_i("movq %r10, ", slot, "(%rbp)")
                    spilled = spilled + 1
                }
                int_next = int_next + 1
            } else {
                // System V put the bytes in the incoming argument area, so the
                // copy this function is entitled to is already there and its
                // address is what the parameter holds.
                asm_i("leaq ", 16 + shadow + 8 * spilled, "(%rbp), %r10")
                asm_i("movq %r10, ", slot, "(%rbp)")
                spilled = spilled + value_abi_slots(p, want)
            }
        } else if (is_aggregate(ptype)) {
            if (int_reg < regs) {
                emit_text("    movq ")
                emit_asm_arg_reg(p, int_reg)
                emit_text(", %r11\n")
            } else {
                asm_i("movq ", 16 + shadow + 8 * spilled, "(%rbp), %r11")
                spilled = spilled + 1
            }
            asm_i("leaq ", slot, "(%rbp), %r10")
            emit_asm_copy(type_size(p, ptype))
            int_next = int_next + 1
        } else if (wants_sse && sse_reg < sse_regs) {
            emit_text("    movq ")
            emit_asm_sse_reg(sse_reg)
            emit_text(", ")
            frost_rt_emit_int(slot)
            emit_text("(%rbp)\n")
            sse_next = sse_next + 1
        } else if (wants_sse == false && int_reg < regs) {
            emit_text("    movq ")
            emit_asm_arg_reg(p, int_reg)
            emit_text(", ")
            emit_asm_home(p, asm_reg_of(p, off, len), slot)
            emit_text("\n")
            int_next = int_next + 1
        } else {
            asm_i("movq ", 16 + shadow + 8 * spilled, "(%rbp), %r10")
            emit_text("    movq %r10, ")
            emit_asm_home(p, asm_reg_of(p, off, len), slot)
            emit_text("\n")
            spilled = spilled + 1
            if (wants_sse) {
                sse_next = sse_next + 1
            } else {
                int_next = int_next + 1
            }
        }
        index = index + 1
        pid = next_id
    }

    emit_asm_function_body(p, body)
    asm("movq $0, %rax")
    emit_asm_leave(p)
    // Now that every local and temporary has been reached, say how wide the
    // frame the prologue asked for is. The pad is the outgoing shadow area a
    // call writes into, below everything this function named.
    emit_text("    .set __frost_frame_")
    frost_rt_emit_int(mine)
    emit_text(", ")
    frost_rt_emit_int(align_up(p.frame_used + ASM_FRAME_PAD, 16))
    emit_text("\n")
}

emit_asm_function :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    fn_index := node.val
    body := node.a
    params := node.b
    is_main := node.c
    sym := arena_at(p.fns, fn_index)
    ret := sym.ret_type
    begin_provider(p, fn_index)
    emit_text("    .globl ")
    if (is_main == 1 && p.testing == 0) {
        emit_text("main\n")
        emit_text("main:\n")
    } else {
        emit_asm_fn_symbol(p, fn_index)
        emit_text("\n")
        emit_asm_fn_symbol(p, fn_index)
        emit_text(":\n")
    }
    emit_asm_frame(p, body, params, ret)
}

// The stable part of a function's emitted name: which module declared it and
// what it is called there.
//
// The index into the symbol table would be shorter, but it is a number over the
// whole program. One function added to the first module shifts every index
// after it, so every unit that calls one of them is written differently, and a
// build that compiles each module to its own object builds all of them again
// for an edit that reached one. A name and a module do not move.
emit_asm_fn_stem :: fn(mut p: Parser, fn_index: i64) {
    sym := arena_at(p.fns, fn_index)
    emit_text("mf_")
    frost_rt_emit_int(module_at(p.modules, sym.off))
    emit_text("_")
    emit_source(p.src, sym.off, sym.len)
}

// What a function is called in the emitted assembly. A C library's name, and a
// function written as `extern fn` with a body, are both spelled the way they
// were written, because something outside this object names them. Everything
// else is `mf_<index>`. The C backend's rule, said the same way.
emit_asm_fn_symbol :: fn(mut p: Parser, fn_index: i64) {
    sym := arena_at(p.fns, fn_index)
    if (sym.is_extern == 1 || sym.keeps_name == 1) {
        emit_source(p.src, sym.off, sym.len)
        return
    }
    emit_asm_fn_stem(p, fn_index)
}

// One argument's contribution to a mangled name, the assembly backend's copy of
// the C backend's rule so the two agree: a type argument is `_t<code>`, a value
// argument `_c<number>`, a function argument `_f<index>`.
emit_asm_mangled_arg :: fn(mut p: Parser, arg: i64) {
    if (arg >= FN_BASE) {
        emit_text("_f")
        frost_rt_emit_int(arg - FN_BASE)
    } else if (arg >= CONST_BASE) {
        emit_text("_c")
        frost_rt_emit_int(arg - CONST_BASE)
    } else {
        emit_text("_t")
        frost_rt_emit_int(arg)
    }
}

emit_asm_mono_name :: fn(
    mut p: Parser,
    fn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64
) {
    emit_asm_fn_stem(p, fn_index)
    emit_asm_mangled_arg(p, arg)
    mut i: i64 = 0
    while (i < xarg_count) {
        garg := arena_at(p.gargs, xarg_start + i)
        // An element that names a record constant is written into the body, so
        // two constants of one type are two bodies. The name is what tells them
        // apart, and the offset it starts at is unique within a build.
        if (garg.const_len > 0) {
            emit_text("_r")
            frost_rt_emit_int(garg.const_off)
        } else {
            emit_asm_mangled_arg(p, garg.value)
        }
        i = i + 1
    }
}

// One monomorphization, under the name its call sites use.
emit_asm_mono_function :: fn(
    mut p: Parser,
    id: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    ret: i64
) {
    node := arena_at(p.arena, id)
    fn_index := node.val
    body := node.a
    params := node.b
    begin_provider(p, fn_index)
    emit_text("    .globl ")
    emit_asm_mono_name(p, fn_index, arg, xarg_start, xarg_count)
    emit_text("\n")
    emit_asm_mono_name(p, fn_index, arg, xarg_start, xarg_count)
    emit_text(":\n")
    emit_asm_frame(p, body, params, ret)
}

// The entry point a `--test` build gets instead of the program's own. Each body
// is handed to the runner by address rather than called here, so a failing
// assertion can escape back into the runner without ending the run.
emit_asm_test_main :: fn(mut p: Parser) {
    shadow := abi_shadow(p)
    emit_text("    .globl main\n")
    emit_text("main:\n")
    asm("pushq %rbp")
    asm("movq %rsp, %rbp")
    mut i: i64 = 0
    while (i < p.tests.count) {
        entry := arena_at(p.tests, i)
        // Only the tests of the file that was named, the same rule the C
        // backend follows. The root is module zero, since it is recorded
        // before the files it imports even though its text is laid down
        // after them.
        if (module_at(p.modules, entry.name_off) == 0) {
            emit_text("    leaq .Ltest")
            frost_rt_emit_int(i)
            emit_text("(%rip), ")
            emit_asm_arg_reg(p, 0)
            emit_text("\n")
            emit_text("    leaq ")
            emit_asm_fn_stem(p, entry.fn_index)
            emit_text("(%rip), ")
            emit_asm_arg_reg(p, 1)
            emit_text("\n")
            asm_i("subq $", shadow, ", %rsp")
            asm("call frost_rt_test_run")
            asm_i("addq $", shadow, ", %rsp")
        }
        i = i + 1
    }
    asm_i("subq $", shadow, ", %rsp")
    asm("call frost_rt_test_summary")
    asm_i("addq $", shadow, ", %rsp")
    asm("leave")
    asm("ret")
}

// Whether the function at `id` belongs to the unit being emitted.
unit_owns :: fn(mut p: Parser, id: i64) -> bool {
    node := arena_at(p.arena, id)
    position := node.pos
    sym := arena_at(p.fns, node.val)
    mut off := sym.off
    // A `test` block's function is given a name the compiler made up, which
    // sits past every module, so where its body was written is what says which
    // unit it belongs in.
    if (in_any_module(p, off) == false) {
        off = position
    }
    unit_holds(p, off)
}

// Whether a generic's specializations belong to the unit being emitted. They go
// with the template that stamped them out, once, under names of their own, and
// every other unit calls them by those names.
unit_owns_generic :: fn(mut p: Parser, gfn_index: i64) -> bool {
    gfn := arena_at(p.generic_fns, gfn_index)
    sym := arena_at(p.fns, gfn.fn_index)
    unit_holds(p, sym.off)
}

// The files a program was written in, so a `.loc` can name one. Emitted before
// anything else, since a file number has to be declared before it is used.
//
// Free when `as` or clang assembles the text: what it buys is stepping through
// a program in gdb or lldb, in the source rather than in the disassembly. The
// assembler in this compiler reads past them, because writing debug sections is
// a separate job and having two kinds of assembly text would mean only one of
// them is ever checked.
emit_asm_files :: fn(mut p: Parser) {
    if (p.debug_lines != 1) {
        return
    }
    mut i: i64 = 0
    while (i < p.modules.count) {
        entry := arena_at(p.modules, i)
        emit_text("    .file ")
        frost_rt_emit_int(i + 1)
        emit_text(" \"")
        mut k: i64 = 0
        length := cstr_len(entry.path)
        while (k < length) {
            byte := byte_at(entry.path, k)
            if (byte == CH_BACKSLASH) {
                frost_rt_emit_char(CH_BACKSLASH)
            }
            frost_rt_emit_char(byte)
            k = k + 1
        }
        emit_text("\"\n")
        i = i + 1
    }
}

// Where the statement about to be emitted was written. A debugger reads these
// to turn an address back into a line.
emit_asm_loc :: fn(mut p: Parser, offset: i64) {
    if (p.debug_lines != 1) {
        return
    }
    file := file_of(p.modules, offset)
    if (file < 1) {
        return
    }
    emit_text("    .loc ")
    frost_rt_emit_int(file)
    emit_text(" ")
    frost_rt_emit_int(line_of(p.modules, p.src, offset))
    emit_text(" ")
    frost_rt_emit_int(column_of(p.modules, p.src, offset))
    emit_text("\n")
}

emit_asm_program :: fn(mut p: Parser, head: i64) {
    emit_asm_files(p)
    asm(".text")
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (kind == NodeKind::Func && (node.c != 2 || p.testing == 1)
            && unit_owns(p, id)) {
            emit_asm_function(p, id)
        }
        id = next_id
    }

    // Which instances are the first of their kind, marked once for each generic
    // rather than asked one at a time. Asking walks every instance before the
    // one in hand, which is the square of them for every generic declared.
    mut firsts: Arena<InstanceSlot> = arena_make($InstanceSlot, 1024)
    mut instance_table: Arena<InstanceSlot> = arena_make($InstanceSlot, 1024)
    mut gi: i64 = 0
    while (gi < p.generic_fns.count) {
        if (unit_owns_generic(p, gi)) {
            mark_first_instances(p, gi, firsts, instance_table)
            mut ii: i64 = 0
            while (ii < p.type_args.count) {
                used := arena_at(p.type_args, ii)
                arg := used.arg
                xstart := used.xarg_start
                xcount := used.xarg_count
                is_pack := used.is_pack
                owner := used.owner
                // An instance parsed below can put more in the table, and
                // those come after what was marked, so they are asked the long
                // way. They are few, where the ones marked are all of them.
                mut first: bool = false
                if (ii < firsts.count) {
                    first = arena_at(firsts, ii).mark == gi + 1
                } else {
                    first = (
                        instance_fits_kind(
                            p,
                            gi,
                            arg,
                            xstart,
                            xcount,
                            is_pack,
                            owner
                        ) && tuple_is_first_for(p, gi, ii)
                    )
                }
                if (first) {
                    node := parse_generic_instance(p, gi, arg, xstart, xcount)
                    ret := p.last_return_type
                    emit_asm_mono_function(p, node, arg, xstart, xcount, ret)
                }
                ii = ii + 1
            }
        }
        gi = gi + 1
    }

    // One entry point however many units there are, in the first, which is the
    // file the build was pointed at.
    if (p.testing == 1 && p.emit_module <= 0) {
        emit_asm_test_main(p)
    }

    asm(".data")
    mut ti: i64 = 0
    while (ti < p.tests.count) {
        entry := arena_at(p.tests, ti)
        emit_text(".Ltest")
        frost_rt_emit_int(ti)
        emit_text(":\n")
        emit_text("    .asciz \"")
        emit_string_content(p.src, entry.name_off, entry.name_len)
        emit_text("\"\n")
        ti = ti + 1
    }
    emit_asm_strings(p)
}

// Records that the unit being emitted refers to the literal at `id`, so that
// the unit defines it whether or not the source it was written in is the
// unit's own.
mark_asm_used :: fn(mut p: Parser, id: i64) {
    // A whole program emits every literal where it was written, so there is
    // nothing here for it to record.
    if (p.emit_module < 0) {
        return
    }
    while (p.asm_used.count <= id) {
        arena_push(p.asm_used, AsmUse { unit = 0, slot = 0 })
    }
    if (arena_at(p.asm_used, id).unit == p.emit_module + 2) {
        return
    }
    arena_at(p.asm_used, id).unit = p.emit_module + 2
    arena_at(p.asm_used, id).slot = p.asm_slots
    p.asm_slots = p.asm_slots + 1
}

// What a literal is called in the text being written.
//
// A whole program is one unit and numbers these by the node that holds them,
// which is what it has always written. A unit of a larger build counts its own
// from zero, so what it writes turns on what it refers to rather than on where
// every other module's nodes happened to land.
asm_label :: fn(mut p: Parser, id: i64) -> i64 {
    if (p.emit_module < 0) {
        return id
    }
    arena_at(p.asm_used, id).slot
}

// Whether the unit being emitted refers to the literal at `id`.
asm_used_here :: fn(mut p: Parser, id: i64) -> bool {
    if (id >= p.asm_used.count) {
        return false
    }
    arena_at(p.asm_used, id).unit == p.emit_module + 2
}

// Every string literal in the program, labelled by the node that holds it.
emit_asm_strings :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        kind := node.kind
        off := node.val
        len := node.c
        // A whole program writes every literal where it was written, which is
        // what it has always written. A unit of a larger build writes the ones
        // it refers to and no others: what it holds and never names is written
        // by nobody, and a name it uses is a number of its own that no other
        // module's nodes can move.
        mut wanted: bool = false
        if (p.emit_module < 0) {
            wanted = unit_holds(p, off)
        } else {
            wanted = asm_used_here(p, i)
        }
        if (kind == NodeKind::StrLit && wanted) {
            emit_text(".Lstr")
            frost_rt_emit_int(asm_label(p, i))
            emit_text(":\n")
            emit_text("    .asciz \"")
            emit_string_content(p.src, off, len)
            emit_text("\"\n")
        }
        mut wanted_pos: bool = false
        if (p.emit_module < 0) {
            wanted_pos = unit_holds(p, node.pos)
        } else {
            wanted_pos = asm_used_here(p, i)
        }
        if (kind == NodeKind::Assert && wanted_pos) {
            emit_text(".Lpos")
            frost_rt_emit_int(asm_label(p, i))
            emit_text(":\n")
            emit_text("    .asciz \"")
            emit_position(p.modules, p.src, node.pos)
            emit_text("\"\n")
        }
        if (kind == NodeKind::Float && wanted) {
            emit_text("    .align 8\n")
            emit_text(".Lflt")
            frost_rt_emit_int(asm_label(p, i))
            emit_text(":\n")
            emit_text("    .double ")
            // A sign when the literal was written negative. The assembler's own
            // reader already takes a leading minus, so this needs nothing else.
            if (node.b == 1) {
                emit_text("-")
            }
            emit_source(p.src, off, len)
            emit_text("\n")
        }
        i = i + 1
    }
}

count_params :: fn(mut p: Parser, head: i64) -> i64 {
    mut count: i64 = 0
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        count = count + 1
        id = node.next
    }
    count
}

// The other half of the same list: how many arguments a call writes with a `$`
// in front of them, which is what says a compile-time parameter was given.
count_type_args :: fn(mut p: Parser, head: i64) -> i64 {
    mut count: i64 = 0
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal) {
            count = count + 1
        }
        id = next_id
    }
    count
}

// A type argument is erased before runtime, so it is not counted against the
// parameter list, which never has a node for a type parameter either.
count_args :: fn(mut p: Parser, head: i64) -> i64 {
    mut count: i64 = 0
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        kind := vnode.kind
        if (kind != NodeKind::TypeVal) {
            count = count + 1
        }
        id = next_id
    }
    count
}

// --------------------------------------------------------------------------- // Regions. A `with arena { ... }` block is a region. A raw pointer derived from // the arena inside it dies with the block, so it may not be assigned to // anything declared outside the block or returned. There are no lifetimes and // no region types on pointers, only a walk over the block tracking which names // hold arena pointers. That is enough here because the language has no global // arenas and no closures, so a pointer can only reach an arena a function was // handed directly. // ---------------------------------------------------------------------------
