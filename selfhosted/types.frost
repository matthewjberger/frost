// Typing and the checks that ride on it: locals, moves, linearity, field and
// expression types, and the concrete return type of a generic call.

import "core.frost"
import "lexer.frost"
import "imports.frost"
import "names.frost"
import "layout.frost"

export call_ret_type, call_type_args, call_args_for, collect_type_args,
    fn_index_of, note_type_args, takes_pack, pack_call_args,
    is_type_predicate, predicate_holds, record_parse_local,
    parse_local_type, parse_param_type, field_binding_of,
    fn_proc_type, bundle_field_fn,
    count_value_args, field_type, generic_fn_of, is_linear_type, is_moved,
    local_exists, lookup_local, lower_enum_compare, nth_param_by_value,
    nth_param_type, nth_value_arg, nth_param_auto_borrows,
    param_node_by_value,
    record_local, record_mono_ret, type_cache_prepare, type_of, binding_type,
    types_compatible, value_fits, untyped_literal

// `a == b` on two enum values asks which variant each is, and that is the tag
// they both carry. An enum is laid out as a struct with `tag` beside every
// variant's fields, so this rewrites the two sides to read that field, the same
// way a `match` on an enum switches on `e.tag`. Both backends call it, so
// neither has to know that an enum comparison is different from any other.
//
// It runs during emit rather than before it, because a local's type is recorded
// as the emitter walks the body, so nothing earlier can say what `a` is. It is
// idempotent: once rewritten the sides are integers and the test is false.
//
// A variant with fields makes the question ambiguous, since two values can be
// the same variant and hold different things, so that one is refused.
lower_enum_compare :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    op := node.val
    left := node.a
    right := node.b
    position := node.pos
    if (op != OP_EQ && op != OP_NE) {
        return
    }
    // An enum reached through a borrow is still that enum, which is what a
    // parameter of enum type is. A field access through a pointer reads
    // through it, so the tag is reached the same way either way.
    mut ty := type_of(p, left)
    if (is_pointer(ty)) {
        ty = pointee(ty)
    }
    if (is_struct_ty(ty) == false) {
        return
    }
    def := arena_at(p.structs, struct_index_of(ty))
    if (def.is_enum != 1) {
        return
    }
    first_field := def.field_head
    if (first_field != (0 - 1)) {
        field := arena_at(p.fields, first_field)
        if (field.next != (0 - 1)) {
            report_where(p.modules, p.src, position)
            report("an enum whose variants carry fields cannot be compared with ==, since two values can be the same variant and hold different things; match on it instead")
            frost_rt_die()
        }
    }
    // Both nodes are made before the one being rewritten is reached for, since
    // pushing to the arena can move it and a borrow taken first would be
    // writing to where it was.
    tag_left := enum_tag_operand(p, left)
    tag_right := enum_tag_operand(p, right)
    mut held := arena_at(p.arena, id)
    held.a = tag_left
    held.b = tag_right
}

// The tag of one side of an enum comparison. `Kind::Var` is a struct literal
// whose tag is written into it, so the value it was given is used directly:
// reading a field of a literal would need its address, and a literal is not a
// place either backend can take one of. Anything else is a place, so the tag is
// read out of it.
enum_tag_operand :: fn(mut p: Parser, side: i64) -> i64 {
    node := arena_at(p.arena, side)
    if (node.kind == NodeKind::StructLit) {
        mut init := node.a
        while (init != (0 - 1)) {
            held := arena_at(p.arena, init)
            value := held.a
            name_off := held.val
            name_len := held.c
            next_init := held.next
            if (name_len == 3 && name_off == p.name_tag) {
                return value
            }
            init = next_init
        }
    }
    new_field_node(p, side, p.name_tag, 3)
}

// The declared type of the nth parameter, or -1 past the end of the list. An
// argument is classified and converted by what the callee said it takes rather
// than by what the caller happened to write.
nth_param_type :: fn(mut p: Parser, params: i64, n: i64) -> i64 {
    mut id := params
    mut index : i64 = 0
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        if (index == n) {
            return node.b
        }
        index = index + 1
        id = node.next
    }
    0 - 1
}

// Whether a parameter was declared `value`, so the struct crosses to C the way
// C passes one rather than as an address. Recorded beside the parameter nodes
// rather than on them, because the placement is the only thing it changes.
param_node_by_value :: fn(mut p: Parser, param_node: i64) -> bool {
    mut entry : i64 = 0
    while (entry < p.value_params.count) {
        held := arena_at(p.value_params, entry)
        if (held.name_off == param_node) {
            return true
        }
        entry = entry + 1
    }
    false
}

// Whether the nth parameter borrows what it is given, so the call site is what
// takes the address. An aggregate is already reached by address; a scalar is
// not, and this is what says so.
nth_param_auto_borrows :: fn(mut p: Parser, params: i64, n: i64) -> bool {
    mut id := params
    mut index : i64 = 0
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        borrows := node.a
        if (index == n) {
            return borrows == 1
        }
        index = index + 1
        id = next_id
    }
    false
}

nth_param_by_value :: fn(mut p: Parser, params: i64, n: i64) -> bool {
    mut id := params
    mut index : i64 = 0
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (index == n) {
            return param_node_by_value(p, id)
        }
        index = index + 1
        id = next_id
    }
    false
}

// A name may be bound more than once in one body, once per sibling scope, and
// the binding in scope is the one bound most recently. Locals are recorded in
// declaration order and never popped, so that is the last matching entry, not
// the first: `emit_program` binds `node` to an i64 and later to a `^Node`, and
// answering with the i64 types `node^.next` as a scalar and reads offset zero.
lookup_local :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = p.locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    TY_I64
}

// Whether a name is in scope as a parameter or local. lookup_local answers with
// a type and defaults an unknown name to i64, which cannot distinguish "an i64"
// from "not declared", so a check needs this instead.
// Whether a value of type `from` may stand in for `to`. Scalars and pointers
// convert freely, the way the emitted C does, and a type parameter matches
// anything because it is a placeholder. A struct only matches the same struct,
// which is where real mistakes show up.
// A literal has no type of its own until the context gives it one, which is
// what makes `m : Meters = 3` read the way it should. An arithmetic expression
// built only out of literals is still one, so `m : Meters = 60 * 60` reads the
// same way.
untyped_literal :: fn(mut p: Parser, id: i64) -> bool {
    if (id < 0) {
        return false
    }
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Num) {
        // A bit of a flags type is written as a name and carries that type, so
        // it is not one of the numbers the context gets to type.
        return node.b == 0
    }
    if (node.kind == NodeKind::Float) {
        return true
    }
    if (node.kind == NodeKind::Bin && op_answers_truth(node.val) == false) {
        return untyped_literal(p, node.a) && untyped_literal(p, node.b)
    }
    false
}

// The type a `x := value` binding takes. A borrowed aggregate named by a plain
// name is copied into the binding rather than aliased, so naming it means the
// value the caller holds. Only a name: a call that answers with a `ref T`
// handed out a borrow on purpose, and `ref x := place` asks for one, so both
// keep what they were given.
binding_type :: fn(mut p: Parser, value: i64) -> i64 {
    ty := type_of(p, value)
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Var) {
        return ty
    }
    if (is_borrow(ty) && is_aggregate(pointee(ty))) {
        return pointee(ty)
    }
    ty
}

// Whether a value of type `from` may be given to something of type `to`, with
// the value in hand, so a literal can be exempt from the distinct-type rule.
value_fits :: fn(mut p: Parser, value: i64, from: i64, to: i64) -> bool {
    // A set of bits has no such exemption. Its whole content is the names, so a
    // number written where one belongs is the thing the declaration replaces.
    if (is_flags_type(p, to)) {
        return from == to
    }
    if (is_distinct(to) && untyped_literal(p, value)) {
        return types_compatible(p, from, distinct_repr(to))
    }
    types_compatible(p, from, to)
}

types_compatible :: fn(mut p: Parser, from: i64, to: i64) -> bool {
    if (from == to) {
        return true
    }
    if (from == TY_PARAM || to == TY_PARAM) {
        return true
    }
    // A distinct type is built only from itself, so neither its representation
    // nor another distinct type over the same representation will do. What the
    // name protects is what goes in. Reading one as what it is represented by
    // is allowed, and is what a call into C is.
    if (is_distinct(to)) {
        return false
    }
    if (is_distinct(from)) {
        return types_compatible(p, distinct_repr(from), to)
    }
    if (is_pointer(from) && is_pointer(to)) {
        return true
    }
    // An aggregate is held by address, so an expression that answers with the
    // address of one is that value: `slice[index]` of a struct answers with a
    // pointer, and handing it to a place of the struct's own type is a copy of
    // the element, not a type error.
    if (is_pointer(from) && is_aggregate(to) && pointee(from) == to) {
        return true
    }
    // An array reaches a slice of its own element type and nothing else. Two
    // arrays that are not the same type were caught above.
    if (is_array_ty(from) || is_array_ty(to)) {
        // A `str` is a slice of bytes, and a string literal is a bare pointer
        // to them, so that one pointer reaches a slice by gaining a length.
        if (is_pointer(from) && is_array_ty(to) && is_slice_ty(p, to)) {
            return array_element(p, to) == TY_U8
        }
        return is_array_ty(from) && is_array_ty(to) && is_slice_ty(p, to)
            && array_element(p, from) == array_element(p, to)
    }
    if (is_struct_ty(from) || is_struct_ty(to)) {
        return false
    }
    true
}

local_exists :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i : i64 = p.locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
    }
    false
}

// Whether the value named (off, len) has been moved on the current path, read
// by the flow-aware move check as it walks a function body.
is_moved :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i : i64 = 0
    while (i < p.moved.count) {
        entry := arena_at(p.moved, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

is_linear_type :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_struct_ty(ty) == false) {
        return false
    }
    // A struct code that names no struct is a type still being worked out, such
    // as a generic's declared return before it is instantiated. It is not a
    // resource, and reading past the table to decide would be a crash.
    index := struct_index_of(ty)
    if (index < 0 || index >= p.structs.count) {
        return false
    }
    def := arena_at(p.structs, index)
    if (def.is_linear == 1) {
        return true
    }
    false
}

record_local :: fn(mut p: Parser, off: i64, len: i64, ty: i64) {
    // The frame slot is decided here, once, rather than by adding up every
    // local's size at each mention of the name. That sum was the native
    // backend's inner loop: quadratic in a function's locals, with a type's
    // size measured again on every step of it.
    p.frame_used = p.frame_used + align_up(type_size(p, ty), 8)
    arena_push(p.locals, LocalVar { name_off = off, name_len = len, ty = ty,
        slot = 0 - p.frame_used })
}

// The type of a struct field. The base type may be a pointer (a borrow of a
// struct or a `^T`), which is dereferenced one level first, so `a.count` and
// `node^.next` both resolve.
field_type :: fn(mut p: Parser, base_ty: i64, off: i64, len: i64) -> i64 {
    mut struct_ty := base_ty
    if (is_pointer(struct_ty)) {
        struct_ty = pointee(struct_ty)
    }
    if (is_struct_ty(struct_ty) == false) {
        return TY_I64
    }
    def := arena_at(p.structs, struct_index_of(struct_ty))
    struct_off := def.name_off
    struct_len := def.name_len
    mut fid := def.field_head
    while (fid != (0 - 1)) {
        field := arena_at(p.fields, fid)
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return field.ty
        }
        fid = field.next
    }
    // The base is a struct but carries no such field. Emitting the access
    // verbatim would leave it for whatever compiles the output to notice.
    report_where(p.modules, p.src, off)
    report("struct '")
    report_src(p.src, struct_off, struct_len)
    report("' has no field '")
    report_src(p.src, off, len)
    report("'")
    frost_rt_die()
    TY_I64
}

// Fill the type cache with one empty slot per possible node index. The node
// arena is a fixed allocation, so its capacity bounds every id a monomorphized
// instance can later take, and a slot per capacity covers them all without the
// cache ever having to grow alongside the arena.
type_cache_prepare :: fn(mut p: Parser) {
    while (p.type_cache.count < p.type_cache.cap) {
        arena_push(p.type_cache, TypeCacheEntry { ty = 0 })
    }
}

// The type of a node. During emit the answer is memoized per node index, since
// emit asks for the same node's type many times and re-deriving it walks the
// symbol tables each time. A slot holds the type plus one, so an untouched zero
// slot is "not computed" and a real type of zero still stores as one. The checks
// run with type_cache_on off, so a type derived under a generic binding it will
// not have at emit is never cached.
type_of :: fn(mut p: Parser, id: i64) -> i64 {
    if (p.type_cache_on == 1 && id >= 0 && id < p.type_cache.count) {
        slot := arena_at(p.type_cache, id)
        if (slot.ty != 0) {
            return slot.ty - 1
        }
        result := type_of_compute(p, id)
        stored := arena_at(p.type_cache, id)
        stored.ty = result + 1
        return result
    }
    type_of_compute(p, id)
}

type_of_compute :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::StrLit) {
        return POINTER_BASE + TY_I8
    }
    // A number written as a bit of a flags type carries that type; every other
    // one takes its type from where it was written.
    if (kind == NodeKind::Num && node.b != 0) {
        return node.b - 1
    }
    if (kind == NodeKind::StructLit) {
        return node.val
    }
    if (kind == NodeKind::Var) {
        // A name that is not a local but is a global function is that function
        // used as a value: it stands for the function's address, of the
        // function-pointer type its signature makes.
        if (local_exists(p, node.val, node.c) == false) {
            fi := fn_index_of(p, node.val, node.c)
            if (fi >= 0) {
                return fn_proc_type(p, fi)
            }
            // A struct constant is its literal, so it has the literal's type.
            value_node := value_const_node(p, node.val, node.c)
            if (value_node >= 0) {
                return type_of(p, value_node)
            }
        }
        return lookup_local(p, node.val, node.c)
    }
    if (kind == NodeKind::Call) {
        // A call a template's own parse produced from a list that is not bound
        // names no instantiation, so asking it for one would make a
        // specialization out of elements that do not exist. The parse it
        // belongs to is thrown away and done again per instance.
        if (node.b == 1) {
            return TY_I64
        }
        // A generic function's declared return type still mentions its type
        // parameter, so a call answers with the concrete type recorded for the
        // instantiation it names.
        return call_ret_type(p, node.a, node.val)
    }
    if (kind == NodeKind::Field) {
        base := node.a
        off := node.val
        len := node.c
        // `c[h].field` on a columns container yields one element of that field's
        // column, so the type is the column array's element, not the column.
        base_node := arena_at(p.arena, base)
        if (base_node.kind == NodeKind::Index) {
            cbase_ty := type_of(p, base_node.a)
            mut cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(cthrough)
            }
            if (type_of(p, base_node.b) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                col := field_type_by_range(p, cthrough, off, len)
                return array_element(p, col)
            }
        }
        base_ty := type_of(p, base)
        return field_type(p, base_ty, off, len)
    }
    if (kind == NodeKind::Deref) {
        inner := node.a
        t := type_of(p, inner)
        if (is_pointer(t)) {
            return pointee(t)
        }
        return TY_I64
    }
    if (kind == NodeKind::Index) {
        base := node.a
        t := type_of(p, base)
        // A slab indexed by a handle yields one of its stored elements, so the
        // type is the storage array's element, not the slab.
        if (type_of(p, node.b) == TY_HANDLE && is_slab_ty(p, t)) {
            return array_element(p, slab_field_type(p, t, "storage"))
        }
        if (is_array_ty(t)) {
            return array_element(p, t)
        }
        if (is_pointer(t)) {
            inner := pointee(t)
            if (is_array_ty(inner)) {
                return array_element(p, inner)
            }
            return inner
        }
        return t
    }
    if (kind == NodeKind::SliceLen) {
        return TY_I64
    }
    if (kind == NodeKind::Assert) {
        return TY_VOID
    }
    // A literal says both halves of its own type: the element from a declared
    // type when one was in force, otherwise from the first thing in it, and the
    // length from how many there are.
    if (kind == NodeKind::ArrayLit) {
        mut element : i64 = TY_I64
        if (node.val != 0) {
            element = node.val - 1
        } else {
            if (node.a != (0 - 1)) {
                first := arena_at(p.arena, node.a)
                element = type_of(p, first.a)
            }
        }
        return array_of(p, element, node.c)
    }
    if (kind == NodeKind::Ref) {
        return BORROW_FLAG + type_of(p, node.a)
    }
    if (kind == NodeKind::SliceFrom) {
        return node.val
    }
    if (kind == NodeKind::AddrOf) {
        inner := node.a
        return POINTER_BASE + type_of(p, inner)
    }
    if (kind == NodeKind::PtrCast) {
        return POINTER_BASE + node.val
    }
    if (kind == NodeKind::Float) {
        return TY_F64
    }
    // Arithmetic answers i64 whatever it was handed, which is deliberate: a
    // narrower operand widening to the result rather than the result narrowing
    // to the operand is what keeps a byte fed into an i64 accumulator from
    // being computed at eight bits. Floats are the exception, since an integer
    // result there would be the wrong kind of number rather than the wrong
    // width, and a comparison answers a truth value either way.
    // A call through a value answers with what that signature answers with.
    if (kind == NodeKind::CallPtr) {
        callee_ty := type_of(p, node.a)
        if (is_proc(callee_ty)) {
            return proc_ret(p, callee_ty)
        }
        return TY_I64
    }
    if (kind == NodeKind::Bin) {
        if (op_answers_truth(node.val)) {
            return TY_I64
        }
        left := type_of(p, node.a)
        // Arithmetic on a distinct type answers with that type. Adding two
        // lengths gives a length, and the sum can go back where either came
        // from, which is the whole reason to have named the type.
        if (is_distinct(left)) {
            return left
        }
        if (is_float(left)) {
            return left
        }
        right := type_of(p, node.b)
        if (is_distinct(right)) {
            return right
        }
        if (is_float(right)) {
            return right
        }
        return TY_I64
    }
    TY_I64
}

// The generic-fns index of a function, or -1 if it is not generic.
generic_fn_of :: fn(mut p: Parser, fn_index: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.generic_fns.count) {
        entry := arena_at(p.generic_fns, i)
        if (entry.fn_index == fn_index) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// Determine the concrete argument tuple of a generic call: the explicit `$Type`
// and `$value` arguments in order if there are any, otherwise the single
// argument inferred from the first runtime argument whose type is a generic
// instance. The first argument is returned. Any beyond it are left in the
// `gargs` arena at p.call_xarg_start for p.call_xarg_count entries.
// The tuple a call names, whichever kind of generic the callee is. A callee
// taking a compile-time list is keyed by what that list was given; every other
// one by the type arguments written at the call.
call_args_for :: fn(mut p: Parser, head: i64, fn_index: i64) -> i64 {
    if (pack_call_args(p, head, fn_index)) {
        return p.call_pack_primary
    }
    call_type_args(p, head)
}

call_type_args :: fn(mut p: Parser, head: i64) -> i64 {
    mut count : i64 = 0
    mut first : i64 = TY_I64
    xstart := p.gargs.count
    mut id := head
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal) {
            if (count == 0) {
                first = vnode.val
            } else {
                arena_push(p.gargs, GArg { value = vnode.val, is_type = 0 })
            }
            count = count + 1
        }
        id = next_id
    }
    if (count > 0) {
        p.call_xarg_start = xstart
        p.call_xarg_count = count - 1
        return first
    }
    p.call_xarg_start = 0
    p.call_xarg_count = 0
    id = head
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        mut t := type_of(p, value)
        if (is_pointer(t)) {
            t = pointee(t)
        }
        // A runtime argument that is a generic instance carries the whole tuple
        // its parameters were bound to, so a call that leaves the arguments
        // implicit is monomorphized on every one of them, not just the first.
        if (is_struct_ty(t)) {
            si := struct_index_of(t)
            mut k : i64 = 0
            while (k < p.instances.count) {
                inst := arena_at(p.instances, k)
                if (inst.struct_index == si) {
                    p.call_xarg_start = inst.xarg_start
                    p.call_xarg_count = inst.xarg_count
                    return inst.arg
                }
                k = k + 1
            }
        }
        id = next_id
    }
    TY_I64
}

// Arguments evaluate right to left onto the stack and only then land in the
// registers the ABI names, so an argument that is itself a call cannot clobber
// one already computed.
// The value of the nth argument that survives to runtime, skipping the type
// arguments, which are erased.
record_mono_ret :: fn(mut p: Parser, fn_index: i64, arg: i64, xarg_start: i64,
    xarg_count: i64, ret: i64) {
    // The discovery pass runs until it finds nothing new, so the same
    // monomorphization is offered more than once and only the first is kept.
    mut i : i64 = 0
    while (i < p.mono_rets.count) {
        entry := arena_at(p.mono_rets, i)
        if (entry.fn_index == fn_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return
        }
        i = i + 1
    }
    arena_push(p.mono_rets,
        MonoRet { fn_index = fn_index, arg = arg, xarg_start = xarg_start,
            xarg_count = xarg_count, ret = ret })
}

// The concrete argument tuples the generics in this program are used with. A
// generic struct written as `Box<i64>` is one, and so is a call to a generic
// function, which used to be missed: instantiation was driven by the struct
// instances alone, so a generic function called with a type that no generic
// struct had been written with was called and never emitted.
//
// Distinct tuples rather than instances, since two generic structs written with
// the same arguments would otherwise have every generic function emitted twice.
// Which generic each tuple belongs to is deliberately not kept: the tuple of a
// call is inferred from its arguments, and out here, away from the function the
// call sits in, there is no local to infer from. A generic is tried against
// every tuple and `instance_fits` says which pairings are real.
note_type_args :: fn(mut p: Parser, arg: i64, xarg_start: i64, xarg_count: i64,
    is_pack: i64) {
    if (arg < 0 || arg == TY_PARAM) {
        return
    }
    // A call inside a generic template names the enclosing parameter as its
    // argument, so its argument is the unbound placeholder. That call is
    // re-parsed with a real argument for each instance. The placeholder itself
    // must not drive an instantiation, which would emit a `^T` for a T that is
    // no type.
    mut g : i64 = 0
    while (g < xarg_count) {
        entry := arena_at(p.gargs, xarg_start + g)
        if (entry.value == TY_PARAM) {
            return
        }
        g = g + 1
    }
    mut i : i64 = 0
    while (i < p.type_args.count) {
        entry := arena_at(p.type_args, i)
        if (entry.arg == arg && entry.xarg_count == xarg_count
            && entry.is_pack == is_pack
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return
        }
        i = i + 1
    }
    arena_push(p.type_args, TypeArg { arg = arg, xarg_start = xarg_start,
        xarg_count = xarg_count, is_pack = is_pack })
}

collect_type_args :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.instances.count) {
        entry := arena_at(p.instances, i)
        note_type_args(p, entry.arg, entry.xarg_start, entry.xarg_count, 0)
        i = i + 1
    }
    i = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        if (node.kind == NodeKind::Call && generic_fn_of(p, node.val) >= 0) {
            // A call to a generic taking a compile-time list was noted where it
            // was written, since what the list was given is the type of each
            // argument and only the parse has the names in scope to say what
            // those are.
            if (takes_pack(p, node.val) == false) {
                arg := call_type_args(p, node.a)
                note_type_args(p, arg, p.call_xarg_start, p.call_xarg_count, 0)
            }
        }
        i = i + 1
    }
}

mono_ret_type :: fn(mut p: Parser, fn_index: i64, arg: i64, xarg_start: i64,
    xarg_count: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.mono_rets.count) {
        entry := arena_at(p.mono_rets, i)
        if (entry.fn_index == fn_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return entry.ret
        }
        i = i + 1
    }
    TY_I64
}

// What a call answers with, which decides whether it needs a result buffer.
// The global function of this name, or -1. A function used as a value or called
// indirectly is found this way when the name is not a local.
fn_index_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.fns.count) {
        sym := arena_at(p.fns, i)
        if (sym.len == len && sym.defined == 1
            && bytes_equal(p.src, sym.off, off, len)) {
            return i
        }
        i = i + 1
    }
    0 - 1
}

// The function a bundle's field names, for a bundle that is a constant, or -1
// when the callee is anything else. `ops.less(a, b)` where `ops` is a constant
// whose `less` field names a function is a call to that function: the field can
// hold one value and it is known here, so nothing is loaded and nothing is
// called through a pointer.
bundle_field_fn :: fn(mut p: Parser, callee: i64) -> i64 {
    node := arena_at(p.arena, callee)
    if (node.kind != NodeKind::Field) {
        return 0 - 1
    }
    base := node.a
    field_off := node.val
    field_len := node.c
    base_node := arena_at(p.arena, base)
    if (base_node.kind != NodeKind::Var) {
        return 0 - 1
    }
    name_off := base_node.val
    name_len := base_node.c
    if (local_exists(p, name_off, name_len)) {
        return 0 - 1
    }
    literal := value_const_node(p, name_off, name_len)
    if (literal < 0) {
        return 0 - 1
    }
    literal_node := arena_at(p.arena, literal)
    if (literal_node.kind != NodeKind::StructLit) {
        return 0 - 1
    }
    mut id := literal_node.a
    while (id != (0 - 1)) {
        init := arena_at(p.arena, id)
        init_off := init.val
        init_len := init.c
        value := init.a
        next_id := init.next
        if (init_len == field_len
            && bytes_equal(p.src, init_off, field_off, field_len)) {
            value_node := arena_at(p.arena, value)
            if (value_node.kind != NodeKind::Var) {
                return 0 - 1
            }
            return fn_index_of(p, value_node.val, value_node.c)
        }
        id = next_id
    }
    0 - 1
}

// The function-pointer type of a global function: its parameter types and its
// return type interned as a signature. This is what a function's name stands
// for when it is used as a value.
fn_proc_type :: fn(mut p: Parser, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    ret := sym.ret_type
    param_start := p.proc_params.count
    mut count : i64 = 0
    mut pid := sym.params
    while (pid != (0 - 1)) {
        pnode := arena_at(p.arena, pid)
        arena_push(p.proc_params, GArg { value = pnode.b, is_type = 0 })
        count = count + 1
        pid = pnode.next
    }
    proc_of(p, ret, param_start, count)
}

// Whether a name is one of the type predicates, and what it answers of a type.
// The vocabulary is fixed and closed (spec 11.4a): every one of these is a
// question the compiler answers for itself to decide what to emit. Two things
// ask it, a `where` clause at a call and an expansion-time `if` in an unrolled
// body, and they ask the same one so the two cannot drift.
is_type_predicate :: fn(src: str, off: i64, len: i64) -> bool {
    str_range_eq(src, off, len, "is_numeric")
        || str_range_eq(src, off, len, "is_integer")
        || str_range_eq(src, off, len, "is_float")
        || str_range_eq(src, off, len, "is_struct")
        || str_range_eq(src, off, len, "is_array")
        || str_range_eq(src, off, len, "is_slice")
        || str_range_eq(src, off, len, "is_pointer")
}

predicate_holds :: fn(mut p: Parser, off: i64, len: i64, ty: i64) -> i64 {
    if (str_range_eq(p.src, off, len, "is_numeric")) {
        if (is_integer(ty) || is_float(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_integer")) {
        if (is_integer(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_float")) {
        if (is_float(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_struct")) {
        if (is_struct_ty(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_array")) {
        if (is_array_ty(ty) && is_slice_ty(p, ty) == false) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_slice")) {
        if (is_array_ty(ty) && is_slice_ty(p, ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_pointer")) {
        if (is_pointer(ty)) { return 1 }
        return 0
    }
    0 - 1
}

// Record what a name binds for the rest of this declaration's parse.
record_parse_local :: fn(mut p: Parser, off: i64, len: i64, ty: i64) {
    arena_push(p.parse_locals, LocalVar { name_off = off, name_len = len,
        ty = ty, slot = 0 })
}

// The type a name binds to in the declaration being parsed, or -1 when nothing
// here names it. The last binding wins, the same rule the emitters' table has.
parse_local_type :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = p.parse_locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    0 - 1
}

// The same, over the parameters of the declaration being parsed and nothing
// else. What an expansion-time `if` may ask about is a parameter, since that is
// what an instantiation decides and a local is not.
parse_param_type :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = p.parse_param_end
    while (i > p.parse_param_start) {
        i = i - 1
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    0 - 1
}

// The type of one argument given to a compile-time list. A name is what the
// declaration being parsed bound it to; anything else is derived the ordinary
// way.
pack_arg_type :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind == NodeKind::Var) {
        held := parse_local_type(p, node.val, node.c)
        if (held >= 0) {
            return held
        }
    }
    type_of(p, value)
}

// The field a name is bound to by a `for` over `fields(T)`, as the entry
// holding what it is and where it sits, or -1 when the name is not one.
field_binding_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = p.field_bindings.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.field_bindings, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
    }
    0 - 1
}

// Whether a callee takes a compile-time list.
takes_pack :: fn(mut p: Parser, fn_index: i64) -> bool {
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return false
    }
    gfn := arena_at(p.generic_fns, gi)
    gfn.pack_len > 0
}

// The argument tuple a call to a generic names, when the callee takes a
// compile-time list. The tuple is the type of every argument past the ordinary
// parameters, in order, which is what makes two calls giving different types
// two specializations. Answers false when the callee takes no list, leaving the
// ordinary path to work out the tuple.
pack_call_args :: fn(mut p: Parser, args: i64, fn_index: i64) -> bool {
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return false
    }
    gfn := arena_at(p.generic_fns, gi)
    pack_len := gfn.pack_len
    fixed := gfn.pack_fixed
    if (pack_len == 0) {
        return false
    }
    // How many compile-time parameters the callee declares before its list: the
    // primary one, if it has one, and the rest. A `$` argument fills those
    // first; anything past them is an element of the list.
    mut declared : i64 = gfn.xparam_count
    if (gfn.tparam_len > 0) {
        declared = declared + 1
    }
    // The run this call leaves behind is the callee's own compile-time
    // arguments past the first, then the list's elements. Both live in `gargs`
    // and both are part of what makes this specialization the one it is; what
    // separates them is the count the declaration wrote, which every reader of
    // the run already has.
    xstart := p.gargs.count
    mut primary : i64 = TY_I64
    mut types_seen : i64 = 0
    mut id := args
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal && types_seen < declared) {
            if (types_seen == 0) {
                primary = vnode.val
            } else {
                arena_push(p.gargs, GArg { value = vnode.val, is_type = 0 })
            }
            types_seen = types_seen + 1
        }
        id = next_id
    }
    mut count : i64 = 0
    mut index : i64 = 0
    mut seen : i64 = 0
    id = args
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        // A type past the declared compile-time parameters is an element of the
        // list: a name the body writes where a type belongs, taking no
        // parameter and evaluated nowhere.
        if (vnode.kind == NodeKind::TypeVal) {
            if (seen >= declared) {
                arena_push(p.gargs, GArg { value = vnode.val, is_type = 1 })
                count = count + 1
            }
            seen = seen + 1
        } else {
            if (index >= fixed) {
                arena_push(p.gargs,
                    GArg { value = pack_arg_type(p, value), is_type = 0 })
                count = count + 1
            }
            index = index + 1
        }
        id = next_id
    }
    p.call_xarg_start = xstart
    p.call_xarg_count = gfn.xparam_count + count
    p.call_pack_primary = primary
    true
}

call_ret_type :: fn(mut p: Parser, args: i64, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    // A call through a local of function-pointer type is indirect and answers
    // with that signature's return type.
    if (local_exists(p, sym.off, sym.len)) {
        local_ty := lookup_local(p, sym.off, sym.len)
        if (is_proc(local_ty)) {
            return proc_ret(p, local_ty)
        }
    }
    if (generic_fn_of(p, fn_index) >= 0) {
        arg := call_args_for(p, args, fn_index)
        return mono_ret_type(p, fn_index, arg, p.call_xarg_start,
            p.call_xarg_count)
    }
    sym.ret_type
}

nth_value_arg :: fn(mut p: Parser, args: i64, n: i64) -> i64 {
    mut id := args
    mut seen : i64 = 0
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            if (seen == n) {
                return value
            }
            seen = seen + 1
        }
        id = next_id
    }
    0 - 1
}

count_value_args :: fn(mut p: Parser, args: i64) -> i64 {
    mut id := args
    mut count : i64 = 0
    while (id != (0 - 1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            count = count + 1
        }
        id = next_id
    }
    count
}

