// Typing and the checks that ride on it: locals, moves, linearity, field and
// expression types, and the concrete return type of a generic call.

import "core.frost"
import "lexer.frost"
import "cursor.frost"
import "imports.frost"
import "names.frost"
import "layout.frost"

export call_ret_type, call_type_args, call_args_for, collect_type_args,
    settle_pack_args, tparam_position, gparam_position, word_is_gparam,
    written_gparam_count,
    first_settled_gparam, has_fallback_gparam, fallback_gparam_count,
    settled_type_args, nth_type_arg,
    hold_pending_tuple,
    settle_pending_tuples, hold_declaration, restore_declaration,
    MONO_DEPTH_MAX, Declaring,
    fn_index_of, note_type_args, takes_pack, pack_call_args,
    note_format_forward, note_format_call, check_format_types,
    parse_call_type_args,
    is_type_predicate, predicate_holds, record_parse_local, untyped_literal,
    parse_local_type,
    parse_local_type, parse_param_type, field_binding_of,
    fn_proc_type, bundle_field_fn,
    count_value_args, field_type, generic_fn_of, is_linear_type, is_moved,
    constant_node,
    local_exists, lookup_local, lower_enum_compare, nth_param_by_value,
    nth_param_type, nth_value_arg, nth_param_auto_borrows,
    param_node_by_value,
    borrow_kept, pack_local_type, operand_type,
    reads_through_borrow,
    record_local, record_mono_ret, type_cache_prepare, type_of, binding_type,
    place_type,
    types_compatible, value_fits, untyped_literal, is_str_literal

// `a == b` on two enum values asks which variant each is, and that is the tag
// they both carry. An enum is laid out as a struct with `tag` beside every
// variant's fields, so this rewrites the two sides to read that field, the same
// way a `match` on an enum switches on `e.tag`. Both backends call it, so
// neither has to know that an enum comparison is different from any other.
//
// It runs during emit rather than before it, because a local's type is recorded
// as the emitter walks the body, so nothing earlier can say what `a` is. It is
// idempotent: once rewritten the sides are integers and the test is false.
//
// A variant with fields makes the question ambiguous, since two values can be
// the same variant and hold different things, so that one is refused.
lower_enum_compare :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    op := node.val
    left := node.a
    right := node.b
    position := node.pos
    if (op != OP_EQ && op != OP_NE) {
        return
    }
    // An enum reached through a borrow is still that enum, which is what a
    // parameter of enum type is. A field access through a pointer reads
    // through it, so the tag is reached the same way either way.
    mut ty := type_of(p, left)
    if (is_pointer(ty)) {
        ty = pointee(p, ty)
    }
    if (is_struct_ty(ty) == false) {
        return
    }
    def := arena_at(p.structs, struct_index_of(ty))
    if (def.is_enum != 1) {
        return
    }
    first_field := def.field_head
    if (first_field != (-1)) {
        field := arena_at(p.fields, first_field)
        if (field.next != (-1)) {
            report_where(p.modules, p.src, position)
            report("an enum whose variants carry fields cannot be compared with ==, since two values can be the same variant and hold different things; match on it instead")
            frost_rt_recover_escape()
        }
    }
    // Both nodes are made before the one being rewritten is reached for, since
    // pushing to the arena can move it and a borrow taken first would be
    // writing to where it was.
    tag_left := enum_tag_operand(p, left)
    tag_right := enum_tag_operand(p, right)
    mut held := arena_at(p.arena, id)
    held.a = tag_left
    held.b = tag_right
}

// The tag of one side of an enum comparison. `Kind::Var` is a struct literal
// whose tag is written into it, so the value it was given is used directly:
// reading a field of a literal would need its address, and a literal is not a
// place either backend can take one of. Anything else is a place, so the tag is
// read out of it.
enum_tag_operand :: fn(mut p: Parser, side: i64) -> i64 {
    node := arena_at(p.arena, side)
    if (node.kind == NodeKind::StructLit) {
        mut init := node.a
        while (init != (-1)) {
            held := arena_at(p.arena, init)
            value := held.a
            name_off := held.val
            name_len := held.c
            next_init := held.next
            if (name_len == 3 && name_off == p.name_tag) {
                return value
            }
            init = next_init
        }
    }
    new_field_node(p, side, p.name_tag, 3)
}

// The declared type of the nth parameter, or -1 past the end of the list. An
// argument is classified and converted by what the callee said it takes rather
// than by what the caller happened to write.
nth_param_type :: fn(mut p: Parser, params: i64, n: i64) -> i64 {
    mut id := params
    mut index: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        if (index == n) {
            return node.b
        }
        index = index + 1
        id = node.next
    }
    -1
}

// Whether a parameter was declared `value`, so the struct crosses to C the way
// C passes one rather than as an address. Recorded beside the parameter nodes
// rather than on them, because the placement is the only thing it changes.
param_node_by_value :: fn(mut p: Parser, param_node: i64) -> bool {
    mut entry: i64 = 0
    while (entry < p.value_params.count) {
        held := arena_at(p.value_params, entry)
        if (held.name_off == param_node) {
            return true
        }
        entry = entry + 1
    }
    false
}

// Whether the nth parameter borrows what it is given, so the call site is what
// takes the address. An aggregate is already reached by address and a scalar is
// not, and this is what says so.
nth_param_auto_borrows :: fn(mut p: Parser, params: i64, n: i64) -> bool {
    mut id := params
    mut index: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        borrows := node.a
        if (index == n) {
            return borrows == 1
        }
        index = index + 1
        id = next_id
    }
    false
}

nth_param_by_value :: fn(mut p: Parser, params: i64, n: i64) -> bool {
    mut id := params
    mut index: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (index == n) {
            return param_node_by_value(p, id)
        }
        index = index + 1
        id = next_id
    }
    false
}

// A name may be bound more than once in one body, once per sibling scope, and
// the binding in scope is the one bound most recently. Locals are recorded in
// declaration order and never popped, so that is the last matching entry, not
// the first: `emit_program` binds `node` to an i64 and later to a `^Node`, and
// answering with the i64 types `node^.next` as a scalar and reads offset zero.
lookup_local :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    TY_I64
}

// Whether a name is in scope as a parameter or local. lookup_local answers with
// a type and defaults an unknown name to i64, which cannot distinguish "an i64"
// from "not declared", so a check needs this instead.
// Whether a value of type `from` may stand in for `to`. Scalars and pointers
// convert freely, the way the emitted C does, and a type parameter matches
// anything because it is a placeholder. A struct only matches the same struct,
// which is where real mistakes show up.
// A literal has no type of its own until the context gives it one, which is
// what makes `m : Meters = 3` read the way it should. An arithmetic expression
// built only out of literals is still one, so `m : Meters = 60 * 60` reads the
// same way.
untyped_literal :: fn(mut p: Parser, id: i64) -> bool {
    if (id < 0) {
        return false
    }
    // A constant is written out where it is named, so the question is asked of
    // what it stands for: `PITCH_LIMIT` read at an `f32` is the same as writing
    // the number there. A local of the same name is a value with a type and
    // shadows it, which `constant_node` answers for.
    node := arena_at(p.arena, constant_node(p, id))
    if (node.kind == NodeKind::Num) {
        // A bit of a flags type is written as a name and carries that type, so
        // it is not one of the numbers the context gets to type.
        return node.b == 0
    }
    if (node.kind == NodeKind::Float) {
        return true
    }
    // An integer constant is a name for a number too, and is kept in a table of
    // its own rather than as a node, so it is asked about separately.
    if (node.kind == NodeKind::Var && local_exists(p, node.val, node.c) == false
        && is_const(p, node.val, node.c)) {
        return true
    }
    if (node.kind == NodeKind::Bin && op_answers_truth(node.val) == false) {
        if (untyped_literal(p, node.a) && untyped_literal(p, node.b)) {
            return true
        }
        // A literal mixed with an integer has no width of its own either: the
        // only float in `0.3 + count` is the literal, and the integer converts
        // to whatever float the context asks for. One typed float on either
        // side does fix the width, and then it is not one of these.
        if (untyped_literal(p, node.a) && is_integer(operand_type(p, node.b))) {
            return true
        }
        if (untyped_literal(p, node.b) && is_integer(operand_type(p, node.a))) {
            return true
        }
    }
    false
}

// The type a `x := value` binding takes. A borrowed aggregate named by a plain
// name is copied into the binding rather than aliased, so naming it means the
// value the caller holds. Only a name: a call that answers with a `ref T`
// handed out a borrow on purpose, and `ref x := place` asks for one, so both
// keep what they were given.
binding_type :: fn(mut p: Parser, value: i64) -> i64 {
    // An address, a field or an element written over a name, read the way an
    // argument is. The walks' table is empty while a declaration is being read,
    // so `type_of` answers off a root it reads as `i64`, and a name bound to one
    // carried that into every call it was handed to: `one := held[i]` followed
    // by `print(fmt, one.name, ...)` filed a list holding a number where it
    // holds text.
    bound_kind := arena_at(p.arena, value).kind
    if (bound_kind == NodeKind::AddrOf || bound_kind == NodeKind::Field
        || bound_kind == NodeKind::Index) {
        held := argument_type(p, value)
        if (held >= 0) {
            return held
        }
    }
    ty := type_of(p, value)
    node := arena_at(p.arena, value)
    // A string literal is a pointer where a `^i8` is asked for and a `str`
    // where a `str` is, and a binding with no annotation asks for neither. It
    // takes `str`, which is what the language calls text and what every
    // operation over one expects. A program wanting the pointer says `^i8`.
    //
    // It has to be settled here rather than left to the coercion, because the
    // length is read out of the source while the literal is still in hand. A
    // binding that kept the pointer would have nowhere to recover it from. A
    // name standing for a literal is the literal, and binding one has the same
    // nowhere to recover the length from.
    if (arena_at(p.arena, constant_node(p, value)).kind == NodeKind::StrLit) {
        return array_of(p, TY_U8, -1)
    }
    if (node.kind != NodeKind::Var) {
        return ty
    }
    if (is_borrow(ty) && is_aggregate(pointee(p, ty))) {
        return pointee(p, ty)
    }
    ty
}

// What an assignment's place denotes. A `mut` parameter of aggregate type
// travels as an address, and the name stands for the aggregate rather than for
// the address, which is how `binding_type` reads one on the other side of the
// `=`. A field or an element off such a name is reached through the address
// like any other, so only the whole value asks this.
place_type :: fn(mut p: Parser, place: i64) -> i64 {
    ty := type_of(p, place)
    if (arena_at(p.arena, place).kind != NodeKind::Var) {
        return ty
    }
    if (is_borrow(ty) && is_aggregate(pointee(p, ty))) {
        return pointee(p, ty)
    }
    ty
}

// Whether a value of type `from` may be given to something of type `to`, with
// the value in hand, so a literal can be exempt from the distinct-type rule.
// The number a literal spells, folded the same way `untyped_literal` decides
// whether it is one. Only integers: a float is not range-checked here.
literal_value :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Num) {
        return node.val
    }
    if (node.kind == NodeKind::Var && local_exists(p, node.val, node.c) == false
        && is_const(p, node.val, node.c)) {
        return const_value(p, node.val, node.c)
    }
    if (node.kind == NodeKind::Bin) {
        left := literal_value(p, node.a)
        right := literal_value(p, node.b)
        if (node.val == OP_ADD) { return left + right }
        if (node.val == OP_SUB) { return left - right }
        if (node.val == OP_MUL) { return left * right }
        if (node.val == OP_DIV && right != 0) { return left / right }
        if (node.val == OP_MOD && right != 0) { return left % right }
        if (node.val == OP_BITAND) { return left & right }
        if (node.val == OP_BITOR) { return left | right }
        if (node.val == OP_SHL && right >= 0 && right < 64) {
            return left << right
        }
        if (node.val == OP_SHR && right >= 0 && right < 64) {
            return left >> right
        }
    }
    0
}

// The smallest and largest a type holds. `usize` and `isize` are the word this
// compiler targets, which is sixty-four bits everywhere it runs, and a literal
// is read as an i64, so the top half of a u64 cannot be written as one anyway.
integer_low :: fn(ty: i64) -> i64 {
    held := distinct_repr(ty)
    if (held == TY_I8) { return -128 }
    if (held == TY_I16) { return -32768 }
    if (held == TY_I32) { return -2147483648 }
    // A u64 is as wide as the literal, so a negative one loses no bits and is
    // the only way to write a sentinel of all ones while there are no hex
    // literals. The narrower unsigned types do lose bits, and are refused.
    if (held == TY_I64 || held == TY_ISIZE || held == TY_U64
        || held == TY_USIZE) {
        return -9223372036854775807 - 1
    }
    0
}

integer_high :: fn(ty: i64) -> i64 {
    held := distinct_repr(ty)
    if (held == TY_I8) { return 127 }
    if (held == TY_U8) { return 255 }
    if (held == TY_I16) { return 32767 }
    if (held == TY_U16) { return 65535 }
    if (held == TY_I32) { return 2147483647 }
    if (held == TY_U32) { return 4294967295 }
    9223372036854775807
}

// Whether reading one type at another can lose what it holds: a narrower
// integer, or a float becoming one. Widening loses nothing and stays implicit.
is_narrowing :: fn(from: i64, to: i64) -> bool {
    held_from := distinct_repr(from)
    held_to := distinct_repr(to)
    if (is_float(held_from) && is_integer(held_to)) {
        return true
    }
    if (is_integer(held_from) && is_integer(held_to)) {
        return scalar_size(held_to) < scalar_size(held_from)
    }
    if (is_float(held_from) && is_float(held_to)) {
        return scalar_size(held_to) < scalar_size(held_from)
    }
    false
}

value_fits :: fn(mut p: Parser, value: i64, from: i64, to: i64) -> bool {
    // A conversion that can lose the value is the reader's to ask for: an i64
    // of 300 read at a u8 is 44. A literal is exempt, since one is checked
    // against the range it is written at instead. Two different named types are
    // a different complaint, and the one that names them says more than a width
    // does, so this fires only between the same type and between plain ones.
    named := is_distinct(from) || is_distinct(to)
    if (from == to || named == false) {
        if (is_narrowing(from, to) && untyped_literal(p, value) == false) {
            report_where(p.modules, p.src, arena_at(p.arena, value).pos)
            report("this is a '")
            report_type_name(p, from)
            report("' and a '")
            report_type_name(p, to)
            report("' is wanted, which cannot hold all of one; write cast($")
            report_type_name(p, to)
            report(", ...) to say the loss is meant")
            frost_rt_recover_escape()
        }
    }
    // A literal that does not fit what it is being read at. The type is in hand
    // and so is the number, which is the whole of what a range check needs.
    if (value >= 0 && is_integer(to) && untyped_literal(p, value)) {
        held := literal_value(p, value)
        if (held < integer_low(to) || held > integer_high(to)) {
            report_where(p.modules, p.src, arena_at(p.arena, value).pos)
            report_fmt("{} does not fit in a '", held)
            report_type_name(p, to)
            report_fmt(
                "', which holds {} to {}",
                integer_low(to),
                integer_high(to)
            )
            frost_rt_recover_escape()
        }
    }
    // A set of bits has no such exemption. Its whole content is the names, so a
    // number written where one belongs is the thing the declaration replaces.
    if (is_flags_type(p, to)) {
        return from == to
    }
    if (is_distinct(to) && untyped_literal(p, value)) {
        return types_compatible(p, from, distinct_repr(to))
    }
    // A string literal is bytes the compiler wrote down, so it knows how many
    // there are and hands a slice its length. That is the one pointer a slice of
    // bytes accepts, and it is the expression rather than the type that says so.
    if (is_pointer(from) && is_array_ty(to) && is_slice_ty(p, to)
        && array_element(p, to) == TY_U8 && is_str_literal(p, value)) {
        return true
    }
    // Text is a run of bytes, and what it reaches is a run of them or an
    // address a call into C reads. Its type here is the address it holds, and
    // an address reaches a whole number so that a call into C can hand one
    // over, so `show("abc")` filled an `i64` parameter with a pointer and
    // nothing said a word. Asked of the expression, the way the allowance above
    // is, since being a literal is what decides it.
    if (is_str_literal(p, value) && is_array_ty(to) == false
        && is_pointer(to) == false) {
        return false
    }
    types_compatible(p, from, to)
}

// Whether an expression is text written down in the source, which is the one
// pointer that reaches a slice of bytes. A named constant holding one is the same
// literal under a name, which is what `constant_node` reaches through.
is_str_literal :: fn(mut p: Parser, value: i64) -> bool {
    if (value < 0) {
        return false
    }
    arena_at(p.arena, constant_node(p, value)).kind == NodeKind::StrLit
}

// One part of a function type against the matching part of another, with a
// borrow read through on either side.
parts_fit :: fn(mut p: Parser, from: i64, to: i64) -> bool {
    mut left := from
    mut right := to
    if (is_borrow(left)) {
        left = pointee(p, left)
    }
    if (is_borrow(right)) {
        right = pointee(p, right)
    }
    types_compatible(p, left, right)
}

types_compatible :: fn(mut p: Parser, from: i64, to: i64) -> bool {
    if (from == to) {
        return true
    }
    // A type parameter stands for a type not yet known, so nothing is decided
    // against it. Asked before the question below, because a type nobody has
    // bound yet is not a type to judge a value against.
    if (from == TY_PARAM || to == TY_PARAM) {
        return true
    }
    // Nothing is not a value. A call that answers nothing has none to hand
    // over, so it reaches no place that holds one. Asked here because what is
    // left at the end of this chain answers `true`, and a void fell through
    // every question on the way down and reached every type there is.
    //
    // One way only. A value where nothing is wanted is a value dropped, which
    // is what a call written as a statement is, and the bootstrap reads it that
    // way; a nothing where a value is wanted has nothing to read.
    if (from == TY_VOID) {
        return false
    }
    // A distinct type is built only from itself, so neither its representation
    // nor another distinct type over the same representation will do. What the
    // name protects is what goes in. Reading one as what it is represented by
    // is allowed, and is what a call into C is.
    if (is_distinct(to)) {
        return false
    }
    if (is_distinct(from)) {
        return types_compatible(p, distinct_repr(from), to)
    }
    if (is_pointer(from) && is_pointer(to)) {
        return true
    }
    // An aggregate is held by address, so an expression that answers with the
    // address of one is that value: `slice[index]` of a struct answers with a
    // pointer, and handing it to a place of the struct's own type is a copy of
    // the element, not a type error.
    if (is_pointer(from) && is_aggregate(to) && pointee(p, from) == to) {
        return true
    }
    // A parameter of array type is a borrow, so the name holds where the
    // caller's array sits. It reaches a slice of the whole of itself the way
    // the array written out does: the length a slice needs is part of the
    // array's type, and the borrow still names that type. Asked of a borrow
    // alone, so a raw pointer meets the rule below.
    if (is_borrow(from) && is_array_ty(to) && is_slice_ty(p, to)) {
        held := pointee(p, from)
        if (is_array_ty(held) && is_slice_ty(p, held) == false
            && array_element(p, held) == array_element(p, to)) {
            return true
        }
    }
    // An array reaches a slice of its own element type and nothing else. Two
    // arrays that are not the same type were caught above. A bare pointer
    // reaches neither: a slice is an address and a length, and a pointer is the
    // address without the length, so what a callee would read for the length is
    // whatever sat beside it. The one pointer that does reach a slice is a
    // string literal, which `value_fits` answers for, since being a literal is a
    // question about the expression rather than about its type.
    if (is_array_ty(from) || is_array_ty(to)) {
        return (is_array_ty(from) && is_array_ty(to) && is_slice_ty(p, to)
            && array_element(p, from) == array_element(p, to))
    }
    if (is_struct_ty(from) || is_struct_ty(to)) {
        return false
    }
    // A function type is its parameters and its answer, and two fit when their
    // parts do. Without this a function value fell to the answer at the end of
    // this chain and every signature reached every other: a name taking two
    // parameters was handed to a place wanting one, the call passed one, and
    // the callee read whatever sat in the register for the other.
    //
    // A borrow is read through on both sides. An aggregate travels by address
    // whichever mode declared it, so a parameter written `mut Ctx` and one
    // written `Ctx` are one parameter in a signature, which is what lets a
    // handler that writes to its context fill a slot declared without the mode.
    if (is_proc(from) || is_proc(to)) {
        if (is_proc(from) == false || is_proc(to) == false) {
            return false
        }
        count := proc_param_count(p, from)
        if (proc_param_count(p, to) != count) {
            return false
        }
        mut k: i64 = 0
        while (k < count) {
            if (parts_fit(p, proc_param_at(p, from, k), proc_param_at(p, to, k)) == false) {
                return false
            }
            k = k + 1
        }
        return parts_fit(p, proc_ret(p, from), proc_ret(p, to))
    }
    // What is left is scalars and pointers. A pointer is an address and an
    // address is a whole number, which is what a call into C hands over and
    // what address arithmetic reads back, so a pointer and an integer reach
    // each other. A float holds a different encoding of the same bits and a
    // bool holds one of two values, so reading an address as either is a
    // mistake the reference compiler names and this one took.
    if (is_pointer(from) != is_pointer(to)) {
        mut held := to
        if (is_pointer(to)) {
            held = from
        }
        if (is_float(held) || held == TY_BOOL) {
            return false
        }
        // An address is a whole number, which is the one crossing left here.
        return true
    }
    // A number, a truth value and an address are three kinds of thing, and one
    // does not become another without a cast saying so. Two numbers reach each
    // other, whole or not: how wide they are is the narrowing rule's question
    // rather than this one's, and the bootstrap reads a number into a number
    // the same way.
    //
    // This chain ended in `true`, so every scalar reached every other: an i64
    // filled a `bool` and nothing said a word.
    // A value where nothing is wanted is a value dropped, which is what a call
    // written as a statement is.
    if (to == TY_VOID) {
        return true
    }
    // A handle is a whole number under a name of its own, and the containers
    // hand one back where a number is held.
    holds_a_number(from) && holds_a_number(to)
}

// Whether a type carries a number: whole, fractional, or a handle, which is a
// whole one under a name of its own. A truth value is not one of them.
holds_a_number :: fn(ty: i64) -> bool {
    is_integer(ty) || is_float(ty) || ty == TY_HANDLE
}

local_exists :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i: i64 = p.locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
    }
    false
}

// The node a name stands for when it names a constant that is a value, and the
// node itself otherwise.
//
// A value constant is its literal wherever it is written, so every question
// about the literal has to be asked of the literal: what type it has, whether
// indexing it is checked, what to emit for it. Asking the name instead answers
// about a name, which is how a string constant came to be a thing that could be
// declared and then not indexed.
constant_node :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    if (node.kind != NodeKind::Var) {
        return id
    }
    if (local_exists(p, node.val, node.c)) {
        return id
    }
    held := value_const_node(p, node.val, node.c)
    if (held < 0) {
        return id
    }
    held
}

// Whether the value named (off, len) has been moved on the current path, read
// by the flow-aware move check as it walks a function body.
is_moved :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i: i64 = 0
    while (i < p.moved.count) {
        entry := arena_at(p.moved, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

is_linear_type :: fn(mut p: Parser, ty: i64) -> bool {
    // A run of resources is a resource: freeing the run is not freeing what is
    // in it, and a fixed array holds its elements by value. A slice does not
    // own what it looks at, so it answers for nothing, and it is told from an
    // array by carrying no length of its own.
    //
    // A distinct type is whichever the type it stands for is, which
    // `distinct_repr` answers at the front of every other type predicate too.
    if (is_array_ty(ty) && is_slice_ty(p, ty) == false) {
        return is_linear_type(p, array_element(p, ty))
    }
    if (is_struct_ty(ty) == false) {
        return false
    }
    // A struct code that names no struct is a type still being worked out, such
    // as a generic's declared return before it is instantiated. It is not a
    // resource, and reading past the table to decide would be a crash.
    index := struct_index_of(ty)
    if (index < 0 || index >= p.structs.count) {
        return false
    }
    def := arena_at(p.structs, index)
    if (def.is_linear == 1) {
        return true
    }
    false
}

record_local :: fn(mut p: Parser, off: i64, len: i64, ty: i64) {
    // The frame slot is decided here, once, rather than by adding up every
    // local's size at each mention of the name. That sum was the native
    // backend's inner loop: quadratic in a function's locals, with a type's
    // size measured again on every step of it.
    p.frame_used = p.frame_used + align_up(type_size(p, ty), 8)
    arena_push(
        p.locals,
        LocalVar {
            name_off = off,
            name_len = len,
            ty = ty,
            slot = -p.frame_used
        }
    )
}

// The type of a struct field. The base type may be a pointer (a borrow of a
// struct or a `^T`), which is dereferenced one level first, so `a.count` and
// `node^.next` both resolve.
field_type :: fn(mut p: Parser, base_ty: i64, off: i64, len: i64) -> i64 {
    mut struct_ty := base_ty
    if (is_pointer(struct_ty)) {
        struct_ty = pointee(p, struct_ty)
    }
    if (is_struct_ty(struct_ty) == false) {
        return TY_I64
    }
    def := arena_at(p.structs, struct_index_of(struct_ty))
    struct_off := def.name_off
    struct_len := def.name_len
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return field.ty
        }
        fid = field.next
    }
    // The base is a struct but carries no such field. Emitting the access
    // verbatim would leave it for whatever compiles the output to notice.
    report_where(p.modules, p.src, off)
    report("struct '")
    report_src(p.src, struct_off, struct_len)
    report("' has no field '")
    report_src(p.src, off, len)
    report("'")
    frost_rt_recover_escape()
    TY_I64
}

// Fill the type cache with one empty slot per possible node index. The node
// arena is a fixed allocation, so its capacity bounds every id a monomorphized
// instance can later take, and a slot per capacity covers them all without the
// cache ever having to grow alongside the arena.
type_cache_prepare :: fn(mut p: Parser) {
    while (p.type_cache.count < p.type_cache.cap) {
        arena_push(p.type_cache, TypeCacheEntry { ty = 0 })
    }
}

// The type of a node. During emit the answer is memoized per node index, since
// emit asks for the same node's type many times and re-deriving it walks the
// symbol tables each time. A slot holds the type plus one, so an untouched zero
// slot is "not computed" and a real type of zero still stores as one. The checks
// run with type_cache_on off, so a type derived under a generic binding it will
// not have at emit is never cached.
type_of :: fn(mut p: Parser, id: i64) -> i64 {
    if (p.type_cache_on == 1 && id >= 0 && id < p.type_cache.count) {
        slot := arena_at(p.type_cache, id)
        if (slot.ty != 0) {
            return slot.ty - 1
        }
        result := type_of_compute(p, id)
        stored := arena_at(p.type_cache, id)
        stored.ty = result + 1
        return result
    }
    type_of_compute(p, id)
}

type_of_compute :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::StrLit) {
        return POINTER_BASE + TY_I8
    }
    // A number written as a bit of a flags type carries that type. Every other
    // one takes its type from where it was written.
    if (kind == NodeKind::Num && node.b != 0) {
        return node.b - 1
    }
    if (kind == NodeKind::StructLit) {
        return node.val
    }
    if (kind == NodeKind::Var) {
        // A name that is not a local but is a global function is that function
        // used as a value: it stands for the function's address, of the
        // function-pointer type its signature makes.
        if (local_exists(p, node.val, node.c) == false) {
            fi := fn_index_of(p, node.val, node.c)
            if (fi >= 0) {
                return fn_proc_type(p, fi)
            }
            // A struct constant is its literal, so it has the literal's type.
            value_node := value_const_node(p, node.val, node.c)
            if (value_node >= 0) {
                return type_of(p, value_node)
            }
        }
        return lookup_local(p, node.val, node.c)
    }
    if (kind == NodeKind::Call) {
        // A call a template's own parse produced from a list that is not bound
        // names no instantiation, so asking it for one would make a
        // specialization out of elements that do not exist. The parse it
        // belongs to is thrown away and done again per instance.
        if (node.b == 1) {
            return TY_I64
        }
        // A generic function's declared return type still mentions its type
        // parameter, so a call answers with the concrete type recorded for the
        // instantiation it names.
        return call_ret_type(p, node.a, node.val)
    }
    if (kind == NodeKind::Field) {
        base := node.a
        off := node.val
        len := node.c
        // `c[h].field` on a columns container yields one element of that field's
        // column, so the type is the column array's element, not the column.
        base_node := arena_at(p.arena, base)
        if (base_node.kind == NodeKind::Index) {
            cbase_ty := type_of(p, base_node.a)
            mut cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(p, cthrough)
            }
            if (type_of(p, base_node.b) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                col := field_type_by_range(p, cthrough, off, len)
                return array_element(p, col)
            }
        }
        base_ty := type_of(p, base)
        return field_type(p, base_ty, off, len)
    }
    if (kind == NodeKind::Deref) {
        inner := node.a
        t := type_of(p, inner)
        if (is_pointer(t)) {
            return pointee(p, t)
        }
        return TY_I64
    }
    if (kind == NodeKind::Index) {
        base := node.a
        t := type_of(p, base)
        // A literal is a `^i8` everywhere else, because that is what a call
        // taking one wants and the coercion builds text out of it where text is
        // wanted. Indexed, it is neither: the compiler read the bytes out of
        // the source and knows how many there are, so the read is checked and
        // answers a byte. A constant that is a string is this literal wherever
        // it is named, so this is what makes one indexable.
        if (arena_at(p.arena, constant_node(p, base)).kind
            == NodeKind::StrLit) {
            return TY_U8
        }
        // A slab indexed by a handle yields one of its stored elements, so the
        // type is the storage array's element, not the slab.
        if (type_of(p, node.b) == TY_HANDLE && is_slab_ty(p, t)) {
            return array_element(p, slab_field_type(p, t, "storage"))
        }
        if (is_array_ty(t)) {
            return array_element(p, t)
        }
        if (is_pointer(t)) {
            inner := pointee(p, t)
            if (is_array_ty(inner)) {
                return array_element(p, inner)
            }
            return inner
        }
        return t
    }
    if (kind == NodeKind::SliceLen || kind == NodeKind::TrailingZeros) {
        return TY_I64
    }
    if (kind == NodeKind::Assert) {
        return TY_VOID
    }
    // A literal says both halves of its own type: the element from a declared
    // type when one was in force, otherwise from the first thing in it, and the
    // length from how many there are.
    if (kind == NodeKind::ArrayLit) {
        mut element: i64 = TY_I64
        if (node.val != 0) {
            element = node.val - 1
        } else {
            if (node.a != (-1)) {
                first := arena_at(p.arena, node.a)
                element = type_of(p, first.a)
            }
        }
        return array_of(p, element, node.c)
    }
    if (kind == NodeKind::Ref) {
        return borrow_of(p, type_of(p, node.a))
    }
    if (kind == NodeKind::SliceFrom) {
        return node.val
    }
    if (kind == NodeKind::AddrOf) {
        inner := node.a
        // A name that is already an address, a `mut` aggregate parameter or a
        // `ref` binding, stands for the caller's storage: its address is the
        // one it carries, not the address of the cell carrying it.
        inner_node := arena_at(p.arena, inner)
        inner_ty := type_of(p, inner)
        if (inner_node.kind == NodeKind::Var && is_borrow(inner_ty)) {
            return pointer_to(p, pointee(p, inner_ty))
        }
        return pointer_to(p, inner_ty)
    }
    if (kind == NodeKind::Cast) {
        return node.val
    }
    if (kind == NodeKind::PtrCast) {
        // A function type is already an address, so naming one asks for that
        // function type rather than for a pointer to it. This is what lets a
        // table of callbacks hold one shape while each registration is written
        // against the state it belongs to.
        if (is_proc(node.val)) {
            return node.val
        }
        return pointer_to(p, node.val)
    }
    // A float literal is the digits until something says how wide they are, the
    // way an integer literal is. What said so is written on the node by
    // `want_single`, since the emitters ask a node for its type long after the
    // context that wanted it is gone.
    if (kind == NodeKind::Float) {
        if (node.a == 1) {
            return TY_F32
        }
        return TY_F64
    }
    // Arithmetic answers i64 whatever it was handed, which is deliberate: a
    // narrower operand widening to the result rather than the result narrowing
    // to the operand is what keeps a byte fed into an i64 accumulator from
    // being computed at eight bits. Floats are the exception, since an integer
    // result there would be the wrong kind of number rather than the wrong
    // width, and a comparison answers a truth value either way.
    // A call through a value answers with what that signature answers with.
    if (kind == NodeKind::CallPtr) {
        callee_ty := type_of(p, node.a)
        if (is_proc(callee_ty)) {
            return proc_ret(p, callee_ty)
        }
        return TY_I64
    }
    if (kind == NodeKind::Bin) {
        // A comparison answers a truth value, not the number it compared. It
        // said `i64` here, which nothing caught while every scalar reached
        // every other, and `-> bool` bodies answering `a == b` were checked
        // against the wrong type.
        if (op_answers_truth(node.val)) {
            return TY_BOOL
        }
        left := operand_type(p, node.a)
        right := operand_type(p, node.b)
        // Two vectors answer with a vector. The operation is done once per
        // lane, and what comes out is as wide as what went in, so a borrow the
        // operand arrived as is read through here.
        held := vector_of(p, left)
        if (held >= 0) {
            return held
        }
        // Arithmetic on a distinct type answers with that type. Adding two
        // lengths gives a length, and the sum can go back where either came
        // from, which is the whole reason to have named the type.
        if (is_distinct(left)) {
            return left
        }
        if (is_distinct(right)) {
            return right
        }
        // A literal has no width of its own, so it takes the other operand's:
        // `byte + 32` where `byte` is a `u8` is a `u8` and `1.0 / length` where
        // `length` is an `f32` is an `f32`. Two operands of one type stay that
        // type, and genuinely mixed widths widen to the wider, which holds both.
        if (is_float(left) && is_float(right)) {
            if (untyped_literal(p, node.b)) {
                return left
            }
            if (untyped_literal(p, node.a)) {
                return right
            }
            if (scalar_size(left) >= scalar_size(right)) {
                return left
            }
            return right
        }
        if (is_float(left)) {
            return left
        }
        if (is_float(right)) {
            return right
        }
        if (is_integer(left) && is_integer(right)) {
            if (untyped_literal(p, node.b)) {
                return left
            }
            if (untyped_literal(p, node.a)) {
                return right
            }
            if (scalar_size(left) >= scalar_size(right)) {
                return left
            }
            return right
        }
        return TY_I64
    }
    TY_I64
}

// The generic-fns index of a function, or -1 if it is not generic.
generic_fn_of :: fn(mut p: Parser, fn_index: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.generic_fns.count) {
        entry := arena_at(p.generic_fns, i)
        if (entry.fn_index == fn_index) {
            return i
        }
        i = i + 1
    }
    -1
}

// Determine the concrete argument tuple of a generic call: the explicit `$Type`
// and `$value` arguments in order if there are any, otherwise the single
// argument inferred from the first runtime argument whose type is a generic
// instance. The first argument is returned. Any beyond it are left in the
// `gargs` arena at p.call_xarg_start for p.call_xarg_count entries.
// The tuple a call names, whichever kind of generic the callee is. A callee
// taking a compile-time list is keyed by what that list was given, every other
// one by the type arguments written at the call.
call_args_for :: fn(mut p: Parser, head: i64, fn_index: i64) -> i64 {
    if (pack_call_args(p, head, fn_index)) {
        return p.call_pack_primary
    }
    call_type_args(p, head, generic_fn_of(p, fn_index))
}

// How many compile-time parameters one generic may declare. The bound tuple is
// worked out into a run of this many before any of it is filed, so a generic
// past it is named where it is declared rather than silently bound short.
SETTLED_MAX :: 16

// How many instances deep a call for an answer may go before it stops asking.
// A generic that calls itself would ask for the instance it is inside, since
// an instance is remembered only once its body has been read.
MONO_DEPTH_MAX :: 4

// The tuple a call to a generic at least one of whose compile-time parameters a
// value parameter settles names. Each parameter is taken in the order it was
// declared: a settled one off the type of the argument the value parameter
// naming it takes, and one the call writes off the next `$` argument.
//
// Each bound type is worked out before any of them is filed, because working
// one out reads an argument, and reading an argument names whatever generics it
// calls: those leave their own tuples in `gargs`, and a run filed around them
// would have their entries in the middle of it.
settled_type_args :: fn(mut p: Parser, head: i64, owner: i64) -> i64 {
    gfn := arena_at(p.generic_fns, owner)
    mut bounds: [SETTLED_MAX]i64 = [0; SETTLED_MAX]
    total := gfn.xparam_count + 1
    if (total > SETTLED_MAX) {
        report_where(p.modules, p.src, gfn.token_start)
        report("this generic takes more compile-time parameters than one call can bind")
        frost_rt_recover_escape()
    }
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < total) {
        mut name_off := gfn.tparam_off
        mut name_len := gfn.tparam_len
        if (index > 0) {
            param := arena_at(p.gparams, gfn.xparam_start + index - 1)
            name_off = param.name_off
            name_len = param.name_len
        }
        mut fallback := gfn.tparam_fallback
        if (index > 0) {
            fallback = arena_at(
                p.gparams,
                gfn.xparam_start + index - 1
            ).fallback
        }
        at := gparam_position(p, gfn.token_start, name_off, name_len)
        settled := p.gparam_settled
        through := p.tparam_through
        mut bound: i64 = -1
        if (settled == 1) {
            if (at >= 0) {
                bound = call_arg_type_at(p, head, at, through)
            }
        } else if (fallback >= 0 && nth_type_arg(p, head, written) < 0) {
            // Nothing written for it, so it stands for what its declaration
            // said. Told apart by the `$` rather than by counting: an argument
            // carrying one binds a compile-time parameter and every other binds
            // a value parameter.
            bound = fallback
        } else {
            bound = nth_type_arg(p, head, written)
            written = written + 1
        }
        bounds[index] = bound
        index = index + 1
    }
    xstart := p.gargs.count
    mut extra: i64 = 1
    while (extra < total) {
        arena_push(
            p.gargs,
            GArg { value = bounds[extra], is_type = 0, pending = -1, node = -1 }
        )
        extra = extra + 1
    }
    p.call_xarg_start = xstart
    p.call_xarg_count = gfn.xparam_count
    if (gfn.tparam_len == 0) {
        return TY_I64
    }
    bounds[0]
}

// Take down the type of every runtime argument of a call whose callee has not
// been declared yet. Which of a generic's compile-time parameters a value
// parameter settles is read off that declaration, so a call written before it
// has nothing to read; the names in the call are in scope only here, so what
// they hold is written down for the pass that works the tuple out.
hold_pending_tuple :: fn(mut p: Parser, node: i64, fn_index: i64, head: i64) {
    start := p.pending_types.count
    mut count: i64 = 0
    mut id := head
    while (id != (-1)) {
        entry := arena_at(p.arena, id)
        value := entry.a
        next_id := entry.next
        if (arena_at(p.arena, value).kind != NodeKind::TypeVal) {
            // The expression a name stands for, where it stands for one. A
            // name bound from a call to a function declared further down has
            // the type that call had not been given yet, so what is kept is
            // where to read it again.
            mut bound := bound_value(p, value)
            if (bound == value) {
                bound = -1
            }
            arena_push(
                p.pending_types,
                GArg {
                    value = argument_type(p, value),
                    is_type = 0,
                    pending = -1,
                    node = bound
                }
            )
            count = count + 1
        }
        id = next_id
    }
    arena_push(
        p.pending_tuples,
        PendingTuple {
            node = node,
            fn_index = fn_index,
            start = start,
            count = count
        }
    )
}

// The tuple each of those calls names, now that every declaration has been
// read. A callee that turned out to settle nothing was handled where the call
// was written and is passed over here.
settle_pending_tuples :: fn(mut p: Parser) {
    mut index: i64 = 0
    while (index < p.pending_tuples.count) {
        held := arena_at(p.pending_tuples, index)
        owner := generic_fn_of(p, held.fn_index)
        if (owner >= 0 && takes_pack(p, held.fn_index) == false
            && first_settled_gparam(p, owner)) {
            arg := pending_type_args(p, held, owner)
            note_type_args(
                p,
                arg,
                p.call_xarg_start,
                p.call_xarg_count,
                0,
                owner
            )
        }
        index = index + 1
    }
}

// The same walk `settled_type_args` makes, over the argument types taken down
// at the call rather than over the arguments themselves.
pending_type_args :: fn(mut p: Parser, held: PendingTuple, owner: i64) -> i64 {
    gfn := arena_at(p.generic_fns, owner)
    mut bounds: [SETTLED_MAX]i64 = [0; SETTLED_MAX]
    total := gfn.xparam_count + 1
    if (total > SETTLED_MAX) {
        return -1
    }
    node := arena_at(p.arena, held.node)
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < total) {
        mut name_off := gfn.tparam_off
        mut name_len := gfn.tparam_len
        if (index > 0) {
            param := arena_at(p.gparams, gfn.xparam_start + index - 1)
            name_off = param.name_off
            name_len = param.name_len
        }
        at := gparam_position(p, gfn.token_start, name_off, name_len)
        settled := p.gparam_settled
        through := p.tparam_through
        mut bound: i64 = -1
        if (settled == 1) {
            if (at >= 0 && at < held.count) {
                entry := arena_at(p.pending_types, held.start + at)
                mut raw := entry.value
                if (entry.node >= 0) {
                    raw = type_of(p, entry.node)
                }
                // The same reading `call_arg_type_at` makes of an argument
                // written where its callee was already known. A pointer is read
                // through, so `^T` binds what a bare `T` would.
                if (is_pointer(raw)) {
                    raw = pointee(p, raw)
                }
                bound = read_through(p, raw, through)
            }
        } else {
            bound = nth_type_arg(p, node.a, written)
            written = written + 1
        }
        bounds[index] = bound
        index = index + 1
    }
    xstart := p.gargs.count
    mut extra: i64 = 1
    while (extra < total) {
        arena_push(
            p.gargs,
            GArg { value = bounds[extra], is_type = 0, pending = -1, node = -1 }
        )
        extra = extra + 1
    }
    p.call_xarg_start = xstart
    p.call_xarg_count = gfn.xparam_count
    if (gfn.tparam_len == 0) {
        return TY_I64
    }
    bounds[0]
}

// The nth type argument written at a call, or -1 where the call wrote fewer
// than that. A call giving too few is reported where the count is checked; here
// it answers that the tuple is unknown rather than guessing at one.
nth_type_arg :: fn(mut p: Parser, head: i64, at: i64) -> i64 {
    mut seen: i64 = 0
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        vnode := arena_at(p.arena, node.a)
        if (vnode.kind == NodeKind::TypeVal) {
            if (seen == at) {
                return vnode.val
            }
            seen = seen + 1
        }
        id = node.next
    }
    -1
}

// `owner` is the generic being called, or -1 where the caller does not know it.
// It is what says which argument stands for the type parameter; without it the
// first argument whose type is known has to do.
call_type_args :: fn(mut p: Parser, head: i64, owner: i64) -> i64 {
    if (owner >= 0
        && (first_settled_gparam(p, owner) || has_fallback_gparam(p, owner))) {
        return settled_type_args(p, head, owner)
    }
    mut count: i64 = 0
    mut first: i64 = TY_I64
    xstart := p.gargs.count
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal) {
            if (count == 0) {
                first = vnode.val
            } else {
                arena_push(
                    p.gargs,
                    GArg {
                        value = vnode.val,
                        is_type = 0,
                        pending = -1,
                        node = -1
                    }
                )
            }
            count = count + 1
        }
        id = next_id
    }
    if (count > 0) {
        p.call_xarg_start = xstart
        p.call_xarg_count = count - 1
        return first
    }
    p.call_xarg_start = 0
    p.call_xarg_count = 0
    id = head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        mut t := type_of(p, value)
        if (is_pointer(t)) {
            t = pointee(p, t)
        }
        // A runtime argument that is a generic instance carries the whole tuple
        // its parameters were bound to, so a call that leaves the arguments
        // implicit is monomorphized on every one of them, not just the first.
        if (is_struct_ty(t)) {
            si := struct_index_of(t)
            mut k: i64 = 0
            while (k < p.instances.count) {
                inst := arena_at(p.instances, k)
                if (inst.struct_index == si) {
                    p.call_xarg_start = inst.xarg_start
                    p.call_xarg_count = inst.xarg_count
                    return inst.arg
                }
                k = k + 1
            }
        }
        id = next_id
    }
    // No argument carried a tuple, so the tuple is the type an argument has: a
    // generic over a plain type names that type through what it was given and
    // nowhere else. Which argument is the one the declaration wrote `$T` on,
    // where it says; the first whose type is known otherwise.
    if (owner >= 0) {
        at := tparam_position(p, owner)
        if (at >= 0) {
            // -1 rather than a default. The argument that stands for the
            // parameter is known to be this one and its type is not known here,
            // so there is no tuple to name. Answering `i64` would name an
            // instance nothing asked for, and that instance is emitted and
            // compiled like any other.
            return call_arg_type_at(p, head, at, p.tparam_through)
        }
    }
    id = head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            mut held := argument_type(p, value)
            if (is_pointer(held)) {
                held = pointee(p, held)
            }
            if (held >= 0) {
                return held
            }
        }
        id = next_id
    }
    TY_I64
}

// Arguments evaluate right to left onto the stack and only then land in the
// registers the ABI names, so an argument that is itself a call cannot clobber
// one already computed.
// The value of the nth argument that survives to runtime, skipping the type
// arguments, which are erased.
record_mono_ret :: fn(
    mut p: Parser,
    fn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    ret: i64
) {
    // The discovery pass runs until it finds nothing new, so the same
    // monomorphization is offered more than once and only the first is kept.
    mut i: i64 = 0
    while (i < p.mono_rets.count) {
        entry := arena_at(p.mono_rets, i)
        if (entry.fn_index == fn_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return
        }
        i = i + 1
    }
    arena_push(
        p.mono_rets,
        MonoRet {
            fn_index = fn_index,
            arg = arg,
            xarg_start = xarg_start,
            xarg_count = xarg_count,
            ret = ret
        }
    )
}

// The concrete argument tuples the generics in this program are used with. A
// generic struct written as `Box<i64>` is one, and so is a call to a generic
// function, which used to be missed: instantiation was driven by the struct
// instances alone, so a generic function called with a type that no generic
// struct had been written with was called and never emitted.
//
// Distinct tuples rather than instances, since two generic structs written with
// the same arguments would otherwise have every generic function emitted twice.
// A tuple carries which generic it was written for, since a call names its
// callee. A generic struct's instance names no function and carries -1, which
// every generic accepts.
note_type_args :: fn(
    mut p: Parser,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    is_pack: i64,
    owner: i64
) {
    if (arg < 0 || arg == TY_PARAM) {
        return
    }
    // A call inside a generic template names the enclosing parameter as its
    // argument, so its argument is the unbound placeholder. That call is
    // re-parsed with a real argument for each instance. The placeholder itself
    // must not drive an instantiation, which would emit a `^T` for a T that is
    // no type.
    mut g: i64 = 0
    while (g < xarg_count) {
        entry := arena_at(p.gargs, xarg_start + g)
        if (entry.value == TY_PARAM) {
            return
        }
        g = g + 1
    }
    mut i: i64 = 0
    while (i < p.type_args.count) {
        entry := arena_at(p.type_args, i)
        if (entry.arg == arg && entry.xarg_count == xarg_count
            && entry.is_pack == is_pack && entry.owner == owner
            && gargs_alike(p, entry.xarg_start, xarg_start, xarg_count)) {
            return
        }
        i = i + 1
    }
    arena_push(
        p.type_args,
        TypeArg {
            arg = arg,
            xarg_start = xarg_start,
            xarg_count = xarg_count,
            is_pack = is_pack,
            owner = owner
        }
    )
}

collect_type_args :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.instances.count) {
        // A generic struct written as `Box<i64>` names no function, so its
        // tuple is offered to every generic.
        entry := arena_at(p.instances, i)
        note_type_args(p, entry.arg, entry.xarg_start, entry.xarg_count, 0, -1)
        i = i + 1
    }
    i = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        if (node.kind == NodeKind::Call) {
            owner := generic_fn_of(p, node.val)
            if (owner >= 0) {
                // A call to a generic taking a compile-time list was noted
                // where it was written, since what the list was given is the
                // type of each argument and only the parse has the names in
                // scope to say what those are.
                // A generic whose compile-time parameter a value parameter
                // settles names its tuple through the types of its arguments,
                // and nothing is in scope here to say what a name holds. That
                // tuple was read where the call was written, with the local
                // table still standing.
                if (takes_pack(p, node.val) == false
                    && first_settled_gparam(p, owner) == false) {
                    arg := call_type_args(p, node.a, owner)
                    note_type_args(
                        p,
                        arg,
                        p.call_xarg_start,
                        p.call_xarg_count,
                        0,
                        owner
                    )
                }
            }
        }
        i = i + 1
    }
}

// Read every list element whose type is what a call to a generic answers with,
// now that the monomorphizations recorded their return types. An element like
// that is written down as the default while its call is parsed, because the
// answer is not worked out until afterwards, and the emitters run once the types
// have settled and name the specialization the settled tuple picks out. This is
// what makes the tuple an instance was made under the same one.
//
// Answers whether any tuple changed, which is a round that found something new:
// a changed tuple is a specialization nothing has been instantiated for yet.
settle_pack_args :: fn(mut p: Parser) -> bool {
    mut changed := false
    mut i: i64 = 0
    while (i < p.type_args.count) {
        used := arena_at(p.type_args, i)
        start := used.xarg_start
        count := used.xarg_count
        fresh := settled_run(p, start, count)
        if (fresh >= 0) {
            slot := arena_at(p.type_args, i)
            slot.xarg_start = fresh
            changed = true
        }
        i = i + 1
    }
    changed
}

// A run with every element that reads again read, or -1 where none of them
// changed. A fresh run rather than the old one written over: an instance
// already parsed from a run is held under its contents, so contents that
// changed underneath it would answer that lookup with a body parsed for other
// types.
settled_run :: fn(mut p: Parser, start: i64, count: i64) -> i64 {
    buf_start := p.argbuf.count
    mut differs := false
    mut k: i64 = 0
    while (k < count) {
        held := arena_at(p.gargs, start + k)
        value := held.value
        is_type := held.is_type
        pending := held.pending
        node := held.node
        mut settled := value
        if (pending >= 0) {
            settled = pending_ret_type(p, pending)
            // What the call answers with is the base. A field or an element
            // written over it is read off that, the same walk the parse ran
            // over the guess it had to use.
            if (node >= 0) {
                settled = project_type(p, node, settled)
            }
            if (settled < 0) {
                settled = value
            }
        }
        // What an element reads again is kept only until it changes. The answer
        // is recorded once and never revised, so reading it after that answers
        // the same, and a run that keeps changing is a fixpoint that never
        // closes.
        mut later := pending
        if (settled != value) {
            differs = true
            later = -1
        }
        mut keep := node
        if (later < 0) {
            keep = -1
        }
        arena_push(
            p.argbuf,
            GArg {
                value = settled,
                is_type = is_type,
                pending = later,
                node = keep
            }
        )
        k = k + 1
    }
    mut fresh: i64 = -1
    if (differs) {
        fresh = copy_run(p, buf_start)
    }
    p.argbuf.count = buf_start
    fresh
}

// What the call an element waits on returns, as recorded for its
// monomorphization.
pending_ret_type :: fn(mut p: Parser, pending: i64) -> i64 {
    held := arena_at(p.pending_rets, pending)
    fn_index := held.fn_index
    arg := held.arg
    xarg_start := held.xarg_start
    xarg_count := held.xarg_count
    // A plain function waited on because its signature came later. What it
    // answers with is the signature itself, with no tuple to pick an instance
    // out of.
    if (generic_fn_of(p, fn_index) < 0) {
        return arena_at(p.fns, fn_index).ret_type
    }
    mono_ret_type(p, fn_index, arg, xarg_start, xarg_count)
}

mono_ret_type :: fn(
    mut p: Parser,
    fn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64
) -> i64 {
    mut i: i64 = 0
    while (i < p.mono_rets.count) {
        entry := arena_at(p.mono_rets, i)
        if (entry.fn_index == fn_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return entry.ret
        }
        i = i + 1
    }
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return TY_I64
    }
    // No instance has been parsed for this tuple. The declared type with the
    // tuple bound into it is what the answer will be wherever the answer is
    // built out of the parameter alone, and saying `i64` here left a name bound
    // from such a call standing for a number.
    bind_param_type(p, arena_at(p.generic_fns, gi).template_ret, arg)
}

// What the declaration being read has settled so far. Reading a template into
// the program to answer a call runs the whole parser over another declaration,
// and everything the enclosing one has worked out lives in the parser rather
// than on a stack, so it is put aside and put back.
Declaring :: struct {
    type_param_off: i64,
    type_param_len: i64,
    saw_type_param: i64,
    tparam_is_slot: i64,
    tparam_is_value: i64,
    tparam_fallback: i64,
    tparam_called: i64,
    bound_token: i64,
    xparam_start: i64,
    xparam_count: i64,
    decl_pack_off: i64,
    decl_pack_len: i64,
    decl_pack_fixed: i64,
    decl_pack_format: i64,
    decl_format_off: i64,
    decl_format_len: i64,
    parse_param_start: i64,
    parse_param_end: i64,
    parse_locals: i64,
    parse_local_values: i64,
    result_ty: i64,
    failure_ty: i64,
    ok_ty: i64,
    multi_ty: i64,
    multi_count: i64,
    expected_type: i64,
    expected_alt: i64,
    args_unbound_map: i64,
    block_depth: i64,
    defer_base: i64,
    defer_count: i64,
    defer_depth: i64,
    defers: i64,
    unsafe_depth: i64,
    last_return_type: i64,
    last_type_was_generic: i64,
    last_type_was_param: i64,
    pending_gt: i64,
    frame_used: i64,
    no_struct_lit: bool,
}

hold_declaration :: fn(mut p: Parser) -> Declaring {
    Declaring {
        type_param_off = p.type_param_off,
        type_param_len = p.type_param_len,
        saw_type_param = p.saw_type_param,
        tparam_is_slot = p.tparam_is_slot,
        tparam_is_value = p.tparam_is_value,
        tparam_fallback = p.tparam_fallback,
        tparam_called = p.tparam_called,
        bound_token = p.bound_token,
        xparam_start = p.xparam_start,
        xparam_count = p.xparam_count,
        decl_pack_off = p.decl_pack_off,
        decl_pack_len = p.decl_pack_len,
        decl_pack_fixed = p.decl_pack_fixed,
        decl_pack_format = p.decl_pack_format,
        decl_format_off = p.decl_format_off,
        decl_format_len = p.decl_format_len,
        parse_param_start = p.parse_param_start,
        parse_param_end = p.parse_param_end,
        parse_locals = p.parse_locals.count,
        parse_local_values = p.parse_local_values.count,
        result_ty = p.result_ty,
        failure_ty = p.failure_ty,
        ok_ty = p.ok_ty,
        multi_ty = p.multi_ty,
        multi_count = p.multi_count,
        expected_type = p.expected_type,
        expected_alt = p.expected_alt,
        args_unbound_map = p.args_unbound_map,
        block_depth = p.block_depth,
        defer_base = p.defer_base,
        defer_count = p.defer_count,
        defer_depth = p.defer_depth,
        defers = p.defers.count,
        unsafe_depth = p.unsafe_depth,
        last_return_type = p.last_return_type,
        last_type_was_generic = p.last_type_was_generic,
        last_type_was_param = p.last_type_was_param,
        pending_gt = p.pending_gt,
        frame_used = p.frame_used,
        no_struct_lit = p.no_struct_lit
    }
}

restore_declaration :: fn(mut p: Parser, held: Declaring) {
    p.type_param_off = held.type_param_off
    p.type_param_len = held.type_param_len
    p.saw_type_param = held.saw_type_param
    p.tparam_is_slot = held.tparam_is_slot
    p.tparam_is_value = held.tparam_is_value
    p.tparam_fallback = held.tparam_fallback
    p.tparam_called = held.tparam_called
    p.bound_token = held.bound_token
    p.xparam_start = held.xparam_start
    p.xparam_count = held.xparam_count
    p.decl_pack_off = held.decl_pack_off
    p.decl_pack_len = held.decl_pack_len
    p.decl_pack_fixed = held.decl_pack_fixed
    p.decl_pack_format = held.decl_pack_format
    p.decl_format_off = held.decl_format_off
    p.decl_format_len = held.decl_format_len
    p.parse_param_start = held.parse_param_start
    p.parse_param_end = held.parse_param_end
    p.parse_locals.count = held.parse_locals
    p.parse_local_values.count = held.parse_local_values
    p.result_ty = held.result_ty
    p.failure_ty = held.failure_ty
    p.ok_ty = held.ok_ty
    p.multi_ty = held.multi_ty
    p.multi_count = held.multi_count
    p.expected_type = held.expected_type
    p.expected_alt = held.expected_alt
    p.args_unbound_map = held.args_unbound_map
    p.block_depth = held.block_depth
    p.defer_base = held.defer_base
    p.defer_count = held.defer_count
    p.defer_depth = held.defer_depth
    p.defers.count = held.defers
    p.unsafe_depth = held.unsafe_depth
    p.last_return_type = held.last_return_type
    p.last_type_was_generic = held.last_type_was_generic
    p.last_type_was_param = held.last_type_was_param
    p.pending_gt = held.pending_gt
    p.frame_used = held.frame_used
    p.no_struct_lit = held.no_struct_lit
}

// A declared type with the type parameter replaced by what a call bound it to.
// `T`, `[]T`, `[N]T` and `^T` are what a generic answers with where the answer
// is built from the parameter alone; anything else names a type of its own and
// is already what it will be.
bind_param_type :: fn(mut p: Parser, ty: i64, arg: i64) -> i64 {
    // Only an ordinary type stands where a type is written. A generic whose
    // first compile-time parameter takes a function, a bundle or a number is
    // bound to a code naming one of those, and building `[]T` out of it makes
    // an array of a thing that is no type: the emitters were handed
    // `struct __arr20 { struct * data; }` to write out.
    if (arg < 0 || arg >= CONST_BASE) {
        return ty
    }
    if (ty == TY_PARAM) {
        return arg
    }
    if (is_array_ty(ty)) {
        element := array_element(p, ty)
        bound := bind_param_type(p, element, arg)
        if (bound == element) {
            return ty
        }
        return array_of(p, bound, array_length(p, ty))
    }
    if (is_pointer(ty)) {
        target := pointee(p, ty)
        bound := bind_param_type(p, target, arg)
        if (bound == target) {
            return ty
        }
        return pointer_to(p, bound)
    }
    ty
}

// What a call answers with, which decides whether it needs a result buffer.
// The global function of this name, or -1. A function used as a value or called
// indirectly is found this way when the name is not a local.
fn_index_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.fns.count) {
        sym := arena_at(p.fns, i)
        if (sym.len == len && sym.defined == 1
            && bytes_equal(p.src, sym.off, off, len)) {
            return i
        }
        i = i + 1
    }
    -1
}

// The function a bundle's field names, for a bundle that is a constant, or -1
// when the callee is anything else. `ops.less(a, b)` where `ops` is a constant
// whose `less` field names a function is a call to that function: the field can
// hold one value and it is known here, so nothing is loaded and nothing is
// called through a pointer.
bundle_field_fn :: fn(mut p: Parser, callee: i64) -> i64 {
    node := arena_at(p.arena, callee)
    if (node.kind != NodeKind::Field) {
        return -1
    }
    base := node.a
    field_off := node.val
    field_len := node.c
    base_node := arena_at(p.arena, base)
    if (base_node.kind != NodeKind::Var) {
        return -1
    }
    name_off := base_node.val
    name_len := base_node.c
    if (local_exists(p, name_off, name_len)) {
        return -1
    }
    literal := value_const_node(p, name_off, name_len)
    if (literal < 0) {
        return -1
    }
    literal_node := arena_at(p.arena, literal)
    if (literal_node.kind != NodeKind::StructLit) {
        return -1
    }
    mut id := literal_node.a
    while (id != (-1)) {
        init := arena_at(p.arena, id)
        init_off := init.val
        init_len := init.c
        value := init.a
        next_id := init.next
        if (init_len == field_len
            && bytes_equal(p.src, init_off, field_off, field_len)) {
            value_node := arena_at(p.arena, value)
            if (value_node.kind != NodeKind::Var) {
                return -1
            }
            return fn_index_of(p, value_node.val, value_node.c)
        }
        id = next_id
    }
    -1
}

// The function-pointer type of a global function: its parameter types and its
// return type interned as a signature. This is what a function's name stands
// for when it is used as a value.
fn_proc_type :: fn(mut p: Parser, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    ret := sym.ret_type
    param_start := p.proc_params.count
    mut count: i64 = 0
    mut pid := sym.params
    while (pid != (-1)) {
        pnode := arena_at(p.arena, pid)
        arena_push(
            p.proc_params,
            GArg { value = pnode.b, is_type = 0, node = -1, pending = -1 }
        )
        count = count + 1
        pid = pnode.next
    }
    proc_of(p, ret, param_start, count)
}

// Whether a name is one of the type predicates, and what it answers of a type.
// The vocabulary is fixed and closed: every one of these is a
// question the compiler answers for itself to decide what to emit. Two things
// ask it, a `where` clause at a call and an expansion-time `if` in an unrolled
// body, and they ask the same one so the two cannot drift.
is_type_predicate :: fn(src: str, off: i64, len: i64) -> bool {
    (str_range_eq(src, off, len, "is_numeric")
        || str_range_eq(src, off, len, "is_integer")
        || str_range_eq(src, off, len, "is_float")
        || str_range_eq(src, off, len, "is_struct")
        || str_range_eq(src, off, len, "is_array")
        || str_range_eq(src, off, len, "is_slice")
        || str_range_eq(src, off, len, "is_pointer")
        || str_range_eq(src, off, len, "is_linear"))
}

predicate_holds :: fn(mut p: Parser, off: i64, len: i64, ty: i64) -> i64 {
    if (str_range_eq(p.src, off, len, "is_numeric")) {
        if (is_integer(ty) || is_float(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_integer")) {
        if (is_integer(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_float")) {
        if (is_float(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_struct")) {
        if (is_struct_ty(ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_array")) {
        if (is_array_ty(ty) && is_slice_ty(p, ty) == false) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_slice")) {
        if (is_array_ty(ty) && is_slice_ty(p, ty)) { return 1 }
        return 0
    }
    if (str_range_eq(p.src, off, len, "is_pointer")) {
        if (is_pointer(ty)) { return 1 }
        return 0
    }
    // Whether a value of this type has to be consumed exactly once. A container
    // that reaches an element by a number cannot say which element it took, so
    // the generic ones hold themselves to types where there is nothing to say:
    // `where !is_linear(T)` refuses the binding at the call rather than
    // leaking inside a body nobody wrote.
    if (str_range_eq(p.src, off, len, "is_linear")) {
        if (is_linear_type(p, ty)) { return 1 }
        return 0
    }
    -1
}

// Whether reading this type reads through it.
//
// Reading a borrow reads what it borrows. An aggregate is reached by address
// either way, so a field access through one already does it and there is
// nothing to add; a scalar has no field to reach through, so the read is here
// or nowhere. Two walks apply this and the rule is written once: the parse,
// wrapping a name that holds one, and each backend's coercion, which is what
// every value in a value position goes through.
reads_through_borrow :: fn(mut p: Parser, ty: i64) -> bool {
    is_borrow(ty) && is_aggregate(pointee(p, ty)) == false
}

// The type an operand of an operator is read at.
//
// A name holding a borrow of a scalar reads through where it is written, which
// the parse does. A call answering one is known to answer a borrow only once
// every signature has been read, and a call may be written above the
// declaration it names, so its operands say here what they are read at and the
// coercion does the reading. Left alone, `at(bag, 2) == 9` compared the address
// the borrow holds against nine and answered no for every bag there is.
operand_type :: fn(mut p: Parser, value: i64) -> i64 {
    ty := type_of(p, value)
    if (reads_through_borrow(p, ty)) {
        return pointee(p, ty)
    }
    ty
}

// A borrow where a borrow is wanted, undoing the read a name holding one takes
// wherever it is written. A function answering `ref T` hands back the borrow
// rather than what it borrows, and so does an argument for a parameter that
// takes one.
borrow_kept :: fn(mut p: Parser, value: i64, want: i64) -> i64 {
    if (is_borrow(want) == false) {
        return value
    }
    held := arena_at(p.arena, value)
    if (held.kind == NodeKind::Deref && held.val == 1) {
        return held.a
    }
    value
}

// Record what a name binds for the rest of this declaration's parse.
// `bound` is the expression the name was given, for a name whose type was read
// off one, and -1 for a parameter, a list element or a name written with the
// type it holds. The two tables move together, so a binding that shadows an
// earlier one shadows what that one bound as well.
record_parse_local :: fn(
    mut p: Parser,
    off: i64,
    len: i64,
    ty: i64,
    bound: i64
) {
    arena_push(
        p.parse_locals,
        LocalVar { name_off = off, name_len = len, ty = ty, slot = 0 }
    )
    arena_push(p.parse_local_values, BoundValue { node = bound })
}

// The type a name binds to in the declaration being parsed, or -1 when nothing
// here names it. The last binding wins, the same rule the emitters' table has.
parse_local_type :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.parse_locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    -1
}

// The same, over the parameters of the declaration being parsed and nothing
// else. What an expansion-time `if` may ask about is a parameter, since that is
// what an instantiation decides and a local is not.
parse_param_type :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.parse_param_end
    while (i > p.parse_param_start) {
        i = i - 1
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.ty
        }
    }
    -1
}

// The expression an argument holds, reading through a name to what it was
// bound to. An argument is a name in two ways that matter here: written as one,
// and a call answering with an aggregate, which is bound to a name where it was
// written. Either way the name's type was read off the expression while the
// expression was still being parsed, so a reader that comes after wants the
// expression.
// The name a chain of fields and elements is written over. `held.x` and
// `rows[i].x` are both read off `held` and `rows`, and what those stand for is
// what decides the whole expression's type.
pack_arg_base :: fn(mut p: Parser, value: i64) -> i64 {
    mut held := value
    while (true) {
        node := arena_at(p.arena, held)
        if (node.kind != NodeKind::Field && node.kind != NodeKind::Index) {
            return held
        }
        held = node.a
    }
    held
}

// That chain applied to the type the base turned out to have. An element whose
// base is a call to a generic is written down before the call's answer is
// worked out, so the same walk runs again over the answer rather than over the
// guess the parse had to use.
project_type :: fn(mut p: Parser, value: i64, base_ty: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind == NodeKind::Field) {
        mut held := project_type(p, node.a, base_ty)
        if (held < 0) {
            return -1
        }
        if (is_borrow(held) && is_aggregate(pointee(p, held))) {
            held = pointee(p, held)
        }
        return field_type_by_range(p, held, node.val, node.c)
    }
    if (node.kind == NodeKind::Index) {
        mut held := project_type(p, node.a, base_ty)
        if (held < 0) {
            return -1
        }
        if (is_borrow(held)) {
            held = pointee(p, held)
        }
        if (is_array_ty(held)) {
            return array_element(p, held)
        }
        if (is_raw_pointer(held)) {
            return pointee(p, held)
        }
        return -1
    }
    base_ty
}

bound_value :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Var) {
        return value
    }
    name_off := node.val
    name_len := node.c
    mut i: i64 = p.parse_locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == name_len
            && bytes_equal(p.src, entry.name_off, name_off, name_len)) {
            held := arena_at(p.parse_local_values, i)
            bound := held.node
            if (bound >= 0) {
                return bound
            }
            return value
        }
    }
    value
}

// Where a list element's type is read from again, for an element whose type is
// what a call to a generic answers with, and -1 for one whose type is already
// what it will be. The tuple the call names is worked out here, since the names
// it writes are in scope only during this parse, and the type that
// monomorphization returns is read from the tuple later.
// Whether the call names its own type arguments rather than leaving them to be
// worked out from what it was passed. `slice_range($i64, ...)` writes one;
// `peek(numbers)` leaves it to the type of `numbers`.
call_writes_its_types :: fn(mut p: Parser, args: i64) -> bool {
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        if (arena_at(p.arena, node.a).kind == NodeKind::TypeVal) {
            return true
        }
        id = node.next
    }
    false
}

pack_arg_pending :: fn(mut p: Parser, written: i64) -> i64 {
    value := bound_value(p, pack_arg_base(p, written))
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call) {
        return -1
    }
    args := node.a
    fn_index := node.val
    sym := arena_at(p.fns, fn_index)
    sym_off := sym.off
    sym_len := sym.len
    sym_defined := sym.defined
    // A call through a local of function-pointer type is indirect and answers
    // with that signature's return type, which is known already.
    if (local_exists(p, sym_off, sym_len)) {
        return -1
    }
    mut arg: i64 = -1
    mut xarg_start: i64 = 0
    mut xarg_count: i64 = 0
    if (generic_fn_of(p, fn_index) < 0) {
        // A function written after the call that names it has no signature
        // here, so the element stood for whatever the parse guessed. Read again
        // once every signature is known: `print(fmt, one.name, resource_name(g,
        // wanted))` in `lib/renderer/graph.frost` names a function declared a
        // hundred lines below it, so the list was filed holding a number where
        // it holds text and the instance the call emitted was one nobody made.
        if (sym_defined == 1) {
            return -1
        }
    } else {
        // A tuple worked out from the types of the arguments is not one to wait
        // on. Those types are read from tables the parse has not filled, so the
        // tuple named here can name a monomorphization nothing has, and the
        // answer read back from it belongs to some other one. A tuple the call
        // writes out is the same however often it is read, so only those are
        // waited on.
        if (call_writes_its_types(p, args) == false) {
            return -1
        }
        arg = call_args_for(p, args, fn_index)
        xarg_start = p.call_xarg_start
        xarg_count = p.call_xarg_count
    }
    // The same call is read more than once, since the checks and the emitters
    // work the tuple out again where it was written. One entry per
    // monomorphization keeps this table the size of what the program
    // instantiates rather than the size of how often it is read.
    mut i: i64 = 0
    while (i < p.pending_rets.count) {
        entry := arena_at(p.pending_rets, i)
        if (entry.fn_index == fn_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return i
        }
        i = i + 1
    }
    arena_push(
        p.pending_rets,
        PendingRet {
            fn_index = fn_index,
            arg = arg,
            xarg_start = xarg_start,
            xarg_count = xarg_count
        }
    )
}

// What a name the declaration being parsed bound stands for, and what an
// element or a field of one does. `type_of` reads the table the emitters fill,
// which holds nothing while the declaration is still being parsed, so an
// argument built out of a name would be answered a default there and the real
// type later. The two answers name two specializations, and only one of them
// gets a body.
//
// The emitters' table answers wherever it knows the name, and this one only
// where it does not. Both are consulted because neither is filled the whole
// time: the parse's is all there is while a declaration is being read, and the
// emitters' is the one that has seen the instantiations a generic call's answer
// is worked out from. A name bound to a generic call is recorded here as i64,
// since `mono_ret_type` has nothing to look up until every instance has been
// walked, and letting that stand would key a call on a type the callee never
// has.
pack_local_type :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind == NodeKind::Var) {
        if (local_exists(p, node.val, node.c)) {
            return -1
        }
        return parse_local_type(p, node.val, node.c)
    }
    if (node.kind == NodeKind::Index) {
        mut base := pack_local_type(p, node.a)
        if (base < 0) {
            return -1
        }
        if (is_borrow(base)) {
            base = pointee(p, base)
        }
        if (is_array_ty(base)) {
            return array_element(p, base)
        }
        if (is_raw_pointer(base)) {
            return pointee(p, base)
        }
        return -1
    }
    if (node.kind == NodeKind::Field) {
        mut base := pack_local_type(p, node.a)
        if (base < 0) {
            return -1
        }
        if (is_borrow(base) && is_aggregate(pointee(p, base))) {
            base = pointee(p, base)
        }
        return field_type_by_range(p, base, node.val, node.c)
    }
    // An operator over two values answers with the wider of them, which is the
    // rule `type_of` reads off the emitters' table once there is one. A side
    // this cannot name is left out of the comparison rather than counted as an
    // i64, since a literal beside an f64 does not make the answer an integer.
    if (node.kind == NodeKind::Bin) {
        if (op_answers_truth(node.val)) {
            return -1
        }
        left := pack_local_type(p, node.a)
        right := pack_local_type(p, node.b)
        if (left < 0) {
            return right
        }
        if (right < 0) {
            return left
        }
        if (is_float(left) && is_float(right) == false) {
            return left
        }
        if (is_float(right) && is_float(left) == false) {
            return right
        }
        if (scalar_size(left) >= scalar_size(right)) {
            return left
        }
        return right
    }
    // A call through a pointer answers with what that signature says, which the
    // parse knows already: there is no instance to work out and so nothing to
    // wait for. Only the name the pointer is read off has to be looked up here.
    if (node.kind == NodeKind::CallPtr) {
        callee := pack_local_type(p, node.a)
        if (callee < 0 || is_proc(callee) == false) {
            return -1
        }
        return proc_ret(p, callee)
    }
    -1
}

// The type of one argument given to a compile-time list. A name is what the
// declaration being parsed bound it to. Anything else is derived the ordinary
// way.
pack_arg_type :: fn(mut p: Parser, value: i64) -> i64 {
    // A string literal is a run of bytes here, the way it is everywhere else a
    // `str` is read. `type_of` answers `^i8` for one, which is what a C
    // function taking a terminated buffer wants and what a list element is not.
    // A name standing for such a literal is the literal, so it answers the same.
    if (is_str_literal(p, value)) {
        return array_of(p, TY_U8, -1)
    }
    mut held := pack_local_type(p, value)
    if (held < 0) {
        held = type_of(p, value)
    }
    // A read-mode aggregate parameter is auto-borrowed, so what names it holds
    // a borrow rather than the value. What the call passed is the value, which
    // is what the element has to be: a body asking `is_slice` of it is asking
    // about what was handed over, not about how the parameter carries it.
    //
    // Both readings of this run this: the parse knows the local, and the
    // emitters no longer do and reach `type_of` instead. A specialization is
    // named by one and defined by the other, so stripping in one place only
    // names a body nothing emits.
    // Whatever it borrows: a slice, a number, or a struct. An element of a list
    // is a value like any other, and this is the one place a value arrives with
    // nothing having asked for a type, so a borrow that stayed one travelled as
    // itself. A `ref` binding to a struct named a specialization for the borrow
    // while the emitters named one for the struct, and the call went out to a
    // body nothing defines.
    if (is_borrow(held)) {
        return pointee(p, held)
    }
    held
}

// Which runtime argument of a call to this generic carries the type parameter,
// or -1 where the declaration does not say plainly. The parameter list is read
// back from the declaration's own tokens, and the position wanted is the first
// parameter written exactly `$T`: the argument there has the type the parameter
// stands for, where a parameter written `Vec<$T>` or `[]$T` has only a type
// built from it. A parameter whose *name* carries the `$` is compile-time and
// fills no runtime position, so it is counted out.
tparam_position :: fn(mut p: Parser, gfn_index: i64) -> i64 {
    gfn := arena_at(p.generic_fns, gfn_index)
    gparam_position(p, gfn.token_start, gfn.tparam_off, gfn.tparam_len)
}

// Whether the token at `at`, with a `$` in front of it or without one, is this
// compile-time parameter's name. The corpus writes both spellings, and
// `mut v: Vec<T>` beside `move value: $T` in one signature is the ordinary
// case rather than the odd one.
word_is_gparam :: fn(
    mut p: Parser,
    at: i64,
    name_off: i64,
    name_len: i64
) -> bool {
    mut offset := at
    if (peek_kind(p, offset) == TokenKind::Dollar) {
        offset = offset + 1
    }
    if (peek_kind(p, offset) != TokenKind::Ident) {
        return false
    }
    if (peek_len(p, offset) != name_len) {
        return false
    }
    bytes_equal(p.src, peek_off(p, offset), name_off, name_len)
}

// How far into the argument a value parameter takes this compile-time
// parameter is read, with the cursor sitting on the first token of that
// parameter's declared type. 0 is the argument's own type, 1 is its element,
// and 2 plus a number is that many arguments into the instance it is. -1 is a
// type this cannot read the parameter out of, whether it names it or not.
//
// The cursor is left wherever the shape ran out, and the caller reads on to the
// next top-level comma.
type_names_gparam :: fn(mut p: Parser, name_off: i64, name_len: i64) -> i64 {
    // `[]$T` and `[N]$T` name the parameter through what they hold, so the
    // argument's element is what it binds to.
    if (cur(p) == TokenKind::Lbracket) {
        while (cur(p) != TokenKind::Rbracket && cur(p) != TokenKind::Eof) {
            advance(p)
        }
        advance(p)
        if (word_is_gparam(p, 0, name_off, name_len)) {
            return 1
        }
        return -1
    }
    // A pointer is read through where an argument's type is taken, so `^T`
    // names the parameter the same way a bare `T` does.
    while (cur(p) == TokenKind::Caret) {
        advance(p)
    }
    if (word_is_gparam(p, 0, name_off, name_len)) {
        return 0
    }
    // `Bag<$T>` names the parameter through a generic struct's argument list,
    // so what it binds to is the argument's own argument rather than the
    // argument. Read as if it named nothing, the tuple fell through to the
    // first argument whose type was known, which is the struct: `outer` was
    // compiled for `Bag<i64>`, whose parameter is a `Bag<Bag<i64>>` nothing
    // wrote, and each round of the fixpoint went one deeper.
    //
    // One level, since `>>` is a shift to the lexer and a scan looking for `>`
    // through a nested instance walks off the end of the declaration and takes
    // any later name for this one.
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Lt) {
        advance(p)
        advance(p)
        mut index: i64 = 0
        while (cur(p) != TokenKind::Gt && cur(p) != TokenKind::Eof) {
            if (cur(p) == TokenKind::Lt || cur(p) == TokenKind::Lbracket
                || cur(p) == TokenKind::Lparen) {
                return -1
            }
            if (word_is_gparam(p, 0, name_off, name_len)) {
                return 2 + index
            }
            if (cur(p) == TokenKind::Comma) {
                index = index + 1
            }
            advance(p)
        }
    }
    -1
}

// Which runtime argument of a call settles this compile-time parameter, or -1
// where nothing here can read it out of one. The parameter list is read back
// from the declaration's own tokens, and the answer is the position of the
// first value parameter whose declared type is a shape this reads through;
// `p.tparam_through` says how far in.
//
// `p.gparam_settled` is the wider question and the one the call spelling turns
// on: whether any value parameter names the parameter at all. A `$Ctx` named
// only inside a `fn(mut Ctx, ...)` parameter is settled and read off a later
// `^Ctx`, and one named nowhere is written at the call.
//
// A parameter whose *name* carries the `$` is compile-time and fills no runtime
// position, so it is counted out.
gparam_position :: fn(
    mut p: Parser,
    token_start: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    p.gparam_settled = 0
    p.gparam_settler_off = 0
    p.gparam_settler_len = 0
    if (name_len == 0) {
        return -1
    }
    held_ti := p.ti
    p.ti = token_start
    while (cur(p) != TokenKind::Lparen && cur(p) != TokenKind::Eof) {
        advance(p)
    }
    advance(p)
    mut depth: i64 = 0
    mut position: i64 = 0
    mut found: i64 = -1
    mut at_start: i64 = 1
    mut compile_time: i64 = 0
    mut in_type: i64 = 0
    mut param_off: i64 = 0
    mut param_len: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Rparen && depth == 0) {
            break
        }
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket) {
            depth = depth + 1
            advance(p)
            continue
        }
        if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket) {
            depth = depth - 1
            advance(p)
            continue
        }
        if (kind == TokenKind::Comma && depth == 0) {
            if (compile_time == 0) {
                position = position + 1
            }
            at_start = 1
            compile_time = 0
            in_type = 0
            advance(p)
            continue
        }
        // Anywhere inside a value parameter's declared type, at the type's own
        // depth. A shape this reads through was taken when the type opened;
        // this is the wider question of whether the type names the parameter at
        // all.
        //
        // Held to depth zero because the settled type is read off the argument
        // and then read through: that reaches `C`, `^C`, `[]C` and `Bump<C>`,
        // and reaches nothing inside a `fn(mut C, i64)`, whose argument is a
        // function pointer. A typed callback names its context in both the hook
        // and the state beside it, so taking the first left `$Ctx` bound to the
        // hook's own type and the instance the call emitted was one nobody
        // filed.
        if (in_type == 1 && compile_time == 0 && p.gparam_settled == 0
            && depth == 0
            && word_is_gparam(p, 0, name_off, name_len)) {
            p.gparam_settled = 1
            p.gparam_settler_off = param_off
            p.gparam_settler_len = param_len
        }
        if (at_start == 1) {
            if (kind == TokenKind::KwMut || kind == TokenKind::KwMove
                || kind == TokenKind::KwRef) {
                advance(p)
                continue
            }
            if (kind == TokenKind::Dollar) {
                compile_time = 1
                advance(p)
                continue
            }
            at_start = 0
            param_off = cur_off(p)
            param_len = cur_len(p)
            advance(p)
            if (cur(p) == TokenKind::Colon) {
                advance(p)
                in_type = 1
                if (compile_time == 0) {
                    through := type_names_gparam(p, name_off, name_len)
                    if (through >= 0) {
                        if (p.gparam_settled == 0) {
                            p.gparam_settler_off = param_off
                            p.gparam_settler_len = param_len
                        }
                        p.gparam_settled = 1
                        if (found < 0) {
                            found = position
                            p.tparam_through = through
                        }
                    }
                }
            }
            continue
        }
        advance(p)
    }
    p.ti = held_ti
    found
}

// How many of a generic's compile-time parameters a call writes. One a value
// parameter settles is read off the argument, so writing it says twice what
// the argument says once.
written_gparam_count :: fn(mut p: Parser, gfn_index: i64) -> i64 {
    gfn := arena_at(p.generic_fns, gfn_index)
    mut count: i64 = 0
    if (gfn.tparam_len > 0 && gfn.tparam_is_slot == 1
        && gfn.tparam_fallback < 0) {
        gparam_position(p, gfn.token_start, gfn.tparam_off, gfn.tparam_len)
        if (p.gparam_settled == 0) {
            count = count + 1
        }
    }
    mut index: i64 = 0
    while (index < gfn.xparam_count) {
        param := arena_at(p.gparams, gfn.xparam_start + index)
        if (param.fallback < 0) {
            gparam_position(p, gfn.token_start, param.name_off, param.name_len)
            if (p.gparam_settled == 0) {
                count = count + 1
            }
        }
        index = index + 1
    }
    count
}

// Whether any compile-time parameter of this generic carries a default, so a
// call may write nothing for it and the walk that binds them has to run.
has_fallback_gparam :: fn(mut p: Parser, gfn_index: i64) -> bool {
    gfn := arena_at(p.generic_fns, gfn_index)
    if (gfn.tparam_fallback >= 0) {
        return true
    }
    mut index: i64 = 0
    while (index < gfn.xparam_count) {
        if (arena_at(p.gparams, gfn.xparam_start + index).fallback >= 0) {
            return true
        }
        index = index + 1
    }
    false
}

// How many of this generic's compile-time parameters carry a default. A call
// may write each of them or leave it out, so what a call gives is a range
// rather than a count.
fallback_gparam_count :: fn(mut p: Parser, gfn_index: i64) -> i64 {
    gfn := arena_at(p.generic_fns, gfn_index)
    mut count: i64 = 0
    if (gfn.tparam_len > 0 && gfn.tparam_is_slot == 1
        && gfn.tparam_fallback >= 0) {
        count = count + 1
    }
    mut index: i64 = 0
    while (index < gfn.xparam_count) {
        if (arena_at(p.gparams, gfn.xparam_start + index).fallback >= 0) {
            count = count + 1
        }
        index = index + 1
    }
    count
}

// Whether any compile-time parameter of this generic is settled by a value
// parameter, leaving the first one named in `p.gparam_name_off` and
// `p.gparam_name_len` and the parameter that settles it in
// `p.gparam_settler_off` and `p.gparam_settler_len`. Those two names are what
// a refusal reports.
first_settled_gparam :: fn(mut p: Parser, gfn_index: i64) -> bool {
    gfn := arena_at(p.generic_fns, gfn_index)
    if (gfn.tparam_len > 0) {
        gparam_position(p, gfn.token_start, gfn.tparam_off, gfn.tparam_len)
        if (p.gparam_settled == 1) {
            p.gparam_name_off = gfn.tparam_off
            p.gparam_name_len = gfn.tparam_len
            return true
        }
    }
    mut index: i64 = 0
    while (index < gfn.xparam_count) {
        param := arena_at(p.gparams, gfn.xparam_start + index)
        gparam_position(p, gfn.token_start, param.name_off, param.name_len)
        if (p.gparam_settled == 1) {
            p.gparam_name_off = param.name_off
            p.gparam_name_len = param.name_len
            return true
        }
        index = index + 1
    }
    false
}

// The type an argument has where something in scope says so, and -1 where
// nothing does. A name is asked of the table the parse keeps and then of the one
// the walks build. Where neither holds it the answer is that it is not known,
// rather than the `i64` `lookup_local` hands back for a name it has never seen:
// a tuple built from that default names an instance the program never asked
// for, and that instance is emitted and compiled like any other.
argument_type :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind == NodeKind::Var) {
        // What the walks built, wherever they have reached this name. The
        // parse's own table answered while the declaration was being read, and
        // a name bound there from a call to a generic holds what that call's
        // instance had not been parsed to say yet. The walks run once every
        // instance is settled, and their table is empty until then, so asking
        // it first is asking the one that knows.
        if (local_exists(p, node.val, node.c)) {
            return lookup_local(p, node.val, node.c)
        }
        held := parse_local_type(p, node.val, node.c)
        if (held >= 0) {
            return held
        }
        return -1
    }
    // `ptr_to(x)` is the address of whatever `x` is, and the same table is
    // empty here, so `type_of` read the root as `i64` and answered `^i64`. The
    // address is built over what the parse's own table says instead. A generic
    // whose compile-time parameter a `^C` parameter settles reads its tuple off
    // this, and a wrong answer here filed no tuple at all while the call
    // emitted the name of the instance nobody had made.
    if (node.kind == NodeKind::AddrOf) {
        held := argument_type(p, node.a)
        if (held < 0) {
            return -1
        }
        return pointer_to(p, held)
    }
    // A chain of fields and elements written over a name. The walks' table is
    // empty while a declaration is being read, so `type_of` answers `i64` for
    // the name at the root of one and the chain over it comes out as nothing.
    // The parse's own table holds the root, and the chain applies to that.
    if (node.kind == NodeKind::Field || node.kind == NodeKind::Index) {
        base := pack_arg_base(p, value)
        root := arena_at(p.arena, base)
        if (root.kind == NodeKind::Var
            && local_exists(p, root.val, root.c) == false) {
            held := parse_local_type(p, root.val, root.c)
            if (held < 0) {
                return -1
            }
            return project_type(p, value, held)
        }
    }
    type_of(p, value)
}

// The type of the nth runtime argument of a call, with a pointer read through,
// or -1 where nothing here says what it is. `through` is 1 where the declaration
// wrote the parameter inside brackets, so what it binds to is the argument's
// element rather than the argument, and 2 where it wrote it inside a generic
// struct's argument list, so what it binds to is that instance's own argument.
call_arg_type_at :: fn(mut p: Parser, args: i64, at: i64, through: i64) -> i64 {
    mut id := args
    mut seen: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        // A type argument is erased and fills no runtime position, so it is
        // counted out here the same way it is where the positions are read off
        // the declaration.
        if (arena_at(p.arena, value).kind == NodeKind::TypeVal) {
            id = next_id
            continue
        }
        if (seen == at) {
            mut held := argument_type(p, value)
            if (is_pointer(held)) {
                held = pointee(p, held)
            }
            return read_through(p, held, through)
        }
        seen = seen + 1
        id = next_id
    }
    -1
}

// What a compile-time parameter stands for, read out of the type of the
// argument the value parameter naming it takes. 0 is that type itself, 1 is its
// element, and 2 plus a number is that many arguments into the instance it is.
read_through :: fn(mut p: Parser, held: i64, through: i64) -> i64 {
    if (through == 1) {
        if (held < 0 || is_array_ty(held) == false) {
            return -1
        }
        return array_element(p, held)
    }
    if (through >= 2) {
        if (held < 0 || is_struct_ty(held) == false) {
            return -1
        }
        // A columns container is synthesized rather than instantiated from a
        // template, so what it was made with is read off its own shape: the
        // element is the struct its columns are arrays of, and the capacity is
        // how long they are.
        if (is_columns_ty(p, held)) {
            if (through == 2) {
                return columns_made_for(p, held)
            }
            if (through == 3) {
                gens := slab_field_type(p, held, "generations")
                if (is_array_ty(gens) == false) {
                    return -1
                }
                return CONST_BASE + array_length(p, gens)
            }
            return -1
        }
        return instance_arg_at(p, struct_index_of(held), through - 2)
    }
    held
}

// The nth argument a generic struct's instance was made with, or -1 for a
// struct that is no instance of one. A `Map<K, V>` parameter names two of them,
// and which one a compile-time parameter stands for is where it was written in
// the argument list.
instance_arg_at :: fn(mut p: Parser, struct_index: i64, at: i64) -> i64 {
    mut index: i64 = 0
    while (index < p.instances.count) {
        inst := arena_at(p.instances, index)
        if (inst.struct_index == struct_index) {
            if (at == 0) {
                return inst.arg
            }
            if (at > inst.xarg_count) {
                return -1
            }
            return arena_at(p.gargs, inst.xarg_start + at - 1).value
        }
        index = index + 1
    }
    -1
}

// The tuple a call to a generic names through its arguments alone, read while
// the declaration around it is being parsed. A generic over a plain type names
// that type only in the local table, and this is where that table is in scope.
//
// -1 when the call writes its type arguments out, since those are read where
// the tuples are collected and need nothing from here.
parse_call_type_args :: fn(mut p: Parser, args: i64, gfn_index: i64) -> i64 {
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal) {
            return -1
        }
        id = next_id
    }
    // Where the declaration says which argument stands for the parameter, that
    // argument is the answer and no other. A generic whose first parameter is
    // an ordinary type took the first argument's type otherwise, so
    // `scale(by: i64, mut v: $T)` was compiled for `i64` whatever it was given.
    at := tparam_position(p, gfn_index)
    if (at >= 0) {
        held := call_arg_type_at(p, args, at, p.tparam_through)
        if (held >= 0) {
            return held
        }
        return -1
    }
    id = args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        mut held := argument_type(p, value)
        if (is_pointer(held)) {
            held = pointee(p, held)
        }
        if (held >= 0) {
            return held
        }
        id = next_id
    }
    -1
}

// The field a name is bound to by a `for` over `fields(T)`, as the entry
// holding what it is and where it sits, or -1 when the name is not one.
field_binding_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.field_bindings.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.field_bindings, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
    }
    -1
}

// Whether a callee takes a compile-time list.
takes_pack :: fn(mut p: Parser, fn_index: i64) -> bool {
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return false
    }
    gfn := arena_at(p.generic_fns, gi)
    gfn.pack_len > 0
}

// The argument tuple a call to a generic names, when the callee takes a
// compile-time list. The tuple is the type of every argument past the ordinary
// parameters, in order, which is what makes two calls giving different types
// two specializations. Answers false when the callee takes no list, leaving the
// ordinary path to work out the tuple.
pack_call_args :: fn(mut p: Parser, args: i64, fn_index: i64) -> bool {
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return false
    }
    gfn := arena_at(p.generic_fns, gi)
    pack_len := gfn.pack_len
    fixed := gfn.pack_fixed
    if (pack_len == 0) {
        return false
    }
    // How many compile-time parameters the callee declares before its list: the
    // primary one, if it has one, and the rest. A `$` argument fills those
    // first, and anything past them is an element of the list.
    mut declared: i64 = gfn.xparam_count
    if (gfn.tparam_len > 0) {
        declared = declared + 1
    }
    // The run this call leaves behind is the callee's own compile-time
    // arguments past the first, then the list's elements. Both live in `gargs`
    // and both are part of what makes this specialization the one it is. What
    // separates them is the count the declaration wrote, which every reader of
    // the run already has.
    //
    // The elements are collected on the argument stack first. Working out an
    // element's type reads what it names, and a name that is itself a generic
    // leaves a run of its own in `gargs`, so building this run there directly
    // would interleave the two.
    buf_start := p.argbuf.count
    mut primary: i64 = TY_I64
    mut types_seen: i64 = 0
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind == NodeKind::TypeVal && types_seen < declared) {
            if (types_seen == 0) {
                primary = vnode.val
            } else {
                arena_push(
                    p.argbuf,
                    GArg {
                        value = vnode.val,
                        is_type = 0,
                        pending = -1,
                        node = -1
                    }
                )
            }
            types_seen = types_seen + 1
        }
        id = next_id
    }
    mut count: i64 = 0
    mut index: i64 = 0
    mut seen: i64 = 0
    id = args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        // A type past the declared compile-time parameters is an element of the
        // list: a name the body writes where a type belongs, taking no
        // parameter and evaluated nowhere.
        if (vnode.kind == NodeKind::TypeVal) {
            if (seen >= declared) {
                arena_push(
                    p.argbuf,
                    GArg {
                        value = vnode.val,
                        is_type = 1,
                        pending = -1,
                        node = -1
                    }
                )
                count = count + 1
            }
            seen = seen + 1
        } else {
            if (index >= fixed) {
                later := pack_arg_pending(p, value)
                held := pack_arg_type(p, value)
                mut written := value
                if (later < 0) {
                    written = -1
                }
                arena_push(
                    p.argbuf,
                    GArg {
                        value = held,
                        is_type = 0,
                        pending = later,
                        node = written
                    }
                )
                count = count + 1
            }
            index = index + 1
        }
        id = next_id
    }
    if (gfn.pack_format >= 0) {
        check_format_call(p, args, gfn.pack_format, buf_start, count)
    }
    xstart := copy_run(p, buf_start)
    p.argbuf.count = buf_start
    p.call_xarg_start = xstart
    p.call_xarg_count = gfn.xparam_count + count
    p.call_pack_primary = primary
    true
}

// What a formatted value may be: a number, a yes or no, or text. Read through
// any name a type carries, the same way the bounds vocabulary reads one.
writable_by_format :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_integer(ty) || is_float(ty)) {
        return true
    }
    if (distinct_repr(ty) == TY_BOOL) {
        return true
    }
    is_slice_ty(p, ty) && array_element(p, ty) == TY_U8
}

// Whether this call hands on the literal and the values the declaration being
// parsed was given, rather than writing its own. `print` is the case: it takes
// a `format` parameter and a list and passes both to `write`, so the holes were
// counted against the values where the reader wrote them, and counting again
// here would be counting a name.
//
// Both halves are required. A body forwarding the literal beside values of its
// own would be handing over a count nothing had checked, which is the hole the
// word exists to close. The values are held to being this declaration's own
// trailing parameters in the order it declared them, which is what a forwarded
// list expands to and what writing a list out by hand is not. A call giving no
// values is the two being equal at zero.
forwards_own_format :: fn(mut p: Parser, args: i64) -> bool {
    mut i: i64 = 0
    while (i < p.format_forwards.count) {
        entry := arena_at(p.format_forwards, i)
        if (entry.node == args) {
            return true
        }
        i = i + 1
    }
    false
}

// Which recorded tuple a call's arguments came to, matched the way
// `note_type_args` matches so a call that deduped onto an earlier one finds
// that one. -1 where nothing holds it.
find_type_args :: fn(
    mut p: Parser,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    is_pack: i64,
    owner: i64
) -> i64 {
    mut i: i64 = 0
    while (i < p.type_args.count) {
        entry := arena_at(p.type_args, i)
        if (entry.arg == arg && entry.xarg_count == xarg_count
            && entry.is_pack == is_pack && entry.owner == owner
            && gargs_alike(p, entry.xarg_start, xarg_start, xarg_count)) {
            return i
        }
        i = i + 1
    }
    -1
}

// A call that took a format string, kept for the pass that reads its values.
// Only the literal is settled where the call is written, so only the holes are
// counted there; what the values are waits for every instance to be walked.
note_format_call :: fn(mut p: Parser, args: i64, fn_index: i64) {
    owner := generic_fn_of(p, fn_index)
    if (owner < 0) {
        return
    }
    gfn := arena_at(p.generic_fns, owner)
    if (gfn.pack_format < 0) {
        return
    }
    // A call handing on a literal it was given has already been counted where
    // that literal was written, and a call whose format string is not a literal
    // was refused there.
    if (forwards_own_format(p, args)) {
        return
    }
    fmt := nth_value_arg(p, args, gfn.pack_format)
    if (fmt < 0) {
        return
    }
    if (arena_at(p.arena, fmt).kind != NodeKind::StrLit) {
        return
    }
    tuple := find_type_args(
        p,
        p.call_pack_primary,
        p.call_xarg_start,
        p.call_xarg_count,
        owner + 1,
        owner
    )
    if (tuple < 0) {
        return
    }
    mut i: i64 = 0
    while (i < p.format_calls.count) {
        held := arena_at(p.format_calls, i)
        if (held.fmt == fmt && held.tuple == tuple) {
            return
        }
        i = i + 1
    }
    arena_push(
        p.format_calls,
        FormatCall { fmt = fmt, tuple = tuple, owner = owner }
    )
}

// What every format call was given, read after the fixpoint has settled it.
// This is the one place a value's type is judged: the parse cannot tell a
// `[]i64` from an `i64` while the call that answers with it is still waiting to
// be worked out, and by the time this runs there is nothing left waiting.
// Where a string literal begins, which is its opening quote. A literal's
// offset is the first byte of its text, and the text starts after the quote.
literal_at :: fn(node: Node) -> i64 {
    node.val - 1
}

check_format_types :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.format_calls.count) {
        held := arena_at(p.format_calls, i)
        entry := arena_at(p.type_args, held.tuple)
        gfn := arena_at(p.generic_fns, held.owner)
        start := entry.xarg_start + gfn.xparam_count
        count := entry.xarg_count - gfn.xparam_count
        node := arena_at(p.arena, held.fmt)
        mut k: i64 = 0
        while (k < count) {
            garg := arena_at(p.gargs, start + k)
            if (garg.is_type == 1) {
                report_where(p.modules, p.src, literal_at(node))
                report("a format string writes a value, and a type is not one")
                frost_rt_recover_escape()
            } else if (writable_by_format(p, garg.value) == false) {
                report_where(p.modules, p.src, literal_at(node))
                report("a format string writes a number, a yes or no, or a str, and this is a ")
                report_type_name(p, garg.value)
                frost_rt_recover_escape()
            }
            k = k + 1
        }
        i = i + 1
    }
}

// The same question asked where the answer is knowable: while the declaration
// that wrote the call is still being parsed, which is the only time the names
// it gave its own parameters are in hand. Every later pass reads what this
// noted, since by then the tables hold whatever was parsed last.
note_format_forward :: fn(mut p: Parser, args: i64, fn_index: i64) {
    owner := generic_fn_of(p, fn_index)
    if (owner < 0) {
        return
    }
    gfn := arena_at(p.generic_fns, owner)
    at := gfn.pack_format
    if (at < 0) {
        return
    }
    // What this declaration called its list. A template's own parse has it as
    // the name it wrote; an instance parse has the same name put back under
    // `pack_off`, which is what its body is read against.
    mut list_off := p.decl_pack_off
    mut list_len := p.decl_pack_len
    if (list_len == 0) {
        list_off = p.pack_off
        list_len = p.pack_len
    }
    if (p.decl_format_len == 0 || list_len == 0) {
        return
    }
    held := nth_value_arg(p, args, at)
    if (held < 0) {
        return
    }
    node := arena_at(p.arena, held)
    if (node.kind != NodeKind::Var || node.c != p.decl_format_len
        || bytes_equal(
            p.src,
            node.val,
            p.decl_format_off,
            p.decl_format_len
        ) == false) {
        return
    }
    // What is handed on past the literal. A template's own parse still writes
    // the list under its name, so that is one argument standing for however
    // many elements an instance will have. An instance's parse has the list
    // already spread into one argument per element, and those are the
    // parameters this declaration took them as, in the order it took them.
    // Either way a body writing values of its own is a different shape and
    // stays checked.
    mut given: i64 = 0
    while (nth_value_arg(p, args, at + 1 + given) >= 0) {
        given = given + 1
    }
    if (given == 1
        && names_the_pack(
            p,
            nth_value_arg(p, args, at + 1),
            list_off,
            list_len
        )) {
        arena_push(p.format_forwards, BoundValue { node = args })
        return
    }
    // An instance knows how many values its list was given, so a call handing
    // over a different number is writing a list of its own and stays counted. A
    // line with no values at all is the two agreeing at zero, which is what
    // `print("\n")` forwards. A type element is counted out: it takes no
    // argument, so handing the list on writes one fewer.
    if (given != pack_value_count(p)) {
        return
    }
    if (given == 0) {
        arena_push(p.format_forwards, BoundValue { node = args })
        return
    }
    mine := p.parse_param_end - given
    if (mine < p.parse_param_start) {
        return
    }
    mut k: i64 = 0
    while (k < given) {
        held2 := nth_value_arg(p, args, at + 1 + k)
        gnode := arena_at(p.arena, held2)
        entry := arena_at(p.parse_locals, mine + k)
        if (gnode.kind != NodeKind::Var || gnode.c != entry.name_len
            || bytes_equal(
                p.src,
                gnode.val,
                entry.name_off,
                entry.name_len
            ) == false) {
            return
        }
        k = k + 1
    }
    arena_push(p.format_forwards, BoundValue { node = args })
}

// How many of the list this instance was given are values. A type element is a
// name the body writes where a type belongs and takes no argument, so a body
// handing the list on writes one fewer for each of them.
pack_value_count :: fn(mut p: Parser) -> i64 {
    mut found: i64 = 0
    mut i: i64 = 0
    while (i < p.pack_count) {
        held := arena_at(p.gargs, p.pack_start + i)
        if (held.is_type == 0) {
            found = found + 1
        }
        i = i + 1
    }
    found
}

names_the_pack :: fn(
    mut p: Parser,
    held: i64,
    list_off: i64,
    list_len: i64
) -> bool {
    if (held < 0) {
        return false
    }
    node := arena_at(p.arena, held)
    if (node.kind != NodeKind::Var || node.c != list_len) {
        return false
    }
    bytes_equal(p.src, node.val, list_off, list_len)
}

// The literal a `format` parameter took, read where the call is written. How
// many values a line names is settled here, so the literal is read here too:
// the holes it opens are counted against the list that follows, and a type
// nothing can write is refused against the line the reader wrote rather than
// inside a body they never saw.
check_format_call :: fn(
    mut p: Parser,
    args: i64,
    at: i64,
    buf_start: i64,
    count: i64
) {
    node_id := nth_value_arg(p, args, at)
    if (node_id < 0) {
        return
    }
    node := arena_at(p.arena, node_id)
    if (node.kind != NodeKind::StrLit) {
        if (forwards_own_format(p, args)) {
            return
        }
        report_where(p.modules, p.src, literal_at(node))
        report("a format string is written as a literal, since how many values follow it is settled where the call is written")
        frost_rt_recover_escape()
        return
    }
    off := node.val
    length := node.c
    mut holes: i64 = 0
    mut k: i64 = 0
    while (k < length) {
        byte := p.src[off + k]
        if (byte == 123) {
            if (k + 1 >= length) {
                report_where(p.modules, p.src, literal_at(node))
                report("a '{' in a format string opens a hole or stands for one brace, so write '{}' or '{{'")
                frost_rt_recover_escape()
                return
            }
            next := p.src[off + k + 1]
            if (next == 125) {
                holes = holes + 1
            } else {
                if (next != 123) {
                    report_where(p.modules, p.src, literal_at(node))
                    report("a '{' in a format string opens a hole or stands for one brace, so write '{}' or '{{'")
                    frost_rt_recover_escape()
                    return
                }
            }
            k = k + 2
            continue
        }
        if (byte == 125 && k + 1 < length && p.src[off + k + 1] == 125) {
            k = k + 2
            continue
        }
        k = k + 1
    }
    if (holes != count) {
        report_where(p.modules, p.src, literal_at(node))
        report_fmt(
            "this format string opens {} hole(s) and the call gives {} value(s)",
            holes,
            count
        )
        frost_rt_recover_escape()
        return
    }
// What the values are is not settled here. An element whose type is what a
// call to a generic answers with reads as the default until every instance
// has been walked, so judging one here would accept a `[]i64` for reading
// as an `i64`. `check_format_types` reads them once there is nothing left
// waiting.
}

// The run built on the argument stack from `at` upward, moved into `gargs` in
// one piece. Answers where it landed.
copy_run :: fn(mut p: Parser, at: i64) -> i64 {
    start := p.gargs.count
    mut k: i64 = at
    while (k < p.argbuf.count) {
        held := arena_at(p.argbuf, k)
        value := held.value
        is_type := held.is_type
        pending := held.pending
        written := held.node
        arena_push(
            p.gargs,
            GArg {
                value = value,
                is_type = is_type,
                pending = pending,
                node = written
            }
        )
        k = k + 1
    }
    start
}

call_ret_type :: fn(mut p: Parser, args: i64, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    // A call through a local of function-pointer type is indirect and answers
    // with that signature's return type.
    if (local_exists(p, sym.off, sym.len)) {
        local_ty := lookup_local(p, sym.off, sym.len)
        if (is_proc(local_ty)) {
            return proc_ret(p, local_ty)
        }
    }
    if (generic_fn_of(p, fn_index) >= 0) {
        arg := call_args_for(p, args, fn_index)
        return mono_ret_type(
            p,
            fn_index,
            arg,
            p.call_xarg_start,
            p.call_xarg_count
        )
    }
    sym.ret_type
}

nth_value_arg :: fn(mut p: Parser, args: i64, n: i64) -> i64 {
    mut id := args
    mut seen: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            if (seen == n) {
                return value
            }
            seen = seen + 1
        }
        id = next_id
    }
    -1
}

count_value_args :: fn(mut p: Parser, args: i64) -> i64 {
    mut id := args
    mut count: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            count = count + 1
        }
        id = next_id
    }
    count
}
