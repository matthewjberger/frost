// The Frost compiler, written in Frost. This file is the driver. The modules it
// imports are named in dependency order below and each one is about a single
// concern.
//
// It reads a Frost program, lexes it into a token stream, parses that into an
// abstract syntax tree in an arena, checks it, and emits either a C translation
// unit or x86-64 assembly. It compiles its own source through either path to a
// byte-identical fixpoint, so through the assembly backend there is no C
// compiler anywhere in the loop.
//
// The whole thing is written against the data-oriented surface the language is
// for: no closures, no dynamic collections, references are second-class, and
// every mutable working set is an arena (the token stream, the AST, and the
// symbol tables). The arenas are the language's own allocator, a generic bump
// allocator over one `malloc` per arena, not a runtime pool.
//
// The AST is an arena of Node records. A node names its children by their arena
// index (a plain integer), which is the data-oriented replacement for pointers
// between heap nodes. Sibling statements, parameters, and call arguments are
// each threaded through a `next` field into a singly linked list.
//
// Identifiers are byte ranges into the source (offset + length). A local is
// emitted as its own name in the generated C, so no local symbol table is
// needed. Function names are interned to small integer indices through one
// global table, and a name becomes the `mf_<index>` of its emitted C function,
// which also keeps user names from colliding with the C runtime.

import "core.frost"
import "cli.frost"
import "format.frost"
import "lint.frost"
import "lexer.frost"
import "imports.frost"
import "names.frost"
import "const_eval.frost"
import "types.frost"
import "parser.frost"
import "emit_c.frost"
import "emit_asm.frost"
import "regions.frost"
import "query.frost"
import "blob.frost"
import "assemble.frost"
import "coff.frost"
import "elf.frost"

// One assembler run waiting to happen: the command line, and what it answered,
// read after the thread running it is joined.
Assembling :: struct {
    command: ^i8,
    status: i64,
}

// A thread's body. The context is the job it is for, which lives in the
// caller's arena and outlives the join.
run_assembling :: fn(raw: ^u8) {
    job := unsafe { ptr_cast($Assembling, raw) }
    unsafe { job^.status = frost_rt_run_command(job^.command) }
}

// A build that compiles each module to its own object. A module whose emitted
// code is byte for byte last build's is left alone, and the rest are assembled
// again. Then the objects are linked.
//
// This is where the time goes on a full build, so what pays is not assembling
// what did not change. Where this compiler encodes its own output the module's
// assembly stays in memory and never becomes a file at all; where the toolchain
// does the encoding it is written to `<build>/m<n>.s` for that program to read.
// A built program named for running rather than for writing. The name a link
// produces is a path, and a shell given a bare one searches what is on PATH
// rather than where the file is, so a program built into the working directory
// is not found there. Saying the directory is what makes it a path again.
//
// A name that already has a directory in it is left alone, since it is already
// telling the shell where to look.
runnable :: fn(path: ^i8) -> ^i8 {
    length := cstr_len(path)
    var index: i64 = 0
    while (index < length) {
        byte := unsafe { path[index] }
        if (byte == 47 || byte == 92) {
            return path
        }
        index = index + 1
    }
    if (frost_rt_is_windows() == 1) {
        return join_two(".\\", path)
    }
    join_two("./", path)
}

build_per_module :: fn(mut p: Parser, program: i64, options: Options) -> i64 {
    make_directory(options.build_dir)
    prefix := join_two(options.build_dir, "/m")
    var executable: ^i8 = options.output
    if (cstr_len(executable) == 0) {
        executable = "a.out"
        if (frost_rt_is_windows() == 1) {
            executable = "a.exe"
        }
    }

    // Whether this build encodes its own output. What the encoder reads is
    // assembly, so the C backend still hands each unit to the toolchain.
    assembles := options.backend == Backend::Asm
    // Grown to what each module turns out to need, so a build that hands its
    // units to the toolchain never grows any of it at all.
    var unit := assembly_of(object_format())
    var blob := object_blob()

    // Every assembler run this build needs, gathered before any of them is
    // started so they can all be handed to the machine at once. The work is one
    // process per module and they share nothing, which is the whole reason this
    // is worth threading and the rest of the compiler is not.
    var jobs: Arena<Assembling> = arena_make($Assembling, 4096)
    var records: Arena<Assembling> = arena_make($Assembling, 4096)

    var objects: ^i8 = ""
    var index: i64 = 0
    while (index < p.modules.count) {
        var suffix: ^i8 = ".s"
        if (options.backend == Backend::C) {
            suffix = ".c"
        }
        source := join_number(prefix, index, suffix)
        record := join_number(prefix, index, ".sum")
        object := join_number(prefix, index, ".o")
        if (assembles) {
            emit_to_memory()
        } else if (unsafe { frost_rt_emit_open(source) } == 0) {
            report("frost: cannot write '")
            report_cstr(source)
            report("'")
            frost_rt_die()
        }
        p.emit_module = index
        if (options.backend == Backend::C) {
            // Every unit carries the declarations, since a C unit cannot call
            // what it has not seen: the runtime's prototypes, every type, every
            // extern, and a prototype for every function and specialization in
            // the program. What differs between units is which bodies follow.
            emit_text("#include <stdio.h>\n")
            emit_text("#include <stdint.h>\n")
            emit_program(p, program)
        } else {
            emit_asm_program(p, program)
        }
        p.emit_module = -1

        var text := empty_source()
        var sum: i64 = 0
        if (assembles) {
            text = emit_memory_text()
            sum = text_checksum(text)
        } else {
            frost_rt_emit_close()
            sum = file_checksum(source)
        }
        var stale: bool = sum != stored_checksum(record)
        if (unsafe { frost_rt_file_exists(object) } == 0) {
            stale = true
        }
        if (stale && assembles) {
            assemble_into(unit, text)
            write_object(unit, blob, object)
            // The checksum goes down once the object it stands for is there, so
            // a build that dies partway leaves nothing claiming to be up to
            // date.
            write_checksum(record, sum)
        } else if (stale) {
            command := join_two(
                join_two(
                    join_two(join_two(c_compiler(), " -c "), source),
                    " -o "
                ),
                object
            )
            arena_push(jobs, Assembling { command = command, status = 0 })
            arena_push(records, Assembling { command = record, status = sum })
        }
        objects = join_two(join_two(objects, " "), object)
        index = index + 1
    }

    // All of them at once. One thread per run, since each is a process this one
    // only waits on.
    var handles: Arena<Assembling> = arena_make($Assembling, 4096)
    var started: i64 = 0
    while (started < jobs.count) {
        // The address of the element itself, not of a copy of it: the thread
        // reads the job while this loop goes on to the next one, and a copy
        // would be a stack slot this loop reuses.
        handle := unsafe {
            frost_rt_thread_spawn(
                run_assembling,
                ptr_cast($u8, ptr_to(jobs.data[started]))
            )
        }
        arena_push(handles, Assembling { command = "", status = handle })
        started = started + 1
    }
    var waited: i64 = 0
    while (waited < handles.count) {
        held := arena_at(handles, waited)
        unsafe { frost_rt_thread_join(held.status) }
        waited = waited + 1
    }
    var checked: i64 = 0
    while (checked < jobs.count) {
        job := arena_at(jobs, checked)
        if (job.status != 0) {
            report("frost: the assembler failed: ")
            report_cstr(job.command)
            report("\n")
            frost_rt_die()
        }
        entry := arena_at(records, checked)
        write_checksum(entry.command, entry.status)
        checked = checked + 1
    }

    runtime_object := cached_runtime_object(executable)
    frost_runtime := cached_frost_runtime_object(executable)
    var command := join_two(
        join_two(
            join_two(
                join_two(
                    join_two(
                        join_two(join_two(c_compiler(), objects), " "),
                        runtime_object
                    ),
                    " "
                ),
                frost_runtime
            ),
            " -o "
        ),
        executable
    )
    command = join_two(command, options.libs)
    if (frost_rt_is_windows() == 0) {
        command = join_two(command, " -lm")
    }
    if (unsafe { frost_rt_run_command(command) } != 0) {
        report("frost: the linker failed: ")
        report_cstr(command)
        report("\n")
        report("frost: the runtime linked was ")
        report_cstr(runtime_source())
        report(" and ")
        report_cstr(frost_runtime_source())
        report("\n")
        frost_rt_die()
    }
    if (options.testing == 1) {
        return unsafe { frost_rt_run_command(runnable(executable)) }
    }
    0
}

// Which object format this target reads. It decides how the encoder settles a
// reference as well as how the object is laid out, so it is asked once and
// carried into both.
// The host's format by default. FROST_OBJECT overrides it so the other
// target's object can be inspected and checked from either host, the way
// FROST_ABI does for the calling convention.
object_format :: fn() -> i64 {
    named := unsafe { frost_rt_getenv("FROST_OBJECT") }
    if (cstr_eq(named, "elf")) {
        return FORMAT_ELF
    }
    if (cstr_eq(named, "coff")) {
        return FORMAT_COFF
    }
    if (frost_rt_is_windows() == 1) {
        return FORMAT_COFF
    }
    FORMAT_ELF
}

write_object :: fn(mut unit: Assembly, mut object: Blob, path: ^i8) {
    if (object_format() == FORMAT_COFF) {
        write_coff_object(unit, object, path)
        return
    }
    write_elf_object(unit, object, path)
}

// Compile straight to an object: the assembly is emitted into memory and
// encoded from there, so the text is neither written for another program to
// read nor read back.
assemble_program :: fn(mut p: Parser, program: i64, output: ^i8) {
    emit_to_memory()
    emit_asm_program(p, program)
    text := emit_memory_text()
    var unit := assembly_of(object_format())
    var object := object_blob()
    assemble_into(unit, text)
    write_object(unit, object, output)
}

// Hand what was compiled to the linker, along with the runtime every program
// needs, and remove what it read. `unit` is an object where this compiler
// assembled its own output and assembly or C where it did not, and the
// toolchain takes any of the three.
//
// The runtime is two objects because it is two files: the checks an index and a
// slice compile to are Frost, in `runtime.frost`, and what they bottom out in is
// the C stub beside it, which also holds the assertion, the emitters and the
// test runner a `--test` build needs. FROST_RUNTIME and FROST_RUNTIME_FROST say
// where they are for a checkout that is not the working directory.
link_with_toolchain :: fn(unit: ^i8, executable: ^i8, options: Options) -> i64 {
    extra := join_two(
        join_two(join_two(" ", cached_runtime_object(executable)), " "),
        cached_frost_runtime_object(executable)
    )
    var base := join_two(
        join_two(
            join_two(join_two(join_two(c_compiler(), " "), unit), extra),
            " -o "
        ),
        executable
    )
    // A C unit is held to what Frost means rather than to what C allows: an
    // integer wraps on overflow here rather than being undefined, and
    // `ptr_cast` reads the same bytes through another type on purpose. A C
    // compiler entitled to assume neither ever happens is entitled to
    // miscompile the unit, and comparing this backend against the other one
    // would not show it, since both sides go through the same C compiler.
    if (options.backend != Backend::Asm) {
        base = join_two(base, " -fwrapv -fno-strict-aliasing")
    }
    // What `--libs` named goes after the objects and ahead of the platform's
    // own libraries, which is the order a linker resolves in: a named library
    // that reaches libm has to be seen before libm is.
    var command := join_two(base, options.libs)
    // A program that reaches the C math functions (std/math.frost's sqrtf and
    // the rest) needs libm where the platform keeps it out of the C runtime,
    // which is Linux and the BSDs. Windows keeps them in the CRT, so the flag
    // is only added off Windows.
    if (frost_rt_is_windows() == 0) {
        command = join_two(command, " -lm")
    }
    status := unsafe { frost_rt_run_command(command) }
    unsafe { frost_rt_remove_file(unit) }
    if (status != 0) {
        // Name the command, since a failing link is nearly always the toolchain
        // being absent or a path it could not read, and neither is guessable
        // from the bare word "failed".
        report("frost: the linker failed: ")
        report_cstr(command)
        report("\n")
        // And name the runtime, because the other way a link fails is a symbol
        // the runtime beside this compiler does not have. The object is keyed
        // on what that file holds, which cannot tell "the runtime changed"
        // apart from "a different runtime is being read", so the resolved path
        // is the thing that distinguishes them and the linker never says it.
        report("frost: the runtime linked was ")
        report_cstr(runtime_source())
        report(" and ")
        report_cstr(frost_runtime_source())
        report("\n")
        frost_rt_die()
    }
    // Building the tests and not running them would be half an answer, so the
    // process ends on what they said.
    if (options.testing == 1) {
        return unsafe { frost_rt_run_command(runnable(executable)) }
    }
    0
}

// Read assembly and write the object it stands for. The encoder is checked
// against the system assembler byte for byte, so this and `as` produce the
// same code.
assemble_file :: fn(input: ^i8, output: ^i8) -> i64 {
    if (cstr_len(input) == 0 || cstr_len(output) == 0) {
        report("frost: --assemble needs an input file and -o\n")
        frost_rt_die()
    }
    raw := unsafe { frost_rt_read_file(input) }
    if (cstr_len(raw) == 0) {
        report("frost: cannot read ")
        report_cstr(input)
        report("\n")
        frost_rt_die()
    }
    var unit := assembly_of(object_format())
    var object := object_blob()
    assemble_into(unit, cstr_slice(raw))
    write_object(unit, object, output)
    0
}

// Whether the assembly backend writes what its scan found about each name into
// the emitted text. An environment variable rather than an option, because what
// it produces is for reading rather than for assembling.
asm_debug_names_wanted :: fn() -> i64 {
    if (cstr_len(unsafe { frost_rt_getenv("FROST_ASM_NAMES") }) != 0) {
        return 1
    }
    0
}

main :: fn() -> i64 {
    if (json_reports()) {
        frost_rt_json_reports()
    }
    // `fmt` is read off the arguments before the flags, since the compiler has
    // taken a file as its first argument since before it took anything else.
    if (frost_rt_arg_count() > 1
        && cstr_eq(frost_rt_arg_at(1), "fmt")) {
        return format_command()
    }
    options := options_from_command_line()
    if (options.help == 1) {
        usage()
        return 0
    }
    if (options.ok == 0) {
        frost_rt_die()
    }

    // `--assemble` does not compile anything: it reads assembly and writes the
    // object that text stands for, which is what lets a build reach an object
    // without a separate assembler.
    if (options.assemble == 1) {
        return assemble_file(options.input, options.output)
    }

    // With no file named anywhere, the built-in demonstration program is what
    // gets compiled, which is what makes the compiler runnable with no
    // arguments at all.
    input_path := options.input
    // The whole program's text: the source of every module laid end to end,
    // followed by room for the names the compiler makes up. It is a slice, so
    // reading and writing it is a checked index everywhere below.
    var source := empty_source()
    var modules: Arena<Module> = arena_make($Module, 4096)
    var exports: Arena<Export> = arena_make($Export, 4096)
    var import_edges: Arena<ImportEdge> = arena_make($ImportEdge, 4096)
    var renames: Arena<Rename> = arena_make($Rename, 4096)
    export_names := buffer_of(SYNTH_ROOM)
    if (cstr_len(input_path) != 0) {
        // One buffer holds the root file and everything it imports, so a name
        // is an offset into a single source no matter which file wrote it.
        buffer := buffer_of(SOURCE_ROOM + SYNTH_ROOM)
        var scratch: Arena<Token> = arena_make($Token, 262144)
        // What the project declares, after anything the command line named and
        // before the standard library, which is the order the other compiler
        // assembles them in.
        manifest_roots(input_path, options.roots, options.layers)
        search_roots_from(options.roots)
        resolve_imports(
            buffer,
            input_path,
            export_names,
            modules,
            exports,
            import_edges,
            renames,
            scratch,
            options.roots,
            options.layers
        )
        source = buffer
    }
    if (str_len(source) <= 1) {
        source = "
        strlen :: extern fn(s: ^i8) -> i64
        frost_rt_write_i64 :: safe extern fn(value: i64)
        frost_rt_write_char :: safe extern fn(byte: i64)

        print_int_line :: fn(value: i64) {
            frost_rt_write_i64(value)
            frost_rt_write_char(10)
        }

        ANSWER :: 42

        fib :: fn(n: i64) -> i64 {
            if (n < 2) { return n }
            return fib(n - 1) + fib(n - 2)
        }

        fact :: fn(n: i64) -> i64 {
            if (n < 1) { return 1 }
            return n * fact(n - 1)
        }

        Point :: struct { x: i64, y: i64 }

        sum_point :: fn(pt: Point) -> i64 {
            return pt.x + pt.y
        }

        bump :: fn(b: ^Point) {
            unsafe { b^.x = b^.x + 1 }
        }

        classify :: fn(n: i64) -> i64 {
            var result : i64 = 0
            match n {
                case 0: result = 100
                case 1: result = 200
                case _: result = 999
            }
            return result
        }

        Box :: struct($T: Type) { value: $T }

        Holder :: struct { item: Box<i64> }

        box_make :: fn($T: Type, v: $T) -> Box<T> {
            Box { value = v }
        }

        box_get :: fn(b: Box<$T>) -> $T {
            unsafe { b^.value }
        }

        main :: fn() -> i64 {
            print_int_line(fib(10))
            print_int_line(fact(5))
            var sum : i64 = 0
            var index : i64 = 1
            while (index <= 10) { sum = sum + index  index = index + 1 }
            print_int_line(sum)
            p := Point { x = 3, y = 4 }
            print_int_line(p.x)
            p.x = 10
            print_int_line(sum_point(p))
            ptr := ptr_to(p)
            bump(ptr)
            print_int_line(p.x)
            unsafe {
                print_int_line(ptr^.y)
                print_int_line(ptr[0].x)
                q := ptr_cast($Point, ptr)
                print_int_line(q^.x)
            }
            print_int_line(sizeof(Point))
            print_int_line(classify(0))
            print_int_line(classify(1))
            print_int_line(classify(7))
            unsafe { print_int_line(strlen(\"hello\")) }
            print_int_line(ANSWER)
            h := Holder { item = box_make(77) }
            print_int_line(box_get(h.item))
        }
    "
    }
    // The demo program is a literal with nowhere to write, so it needs the same
    // copy with room past the terminator that an imported source already has.
    if (cstr_len(input_path) == 0) {
        source = source_with_room(source)
    }

    var parser := Parser {
        src = source,
        tokens = arena_make($Token, 262144),
        ti = 0,
        arena = arena_make($Node, 262144),
        fns = arena_make($Sym, 8192),
        structs = arena_make($StructDef, 4096),
        fields = arena_make($StructField, 8192),
        locals = arena_make($LocalVar, 4096),
        spill_slots = arena_make($LocalVar, 256),
        asm_names = arena_make($AsmName, 256),
        asm_returns = 0,
        asm_loop_depth = 0,
        asm_save_base = -1,
        asm_saved = 0,
        spill_depth = 0,
        consts = arena_make($ConstDef, 4096),
        const_fns = arena_make($ConstFn, 4096),
        const_locals = arena_make($ConstLocal, 256),
        const_stack = arena_make($ConstFrame, 64),
        const_args = arena_make($ConstValue, 256),
        const_items = arena_make($ConstItem, 65536),
        const_aggregates = arena_make($ConstDef, 1024),
        const_steps = 0,
        const_quiet = 0,
        const_failed = 0,
        value_consts = arena_make($ConstDef, 4096),
        instances = arena_make($Instance, 4096),
        const_faults = arena_make($i64, 256),
        const_repeat = 0,
        refused_pools = arena_make($i64, 64),
        told_moves = arena_make($ToldMove, 256),
        generic_fns = arena_make($GenericFn, 4096),
        caps = arena_make($Cap, 4096),
        providers = arena_make($Provider, 4096),
        aliases = arena_make($Alias, 64),
        frame_used = 0,
        emit_module = -1,
        field_bindings = arena_make($LocalVar, 64),
        parse_locals = arena_make($LocalVar, 4096),
        parse_local_values = arena_make($BoundValue, 4096),
        parse_param_start = 0,
        parse_param_end = 0,
        pack_off = 0,
        pack_len = 0,
        pack_start = 0,
        pack_count = 0,
        gparams = arena_make($GParam, 4096),
        cfn_params = arena_make($GParam, 4096),
        gargs = arena_make($GArg, 4096),
        // A signature per function type in the whole import closure, and a
        // slot per parameter of one. The wgpu binding alone declares a
        // callback type and a constructor against it per callback, so these
        // two count what a program reaches rather than what it writes.
        procs = arena_make($ProcSig, 16384),
        proc_params = arena_make($GArg, 16384),
        argbuf = arena_make($GArg, 4096),
        pending_rets = arena_make($PendingRet, 4096),
        format_forwards = arena_make($BoundValue, 256),
        format_calls = arena_make($FormatCall, 256),
        summaries = arena_make($Summary, 4096),
        summary_steps = arena_make($SummaryStep, 4096),
        run_views = arena_make($Summary, 4096),
        run_replaces = arena_make($Summary, 4096),
        run_steps = arena_make($SummaryStep, 4096),
        runs_fn = -1,
        runs_params = -1,
        runs_answers_view = 0,
        run_locals = arena_make($LocalVar, 1024),
        view_runs = arena_make($LocalVar, 1024),
        stale_views = arena_make($LocalVar, 1024),
        stale_scratch = arena_make($LocalVar, 1024),
        run_replacements = 0,
        run_chain_open = 0,
        run_chain_start = 0,
        moves_quiet = 0,
        moves_answers = 0,
        moves_params = -1,
        gbindings = arena_make($GBinding, 4096),
        type_param_off = 0,
        type_param_len = 0,
        xparam_start = 0,
        xparam_count = 0,
        call_xarg_start = 0,
        call_xarg_count = 0,
        call_pack_primary = 0,
        pending_gt = 0,
        type_binding = 0,
        binding_active = 0,
        expected_type = 0,
        expected_alt = -1,
        ok_ty = -1,
        variant_fixups = arena_make($VariantFixup, 4096),
        saw_type_param = 0,
        tparam_is_slot = 0,
        tparam_called = 0,
        bound_token = -1,
        decl_pack_off = 0,
        decl_pack_len = 0,
        decl_pack_fixed = 0,
        decl_pack_format = -1,
        decl_format_off = 0,
        decl_format_len = 0,
        tparam_is_value = 0,
        tparam_fallback = -1,
        last_return_type = 0,
        no_struct_lit = false,
        last_type_was_generic = 0,
        unsafe_spans = arena_make($UnsafeSpan, 4096),
        unsafe_depth = 0,
        defers = arena_make($LocalVar, 256),
        defer_base = 0,
        defer_count = 0,
        block_depth = 0,
        defer_depth = -1,
        tparam_through = 0,
        gparam_settled = 0,
        gparam_settler_off = 0,
        gparam_settler_len = 0,
        gparam_name_off = 0,
        gparam_name_len = 0,
        pending_tuples = arena_make($PendingTuple, 4096),
        pending_types = arena_make($GArg, 16384),
        mono_depth = 0,
        mono_on_demand = 1,
        moved = arena_make($LocalVar, 4096),
        move_views = arena_make($LocalVar, 1024),
        label_id = 0,
        abi_windows = 0,
        args_unbound_map = 0,
        loop_top = -1,
        loop_end = -1,
        frame_id = 0,
        asm_ret = 0,
        sret_slot = 0,
        mono_rets = arena_make($MonoRet, 4096),
        mono_nodes = arena_make($MonoNode, 4096),
        current_ret = 0,
        current_fn_off = 0,
        current_fn_len = 0,
        tainted = arena_make($LocalVar, 4096),
        inner = arena_make($LocalVar, 4096),
        region_off = 0,
        region_len = 0,
        region_returns = 0,
        frame_storage = arena_make($LocalVar, 4096),
        frame_outlives = arena_make($LocalVar, 4096),
        frame_locals = arena_make($LocalVar, 4096),
        answer_masks = arena_make($AnswerMask, 4096),
        // One mask per parameter of every function, which is what says
        // who holds a pointer handed to a call for as long as it lives.
        kept_masks = arena_make($AnswerMask, 131072),
        mask_views_copy = 0,
        answer_locals = arena_make($LocalVar, 4096),
        frame_places = arena_make($LocalVar, 4096),
        frame_reported = arena_make($LocalVar, 4096),
        walk_types = arena_make($LocalVar, 4096),
        region_via_pointer = arena_make($LocalVar, 4096),
        frame_ret = -1,
        frame_answers_view = 0,
        frame_answers_place = 0,
        arith_site = 0,
        mut_params = arena_make($LocalVar, 8192),
        value_params = arena_make($LocalVar, 4096),
        move_scratch = arena_make($LocalVar, 4096),
        modules = modules,
        exports = exports,
        import_edges = import_edges,
        renames = renames,
        shared_exports = 0,
        export_names = export_names,
        result_ty = -1,
        failure_ty = -1,
        multi_ty = -1,
        multi_count = 0,
        multi_calls = arena_make($LocalVar, 1024),
        multi_discards = arena_make($LocalVar, 1024),
        variants = arena_make($Variant, 4096),
        match_count = 0,
        case_variant = -1,
        case_bindings = -1,
        type_args = arena_make($TypeArg, 4096),
        pending = arena_make($LocalVar, 4096),
        try_count = 0,
        name_tag = 0,
        name_value = 0,
        name_error = 0,
        name_ok = 0,
        name_err = 0,
        name_ok_value = 0,
        name_err_error = 0,
        synth_next = 0,
        prov_kind = 0,
        prov_off = 0,
        prov_len = 0,
        type_aliases = arena_make($ConstDef, 4096),
        flag_bits = arena_make($FlagBit, 4096),
        arrays = arena_make($ArrayDef, 4096),
        indirects = arena_make($Indirect, 4096),
        tests = arena_make($TestCase, 4096),
        testing = options.testing,
        runtime_names = compiling_the_runtime(input_path),
        audit_unsafe = options.audit_unsafe,
        linting = options.linting,
        debug_lines = options.debug_lines,
        asm_debug_names = asm_debug_names_wanted(),
        type_cache = arena_make($TypeCacheEntry, 262144),
        type_cache_on = 0,
        type_check_names = 0,
        bracket_depth = 0,
    }
    // Names the compiler synthesizes go past the source's terminator, so the
    // first free byte is one past the text.
    parser.synth_next = source_end(source) + 1
    // The two names of each rename move into the source, so every lookup
    // compares bytes in one buffer the way it always has.
    place_renames(parser, export_names)
    // The host convention by default. FROST_ABI overrides it so the other
    // target's output can be inspected from either host.
    parser.abi_windows = frost_rt_is_windows()
    abi := unsafe { frost_rt_getenv("FROST_ABI") }
    if (cstr_eq(abi, "sysv")) {
        parser.abi_windows = 0
    }
    if (cstr_eq(abi, "win")) {
        parser.abi_windows = 1
    }
    tokenize(source, source_end(source), parser.tokens)
    // What `include_str` names arrives as a string literal before anything
    // reads the tokens, so no pass after this one knows the feature exists.
    expand_includes(parser)
    // Whether two modules here export the same name, which decides how careful
    // a name lookup has to be. Known from the export lines alone, so it is
    // answered before anything is parsed.
    check_export_collisions(parser)
    program := parse_program(parser)
    // The parser kept reading past its faults so every one of them is on
    // stderr, and a program that faulted at all is still refused, here, once
    // the whole file has had its say.
    if (frost_rt_recover_failures() > 0) {
        frost_rt_die()
    }
    // Everything the parse still owes, now that every signature is known: the
    // `.Variant` an argument left unresolved. A generic's body is parsed again
    // per instance and owes the same, so this is called from there too.
    resolve_variant_fixups(parser)
    // The resources a `_` would drop, once every declaration has said whether
    // it holds one.
    check_discarded_resources(parser)
    // Which generics to emit is a fixpoint rather than one pass. Parsing an
    // instance creates the calls its body makes, and one of those may name an
    // argument tuple nothing had asked for: a sort taking a comparison calls a
    // swap that takes only the element type. Keep going until a round finds no
    // new tuple.
    // The tuples of calls written before what they name was declared. Their
    // arguments were taken down where they stand, so this needs no names in
    // scope and runs before the instances settle.
    settle_pending_tuples(parser)
    var known: i64 = -1
    while (known != parser.type_args.count) {
        known = parser.type_args.count
        collect_type_args(parser)
        record_mono_rets(parser)
        // A list element whose type is what a call to a generic answers with
        // was written down before that answer was worked out. Reading it here
        // names a tuple nothing has been instantiated for, which is a round
        // that found something new whatever the count says.
        if (settle_pack_args(parser)) {
            known = -1
        }
    }
    // What every format call was given, now that the fixpoint has settled what
    // each list holds. It waits for that: an element whose type is what a call
    // to a generic answers with reads as the default until every instance has
    // been walked.
    // Every instance the program asks for has been parsed, so nothing below is
    // entitled to add one: a walk over the program reading a template into it
    // would be reading a body nobody wrote where it stands.
    parser.mono_on_demand = 0
    check_format_types(parser)
    check_calls(parser)
    check_entry_point(parser, program)
    check_pooled_resources(parser)
    check_regions(parser)
    check_frame_escapes(parser)
    check_reference_fields(parser)
    check_borrow_exclusivity(parser)
    check_moves(parser)
    // Last of the checks, because it is the one that walks functions the way
    // the emitters do, and the passes before it read whatever local table the
    // parse left behind.
    check_types(parser, program)
    // Every fault the walks above reported, refused here before the unsafety
    // gate reads annotations a faulted function never finished writing, and
    // before any backend writes a word.
    if (frost_rt_recover_failures() > 0) {
        frost_rt_die()
    }
    // After the types, because whether an index or a field read goes through a
    // raw pointer is a question about a local's type, and check_types is where
    // the locals are known. It writes the answer onto the node and this reads
    // it.
    check_unsafety(parser)

    // `frost lint <file>` says what is worth a look and refuses nothing, so it
    // runs after the checks and before anything is emitted.
    if (options.linting == 1) {
        return lint_program(parser)
    }

    // An editor's question about a checked program, answered instead of a
    // build. The program was parsed and checked exactly as a build would
    // have, so the answer reads the same tables a build reads.
    question := unsafe { frost_rt_getenv("FROST_QUERY") }
    if (cstr_len(question) > 0) {
        run_query(parser, program, question)
        return 0
    }

    // The checks are done, so a node's type is settled. The memo is what makes
    // emit stop re-deriving the same ones, and a per-module build emits as many
    // times as there are modules, so it is turned on before either path.
    type_cache_prepare(parser)
    parser.type_cache_on = 1

    // One object per module, assembling only the ones whose emitted code
    // changed. The cache is the emitted assembly itself: the compiler has just
    // written what this module compiles to, so whether its object is stale is a
    // comparison of those bytes against last time's, and nothing else has to be
    // hashed, fingerprinted or walked.
    if (options.incremental == 1) {
        return build_per_module(parser, program, options)
    }

    // An object needs somewhere to go, and assembly on standard output is what
    // --emit-asm is for. Asked before anything is emitted, so the answer is not
    // a program's worth of assembly followed by a complaint.
    if (options.object == 1 && options.link == 0
        && cstr_len(options.output) == 0) {
        report("frost: --native writes an object, so it needs -o <path>\n")
        frost_rt_die()
    }

    var executable: ^i8 = options.output
    if (options.link == 1 && cstr_len(executable) == 0) {
        executable = "a.out"
        if (frost_rt_is_windows() == 1) {
            executable = "a.exe"
        }
    }

    // The encoder is part of this compiler, so a build that ends in an object
    // reaches one without writing assembly for another program to read back.
    if (options.backend == Backend::Asm
        && (options.object == 1 || options.link == 1)) {
        var object: ^i8 = options.output
        if (options.link == 1) {
            object = join_two(executable, ".o")
        }
        assemble_program(parser, program, object)
        if (options.link == 0) {
            return 0
        }
        return link_with_toolchain(object, executable, options)
    }

    // Where the emitted text goes. A link needs it in a file whatever the
    // caller asked for, so it writes one beside the executable and removes it
    // afterwards. Without -o and without --link it goes to standard output.
    var emit_path: ^i8 = options.output
    if (options.link == 1) {
        if (options.backend == Backend::Asm) {
            emit_path = join_two(executable, ".s")
        } else {
            emit_path = join_two(executable, ".c")
        }
    } else if (options.object == 1 && cstr_len(options.output) != 0) {
        // The object goes where -o said, so the assembly it is made from is
        // written beside it and removed once the toolchain has read it.
        emit_path = join_two(options.output, ".s")
    }
    if (cstr_len(emit_path) != 0) {
        if (unsafe { frost_rt_emit_open(emit_path) } == 0) {
            report("frost: cannot write '")
            report_cstr(emit_path)
            report("'")
            frost_rt_die()
        }
    }

    if (options.backend == Backend::Asm) {
        emit_asm_program(parser, program)
    } else {
        emit_text("#include <stdio.h>\n")
        emit_text("#include <stdint.h>\n")
        emit_program(parser, program)
    }
    frost_rt_emit_close()

    // `--native` answers with an object, so the emitted assembly goes to the
    // toolchain rather than to the caller. Without an output path there is
    // nowhere for an object to go, and assembly on standard output is what
    // `--emit-asm` is for.
    if (options.object == 1 && options.link == 0) {
        build := join_two(
            join_two(
                join_two(join_two(c_compiler(), " -c "), emit_path),
                " -o "
            ),
            options.output
        )
        status := unsafe { frost_rt_run_command(build) }
        unsafe { frost_rt_remove_file(emit_path) }
        if (status != 0) {
            report("frost: the assembler failed: ")
            report_cstr(build)
            report("\n")
            frost_rt_die()
        }
        return 0
    }

    if (options.link == 1) {
        return link_with_toolchain(emit_path, executable, options)
    }
    0
}

// `frost fmt <paths...>`: write the one rendering of every file named, or with
// `--check` write nothing and name the files that are not already it.
format_command :: fn() -> i64 {
    check: bool = false
    var index: i64 = 2
    var count := frost_rt_arg_count()
    while (index < count) {
        if (cstr_eq(frost_rt_arg_at(index), "--check")) {
            check = true
        }
        index = index + 1
    }
    var refused: i64 = 0
    index = 2
    while (index < count) {
        path := frost_rt_arg_at(index)
        if (cstr_eq(path, "--check") == false) {
            refused = refused + format_one(path, check)
        }
        index = index + 1
    }
    refused
}

// One file: read it, render it into memory, and either write it back or say it
// differs. Rendering into memory rather than over the file is what lets
// `--check` ask without writing.
format_one :: fn(path: ^i8, check: bool) -> i64 {
    raw := unsafe { frost_rt_read_file(path) }
    if (cstr_len(raw) == 0) {
        return 0
    }
    src := cstr_slice(raw)
    length := cstr_len(raw)
    emit_to_memory()
    format_source(src, length)
    written := emit_memory_text()
    if (same_text(src, length, written)) {
        return 0
    }
    if (check) {
        report_cstr(path)
        report("\n")
        return 1
    }
    if (unsafe { frost_rt_emit_open(path) } == 0) {
        report("frost fmt: cannot write ")
        report_cstr(path)
        report("\n")
        return 1
    }
    report_text(written)
    frost_rt_emit_close()
    0
}

report_text :: fn(text: str) {
    var index: i64 = 0
    var length := str_len(text)
    while (index < length) {
        frost_rt_emit_char(cast($i64, text[index]))
        index = index + 1
    }
}

same_text :: fn(src: str, length: i64, written: str) -> bool {
    if (str_len(written) != length) {
        return false
    }
    var index: i64 = 0
    while (index < length) {
        if (src[index] != written[index]) {
            return false
        }
        index = index + 1
    }
    true
}
