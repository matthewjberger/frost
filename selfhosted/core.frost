// Externs, the constant tables, the node and symbol records, the arena, and
// the Parser that every pass threads through itself.

export ARRAY_BASE, Arena, ArrayDef, CH_0, CH_9, TestCase, CH_AMP, CH_BACKSLASH, CH_BANG, CH_CARET, CH_COLON,
    CH_COMMA, CH_CR, CH_DOLLAR, CH_DOT, CH_DQUOTE, CH_EQ, CH_GT, CH_LBRACE,
    CH_LBRACKET, CH_LF, CH_LOWER_A, CH_LOWER_N, CH_LOWER_T, CH_LOWER_Z,
    CH_LPAREN, CH_LT, CH_MINUS, CH_PERCENT, CH_PIPE, CH_PLUS, CH_QUESTION,
    CH_RBRACE, CH_RBRACKET, CH_RPAREN, CH_SEMI, CH_SLASH, CH_SPACE, CH_STAR,
    CH_TAB, CH_UNDERSCORE, CH_UPPER_A, CH_UPPER_Z, Alias, ConstDef, Export,
    CH_LOWER_B, CH_LOWER_E, CH_LOWER_F, CH_LOWER_X, CH_UPPER_B, CH_UPPER_E,
    CH_UPPER_F, CH_UPPER_X,
    Cap, Provider, FlagBit, Indirect,
    AnswerMask, AsmName, GenericFn, GParam, GArg, GBinding, ImportEdge, Instance,
    LocalVar, Module,
    Rename,
    MonoNode,
    BoundValue, Summary, SummaryStep,
    MonoRet, PendingRet, ProcSig, CONST_BASE, PROC_BASE, FN_BASE, DISTINCT_BASE,
    DISTINCT_STRIDE, Node, NodeKind,
    OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LE, OP_LT, OP_MOD, OP_MUL,
    OP_NE, OP_OR, OP_SUB, OP_SHL, OP_SHR, OP_BITAND, OP_BITOR,
    OP_WRAP_ADD, OP_WRAP_SUB, OP_WRAP_MUL,
    op_answers_truth,
    BORROW_FLAG, POINTER_BASE, INDIRECT_BASE, Parser, STRUCT_BASE, StructDef,
    StructField, Sym, TokenKind, VariantFixup, FixupKind, TY_BOOL, TY_F32, TY_F64, TY_HANDLE, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE,
    TY_PARAM, TY_U16,
    TY_U32, TY_U64, TY_U8, TY_USIZE, TY_VOID, Token, TypeArg,
    TypeCacheEntry, UnsafeSpan,
    Variant,
    add_root, add_layer, Layer, layer_of, path_under,
    arena_at, arena_make, arena_push, cstr_eq, emit_text, frost_rt_alloc,
    frost_rt_check_size, frost_rt_check_span,
    emit_to_memory, emit_memory_text,
    report, report_cstr, report_int, report_src, SearchRoot,
    buffer_of, cstr_slice, empty_source, source_end, byte_at, byte_set,
    cstr_len,
    frost_rt_arg_at, frost_rt_arg_count,
    frost_rt_die, frost_rt_emit_char, frost_rt_emit_close, frost_rt_emit_int,
    frost_rt_emit_open, frost_rt_error, frost_rt_error_int, frost_rt_error_src,
    frost_rt_file_exists, frost_rt_absolute_path,
    frost_rt_getenv, frost_rt_is_windows,
    frost_rt_read_file, frost_rt_remove_file, frost_rt_run_command,
    frost_rt_thread_spawn, frost_rt_thread_join,
    frost_rt_recover_run, frost_rt_recover_escape, frost_rt_recover_note,
    frost_rt_recover_failures

// The runtime's allocator rather than the C library's, so a request that cannot
// be met stops here with a message instead of answering null and leaving the
// caller to write through it. Safe because the call either gives back a block or
// does not return; what is done with the block is gated as ever.
frost_rt_alloc :: safe extern fn(size: i64) -> ^u8
// How many bytes a count of elements takes, refused where the product would
// wrap. Safe because it is arithmetic and an abort.
frost_rt_check_size :: safe extern fn(count: i64, width: i64) -> i64
// A view of `count` elements starting `from` into a run of `room`, refused where
// it reaches past the end. Safe for the same reason.
frost_rt_check_span :: safe extern fn(from: i64, count: i64, room: i64) -> i64
frost_rt_byte_at :: extern fn(s: ^i8, i: i64) -> i64
frost_rt_str_len :: extern fn(s: ^i8) -> i64
// Emits a counted run of bytes. The read is bounded by the length, so the one
// caller, emit_text below, hands it a `str` whose length it already knows
// and the emit path is safe. Only this declaration keeps the gate.
frost_rt_emit_bytes :: extern fn(data: ^u8, length: i64)
frost_rt_emit_int :: safe extern fn(value: i64)
frost_rt_emit_char :: safe extern fn(byte: i64)
// Send the emitted text to memory rather than to a file. The buffer belongs to
// the runtime and grows to hold whatever is emitted, so what comes back is
// where it ended up and how much of it there is.
frost_rt_emit_to_memory :: safe extern fn()
frost_rt_emit_memory_length :: safe extern fn() -> i64
frost_rt_emit_memory_at :: extern fn() -> ^u8
frost_rt_emit_memory_done :: safe extern fn()
frost_rt_read_file :: extern fn(path: ^i8) -> ^i8
frost_rt_byte_set :: extern fn(buffer: ^i8, index: i64, value: i64)

// Emit a string. A `str` carries its own length, so this reads exactly that
// many bytes rather than scanning for a terminator, which is what lets every
// caller emit without an `unsafe` block. A string literal is a `str` by the
// same coercion that gives one a length everywhere else.
emit_text :: fn(s: str) {
    length := str_len(s)
    if (length == 0) {
        return
    }
    unsafe { frost_rt_emit_bytes(ptr_to(s[0]), length) }
}

// Emit into memory instead of a file, for a build that hands its own output to
// the assembler rather than to the toolchain: the text never becomes a file, so
// it is neither written nor read back.
emit_to_memory :: fn() {
    frost_rt_emit_to_memory()
}

// What was emitted, as a run of bytes carrying its own length, which is the
// last thing read through a bare pointer before the assembler reads it as a
// slice like everything else.
emit_memory_text :: fn() -> str {
    length := frost_rt_emit_memory_length()
    frost_rt_emit_memory_done()
    if (length == 0) {
        return empty_source()
    }
    unsafe { slice_from($u8, frost_rt_emit_memory_at(), length) }
}

// Diagnostics. The emitted C goes to stdout, so an error is composed on stderr
// piece by piece and frost_rt_die ends the process.
//
// The ones taking only numbers, or nothing, cannot corrupt memory whatever they
// are handed, so they are `safe` and need no block. The ones taking a `^i8` read
// until a NUL, and `ptr_to` hands out a `^i8` without one at no cost, so those
// keep the gate. The caller is what promises the terminator.
frost_rt_error :: extern fn(text: ^i8)
frost_rt_error_src :: extern fn(text: ^i8, offset: i64, length: i64)
frost_rt_error_bytes :: extern fn(data: ^u8, length: i64)
frost_rt_error_int :: safe extern fn(value: i64)
frost_rt_die :: safe extern fn()
frost_rt_is_windows :: safe extern fn() -> i64
frost_rt_getenv :: extern fn(name: ^i8) -> ^i8

// Compose a diagnostic on stderr. A `str` is written by the length it carries,
// a source range by the length it is given, and a C string by the length up to
// its terminator. Each confines its one unchecked step to itself, so the code
// that reports an error calls them without an `unsafe` block of its own.
report :: fn(s: str) {
    length := str_len(s)
    if (length == 0) {
        return
    }
    unsafe { frost_rt_error_bytes(ptr_to(s[0]), length) }
}

// A number in a diagnostic. `frost_rt_emit_int` writes to the emit stream,
// which is where a backend's output goes, so a diagnostic that used it put its
// number somewhere else and the message came out in pieces.
report_int :: fn(value: i64) {
    if (value == 0) {
        report("0")
        return
    }
    var held := value
    if (held < 0) {
        report("-")
        held = -held
    }
    var digits: [24]u8 = [0; 24]
    var count: i64 = 0
    while (held > 0) {
        digits[count] = cast($u8, 48 + (held % 10))
        held = held / 10
        count = count + 1
    }
    while (count > 0) {
        count = count - 1
        unsafe { frost_rt_error_bytes(ptr_to(digits[count]), 1) }
    }
}

report_src :: fn(src: str, offset: i64, length: i64) {
    unsafe {
        frost_rt_error_bytes(ptr_cast($u8, ptr_to(src[offset])), length)
    }
}

report_cstr :: fn(s: ^i8) {
    unsafe {
        frost_rt_error_bytes(ptr_cast($u8, s), cstr_len(s))
    }
}

// The command line, and the two things a compiler does with the world once it
// has read one: put its output somewhere, and run the tool that finishes the
// build. Emitted output goes to standard output until a file is opened for it.
frost_rt_arg_count :: safe extern fn() -> i64
frost_rt_arg_at :: safe extern fn(index: i64) -> ^i8
frost_rt_emit_open :: extern fn(path: ^i8) -> i64
frost_rt_emit_close :: safe extern fn()
frost_rt_run_command :: extern fn(command: ^i8) -> i64
// One OS thread, for the one thing this compiler does more than once at a time:
// handing several assembler runs to the machine at once rather than waiting out
// each in turn. The body takes the raw pointer the spawner gives it, which is
// the shape C wants, and casts it back to what it knows.
frost_rt_thread_spawn :: extern fn(body: fn(^u8), context: ^u8) -> i64
frost_rt_thread_join :: extern fn(handle: i64)
// Parser recovery: run the body with an escape armed, so a fault ends the
// declaration it is in rather than the compile, and count what escaped so
// the compile still refuses at the end. The escape with no mark armed dies,
// which is what every fault outside a recovering loop has always done.
frost_rt_recover_run :: extern fn(body: fn(^u8), context: ^u8) -> i64
frost_rt_recover_escape :: safe extern fn()
// A fault a walk carries on past: counted and its line ended, with no escape.
// What a check whose state does not cross the thing it checks uses, so one run
// names every call it found wrong rather than the first.
frost_rt_recover_note :: safe extern fn()
frost_rt_recover_failures :: safe extern fn() -> i64
frost_rt_remove_file :: extern fn(path: ^i8) -> i64
frost_rt_file_exists :: extern fn(path: ^i8) -> i64
frost_rt_absolute_path :: extern fn(path: ^i8) -> ^i8

// What a node is. The kinds are an enum rather than a run of integer
// constants, so a node's kind carries its own type: `NodeKind::SliceLen`
// names itself, a kind cannot be confused with a token kind or a type code,
// and a `match` over one has to cover the cases it says it covers. The
// struct below is `Node`, so the enum beside it is `NodeKind`.
//
// `ref x := place` is a borrow of a place, an address that types as a borrow
// rather than a raw pointer, so reading through it needs no `unsafe` block.
// `slice_from($T, ptr, len)` is a `[]T` view over a run of T at a raw
// address. The claim that the bytes are that is unchecked, so the call is
// gated. Reads through the slice it returns are bounds-checked and are not.
NodeKind :: enum {
    Num, Var, Bin, Let, Assign, If, While, Return, Call, Func, Param,
    Arg, StructLit, Field, FieldInit, Deref, Index, AddrOf, PtrCast, Cast,
    Sizeof,
    ExprStmt, Match, Case, Extern, StrLit, TypeVal, With, Float, ArrayLit,
    SliceLen, Assert, Ref, SliceFrom,
    // Leaving a loop, and going round it again. Both are statements with
    // nothing under them: which loop they mean is the innermost one, decided
    // where they are emitted.
    Break, Continue,
    // A call through a value rather than through a name: `ops.less(a, b)`,
    // where the callee is any expression of function-pointer type. `a` is that
    // expression and `b` is the argument list.
    CallPtr,
}

// Type codes. A type is one i64. The primitives are small constants. A struct is
// STRUCT_BASE plus its table index. A pointer to a type T (also how a borrow
// parameter is modelled, since a borrow is a C pointer) is POINTER_BASE plus T, so
// pointer nesting composes by repeated addition.
TY_I64 :: 0
TY_I8 :: 1
TY_BOOL :: 2
TY_U8 :: 3
TY_VOID :: 4
TY_PARAM :: 5
TY_I16 :: 6
TY_I32 :: 7
TY_U16 :: 8
TY_U32 :: 9
TY_U64 :: 10
TY_ISIZE :: 11
TY_USIZE :: 12
TY_F32 :: 13
TY_F64 :: 14
// `Handle<T>`: a copyable i64 that packs a slot index and a generation. It is a
// scalar at the ABI, the same width as an i64 and converting freely to one. The
// element type it names comes from the slab it indexes, not from the code here.
// Its own code is what tells `slab[handle]` apart from an ordinary index.
TY_HANDLE :: 15
STRUCT_BASE :: 16
// A fixed array and a slice are both an entry in one table, since a slice is an
// array that did not say how long it is. That keeps `[]T` and `[N]T` one kind of
// thing everywhere but their layout.
ARRAY_BASE :: 500000
// `^T` and borrows of `T` where `T` is distinct, which are the one shape that
// cannot be reached by adding a base to the type pointed at. See `Indirect`.
// The range sits under POINTER_BASE so `is_pointer` answers for it by reading
// the code, the way it does for every other pointer.
INDIRECT_BASE :: 900000
POINTER_BASE :: 1000000
// A borrow (a `mut`/read parameter, a `ref` binding) is a C pointer like a raw
// one, and emits identically, but the two are different to the unsafety gate. A
// borrow was proven safe where it was formed, a raw pointer was not. The flag
// sits far above pointer nesting so `is_pointer` still answers yes for a borrow
// and only the gate and `pointee` tell them apart.
BORROW_FLAG :: 1000000000
// A compile-time integer argument to a generic, a value generic like the `N` in
// `Slab<T, N>`. It rides in the same i64 space as a type code so the whole
// monomorphization machinery stays keyed on one integer per argument. A code at
// or above this base is the value `code - CONST_BASE`. The base sits far above
// every real type code, and a value argument never reaches layout or the
// pointer tests. It is resolved to an array length or an integer literal while
// the generic body is re-parsed with the argument bound.
CONST_BASE :: 2000000000
// A function pointer, a value that is the address of a function with a given
// signature. It is a pointer at the ABI but not a data pointer. It is neither
// dereferenced nor pointer-arithmeticked, it is called. A code at or above this
// base names an entry in the `procs` table, its signature. This sits above the
// value-generic range so `is_pointer` and `is_borrow`, which now stop below
// CONST_BASE, answer no for it, since a function pointer emits its own C
// declarator rather than a trailing `*`.
PROC_BASE :: 3000000000
// A function chosen at the call site, the argument a `$f: fn(i64) -> i64`
// parameter is given. It rides in the same i64 space as a type code because a
// compile-time function argument is monomorphized on exactly like a type: a
// code at or above this base names entry `code - FN_BASE` of the `fns` table.
// It is not a type and never reaches layout. What it does reach is name
// resolution, where the body's `f(x)` finds the function that was passed.
FN_BASE :: 4000000000
// A `distinct` type: `Meters :: distinct i64` is laid out, computed and passed
// to C as an i64, and is not one. The code carries both halves of that. The
// number above the base divides into the type it is represented by and an index
// that is its identity, so `Meters` and `Feet` over the same i64 are different
// codes. Carrying the representation in the code rather than in a table is what
// lets `is_float`, `scalar_size` and the rest resolve a distinct type without
// the parser, and they all take a bare type code.
DISTINCT_BASE :: 5000000000
DISTINCT_STRIDE :: 4096

// Binary operator codes.
OP_ADD :: 0
OP_SUB :: 1
OP_MUL :: 2
OP_DIV :: 3
OP_MOD :: 4
OP_LT :: 5
OP_GT :: 6
OP_LE :: 7
OP_GE :: 8
OP_EQ :: 9
OP_NE :: 10
OP_AND :: 11
OP_OR :: 12
OP_SHL :: 13
OP_SHR :: 14
OP_BITAND :: 15
OP_BITOR :: 16
// Arithmetic that keeps the low bits of its type and drops the rest. Ordinary
// arithmetic refuses a result that does not fit; a hash is the case where
// leaving the range is the point, and it says so at the site.
OP_WRAP_ADD :: 17
OP_WRAP_SUB :: 18
OP_WRAP_MUL :: 19

// Whether an operator answers with a truth value rather than with a number.
// The codes are not laid out so that one comparison separates the two groups:
// the shifts and the bitwise operators were added after the comparisons and sit
// above them, and they are arithmetic. Reading the boundary off the numbers is
// what made `a | b` on a distinct type answer with i64.
op_answers_truth :: fn(op: i64) -> bool {
    op >= OP_LT && op <= OP_OR
}

// Token kinds. The lexer turns the source into a flat arena of these
// before the parser runs, so the parser peeks a kind rather than raw
// bytes. An identifier run that spells a keyword is classified to its
// keyword kind while lexing.
//
// An enum rather than a run of integers, so a kind carries its own type
// and two of them cannot quietly share a number. Two did: `inline` and
// `<<` were both 73.
TokenKind :: enum {
    Eof,
    Int,
    Ident,
    Str,
    Float,
    KwFn,
    KwIf,
    KwElse,
    KwWhile,
    KwBreak,
    KwContinue,
    KwReturn,
    KwStruct,
    KwMatch,
    KwCase,
    KwExtern,
    KwMut,
    KwVar,
    KwMove,
    KwLinear,
    KwUses,
    KwWith,
    KwImport,
    KwExport,
    KwEnum,
    KwTest,
    KwUnsafe,
    KwDistinct,
    KwWhere,
    KwSafe,
    KwRef,
    KwInline,
    KwDefer,
    Lparen,
    Rparen,
    Lbrace,
    Rbrace,
    Lbracket,
    Rbracket,
    Comma,
    Dot,
    Dotdot,
    Dotdoteq,
    Colon,
    Coloncolon,
    Coloneq,
    Arrow,
    Caret,
    Amp,
    Assign,
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    Lt,
    Le,
    Gt,
    Ge,
    Eqeq,
    Ne,
    Andand,
    Oror,
    Dollar,
    Bang,
    Question,
    Shl,
    Shr,
    Pipe,
    Semi,
    KwFor,
    KwIn,
    Illegal,
}

// Character codes (the language has no character literals).
CH_TAB :: 9
CH_LF :: 10
CH_CR :: 13
CH_SPACE :: 32
CH_BANG :: 33
CH_QUESTION :: 63
CH_PERCENT :: 37
CH_AMP :: 38
CH_LPAREN :: 40
CH_RPAREN :: 41
CH_STAR :: 42
CH_PLUS :: 43
CH_COMMA :: 44
CH_MINUS :: 45
CH_SLASH :: 47
CH_0 :: 48
CH_9 :: 57
CH_SEMI :: 59
CH_LT :: 60
CH_EQ :: 61
CH_GT :: 62
CH_LBRACE :: 123
CH_PIPE :: 124
CH_RBRACE :: 125
CH_LOWER_A :: 97
CH_LOWER_Z :: 122
CH_DQUOTE :: 34
CH_DOLLAR :: 36
CH_DOT :: 46
CH_COLON :: 58
CH_UPPER_A :: 65
CH_UPPER_Z :: 90
CH_LBRACKET :: 91
CH_RBRACKET :: 93
CH_CARET :: 94
CH_UNDERSCORE :: 95
CH_LOWER_B :: 98
CH_LOWER_E :: 101
CH_LOWER_F :: 102
CH_LOWER_X :: 120
CH_UPPER_B :: 66
CH_UPPER_E :: 69
CH_UPPER_F :: 70
CH_UPPER_X :: 88
CH_BACKSLASH :: 92
CH_LOWER_N :: 110
CH_LOWER_T :: 116

// `pos` is where in the one buffer this node was written, which is what turns a
// diagnostic into a file, a line and a column. A node the compiler synthesizes
// takes the position of whatever was being read when it was made, which is the
// line the reader wrote even though the node is not.
// One named bit of a `flags` declaration: which type it belongs to, the name
// as a range of the source, and the number a C header wrote down.
FlagBit :: struct {
    ty: i64,
    name_off: i64,
    name_len: i64,
    value: i64,
}

Node :: struct {
    kind: NodeKind,
    a: i64,
    b: i64,
    c: i64,
    val: i64,
    next: i64,
    pos: i64,
}

// An interned function name: a byte range into the source, a flag marking it as
// an `extern` (so calls emit its real name rather than mf_<index>), and its
// return type so a call expression can be typed.
// `cap_start`/`cap_count` are the run of allocation capabilities a `uses`
// function draws, in the `caps` arena. A function that allocates from nothing
// has a count of zero.
Sym :: struct {
    off: i64,
    len: i64,
    is_extern: i64,
    // `safe extern fn`: audited, so a call needs no `unsafe` block.
    is_safe: i64,
    // `inline fn`: the C backend forces this one inline. The assembly backend
    // ignores it.
    is_inline: i64,
    ret_type: i64,
    params: i64,
    defined: i64,
    cap_start: i64,
    cap_count: i64,
}

// One allocation capability: its type, and the name its body reaches it by,
// which is the type's own name with the first letter lowercased. A function may
// draw several, and the name is what tells them apart at a call.
Cap :: struct {
    ty: i64,
    off: i64,
    len: i64,
}

// One capability available where a call is being emitted: the name it is
// reached by, and whether it is a parameter already holding a reference or a
// variable a `with` block named, whose address the call takes.
Provider :: struct {
    off: i64,
    len: i64,
    borrow: i64,
}

// A compile-time integer constant `name :: value`, inlined at each use.
ConstDef :: struct {
    name_off: i64,
    name_len: i64,
    value: i64,
}

// A lexed token. `off`/`len` are the byte range in the source (used to intern
// identifiers and to re-emit string literals). `value` holds the parsed integer
// for a TokenKind::Int.
Token :: struct {
    kind: TokenKind,
    off: i64,
    len: i64,
    value: i64,
}

// A struct declaration. `field_head` is the first field's index in the field
// arena (or -1). A generic template (is_generic = 1) leaves fields unparsed and
// records its type parameter name and the token index of its `{` so each
// instantiation can re-parse the fields with the parameter bound. A monomorphized
// instance (instance_id >= 0) is emitted as `<name>_<instance_id>` rather than by
// its source name.
StructDef :: struct {
    name_off: i64,
    name_len: i64,
    field_head: i64,
    is_generic: i64,
    tparam_off: i64,
    tparam_len: i64,
    field_token: i64,
    instance_id: i64,
    is_linear: i64,
    emitted: i64,
    xparam_start: i64,
    xparam_count: i64,
    // A generic template that is an enum rather than a struct, so an
    // instantiation re-parses its body as variants rather than as fields.
    is_enum: i64,
    // Whether this entry holds the declaration or only the name. Every type a
    // file declares is put in the table by name before any body is read, so a
    // field or a literal naming a type declared further down resolves to the
    // same thing as one naming a type declared above it. The body fills the
    // entry in when the declaration is reached.
    declared: i64,
}

// A monomorphized instance of a generic struct: which template, the concrete
// type argument, and the concrete struct's index in the struct table.
// `arg` is the first generic argument. A generic with more than one parameter
// keeps the rest as a run in the `gargs` arena, at xarg_start for xarg_count
// entries. A single-parameter generic, which is all the compiler's own source
// has, leaves xarg_count zero and reads exactly as it did before.
MonoRet :: struct {
    fn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    ret: i64,
}

// A generic function already re-parsed with one type argument bound: which
// template, which argument, the FUNC node it produced and the return type that
// parse worked out. Parsing a template is deterministic given those two, and
// every instantiation used to be parsed three times over, once to record its
// return type and once each for its prototype and its body.
MonoNode :: struct {
    gfn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    node: i64,
    ret: i64,
}

Instance :: struct {
    generic_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    struct_index: i64,
}

// A generic function template: its interned name index, its first type parameter
// name, the run of any further parameter names in the `gparams` arena, and the
// token index of its name, so it can be re-parsed and emitted once per concrete
// argument tuple with every parameter bound.
GenericFn :: struct {
    fn_index: i64,
    // The first token of the `where` bound, or -1. The bound is read again at
    // each call, with that call's arguments bound, rather than kept as a tree:
    // the vocabulary is fixed, so reading it is the same work as walking it.
    bound_token: i64,
    tparam_off: i64,
    tparam_len: i64,
    // Whether the first parameter takes a number, and whether the body calls
    // it, the same two questions `is_value` and `is_fn` ask of the rest.
    tparam_is_value: i64,
    tparam_is_fn: i64,
    // The compile-time list this generic takes, by the name it is reached
    // under, and how many ordinary parameters were written before it. A length
    // of zero is a generic that takes no list.
    pack_off: i64,
    pack_len: i64,
    pack_fixed: i64,
    xparam_start: i64,
    xparam_count: i64,
    token_start: i64,
}

// One generic parameter name beyond the first, held in the `gparams` arena.
GParam :: struct {
    name_off: i64,
    name_len: i64,
    // Whether this parameter takes a number rather than a type, which is what
    // `$N: usize` says and `$T: Type` does not.
    is_value: i64,
    // Whether the body calls this parameter, which is what says a function
    // rather than a type binds to it. The kind written after the colon does
    // not say: a comparison is declared `$less: fn(T, T) -> bool` in one
    // place and `$less: Type` in another. Being called is the difference that
    // matters, since only then does the body name something that has to be
    // there.
    is_fn: i64,
}

// One generic argument beyond the first, held in the `gargs` arena. The value is
// a type code, or a compile-time integer encoded as CONST_BASE plus the number.
// One argument of a generic call, or one element of a compile-time list. A list
// element is a value or a type: a value becomes a parameter of the
// specialization and is evaluated once at the call, a type becomes a name the
// body writes where a type belongs and nothing at run time. `is_type` is what
// tells the two apart, since both are held here as a type code.
GArg :: struct {
    value: i64,
    is_type: i64,
    // Where this element's type is read from again, as an index into
    // `pending_rets`, or -1 for an element whose type is already what it will
    // be. An element whose type is what a call to a generic answers with is one
    // of these: the answer is worked out after the call is parsed.
    pending: i64,
}

// One place a function hands on that belongs to a borrowed parameter: which
// function, which parameter, and the run of field names under it held in
// `summary_steps`.
//
// The count linearity keeps is per place, and a place lives in one function. A
// callee that consumes part of what it borrows leaves its caller believing that
// storage is still live, so calling it twice consumes twice. This is what a call
// site reads to know better.
Summary :: struct {
    fn_index: i64,
    param: i64,
    step_start: i64,
    step_count: i64,
}

// One field name on the way from a borrowed parameter to the place given away.
SummaryStep :: struct {
    name_off: i64,
    name_len: i64,
}

// The expression one entry of `parse_locals` was bound to, in step with it, and
// -1 for a name that binds none. A name's type is read where it is bound, and a
// type that is what a call to a generic answers with is not settled then, so a
// reader that comes after has to reach the expression rather than the type it
// had at the time.
BoundValue :: struct {
    node: i64,
}

// One list element whose type is the return type of a call to a generic. Which
// monomorphization the call names is worked out where the call is parsed, since
// only there are the names it writes in scope; what that monomorphization
// returns is read from this later, once every one of them is recorded.
PendingRet :: struct {
    fn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
}

// One node's derived type, memoized during emit. type_of otherwise re-derives a
// node's type from the symbol tables on every visit, and emit visits each node
// many times over. The cache is one slot per node index. A stored answer is the
// type plus one, so a zero slot reads as "not computed yet" without a type ever
// colliding with it, since a type of zero (i64) stores as one.
TypeCacheEntry :: struct {
    ty: i64,
}

// One binding in force while a generic body is re-parsed: a parameter name and
// what it stands for, a type code or a CONST_BASE-encoded value. Bindings form a
// stack in the `gbindings` arena so a nested instantiation shadows an outer one
// and is popped when its parse finishes.
GBinding :: struct {
    name_off: i64,
    name_len: i64,
    bound: i64,
}

// One field of a struct: its name (byte range), its type code, and the next
// field's index in the field arena. `variant` is -1 for an ordinary field and
// the variant's tag for one that came from an enum variant's payload. Two
// fields of different variants can never both be live, so they are laid at the
// same offset, and that number is what says which ones share.
StructField :: struct {
    name_off: i64,
    name_len: i64,
    ty: i64,
    next: i64,
    variant: i64,
}

// A `.Variant` or a `{ ... }` written as a call argument, whose type is the
// parameter's. The callee may not be parsed when the argument is, so the
// literal is left unresolved and patched once every signature is known. `lit`
// is the literal node, `callee` the function it is an argument to, and
// `argument` its position in that call.
// What a fixup patches. `Literal` is an argument that named no type;
// `MultiField` is one name of a list binding, whose field is called whatever
// the callee's return type list called it.
FixupKind :: enum { Literal, MultiField }

VariantFixup :: struct {
    lit: i64,
    callee: i64,
    argument: i64,
    kind: FixupKind,
}

// One source file. A name is an offset into the buffer every file's text was
// laid into, and a module's range is what says which file wrote it.
Module :: struct {
    path: ^i8,
    start: i64,
    finish: i64,
    // Where the last line and column question about this module was answered.
    // Positions are asked for in roughly source order, so the next answer
    // carries on from here. Counting newlines from the module start each time
    // would cost a file's worth of positions the file's length squared. A
    // negative offset means nothing has been asked yet.
    cursor_off: i64,
    cursor_line: i64,
    cursor_column: i64,
}

// One name standing for another while a body is read again. A compile-time
// `for` reads its body once per element of the list, and this is what binds the
// loop's name to the element that copy is for.
Alias :: struct {
    from_off: i64,
    from_len: i64,
    to_off: i64,
    to_len: i64,
}

// One `old as new` of an import. The file that wrote it reads `local` where
// the module it names declares `exported`, and no other file is affected. The
// two names are copied out of the import line, since the line is blanked before
// the parser sees it, and re-pointed into the source once the parser has a
// place to keep them.
Rename :: struct {
    importer: i64,
    imported: i64,
    local_off: i64,
    local_len: i64,
    exported_off: i64,
    exported_len: i64,
}

// One `import` line, as the two modules it connects. A file may name what it
// declares and what the modules it imports directly export, and nothing else,
// so this is what says which of the two a given file is.
ImportEdge :: struct {
    importer: i64,
    imported: i64,
}

// A name a module offers to whoever imports it, from an `export a, b` line. A
// top-level name not listed is the module's own. Another file naming it is
// naming something else, and two modules may each keep one of the same name.
Export :: struct {
    module: i64,
    off: i64,
    len: i64,
}

// One variant of an enum: which enum it belongs to, its name, and the tag that
// stands for it. An enum is laid out as a struct carrying the tag beside every
// variant's fields, each named for the variant it came from, so a variant is a
// tag value and a set of field names rather than a type of its own.
Variant :: struct {
    enum_ty: i64,
    name_off: i64,
    name_len: i64,
    tag: i64,
}

// A `test "name" { ... }` block, as the name it was given and the function its
// body became. The body is an ordinary function, so nothing downstream of the
// parser has to know a test from anything else.
TestCase :: struct {
    name_off: i64,
    name_len: i64,
    fn_index: i64,
}

// A directory an import may be found under, after the importing file's own.
SearchRoot :: struct {
    path: ^i8,
}

// One layer of a project, as the manifest named it and as the path that names
// it resolves to. The order they are declared in is the order they may reach:
// a file under one may import from its own or from any declared before it.
Layer :: struct {
    name: ^i8,
    path: ^i8,
}

// A fixed array or a slice. `length` is how many elements a `[N]T` holds, and
// -1 says this is a `[]T`, which carries its length at run time instead.
ArrayDef :: struct {
    element: i64,
    length: i64,
    emitted: i64,
}

// One `^T` or borrow of `T` where `T` is a distinct type. Every other type
// composes by addition, which works because each base sits above everything it
// can contain. A distinct type sits above all of them, since its code carries
// the representation it is laid out as, so adding a pointer's base to one lands
// back inside the distinct range and reads as a different distinct type
// entirely. `^Meters` read as a struct index far past the end of the table.
//
// These are the one shape that cannot compose, so they are given a range of
// their own and an entry here saying what each points at.
Indirect :: struct {
    target: i64,
    // Whether the indirection was proven safe where it was formed. A borrow and
    // a raw pointer emit alike and differ only to the unsafety gate, which is
    // the same difference `BORROW_FLAG` carries for every other type.
    borrow: i64,
}

// A function-pointer signature: the return type and a run of parameter type
// codes in the `proc_params` arena. Every distinct signature is one entry, so a
// function-pointer type is this table's index plus PROC_BASE.
ProcSig :: struct {
    ret: i64,
    param_start: i64,
    param_count: i64,
}

// A concrete type a generic was used with. Every generic function is emitted
// once per distinct one of these.
TypeArg :: struct {
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    // Zero for the type arguments written at a call. For what a compile-time
    // list was given, the generic that took it, plus one. A list's tuple is a
    // run of ordinary types with nothing to say which parameters they bind, so
    // it belongs to the one generic whose call made it and to no other.
    is_pack: i64,
    // The generic this tuple was written for, or -1 when nothing says. A call
    // names its callee, so the tuple a call makes belongs to that generic and
    // to no other. A generic struct's instance names no function and carries
    // -1, which every generic accepts, since a function generic over the same
    // type takes its instance from there.
    owner: i64,
}

// A local's type binding during code generation. The table is rebuilt per
// function and maps a local's name (byte range) to its type code, so a field
// access or a `:=` can be typed by walking it.
// Which parameters a function's answer can name the storage of, one bit per
// parameter, indexed by function. A mask of -1 is every parameter, which is
// what a body shape the walk cannot read answers with.
AnswerMask :: struct { mask: i64 }

// One name a function binds, as the assembly backend's scan reads it before
// anything is emitted. `reads` counts the places the body asks for the name's
// value and nothing more; `pinned` says something reaches the name's storage by
// a route a register cannot follow, so the name is loaded from its slot every
// time and stored to its slot every time.
AsmName :: struct {
    name_off: i64,
    name_len: i64,
    reads: i64,
    pinned: i64,
    // How many places assign to it, the binding included, and how many times it
    // is bound at all. A name bound twice is two locals sharing one spelling,
    // and telling them apart here would mean telling scopes apart, so it is
    // pinned instead.
    writes: i64,
    binds: i64,
    // The type it was bound with, since what may live in a register is decided
    // by width and by kind.
    ty: i64,
    // The same accesses counted again with the ones inside a loop worth more,
    // since what a register saves is what runs rather than what is written.
    // This orders the candidates; `reads` and `writes` say whether any of them
    // is worth a register at all.
    weight: i64,
    // Which callee-saved register holds it for the whole function: 0 for none,
    // otherwise an index into the five the backend is free to use.
    reg: i64,
}

LocalVar :: struct {
    name_off: i64,
    name_len: i64,
    ty: i64,
    // Where this local sits in the frame, decided once when it is recorded
    // rather than by adding up every local's size at each mention of it. The
    // native backend is what reads it. Every other table of these leaves it
    // zero.
    slot: i64,
}

// The source span of one `unsafe { ... }`. The gate is a question about where a
// node was written, and a name here is already an offset into one buffer, so a
// span answers it without giving every node a flag of its own.
UnsafeSpan :: struct {
    start: i64,
    end: i64,
    // Whether anything inside it needed one. Only `--audit-unsafe` fills this
    // in, so an ordinary build never looks.
    used: i64,
}

// A growable, index-addressed arena over a single heap allocation. This is the
// data-oriented allocator, generic over its element.
// arena_push appends and returns the element's index, arena_at turns an index
// back into a pointer. The compiler is asked only for the raw memory and the
// pointer reinterpret. The bump logic is here.
Arena :: struct($T: Type) {
    data: ^T,
    cap: i64,
    count: i64,
}

arena_make :: fn($T: Type, cap: i64) -> Arena<T> {
    // `frost_rt_alloc` is a `safe extern`: it hands back memory or does not
    // return, so it cannot corrupt any. Reading those bytes as a `T` is the
    // unchecked part, and that is all the block below vouches for.
    //
    // The size is answered for rather than multiplied out. A count times a width
    // that wraps asks for fewer bytes than the arena believes it has, and the
    // arena's own bounds check then runs against the count it was told.
    bytes := frost_rt_alloc(frost_rt_check_size(cap, sizeof(T)))
    Arena { data = unsafe { ptr_cast($T, bytes) }, cap = cap, count = 0 }
}

arena_push :: fn(mut a: Arena<$T>, move value: $T) -> i64 {
    // An arena is a single fixed allocation, so running past it writes over
    // whatever the allocator put next and the damage surfaces somewhere else
    // entirely. Say so here instead.
    if (a.count >= a.cap) {
        // The capacity says which arena this is, since they are made at one
        // place with the sizes written there and nothing else distinguishes
        // one from another here.
        report("frost: an arena of ")
        frost_rt_error_int(a.cap)
        report(" ran out of room")
        frost_rt_die()
    }
    id := a.count
    // The bounds are checked above, so this index is in range. What the block
    // vouches for is that and nothing else.
    unsafe { a.data[id] = value }
    a.count = a.count + 1
    id
}

// An index outside the arena reads whatever happens to sit there, which lands
// inside the heap on one host and outside the mapping on another, so the same
// mistake is silent corruption in one place and a crash with no explanation in
// the other. Answer for it here instead.
arena_at :: fn(a: Arena<$T>, id: i64) -> ref T {
    if (id < 0 || id >= a.count) {
        report("frost: an arena was indexed out of range: ")
        frost_rt_error_int(id)
        frost_rt_die()
    }
    // Checked against the count above, so the index is in range.
    unsafe {
        ref result := a.data[id]
        result
    }
}

// A directory added to the search list. arena_push answers with an index
// this has no use for, and a branch ending in a value is a branch that
// produced one, so it is dropped here rather than at every call.
// A run of bytes with room for `size` of them. This is the one place the
// compiler asks for memory, and what it hands back carries its own length, so
// every read and write into the source buffer above is a checked index.
buffer_of :: fn(size: i64) -> str {
    unsafe { slice_from($u8, frost_rt_alloc(size), size) }
}

// A C string as a slice of the bytes it holds, for text the environment handed
// over: a file's contents, an argument. Measuring it is the last thing done
// through a bare pointer. Everything after reads it as a slice.
cstr_slice :: fn(text: ^i8) -> str {
    unsafe { slice_from($u8, ptr_cast($u8, text), cstr_len(text)) }
}

// The empty buffer, for a driver that has not read anything yet.
empty_source :: fn() -> str {
    buffer_of(1)
}

// Where the text in a buffer stops, which is the terminator written after it.
// The buffer is longer than its text: the room past the terminator is where the
// names the compiler makes up go.
source_end :: fn(text: str) -> i64 {
    var at: i64 = 0
    while (at < str_len(text) && text[at] != 0) {
        at = at + 1
    }
    at
}

// The compiler's own byte access, audited here so nothing above this names the
// three unchecked operations it is built on.
//
// The buffer these read is one the compiler made: the source of every module
// laid end to end, followed by room for the names it synthesizes. Every offset
// into it comes from the lexer, which produced it by walking the same buffer,
// so an offset that is not inside it would be a bug in the compiler rather
// than anything a program can cause.
//
// What is missing is the bound. These take a pointer with no length beside it,
// so the read is unchecked and this is a perimeter rather than a proof. Making
// it a proof means carrying the buffer as a slice, which is the length threaded
// through every function that takes a `^i8` here.
byte_at :: fn(src: ^i8, index: i64) -> i64 {
    unsafe { frost_rt_byte_at(src, index) }
}

byte_set :: fn(buffer: ^i8, index: i64, value: i64) {
    unsafe { frost_rt_byte_set(buffer, index, value) }
}

// The length of a C string: what the environment hands the compiler, where the
// terminator is the only thing that says how long it is.
cstr_len :: fn(s: ^i8) -> i64 {
    unsafe { frost_rt_str_len(s) }
}

add_root :: fn(mut roots: Arena<SearchRoot>, directory: ^i8) {
    arena_push(roots, SearchRoot { path = directory })
}

add_layer :: fn(mut layers: Arena<Layer>, name: ^i8, directory: ^i8) {
    arena_push(layers, Layer { name = name, path = directory })
}

// Whether a path sits under a directory, comparing whole path components so
// `lib/rendererx` is not read as being under `lib/renderer`.
path_under :: fn(path: ^i8, directory: ^i8) -> bool {
    length := cstr_len(directory)
    if (length == 0 || cstr_len(path) < length) {
        return false
    }
    var k: i64 = 0
    while (k < length) {
        if (byte_at(path, k) != byte_at(directory, k)) {
            return false
        }
        k = k + 1
    }
    if (cstr_len(path) == length) {
        return true
    }
    byte_at(path, length) == CH_SLASH
}

// Which layer a file is in, or -1 where it is in none. The deepest declared
// layer containing it wins, so a layer declared inside another is the answer
// for the files under it.
layer_of :: fn(path: ^i8, mut layers: Arena<Layer>) -> i64 {
    var best: i64 = -1
    var deepest: i64 = -1
    var i: i64 = 0
    while (i < layers.count) {
        held := arena_at(layers, i)
        if (path_under(path, held.path)) {
            length := cstr_len(held.path)
            if (length > deepest) {
                deepest = length
                best = i
            }
        }
        i = i + 1
    }
    best
}

Parser :: struct {
    src: str,
    tokens: Arena<Token>,
    ti: i64,
    arena: Arena<Node>,
    fns: Arena<Sym>,
    structs: Arena<StructDef>,
    fields: Arena<StructField>,
    locals: Arena<LocalVar>,
    consts: Arena<ConstDef>,
    // A constant whose value is a struct rather than an integer. `value` is the
    // node the literal parsed to, written out again at each use.
    value_consts: Arena<ConstDef>,
    instances: Arena<Instance>,
    generic_fns: Arena<GenericFn>,
    // Every allocation capability every `uses` function draws, as runs one per
    // function, and the ones in scope where a call is being emitted.
    caps: Arena<Cap>,
    providers: Arena<Provider>,
    // The names in force while a compile-time `for` reads its body again.
    aliases: Arena<Alias>,
    // How much of the frame the locals recorded so far take, which is what
    // gives the next one its slot.
    frame_used: i64,
    // Where a half-finished value waits while the other half of an expression
    // is worked out. One slot per depth of nesting, taken from the frame the
    // function already reserves and reused by every expression that reaches
    // that depth, so a deeply nested expression costs slots and a wide one
    // costs none. `slot` is the offset; the rest of the record is unused.
    spill_slots: Arena<LocalVar>,
    // What the assembly backend's scan found about the function being emitted:
    // one entry per name it binds, rebuilt per function.
    asm_names: Arena<AsmName>,
    // How many places the function being emitted leaves from, so what a
    // register costs to save and put back can be weighed against what holding
    // a name in it saves.
    asm_returns: i64,
    // How many loops the scan is inside, so an access can be weighed by how
    // often it is likely to run rather than by how often it is written.
    asm_loop_depth: i64,
    // Where the five callee-saved registers are kept while this function has
    // them, as one run of eight-byte slots. -1 when the function took none.
    asm_save_base: i64,
    // How many of them it took, so the prologue and every exit move the same
    // ones.
    asm_saved: i64,
    // How many of them are in use where emission has reached.
    spill_depth: i64,
    // Which module is being emitted, or -1 for the whole program in one unit.
    // A build that compiles each module to its own object emits one unit per
    // module, and a specialization goes in every unit that could call it, as a
    // symbol local to that unit so the copies do not collide at the link.
    emit_module: i64,
    // The fields in force: a `for` over `fields(T)` binds its name to one of
    // them per copy of the body. `ty` is what the field holds and `slot` is
    // where it sits, which is every question that may be asked of one.
    field_bindings: Arena<LocalVar>,
    // What each name binds while the declaration around it is being parsed.
    // Only what a compile-time list is given is read from here, and only at the
    // call that gives it, since that is the one question whose answer has to be
    // settled before anything else runs. Everything else types a name from the
    // table the emitters build, which is what it has always done.
    parse_locals: Arena<LocalVar>,
    parse_local_values: Arena<BoundValue>,
    // The run of that table holding the parameters of the declaration being
    // parsed. An expansion-time `if` asks about a parameter and nothing else,
    // which is what keeps a body's own `is_float(x)` over a local its own call.
    parse_param_start: i64,
    parse_param_end: i64,
    // The compile-time list this instantiation bound: the parameter's name, and
    // the run of element types in `gargs`. A length of zero is a template being
    // read with nothing bound.
    pack_off: i64,
    pack_len: i64,
    pack_start: i64,
    pack_count: i64,
    gparams: Arena<GParam>,
    // Every `$f: fn(..)` parameter name in the program. A template's body is
    // parsed once before any call to it is seen, so `f(x)` in there names no
    // function yet and would read as a call to one that does not exist. This
    // says which names are a function the caller supplies, and each instance
    // resolves them to the function it was actually given.
    cfn_params: Arena<GParam>,
    gargs: Arena<GArg>,
    procs: Arena<ProcSig>,
    proc_params: Arena<GArg>,
    // A stack scratch for the arguments of the generic currently being parsed,
    // so a nested generic's arguments do not interleave with the outer one's in
    // `gargs`. Each level pushes its arguments here, copies them out, and pops.
    argbuf: Arena<GArg>,
    // The calls a compile-time list's elements take their types from, each
    // named by the tuple the call makes.
    pending_rets: Arena<PendingRet>,
    gbindings: Arena<GBinding>,
    type_param_off: i64,
    type_param_len: i64,
    // The parameters beyond the first that the current declaration collected into
    // `gparams`, so the generic it belongs to can record its whole list.
    xparam_start: i64,
    xparam_count: i64,
    // The argument tuple of the generic call last examined: the run of arguments
    // beyond the first, in the `gargs` arena, so a call to a multi-parameter
    // generic is monomorphized on its whole tuple.
    call_xarg_start: i64,
    call_xarg_count: i64,
    // The first compile-time argument of a call to a generic that also takes a
    // compile-time list. Without a list this is what `call_type_args` answers
    // with. With one the run holds both kinds and this is the primary.
    call_pack_primary: i64,
    // A `>` left over from splitting a `>>` token that closed a nested generic,
    // so the enclosing generic sees its own close where the lexer ran the two
    // together, as in `Vec<Vec<i64>>`.
    pending_gt: i64,
    type_binding: i64,
    binding_active: i64,
    // The declared type of the binding whose initializer is being parsed, so a
    // bare generic literal like `Slab { ... }` written for a `Slab<Entity, 8>`
    // resolves to that instance where no generic binding is in force to name it.
    expected_type: i64,
    // The type a `.Variant` takes its enum from, and the second place to look
    // when the first does not have the variant. The pair is what lets a
    // `return` in a fallible function name a variant of either the value it
    // answers with or the failure set it declares.
    expected_alt: i64,
    // The declared value type of the function being parsed, before a failure
    // set wraps it, so a `return` knows what it is expected to produce.
    ok_ty: i64,
    variant_fixups: Arena<VariantFixup>,
    saw_type_param: i64,
    // Whether the declaration being parsed calls its own first compile-time
    // parameter, so the generic it becomes records that a function binds there.
    tparam_called: i64,
    // The first token of the `where` bound the declaration being parsed
    // carries, or -1.
    bound_token: i64,
    // The compile-time list the declaration being parsed takes, by name, and
    // how many ordinary parameters came before it.
    decl_pack_off: i64,
    decl_pack_len: i64,
    decl_pack_fixed: i64,
    // Whether that first parameter was declared as taking a number.
    tparam_is_value: i64,
    last_return_type: i64,
    no_struct_lit: bool,
    last_type_was_generic: i64,
    // Where each `unsafe { ... }` was written, and how deep the parser is in
    // one, so the gate can ask where a node came from.
    unsafe_spans: Arena<UnsafeSpan>,
    unsafe_depth: i64,
    // The statements a `defer` put off, as the token index of each in
    // `name_off`. A copy is made by reading the tokens again at every exit
    // rather than by copying nodes, so nothing downstream learns a new form.
    // `defer_base` is where the function being parsed started, since a function
    // literal inside one has its own.
    defers: Arena<LocalVar>,
    defer_base: i64,
    defer_count: i64,
    // How many blocks deep the parser is, and the depth a `defer` is allowed at:
    // the top level of the body being read. A `defer` deeper than that is
    // refused, since what it means there is not what it looks like. It would run
    // where the function leaves rather than where the block does, and one
    // written in a loop would run once with whatever the loop left behind.
    block_depth: i64,
    defer_depth: i64,
    // Whether the parameter the type variable was written on holds it rather
    // than being it: `[]$T` and `[N]$T` name it through their element, so what
    // the argument binds is the element's type. Set by `tparam_position` beside
    // the position it answers with.
    tparam_through: i64,
    moved: Arena<LocalVar>,
    // For a binding that views a container's storage rather than its own, the
    // node of the place that container sits in. `slot` holds it.
    move_views: Arena<LocalVar>,
    // What each function does to the resources it is lent, and the field names
    // that say which place. Worked out to a fixpoint before anything is
    // reported, since what one function gives away depends on what the
    // functions it calls give away.
    summaries: Arena<Summary>,
    summary_steps: Arena<SummaryStep>,
    // What each function does with the runs its callers hold: which one its
    // answer views, and which one it replaces. A container that fills asks the
    // allocator for a wider block and gives the old one back, so a view taken
    // before the growth names storage that is no longer the container's, and
    // neither half of that is visible from the call. Both are field-granular:
    // growing one run while a caller holds a view of another is ordinary, and
    // the ECS does it on every frame.
    run_views: Arena<Summary>,
    run_replaces: Arena<Summary>,
    run_steps: Arena<SummaryStep>,
    // The function whose runs are being read, its parameter list, and whether
    // it answers with a view at all.
    runs_fn: i64,
    runs_params: i64,
    runs_answers_view: i64,
    // The runs the locals of the body being read view, by name, so a binding
    // taken from one call and handed to the answer carries what it names.
    run_locals: Arena<LocalVar>,
    // For the reporting walk: the run each binding views, as a place in this
    // frame, and the bindings whose run has been replaced since they were taken.
    // `slot` holds the place node either way.
    view_runs: Arena<LocalVar>,
    stale_views: Arena<LocalVar>,
    // Scratch for the branch walks: what an arm left stale, held while the
    // other arms are walked, then merged back so a view is stale after a branch
    // if any arm replaced the run behind it.
    stale_scratch: Arena<LocalVar>,
    // How many times a run under a live view has been replaced. A loop body is
    // walked twice only when this moved, since the second walk is what asks what
    // the top of the loop reads on the turn after.
    run_replacements: i64,
    // Whether the field chain being pushed is still taking names. It stops at
    // the first step that is not a field, since the run holding an element is
    // what both sides of a call can name and the element itself is not.
    run_chain_open: i64,
    // Where the chain being pushed started, so its depth can be read off.
    run_chain_start: i64,
    // Whether the move walk is working the summaries out rather than reporting.
    // The same walk does both, and a complaint made while the answers are still
    // settling is one made against a state that is not final.
    moves_quiet: i64,
    // Whether the function being walked answers with a resource, which is what
    // says a place it hands back is one. The walk runs before the locals are
    // recorded, so the declaration is what can be read rather than the place.
    moves_answers: i64,
    // The parameter list of the function being walked, so a place rooted in one
    // can be typed from the declaration.
    moves_params: i64,
    label_id: i64,
    abi_windows: i64,
    // Whether the argument list just read held a `for` over a compile-time list
    // that was not bound, which is what a template's own parse sees. That parse
    // is thrown away and done again per instance, so the tuple it would name is
    // not one any call asks for.
    args_unbound_map: i64,
    // The labels of the loop being emitted, for `break` and `continue`. -1
    // outside a loop, which is what says the two have nothing to jump to.
    loop_top: i64,
    loop_end: i64,
    // Which frame symbol the function being emitted uses. A function's frame
    // size is written down after its body, so the two have to agree on a name.
    frame_id: i64,
    asm_ret: i64,
    sret_slot: i64,
    mono_rets: Arena<MonoRet>,
    mono_nodes: Arena<MonoNode>,
    current_ret: i64,
    current_fn_off: i64,
    current_fn_len: i64,
    tainted: Arena<LocalVar>,
    inner: Arena<LocalVar>,
    region_off: i64,
    region_len: i64,
    region_returns: i64,
    // The frame-escape check's sets. A name's storage and a name's value are
    // different questions, so they are different tables: `frame_storage` holds
    // the names this frame owns and `frame_outlives` the names it did not
    // create. A `move` parameter is in both, since its storage is this call's
    // copy while its value is whatever the caller handed over.
    frame_storage: Arena<LocalVar>,
    frame_outlives: Arena<LocalVar>,
    // What each local's value names, as a provenance in `slot`.
    frame_locals: Arena<LocalVar>,
    // Which parameters each function's answer can name the storage of, and the
    // masks the locals of the body being walked carry.
    answer_masks: Arena<AnswerMask>,
    // One mask per parameter of every function: which other parameters
    // that one is written into, so a pointer handed to a call is judged
    // against what will still be holding it.
    kept_masks: Arena<AnswerMask>,
    answer_locals: Arena<LocalVar>,
    // For a local that borrows rather than owning storage, where the place it
    // names lives. `ref x := place` binds one, and so does a binding taken from
    // a call answering with a `ref`.
    frame_places: Arena<LocalVar>,
    // The declared or inferred type of each parameter and local, in `ty`. The
    // frame check runs before the type pass, so it carries its own.
    frame_types: Arena<LocalVar>,
    // The same idea for a region: bindings holding the address of one already
    // tainted, so reading back through one hands the arena pointer out again.
    region_via_pointer: Arena<LocalVar>,
    // What the function being checked answers with, and the three separate
    // questions asked of it: whether it holds a view at all, whether it is a
    // `ref` and so denotes a place, and whether it is a view itself rather than
    // a value holding one.
    frame_ret: i64,
    frame_answers_view: i64,
    frame_answers_place: i64,
    // Which scratch slot the next checked operation reads its left operand
    // into, counted per function.
    arith_site: i64,
    // The parameter nodes declared `mut`, by node index, so the exclusivity
    // check can tell an exclusive borrow from a shared one where the type alone
    // cannot. A `mut` and a read of an aggregate both pass by address.
    mut_params: Arena<LocalVar>,
    // The parameter nodes declared `value` on an `extern`, by node index. The
    // parameter behaves as a borrow everywhere else, so only the call's
    // argument placement consults this, which is the one thing that differs.
    value_params: Arena<LocalVar>,
    // Scratch for the move check: the values a branch moved, held while the
    // other branch is walked, then merged back so what is moved after an `if` is
    // whatever either arm moved.
    move_scratch: Arena<LocalVar>,
    modules: Arena<Module>,
    exports: Arena<Export>,
    import_edges: Arena<ImportEdge>,
    renames: Arena<Rename>,
    // Whether two modules in this program export the same name. Nothing is
    // wrong with that on its own, so it only turns on the careful lookup that
    // answers for a file importing both.
    shared_exports: i64,
    export_names: str,
    result_ty: i64,
    failure_ty: i64,
    // `-> (i64, i64)`: the struct standing for the return type list of the
    // function being parsed, and how many values it holds. -1 when the function
    // returns one value, which is what a `return` with a comma is measured
    // against.
    multi_ty: i64,
    multi_count: i64,
    variants: Arena<Variant>,
    match_count: i64,
    // Which entry of `variants` the case just parsed named, so a match can tell
    // whether it covered every variant of the enum it switched on. -1 when the
    // variant did not resolve, which is an uninstantiated generic template.
    case_variant: i64,
    type_args: Arena<TypeArg>,
    pending: Arena<LocalVar>,
    try_count: i64,
    name_tag: i64,
    name_value: i64,
    name_error: i64,
    // A failure result is an enum with `Ok { value }` and `Err { error }`,
    // laid out the way every other enum is: a tag beside fields named for the
    // variant they came from.
    name_ok: i64,
    name_err: i64,
    name_ok_value: i64,
    name_err_error: i64,
    synth_next: i64,
    prov_kind: i64,
    prov_off: i64,
    prov_len: i64,
    // `Meters :: distinct i64` and `InitFlags :: flags u32 { ... }`, both of
    // which put a name in this table standing for a code of its own rather than
    // for the representation, which is what makes a Feet not a Meters.
    type_aliases: Arena<ConstDef>,
    // The named bits of every flags type, each carrying which type it belongs
    // to. A flags type is otherwise an ordinary distinct type, so this table is
    // the whole of what tells one apart.
    flag_bits: Arena<FlagBit>,
    arrays: Arena<ArrayDef>,
    indirects: Arena<Indirect>,
    tests: Arena<TestCase>,
    testing: i64,
    // Whether to report an `unsafe` block that vouches for nothing. Off unless
    // asked for, so an ordinary build never walks the spans.
    audit_unsafe: i64,
    // Whether a line table is written beside the code. Off unless asked for,
    // since the paths in it are absolute and a build that carries them is not
    // the same bytes on another machine.
    debug_lines: i64,
    // Whether the assembly backend writes what its scan found about each name
    // into the emitted text as comments. FROST_ASM_NAMES asks for it, and
    // nothing but reading the sets against a function wants it.
    asm_debug_names: i64,
    // A memo of each node's derived type, read by type_of. It is filled only
    // while emitting, where a node's type is fixed and asked for repeatedly.
    // type_cache_on gates it so the checks, which ask under generic bindings
    // that change the answer, never write to it.
    type_cache: Arena<TypeCacheEntry>,
    type_cache_on: i64,
}

cstr_eq :: fn(a: ^i8, b: ^i8) -> bool {
    la := cstr_len(a)
    lb := cstr_len(b)
    if (la != lb) {
        return false
    }
    var i: i64 = 0
    while (i < la) {
        if (byte_at(a, i) != byte_at(b, i)) {
            return false
        }
        i = i + 1
    }
    true
}
