// Import resolution puts every file's text into one buffer, dependencies first.

import "core.frost"
import "json.frost"
import "lexer.frost"

export SOURCE_ROOM, SYNTH_ROOM, copy_name,
    directory_part, emit_position,
    file_name,
    joined_path, join_path, module_at, report_where, report_note_where,
    report_fix,
    line_of, column_of, file_of,
    resolve_imports, search_roots_from, manifest_roots, manifest_generators,
    source_with_room,
    manifest_above

module_seen :: fn(mut modules: Arena<Module>, path: ^i8) -> bool {
    mut i: i64 = 0
    while (i < modules.count) {
        entry := arena_at(modules, i)
        if (cstr_eq(entry.path, path)) {
            return true
        }
        i = i + 1
    }
    false
}

// A path named by an import, resolved against the directory of the file that
// named it.
join_path :: fn(parent: ^i8, src: str, off: i64, len: i64) -> ^i8 {
    parent_len := cstr_len(parent)
    mut cut: i64 = 0
    mut k: i64 = 0
    while (k < parent_len) {
        c := byte_at(parent, k)
        if (c == CH_SLASH || c == CH_BACKSLASH) {
            cut = k + 1
        }
        k = k + 1
    }
    out := unsafe { ptr_cast($i8, frost_rt_alloc(cut + len + 1)) }
    k = 0
    while (k < cut) {
        byte_set(out, k, byte_at(parent, k))
        k = k + 1
    }
    k = 0
    while (k < len) {
        byte_set(out, cut + k, src[off + k])
        k = k + 1
    }
    byte_set(out, cut + len, 0)
    out
}

// A path under a directory, with a separator between them when the directory
// needs one.
join_under :: fn(directory: ^i8, src: str, off: i64, len: i64) -> ^i8 {
    directory_len := cstr_len(directory)
    mut separator: i64 = 0
    if (directory_len > 0) {
        last := byte_at(directory, directory_len - 1)
        if (last != CH_SLASH && last != CH_BACKSLASH) {
            separator = 1
        }
    }
    out := unsafe { ptr_cast($i8, frost_rt_alloc(directory_len + separator + len + 1)) }
    mut k: i64 = 0
    while (k < directory_len) {
        byte_set(out, k, byte_at(directory, k))
        k = k + 1
    }
    if (separator == 1) {
        byte_set(out, directory_len, CH_SLASH)
    }
    k = 0
    while (k < len) {
        byte_set(out, directory_len + separator + k, src[off + k])
        k = k + 1
    }
    byte_set(out, directory_len + separator + len, 0)
    out
}

// A path with its `.` and `..` steps taken, and one separator throughout.
//
// Whether two imports name the same file is asked by comparing their paths, so
// two spellings of one file have to come out the same or it is placed twice and
// every name in it collides with itself. `lib/engine/../renderer/mesh.frost`
// and `examples/graphics/../../lib/renderer/mesh.frost` are one file, and a
// program that reaches a module from two directories reaches it from two
// directories.
//
// Lexical rather than a walk of the filesystem: what a `..` after a real
// directory means is that directory's parent, which is what this takes, and no
// question is asked of the disk. A leading `..` that nothing precedes is kept,
// since there is nothing above it to cancel.
normalise_path :: fn(path: ^i8) -> ^i8 {
    length := cstr_len(path)
    out := unsafe { ptr_cast($i8, frost_rt_alloc(length + 2)) }
    mut at: i64 = 0
    // A path that begins at the root stays at the root. Every separator after
    // this is written by the segments themselves, and the first of them writes
    // none, so without this `/tmp/x` comes back as `tmp/x` and names a
    // different file.
    if (length > 0) {
        first := byte_at(path, 0)
        if (first == CH_SLASH || first == CH_BACKSLASH) {
            byte_set(out, 0, CH_SLASH)
            at = 1
        }
    }
    // Where the segments start, so the undo below knows the root is not one of
    // them and stops there.
    root_at := at
    // Where each segment written so far starts, so a `..` knows what to undo.
    mut starts: [MAX_PATH_STEPS]i64 = [0; MAX_PATH_STEPS]
    mut depth: i64 = 0
    mut read: i64 = 0
    while (read < length) {
        c := byte_at(path, read)
        if (c == CH_SLASH || c == CH_BACKSLASH) {
            read = read + 1
            continue
        }
        // One segment, up to the next separator.
        mut stop := read
        while (stop < length) {
            held := byte_at(path, stop)
            if (held == CH_SLASH || held == CH_BACKSLASH) {
                break
            }
            stop = stop + 1
        }
        span := stop - read
        if (span == 1 && byte_at(path, read) == CH_DOT) {
            read = stop
            continue
        }
        if (span == 2 && byte_at(path, read) == CH_DOT
            && byte_at(path, read + 1) == CH_DOT && depth > 0
            && is_parent_step(out, starts[depth - 1], at) == false) {
            depth = depth - 1
            // Back to where the segment started, and back over the separator
            // in front of it, or the next one written puts a second there.
            at = starts[depth]
            if (at > root_at) {
                at = at - 1
            }
            read = stop
            continue
        }
        if (at > root_at) {
            byte_set(out, at, CH_SLASH)
            at = at + 1
        }
        if (depth < MAX_PATH_STEPS) {
            starts[depth] = at
            depth = depth + 1
        }
        mut k: i64 = 0
        while (k < span) {
            byte_set(out, at + k, byte_at(path, read + k))
            k = k + 1
        }
        at = at + span
        read = stop
    }
    byte_set(out, at, 0)
    out
}

// How many steps of a path this keeps track of, which is what bounds how deep
// a `..` can reach back.
MAX_PATH_STEPS :: 64

// Whether the segment written at `start` is itself a `..`, which nothing above
// it can cancel: `../../a` keeps both.
is_parent_step :: fn(out: ^i8, start: i64, at: i64) -> bool {
    (at - start == 2 && byte_at(out, start) == CH_DOT
        && byte_at(out, start + 1) == CH_DOT)
}

// An import is found beside the file that named it first, then under
// each directory the command line or the environment offered, then under the
// standard library. Beside-first is what lets a project's own files name each
// other without a search path, and the rest is what lets `std/strings.frost`
// be named from anywhere.
//
// A path that matches nothing is answered with the beside-it form, so the error
// names where the reader would have looked.
find_import :: fn(
    parent: ^i8,
    src: str,
    off: i64,
    len: i64,
    mut roots: Arena<SearchRoot>,
    mut layers: Arena<Layer>
) -> ^i8 {
    found := locate_import(parent, src, off, len, roots)
    // A path that matched nothing comes back as the beside-it form, which names
    // no file. What is wrong with that import is that it names nothing, and the
    // read below says so; weighing its layer first would answer a different
    // question about a file that is not there.
    if (unsafe { frost_rt_file_exists(found) } == 1) {
        refuse_upward(parent, found, layers)
    }
    found
}

locate_import :: fn(
    parent: ^i8,
    src: str,
    off: i64,
    len: i64,
    mut roots: Arena<SearchRoot>
) -> ^i8 {
    beside := normalise_path(join_path(parent, src, off, len))
    if (unsafe { frost_rt_file_exists(beside) } == 1) {
        return beside
    }
    mut i: i64 = 0
    while (i < roots.count) {
        entry := arena_at(roots, i)
        candidate := normalise_path(join_under(entry.path, src, off, len))
        if (unsafe { frost_rt_file_exists(candidate) } == 1) {
            return candidate
        }
        i = i + 1
    }
    beside
}

// The bytes of a terminated string from `start` on, as one of its own.
cstr_from :: fn(s: ^i8, start: i64) -> ^i8 {
    length := cstr_len(s) - start
    out := unsafe { ptr_cast($i8, frost_rt_alloc(length + 1)) }
    mut k: i64 = 0
    while (k < length) {
        byte_set(out, k, byte_at(s, start + k))
        k = k + 1
    }
    byte_set(out, length, 0)
    out
}

// What a file is called in a report and in what a build writes out: where it
// sits under the directory the build was started in. The path beside it says
// where to read the file on this machine, and that changes with the machine, so
// a compiler built in one checkout and one built in another wrote two spellings
// of `std/mem.frost` into their own assembly and agreed on nothing else.
//
// A file outside that directory is called by its own name, which is what a
// build reading one file names it either way.
named_path :: fn(path: ^i8) -> ^i8 {
    here := absolute_path(".")
    full := absolute_path(path)
    prefix := cstr_len(here)
    if (prefix == 0 || cstr_len(full) <= prefix + 1) {
        return file_name(full)
    }
    mut k: i64 = 0
    while (k < prefix) {
        if (byte_at(full, k) != byte_at(here, k)) {
            return file_name(full)
        }
        k = k + 1
    }
    mut start := prefix
    if (byte_at(full, start) == CH_SLASH) {
        start = start + 1
    }
    cstr_from(full, start)
}

// What follows the last separator, which is a file's own name.
file_name :: fn(path: ^i8) -> ^i8 {
    length := cstr_len(path)
    mut cut: i64 = 0
    mut k: i64 = 0
    while (k < length) {
        if (byte_at(path, k) == CH_SLASH || byte_at(path, k) == CH_BACKSLASH) {
            cut = k + 1
        }
        k = k + 1
    }
    cstr_from(path, cut)
}

// A path with the working directory in front of it and one separator
// throughout, which is what makes two spellings of one file compare equal. A
// relative path and an absolute one name the same file and share no prefix, so
// whether one sits under another cannot be asked of them as written.
absolute_path :: fn(path: ^i8) -> ^i8 {
    normalise_path(unsafe { frost_rt_absolute_path(path) })
}

// A layer may reach its own and the ones declared before it. The paths compared
// are the ones resolution settled on, made absolute, so an import spelling its
// way up and back down, or reaching a layer through a search root written
// absolutely, names the same file and is weighed the same.
//
// A file under no declared layer is unconstrained, as importer and as target,
// which is what leaves the standard library and a program outside the project
// alone.
refuse_upward :: fn(parent: ^i8, found: ^i8, mut layers: Arena<Layer>) {
    from := layer_of(absolute_path(parent), layers)
    into := layer_of(absolute_path(found), layers)
    if (from < 0 || into < 0 || into <= from) {
        return
    }
    report_command("layer: '")
    report_cstr(arena_at(layers, from).name)
    report("' may not reach '")
    report_cstr(arena_at(layers, into).name)
    report("': a file in '")
    report_cstr(arena_at(layers, from).name)
    report("' imports '")
    report_cstr(layer_relative(found, arena_at(layers, into)))
    report("'")
    frost_rt_die()
}

// A file as a reader would write it: the layer's own name, then the rest of the
// path under it, so a diagnostic says the same thing wherever the build ran.
//
// A layer's path is absolute and the path asked about has to be, or the two
// share no prefix and there is no rest to take. A path that is under no layer
// after that is said whole, since what a report has to do is name the file.
layer_relative :: fn(raw: ^i8, held: Layer) -> ^i8 {
    path := absolute_path(raw)
    length := cstr_len(held.path)
    rest := cstr_len(path) - length - 1
    if (rest < 0 || path_under(path, held.path) == false) {
        return path
    }
    name_len := cstr_len(held.name)
    out := unsafe { ptr_cast($i8, frost_rt_alloc(name_len + rest + 2)) }
    mut k: i64 = 0
    while (k < name_len) {
        byte_set(out, k, byte_at(held.name, k))
        k = k + 1
    }
    byte_set(out, name_len, CH_SLASH)
    k = 0
    while (k < rest) {
        byte_set(out, name_len + 1 + k, byte_at(path, length + 1 + k))
        k = k + 1
    }
    byte_set(out, name_len + 1 + rest, 0)
    out
}

// Copy a file's text into the buffer at `at`, terminated, and answer where the
// next one starts.
append_text :: fn(buffer: str, at: i64, text: str) -> i64 {
    length := str_len(text)
    mut into := buffer
    mut k: i64 = 0
    while (k < length) {
        into[at + k] = text[k]
        k = k + 1
    }
    into[at + length] = CH_LF
    into[at + length + 1] = 0
    at + length + 1
}

// Place a file and everything it imports, imports first. A struct's name is
// resolved where it is written rather than looked up later, so a file has to
// reach the buffer after everything it depends on. A file already placed is
// skipped, which is what makes a diamond one copy and a cycle terminate.
place_module :: fn(
    buffer: str,
    at: i64,
    given: ^i8,
    mut modules: Arena<Module>,
    mut roots: Arena<SearchRoot>,
    mut layers: Arena<Layer>,
    mut scratch: Arena<Token>
) -> i64 {
    // The one the root file was named by comes in as the command line wrote it,
    // which on this machine is as likely to hold backslashes as not. Every
    // other path here has been through this already, and two spellings of one
    // file are two modules.
    path := normalise_path(given)
    if (module_seen(modules, path)) {
        return at
    }
    mine := arena_push(
        modules,
        Module {
            path = path,
            name = named_path(path),
            start = 0,
            finish = 0,
            cursor_off = -1,
            cursor_line = 1,
            cursor_column = 1
        }
    )
    raw := unsafe { frost_rt_read_file(path) }
    // The file's bytes as a slice, once, so nothing below indexes a bare
    // pointer.
    text := cstr_slice(raw)
    if (str_len(text) == 0) {
        report_command("cannot read '")
        report_cstr(path)
        report("'")
        frost_rt_die()
    }
    // Read this file's imports out before recursing, since the recursion needs
    // the scratch tokens for the file it descends into.
    mut children := arena_make($Module, 256)
    scratch.count = 0
    tokenize(text, str_len(text), scratch)
    mut i: i64 = 0
    while (i + 1 < scratch.count) {
        entry := arena_at(scratch, i)
        named := arena_at(scratch, i + 1)
        if (entry.kind == TokenKind::KwImport && named.kind == TokenKind::Str) {
            // Held for both fields. What a child is called is worked out where
            // it is placed, and nothing reads this one.
            child := find_import(
                path,
                text,
                named.off,
                named.len,
                roots,
                layers
            )
            arena_push(
                children,
                Module {
                    path = child,
                    name = child,
                    start = 0,
                    finish = 0,
                    cursor_off = -1,
                    cursor_line = 1,
                    cursor_column = 1
                },
            )
        }
        i = i + 1
    }
    mut here := at
    mut c: i64 = 0
    while (c < children.count) {
        child := arena_at(children, c)
        here = place_module(
            buffer,
            here,
            child.path,
            modules,
            roots,
            layers,
            scratch
        )
        c = c + 1
    }
    finish := append_text(buffer, here, text)
    // A byte-order mark at the head of this file would land mid-buffer, where
    // the tokenizer's own head-of-file skip cannot see it. Blanked to spaces
    // in place, so every offset after it stays where it was.
    if (str_len(text) >= 3 && text[0] == 239 && text[1] == 187
        && text[2] == 191) {
        mut into := buffer
        into[here] = CH_SPACE
        into[here + 1] = CH_SPACE
        into[here + 2] = CH_SPACE
    }
    // The range is known only now, since everything this file imports went in
    // ahead of it. It is what tells a name which file wrote it.
    placed := arena_at(modules, mine)
    placed.start = here
    placed.finish = finish
    finish
}

// Which module a byte belongs to. A program compiled from a single file has no
// modules recorded, and everything in it belongs to the root.
// Where an offset came from, as the file that wrote it and the line and column
// inside that file. Every file's text is laid into one buffer, so a line is
// counted from where that file's own text starts rather than from the top.
//
// This walks rather than keeping a table of line starts. It runs once, on the
// way to reporting an error and ending the process, so what it costs is not on
// any path a working build takes.
// The line an offset is on, counting from one, and the module holding it.
// `report_where` works the same thing out in order to print it; this is for
// the places that want the numbers, which is the debug line table.
line_of :: fn(mut modules: Arena<Module>, src: str, offset: i64) -> i64 {
    index := module_at(modules, offset)
    if (index < 0) {
        return 0
    }
    entry := arena_at(modules, index)
    // Bounded by the text as well as by the offset. A module's range covers the
    // room appended after it for synthesized names, and a node built out of one
    // carries an offset in there, which is past anything to read.
    mut line: i64 = 1
    mut at := entry.start
    stop := str_len(src)
    while (at < offset && at < stop) {
        if (src[at] == CH_LF) {
            line = line + 1
        }
        at = at + 1
    }
    line
}

column_of :: fn(mut modules: Arena<Module>, src: str, offset: i64) -> i64 {
    index := module_at(modules, offset)
    if (index < 0) {
        return 0
    }
    entry := arena_at(modules, index)
    mut column: i64 = 1
    mut at := entry.start
    stop := str_len(src)
    while (at < offset && at < stop) {
        if (src[at] == CH_LF) {
            column = 1
        } else {
            column = column + 1
        }
        at = at + 1
    }
    column
}

// Which module an offset belongs to, as a number a `.file` directive can carry.
// One rather than zero, since a file number of zero is not one an assembler
// takes.
file_of :: fn(mut modules: Arena<Module>, offset: i64) -> i64 {
    module_at(modules, offset) + 1
}

// The second line of a report already open: the same block of file, line and
// caret, sorting with the line above it rather than where it points.
report_note_where :: fn(mut modules: Arena<Module>, src: str, offset: i64) {
    frost_rt_report_note()
    report_place(modules, src, offset)
}

report_where :: fn(mut modules: Arena<Module>, src: str, offset: i64) {
    // The report starts here, at the byte its place is. Everything written
    // after this belongs to it, and the run writes them all out in the order
    // they are written rather than the order the passes found them. Opened
    // before the two answers below, so a report with no file to name is still
    // one report and still sorts where it belongs.
    frost_rt_report_open(offset)
    report_place(modules, src, offset)
}

// The edit that answers the report being composed, where the site that wrote it
// knows one. The span counts bytes from the start of the file, and the offsets a
// pass holds count from the start of the one buffer every module was laid into,
// so the module's own start is what comes off them.
//
// Said only where a run asks for records. At a terminal the report is the text
// and the reader is the one who applies it.
report_fix :: fn(
    mut modules: Arena<Module>,
    offset: i64,
    length: i64,
    replacement: ^i8,
    certain: i64
) {
    if (json_reports() == false || modules.count == 0) {
        return
    }
    index := module_at(modules, offset)
    if (index < 0) {
        return
    }
    start := arena_at(modules, index).start
    unsafe {
        frost_rt_json_fix(
            offset - start,
            offset - start + length,
            replacement,
            certain
        )
    }
}

// The block a report opens with: the file, the line and the column, the line of
// source itself, and a caret under the column. Written by both of the two
// above, which differ only in whether they start a report or continue one.
report_place :: fn(mut modules: Arena<Module>, src: str, offset: i64) {
    // A program the compiler holds itself rather than reads is in no module, so
    // there is no file and no line to name. The report still says what is
    // wrong; without this it died on the empty table instead.
    if (modules.count == 0) {
        return
    }
    index := module_at(modules, offset)
    if (index < 0) {
        return
    }
    entry := arena_at(modules, index)
    mut line: i64 = 1
    mut column: i64 = 1
    // The start of the line the offset is on, and the end of it, so the source
    // can be shown with a caret under the column the error is at.
    mut line_start := entry.start
    mut line_end := offset
    mut at := entry.start
    while (at < offset) {
        if (src[at] == CH_LF) {
            line = line + 1
            column = 1
            line_start = at + 1
        } else {
            column = column + 1
        }
        at = at + 1
    }
    while (line_end < entry.finish
        && src[line_end] != CH_LF) {
        line_end = line_end + 1
    }
    // A caller reading JSON gets the place as fields and the message as one
    // string, so the record opens here and whatever ends the report closes it.
    if (json_reports()) {
        // Into the file, not into the buffer every module was spliced into. A
        // reader of the JSON opens the file this names and looks at the bytes
        // the span gives, and the buffer's own offset points past the end of a
        // file the imports were laid down before.
        unsafe {
            frost_rt_json_place(entry.name, line, column, offset - entry.start)
        }
        return
    }
    report_cstr(entry.name)
    report(":")
    frost_rt_error_int(line)
    report(":")
    frost_rt_error_int(column)
    report(":\n")
    // The offending line, then a caret under the column. The message the caller
    // writes next follows the caret on that line, so it sits right at the spot.
    report_src(src, line_start, line_end - line_start)
    report("\n")
    mut space: i64 = 1
    while (space < column) {
        report(" ")
        space = space + 1
    }
    report("^ ")
}

// The same position, written into the emitted program rather than to stderr,
// for an assertion that has to name where it was written when it fails at run
// time. A path separator is escaped, since this lands inside a C string.
emit_position :: fn(mut modules: Arena<Module>, src: str, offset: i64) {
    index := module_at(modules, offset)
    if (index < 0) {
        return
    }
    entry := arena_at(modules, index)
    mut line: i64 = 1
    mut column: i64 = 1
    mut at := entry.start
    // Carry on from the last answer when this one is further into the file,
    // which is the ordinary case, and start over when it is behind.
    if (entry.cursor_off >= 0 && entry.cursor_off <= offset) {
        at = entry.cursor_off
        line = entry.cursor_line
        column = entry.cursor_column
    }
    while (at < offset) {
        if (src[at] == CH_LF) {
            line = line + 1
            column = 1
        } else {
            column = column + 1
        }
        at = at + 1
    }
    entry.cursor_off = offset
    entry.cursor_line = line
    entry.cursor_column = column
    mut k: i64 = 0
    length := cstr_len(entry.name)
    while (k < length) {
        byte := byte_at(entry.name, k)
        if (byte == CH_BACKSLASH) {
            frost_rt_emit_char(CH_BACKSLASH)
        }
        frost_rt_emit_char(byte)
        k = k + 1
    }
    emit_text(":")
    frost_rt_emit_int(line)
    emit_text(":")
    frost_rt_emit_int(column)
}

module_at :: fn(mut modules: Arena<Module>, offset: i64) -> i64 {
    mut i: i64 = 0
    while (i < modules.count) {
        entry := arena_at(modules, i)
        if (offset >= entry.start && offset < entry.finish) {
            return i
        }
        i = i + 1
    }
    0
}

// A newline is left where it is. A report names the line a thing is written on
// by counting the newlines above it, so a list blanked away took its lines with
// it and everything below was named as if it stood that many lines higher: an
// `export` running over thirteen lines put every report in the file twelve
// lines above what the reader wrote.
blank_range :: fn(buffer: str, from: i64, through: i64) {
    mut b := from
    while (b <= through) {
        if (buffer[b] != CH_LF) {
            buffer[b] = CH_SPACE
        }
        b = b + 1
    }
}

// A directory joined to a name, as a NUL-terminated string the search can keep.
// The block is malloc and byte stores into what it just took, which is memory
// nothing else has yet.
joined_path :: fn(directory: ^i8, upto: i64, name: ^i8) -> ^i8 {
    extra := cstr_len(name)
    block := unsafe { ptr_cast($i8, frost_rt_alloc(upto + extra + 2)) }
    mut i: i64 = 0
    while (i < upto) {
        byte_set(block, i, byte_at(directory, i))
        i = i + 1
    }
    // One separator between the two, whether or not the directory already ends
    // in one. The root is the directory that does, and "/" joined with a name
    // is "/name".
    mut end := upto
    if (end > 0) {
        last := byte_at(directory, end - 1)
        if (last == CH_SLASH || last == CH_BACKSLASH) {
            end = end - 1
        }
    }
    byte_set(block, end, CH_SLASH)
    mut k: i64 = 0
    while (k < extra) {
        byte_set(block, end + 1 + k, byte_at(name, k))
        k = k + 1
    }
    byte_set(block, end + 1 + extra, 0)
    block
}

// How much of a path is the directory holding it, which is everything up to the
// last separator. Both separators count, since a Windows argv[0] uses one and a
// shell may hand over the other.
directory_part :: fn(path: ^i8, upto: i64) -> i64 {
    mut at := upto
    while (at > 0) {
        at = at - 1
        held := byte_at(path, at)
        if (held == CH_SLASH || held == CH_BACKSLASH) {
            return at
        }
    }
    0
}

// What a project declares about where its own libraries live, beside the file
// named on the command line.
//
// A project without one is the common case and is no error: a file that imports
// its neighbours needs nothing declared. One that cannot be read as JSON is an
// error, because a manifest that is there and says nothing readable is a
// project saying something it meant.
MANIFEST_NAME :: "frost.json"

// The directory holding the nearest manifest at or above the entry file, or an
// empty path where there is none. A layer list describes a whole project and a
// build's entry is any file in it, so the declaration is found by walking up
// rather than repeated in every directory a build might start in.
//
// The walk is over the entry's absolute directory, so how the path was spelled
// on the command line says nothing about which manifest is found: `frost
// deep/x.frost` from inside a project reaches the same declaration `frost
// project/deep/x.frost` from above it does. Walking the path as written stopped
// at the directory the build was started in, which let a build run from a
// subdirectory compile a program the same build run from the project root
// refuses.
manifest_above :: fn(entry: ^i8) -> ^i8 {
    absolute := absolute_path(entry)
    mut length := directory_part(absolute, cstr_len(absolute))
    // Down to the shortest prefix that still names a directory. On Windows that
    // is the drive, "C:", which the walk reaches as a prefix of its own.
    while (length > 0) {
        held := prefix_of(absolute, length)
        if (unsafe { frost_rt_file_exists(manifest_path(held)) } == 1) {
            return held
        }
        length = directory_part(absolute, length)
    }
    // A path that begins with a separator has one directory above what the walk
    // reached, the root itself, and "/frost.json" is a manifest like any other.
    // The walk stops before it because the prefix that names it is one byte
    // long and every step answers where a separator sits, which is byte 0.
    //
    // Read here rather than by letting the walk reach a prefix of nothing: on a
    // path with no leading separator that prefix names no directory at all, and
    // reading it as the working directory would hand a project's manifest to a
    // file compiled from somewhere else entirely.
    if (cstr_len(absolute) > 0) {
        first := byte_at(absolute, 0)
        if (first == CH_SLASH || first == CH_BACKSLASH) {
            if (unsafe { frost_rt_file_exists(manifest_path("/")) } == 1) {
                return "/"
            }
        }
    }
    ""
}

// The manifest in a directory.
manifest_path :: fn(directory: ^i8) -> ^i8 {
    joined_path(directory, cstr_len(directory), MANIFEST_NAME)
}

manifest_roots :: fn(
    entry: ^i8,
    mut roots: Arena<SearchRoot>,
    mut layers: Arena<Layer>
) {
    under := manifest_above(entry)
    if (cstr_len(under) == 0) {
        return
    }
    path := manifest_path(under)
    text := cstr_slice(unsafe { frost_rt_read_file(path) })
    mut document := json_parse(text)
    root := json_root(document)
    if (root < 0 || json_kind(document, root) != JsonKind::Object) {
        // Nothing is given back here, since the next thing this does is stop.
        report_command("cannot read '")
        report_cstr(path)
        report("' as a manifest")
        frost_rt_die()
    }
    // Each declared directory is relative to the manifest, which is what lets
    // one name a sibling of the project rather than of whatever directory the
    // build was started from.
    mut named := json_at(document, json_member(document, root, "paths"), 0)
    while (named >= 0) {
        if (json_kind(document, named) == JsonKind::String) {
            off := json_text_off(document, named)
            len := json_text_len(document, named)
            add_root(
                roots,
                normalise_path(join_under(under, text, off, len))
            )
        }
        named = json_next(document, named)
    }
    // The layers, in the order they may reach. Each is kept twice: as the
    // manifest wrote it, which is what a diagnostic says, and as the path it
    // resolves to, which is what a file is tested against.
    mut layer := json_at(document, json_member(document, root, "layers"), 0)
    while (layer >= 0) {
        if (json_kind(document, layer) == JsonKind::String) {
            off := json_text_off(document, layer)
            len := json_text_len(document, layer)
            add_layer(
                layers,
                text_as_cstr(text, off, len),
                absolute_path(join_under(under, text, off, len))
            )
        }
        layer = json_next(document, layer)
    }
    json_free(document)
}

// The files a program of this project writes, as the manifest declares them, in
// the order it declares them.
//
// A manifest that is not there declares none, which is what a project with
// nothing generated looks like and is no error. A member of `generated` that
// names only one of the two paths it has to name is refused, because a project
// that wrote half a declaration meant the whole of it.
manifest_generators :: fn(entry: ^i8, mut into: Arena<Generator>) {
    under := manifest_above(entry)
    if (cstr_len(under) == 0) {
        return
    }
    path := manifest_path(under)
    text := cstr_slice(unsafe { frost_rt_read_file(path) })
    mut document := json_parse(text)
    root := json_root(document)
    if (root < 0 || json_kind(document, root) != JsonKind::Object) {
        report_command("cannot read '")
        report_cstr(path)
        report("' as a manifest")
        frost_rt_die()
    }
    mut step := json_at(document, json_member(document, root, "generated"), 0)
    while (step >= 0) {
        // A member of any other shape names nothing, so it is refused here for
        // the same reason a half declared one is. Reading the two paths off a
        // member that is not an object answers -1 for each, which is the same
        // answer a missing one gives, so one report covers every shape.
        written := json_member(document, step, "output")
        from := json_member(document, step, "from")
        if (json_kind(document, written) != JsonKind::String
            || json_kind(document, from) != JsonKind::String) {
            report("frost generate: a member of 'generated' in frost.json ")
            report("does not name both an output and what writes it")
            frost_rt_die()
        }
        // Every path is relative to the manifest, the way a declared search
        // directory is, so the same command run from anywhere under the
        // project reaches the same files.
        mut arguments: ^i8 = ""
        mut input := json_at(document, json_member(document, step, "inputs"), 0)
        while (input >= 0) {
            if (json_kind(document, input) == JsonKind::String) {
                arguments = join_two(
                    join_two(
                        join_two(arguments, " \""),
                        resolved_under(under, text, input, document)
                    ),
                    "\""
                )
            }
            input = json_next(document, input)
        }
        arena_push(
            into,
            Generator {
                output_named = spelled(text, written, document),
                output = resolved_under(under, text, written, document),
                from_named = spelled(text, from, document),
                from = resolved_under(under, text, from, document),
                inputs = arguments,
            }
        )
        step = json_next(document, step)
    }
    json_free(document)
}

// A path as the manifest spelled it, which is what a report about it says.
spelled :: fn(text: str, node: i64, mut document: Json) -> ^i8 {
    text_as_cstr(
        text,
        json_text_off(document, node),
        json_text_len(document, node)
    )
}

// A path a manifest member names, under the directory the manifest sits in.
resolved_under :: fn(
    under: ^i8,
    text: str,
    node: i64,
    mut document: Json
) -> ^i8 {
    normalise_path(
        join_under(
            under,
            text,
            json_text_off(document, node),
            json_text_len(document, node)
        )
    )
}

// A run of the manifest's text as a string of its own.
text_as_cstr :: fn(src: str, off: i64, len: i64) -> ^i8 {
    out := unsafe { ptr_cast($i8, frost_rt_alloc(len + 1)) }
    mut k: i64 = 0
    while (k < len) {
        byte_set(out, k, src[off + k])
        k = k + 1
    }
    byte_set(out, len, 0)
    out
}

// The leading part of a path, as a string of its own, which is what a declared
// directory is joined under. `directory_part` answers with a length rather than
// a string, since every other caller wants to keep walking back through it.
prefix_of :: fn(path: ^i8, length: i64) -> ^i8 {
    out := unsafe { ptr_cast($i8, frost_rt_alloc(length + 1)) }
    mut k: i64 = 0
    while (k < length) {
        byte_set(out, k, byte_at(path, k))
        k = k + 1
    }
    byte_set(out, length, 0)
    out
}

// The directories an import may be found under, most deliberate first: what the
// command line said, then FROST_PATH, then FROST_STD, then the standard library
// beside the compiler and one checkout layout up from it, then the working
// directory. The two beside the compiler are what let it run from anywhere
// rather than only from a checkout root.
// The library beside a compiler at `program`, and beside the one and two
// directories above it: an installed layout puts `std` next to the binary, and
// a checkout puts it two above `target/release` and one above `selfhosted`.
roots_beside :: fn(mut roots: Arena<SearchRoot>, program: ^i8) {
    length := cstr_len(program)
    if (length == 0) {
        return
    }
    directory := directory_part(program, length)
    add_root(roots, joined_path(program, directory, "std"))
    up_one := directory_part(program, directory)
    add_root(roots, joined_path(program, up_one, "std"))
    up_two := directory_part(program, up_one)
    add_root(roots, joined_path(program, up_two, "std"))
}

search_roots_from :: fn(mut roots: Arena<SearchRoot>) {
    named := unsafe { frost_rt_getenv("FROST_PATH") }
    if (cstr_len(named) != 0) {
        add_root(roots, named)
    }
    // Someone who says exactly where the standard library is means it.
    standard := unsafe { frost_rt_getenv("FROST_STD") }
    if (cstr_len(standard) != 0) {
        add_root(roots, standard)
    }
    // Where this program is, as the system says and as the caller wrote it.
    // The two differ: a spawn naming the compiler by itself hands over a bare
    // name, and the directory read off that one is the caller's rather than the
    // compiler's. Both are read, since the system answers nothing on a platform
    // that will not say.
    roots_beside(roots, unsafe { frost_rt_program_path() })
    roots_beside(roots, frost_rt_arg_at(0))
    add_root(roots, "std")
    add_root(roots, ".")
}

// Which module a path is, or -1 for one that was never placed.
module_index_of :: fn(mut modules: Arena<Module>, path: ^i8) -> i64 {
    mut i: i64 = 0
    while (i < modules.count) {
        entry := arena_at(modules, i)
        if (cstr_eq(entry.path, path)) {
            return i
        }
        i = i + 1
    }
    -1
}

// Copy a name out of one buffer into another, answering with the length so the
// caller can keep its own cursor. Used for names on lines that are about to be
// blanked.
// The copy that puts a name into the buffer's synth room. The destination is
// bound mutable first: `into` is a read parameter, and writing through one is
// not what it means.
copy_name :: fn(into: str, at: i64, from: str, off: i64, len: i64) -> i64 {
    mut destination := into
    mut b: i64 = 0
    while (b < len) {
        destination[at + b] = from[off + b]
        b = b + 1
    }
    len
}

resolve_imports :: fn(
    buffer: str,
    root: ^i8,
    names: str,
    mut modules: Arena<Module>,
    mut exports: Arena<Export>,
    mut edges: Arena<ImportEdge>,
    mut renames: Arena<Rename>,
    mut scratch: Arena<Token>,
    mut roots: Arena<SearchRoot>,
    mut layers: Arena<Layer>
) -> i64 {
    mut named_at: i64 = 0
    length := place_module(buffer, 0, root, modules, roots, layers, scratch)
    // Every imported file's text is in the buffer now, so the imports have
    // nothing left to say, and an export line has said it once it is recorded.
    // Blanking both leaves the parser one plain program with every offset where
    // it was.
    scratch.count = 0
    tokenize(buffer, length, scratch)
    mut j: i64 = 0
    while (j + 1 < scratch.count) {
        entry := arena_at(scratch, j)
        named := arena_at(scratch, j + 1)
        if (entry.kind == TokenKind::KwImport && named.kind == TokenKind::Str) {
            // The line is about to be blanked, so the edge it stands for is
            // recorded first. The importer is whoever wrote the line, and the
            // module it names is resolved against that file's own directory,
            // the same way it was when the text was placed.
            importer := module_at(modules, entry.off)
            mut imported: i64 = -1
            if (importer >= 0) {
                mine := arena_at(modules, importer)
                found := find_import(
                    mine.path,
                    buffer,
                    named.off,
                    named.len,
                    roots,
                    layers
                )
                imported = module_index_of(modules, found)
                if (imported >= 0) {
                    arena_push(
                        edges,
                        ImportEdge { importer = importer, imported = imported }
                    )
                }
            }
            // `(insert as list_insert)`: the names are copied out because the
            // line is about to be blanked, and the tail is blanked with it.
            mut through := named.off + named.len
            mut r := j + 2
            if (r < scratch.count) {
                opened := arena_at(scratch, r)
                if (opened.kind == TokenKind::Lparen) {
                    through = opened.off
                    r = r + 1
                    mut reading: bool = true
                    while (reading && r + 2 < scratch.count) {
                        exported := arena_at(scratch, r)
                        word := arena_at(scratch, r + 1)
                        local := arena_at(scratch, r + 2)
                        if (exported.kind != TokenKind::Ident
                            || word.kind != TokenKind::Ident
                            || local.kind != TokenKind::Ident) {
                            reading = false
                        } else {
                            exported_at := named_at
                            named_at = named_at + copy_name(
                                names,
                                named_at,
                                buffer,
                                exported.off,
                                exported.len
                            )
                            local_at := named_at
                            named_at = named_at + copy_name(
                                names,
                                named_at,
                                buffer,
                                local.off,
                                local.len
                            )
                            arena_push(
                                renames,
                                Rename {
                                    importer = importer,
                                    imported = imported,
                                    local_off = local_at,
                                    local_len = local.len,
                                    exported_off = exported_at,
                                    exported_len = exported.len
                                }
                            )
                            through = local.off + local.len
                            r = r + 3
                            if (r < scratch.count) {
                                following := arena_at(scratch, r)
                                if (following.kind == TokenKind::Comma) {
                                    r = r + 1
                                } else {
                                    reading = false
                                    through = following.off
                                }
                            }
                        }
                    }
                }
            }
            blank_range(buffer, entry.off, through)
        }
        if (entry.kind == TokenKind::KwExport) {
            owner := module_at(modules, entry.off)
            mut k := j + 1
            mut through := entry.off + entry.len - 1
            mut listing: bool = true
            while (listing) {
                listed := arena_at(scratch, k)
                if (listed.kind != TokenKind::Ident) {
                    listing = false
                } else {
                    // The name is copied out because the line it is written
                    // on is about to be blanked.
                    mut b: i64 = 0
                    while (b < listed.len) {
                        names[named_at + b] = buffer[listed.off + b]
                        b = b + 1
                    }
                    arena_push(
                        exports,
                        Export {
                            module = owner,
                            off = named_at,
                            len = listed.len
                        },
                    )
                    named_at = named_at + listed.len
                    through = listed.off + listed.len - 1
                    k = k + 1
                    following := arena_at(scratch, k)
                    if (following.kind == TokenKind::Comma) {
                        through = following.off
                        k = k + 1
                    } else {
                        listing = false
                    }
                }
            }
            blank_range(buffer, entry.off, through)
        }
        j = j + 1
    }
    scratch.count = 0
    length
}

// Room past the source's terminator for names the compiler makes up and for
// the files `include_str` splices in. A name is an offset and a length into the
// source everywhere in this compiler, so a synthesized one has to live in the
// source too rather than in a table of its own, and an included file's bytes
// live there for the same reason. The lexer stops at the terminator, so nothing
// here is ever read as code. Sized for shaders, not just names.
SYNTH_ROOM :: 4194304

// Room for the root file and everything it imports, laid end to end.
SOURCE_ROOM :: 8388608

// A text with room after it for the names the compiler makes up, as a slice:
// the length is known here, so every read and write into it from now on is a
// checked index.
source_with_room :: fn(text: str) -> str {
    length := str_len(text)
    mut buffer := buffer_of(length + SYNTH_ROOM + 1)
    mut k: i64 = 0
    while (k < length) {
        buffer[k] = text[k]
        k = k + 1
    }
    buffer[length] = 0
    buffer
}
