// The region check: an arena pointer may not outlive the `with` block it
// came from, across calls as well as within one.

import "core.frost"
import "imports.frost"
import "lexer.frost"
import "names.frost"
import "types.frost"
import "emit_asm.frost"
import "cursor.frost"
import "parser.frost"

export check_borrow_exclusivity, check_calls, check_export_collisions,
    check_frame_escapes, check_moves, check_pooled_resources,
    check_reference_fields, check_regions, check_types, check_unsafety

// A pool whose elements are resources.
//
// A slot is emptied by bumping a generation and filled again by an insert that
// overwrites what was there, so nothing consumes the element that leaves. The
// container carries one obligation and its slots carry none, and there is no
// consumer that can discharge the difference: releasing each element means
// consuming `p.storage[i]` around a loop, which is a move inside a loop and
// refused, correctly, since nothing says the indexes differ. So the shape is one
// the language demands be consumed and gives no way to consume, and it is
// refused where the container is declared.
//
// A slab holds its elements in `storage` and a columns container holds one array
// per field of the element instead, so both are answered by the same question:
// whether any run of values this container owns is a run of resources.
// Every struct, rather than every instantiation of a generic one. A concrete
// `Pool :: struct { storage: [4]File, generations: [4]i64 }` is the same
// container written out, and asking only about instantiations let it through. A
// generic's own entry holds no fields, since those are read again per instance,
// so a template never matches the shape and needs no excluding.
check_pooled_resources :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.structs.count) {
        struct_ty := STRUCT_BASE + i
        if (is_slab_ty(p, struct_ty) || is_columns_ty(p, struct_ty)) {
            report_pooled_resource(p, struct_ty)
        }
        i = i + 1
    }
}

// The slot table, and only that. A slab keeps its elements in `storage`, so that
// one field is the question and any other run the struct happens to carry is not:
// a field holding resources beside a pool makes the struct a resource by the
// ordinary rule and is answered for there. A columns container has no `storage`
// at all, since one array per field of the element is what it is, so every column
// is part of the element and every column is asked. The bookkeeping arrays are
// the container's own and hold no element.
report_pooled_resource :: fn(mut p: Parser, struct_ty: i64) {
    if (is_slab_ty(p, struct_ty)) {
        storage := slab_field_type(p, struct_ty, "storage")
        if (is_slice_ty(p, storage) == false
            && is_linear_type(p, array_element(p, storage))) {
            report_pool(p, struct_ty)
        }
        return
    }
    def := arena_at(p.structs, struct_index_of(struct_ty))
    mut field := def.field_head
    while (field != (-1)) {
        held := arena_at(p.fields, field)
        ty := held.ty
        name_off := held.name_off
        name_len := held.name_len
        next_field := held.next
        if (is_column_field(p, name_off, name_len) && is_array_ty(ty)
            && is_slice_ty(p, ty) == false
            && is_linear_type(p, array_element(p, ty))) {
            report_pool(p, struct_ty)
        }
        field = next_field
    }
}

// Whether a field of a columns container is one of the element's rather than the
// container's own bookkeeping.
is_column_field :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    if (str_range_eq(p.src, off, len, "generations")) {
        return false
    }
    if (str_range_eq(p.src, off, len, "free_list")) {
        return false
    }
    if (str_range_eq(p.src, off, len, "free_count")) {
        return false
    }
    true
}

report_pool :: fn(mut p: Parser, struct_ty: i64) {
    def := arena_at(p.structs, struct_index_of(struct_ty))
    name_off := def.name_off
    name_len := def.name_len
    report_where(p.modules, p.src, name_off)
    report("'")
    report_src(p.src, name_off, name_len)
    report("' is a pool of a resource. A slot is released by bumping a generation and filled again by an insert that overwrites it, so nothing consumes the element that leaves. Keep the resource outside the pool and put a handle to it in the slot, or hold the elements beside the pool: one array of offsets giving each element its range into a single run that owns the whole of it")
    frost_rt_die()
}


// ---------------------------------------------------------------------------
// `where` bounds.
//
// A bound asks what the compiler already knows about a type. The vocabulary is
// fixed and closed, and every question in it is one the compiler answers for
// itself anyway, to decide whether to emit an integer or a floating point
// instruction, whether a value travels by address, and how wide it is. So a
// bound is a precondition rather than a set of operations a type registers
// into: nothing implements it, nothing is named, and there is nothing to
// resolve.
//
// It is read at the call, with that call's arguments in hand, so a type that
// cannot work is refused against the line the reader wrote rather than against
// a line inside a body they never saw.
//
// Deliberately absent is any predicate keyed by a string, such as asking
// whether a type has a field of a given name. A string literal does not grep
// back to the declaration it names, which is the one thing the flat namespace
// is for.
// ---------------------------------------------------------------------------

// One predicate against one type. -1 says the name is not one of the bounds.
bound_predicate :: fn(mut p: Parser, off: i64, len: i64, ty: i64) -> i64 {
    predicate_holds(p, off, len, ty)
}

// What a compile-time parameter of this generic is bound to at this call, or -1
// when the name is not one of its parameters.
bound_argument :: fn(mut p: Parser, gfn_index: i64, off: i64, len: i64,
    arg: i64, xarg_start: i64, xarg_count: i64) -> i64 {
    gfn := arena_at(p.generic_fns, gfn_index)
    if (gfn.tparam_len == len
        && bytes_equal(p.src, gfn.tparam_off, off, len)) {
        return arg
    }
    mut i : i64 = 0
    while (i < gfn.xparam_count && i < xarg_count) {
        param := arena_at(p.gparams, gfn.xparam_start + i)
        if (param.name_len == len
            && bytes_equal(p.src, param.name_off, off, len)) {
            garg := arena_at(p.gargs, xarg_start + i)
            return garg.value
        }
        i = i + 1
    }
    -1
}

// `pred(T)`, `!term`, and a parenthesized bound. The cursor is left just past
// what was read.
bound_term :: fn(mut p: Parser, gfn_index: i64, arg: i64, xarg_start: i64,
    xarg_count: i64) -> bool {
    if (cur(p) == TokenKind::Bang) {
        advance(p)
        return bound_term(p, gfn_index, arg, xarg_start, xarg_count) == false
    }
    if (cur(p) == TokenKind::Lparen) {
        advance(p)
        held := bound_expr(p, gfn_index, arg, xarg_start, xarg_count)
        advance(p)
        return held
    }
    pred_off := cur_off(p)
    pred_len := cur_len(p)
    advance(p)
    if (cur(p) != TokenKind::Lparen) {
        report_where(p.modules, p.src, pred_off)
        report("a `where` bound is a predicate applied to a compile-time parameter")
        frost_rt_die()
    }
    advance(p)
    param_off := cur_off(p)
    param_len := cur_len(p)
    advance(p)
    advance(p)
    ty := bound_argument(p, gfn_index, param_off, param_len, arg, xarg_start,
        xarg_count)
    if (ty < 0) {
        report_where(p.modules, p.src, param_off)
        report("the bound names ")
        report_src(p.src, param_off, param_len)
        report(", which is not a compile-time parameter of this function")
        frost_rt_die()
    }
    answer := bound_predicate(p, pred_off, pred_len, ty)
    if (answer < 0) {
        report_where(p.modules, p.src, pred_off)
        report_src(p.src, pred_off, pred_len)
        report(" is not one of the bounds a type can be held to, which are: ")
        report("is_numeric, is_integer, is_float, is_struct, is_array, is_slice, is_pointer")
        frost_rt_die()
    }
    answer == 1
}

// Terms joined by `&&` and `||`, left to right, with `&&` binding tighter.
bound_conjunction :: fn(mut p: Parser, gfn_index: i64, arg: i64,
    xarg_start: i64, xarg_count: i64) -> bool {
    mut held := bound_term(p, gfn_index, arg, xarg_start, xarg_count)
    while (cur(p) == TokenKind::Andand) {
        advance(p)
        right := bound_term(p, gfn_index, arg, xarg_start, xarg_count)
        held = held && right
    }
    held
}

bound_expr :: fn(mut p: Parser, gfn_index: i64, arg: i64, xarg_start: i64,
    xarg_count: i64) -> bool {
    mut held := bound_conjunction(p, gfn_index, arg, xarg_start, xarg_count)
    while (cur(p) == TokenKind::Oror) {
        advance(p)
        right := bound_conjunction(p, gfn_index, arg, xarg_start, xarg_count)
        held = held || right
    }
    held
}

// The bound of the generic this call names, against the arguments this call
// gives it.
check_bound_at_call :: fn(mut p: Parser, gfn_index: i64, fn_index: i64,
    args: i64, at: i64) {
    gfn := arena_at(p.generic_fns, gfn_index)
    if (gfn.bound_token < 0) {
        return
    }
    arg := call_type_args(p, args, gfn_index)
    xarg_start := p.call_xarg_start
    xarg_count := p.call_xarg_count
    // A call written inside a template names its enclosing parameters, which
    // are bound only once that template is instantiated. The instance is
    // checked in its own right, so the placeholder is left alone here, and so
    // is a tuple nothing in scope could name.
    if (arg < 0 || arg == TY_PARAM) {
        return
    }
    held := p.ti
    p.ti = gfn.bound_token
    holds := bound_expr(p, gfn_index, arg, xarg_start, xarg_count)
    p.ti = held
    if (holds) {
        return
    }
    sym := arena_at(p.fns, fn_index)
    report_where(p.modules, p.src, at)
    report_src(p.src, sym.off, sym.len)
    report(" is declared `where ")
    mut i : i64 = gfn.bound_token
    while (i < p.tokens.count) {
        token := arena_at(p.tokens, i)
        if (token.kind == TokenKind::Lbrace) {
            i = p.tokens.count
        } else {
            report_src(p.src, token.off, token.len)
            i = i + 1
        }
    }
    report("`, and that does not hold for ")
    report_src(p.src, gfn.tparam_off, gfn.tparam_len)
    report(" = ")
    report_type_name(p, arg)
    mut x : i64 = 0
    while (x < gfn.xparam_count && x < xarg_count) {
        param := arena_at(p.gparams, gfn.xparam_start + x)
        garg := arena_at(p.gargs, xarg_start + x)
        report(", ")
        report_src(p.src, param.name_off, param.name_len)
        report(" = ")
        report_type_name(p, garg.value)
        x = x + 1
    }
    frost_rt_die()
}

// ---------------------------------------------------------------------------
// The type check: every place a value crosses into something that already says
// what it is.
//
// There are four of them and no more: a binding that gave its type, an
// assignment, an argument, and a return. Everything else about a type is
// derived rather than declared, so there is nothing for it to disagree with.
//
// This is a pass rather than something an emitter does, because which backend
// runs must not decide which programs compile. The rule belongs to the
// language. A backend is a way of writing an accepted program down.
//
// It walks what is emitted, the program list and one instance per
// monomorphization, rather than every function node in the arena. A generic
// template's own body names parameters nothing has bound yet, and reading it as
// if it were a program reports errors against code no one wrote.
// ---------------------------------------------------------------------------

check_types :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (kind == NodeKind::Func) {
            sym := arena_at(p.fns, node.val)
            check_types_in(p, node.a, node.b, node.val, sym.ret_type)
        }
        id = next_id
    }
    mut gi : i64 = 0
    while (gi < p.generic_fns.count) {
        mut ii : i64 = 0
        while (ii < p.type_args.count) {
            used := arena_at(p.type_args, ii)
            arg := used.arg
            xstart := used.xarg_start
            xcount := used.xarg_count
            is_pack := used.is_pack
            owner := used.owner
            if (instance_fits_kind(p, gi, arg, xstart, xcount, is_pack,
                owner) && tuple_is_first_for(p, gi, ii)) {
                instance := parse_generic_instance(p, gi, arg, xstart, xcount)
                // The return type worked out for this instance. The template's
                // own still names its parameters.
                ret := p.last_return_type
                fnode := arena_at(p.arena, instance)
                check_types_in(p, fnode.a, fnode.b, fnode.val, ret)
            }
            ii = ii + 1
        }
        gi = gi + 1
    }
}

check_types_in :: fn(mut p: Parser, body: i64, params: i64, fn_index: i64,
    ret: i64) {
    sym := arena_at(p.fns, fn_index)
    p.current_ret = ret
    p.current_fn_off = sym.off
    p.current_fn_len = sym.len
    p.locals.count = 0
    p.frame_used = 0
    check_record_params(p, params)
    check_types_list(p, body)
}

// A parameter is a local of its declared type, which is what lets the rest of
// this walk ask what a name is.
check_record_params :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        record_local(p, node.val, node.c, node.b)
        id = next_id
    }
}

check_types_list :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        check_types_stmt(p, id)
        id = next_id
    }
}

// A float literal reaching a place that holds single precision is read at
// single precision. `held : f32 = -2.1 + 1.1` adds two numbers an `f32` holds
// and the same expression read at `f64` adds two an `f64` holds, so the two
// answer differently and the context is what decides which.
//
// The width is written onto the literal's node rather than answered from here,
// because both emitters ask a node for its type long after this walk is over:
// the C backend writes the suffix that stops C widening the constant, and the
// assembler narrows and widens the number it laid down as a double.
want_single :: fn(mut p: Parser, id: i64, want: i64) {
    if (id < 0 || distinct_repr(want) != TY_F32) {
        return
    }
    mark_single(p, id)
}

mark_single :: fn(mut p: Parser, id: i64) {
    if (id < 0) {
        return
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Float) {
        mut held := arena_at(p.arena, id)
        held.a = 1
        return
    }
    // Arithmetic over literals is a literal, so the width reaches through it.
    // A comparison answers a truth value whatever it was handed, and stops it.
    if (kind == NodeKind::Bin && op_answers_truth(node.val) == false) {
        left := node.a
        right := node.b
        mark_single(p, left)
        mark_single(p, right)
        return
    }
    // A constant standing for a float literal is that literal here. The name is
    // replaced by the number it holds rather than marked, since one constant is
    // read in as many places as it is written and each of them decides its own
    // width; this node is the one use.
    if (kind == NodeKind::Var && local_exists(p, node.val, node.c) == false) {
        source := value_const_node(p, node.val, node.c)
        if (source < 0) {
            return
        }
        literal := arena_at(p.arena, source)
        if (literal.kind != NodeKind::Float) {
            return
        }
        sign := literal.b
        offset := literal.val
        length := literal.c
        mut here := arena_at(p.arena, id)
        here.kind = NodeKind::Float
        here.a = 1
        here.b = sign
        here.val = offset
        here.c = length
    }
}

check_types_stmt :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Let) {
        value := node.a
        annotation := node.b
        off := node.val
        len := node.c
        // Storage a branch fills in has no value of its own here, so there is
        // nothing to check its type against. The type is the one the branches
        // answered with, written on when they were read.
        if (value == (-1)) {
            record_local(p, off, len, annotation)
            return
        }
        check_types_expr(p, value)
        mut ty := annotation
        if (annotation == (-1)) {
            ty = binding_type(p, value)
        } else if (is_columns_new_call(p, value)) {
            // `columns_new()` stands for a zeroed container rather than a call,
            // so it has no declaration to answer with a type.
            ty = annotation
        } else {
            want_single(p, value, annotation)
            value_ty := type_of(p, value)
            if (value_fits(p, value, value_ty, annotation) == false) {
                report_where(p.modules, p.src, node.pos)
                report("this binding is a '")
                report_type_name(p, annotation)
                report("' and the value is a '")
                report_type_name(p, value_ty)
                report("'")
                report_distinct_note(p, value, value_ty, annotation)
                frost_rt_die()
            }
        }
        record_local(p, off, len, ty)
        return
    }
    if (kind == NodeKind::Assign) {
        place := node.a
        value := node.b
        check_types_expr(p, place)
        check_types_expr(p, value)
        // A scatter into a columns container writes a whole element through a
        // handle, so the place is every column at once rather than one value
        // with a type to compare against.
        place_node := arena_at(p.arena, place)
        if (place_node.kind == NodeKind::Index) {
            mut through := type_of(p, place_node.a)
            if (is_pointer(through)) {
                through = pointee(through)
            }
            if (type_of(p, place_node.b) == TY_HANDLE
                && is_columns_ty(p, through)) {
                return
            }
        }
        place_ty := place_type(p, place)
        want_single(p, value, place_ty)
        value_ty := type_of(p, value)
        if (value_fits(p, value, value_ty, place_ty) == false) {
            report_where(p.modules, p.src, node.pos)
            report("assigning a value of the wrong type: the place is a '")
            report_type_name(p, place_ty)
            report("' and the value is a '")
            report_type_name(p, value_ty)
            report("'")
            report_distinct_note(p, value, value_ty, place_ty)
            frost_rt_die()
        }
        return
    }
    if (kind == NodeKind::Return) {
        value := node.a
        if (value == (-1)) {
            return
        }
        check_types_expr(p, value)
        want_single(p, value, p.current_ret)
        value_ty := type_of(p, value)
        if (value_fits(p, value, value_ty, p.current_ret) == false) {
            report_where(p.modules, p.src, node.pos)
            report("'")
            report_src(p.src, p.current_fn_off, p.current_fn_len)
            report("' returns a value of the wrong type")
            report_distinct_note(p, value, value_ty, p.current_ret)
            frost_rt_die()
        }
        return
    }
    if (kind == NodeKind::ExprStmt || kind == NodeKind::Print) {
        check_types_expr(p, node.a)
        return
    }
    if (kind == NodeKind::If) {
        check_types_expr(p, node.a)
        check_types_list(p, node.b)
        if (node.val != (-1)) {
            check_types_list(p, node.val)
        }
        return
    }
    if (kind == NodeKind::While) {
        if (node.c != (-1)) {
            check_types_list(p, node.c)
        }
        check_types_expr(p, node.a)
        check_types_list(p, node.b)
        return
    }
    if (kind == NodeKind::Match) {
        check_types_expr(p, node.a)
        mut cid := node.b
        while (cid != (-1)) {
            cnode := arena_at(p.arena, cid)
            next_case := cnode.next
            check_types_list(p, cnode.a)
            cid = next_case
        }
        return
    }
    if (kind == NodeKind::With) {
        check_types_list(p, node.a)
        return
    }
    // Anything else in statement position is an expression that answers with
    // nothing, and is walked as one.
    check_types_expr(p, id)
}

// The expression walk is here to find calls, since an argument is one of the
// four places a value crosses. The rest of it is the recursion that reaches
// them.
check_types_expr :: fn(mut p: Parser, id: i64) {
    if (id < 0) {
        return
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Call) {
        check_call_arguments(p, node.a, node.val, node.c)
        return
    }
    if (kind == NodeKind::CallPtr) {
        check_types_expr(p, node.a)
        check_argument_expressions(p, node.b)
        return
    }
    if (kind == NodeKind::StructLit) {
        struct_ty := node.val
        mut fid := node.a
        while (fid != (-1)) {
            fnode := arena_at(p.arena, fid)
            next_field := fnode.next
            value := fnode.a
            field_off := fnode.val
            field_len := fnode.c
            check_types_expr(p, value)
            if (is_struct_ty(struct_ty)) {
                want_single(p, value,
                    field_type(p, struct_ty, field_off, field_len))
            }
            fid = next_field
        }
        return
    }
    if (kind == NodeKind::ArrayLit) {
        // The element type, where the literal has one to give. Asking an arena
        // for the entry a type that is not an array names would be a read past
        // its end rather than an answer.
        held := type_of(p, id)
        mut element : i64 = -1
        if (is_array_ty(held)) {
            element = array_element(p, held)
        }
        mut eid := node.a
        while (eid != (-1)) {
            enode := arena_at(p.arena, eid)
            next_element := enode.next
            check_types_expr(p, enode.a)
            want_single(p, enode.a, element)
            eid = next_element
        }
        return
    }
    if (kind == NodeKind::Bin || kind == NodeKind::Index
        || kind == NodeKind::SliceFrom) {
        // Whether this indexes a raw pointer is a question about the base's
        // type, and the locals that answer it exist only here. The unsafety
        // gate runs before this pass and has no local table, so what it needs
        // is written onto the node while it can be known.
        // A string literal is typed as a pointer, and indexing one is still
        // checked: its length came out of the source along with its bytes, so
        // nothing is being vouched for and no block is asked for.
        // A borrow of a raw pointer is that pointer under another name, so the
        // question is asked of what the borrow names.
        if (kind == NodeKind::Index) {
            mut base_ty := type_of(p, node.a)
            if (is_borrow(base_ty)) {
                base_ty = pointee(base_ty)
            }
            if (is_raw_pointer(base_ty)
                && arena_at(p.arena, constant_node(p, node.a)).kind
                    != NodeKind::StrLit) {
                mut held := arena_at(p.arena, id)
                held.c = 1
            }
        }
        if (kind == NodeKind::Bin) {
            check_flags_operator(p, node.val, node.a, node.b, node.pos)
        }
        check_types_expr(p, node.a)
        check_types_expr(p, node.b)
        return
    }
    if (kind == NodeKind::Field || kind == NodeKind::Deref
        || kind == NodeKind::AddrOf || kind == NodeKind::Ref
        || kind == NodeKind::PtrCast || kind == NodeKind::SliceLen
        || kind == NodeKind::Assert) {
        // Whether a field is reached through a raw pointer is the same
        // question indexing asks, and it has the same answer only here, so it
        // is written onto the node the same way.
        if (kind == NodeKind::Field && is_raw_pointer(type_of(p, node.a))) {
            mut held := arena_at(p.arena, id)
            held.b = 1
        }
        check_types_expr(p, node.a)
        return
    }
}

// Each argument against the parameter it lands in. A borrowed parameter is a
// pointer to what it takes and the call site is what takes the address, so the
// argument answers to the pointee. A generic callee's parameter list belongs to
// whichever instance was parsed last, so it says nothing about this call, and
// the instances are checked in their own right.
check_call_arguments :: fn(mut p: Parser, args: i64, fn_index: i64,
    at: i64) {
    sym := arena_at(p.fns, fn_index)
    generic := generic_fn_of(p, fn_index)
    if (generic >= 0) {
        check_bound_at_call(p, generic, fn_index, args, at)
        check_argument_expressions(p, args)
        return
    }
    // A call through a function-pointer local is indirect, and answers to the
    // local's signature rather than to any declaration.
    if (local_exists(p, sym.off, sym.len)) {
        check_argument_expressions(p, args)
        return
    }
    mut index : i64 = 0
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            check_types_expr(p, value)
            declared := nth_param_type(p, sym.params, index)
            if (declared >= 0) {
                mut expected := declared
                if (is_borrow(expected)) {
                    expected = pointee(expected)
                }
                want_single(p, value, expected)
                arg_ty := type_of(p, value)
                // Either shape does: the caller hands over a value and the
                // call takes its address, or it hands over a reference it
                // already holds, which is what a `mut` parameter passed on to
                // another function is. The second shape asks what the reference
                // points at rather than that it is one, since every pointer
                // fits every other and the parameter's own type is a pointer
                // here: a `^i8` handed to a `str` was two pointers agreeing,
                // and the callee then read the length from whatever sat beside
                // it.
                mut fits := value_fits(p, value, arg_ty, expected)
                if (fits == false && expected != declared && is_pointer(arg_ty)
                    && value_fits(p, value, pointee(arg_ty), expected)) {
                    fits = true
                }
                if (expected != TY_PARAM && fits == false) {
                    report_where(p.modules, p.src, vnode.pos)
                    report("'")
                    report_src(p.src, sym.off, sym.len)
                    report("' was passed an argument of the wrong type: ")
                    report("it takes a '")
                    report_type_name(p, expected)
                    report("' and this is a '")
                    report_type_name(p, arg_ty)
                    report("'")
                    report_distinct_note(p, value, arg_ty, expected)
                    frost_rt_die()
                }
            }
            index = index + 1
        }
        id = next_id
    }
}

// A set of bits answers to union, intersection and whether it is the same set.
// Adding two of them, ordering them, or shifting one along is a question about
// the number underneath rather than about the set, and the declaration exists
// to say that the number is not what this is. Reading one as its representation
// is still allowed, so a program that means the arithmetic writes the
// conversion and gets it.
check_flags_operator :: fn(mut p: Parser, op: i64, left: i64, right: i64,
    at: i64) {
    // A program with no flags declaration cannot break this rule, and asking
    // for both operand types is not free: deriving the type of a call is what
    // instantiates the generic it names. So the question is not asked at all
    // unless there is a set of bits in the program to ask it about.
    if (p.flag_bits.count == 0) {
        return
    }
    left_ty := type_of(p, left)
    right_ty := type_of(p, right)
    mut named := left_ty
    if (is_flags_type(p, named) == false) {
        named = right_ty
    }
    if (is_flags_type(p, named) == false) {
        return
    }
    if (op != OP_BITOR && op != OP_BITAND && op != OP_EQ && op != OP_NE) {
        report_where(p.modules, p.src, at)
        report("'")
        report_type_name(p, named)
        report("' is a set of bits, and '")
        report_operator(op)
        report("' is not something two sets answer; combine them with '|', narrow them with '&', and compare them with '==' or 'flags_has'")
        frost_rt_die()
    }
    // A written number takes the other side's type where the context gives it
    // one, so what was written is the question rather than what it typed as.
    if (written_number(p, left) || written_number(p, right)) {
        report_where(p.modules, p.src, at)
        report("'")
        report_type_name(p, named)
        report("' is a set of bits, built from the names declared under it, and a number is not one of them")
        frost_rt_die()
    }
    // Two sets combine when they are the same set. Otherwise the answer would
    // be a number wearing one of the two names.
    if (left_ty != right_ty) {
        report_where(p.modules, p.src, at)
        report("'")
        report_type_name(p, named)
        report("' combines only with itself, and this is a '")
        report_type_name(p, left_ty)
        report("' against a '")
        report_type_name(p, right_ty)
        report("'")
        frost_rt_die()
    }
}

// An operator as the source writes it, written straight into a diagnostic the
// way a type name is, since a function answering with one would be answering
// with text this compiler carries as a view rather than as a literal.
report_operator :: fn(op: i64) {
    if (op == OP_ADD) { report("+")   return }
    if (op == OP_SUB) { report("-")   return }
    if (op == OP_MUL) { report("*")   return }
    if (op == OP_DIV) { report("/")   return }
    if (op == OP_MOD) { report("%")   return }
    if (op == OP_LT) { report("<")    return }
    if (op == OP_GT) { report(">")    return }
    if (op == OP_LE) { report("<=")   return }
    if (op == OP_GE) { report(">=")   return }
    if (op == OP_AND) { report("&&")  return }
    if (op == OP_OR) { report("||")   return }
    if (op == OP_SHL) { report("<<")  return }
    if (op == OP_SHR) { report(">>")  return }
    report("an operator")
}

check_argument_expressions :: fn(mut p: Parser, args: i64) {
    mut id := args
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        check_types_expr(p, node.a)
        id = next_id
    }
}


// Two modules exporting the same name is not itself a problem, since an import
// says what a file may name and a file importing only one of them sees only
// that one. What is a problem is a file that imports both and then writes the
// name, which resolves to whichever the lookup reaches first. That is caught
// where the name is looked up, and the fix is to prefix one of them, since the
// flat namespace is the point (`vec3_add` rather than `math.add`).
//
// This records only that such a pair exists, so the lookup pays for the careful
// answer in a program that has one and nowhere else. Only exported names
// collide. A private name stays the module's own.
check_export_collisions :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.exports.count) {
        first := arena_at(p.exports, i)
        mut j := i + 1
        while (j < p.exports.count) {
            second := arena_at(p.exports, j)
            if (first.module != second.module && first.len == second.len
                && bytes_equal(p.export_names, first.off, second.off,
                    first.len)) {
                p.shared_exports = 1
                return
            }
            j = j + 1
        }
        i = i + 1
    }
}

// The linear-consumption check, flow-aware. A linear value must be handed on
// exactly once on every path out of its scope. One that is not is a resource
// silently dropped. The old check accumulated moves as the code was emitted and
// asked only whether a value was moved somewhere, so a value consumed in one
// arm of an `if` and not the other read as consumed. This asks instead whether
// every path consumes it, which is an `if` only when both arms do and never a
// `while`, since a loop may not run.

is_var_named :: fn(mut p: Parser, id: i64, off: i64, len: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    if (node.kind != NodeKind::Var) {
        return false
    }
    node.c == len && bytes_equal(p.src, node.val, off, len)
}

// Whether a call hands the value named (off, len) to a parameter that takes it
// rather than borrows it, which is what consumes it: an aggregate given to a
// parameter that does not borrow (a `move`, or an extern taking it by value) is
// moved, the same rule the backend emits by.
call_consumes :: fn(mut p: Parser, args: i64, fn_index: i64, off: i64,
    len: i64) -> bool {
    if (fn_index < 0 || fn_index >= p.fns.count) {
        return false
    }
    sym := arena_at(p.fns, fn_index)
    params := sym.params
    count := count_value_args(p, args)
    mut i : i64 = 0
    while (i < count) {
        arg := nth_value_arg(p, args, i)
        param := nth_param_node(p, params, i)
        if (param != (-1) && is_var_named(p, arg, off, len)) {
            pnode := arena_at(p.arena, param)
            if (pnode.a != 1) {
                return true
            }
        }
        // An argument that is itself a call hands the value on the same way a
        // call written on its own line does, so the name may be consumed any
        // depth down rather than only in this call's own argument list.
        if (arg != (-1)) {
            anode := arena_at(p.arena, arg)
            if (anode.kind == NodeKind::Call
                && call_consumes(p, anode.a, anode.val, off, len)) {
                return true
            }
        }
        i = i + 1
    }
    false
}

// Whether one statement consumes the value on every path through it: it is
// returned, or the call it makes hands it to a `move` parameter.
stmt_consumes :: fn(mut p: Parser, id: i64, off: i64, len: i64) -> bool {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Return && is_var_named(p, node.a, off, len)) {
        return true
    }
    // A body's trailing expression is what the function answers with, so naming
    // a resource there hands it to the caller exactly as a `return` does. It is
    // still an expression statement at this point: the emitters are what turn
    // the last one into a return.
    if (kind == NodeKind::ExprStmt && node.next == (-1)
        && is_var_named(p, node.a, off, len)) {
        return true
    }
    // `held := value` moves what `value` held, so the obligation to consume it
    // is the new name's from here on, and that name is checked in its turn.
    if (kind == NodeKind::Let && is_var_named(p, node.a, off, len)) {
        return true
    }
    // `place = value` is the same move into somewhere that outlives the name:
    // a vector written into a field of a struct the caller owns is the struct's
    // from there on.
    if (kind == NodeKind::Assign && is_var_named(p, node.b, off, len)) {
        return true
    }
    mut value : i64 = -1
    // `print close(s)` consumes what the call takes, the same as writing the
    // call on its own line does. A statement holding an expression holds
    // whatever that expression hands away.
    if (kind == NodeKind::ExprStmt || kind == NodeKind::Let
        || kind == NodeKind::Return || kind == NodeKind::Print) {
        value = node.a
    }
    if (kind == NodeKind::Assign) {
        value = node.b
    }
    expr_consumes(p, value, off, len)
}

// Whether an expression hands the value on, anywhere inside it. A consuming
// call gives the value away wherever it is written, so `total = total +
// close(f)` consumes exactly as `close(f)` on its own line does, and reading
// the root of the expression alone missed every one written as an operand.
expr_consumes :: fn(mut p: Parser, id: i64, off: i64, len: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    left := node.a
    right := node.b
    if (kind == NodeKind::Call) {
        if (call_consumes(p, left, node.val, off, len)) {
            return true
        }
        return args_consume(p, left, off, len)
    }
    if (kind == NodeKind::CallPtr) {
        return args_consume(p, left, off, len)
    }
    // Only the left side of `&&` and `||` is reached on every path, so a call
    // written on the right hands the value on sometimes rather than always.
    if (kind == NodeKind::Bin) {
        if (node.val == OP_AND || node.val == OP_OR) {
            return expr_consumes(p, left, off, len)
        }
        return expr_consumes(p, left, off, len)
            || expr_consumes(p, right, off, len)
    }
    if (kind == NodeKind::Index || kind == NodeKind::SliceFrom) {
        return expr_consumes(p, left, off, len)
            || expr_consumes(p, right, off, len)
    }
    if (kind == NodeKind::Field || kind == NodeKind::Deref
        || kind == NodeKind::AddrOf || kind == NodeKind::PtrCast
        || kind == NodeKind::Cast || kind == NodeKind::SliceLen
        || kind == NodeKind::Assert || kind == NodeKind::Ref) {
        return expr_consumes(p, left, off, len)
    }
    // An `if` used as a value hands it on only where both arms do, the same
    // rule an `if` written as a statement answers to.
    if (kind == NodeKind::If) {
        return right != (-1) && node.val != (-1)
            && consumes_block(p, right, off, len, true)
            && consumes_block(p, node.val, off, len, true)
    }
    if (kind == NodeKind::StructLit || kind == NodeKind::ArrayLit) {
        return args_consume(p, left, off, len)
    }
    false
}

// The same question of every item in a chained list: an argument list, a
// struct literal's initializers, an array literal's elements.
args_consume :: fn(mut p: Parser, head: i64, off: i64, len: i64) -> bool {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        if (expr_consumes(p, value, off, len)) {
            return true
        }
        id = next_id
    }
    false
}

// Whether a match takes apart the value named (off, len). A match on a variant
// switches on the tag of the value it bound first, so what it names is reached
// through that field read rather than written at the `match`.
match_subject_is :: fn(mut p: Parser, id: i64, off: i64, len: i64) -> bool {
    node := arena_at(p.arena, id)
    subject := node.a
    if (is_var_named(p, subject, off, len)) {
        return true
    }
    if (subject == (-1)) {
        return false
    }
    held := arena_at(p.arena, subject)
    if (held.kind != NodeKind::Field) {
        return false
    }
    is_var_named(p, held.a, off, len)
}

// Whether every arm of a match consumes the value. A match with no default arm
// leaves a path that runs none of them, so it cannot guarantee consumption.
match_arms_consume :: fn(mut p: Parser, cases: i64, off: i64, len: i64) -> bool {
    mut has_default : bool = false
    mut cid := cases
    while (cid != (-1)) {
        cnode := arena_at(p.arena, cid)
        if (cnode.c == 1) {
            has_default = true
        }
        if (consumes_value(p, cnode.a, off, len) == false) {
            return false
        }
        cid = cnode.next
    }
    has_default
}

// The match a statement is, or -1. A match written as a statement is one, and
// so is a match a body answers with, which is an expression statement holding
// one.
match_in :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Match) {
        return id
    }
    if (node.kind == NodeKind::ExprStmt || node.kind == NodeKind::Return) {
        inner := node.a
        if (inner == (-1)) {
            return -1
        }
        held := arena_at(p.arena, inner)
        if (held.kind == NodeKind::Match) {
            return inner
        }
    }
    -1
}

// Whether a block consumes the value on every path through it. `break` and
// `continue` leave the block a loop body is, so they are paths out of it; at
// the top of a function body there are none to meet.
consumes_value :: fn(mut p: Parser, head: i64, off: i64, len: i64) -> bool {
    consumes_block(p, head, off, len, true)
}

// A block consumes on every path when a statement in it consumes before
// anything leaves. Reading only for a consuming statement took the first one it
// found for the whole answer, so a `return` written above it read as though the
// path through that return went on to consume.
//
// `loops` is whether `break` and `continue` leave *this* block. They bind to
// the nearest enclosing loop, so inside a loop written further in they do not.
consumes_block :: fn(mut p: Parser, head: i64, off: i64, len: i64,
    loops: bool) -> bool {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (stmt_consumes_all(p, id, off, len, loops)) {
            return true
        }
        if (exits_without(p, id, off, len, loops)) {
            return false
        }
        id = next_id
    }
    false
}

// Whether one statement consumes the value on every path through itself: it
// hands it on outright, or it is an `if` whose branches both do, or a `match`
// whose arms all do.
stmt_consumes_all :: fn(mut p: Parser, id: i64, off: i64, len: i64,
    loops: bool) -> bool {
    if (stmt_consumes(p, id, off, len)) {
        return true
    }
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::If && node.val != (-1)
        && consumes_block(p, node.b, off, len, loops)
        && consumes_block(p, node.val, off, len, loops)) {
        return true
    }
    // Taking a value apart is consuming it: every arm names what it held,
    // and what an arm does with those is the arm's own obligation. The
    // match is reached through the statement holding it, which is an
    // expression statement when it is what the body answers with.
    held := match_in(p, id)
    if (held != (-1)) {
        mnode := arena_at(p.arena, held)
        cases := mnode.b
        if (match_subject_is(p, held, off, len)) {
            return true
        }
        if (match_arms_consume(p, cases, off, len)) {
            return true
        }
    }
    false
}

// Whether a statement has a path that leaves the block it sits in with the
// value still held. Everything written after such a statement is off that path,
// so a consumption down there is not on every one.
exits_without :: fn(mut p: Parser, id: i64, off: i64, len: i64,
    loops: bool) -> bool {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Return) {
        return true
    }
    if (loops && (kind == NodeKind::Break || kind == NodeKind::Continue)) {
        return true
    }
    if (kind == NodeKind::If) {
        return branch_exits_without(p, node.b, off, len, loops)
            || branch_exits_without(p, node.val, off, len, loops)
    }
    if (kind == NodeKind::With) {
        return branch_exits_without(p, node.a, off, len, loops)
    }
    // A `break` written inside this loop leaves the loop, not the block the
    // loop sits in, so only a `return` reaches past it.
    if (kind == NodeKind::While) {
        return branch_exits_without(p, node.b, off, len, false)
    }
    held := match_in(p, id)
    if (held != (-1)) {
        mnode := arena_at(p.arena, held)
        mut cid := mnode.b
        while (cid != (-1)) {
            cnode := arena_at(p.arena, cid)
            body := cnode.a
            next_case := cnode.next
            if (branch_exits_without(p, body, off, len, loops)) {
                return true
            }
            cid = next_case
        }
    }
    false
}

// The same question of a block written inside a statement: does a path through
// it leave the enclosing block with the value still held. A consumption reached
// first discharges the obligation, so what follows it is no longer a leak.
branch_exits_without :: fn(mut p: Parser, head: i64, off: i64, len: i64,
    loops: bool) -> bool {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (stmt_consumes_all(p, id, off, len, loops)) {
            return false
        }
        if (exits_without(p, id, off, len, loops)) {
            return true
        }
        id = next_id
    }
    false
}

// `answers` is whether the last statement of this list is the value the
// enclosing function hands back, which is true only when that function's own
// return type holds a resource. A trailing expression is the return value, so a
// call in that position is consumed by the caller rather than dropped here.
check_linear_locals :: fn(mut p: Parser, head: i64, answers: bool) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        last := node.next == (-1)
        // A call whose answer holds a resource, made as a statement, drops what
        // it answered with. Naming the value is what gives anything the chance
        // to consume it.
        if (kind == NodeKind::ExprStmt && node.a != (-1)
            && (answers && last) == false) {
            value := arena_at(p.arena, node.a)
            value_kind := value.kind
            callee := value.val
            named_at := value.c
            if (value_kind == NodeKind::Call && callee >= 0
                && callee < p.fns.count) {
                sym := arena_at(p.fns, callee)
                if (is_linear_type(p, sym.ret_type)) {
                    report_where(p.modules, p.src, named_at)
                    report("this call answers with a value that has to be consumed, and nothing here consumes it")
                    frost_rt_die()
                }
            }
        }
        if (kind == NodeKind::Let) {
            mut ty := node.b
            if (ty == (-1)) {
                ty = type_of(p, node.a)
            }
            if (is_linear_type(p, ty)
                && consumes_value(p, node.next, node.val, node.c) == false) {
                report_where(p.modules, p.src, node.val)
                report("linear value '")
                report_src(p.src, node.val, node.c)
                report("' is never consumed")
                frost_rt_die()
            }
        }
        // A block in trailing position answers with whatever its own last
        // statement answers with, so the obligation carries into it. A loop
        // body never answers.
        if (kind == NodeKind::If) {
            check_linear_locals(p, node.b, answers && last)
            check_linear_locals(p, node.val, answers && last)
        }
        if (kind == NodeKind::While) {
            check_linear_locals(p, node.b, false)
        }
        if (kind == NodeKind::With) {
            check_linear_locals(p, node.a, answers && last)
        }
        id = node.next
    }
}

// The use-after-move check, flow-aware. A value handed by move to a call is
// gone from the caller, so a later read of it reads storage that was given away.
// The old check accumulated moves as the code was emitted, so a move in one arm
// of an `if` was seen while the other arm was walked, and a value consumed in
// both arms read as used-after-move in the second. This walks the tree instead,
// tracking the moved set with a union at every branch, so what a branch moved is
// known only after both are joined. The moved set is p.moved, reset per function.

// The place already given away that shares storage with this one, or -1. Two
// places are the same storage when they overlap rather than when they read
// alike, which is the question the exclusivity check asks of a call's borrows.
place_is_moved :: fn(mut p: Parser, id: i64) -> i64 {
    if (id < 0) {
        return -1
    }
    mut i : i64 = 0
    while (i < p.moved.count) {
        entry := arena_at(p.moved, i)
        held := entry.slot
        if (held >= 0 && places_overlap(p, held, id)) {
            return held
        }
        i = i + 1
    }
    -1
}

// Whether two places are definitely the same storage, step for step.
//
// Not `places_equal`, which answers whether they may be: an index nothing knows
// the value of is neither definitely together nor definitely apart, and a
// dereference through a raw pointer is the same. Which of the three answers a
// caller wants depends on what it does with it, so the two are asked separately.
places_same :: fn(mut p: Parser, a: i64, b: i64) -> bool {
    na := arena_at(p.arena, a)
    nb := arena_at(p.arena, b)
    kind := na.kind
    if (kind != nb.kind) {
        return false
    }
    if (kind == NodeKind::Var) {
        return na.c == nb.c && bytes_equal(p.src, na.val, nb.val, na.c)
    }
    if (kind == NodeKind::Field) {
        if (na.c != nb.c) {
            return false
        }
        if (bytes_equal(p.src, na.val, nb.val, na.c) == false) {
            return false
        }
        return places_same(p, na.a, nb.a)
    }
    if (kind == NodeKind::Index) {
        ia := arena_at(p.arena, na.b)
        ib := arena_at(p.arena, nb.b)
        if (ia.kind != NodeKind::Num || ib.kind != NodeKind::Num) {
            return false
        }
        if (ia.val != ib.val) {
            return false
        }
        return places_same(p, na.a, nb.a)
    }
    if (kind == NodeKind::Deref) {
        // A borrow was proven where it formed. A raw pointer says nothing about
        // where it lands, so two of them are not definitely anything.
        if (na.val != 1 || nb.val != 1) {
            return false
        }
        return places_same(p, na.a, nb.a)
    }
    false
}

// Whether `outer` definitely names storage `inner` is part of: the same place, or
// one `inner` hangs off.
//
// Unknown answers no. This is what a write consults to decide what it gives
// back, and reviving on a guess is what lets a resource be consumed twice, so a
// place reached through an index nobody knows or a raw pointer is not revived.
place_covers :: fn(mut p: Parser, outer: i64, inner: i64) -> bool {
    depth_out := place_depth(p, outer)
    depth_in := place_depth(p, inner)
    if (depth_out > depth_in) {
        return false
    }
    places_same(p, outer, strip_place(p, inner, depth_in - depth_out))
}

// Whether `inner` might be part of some wider place.
//
// Unknown answers yes, which is the other way round from `place_covers` and for
// the same reason. This is what refuses a write into storage that has gone, and
// what cannot be told apart there is what has to be refused.
place_maybe_within :: fn(mut p: Parser, inner: i64, outer: i64) -> bool {
    place_depth(p, outer) <= place_depth(p, inner)
        && places_overlap(p, outer, inner)
}

// The place already given away that this one is part of, or -1. Writing into
// storage handed to someone else is not giving it back: the callee owns it and
// may have released it already.
moved_container_of :: fn(mut p: Parser, id: i64) -> i64 {
    if (id < 0) {
        return -1
    }
    mut i : i64 = 0
    while (i < p.moved.count) {
        entry := arena_at(p.moved, i)
        held := entry.slot
        if (held >= 0 && place_depth(p, held) < place_depth(p, id)
            && place_maybe_within(p, id, held)) {
            return held
        }
        i = i + 1
    }
    -1
}

// A place holds a value again, so nothing that shares its storage is gone any
// more. The entries are compacted rather than marked, since the set is a run
// whose length is what the branch walks save and restore.
revive_place :: fn(mut p: Parser, id: i64) {
    if (id < 0 || is_place_expr(p, id) == false) {
        return
    }
    mut kept : i64 = 0
    mut i : i64 = 0
    while (i < p.moved.count) {
        entry := arena_at(p.moved, i)
        held := entry.slot
        name_off := entry.name_off
        name_len := entry.name_len
        // Only what the write covers. Writing `h` gives `h.file` back, since the
        // write settles the whole of it. Writing `h.file` does not give `h` back,
        // since the rest of `h` is still wherever it went, and dropping that
        // entry let a value be consumed, written into, and consumed again.
        if (held < 0 || place_covers(p, id, held) == false) {
            mut target := arena_at(p.moved, kept)
            target.name_off = name_off
            target.name_len = name_len
            target.ty = 0
            target.slot = held
            kept = kept + 1
        }
        i = i + 1
    }
    p.moved.count = kept
}

// What a place reaches through, which is read even where the place itself is
// written: the index of `xs[i] = v`, and the base of a field or an element. -1
// for a bare name, which reaches through nothing.
place_under :: fn(mut p: Parser, id: i64) -> i64 {
    if (id < 0) {
        return -1
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        return -1
    }
    if (kind == NodeKind::Index) {
        walk_moves_expr(p, node.b)
        return place_under(p, node.a)
    }
    if (kind == NodeKind::Field || kind == NodeKind::Deref) {
        return place_under(p, node.a)
    }
    id
}

// Refuse a read of storage that has gone, naming the root it hangs off. The
// position is the place being read, since that is the line to look at.
report_if_moved :: fn(mut p: Parser, id: i64, name_off: i64, name_len: i64) {
    // While the summaries are settling the state is not final, so what would be
    // said here would be said against a half-answer. The reporting walk that
    // follows says it once the answers are in.
    if (p.moves_quiet == 1) {
        return
    }
    if (place_is_moved(p, id) < 0) {
        return
    }
    report_where(p.modules, p.src, name_off)
    report("use of moved value '")
    report_src(p.src, name_off, name_len)
    report("'")
    frost_rt_die()
}

walk_moves_expr :: fn(mut p: Parser, id: i64) {
    if (id == (-1)) {
        return
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        report_if_moved(p, id, node.val, node.c)
        return
    }
    // A field or an element is a place of its own, so it is weighed against
    // what has gone rather than only its root being weighed. Reading one field
    // after another was given away is reading different storage, and taking the
    // whole after a part is taking the same resource twice.
    if ((kind == NodeKind::Field || kind == NodeKind::Index)
        && is_place_expr(p, id)) {
        root := strip_place(p, id, place_depth(p, id))
        rnode := arena_at(p.arena, root)
        report_if_moved(p, id, rnode.val, rnode.c)
        if (kind == NodeKind::Index) {
            walk_moves_expr(p, node.b)
        }
        return
    }
    if (kind == NodeKind::Call) {
        walk_moves_call(p, node.a, node.val)
        return
    }
    if (kind == NodeKind::Bin || kind == NodeKind::Index || kind == NodeKind::SliceFrom) {
        walk_moves_expr(p, node.a)
        walk_moves_expr(p, node.b)
        return
    }
    if (kind == NodeKind::Field || kind == NodeKind::Deref || kind == NodeKind::AddrOf
        || kind == NodeKind::Ref || kind == NodeKind::PtrCast || kind == NodeKind::SliceLen
        || kind == NodeKind::Assert) {
        walk_moves_expr(p, node.a)
        return
    }
    if (kind == NodeKind::StructLit || kind == NodeKind::ArrayLit) {
        mut child := node.a
        while (child != (-1)) {
            cnode := arena_at(p.arena, child)
            walk_moves_expr(p, cnode.a)
            child = cnode.next
        }
    }
}

// An argument is read before it is moved, so the uses inside every argument are
// checked first, then the values a by-value parameter takes are marked moved.
// The run of field names from a place down to the name it is rooted in, pushed
// root first. Answers false for a place reached any other way, having pushed
// nothing the caller has to keep.
//
// Fields only. An element is reached by a number worked out while the program
// runs, so the place a caller would have to be told about is one neither side
// can name, and a container releasing its elements one at a time is the shape
// that would be refused for it. Leaving those out is this rule declining to
// answer rather than answering wrong.
push_field_chain :: fn(mut p: Parser, place: i64) -> bool {
    node := arena_at(p.arena, place)
    kind := node.kind
    base := node.a
    name_off := node.val
    name_len := node.c
    if (kind == NodeKind::Var) {
        return true
    }
    if (kind != NodeKind::Field) {
        return false
    }
    if (push_field_chain(p, base) == false) {
        return false
    }
    arena_push(p.summary_steps,
        SummaryStep { name_off = name_off, name_len = name_len })
    true
}

// Whether this run of field names is already recorded for this parameter, so a
// round that learns nothing new leaves the table alone and the fixpoint closes.
summary_known :: fn(mut p: Parser, fn_index: i64, param: i64, start: i64,
    count: i64) -> bool {
    mut i : i64 = 0
    while (i < p.summaries.count) {
        entry := arena_at(p.summaries, i)
        held_fn := entry.fn_index
        held_param := entry.param
        held_start := entry.step_start
        held_count := entry.step_count
        if (held_fn == fn_index && held_param == param
            && held_count == count) {
            mut k : i64 = 0
            mut same := true
            while (k < count) {
                mine := arena_at(p.summary_steps, start + k)
                mine_off := mine.name_off
                mine_len := mine.name_len
                theirs := arena_at(p.summary_steps, held_start + k)
                if (theirs.name_len != mine_len
                    || bytes_equal(p.src, theirs.name_off, mine_off,
                        mine_len) == false) {
                    same = false
                }
                k = k + 1
            }
            if (same) {
                return true
            }
        }
        i = i + 1
    }
    false
}

// What this function gave away that belonged to a parameter it only borrows,
// which is exactly what its callers cannot see for themselves. A parameter
// taken by value is not one of these: the call site already reads the
// declaration and marks the whole argument gone.
note_summaries :: fn(mut p: Parser, fn_index: i64, params: i64) {
    mut index : i64 = 0
    mut param := params
    while (param != (-1)) {
        pnode := arena_at(p.arena, param)
        borrows := pnode.a
        pname_off := pnode.val
        pname_len := pnode.c
        next_param := pnode.next
        if (borrows == 1) {
            mut i : i64 = 0
            while (i < p.moved.count) {
                entry := arena_at(p.moved, i)
                place := entry.slot
                if (place >= 0) {
                    root := strip_place(p, place, place_depth(p, place))
                    rnode := arena_at(p.arena, root)
                    root_off := rnode.val
                    root_len := rnode.c
                    if (rnode.kind == NodeKind::Var && root_len == pname_len
                        && bytes_equal(p.src, root_off, pname_off, pname_len)
                        && place != root) {
                        start := p.summary_steps.count
                        if (push_field_chain(p, place)) {
                            count := p.summary_steps.count - start
                            if (count > 0
                                && summary_known(p, fn_index, index, start,
                                    count) == false) {
                                arena_push(p.summaries,
                                    Summary { fn_index = fn_index,
                                        param = index, step_start = start,
                                        step_count = count })
                            } else {
                                p.summary_steps.count = start
                            }
                        } else {
                            p.summary_steps.count = start
                        }
                    }
                }
                i = i + 1
            }
        }
        index = index + 1
        param = next_param
    }
}

// What the callee did to the resources it was lent, read against the places the
// caller wrote. `once(h)` where `once` gives away its parameter's `.file` gives
// up `h.file` here, so a second `once(h)` names storage that is already gone.
//
// The argument as written is deliberate. A loop that binds each element of a
// container by `ref` and releases it hands over a name it rebinds every turn,
// and rebinding gives that name back, so releasing a container's elements one at
// a time stays what it always was.
apply_summaries :: fn(mut p: Parser, args: i64, fn_index: i64) {
    mut i : i64 = 0
    while (i < p.summaries.count) {
        entry := arena_at(p.summaries, i)
        held_fn := entry.fn_index
        param := entry.param
        start := entry.step_start
        count := entry.step_count
        if (held_fn == fn_index) {
            arg := nth_value_arg(p, args, param)
            if (arg != (-1) && is_place_expr(p, arg)) {
                mut place := arg
                mut k : i64 = 0
                while (k < count) {
                    step := arena_at(p.summary_steps, start + k)
                    step_off := step.name_off
                    step_len := step.name_len
                    place = new_field_node(p, place, step_off, step_len)
                    k = k + 1
                }
                root := strip_place(p, arg, place_depth(p, arg))
                rnode := arena_at(p.arena, root)
                root_off := rnode.val
                root_len := rnode.c
                report_if_moved(p, place, root_off, root_len)
                arena_push(p.moved,
                    LocalVar { name_off = root_off, name_len = root_len,
                        ty = 0, slot = place })
            }
        }
        i = i + 1
    }
}

walk_moves_call :: fn(mut p: Parser, args: i64, fn_index: i64) {
    mut id := args
    while (id != (-1)) {
        anode := arena_at(p.arena, id)
        walk_moves_expr(p, anode.a)
        id = anode.next
    }
    apply_summaries(p, args, fn_index)
    sym := arena_at(p.fns, fn_index)
    params := sym.params
    count := count_value_args(p, args)
    mut i : i64 = 0
    while (i < count) {
        arg := nth_value_arg(p, args, i)
        param := nth_param_node(p, params, i)
        if (param != (-1)) {
            pnode := arena_at(p.arena, param)
            anode := arena_at(p.arena, arg)
            // The parameter's mode says whether it takes the value rather than
            // borrows it, and its type says whether taking it leaves anything
            // behind: a scalar is copied, so moving one takes nothing from the
            // caller.
            //
            // A generic's parameter type cannot be read that way. Its written
            // type is the template's own name, and what the node records is
            // whatever instantiation was made last, so `map_put($i64, m, k, n)`
            // read as a move of a struct and left `n` unusable after it. What
            // the call binds the template to is the type argument written at the
            // call, which is what this asks for instead. Inside the template
            // itself nothing is bound yet, and the specializations are walked on
            // their own, so an unresolved one is left alone.
            mut ptype := pnode.b
            if (generic_fn_of(p, fn_index) >= 0
                && (is_aggregate(pnode.b) || pnode.b == TY_PARAM)) {
                ptype = call_type_args(p, args, generic_fn_of(p, fn_index))
                if (ptype < 0 || ptype == TY_PARAM) {
                    ptype = TY_VOID
                }
            }
            if (pnode.a != 1 && anode.kind == NodeKind::Var
                && is_aggregate(ptype)) {
                arena_push(p.moved,
                    LocalVar { name_off = anode.val, name_len = anode.c,
                        ty = 0, slot = arg })
            } else if (pnode.a != 1 && is_linear_type(p, ptype)
                && is_place_expr(p, arg)) {
                // A resource reached through a field or an element is a place of
                // its own. What holds it is not given away, so the name alone
                // says nothing, and only the place says which storage went.
                // Recorded for a resource rather than for every aggregate,
                // since reading a plain struct out of a field is a copy the
                // language has always taken.
                root := strip_place(p, arg, place_depth(p, arg))
                rnode := arena_at(p.arena, root)
                arena_push(p.moved,
                    LocalVar { name_off = rnode.val, name_len = rnode.c,
                        ty = 0, slot = arg })
            }
        }
        i = i + 1
    }
}

// Whether control leaves a block rather than falling out of its end. A `return`
// is the only way in this compiler's own subset, and what it means for the walk
// below is that the arm's moves belong to a path that never reaches the code
// after the `if`.
block_diverges :: fn(mut p: Parser, head: i64) -> bool {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (node.kind == NodeKind::Return) {
            return true
        }
        id = next_id
    }
    false
}

// Walk both arms of an `if` from the state before it, then join: a value is
// moved after the `if` if an arm that falls through moved it. An arm that
// returns takes its moves with it, since control never arrives after the `if`
// from there, which is what lets a value be consumed on an early-return path
// and still be live below. The arm moves are stacked on move_scratch, so a
// nested branch's own scratch use does not disturb this one.
walk_moves_if :: fn(mut p: Parser, then_head: i64, else_head: i64) {
    base := p.moved.count
    then_gone := block_diverges(p, then_head)
    else_gone := block_diverges(p, else_head)
    walk_moves_block(p, then_head)
    scratch_base := p.move_scratch.count
    mut k := base
    while (k < p.moved.count) {
        e := arena_at(p.moved, k)
        if (then_gone == false) {
            arena_push(p.move_scratch,
                LocalVar { name_off = e.name_off, name_len = e.name_len,
                    ty = 0, slot = e.slot })
        }
        k = k + 1
    }
    scratch_top := p.move_scratch.count
    p.moved.count = base
    walk_moves_block(p, else_head)
    if (else_gone) {
        p.moved.count = base
    }
    mut s := scratch_base
    while (s < scratch_top) {
        e := arena_at(p.move_scratch, s)
        held := e.slot
        if (place_is_moved(p, held) < 0) {
            arena_push(p.moved,
                LocalVar { name_off = e.name_off, name_len = e.name_len,
                    ty = 0, slot = held })
        }
        s = s + 1
    }
    p.move_scratch.count = scratch_base
}

// The names a block binds, including the ones its branches and nested loops
// bind, gathered onto the scratch stack. A loop needs these to tell a value it
// binds fresh every iteration from one it took from outside itself.
collect_bound_names :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        if (kind == NodeKind::Let) {
            arena_push(p.move_scratch,
                LocalVar { name_off = node.val, name_len = node.c, ty = 0, slot = 0 })
        }
        if (kind == NodeKind::If) {
            collect_bound_names(p, node.b)
            collect_bound_names(p, node.val)
        }
        if (kind == NodeKind::While) {
            collect_bound_names(p, node.b)
        }
        if (kind == NodeKind::With) {
            collect_bound_names(p, node.a)
        }
        if (kind == NodeKind::Match) {
            mut cid := node.b
            while (cid != (-1)) {
                cnode := arena_at(p.arena, cid)
                collect_bound_names(p, cnode.a)
                cid = cnode.next
            }
        }
        id = node.next
    }
}

in_scratch_range :: fn(mut p: Parser, base: i64, top: i64, off: i64, len: i64) -> bool {
    mut i := base
    while (i < top) {
        e := arena_at(p.move_scratch, i)
        if (e.name_len == len && bytes_equal(p.src, e.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// A value a loop takes from outside itself is gone on the second iteration, so
// moving one is the error rather than the read that follows it. A value the body
// binds is a different value every iteration, so moving that is ordinary: the
// body is walked once and what it moved is sorted into those two cases. Walking
// the body a second time instead reported the fresh binding as a use after move,
// which is what a struct-returning call held in a temporary inside a loop is.
walk_moves_while :: fn(mut p: Parser, body: i64) {
    base := p.moved.count
    scratch_base := p.move_scratch.count
    collect_bound_names(p, body)
    scratch_top := p.move_scratch.count
    walk_moves_block(p, body)
    mut k := base
    while (k < p.moved.count) {
        e := arena_at(p.moved, k)
        if (in_scratch_range(p, scratch_base, scratch_top, e.name_off, e.name_len) == false) {
            report_where(p.modules, p.src, e.name_off)
            report("value '")
            report_src(p.src, e.name_off, e.name_len)
            report("' is moved inside a loop; it would be used after move on a later iteration")
            frost_rt_die()
        }
        k = k + 1
    }
    p.moved.count = base
    p.move_scratch.count = scratch_base
}

// The type of a place whose root is a parameter, worked out from the
// declaration. This walk runs before the locals are recorded, so a field read
// has nothing else to type it against, and a parameter's declared type is
// concrete in an instance where the template's own is a name standing for
// anything. Answers -1 where the place is rooted anywhere else.
param_place_type :: fn(mut p: Parser, place: i64, params: i64) -> i64 {
    if (place == (-1)) {
        return -1
    }
    node := arena_at(p.arena, place)
    kind := node.kind
    base := node.a
    name_off := node.val
    name_len := node.c
    if (kind == NodeKind::Var) {
        mut id := params
        while (id != (-1)) {
            pnode := arena_at(p.arena, id)
            pname_off := pnode.val
            pname_len := pnode.c
            pty := pnode.b
            next_param := pnode.next
            if (pname_len == name_len
                && bytes_equal(p.src, pname_off, name_off, name_len)) {
                if (is_pointer(pty)) {
                    return pointee(pty)
                }
                return pty
            }
            id = next_param
        }
        return -1
    }
    if (kind == NodeKind::Field) {
        held := param_place_type(p, base, params)
        if (held < 0) {
            return -1
        }
        // A generic's own entry holds whatever its last instantiation left in
        // it, so a field read off the template says nothing about the body
        // being walked. Only an instantiation, or a struct that was never
        // generic, answers for itself.
        mut owner := held
        if (is_pointer(owner)) {
            owner = pointee(owner)
        }
        if (is_struct_ty(owner)) {
            def := arena_at(p.structs, struct_index_of(owner))
            if (def.is_generic == 1) {
                return -1
            }
        }
        return field_type(p, held, name_off, name_len)
    }
    if (kind == NodeKind::Index) {
        held := param_place_type(p, base, params)
        if (held < 0 || is_array_ty(held) == false) {
            return -1
        }
        return array_element(p, held)
    }
    -1
}

// A place of resource type given to the caller is gone from here, the same as
// one handed to a call that takes it. Reading it and reading nothing else is
// how a function hands out what it was only lent.
note_handed_out :: fn(mut p: Parser, value: i64) {
    if (value == (-1) || is_place_expr(p, value) == false) {
        return
    }
    // What the place itself is, where it is rooted in a parameter, since an
    // instance's parameter carries a real type where the function it was made
    // from answers with a name standing for anything. What the function was
    // declared to answer with covers the rest.
    held := param_place_type(p, value, p.moves_params)
    mut resource := p.moves_answers == 1
    if (held >= 0) {
        resource = is_linear_type(p, held)
    }
    if (resource == false) {
        return
    }
    root := strip_place(p, value, place_depth(p, value))
    rnode := arena_at(p.arena, root)
    root_off := rnode.val
    root_len := rnode.c
    arena_push(p.moved,
        LocalVar { name_off = root_off, name_len = root_len, ty = 0,
            slot = value })
}

// A body, and the value it answers with. The last statement is that value when
// it is an expression: the emitters are what turn the last one into a return,
// so nothing before them has marked it as one.
walk_moves_body :: fn(mut p: Parser, body: i64, params: i64, answers: bool) {
    saved := p.moves_answers
    saved_params := p.moves_params
    p.moves_params = params
    p.moves_answers = 0
    if (answers) {
        p.moves_answers = 1
    }
    walk_moves_block(p, body)
    mut id := body
    mut last : i64 = -1
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        last = id
        id = node.next
    }
    if (last != (-1)) {
        node := arena_at(p.arena, last)
        if (node.kind == NodeKind::ExprStmt) {
            note_handed_out(p, node.a)
        }
    }
    p.moves_answers = saved
    p.moves_params = saved_params
}

// Whether a call anywhere in the program asked for this instance.
//
// Two things make one. A call names its callee, and the tuple it leaves carries
// that generic as its owner. A generic *struct* written with an argument leaves
// a tuple owned by nothing, and that one is offered to every generic function
// there is, so `Vec<Table>` alone brings `vec_get<Table>` into being with
// nothing calling it. An instance nobody calls hands nothing to anybody, so a
// rule about what a caller is told has nothing to say about it.
//
// Answered only where a rule is about to complain, since it walks two tables.
instance_was_called :: fn(mut p: Parser, node_id: i64) -> bool {
    mut i : i64 = 0
    while (i < p.mono_nodes.count) {
        held := arena_at(p.mono_nodes, i)
        if (held.node == node_id) {
            owner := held.gfn_index
            arg := held.arg
            xstart := held.xarg_start
            xcount := held.xarg_count
            mut k : i64 = 0
            while (k < p.type_args.count) {
                used := arena_at(p.type_args, k)
                if (used.owner == owner && used.arg == arg
                    && used.xarg_count == xcount
                    && gargs_equal(p, used.xarg_start, xstart, xcount)) {
                    return true
                }
                k = k + 1
            }
            return false
        }
        i = i + 1
    }
    false
}

// A resource given away out of a borrowed parameter by a place no summary can
// name, which is the one shape the count cannot be made to cross a call.
//
// `vec_get` is the example: it answers with `v.storage[index]`, so the caller
// is handed a resource out of a container it still believes untouched, and
// asking twice hands the same one out twice.
//
// Refused rather than approximated. A summary saying "some element of this
// went" is the whole container as far as a caller can act on it, and that would
// refuse a container releasing its own elements one at a time, which is how
// resources in containers are written.
report_unnameable :: fn(mut p: Parser, params: i64, fn_index: i64,
    node_id: i64) {
    // A template's own body is walked with nothing bound, so it is left to its
    // instances to answer for. Asked only where a candidate was found, since
    // that is rare and this walks every instance the program made.
    mut param := params
    while (param != (-1)) {
        pnode := arena_at(p.arena, param)
        borrows := pnode.a
        pname_off := pnode.val
        pname_len := pnode.c
        next_param := pnode.next
        if (borrows == 1) {
            mut i : i64 = 0
            while (i < p.moved.count) {
                entry := arena_at(p.moved, i)
                place := entry.slot
                if (place >= 0) {
                    root := strip_place(p, place, place_depth(p, place))
                    rnode := arena_at(p.arena, root)
                    root_off := rnode.val
                    root_len := rnode.c
                    if (rnode.kind == NodeKind::Var && root_len == pname_len
                        && bytes_equal(p.src, root_off, pname_off, pname_len)
                        && place != root) {
                        mark := p.summary_steps.count
                        nameable := push_field_chain(p, place)
                        p.summary_steps.count = mark
                        mut answerable := true
                        if (generic_fn_of(p, fn_index) >= 0) {
                            answerable = instance_was_called(p, node_id)
                        }
                        if (nameable == false && answerable) {
                            report_where(p.modules, p.src, root_off)
                            report("this gives away a resource out of '")
                            report_src(p.src, pname_off, pname_len)
                            report("', which it only borrows, and names it by an element rather than by a field. A caller cannot be told which element went, so nothing stops it asking again and being handed the same one twice. Reach the element through a borrow that stays a borrow, or take it by `move` and answer with it")
                            frost_rt_die()
                        }
                    }
                }
                i = i + 1
            }
        }
        param = next_param
    }
}

walk_moves_block :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        if (kind == NodeKind::Let || kind == NodeKind::Print || kind == NodeKind::ExprStmt
            || kind == NodeKind::Return) {
            walk_moves_expr(p, node.a)
        }
        if (kind == NodeKind::Return) {
            note_handed_out(p, node.a)
        }
        if (kind == NodeKind::Assign) {
            walk_moves_expr(p, node.b)
            // The target is written, not read. Putting a value into a place is
            // what makes it hold one again, so a place given away and then
            // assigned is live: `vec_free($Table, world.tables)` followed by
            // `world.tables = kept` is a container replacing what it released.
            // Whatever the target reaches through is still a read, and a target
            // inside something already given away is not a write anyone may
            // make.
            container := moved_container_of(p, node.a)
            if (container >= 0) {
                root := strip_place(p, container, place_depth(p, container))
                rnode := arena_at(p.arena, root)
                report_where(p.modules, p.src, rnode.val)
                report("use of moved value '")
                report_src(p.src, rnode.val, rnode.c)
                report("'")
                frost_rt_die()
            }
            revive_place(p, node.a)
            walk_moves_expr(p, place_under(p, node.a))
        }
        if (kind == NodeKind::If) {
            walk_moves_expr(p, node.a)
            walk_moves_if(p, node.b, node.val)
        }
        if (kind == NodeKind::While) {
            walk_moves_expr(p, node.a)
            walk_moves_while(p, node.b)
        }
        if (kind == NodeKind::With) {
            walk_moves_block(p, node.a)
        }
        if (kind == NodeKind::Match) {
            walk_moves_expr(p, node.a)
            walk_moves_match(p, node.b)
        }
        id = node.next
    }
}

// Each arm of a match runs from the state before it, and a value is moved after
// the match if any arm moved it, the same join an `if` makes.
walk_moves_match :: fn(mut p: Parser, cases: i64) {
    base := p.moved.count
    scratch_base := p.move_scratch.count
    mut cid := cases
    while (cid != (-1)) {
        cnode := arena_at(p.arena, cid)
        p.moved.count = base
        walk_moves_block(p, cnode.a)
        mut k := base
        while (k < p.moved.count) {
            e := arena_at(p.moved, k)
            if (in_scratch(p, scratch_base, e.name_off, e.name_len) == false) {
                arena_push(p.move_scratch,
                    LocalVar { name_off = e.name_off, name_len = e.name_len, ty = 0, slot = 0 })
            }
            k = k + 1
        }
        cid = cnode.next
    }
    p.moved.count = base
    mut s := scratch_base
    while (s < p.move_scratch.count) {
        e := arena_at(p.move_scratch, s)
        arena_push(p.moved,
            LocalVar { name_off = e.name_off, name_len = e.name_len, ty = 0, slot = 0 })
        s = s + 1
    }
    p.move_scratch.count = scratch_base
}

in_scratch :: fn(mut p: Parser, base: i64, off: i64, len: i64) -> bool {
    mut i := base
    while (i < p.move_scratch.count) {
        e := arena_at(p.move_scratch, i)
        if (e.name_len == len && bytes_equal(p.src, e.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// Whether the program declares a resource at all. Everything the summaries do
// is about resources, so a program with none pays nothing for them, which is
// the bargain the rest of the linear machinery strikes too.
program_has_resources :: fn(mut p: Parser) -> bool {
    mut i : i64 = 0
    while (i < p.structs.count) {
        def := arena_at(p.structs, i)
        if (def.is_linear == 1) {
            return true
        }
        i = i + 1
    }
    false
}

// Work out what every function does to what it is lent, until a round learns
// nothing new. A round rather than a pass, because what one function gives away
// depends on what the functions it calls give away, and the table only grows,
// so this settles.
settle_summaries :: fn(mut p: Parser) {
    if (program_has_resources(p) == false) {
        return
    }
    p.moves_quiet = 1
    mut known : i64 = -1
    while (known != p.summaries.count) {
        known = p.summaries.count
        mut i : i64 = 0
        while (i < p.arena.count) {
            node := arena_at(p.arena, i)
            kind := node.kind
            body := node.a
            params := node.b
            fn_index := node.val
            if (kind == NodeKind::Func) {
                mut answers : bool = false
                if (fn_index >= 0 && fn_index < p.fns.count) {
                    sym := arena_at(p.fns, fn_index)
                    answers = is_linear_type(p, sym.ret_type)
                }
                p.moved.count = 0
                walk_moves_body(p, body, params, answers)
                note_summaries(p, fn_index, params)
            }
            i = i + 1
        }
    }
    p.moves_quiet = 0
}

check_moves :: fn(mut p: Parser) {
    settle_summaries(p)
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        if (node.kind == NodeKind::Func) {
            fn_index := node.val
            mut answers : bool = false
            if (fn_index >= 0 && fn_index < p.fns.count) {
                sym := arena_at(p.fns, fn_index)
                answers = is_linear_type(p, sym.ret_type)
            }
            check_linear_locals(p, node.a, answers)
            p.moved.count = 0
            walk_moves_body(p, node.a, node.b, answers)
            report_unnameable(p, node.b, fn_index, i)
        }
        i = i + 1
    }
}

// The parameter node the nth value argument lands in, walking past the ones a
// type argument erases. The capability a `uses` function draws is a trailing
// parameter with no value argument, so it is never reached.
nth_param_node :: fn(mut p: Parser, params: i64, n: i64) -> i64 {
    mut id := params
    mut index : i64 = 0
    while (id != (-1)) {
        if (index == n) {
            return id
        }
        node := arena_at(p.arena, id)
        index = index + 1
        id = node.next
    }
    -1
}

is_mut_param :: fn(mut p: Parser, param_node: i64) -> bool {
    mut i : i64 = 0
    while (i < p.mut_params.count) {
        entry := arena_at(p.mut_params, i)
        if (entry.name_off == param_node) {
            return true
        }
        i = i + 1
    }
    false
}

// Whether an expression is a place the check can reason about: a variable and
// the fields, indexes and dereferences off it. A call or a literal is not one
// and cannot alias.
is_place_expr :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        return true
    }
    if (kind == NodeKind::Field || kind == NodeKind::Index || kind == NodeKind::Deref) {
        return is_place_expr(p, node.a)
    }
    false
}

// How many fields, indexes or dereferences a place puts between a root variable
// and the storage it names. A bare variable is 0.
place_depth :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Field || kind == NodeKind::Index || kind == NodeKind::Deref) {
        return 1 + place_depth(p, node.a)
    }
    0
}

// Strip `n` outer segments off a place, so two of unequal depth can be compared
// at the depth of the shorter.
strip_place :: fn(mut p: Parser, id: i64, n: i64) -> i64 {
    if (n == 0) {
        return id
    }
    node := arena_at(p.arena, id)
    strip_place(p, node.a, n - 1)
}

// Whether two index expressions could name the same element.
//
// Two numbers are apart when the numbers differ, and that is the whole of what
// can be settled without running the program. Anything else is one element until
// shown otherwise: `xs[i]` and `xs[j]` are the same slot whenever `i == j`, and
// answering that they are apart let two `mut` borrows of one element through,
// which is the aliasing this check exists to refuse.
index_overlaps :: fn(mut p: Parser, a: i64, b: i64) -> bool {
    if (a == (-1) || b == (-1)) {
        return true
    }
    na := arena_at(p.arena, a)
    nb := arena_at(p.arena, b)
    if (na.kind == NodeKind::Num && nb.kind == NodeKind::Num) {
        return na.val == nb.val
    }
    true
}

places_equal :: fn(mut p: Parser, a: i64, b: i64) -> bool {
    na := arena_at(p.arena, a)
    nb := arena_at(p.arena, b)
    kind := na.kind
    if (kind != nb.kind) {
        return false
    }
    if (kind == NodeKind::Var) {
        return na.c == nb.c && bytes_equal(p.src, na.val, nb.val, na.c)
    }
    if (kind == NodeKind::Field) {
        if (na.c != nb.c) {
            return false
        }
        if (bytes_equal(p.src, na.val, nb.val, na.c) == false) {
            return false
        }
        return places_equal(p, na.a, nb.a)
    }
    if (kind == NodeKind::Index) {
        return places_equal(p, na.a, nb.a) && index_overlaps(p, na.b, nb.b)
    }
    if (kind == NodeKind::Deref) {
        return places_equal(p, na.a, nb.a)
    }
    false
}

// Whether a place reaches storage through a raw pointer at any point.
//
// The parser marks a read through a borrow where it makes the node, which is the
// same answer the unsafety gate reads, so the two checks agree on what raw
// means. A `mut` scalar parameter is rewritten to `name^` and carries that mark;
// anything else reached through a `^` is a raw pointer.
place_reaches_raw :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Deref) {
        if (node.val != 1) {
            return true
        }
        return place_reaches_raw(p, node.a)
    }
    if (kind == NodeKind::Field || kind == NodeKind::Index) {
        return place_reaches_raw(p, node.a)
    }
    false
}

// Two places overlap when one contains the other: reduce the deeper to the
// shorter's depth, then they overlap exactly when they are then the same place.
//
// A raw dereference breaks the argument that comparison rests on. Every step in
// front of one says where the pointer was read from and none of them says where
// it points, so `p^` and `q^` are one place whenever `p` and `q` hold one
// address, and `p^` and `x` are one place whenever `p` holds `x`'s address. The
// names settle nothing either way, so a place reaching through a raw pointer
// overlaps whatever it is weighed against.
//
// Either side rather than both. Refusing only the pair looked like the
// affordable half of the rule, and measuring said otherwise: across the standard
// library, this compiler and the examples, the whole rule refuses nothing.
places_overlap :: fn(mut p: Parser, a: i64, b: i64) -> bool {
    if (place_reaches_raw(p, a) || place_reaches_raw(p, b)) {
        return true
    }
    mut left := a
    mut right := b
    da := place_depth(p, a)
    db := place_depth(p, b)
    if (da > db) {
        left = strip_place(p, a, da - db)
    }
    if (db > da) {
        right = strip_place(p, b, db - da)
    }
    places_equal(p, left, right)
}

// A borrowed value argument, or -1: the place it names when the parameter it
// lands in borrows by address (a `mut`, or a read of an aggregate), and nothing
// otherwise, since a scalar read is a copy and a raw pointer is a value.
arg_borrows :: fn(mut p: Parser, args: i64, params: i64, index: i64) -> i64 {
    arg := nth_value_arg(p, args, index)
    if (is_place_expr(p, arg) == false) {
        return -1
    }
    param := nth_param_node(p, params, index)
    if (param == (-1)) {
        return -1
    }
    pnode := arena_at(p.arena, param)
    if (pnode.a != 1) {
        return -1
    }
    arg
}

check_call_exclusivity :: fn(mut p: Parser, args: i64, fn_index: i64, pos: i64) {
    sym := arena_at(p.fns, fn_index)
    params := sym.params
    count := count_value_args(p, args)
    mut i : i64 = 0
    while (i < count) {
        arg_i := arg_borrows(p, args, params, i)
        if (arg_i != (-1)) {
            excl_i := is_mut_param(p, nth_param_node(p, params, i))
            mut j := i + 1
            while (j < count) {
                arg_j := arg_borrows(p, args, params, j)
                if (arg_j != (-1)) {
                    excl_j := is_mut_param(p, nth_param_node(p, params, j))
                    if ((excl_i || excl_j)
                        && places_overlap(p, arg_i, arg_j)) {
                        report_where(p.modules, p.src, pos)
                        if (excl_i && excl_j) {
                            report("two arguments are both borrowed as ")
                            report("mutable in a single call; mutable borrows ")
                            report("are exclusive")
                        } else {
                            report("an argument is borrowed as both shared ")
                            report("and mutable in a single call; mutable ")
                            report("borrows are exclusive")
                        }
                        frost_rt_die()
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// A `mut` borrow is exclusive: no other borrow in the same call may name storage
// that overlaps it, since two writers, or a writer and a reader, of one place at
// once is the aliasing a borrow is meant to rule out.
check_borrow_exclusivity :: fn(mut p: Parser) {
    mut n : i64 = 0
    while (n < p.arena.count) {
        node := arena_at(p.arena, n)
        if (node.kind == NodeKind::Call) {
            check_call_exclusivity(p, node.a, node.val, node.pos)
        }
        n = n + 1
    }
}

// A borrow may be returned, since the frame and region checks hold it to
// storage that outlives the call, but it may not be stored: a struct or an
// array that outlived the borrow would leave it pointing at freed storage with
// no check to catch it. References are second-class for storage. A raw pointer
// is not a borrow and stays allowed, which is what lets the arena keep its
// `data: ^T`.
type_contains_borrow :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_borrow(ty)) {
        return true
    }
    if (is_array_ty(ty)) {
        return type_contains_borrow(p, array_element(p, ty))
    }
    false
}

check_reference_fields :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.structs.count) {
        def := arena_at(p.structs, i)
        mut fid := def.field_head
        while (fid != (-1)) {
            field := arena_at(p.fields, fid)
            if (type_contains_borrow(p, field.ty)) {
                report_where(p.modules, p.src, def.name_off)
                report("cannot store a reference in struct '")
                report_src(p.src, def.name_off, def.name_len)
                report("' (field '")
                report_src(p.src, field.name_off, field.name_len)
                report("'); references are second-class")
                frost_rt_die()
            }
            fid = field.next
        }
        i = i + 1
    }
}

// The frame-escape check. A borrow, a pointer or a slice a function answers
// with may not name storage that dies when the call returns: a local declared
// in the function, or a value built inside it. A `ref` or `ptr_to` into an
// arena or a struct a parameter handed in is fine, since that storage outlives
// the call. One into a local is not. This is the frame counterpart of the
// region check, and together they hold every returnable borrow to storage that
// lives at least as long as it does.
//
// The two differ in where the burden sits. The region check asks whether a
// pointer is known to come from the arena and refuses it when it is. The frame
// check asks whether a view is known to come from somewhere that outlives the
// call and refuses it when it is not. Answering the permissive way for a shape
// nobody taught the walk about is what let a frame pointer out through an
// ordinary call, through a function pointer, and out of a `move` parameter: each
// of those is a shape, and a check whose soundness rests on having enumerated
// every shape is a list rather than a proof. Refusing what it cannot trace turns
// the enumeration into a question about how much honest code compiles, which is
// something a build can measure.

// Where the storage a value names comes from, as far as a walk over one function
// body can tell. The order is what a value built from several parts takes: it is
// as short-lived as its shortest part, so joining is a maximum.
//
// A view leaves the call only on PROV_OUTLIVES: storage this call did not
// create, which is a parameter, an allocation capability, a function's own name,
// or a value holding no storage at all. PROV_FRAME is storage this frame owns
// and dies with it. PROV_UNKNOWN is neither shown, and a view leaving on it is
// refused, because a walk that reads it as outliving the call is reporting what
// it recognized rather than what holds.
PROV_OUTLIVES :: 0
PROV_UNKNOWN :: 1
PROV_FRAME :: 2

// How far the type walks below descend before answering the conservative way. A
// struct cannot hold itself by value, so nothing a program can write reaches
// this; a template whose field types are still placeholders could.
FRAME_TYPE_DEPTH :: 24

prov_max :: fn(a: i64, b: i64) -> i64 {
    if (a > b) {
        return a
    }
    b
}

// The provenance recorded against a name, or -1 when the table says nothing.
prov_listed :: fn(mut table: Arena<LocalVar>, src: str, off: i64, len: i64)
    -> i64 {
    mut i : i64 = 0
    while (i < table.count) {
        entry := arena_at(table, i)
        if (entry.name_len == len
            && bytes_equal(src, entry.name_off, off, len)) {
            return entry.slot
        }
        i = i + 1
    }
    -1
}

// Record what a name is worth, replacing whatever it was worth before. A name
// reassigned holds what it now holds, not what it held when it was declared.
note_prov :: fn(mut table: Arena<LocalVar>, src: str, off: i64, len: i64,
    held: i64) {
    mut i : i64 = 0
    while (i < table.count) {
        mut entry := arena_at(table, i)
        if (entry.name_len == len
            && bytes_equal(src, entry.name_off, off, len)) {
            entry.slot = held
            return
        }
        i = i + 1
    }
    arena_push(table, LocalVar { name_off = off, name_len = len, ty = 0,
        slot = held })
}

// The declared type recorded against a name, or -1.
type_listed :: fn(mut table: Arena<LocalVar>, src: str, off: i64, len: i64)
    -> i64 {
    mut i : i64 = 0
    while (i < table.count) {
        entry := arena_at(table, i)
        if (entry.name_len == len
            && bytes_equal(src, entry.name_off, off, len)) {
            return entry.ty
        }
        i = i + 1
    }
    -1
}

note_type :: fn(mut table: Arena<LocalVar>, src: str, off: i64, len: i64,
    ty: i64) {
    mut i : i64 = 0
    while (i < table.count) {
        mut entry := arena_at(table, i)
        if (entry.name_len == len
            && bytes_equal(src, entry.name_off, off, len)) {
            entry.ty = ty
            return
        }
        i = i + 1
    }
    arena_push(table, LocalVar { name_off = off, name_len = len, ty = ty,
        slot = 0 })
}

// Whether a value of this type is, or holds, a view of storage it does not own.
// Only such a value can carry storage out of a call, so only a function
// answering with one has to account for where that storage came from.
//
// A pointer answers yes without looking at what it points at, so the walk only
// descends through storage held inline.
type_holds_view :: fn(mut p: Parser, ty: i64, depth: i64) -> bool {
    if (depth <= 0) {
        return true
    }
    // A type the walk could not name. It might hold anything, and the answer
    // that costs nothing here is the one that asks the question.
    if (ty < 0) {
        return true
    }
    if (is_pointer(ty)) {
        return true
    }
    // A function pointer is a callable value rather than a view of storage, and
    // a compile-time argument is resolved away before it is a type. Both ride
    // above the pointer range in the same i64 space.
    if (distinct_repr(ty) >= CONST_BASE) {
        return false
    }
    if (is_array_ty(ty)) {
        if (is_slice_ty(p, ty)) {
            return true
        }
        return type_holds_view(p, array_element(p, ty), depth - 1)
    }
    if (is_struct_ty(ty)) {
        def := arena_at(p.structs, struct_index_of(ty))
        mut fid := def.field_head
        while (fid != (-1)) {
            field := arena_at(p.fields, fid)
            held := field.ty
            fid = field.next
            if (type_holds_view(p, held, depth - 1)) {
                return true
            }
        }
        return false
    }
    false
}

// Whether a type is itself a view rather than a value that holds one.
//
// The difference decides whether handing a place over takes its address.
// `-> []i64` given an array takes the array's address; `-> Options` given a
// struct copies the struct, and the pointers inside it keep pointing wherever
// they already did.
type_is_direct_view :: fn(mut p: Parser, ty: i64) -> bool {
    if (ty < 0) {
        return false
    }
    if (is_pointer(ty)) {
        return true
    }
    is_array_ty(ty) && is_slice_ty(p, ty)
}

// Whether a value of type `held` holds an `element` inline.
//
// A view points at elements of one type, and it can land inside a value only
// where that value holds one of those by value. Anything reached through a
// pointer or a slice is not that value's own storage, so the walk stops at every
// indirection.
type_holds_inline :: fn(mut p: Parser, element: i64, held: i64, depth: i64)
    -> bool {
    if (depth <= 0) {
        return true
    }
    if (element < 0 || held < 0) {
        return true
    }
    // A generic that is not yet substituted stands for whatever it will be.
    if (element == TY_PARAM || held == TY_PARAM) {
        return true
    }
    if (element == held) {
        return true
    }
    if (is_array_ty(held)) {
        if (is_slice_ty(p, held)) {
            return false
        }
        return type_holds_inline(p, element, array_element(p, held), depth - 1)
    }
    if (is_struct_ty(held)) {
        def := arena_at(p.structs, struct_index_of(held))
        mut fid := def.field_head
        while (fid != (-1)) {
            field := arena_at(p.fields, fid)
            ty := field.ty
            fid = field.next
            if (type_holds_inline(p, element, ty, depth - 1)) {
                return true
            }
        }
        return false
    }
    false
}

// Whether a view of the answer type could name storage held inside a value of
// the parameter type. A `[]Entity` cannot point inside a `Query` that holds no
// Entity by value, whatever address the callee was given.
view_lands_in :: fn(mut p: Parser, answer: i64, param: i64) -> bool {
    if (answer < 0) {
        return true
    }
    if (is_pointer(answer)) {
        return type_holds_inline(p, pointee(answer), param, FRAME_TYPE_DEPTH)
    }
    if (is_array_ty(answer) && is_slice_ty(p, answer)) {
        return type_holds_inline(p, array_element(p, answer), param,
            FRAME_TYPE_DEPTH)
    }
    // An aggregate holding views could hold any of them, which says nothing
    // about where they point.
    true
}

// The declared type of a place, as far as the annotations and the struct
// declarations give it. -1 says the walk cannot tell, and the rules that ask
// treat that as the answer that keeps storage in.
//
// This is read off declarations rather than out of the type pass, which runs
// after this check and whose local table belongs to whichever function it looked
// at last.
frame_place_type :: fn(mut p: Parser, id: i64) -> i64 {
    if (id == (-1)) {
        return -1
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    child := node.a
    off := node.val
    len := node.c
    if (kind == NodeKind::Var) {
        return type_listed(p.frame_types, p.src, off, len)
    }
    if (kind == NodeKind::Field) {
        base := frame_place_type(p, child)
        if (base < 0) {
            return -1
        }
        return field_type_by_range(p, base, off, len)
    }
    if (kind == NodeKind::Index) {
        base := frame_place_type(p, child)
        if (base < 0) {
            return -1
        }
        if (is_array_ty(base)) {
            return array_element(p, base)
        }
        // An array reached through a borrow indexes to its element, the same as
        // one named directly. A raw pointer indexes to what it points at. A
        // struct indexed is a slab or a columns container, whose element is a
        // question this walk does not need to answer.
        if (is_pointer(base)) {
            inner := pointee(base)
            if (is_array_ty(inner)) {
                return array_element(p, inner)
            }
            if (is_struct_ty(inner)) {
                return -1
            }
            return inner
        }
        return -1
    }
    if (kind == NodeKind::Deref) {
        base := frame_place_type(p, child)
        if (base < 0 || is_pointer(base) == false) {
            return -1
        }
        return pointee(base)
    }
    -1
}

// The type a value has, for the shapes that say so without the type pass: a
// call's return type off its symbol, a literal off itself, an address off the
// place it names. Only enough to answer the questions the rules below ask.
frame_value_type :: fn(mut p: Parser, id: i64) -> i64 {
    if (id == (-1)) {
        return -1
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    child := node.a
    val := node.val
    if (kind == NodeKind::Call) {
        sym := arena_at(p.fns, val)
        if (sym.defined == 0) {
            return -1
        }
        return sym.ret_type
    }
    if (kind == NodeKind::CallPtr) {
        callee := frame_place_type(p, child)
        if (callee < 0 || is_proc(callee) == false) {
            return -1
        }
        return proc_ret(p, callee)
    }
    if (kind == NodeKind::AddrOf) {
        held := frame_place_type(p, child)
        if (held < 0) {
            return -1
        }
        return POINTER_BASE + held
    }
    if (kind == NodeKind::Ref) {
        held := frame_place_type(p, child)
        if (held < 0) {
            return -1
        }
        return BORROW_FLAG + held
    }
    if (kind == NodeKind::PtrCast) {
        return POINTER_BASE + val
    }
    if (kind == NodeKind::SliceFrom || kind == NodeKind::Cast) {
        return val
    }
    // A literal is a `^i8` everywhere but an index into one, which is where the
    // compiler reads the bytes it already holds.
    if (kind == NodeKind::StrLit) {
        return POINTER_BASE + TY_I8
    }
    // A struct literal carries its type, not its table index.
    if (kind == NodeKind::StructLit) {
        return val
    }
    // A literal says both halves of its own type: the element from a declared
    // type when one was in force, otherwise from the first thing in it, and the
    // length from how many there are. Both halves are stored plus one, so an
    // untouched zero is "not written down".
    if (kind == NodeKind::ArrayLit) {
        mut element : i64 = -1
        if (val != 0) {
            element = val - 1
        } else if (child != (-1)) {
            first := arena_at(p.arena, child)
            element = frame_value_type(p, first.a)
        }
        if (element < 0) {
            return -1
        }
        return array_of(p, element, node.c)
    }
    // A number written as a bit of a flags type carries that type, stored plus
    // one. Every other one takes its type from where it was written.
    if (kind == NodeKind::Num) {
        if (node.b != 0) {
            return node.b - 1
        }
        return TY_I64
    }
    if (kind == NodeKind::Float) {
        return TY_F64
    }
    if (kind == NodeKind::SliceLen || kind == NodeKind::Sizeof) {
        return TY_I64
    }
    frame_place_type(p, id)
}

// Whether a name is declared at the top of a file rather than inside this call:
// a compile-time constant, a struct constant, or a function named as a value,
// which is how a table of them is filled in. None of them dies when the call
// returns.
frame_global_name :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    if (is_const(p, off, len)) {
        return true
    }
    if (value_const_node(p, off, len) >= 0) {
        return true
    }
    fn_index_of(p, off, len) >= 0
}

// What a name's value names. A local answers with whatever its binding was
// given, which is how a pointer bound here and handed back later is caught.
frame_name_prov :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    held := prov_listed(p.frame_locals, p.src, off, len)
    if (held >= 0) {
        return held
    }
    if (name_listed(p.frame_outlives, p.src, off, len)) {
        return PROV_OUTLIVES
    }
    if (name_listed(p.frame_storage, p.src, off, len)) {
        return PROV_FRAME
    }
    if (frame_global_name(p, off, len)) {
        return PROV_OUTLIVES
    }
    PROV_UNKNOWN
}

// The storage a place names. Reaching into a place stays in whatever the root
// named, and reaching through an indirection lands wherever it points, which is
// a question about a value rather than about a place.
frame_place_prov :: fn(mut p: Parser, id: i64) -> i64 {
    if (id == (-1)) {
        return PROV_OUTLIVES
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    child := node.a
    off := node.val
    len := node.c
    if (kind == NodeKind::Var) {
        // A borrow names storage somewhere else, so it answers with wherever
        // that was and not with the frame it sits in.
        held := prov_listed(p.frame_places, p.src, off, len)
        if (held >= 0) {
            return held
        }
        if (name_listed(p.frame_storage, p.src, off, len)) {
            return PROV_FRAME
        }
        if (name_listed(p.frame_outlives, p.src, off, len)) {
            return PROV_OUTLIVES
        }
        if (frame_global_name(p, off, len)) {
            return PROV_OUTLIVES
        }
        return PROV_UNKNOWN
    }
    // Indexing a fixed array stays inside the base's storage. Indexing a slice,
    // a `str` or a raw pointer lands wherever that indirection points, which is
    // a question about the base's value: `held[0]` on a `[]T` parameter names
    // the caller's block, not the slice sitting in this frame.
    if (kind == NodeKind::Index) {
        base := frame_place_type(p, child)
        if (base >= 0 && (is_pointer(base) || is_slice_ty(p, base))) {
            return frame_value_prov(p, child)
        }
        return frame_place_prov(p, child)
    }
    if (kind == NodeKind::Field || kind == NodeKind::Ref
        || kind == NodeKind::AddrOf) {
        return frame_place_prov(p, child)
    }
    if (kind == NodeKind::Deref) {
        return frame_value_prov(p, child)
    }
    // Not a place. It names no storage of its own, so it holds nothing to how
    // long a view built from it may live.
    PROV_OUTLIVES
}

// The shortest-lived of a struct-literal or array-literal list, which is what a
// value built from all of them is worth. Each item holds its value in `.a` and
// chains through `.next`.
frame_list_prov :: fn(mut p: Parser, head: i64) -> i64 {
    mut held : i64 = PROV_OUTLIVES
    mut item := head
    while (item != (-1)) {
        inode := arena_at(p.arena, item)
        value := inode.a
        item = inode.next
        held = prov_max(held, frame_value_prov(p, value))
    }
    held
}

// What a block hands back, which is what its last statement answers with. A
// block ending in something that is not a value hands back nothing.
frame_block_prov :: fn(mut p: Parser, head: i64) -> i64 {
    frame_value_prov(p, block_answer(p, head))
}

// One argument's contribution, given what the callee answers with, the type it
// declared for that parameter, and whether it was handed the argument's address.
frame_held_arg :: fn(mut p: Parser, answer: i64, declared: i64,
    addressed: bool, arg: i64) -> i64 {
    if (declared < 0) {
        return prov_max(frame_place_prov(p, arg), frame_value_prov(p, arg))
    }
    // The callee was handed the argument's address, so a view it builds can name
    // the argument's own storage. Only where the view could land there: reading
    // it as though it always could made `query_entities(world, q)` a leak of the
    // local `q`.
    if (addressed && view_lands_in(p, answer, declared)) {
        return prov_max(frame_place_prov(p, arg), frame_value_prov(p, arg))
    }
    // The callee was handed a copy. It can still build a view from what that
    // copy points at, so a slice or a pointer carries its pointee's provenance
    // across. A parameter holding no view carries nothing at all: an `i64` count
    // says nothing about how long anything lives, and joining it in is what made
    // `slice_span($T, held, total, 0)` read as a leak.
    if (type_holds_view(p, declared, FRAME_TYPE_DEPTH)) {
        return frame_value_prov(p, arg)
    }
    PROV_OUTLIVES
}

// What a call answers with. Frost has no global storage and no closures, so the
// only storage a callee can name is storage it was handed, which makes this the
// join over the arguments rather than a walk into the callee.
frame_call_prov :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    args := node.a
    sym := arena_at(p.fns, node.val)
    // A name with no signature in this program: a compile-time parameter
    // standing for a function, or one the walk never saw.
    if (sym.defined == 0) {
        return PROV_UNKNOWN
    }
    answer := sym.ret_type
    params := sym.params
    // A callee answering with no view answers with a value, and a value carries
    // no storage out however it was built.
    if (type_holds_view(p, answer, FRAME_TYPE_DEPTH) == false) {
        return PROV_OUTLIVES
    }
    // C has global storage, so what an extern answers with is not built from
    // what it was handed. This gives up catching a C function that does answer
    // with a pointer into one of its arguments, which `strchr` is the shape of.
    if (sym.is_extern == 1) {
        return PROV_OUTLIVES
    }
    // Only the arguments the callee's answer reaches. Weighing every one reads
    // a wrapper as handing back whatever it was given, and a wrapper over C
    // hands back the library's storage.
    mut reaches : i64 = -1
    callee := node.val
    if (callee >= 0 && callee < p.answer_masks.count) {
        mask_entry := arena_at(p.answer_masks, callee)
        reaches = mask_entry.mask
    }
    mut held : i64 = PROV_OUTLIVES
    count := count_value_args(p, args)
    mut i : i64 = 0
    while (i < count) {
        mut weighed : bool = true
        if (i < ANSWER_BITS) {
            if (reaches & (1 << i) == 0) {
                weighed = false
            }
        }
        if (weighed == false) {
            i = i + 1
            continue
        }
        arg := nth_value_arg(p, args, i)
        param := nth_param_node(p, params, i)
        mut declared : i64 = -1
        mut addressed : bool = false
        if (param != (-1)) {
            pnode := arena_at(p.arena, param)
            declared = pnode.b
            // A parameter that borrows carries the flag in its type. The rules
            // ask about the value the caller named, so the flag comes off and
            // the mode is carried beside it.
            if (pnode.a == 1) {
                addressed = true
                declared = pointee(declared)
            }
        }
        held = prov_max(held,
            frame_held_arg(p, answer, declared, addressed, arg))
        i = i + 1
    }
    held
}

// A call through a value: a function pointer read out of a field or a table. The
// signature it holds says what it answers with and how it takes each argument,
// so a call through one is weighed the same way a named call is. Where that
// signature cannot be read, nothing says where the answer came from, and
// answering that it outlives the call is what let a frame pointer out through
// `ops.pass(ptr_to(local))`.
frame_call_ptr_prov :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    callee := node.a
    args := node.b
    proc_ty := frame_place_type(p, callee)
    if (proc_ty < 0 || is_proc(proc_ty) == false) {
        return PROV_UNKNOWN
    }
    answer := proc_ret(p, proc_ty)
    if (type_holds_view(p, answer, FRAME_TYPE_DEPTH) == false) {
        return PROV_OUTLIVES
    }
    count := proc_param_count(p, proc_ty)
    mut held : i64 = PROV_OUTLIVES
    mut index : i64 = 0
    mut arg := args
    while (arg != (-1)) {
        anode := arena_at(p.arena, arg)
        value := anode.a
        arg = anode.next
        mut declared : i64 = -1
        if (index < count) {
            declared = proc_param_at(p, proc_ty, index)
        }
        // A signature records no modes, so an aggregate parameter is read as
        // being handed the argument's address the way a read of one is, and
        // everything narrower as being handed a copy.
        held = prov_max(held,
            frame_held_arg(p, answer, declared, is_struct_ty(declared), value))
        index = index + 1
    }
    held
}

// The storage a value names.
frame_value_prov :: fn(mut p: Parser, id: i64) -> i64 {
    if (id == (-1)) {
        return PROV_OUTLIVES
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    child := node.a
    // An address of a place names that place's storage.
    if (kind == NodeKind::AddrOf || kind == NodeKind::Ref) {
        return frame_place_prov(p, child)
    }
    if (kind == NodeKind::Var) {
        return frame_name_prov(p, node.val, node.c)
    }
    // Reaching into a value stays inside whatever it named.
    if (kind == NodeKind::Index || kind == NodeKind::Field) {
        return frame_value_prov(p, child)
    }
    // Reading back through a pointer hands out whatever sits there. A scalar
    // read carries no storage however short-lived the pointer was, which is why
    // `p^` under `-> i64` is the ordinary way to read a local. A read whose type
    // holds a view hands the view out again, which is `pp^` where `pp` was taken
    // from a binding that held a frame pointer.
    if (kind == NodeKind::Deref) {
        base := frame_place_type(p, child)
        if (base >= 0 && is_pointer(base)
            && type_holds_view(p, pointee(base), FRAME_TYPE_DEPTH) == false) {
            return PROV_OUTLIVES
        }
        return frame_value_prov(p, child)
    }
    // A cast keeps pointing where it pointed, and a slice wraps a pointer in a
    // length, so both answer with what they were built from.
    if (kind == NodeKind::PtrCast || kind == NodeKind::Cast) {
        return frame_value_prov(p, child)
    }
    if (kind == NodeKind::SliceFrom) {
        return prov_max(frame_value_prov(p, child),
            frame_value_prov(p, node.b))
    }
    // A value built around views is as short-lived as the shortest of them, so a
    // struct carrying a frame pointer out is caught the way a bare one is. An
    // enum variant is a struct literal too, so this covers it.
    if (kind == NodeKind::StructLit || kind == NodeKind::ArrayLit) {
        return frame_list_prov(p, child)
    }
    // A block used as a value answers with whichever branch runs, so it is worth
    // the shortest-lived of them.
    if (kind == NodeKind::If) {
        return prov_max(frame_block_prov(p, node.b),
            frame_block_prov(p, node.val))
    }
    if (kind == NodeKind::Match) {
        mut held : i64 = PROV_OUTLIVES
        mut arm := node.b
        while (arm != (-1)) {
            case_node := arena_at(p.arena, arm)
            body := case_node.a
            arm = case_node.next
            held = prov_max(held, frame_block_prov(p, body))
        }
        return held
    }
    if (kind == NodeKind::Call) {
        return frame_call_prov(p, id)
    }
    if (kind == NodeKind::CallPtr) {
        return frame_call_ptr_prov(p, id)
    }
    // A value that names no storage places no constraint on how long a view
    // built from it may live. Arithmetic is among them: there is no pointer
    // arithmetic in the surface, so a binary operator answers with a number.
    if (kind == NodeKind::Num || kind == NodeKind::Float
        || kind == NodeKind::StrLit || kind == NodeKind::TypeVal
        || kind == NodeKind::Bin || kind == NodeKind::SliceLen
        || kind == NodeKind::Sizeof || kind == NodeKind::Assert) {
        return PROV_OUTLIVES
    }
    // Listed rather than caught by a fallthrough. Frost has no exhaustiveness
    // error to lean on here, so the walk says outright that it met a form nobody
    // wrote a rule for, which is a hole in the check rather than a value that
    // outlives the call.
    frame_unhandled(p, "value", node.pos)
    PROV_UNKNOWN
}

// The storage a view takes the address of when it is built by coercion.
//
// `view : []i64 = arr` and `fn() -> []i64 { arr }` both hand back a view of the
// array rather than a copy of it, so the array's storage is what the view names.
// A value that is already a view carries its own provenance and no new address
// is taken, which is what keeps a slice parameter passed straight back out from
// reading as this frame's.
frame_coercion_prov :: fn(mut p: Parser, id: i64) -> i64 {
    held := frame_value_type(p, id)
    if (held >= 0 && type_is_direct_view(p, held)) {
        return PROV_OUTLIVES
    }
    frame_place_prov(p, id)
}

// Where the place a binding names lives, when the binding borrows rather than
// owning storage of its own. `ref x := place` binds one, and so does a binding
// taken from a call answering with a `ref`. -1 says the binding is storage this
// frame owns. Without this, an accessor built on one refuses itself.
frame_borrowed_place :: fn(mut p: Parser, id: i64) -> i64 {
    if (id == (-1)) {
        return -1
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Ref) {
        return frame_place_prov(p, node.a)
    }
    if (kind == NodeKind::Call) {
        sym := arena_at(p.fns, node.val)
        if (sym.defined == 1 && is_borrow(sym.ret_type)) {
            return frame_call_prov(p, id)
        }
    }
    -1
}

frame_escape :: fn(mut p: Parser, pos: i64, how: ^i8) {
    report_where(p.modules, p.src, pos)
    report("a pointer into this frame is ")
    report_cstr(how)
    report("; the storage it names dies when the call returns")
    frost_rt_die()
}

frame_unproven :: fn(mut p: Parser, pos: i64) {
    report_where(p.modules, p.src, pos)
    report("this answers with a borrowed view whose storage cannot be traced ")
    report("to a parameter or an allocation capability; a view that leaves the ")
    report("call has to name storage that outlives it")
    frost_rt_die()
}

frame_unhandled :: fn(mut p: Parser, what: ^i8, pos: i64) {
    report_where(p.modules, p.src, pos)
    report("the frame check has no rule for this ")
    report_cstr(what)
    report(", so it cannot say where the storage it names lives")
    frost_rt_die()
}

// What a value leaving the call is worth. PROV_FRAME is refused outright.
// PROV_UNKNOWN is refused wherever the function answers with something that
// holds a view, since that is where a value the walk could not classify is able
// to carry storage out.
//
// A function answering with `ref T` answers with a place: `local.a[0]` there
// hands back the element rather than a copy of it, so the storage the answer
// names is what matters and not what happens to sit there. Under `-> i64` the
// same expression is a read, and reading a local carries nothing out. Under
// `-> ^T` it is a value that happens to be an address, so a local holding a heap
// pointer hands back the pointer rather than the local.
frame_judge :: fn(mut p: Parser, id: i64, how: ^i8, pos: i64) {
    mut held := frame_value_prov(p, id)
    if (p.frame_answers_place == 1) {
        held = prov_max(held, frame_place_prov(p, id))
    }
    if (p.frame_answers_direct == 1) {
        held = prov_max(held, frame_coercion_prov(p, id))
    }
    if (held == PROV_FRAME) {
        frame_escape(p, pos, how)
    }
    if (held == PROV_UNKNOWN && p.frame_answers_view == 1) {
        frame_unproven(p, pos)
    }
}

// The value a block answers with: its last statement, when that is an
// expression. -1 when the block ends in something that is not a value.
block_answer :: fn(mut p: Parser, head: i64) -> i64 {
    mut id := head
    mut last : i64 = -1
    while (id != (-1)) {
        last = id
        node := arena_at(p.arena, id)
        id = node.next
    }
    if (last == (-1)) {
        return -1
    }
    node := arena_at(p.arena, last)
    if (node.kind == NodeKind::ExprStmt) {
        return node.a
    }
    -1
}

frame_note_let :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    value := node.a
    annotation := node.b
    off := node.val
    len := node.c
    mut held := frame_value_prov(p, value)
    // A binding declared as a view and given a place takes the address of that
    // place, so `view : []i64 = arr` holds a view of the array rather than a
    // copy of it.
    if (annotation >= 0 && type_is_direct_view(p, annotation)) {
        held = prov_max(held, frame_coercion_prov(p, value))
    }
    borrowed := frame_borrowed_place(p, value)
    mut ty := annotation
    if (ty < 0) {
        ty = frame_value_type(p, value)
    }
    list_name(p.frame_storage, off, len)
    note_prov(p.frame_locals, p.src, off, len, held)
    if (borrowed >= 0) {
        note_prov(p.frame_places, p.src, off, len, borrowed)
    }
    if (ty >= 0) {
        note_type(p.frame_types, p.src, off, len, ty)
    }
}

// Writing a view into a place the call cannot see hands it to the caller just as
// returning it does, and the caller's frame outlives this one. Writing one into
// this frame's own storage keeps it here, and that place now holds whatever the
// value named: without recording it, a pointer stored in a local and returned
// afterwards left with nobody having asked. A `match` or an `if` used as a value
// is that shape, since both desugar into a synthesized local the arms assign to.
frame_note_assign :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    place := node.a
    value := node.b
    pos := node.pos
    held := frame_value_prov(p, value)
    if (frame_place_prov(p, place) == PROV_FRAME) {
        target := root_name(p, place)
        if (target != (-1)) {
            tnode := arena_at(p.arena, target)
            off := tnode.val
            len := tnode.c
            mut now := prov_listed(p.frame_locals, p.src, off, len)
            if (now < 0) {
                now = PROV_OUTLIVES
            }
            note_prov(p.frame_locals, p.src, off, len, prov_max(now, held))
        }
        return
    }
    if (held == PROV_FRAME) {
        frame_escape(p, pos, "stored where the call cannot see it")
    }
}

// Walk a block. `root` says whether this block's trailing value is what the
// function hands back, which only the function's own body and a branch of a
// block in value position can be. Without it, a nested block's last statement
// reads as the call's answer and ordinary code is refused.
frame_check_block :: fn(mut p: Parser, head: i64, root: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        first := node.a
        second := node.b
        third := node.val
        pos := node.pos
        next_id := node.next
        // Whether the value this statement ends with is the block's. A statement
        // with something after it hands its value nowhere.
        mut answers : i64 = 0
        if (root == 1 && next_id == (-1)) {
            answers = 1
        }
        if (kind == NodeKind::Let) {
            frame_note_let(p, id)
        } else if (kind == NodeKind::Assign) {
            frame_note_assign(p, id)
        } else if (kind == NodeKind::Return) {
            frame_judge(p, first, "returned", pos)
        } else if (kind == NodeKind::ExprStmt) {
            if (answers == 1) {
                frame_judge(p, first, "the block's value", pos)
            }
        } else if (kind == NodeKind::If) {
            frame_check_block(p, second, answers)
            frame_check_block(p, third, answers)
        } else if (kind == NodeKind::Match) {
            mut arm := second
            while (arm != (-1)) {
                case_node := arena_at(p.arena, arm)
                body := case_node.a
                arm = case_node.next
                frame_check_block(p, body, answers)
            }
        } else if (kind == NodeKind::While) {
            frame_check_block(p, second, 0)
        } else if (kind == NodeKind::With) {
            frame_check_block(p, first, 0)
        } else if (kind == NodeKind::Print || kind == NodeKind::Assert
            || kind == NodeKind::Break || kind == NodeKind::Continue) {
            // Nothing leaves the frame through one. A print writes a value out
            // and hands nothing back, an assert reads one, and the two transfers
            // carry no value at all.
        } else {
            frame_unhandled(p, "statement", pos)
        }
        id = next_id
    }
}

// Every parameter's name and type, before the body is walked.
//
// A borrow names the caller's storage, which outlives the call by definition. A
// `move` parameter is in both sets, because the two answer different questions:
// its storage is this call's own copy, so `ptr_to(p.x)` is an address into this
// frame, and its value is whatever the caller handed over, so reading it out and
// passing it on carries nothing of this frame with it. An allocation capability
// is a trailing parameter of the same kind, and the arena it names belongs to
// the caller's `with` block, where the region half of this file checks it.
frame_seed_params :: fn(mut p: Parser, params: i64) {
    mut id := params
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        off := node.val
        len := node.c
        ty := node.b
        mode := node.a
        id = node.next
        list_name(p.frame_outlives, off, len)
        if (mode == 2) {
            list_name(p.frame_storage, off, len)
        }
        note_type(p.frame_types, p.src, off, len, ty)
    }
}

// How many parameters a mask can carry. Past this the answer is every
// parameter, which is what the join did before any of this existed.
ANSWER_BITS :: 62

// Every parameter of this function, as a mask.
answer_all_params :: fn(mut p: Parser, params: i64) -> i64 {
    mut n : i64 = 0
    mut id := params
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        id = node.next
        n = n + 1
    }
    if (n >= ANSWER_BITS) {
        return -1
    }
    (1 << n) - 1
}

// The bit for the parameter of this name, or 0 where the name is not one.
answer_param_bit :: fn(mut p: Parser, params: i64, off: i64, len: i64) -> i64 {
    mut id := params
    mut n : i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        if (node.c == len && bytes_equal(p.src, node.val, off, len)) {
            if (n >= ANSWER_BITS) {
                return -1
            }
            return 1 << n
        }
        id = node.next
        n = n + 1
    }
    0
}

// Whether reaching into this place stays inside storage a parameter holds
// inline. A field does, and so does an element of a fixed array. An element of
// a slice or a raw pointer lands wherever the run was allocated.
answer_reaches_inline :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return true
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    base := node.a
    if (kind == NodeKind::Field) {
        return answer_reaches_inline(p, base)
    }
    if (kind == NodeKind::Index) {
        held := frame_place_type(p, base)
        if (held < 0) {
            return answer_reaches_inline(p, base)
        }
        if (is_array_ty(held) && is_slice_ty(p, held) == false) {
            return answer_reaches_inline(p, base)
        }
        return false
    }
    if (kind == NodeKind::Deref) {
        return false
    }
    true
}

// The parameters a place names the storage of.
answer_place_mask :: fn(mut p: Parser, id: i64, params: i64) -> i64 {
    if (id == (-1)) {
        return 0
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Field || kind == NodeKind::Index) {
        if (answer_reaches_inline(p, id)) {
            return answer_place_mask(p, node.a, params)
        }
        return 0
    }
    if (kind == NodeKind::Deref) {
        return 0
    }
    answer_value_mask(p, id, params)
}

// The parameters the storage of this value can be named through.
answer_value_mask :: fn(mut p: Parser, id: i64, params: i64) -> i64 {
    if (id == (-1)) {
        return 0
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    child := node.a
    if (kind == NodeKind::AddrOf || kind == NodeKind::Ref) {
        return answer_place_mask(p, child, params)
    }
    if (kind == NodeKind::Var) {
        bit := answer_param_bit(p, params, node.val, node.c)
        if (bit != 0) {
            return bit
        }
        held := type_listed(p.answer_locals, p.src, node.val, node.c)
        if (held >= 0) {
            return held
        }
        return 0
    }
    // A place read by value copies what is there. Whatever views the copy holds
    // point where they already pointed, so the container is not named by it.
    if (kind == NodeKind::Field || kind == NodeKind::Index) {
        held := frame_place_type(p, id)
        if (held >= 0 && type_holds_view(p, held, FRAME_TYPE_DEPTH) == false) {
            return 0
        }
        if (answer_reaches_inline(p, id)) {
            return answer_value_mask(p, child, params)
        }
        return 0
    }
    if (kind == NodeKind::Deref) {
        return 0
    }
    if (kind == NodeKind::PtrCast || kind == NodeKind::Cast) {
        return answer_value_mask(p, child, params)
    }
    if (kind == NodeKind::SliceFrom) {
        return answer_value_mask(p, child, params)
            | answer_value_mask(p, node.b, params)
    }
    if (kind == NodeKind::StructLit || kind == NodeKind::ArrayLit) {
        mut found : i64 = 0
        mut item := child
        while (item != (-1)) {
            inode := arena_at(p.arena, item)
            found = found | answer_value_mask(p, inode.a, params)
            item = inode.next
        }
        return found
    }
    if (kind == NodeKind::If) {
        return answer_block_answer(p, node.b, params)
            | answer_block_answer(p, node.val, params)
    }
    if (kind == NodeKind::Match) {
        mut found : i64 = 0
        mut arm := node.b
        while (arm != (-1)) {
            case_node := arena_at(p.arena, arm)
            found = found | answer_block_answer(p, case_node.a, params)
            arm = case_node.next
        }
        return found
    }
    if (kind == NodeKind::Call) {
        return answer_call_mask(p, id, params)
    }
    if (kind == NodeKind::Num || kind == NodeKind::Float
        || kind == NodeKind::StrLit || kind == NodeKind::Sizeof
        || kind == NodeKind::SliceLen || kind == NodeKind::TypeVal
        || kind == NodeKind::Bin) {
        return 0
    }
    // A shape this walk does not read answers with every parameter, which is
    // the join it replaced.
    answer_all_params(p, params)
}

// What a block hands back.
answer_block_answer :: fn(mut p: Parser, head: i64, params: i64) -> i64 {
    answer_value_mask(p, block_answer(p, head), params)
}

// What a call contributes: the arguments the callee's own answer reaches.
answer_call_mask :: fn(mut p: Parser, id: i64, params: i64) -> i64 {
    node := arena_at(p.arena, id)
    args := node.a
    sym := arena_at(p.fns, node.val)
    if (sym.defined == 0) {
        return answer_all_params(p, params)
    }
    // C has global storage, so what an extern answers with is not built from
    // what it was handed.
    if (sym.is_extern == 1) {
        return 0
    }
    callee := node.val
    mut reaches : i64 = -1
    if (callee >= 0 && callee < p.answer_masks.count) {
        held := arena_at(p.answer_masks, callee)
        reaches = held.mask
    }
    mut found : i64 = 0
    count := count_value_args(p, args)
    mut i : i64 = 0
    while (i < count) {
        mut weighed : bool = true
        if (i < ANSWER_BITS) {
            if (reaches & (1 << i) == 0) {
                weighed = false
            }
        }
        if (weighed) {
            found = found | answer_value_mask(p, nth_value_arg(p, args, i),
                params)
        }
        i = i + 1
    }
    found
}

// One exit, read as a place where the function answers with one.
answer_exit_mask :: fn(mut p: Parser, id: i64, params: i64,
    answers_place: bool) -> i64 {
    if (answers_place) {
        return answer_place_mask(p, id, params)
    }
    answer_value_mask(p, id, params)
}

// Walk a body, binding each local to the parameters its value reaches, and
// gather what every exit answers with.
answer_walk_block :: fn(mut p: Parser, head: i64, params: i64,
    answers_place: bool) -> i64 {
    mut found : i64 = 0
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next := node.next
        if (kind == NodeKind::Let) {
            mask := answer_value_mask(p, node.a, params)
            note_type(p.answer_locals, p.src, node.val, node.c, mask)
        }
        if (kind == NodeKind::Return) {
            found = found | answer_exit_mask(p, node.a, params, answers_place)
        }
        if (kind == NodeKind::While || kind == NodeKind::With) {
            found = found | answer_walk_block(p, node.b, params, answers_place)
        }
        if (kind == NodeKind::If) {
            found = found | answer_walk_block(p, node.b, params, answers_place)
            found = found
                | answer_walk_block(p, node.val, params, answers_place)
        }
        if (kind == NodeKind::Match) {
            mut arm := node.b
            while (arm != (-1)) {
                case_node := arena_at(p.arena, arm)
                found = found
                    | answer_walk_block(p, case_node.a, params, answers_place)
                arm = case_node.next
            }
        }
        id = next
    }
    found | answer_exit_mask(p, block_answer(p, head), params, answers_place)
}

// Which parameters each function's answer can name the storage of. Grown from
// nothing to a fixpoint, since one function's answer reaches another's and a
// set that only gains bits settles.
settle_answer_sources :: fn(mut p: Parser) {
    while (p.answer_masks.count < p.fns.count) {
        arena_push(p.answer_masks, AnswerMask { mask = 0 })
    }
    mut grew : i64 = 1
    while (grew == 1) {
        grew = 0
        mut i : i64 = 0
        while (i < p.arena.count) {
            node := arena_at(p.arena, i)
            if (node.kind == NodeKind::Func) {
                body := node.a
                fn_index := node.val
                sym := arena_at(p.fns, fn_index)
                params := sym.params
                answers_place := is_borrow(sym.ret_type)
                p.frame_types.count = 0
                p.answer_locals.count = 0
                frame_seed_types(p, params)
                // A function handing back a place reaches it through bindings
                // this walk does not follow closely enough to narrow, so it
                // keeps every parameter and the join weighs them all.
                mut mask : i64 = answer_all_params(p, params)
                if (answers_place == false) {
                    mask = answer_walk_block(p, body, params, answers_place)
                }
                if (fn_index >= 0 && fn_index < p.answer_masks.count) {
                    mut held := arena_at(p.answer_masks, fn_index)
                    merged := held.mask | mask
                    if (merged != held.mask) {
                        held.mask = merged
                        grew = 1
                    }
                }
            }
            i = i + 1
        }
    }
}

// The declared type of each parameter, which is what tells reaching through an
// indirection from reaching into storage held inline.
frame_seed_types :: fn(mut p: Parser, params: i64) {
    mut id := params
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        off := node.val
        len := node.c
        ty := node.b
        id = node.next
        note_type(p.frame_types, p.src, off, len, ty)
    }
}

check_frame_escapes :: fn(mut p: Parser) {
    settle_answer_sources(p)
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        if (node.kind == NodeKind::Func) {
            body := node.a
            sym := arena_at(p.fns, node.val)
            answer := sym.ret_type
            params := sym.params
            p.frame_storage.count = 0
            p.frame_outlives.count = 0
            p.frame_locals.count = 0
            p.frame_places.count = 0
            p.frame_types.count = 0
            p.frame_ret = answer
            p.frame_answers_view = 0
            p.frame_answers_place = 0
            p.frame_answers_direct = 0
            if (type_holds_view(p, answer, FRAME_TYPE_DEPTH)) {
                p.frame_answers_view = 1
            }
            if (is_borrow(answer)) {
                p.frame_answers_place = 1
            }
            if (type_is_direct_view(p, answer)) {
                p.frame_answers_direct = 1
            }
            frame_seed_params(p, params)
            frame_check_block(p, body, 1)
        }
        i = i + 1
    }
}

name_listed :: fn(mut table: Arena<LocalVar>, src: str, off: i64, len: i64)
    -> bool {
    mut i : i64 = 0
    while (i < table.count) {
        entry := arena_at(table, i)
        if (entry.name_len == len
            && bytes_equal(src, entry.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

list_name :: fn(mut table: Arena<LocalVar>, off: i64, len: i64) {
    arena_push(table, LocalVar { name_off = off, name_len = len, ty = 0, slot = 0 })
}

// The name a place is rooted at, walking down through fields, indexes and
// dereferences, or -1 if the place is not rooted at a name.
root_name :: fn(mut p: Parser, id: i64) -> i64 {
    mut current := id
    while (current != (-1)) {
        node := arena_at(p.arena, current)
        kind := node.kind
        if (kind == NodeKind::Var) {
            return current
        }
        if (kind == NodeKind::Field || kind == NodeKind::Index || kind == NodeKind::Deref
            || kind == NodeKind::AddrOf || kind == NodeKind::PtrCast) {
            current = node.a
        } else {
            return -1
        }
    }
    -1
}

// Whether an expression names the region's arena or anything already known to
// point into it.
mentions_region :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Var) {
        off := node.val
        len := node.c
        if (len == p.region_len
            && bytes_equal(p.src, p.region_off, off, len)) {
            return true
        }
        return name_listed(p.tainted, p.src, off, len)
    }
    if (kind == NodeKind::Num || kind == NodeKind::StrLit || kind == NodeKind::TypeVal) {
        return false
    }
    if (kind == NodeKind::Call) {
        return mentions_region_args(p, node.a)
    }
    mentions_region(p, node.a) || mentions_region(p, node.b)
}

mentions_region_args :: fn(mut p: Parser, head: i64) -> bool {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        next_id := node.next
        if (mentions_region(p, node.a)) {
            return true
        }
        id = next_id
    }
    false
}

// Whether a value points into the region. A pointer taken of something that
// mentions the arena is one. So is the result of a call that returns a pointer
// and either draws from an allocation source or was handed the arena.
// Whether a value is the address of a binding that already holds an arena
// pointer, which is the only way a dereference can hand one back out.
region_points_at_tainted :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    if (node.kind != NodeKind::AddrOf && node.kind != NodeKind::Ref) {
        return false
    }
    root := root_name(p, node.a)
    if (root == (-1)) {
        return false
    }
    rnode := arena_at(p.arena, root)
    name_listed(p.tainted, p.src, rnode.val, rnode.c)
}

region_pointer :: fn(mut p: Parser, id: i64) -> bool {
    if (id == (-1)) {
        return false
    }
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::AddrOf) {
        return mentions_region(p, node.a)
    }
    if (kind == NodeKind::Var) {
        return name_listed(p.tainted, p.src, node.val, node.c)
    }
    // A cast still points where it pointed. A dereference does not: it reads
    // the value there, and reading out of the region is what the region is for.
    if (kind == NodeKind::PtrCast) {
        return region_pointer(p, node.a)
    }
    // Reading back through a pointer at a binding that holds an arena pointer
    // hands that pointer out again. `pp^` where `pp` was taken from something
    // already tainted, not `p^` where `p` is the arena pointer itself.
    if (kind == NodeKind::Deref) {
        root := root_name(p, node.a)
        if (root == (-1)) {
            return false
        }
        rnode := arena_at(p.arena, root)
        return name_listed(p.region_via_pointer, p.src, rnode.val, rnode.c)
    }
    if (kind == NodeKind::Call) {
        sym := arena_at(p.fns, node.val)
        if (is_pointer(sym.ret_type) == false) {
            return false
        }
        if (sym.cap_count > 0) {
            return true
        }
        return mentions_region_args(p, node.a)
    }
    false
}

region_escape :: fn(mut p: Parser, how: ^i8) {
    report_where(p.modules, p.src, p.region_off)
    report("a pointer into arena '")
    report_src(p.src, p.region_off, p.region_len)
    report("' escapes its region by ")
    report_cstr(how)
    report("; it may not outlive the arena")
    frost_rt_die()
}

check_region_block :: fn(mut p: Parser, head: i64) {
    mut id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (kind == NodeKind::Let) {
            // A binding declared inside the region dies with it, so it may hold
            // a region pointer.
            if (region_pointer(p, node.a)) {
                list_name(p.tainted, node.val, node.c)
            }
            if (region_points_at_tainted(p, node.a)) {
                list_name(p.region_via_pointer, node.val, node.c)
            }
            list_name(p.inner, node.val, node.c)
        }
        if (kind == NodeKind::Assign) {
            if (region_pointer(p, node.b)) {
                place := root_name(p, node.a)
                mut outside : bool = true
                if (place != (-1)) {
                    pnode := arena_at(p.arena, place)
                    outside = name_listed(p.inner, p.src, pnode.val,
                        pnode.c) == false
                }
                if (outside) {
                    if (p.region_returns == 1) {
                        region_escape(p, "being stored into a parameter")
                    }
                    region_escape(p, "being stored outside it")
                }
            }
        }
        // Handing a pointer back is an escape from a `with` block, whose arena
        // dies at the closing brace. It is not one from a `uses` function: the
        // arena belongs to the caller, so the pointer is handed to the caller's
        // region and checked there.
        if (kind == NodeKind::Return && p.region_returns == 0) {
            if (region_pointer(p, node.a)) {
                region_escape(p, "being returned")
            }
        }
        if (kind == NodeKind::ExprStmt && p.region_returns == 0) {
            if (next_id == (-1) && region_pointer(p, node.a)) {
                region_escape(p, "being the block's value")
            }
        }
        if (kind == NodeKind::If) {
            check_region_block(p, node.b)
            check_region_block(p, node.val)
        }
        if (kind == NodeKind::While) {
            check_region_block(p, node.b)
        }
        if (kind == NodeKind::With) {
            check_region_block(p, node.a)
        }
        id = next_id
    }
}

// Every `with` block in the program is a region, and so is the body of every
// `uses` function, whose arena belongs to whoever supplied it. Each is checked
// on its own, since a region's arena is the only thing its pointers can point
// into. This is what makes the check interprocedural without lifetimes: a
// pointer can only reach an arena a function was handed directly, so following
// the flow inside each body is enough.
check_regions :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        kind := node.kind
        if (kind == NodeKind::With) {
            body := node.a
            p.region_off = node.val
            p.region_len = node.c
            p.tainted.count = 0
            p.region_via_pointer.count = 0
            p.inner.count = 0
            p.region_returns = 0
            check_region_block(p, body)
        }
        if (kind == NodeKind::Func) {
            sym := arena_at(p.fns, node.val)
            // Once per capability the function draws, since a pointer into any
            // of them is a pointer that may not outlive the call.
            mut cap : i64 = 0
            while (cap < sym.cap_count) {
                held := cap_at(p, node.val, cap)
                body := node.a
                p.region_off = held.off
                p.region_len = held.len
                p.tainted.count = 0
                p.region_via_pointer.count = 0
                p.inner.count = 0
                p.region_returns = 1
                check_region_block(p, body)
                p.region_returns = 0
                cap = cap + 1
            }
        }
        i = i + 1
    }
}

// The unsafety gate. Every other check here proves something about a program it
// can see all of. Three operations reach memory none of that covers, and an
// `unsafe` block is where they are allowed:
//
//   - reading or writing through a raw pointer, `p^` and `p[i]`
//   - `ptr_cast`, which says the bytes at an address are a different type
//   - calling an `extern fn`, which is arbitrary C, unless it was declared
//     `safe extern fn` and so audited once at its declaration
//
// The block enabling the three is not what matters. That they are refused
// outside one is, and it makes `unsafe` the complete list of places to look
// when something has corrupted memory. A node carries where it was written and
// an `unsafe` block is a span of source, so the question is whether the one is
// inside the other.
check_unsafety :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        kind := node.kind
        mut gated : i64 = 0
        mut what : ^i8 = ""
        // A borrow was proven safe where it formed, and a `mut` parameter of a
        // scalar type is one: the body reads and writes the caller's value
        // through it. Such a read is marked where the parser makes it, since
        // this walk has no local types in hand. Only a raw pointer is
        // unchecked.
        if (kind == NodeKind::Deref && node.val != 1) {
            gated = 1
            what = "reading through a raw pointer"
        }
        if (kind == NodeKind::PtrCast) {
            gated = 1
            what = "ptr_cast"
        }
        // Forming a slice from a raw pointer and a length is a claim the
        // bytes are that, which nothing checks. Reads through the slice are
        // checked, so the claim is the only unsafe part.
        if (kind == NodeKind::SliceFrom) {
            gated = 1
            what = "slice_from"
        }
        // An array or a slice knows its own length, so indexing one is
        // checked. A borrow was proven safe where it formed. Only a raw
        // pointer is unchecked.
        if (kind == NodeKind::Index) {
            if (node.c == 1) {
                gated = 1
                what = "indexing a raw pointer"
            }
        }
        // Reading a field through a raw pointer is the same unchecked read a
        // `^` is. A borrow reaching its field is not, which is what lets
        // `mut p: Parser` write `p.field` without a block.
        //
        // Both read the answer the type pass wrote down rather than working it
        // out again. This walk holds whatever local table the pass before it
        // left behind, which belongs to the last function that pass looked at,
        // so a name here would be looked up against another function's locals:
        // where the two functions happen to share a parameter name that is a
        // diagnostic about the wrong type, and where they do not it is a
        // silently wrong answer.
        if (kind == NodeKind::Field) {
            if (node.b == 1) {
                gated = 1
                what = "reading a field through a raw pointer"
            }
        }
        if (kind == NodeKind::Call) {
            sym := arena_at(p.fns, node.val)
            if (sym.is_extern == 1 && sym.is_safe == 0) {
                gated = 1
                what = "calling a C function"
            }
        }
        if (gated == 1 && inside_unsafe(p, node.pos) == 0) {
            report_where(p.modules, p.src, node.pos)
            report_cstr(what)
            report(" is unchecked, so it belongs in an `unsafe` block")
            frost_rt_die()
        }
        if (gated == 1) {
            mark_span_used(p, node.pos)
        }
        i = i + 1
    }
    report_idle_unsafe(p)
}

// Mark the innermost `unsafe` holding this position as having earned itself.
// The innermost is the narrowest span containing it, and it is the one that
// vouches: an operation inside a nested block is that block's to answer for.
mark_span_used :: fn(mut p: Parser, pos: i64) {
    mut best : i64 = -1
    mut width : i64 = 0
    mut i : i64 = 0
    while (i < p.unsafe_spans.count) {
        span := arena_at(p.unsafe_spans, i)
        if (pos >= span.start && pos < span.end) {
            held := span.end - span.start
            if (best < 0 || held < width) {
                best = i
                width = held
            }
        }
        i = i + 1
    }
    if (best >= 0) {
        mut chosen := arena_at(p.unsafe_spans, best)
        chosen.used = 1
    }
}

// Every block that vouches for nothing: one holding no unchecked operation, and
// one written inside another, which already covers what is in it. Reported on
// every build as a warning, since the list of `unsafe` blocks is only worth
// reading while every one of them earns its place. `--audit-unsafe` turns the
// warning into a failure, which is what holds a tree to it.
report_idle_unsafe :: fn(mut p: Parser) {
    mut found : i64 = 0
    mut i : i64 = 0
    while (i < p.unsafe_spans.count) {
        span := arena_at(p.unsafe_spans, i)
        // A generic's body is read again for each instantiation, so one block
        // written once is recorded once per instance. They are the same block:
        // the first is reported for, and any of them earning itself earns it.
        mut first : i64 = 1
        mut used : i64 = span.used
        mut nested : i64 = 0
        mut k : i64 = 0
        while (k < p.unsafe_spans.count) {
            other := arena_at(p.unsafe_spans, k)
            if (other.start == span.start && other.end == span.end) {
                if (k < i) {
                    first = 0
                }
                if (other.used == 1) {
                    used = 1
                }
            } else if (span.start >= other.start && span.end <= other.end) {
                nested = 1
            }
            k = k + 1
        }
        if (first == 1 && nested == 1) {
            report_where(p.modules, p.src, span.start)
            report("warning: this `unsafe` block is inside another one, which ")
            report("already vouches for what is in it\n")
            found = 1
        } else if (first == 1 && used == 0) {
            report_where(p.modules, p.src, span.start)
            report("warning: this `unsafe` block holds no unchecked operation, ")
            report("so it vouches for nothing\n")
            found = 1
        }
        i = i + 1
    }
    if (found == 1 && p.audit_unsafe == 1) {
        frost_rt_die()
    }
}

// Whether a source position falls in some `unsafe { ... }` the parser recorded.
inside_unsafe :: fn(mut p: Parser, pos: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.unsafe_spans.count) {
        span := arena_at(p.unsafe_spans, i)
        if (pos >= span.start && pos < span.end) {
            return 1
        }
        i = i + 1
    }
    0
}

// The function-pointer type of a parameter of this name, or -1. A call through
// a function-pointer parameter is indirect, and this is how it is recognized
// before codegen, where the locals table that would otherwise answer does not
// exist yet.
// The signature a binding holds, for a binding whose value is a function. The
// locals table is a codegen structure this check runs before, so the type is
// read off what the value is written as: a name that is a function, or a field
// whose declared type is a signature.
let_proc_type :: fn(mut p: Parser, value: i64) -> i64 {
    if (value < 0) {
        return -1
    }
    node := arena_at(p.arena, value)
    if (node.kind == NodeKind::Field) {
        mut i : i64 = 0
        while (i < p.fields.count) {
            field := arena_at(p.fields, i)
            if (field.name_len == node.c
                && bytes_equal(p.src, field.name_off, node.val, node.c)
                && is_proc(field.ty)) {
                return field.ty
            }
            i = i + 1
        }
        return -1
    }
    if (node.kind == NodeKind::Var) {
        held := fn_index_of(p, node.val, node.c)
        if (held >= 0) {
            sym := arena_at(p.fns, held)
            if (sym.defined == 1) {
                return fn_proc_type(p, held)
            }
        }
    }
    -1
}

proc_param_named :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        if (node.kind == NodeKind::Param && is_proc(node.b)
            && node.c == len && bytes_equal(p.src, node.val, off, len)) {
            return node.b
        }
        // A binding of function-pointer type is a callee the same way a
        // parameter of one is. `run := schedule.systems[i].run` then `run(world)`
        // is how a table of functions is walked, and the name is a local rather
        // than anything declared.
        if (node.kind == NodeKind::Let && node.c == len
            && bytes_equal(p.src, node.val, off, len)) {
            mut ty := node.b
            if (ty < 0 || is_proc(ty) == false) {
                ty = let_proc_type(p, node.a)
            }
            if (ty >= 0 && is_proc(ty)) {
                return ty
            }
        }
        i = i + 1
    }
    -1
}

// Whether a name is a `$f` parameter of some generic in this program, the
// function a call site supplies rather than one any declaration names.
names_cfn_param :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i : i64 = 0
    while (i < p.cfn_params.count) {
        entry := arena_at(p.cfn_params, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

check_calls :: fn(mut p: Parser) {
    mut i : i64 = 0
    while (i < p.arena.count) {
        node := arena_at(p.arena, i)
        kind := node.kind
        fn_index := node.val
        args := node.a
        if (kind == NodeKind::Call) {
            sym := arena_at(p.fns, fn_index)
            defined := sym.defined
            name_off := sym.off
            name_len := sym.len
            params := sym.params
            // A call whose name is not a defined function may be a call
            // through a function-pointer parameter, which is indirect. The
            // codegen locals do not exist yet, so the name is looked for
            // among the function-pointer parameters instead. A defined
            // function is never also a parameter, so this only matters when
            // the name is undefined. Guarding it there keeps `proc_param_named`
            // (a whole-arena scan) off the common path and makes this check
            // linear instead of quadratic in the program size.
            mut callee_proc : i64 = -1
            if (defined == 0) {
                callee_proc = proc_param_named(p, name_off, name_len)
            }
            // `columns_new` is a compiler builtin standing for a zeroed
            // container, so it has no defined symbol. The emitter recognizes
            // it by name. Its zero arguments still satisfy the arity check.
            is_columns_new := str_range_eq(p.src, name_off, name_len,
                "columns_new")
            // A call to a `$f` parameter inside the template it belongs to
            // names no function, since which function it is comes from the
            // call site. The instances of that template are in this arena too,
            // and there the name is the function that was passed, so nothing
            // goes unchecked.
            mut is_supplied : bool = false
            if (defined == 0) {
                is_supplied = names_cfn_param(p, name_off, name_len)
                // A type predicate is a question the compiler answers where the
                // body is expanded, not a function. It survives in a template's
                // own parse, which nothing emits, and is gone from every
                // instance.
                if (is_type_predicate(p.src, name_off, name_len)) {
                    is_supplied = true
                }
            }
            if (defined == 0 && callee_proc < 0 && is_columns_new == false
                && is_supplied == false) {
                report_where(p.modules, p.src, node.pos)
                report("call to undefined function '")
                report_src(p.src, name_off, name_len)
                report("'")
                frost_rt_die()
            }
            mut expected : i64 = 0
            if (callee_proc >= 0) {
                expected = proc_param_count(p, callee_proc)
            } else {
                // The capability is supplied by the caller's context rather
                // than written at the call, so it is not counted.
                expected = count_params(p, params) - sym.cap_count
            }
            got := count_args(p, args)
            // A compile-time list takes every argument past the parameters
            // written before it, so a call to one gives as many as it likes and
            // the count says nothing.
            if (takes_pack(p, fn_index)) {
                expected = got
            }
            if (expected != got && is_supplied == false) {
                report_where(p.modules, p.src, name_off)
                report("'")
                report_src(p.src, name_off, name_len)
                report("' expects ")
                frost_rt_error_int(expected)
                report(" argument(s) but got ")
                frost_rt_error_int(got)
                frost_rt_die()
            }
        }
        i = i + 1
    }
}

