// The command line covers what to compile, which backend to put it through,
// where the result goes, and whether to finish the build by calling the system
// toolchain.

import "core.frost"
import "imports.frost"

export Backend, Options, c_compiler, join_number,
    file_checksum, text_checksum, stored_checksum, write_checksum,
    make_directory, cached_runtime_object, runtime_source,
    cached_frost_runtime_object, frost_runtime_source, compiling_the_runtime,
    options_from_command_line, run_generators, usage

// Which backend the program goes through. Nothing is chosen until the arguments
// and the environment have both had their say, so the answer starts as nothing.
Backend :: enum { Unset, C, Asm }

// `ok` is 0 when the arguments did not make sense, which is separate from
// `help`, since one exits with a failure and the other does not.
Options :: struct {
    input: ^i8,
    output: ^i8,
    backend: Backend,
    link: i64,
    // Assemble the emitted text into an object rather than leaving it as
    // assembly, which is what `--native` answers with in both compilers.
    object: i64,
    // Turn an assembly file into an object with this compiler's own encoder,
    // rather than compiling a Frost source at all.
    assemble: i64,
    testing: i64,
    // Link the program, run it, and exit on what it returned. The arguments
    // after the file on the command line are the program's own rather than the
    // compiler's, and travel as one string ready to append to the command.
    running: i64,
    run_args: ^i8,
    audit_unsafe: i64,
    linting: i64,
    debug_lines: i64,
    // Object files and libraries the link is given, in the order written, as
    // one string ready to hand the toolchain.
    libs: ^i8,
    roots: Arena<SearchRoot>,
    // The project's layers, lowest first, as the manifest declared them.
    layers: Arena<Layer>,
    // Compile each module to its own object and assemble only the ones whose
    // emitted code changed. `build_dir` is where those objects are kept.
    incremental: i64,
    build_dir: ^i8,
    help: i64,
    ok: i64,
}

usage :: fn() {
    report("the Frost compiler\n\n")
    report("    frost [options] <file.frost>\n\n")
    report("    -o <path>     where to write the result\n")
    report("    -L <dir>      a directory to find imports under\n")
    report("    --emit-c      emit a C translation unit (the default)\n")
    report("    --emit-asm    emit x86-64 assembly\n")
    report("    -n, --native  compile to an object file\n")
    report("    -l, --link    assemble and link an executable\n")
    report("    --libs <item> an object file or library to link. Repeatable\n")
    report("    --incremental one object per module, assembling only what changed\n")
    report("    --build-dir <dir>  where those objects are kept\n")
    report("    --assemble    turn an assembly file into an object, with\n")
    report("                  this compiler's own encoder rather than `as`\n")
    report("    --test        build and run the file's `test` blocks\n")
    report("    run <file> [args]  compile the file, run it with those\n")
    report("                  arguments, and exit on what it returned\n")
    report("    --audit-unsafe  also report every `unsafe` block vouching for nothing\n")
    report("    -h, --help    this\n\n")
    report("Words read before the options, each taking files or ")
    report("directories:\n")
    report("    fmt <path>...   write each file the way the formatter ")
    report("renders it\n")
    report("    lint <path>...  findings a build does not refuse on. ")
    report("--diagnostics=json\n")
    report("                    writes one object a line\n")
    report("    api <prefix>    the exported surface under a name prefix, ")
    report("with signatures\n")
    report("    generate [--check]  write the files frost.json says a program ")
    report("of this\n")
    report("                    project writes, or check that none of them is ")
    report("stale\n\n")
    report("Without -o the output goes to standard output. FROST_INPUT ")
    report("and\nFROST_BACKEND are read when the matching argument is ")
    report("absent.\n")
    report("--run-ir and --freestanding are bootstrap options with no path ")
    report("here.\n")
}

// Which C toolchain the emitted translation unit goes to. `CC` overrides, as
// every build system expects. Otherwise the default follows the platform the way
// the bootstrap's own linker search does, preferring gcc on Windows, where a
// bare `cc` is often a stub that answers `--version` and then fails to compile
// anything, which reads as a broken compiler rather than a missing toolchain.
c_compiler :: fn() -> ^i8 {
    chosen := unsafe { frost_rt_getenv("CC") }
    if (cstr_len(chosen) != 0) {
        return chosen
    }
    if (frost_rt_is_windows() == 1) {
        return "gcc"
    }
    "cc"
}

// The text after `--flag=` when an argument is written that way, and an empty
// string when the argument is something else. A caller that also takes the
// value as a separate word checks that first.
value_after :: fn(argument: ^i8, flag: ^i8) -> ^i8 {
    flag_len := cstr_len(flag)
    argument_len := cstr_len(argument)
    if (argument_len <= flag_len) {
        return ""
    }
    mut k: i64 = 0
    while (k < flag_len) {
        if (byte_at(argument, k) != byte_at(flag, k)) {
            return ""
        }
        k = k + 1
    }
    rest := argument_len - flag_len
    out := unsafe { ptr_cast($i8, frost_rt_alloc(rest + 1)) }
    k = 0
    while (k < rest) {
        byte_set(out, k, byte_at(argument, flag_len + k))
        k = k + 1
    }
    byte_set(out, rest, 0)
    out
}

// A string with a number after it, for the per-module file names an
// incremental build works with: `<build>/m3.s` and `<build>/m3.o`.
join_number :: fn(first: ^i8, number: i64, last: ^i8) -> ^i8 {
    mut digits: i64 = 1
    mut scale: i64 = 1
    mut counted := number
    while (counted >= 10) {
        counted = counted / 10
        digits = digits + 1
        scale = scale * 10
    }
    first_len := cstr_len(first)
    last_len := cstr_len(last)
    out := unsafe {
        ptr_cast($i8, frost_rt_alloc(first_len + digits + last_len + 1))
    }
    mut k: i64 = 0
    while (k < first_len) {
        byte_set(out, k, byte_at(first, k))
        k = k + 1
    }
    mut value := number
    mut written: i64 = 0
    while (written < digits) {
        digit := value / scale
        byte_set(out, first_len + written, CH_0 + digit)
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    k = 0
    while (k < last_len) {
        byte_set(out, first_len + digits + k, byte_at(last, k))
        k = k + 1
    }
    byte_set(out, first_len + digits + last_len, 0)
    out
}

// What a file holds, as one number. This is the whole of the cache: the
// compiler has just written what a module compiles to, so whether that module's
// object is stale is a question about those bytes and nothing else. No hash of
// the source, no interface fingerprint, no dependency graph, because the answer
// is already in hand. A file that is not there answers 0, which no emitted unit
// does, so the first build of a module builds it.
file_checksum :: fn(path: ^i8) -> i64 {
    if (unsafe { frost_rt_file_exists(path) } == 0) {
        return 0
    }
    text := unsafe { frost_rt_read_file(path) }
    length := cstr_len(text)
    mut sum: i64 = length + 1
    mut k: i64 = 0
    while (k < length) {
        sum = wrap_add(wrap_mul(sum, 131), byte_at(text, k))
        k = k + 1
    }
    sum
}

// The same number for text already in hand, which is what a build that
// assembles its own output has: the emitted assembly never becomes a file, so
// there is nothing to read back and checksum.
text_checksum :: fn(text: str) -> i64 {
    length := str_len(text)
    mut sum: i64 = length + 1
    mut k: i64 = 0
    while (k < length) {
        sum = wrap_add(wrap_mul(sum, 131), text[k])
        k = k + 1
    }
    sum
}

// The number a previous build left beside a module's object, or 0 for a module
// nothing has built yet.
stored_checksum :: fn(path: ^i8) -> i64 {
    if (unsafe { frost_rt_file_exists(path) } == 0) {
        return 0
    }
    text := unsafe { frost_rt_read_file(path) }
    length := cstr_len(text)
    mut value: i64 = 0
    mut negative: bool = false
    mut k: i64 = 0
    while (k < length) {
        byte := byte_at(text, k)
        if (byte == CH_MINUS) {
            negative = true
        }
        if (byte >= CH_0 && byte <= CH_9) {
            value = value * 10 + (byte - CH_0)
        }
        k = k + 1
    }
    if (negative) {
        return -value
    }
    value
}

write_checksum :: fn(path: ^i8, value: i64) {
    if (unsafe { frost_rt_emit_open(path) } == 0) {
        report("frost: cannot write '")
        report_cstr(path)
        report("'")
        frost_rt_die()
    }
    frost_rt_emit_int(value)
    frost_rt_emit_close()
}

// Where one of the runtime's two files is. It is looked for beside the compiler
// and then up the directories a checkout puts it under, which is the search the
// standard library gets, so a compiler run from somewhere other than the
// directory it was built in still finds it. Not found anywhere, the relative
// path comes back, and whatever reads it says which path it looked at.
runtime_beside :: fn(relative: ^i8) -> ^i8 {
    program := frost_rt_arg_at(0)
    length := cstr_len(program)
    if (length > 0) {
        mut directory := directory_part(program, length)
        mut tries: i64 = 0
        while (tries < 3) {
            here := joined_path(program, directory, relative)
            if (unsafe { frost_rt_file_exists(here) } == 1) {
                return here
            }
            directory = directory_part(program, directory)
            tries = tries + 1
        }
    }
    relative
}

// Where the C stub is. FROST_RUNTIME names it outright.
runtime_source :: fn() -> ^i8 {
    named := unsafe { frost_rt_getenv("FROST_RUNTIME") }
    if (cstr_len(named) != 0) {
        return named
    }
    runtime_beside("runtime/frost_runtime.c")
}

// Where the Frost half is. FROST_RUNTIME_FROST names it, so a checkout that is
// not the working directory can say where both halves are rather than only one.
frost_runtime_source :: fn() -> ^i8 {
    named := unsafe { frost_rt_getenv("FROST_RUNTIME_FROST") }
    if (cstr_len(named) != 0) {
        return named
    }
    runtime_beside("runtime/runtime.frost")
}

// Whether two paths name one file.
//
// The comparison is between absolute paths with the separators read one way,
// because a path built by joining a directory the environment gave to a name
// this compiler chose carries both, and the same file reached two ways is still
// one file. On Windows it also ignores case, which is what that file system
// does.
same_path :: fn(first: ^i8, second: ^i8) -> bool {
    length := cstr_len(first)
    if (cstr_len(second) != length) {
        return false
    }
    windows := frost_rt_is_windows()
    mut k: i64 = 0
    while (k < length) {
        mut here := byte_at(first, k)
        mut there := byte_at(second, k)
        if (here == CH_BACKSLASH) {
            here = CH_SLASH
        }
        if (there == CH_BACKSLASH) {
            there = CH_SLASH
        }
        if (windows == 1) {
            if (here >= CH_UPPER_A && here <= CH_UPPER_Z) {
                here = here + 32
            }
            if (there >= CH_UPPER_A && there <= CH_UPPER_Z) {
                there = there + 32
            }
        }
        if (here != there) {
            return false
        }
        k = k + 1
    }
    true
}

// Whether the file being compiled is the runtime, which is the one file that
// may define a name in the runtime's own name space. Every other file gets the
// refusal, including a module a program imports.
compiling_the_runtime :: fn(path: ^i8) -> i64 {
    if (cstr_len(path) == 0) {
        return 0
    }
    // Each answer is a block of its own, so the second call does not stand on
    // the first.
    here := unsafe { frost_rt_absolute_path(path) }
    wanted := unsafe { frost_rt_absolute_path(frost_runtime_source()) }
    if (same_path(here, wanted)) {
        return 1
    }
    0
}

// Where the system keeps temporary files. The compiled runtime goes here rather
// than beside the program, so a link leaves nothing behind in the directory it
// was run from.
temp_directory :: fn() -> ^i8 {
    mut named := unsafe { frost_rt_getenv("TMPDIR") }
    if (cstr_len(named) == 0) {
        named = unsafe { frost_rt_getenv("TMP") }
    }
    if (cstr_len(named) == 0) {
        named = unsafe { frost_rt_getenv("TEMP") }
    }
    if (cstr_len(named) == 0) {
        named = "."
    }
    named
}

// The compiled C runtime, built once and linked thereafter. It is a compilation
// unit like any other and changes about as often as the C compiler does, so
// compiling it again for every link is most of what a build that assembled
// nothing spends. What the source holds is the name, so editing the runtime
// builds a new one and nothing else does.
cached_runtime_object :: fn(mark: ^i8) -> ^i8 {
    runtime := runtime_source()
    // A missing runtime checksums to the same 0 as any other missing file, so
    // saying which path was looked at beats letting the C compiler report a
    // file it was handed and letting the cache key collide meanwhile.
    if (unsafe { frost_rt_file_exists(runtime) } == 0) {
        report("frost: cannot find the runtime at '")
        report_cstr(runtime)
        report("'. FROST_RUNTIME names it, or install it beside the compiler\n")
        frost_rt_die()
    }
    mut key := file_checksum(runtime) % 1000000007
    if (key < 0) {
        key = -key
    }
    object := join_number(
        join_two(temp_directory(), "/frost_runtime_"),
        key,
        ".o"
    )
    if (unsafe { frost_rt_file_exists(object) } == 1) {
        return object
    }
    // Two builds running at once both find the cache empty and both fill it,
    // and a build reading an object another is still writing links garbage. So
    // the compile goes to a name this build alone uses, named after where its
    // own output is going, and the finished object is moved into place in the
    // one step the platform gives for it.
    pending := join_number(join_two(object, "."), cstr_checksum(mark), ".tmp")
    build := join_two(
        join_two(join_two(join_two(c_compiler(), " -c "), runtime), " -o "),
        pending
    )
    if (unsafe { frost_rt_run_command(build) } != 0) {
        report("frost: the runtime did not compile: ")
        report_cstr(build)
        report("\n")
        frost_rt_die()
    }
    move_file(pending, object)
    object
}

// The Frost half of the runtime, compiled by this compiler and cached the same
// way. `--native` writes an object and links nothing, so a build of the runtime
// never asks for a runtime and this reaches one level deep and stops.
//
// Running this compiler again rather than compiling the file in this process:
// reaching an object from a path is what the command line already is, and a
// second way in would be a second thing to hold to the checks the first one
// runs.
cached_frost_runtime_object :: fn(mark: ^i8) -> ^i8 {
    runtime := frost_runtime_source()
    if (unsafe { frost_rt_file_exists(runtime) } == 0) {
        report("frost: cannot find the runtime at '")
        report_cstr(runtime)
        report("'. FROST_RUNTIME_FROST names it, or install it beside the ")
        report("compiler\n")
        frost_rt_die()
    }
    mut key := file_checksum(runtime) % 1000000007
    if (key < 0) {
        key = -key
    }
    object := join_number(
        join_two(temp_directory(), "/frost_runtime_frost_"),
        key,
        ".o"
    )
    if (unsafe { frost_rt_file_exists(object) } == 1) {
        return object
    }
    pending := join_number(join_two(object, "."), cstr_checksum(mark), ".tmp")
    // The compiler's own path, quoted, since it is the one path here that came
    // from the shell rather than from the environment's temporary directory.
    build := join_two(
        join_two(
            join_two(
                join_two(join_two("\"", frost_rt_arg_at(0)), "\" --native -o "),
                pending
            ),
            " "
        ),
        runtime
    )
    if (unsafe { frost_rt_run_command(build) } != 0) {
        report("frost: the runtime did not compile: ")
        report_cstr(build)
        report("\n")
        frost_rt_die()
    }
    move_file(pending, object)
    object
}

// A number for a name, so a path can carry something of the build that made it
// without a process id to ask for.
cstr_checksum :: fn(text: ^i8) -> i64 {
    length := cstr_len(text)
    mut sum: i64 = length + 1
    mut k: i64 = 0
    while (k < length) {
        sum = wrap_add(wrap_mul(sum, 131), byte_at(text, k))
        k = k + 1
    }
    if (sum < 0) {
        sum = -sum
    }
    sum % 1000000007
}

// The same path written the way the Windows shell reads one. Paths here are
// built by joining a directory the environment gave with a name this compiler
// chose, so they carry both separators, and `move` refuses the mixture.
backslashed :: fn(path: ^i8) -> ^i8 {
    length := cstr_len(path)
    out := unsafe { ptr_cast($i8, frost_rt_alloc(length + 1)) }
    mut k: i64 = 0
    while (k < length) {
        held := byte_at(path, k)
        if (held == CH_SLASH) {
            held = CH_BACKSLASH
        }
        byte_set(out, k, held)
        k = k + 1
    }
    byte_set(out, length, 0)
    out
}

// One name replaced by another, which the shell does in one step on either
// platform. This is the second of the three places that knows which one it is
// running on.
// What it has to say goes nowhere: a compiler with no `-o` writes the program
// it emitted to standard output, and a shell announcing a file it moved would
// land in the middle of it.
move_file :: fn(from: ^i8, to: ^i8) {
    mut command := join_two(join_two(join_two("mv -f ", from), " "), to)
    if (frost_rt_is_windows() == 1) {
        command = join_two(
            join_two(join_two("move /Y \"", backslashed(from)), "\" \""),
            backslashed(to)
        )
        command = join_two(command, "\"")
    }
    command = join_two(command, " > ")
    if (frost_rt_is_windows() == 1) {
        command = join_two(command, "nul 2>&1")
    } else {
        command = join_two(command, "/dev/null 2>&1")
    }
    unsafe { frost_rt_run_command(command) }
}

// The directory the objects go in, made if it is not there. The shell is what
// makes a directory on either platform, and the command differs, so this is one
// of the three places that knows which one it is running on.
make_directory :: fn(path: ^i8) {
    mut command := join_two("mkdir -p ", path)
    if (frost_rt_is_windows() == 1) {
        command = join_two(join_two("if not exist \"", path), "\" mkdir \"")
        command = join_two(join_two(command, path), "\"")
    }
    unsafe { frost_rt_run_command(command) }
}

// One part of a command line, quoted and with a space in front, since the line
// goes to a shell and a path with a space in it is one argument rather than two.
quoted_after :: fn(line: ^i8, part: ^i8) -> ^i8 {
    join_two(join_two(join_two(line, " \""), part), "\"")
}

// A command line the shell will read whole. `cmd` takes a line that begins and
// ends with a quote and strips that pair before reading the rest, which turns a
// quoted program followed by a quoted last argument into something it cannot
// find. A pair of its own is what gets stripped instead. This is the third of
// the three places that knows which platform it is running on.
shell_line :: fn(command: ^i8) -> ^i8 {
    if (frost_rt_is_windows() == 1) {
        return join_two(join_two("\"", command), "\"")
    }
    command
}

// Whether a path names a Frost source, which is what decides if the formatter
// is run over what a generator wrote.
ends_in_frost :: fn(path: ^i8) -> bool {
    length := cstr_len(path)
    suffix: ^i8 = ".frost"
    wanted := cstr_len(suffix)
    if (length < wanted) {
        return false
    }
    mut k: i64 = 0
    while (k < wanted) {
        if (byte_at(path, length - wanted + k) != byte_at(suffix, k)) {
            return false
        }
        k = k + 1
    }
    true
}

// Where a `--check` writes instead of over the declared output.
//
// In the temporary directory, so a check that stops partway leaves nothing in
// the tree, and under the output's own file name so the extension survives and
// the formatter reads it as the kind of file it is. The number in front is the
// whole output path, so two projects writing a file of the same name do not
// check each other's.
generated_scratch :: fn(output: ^i8) -> ^i8 {
    join_two(
        join_number(
            join_two(temp_directory(), "/frost_generate_"),
            cstr_checksum(output),
            "_"
        ),
        file_name(output)
    )
}

// Whether two files hold the same bytes.
//
// Read by length rather than to a terminator, since what a generator writes is
// whatever it writes and a zero among those bytes would end the comparison
// early. Each read is its own statement, because the length of one is asked for
// after it and before the next read replaces it.
same_contents :: fn(first: ^i8, second: ^i8) -> bool {
    if (unsafe { frost_rt_file_exists(first) } == 0
        || unsafe { frost_rt_file_exists(second) } == 0) {
        return false
    }
    held := unsafe { frost_rt_file_read(first) }
    held_length := unsafe { frost_rt_file_size() }
    other := unsafe { frost_rt_file_read(second) }
    other_length := unsafe { frost_rt_file_size() }
    if (held_length != other_length || held_length < 0) {
        return false
    }
    mut k: i64 = 0
    while (k < held_length) {
        if (byte_at(held, k) != byte_at(other, k)) {
            return false
        }
        k = k + 1
    }
    true
}

// `frost generate [--check]`: write every file the project's manifest says a
// program of its own writes.
//
// The generator is compiled and run by this compiler, so a checkout holding two
// compilers regenerates with whichever one was asked. Its arguments are the
// output path first and the declared inputs after, which is the order a program
// written before any manifest existed already took.
//
// A step always writes, and `--check` writes somewhere else and compares the
// bytes. Staleness is decided from content because a checkout stamps every file
// with the time it was made, so a timestamp says nothing about whether the
// generator would write something different.
run_generators :: fn(checking: bool) -> i64 {
    // The manifest is looked for above the directory the command was run in,
    // since `generate` names no file to start from the way a build does.
    here := join_two(unsafe { frost_rt_absolute_path(".") }, "/frost")
    if (cstr_len(manifest_above(here)) == 0) {
        report("frost generate: no frost.json declares this project\n")
        return 0
    }
    mut steps: Arena<Generator> = arena_make($Generator, 16)
    manifest_generators(here, steps)
    if (steps.count == 0) {
        report("frost generate: this project declares nothing to generate\n")
        return 0
    }
    compiler := unsafe { frost_rt_absolute_path(frost_rt_arg_at(0)) }
    mut settled: i64 = 0
    mut index: i64 = 0
    while (index < steps.count) {
        step := arena_at(steps, index)
        mut written := step.output
        if (checking) {
            written = generated_scratch(step.output)
        }
        mut command := quoted_after(quoted_after("", compiler), "run")
        command = quoted_after(quoted_after(command, step.from), written)
        command = join_two(command, step.inputs)
        if (unsafe { frost_rt_run_command(shell_line(command)) } != 0) {
            // What went wrong was said by whatever ran, on the stream this
            // shares, so this names the step rather than repeating it.
            report("frost generate: ")
            report_cstr(step.from_named)
            report(" did not write ")
            report_cstr(step.output_named)
            report("\n")
            return 1
        }
        // A generator lays its output out to be read while it assembles it, and
        // the tree holds every Frost file to one rendering. Formatting here is
        // what makes those two agree, so `--check` compares what a build leaves
        // on disk rather than the form on the way there.
        if (ends_in_frost(written)) {
            mut rendering := quoted_after(quoted_after("", compiler), "fmt")
            rendering = quoted_after(rendering, written)
            if (unsafe { frost_rt_run_command(shell_line(rendering)) } != 0) {
                report("frost generate: the formatter refused ")
                report_cstr(step.output_named)
                report("\n")
                return 1
            }
        }
        if (checking == false) {
            report("frost generate: wrote ")
            report_cstr(step.output_named)
            report("\n")
            index = index + 1
            continue
        }
        matched := same_contents(written, step.output)
        unsafe { frost_rt_remove_file(written) }
        if (matched) {
            report("frost generate: ")
            report_cstr(step.output_named)
            report(" is up to date\n")
        } else {
            settled = 1
            report("frost generate: ")
            report_cstr(step.output_named)
            report(" is not what ")
            report_cstr(step.from_named)
            report(" writes. Run `frost generate`\n")
        }
        index = index + 1
    }
    settled
}

// An argument beginning with `-` that nothing above claimed is a mistake worth
// naming rather than a file name, since taking it as one produces a confusing
// error about an unreadable file much later.
looks_like_a_flag :: fn(text: ^i8) -> bool {
    (cstr_len(text) > 0
        && byte_at(text, 0) == CH_MINUS)
}

options_from_command_line :: fn() -> Options {
    mut options := Options {
        input = "",
        output = "",
        backend = Backend::Unset,
        link = 0,
        object = 0,
        assemble = 0,
        testing = 0,
        running = 0,
        run_args = "",
        audit_unsafe = 0,
        linting = 0,
        debug_lines = 0,
        libs = "",
        roots = arena_make($SearchRoot, 64),
        layers = arena_make($Layer, 16),
        incremental = 0,
        build_dir = ".frost-build",
        help = 0,
        ok = 1,
    }
    count := frost_rt_arg_count()
    mut index: i64 = 1
    while (index < count) {
        argument := frost_rt_arg_at(index)
        if (index == 1 && cstr_eq(argument, "lint")) {
            options.linting = 1
            index = index + 1
            continue
        }
        // `run <file> [args...]`: the file is the only thing the compiler reads
        // off the line, and everything after it is the program's own. The split
        // is what puts a program's `--check` in front of the program rather
        // than in front of this. Each argument is quoted, since the line goes
        // to a shell and a path with a space in it is one argument.
        if (index == 1 && cstr_eq(argument, "run")) {
            options.running = 1
            options.link = 1
            index = index + 1
            if (index >= count) {
                report("frost run: which file?\n")
                options.ok = 0
                return options
            }
            options.input = frost_rt_arg_at(index)
            options.output = join_number(
                join_two(temp_directory(), "/frost_run_"),
                cstr_checksum(options.input),
                ".exe"
            )
            index = index + 1
            while (index < count) {
                options.run_args = join_two(
                    join_two(
                        join_two(options.run_args, " \""),
                        frost_rt_arg_at(index)
                    ),
                    "\""
                )
                index = index + 1
            }
            continue
        }
        if (cstr_eq(argument, "--diagnostics=json")) {
            index = index + 1
            continue
        }
        if (cstr_eq(argument, "--diagnostics")) {
            index = index + 2
            continue
        }
        if (cstr_eq(argument, "-h") || cstr_eq(argument, "--help")) {
            options.help = 1
            return options
        }
        if (cstr_eq(argument, "--emit-c")) {
            options.backend = Backend::C
        } else if (cstr_eq(argument, "--emit-asm")) {
            options.backend = Backend::Asm
        } else if (cstr_eq(argument, "--native") || cstr_eq(argument, "-n")) {
            // An object, which is what the bootstrap's `--native` answers with.
            // `--emit-asm` is the assembly on its own.
            options.backend = Backend::Asm
            options.object = 1
        } else if (cstr_eq(argument, "--libs")) {
            index = index + 1
            if (index >= count) {
                report("frost: --libs needs an object file or library")
                options.ok = 0
                return options
            }
            options.libs = join_two(
                join_two(options.libs, " "),
                frost_rt_arg_at(index)
            )
        } else if (cstr_len(value_after(argument, "--libs=")) != 0) {
            options.libs = join_two(
                join_two(options.libs, " "),
                value_after(argument, "--libs=")
            )
        } else if (cstr_len(value_after(argument, "--build-dir=")) != 0) {
            options.build_dir = value_after(argument, "--build-dir=")
        } else if (cstr_len(value_after(argument, "-L")) != 0) {
            add_root(options.roots, value_after(argument, "-L"))
        } else if (cstr_len(value_after(argument, "-o")) != 0) {
            options.output = value_after(argument, "-o")
        } else if (cstr_eq(argument, "--link") || cstr_eq(argument, "-l")) {
            options.link = 1
        } else if (cstr_eq(argument, "--run-ir")
            || cstr_eq(argument, "--freestanding")) {
            // Both name a path only the bootstrap has: it carries an IR
            // interpreter and a libc-free runtime, and this compiler carries
            // neither. Saying so beats reporting the option as unknown, which
            // reads as a spelling mistake.
            report("frost: '")
            report_cstr(argument)
            report("' is a bootstrap option, and this compiler has no such path")
            options.ok = 0
            return options
        } else if (cstr_eq(argument, "--assemble")) {
            options.assemble = 1
        } else if (cstr_eq(argument, "--incremental")) {
            // One object per module, and only the modules whose emitted code
            // changed are assembled again. A build that keeps objects is a
            // build that links them, so this links.
            options.incremental = 1
            options.link = 1
        } else if (cstr_eq(argument, "--build-dir")) {
            index = index + 1
            if (index >= count) {
                report("frost: --build-dir needs a directory")
                options.ok = 0
                return options
            }
            options.build_dir = frost_rt_arg_at(index)
        } else if (cstr_eq(argument, "-g") || cstr_eq(argument, "--debug")) {
            options.debug_lines = 1
        } else if (cstr_eq(argument, "--audit-unsafe")) {
            options.audit_unsafe = 1
        } else if (cstr_eq(argument, "--test")) {
            // Running the tests means building an executable and running it,
            // so a --test build always links as well.
            options.testing = 1
            options.link = 1
        } else if (cstr_eq(argument, "-L")) {
            index = index + 1
            if (index >= count) {
                report("frost: -L needs a directory")
                options.ok = 0
                return options
            }
            add_root(options.roots, frost_rt_arg_at(index))
        } else if (cstr_eq(argument, "-o")) {
            index = index + 1
            if (index >= count) {
                report("frost: -o needs a path")
                options.ok = 0
                return options
            }
            options.output = frost_rt_arg_at(index)
        } else if (looks_like_a_flag(argument)) {
            report("frost: unknown option '")
            report_cstr(argument)
            report("'")
            options.ok = 0
            return options
        } else {
            options.input = argument
        }
        index = index + 1
    }

    // The environment answers for whatever the arguments did not say, which is
    // what keeps the fixpoint checks and the older callers working unchanged.
    if (cstr_len(options.input) == 0) {
        options.input = unsafe { frost_rt_getenv("FROST_INPUT") }
    }
    // Linking produces a program, and the assembler turns this compiler's own
    // output into one for a fraction of what handing a C compiler a generated
    // translation unit costs. Emitting on its own stays C, which is the
    // portable answer and what a caller reading the output is asking for.
    if (options.backend == Backend::Unset) {
        named := unsafe { frost_rt_getenv("FROST_BACKEND") }
        if (cstr_eq(named, "asm")) {
            options.backend = Backend::Asm
        } else if (cstr_eq(named, "c")) {
            options.backend = Backend::C
        } else if (options.link == 1) {
            options.backend = Backend::Asm
        } else {
            options.backend = Backend::C
        }
    }
    options
}
