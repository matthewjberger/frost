// The command line covers what to compile, which backend to put it through,
// where the result goes, and whether to finish the build by calling the system
// toolchain.

import "core.frost"
import "imports.frost"

export Backend, Options, c_compiler, join_two, join_number,
    file_checksum, stored_checksum, write_checksum, make_directory,
    cached_runtime_object, options_from_command_line, usage

// Which backend the program goes through. Nothing is chosen until the arguments
// and the environment have both had their say, so the answer starts as nothing.
Backend :: enum { Unset, C, Asm }

// `ok` is 0 when the arguments did not make sense, which is separate from
// `help`, since one exits with a failure and the other does not.
Options :: struct {
    input: ^i8,
    output: ^i8,
    backend: Backend,
    link: i64,
    // Assemble the emitted text into an object rather than leaving it as
    // assembly, which is what `--native` answers with in both compilers.
    object: i64,
    // Turn an assembly file into an object with this compiler's own encoder,
    // rather than compiling a Frost source at all.
    assemble: i64,
    testing: i64,
    audit_unsafe: i64,
    // Object files and libraries the link is given, in the order written, as
    // one string ready to hand the toolchain.
    libs: ^i8,
    roots: Arena<SearchRoot>,
    // Compile each module to its own object and assemble only the ones whose
    // emitted code changed. `build_dir` is where those objects are kept.
    incremental: i64,
    build_dir: ^i8,
    help: i64,
    ok: i64,
}

usage :: fn() {
    report("the Frost compiler\n\n")
    report("    frost [options] <file.frost>\n\n")
    report("    -o <path>     where to write the result\n")
    report("    -L <dir>      a directory to find imports under\n")
    report("    --emit-c      emit a C translation unit (the default)\n")
    report("    --emit-asm    emit x86-64 assembly\n")
    report("    -n, --native  compile to an object file\n")
    report("    -l, --link    assemble and link an executable\n")
    report("    --libs <item> an object file or library to link. Repeatable\n")
    report("    --incremental one object per module, assembling only what changed\n")
    report("    --build-dir <dir>  where those objects are kept\n")
    report("    --assemble    turn an assembly file into an object, with\n")
    report("                  this compiler's own encoder rather than `as`\n")
    report("    --test        build and run the file's `test` blocks\n")
    report("    --audit-unsafe  also report every `unsafe` block vouching for nothing\n")
    report("    -h, --help    this\n\n")
    report("Without -o the output goes to standard output. FROST_INPUT ")
    report("and\nFROST_BACKEND are read when the matching argument is ")
    report("absent.\n")
    report("--run-ir and --freestanding are bootstrap options with no path ")
    report("here.\n")
}

// Which C toolchain the emitted translation unit goes to. `CC` overrides, as
// every build system expects. Otherwise the default follows the platform the way
// the bootstrap's own linker search does, preferring gcc on Windows, where a
// bare `cc` is often a stub that answers `--version` and then fails to compile
// anything, which reads as a broken compiler rather than a missing toolchain.
c_compiler :: fn() -> ^i8 {
    chosen := unsafe { frost_rt_getenv("CC") }
    if (cstr_len(chosen) != 0) {
        return chosen
    }
    if (frost_rt_is_windows() == 1) {
        return "gcc"
    }
    "cc"
}

// The text after `--flag=` when an argument is written that way, and an empty
// string when the argument is something else. A caller that also takes the
// value as a separate word checks that first.
value_after :: fn(argument: ^i8, flag: ^i8) -> ^i8 {
    flag_len := cstr_len(flag)
    argument_len := cstr_len(argument)
    if (argument_len <= flag_len) {
        return ""
    }
    mut k : i64 = 0
    while (k < flag_len) {
        if (byte_at(argument, k) != byte_at(flag, k)) {
            return ""
        }
        k = k + 1
    }
    rest := argument_len - flag_len
    out := unsafe { ptr_cast($i8, malloc(rest + 1)) }
    k = 0
    while (k < rest) {
        byte_set(out, k, byte_at(argument, flag_len + k))
        k = k + 1
    }
    byte_set(out, rest, 0)
    out
}

// Two strings end to end, in memory the caller keeps. Command lines and derived
// file names are the only strings this compiler builds rather than points into.
join_two :: fn(first: ^i8, second: ^i8) -> ^i8 {
    first_len := cstr_len(first)
    second_len := cstr_len(second)
    out := unsafe { ptr_cast($i8, malloc(first_len + second_len + 1)) }
    mut k : i64 = 0
    while (k < first_len) {
        byte_set(out, k, byte_at(first, k))
        k = k + 1
    }
    k = 0
    while (k < second_len) {
        unsafe {
            byte_set(out, first_len + k, byte_at(second, k))
        }
        k = k + 1
    }
    byte_set(out, first_len + second_len, 0)
    out
}

// A string with a number after it, for the per-module file names an
// incremental build works with: `<build>/m3.s` and `<build>/m3.o`.
join_number :: fn(first: ^i8, number: i64, last: ^i8) -> ^i8 {
    mut digits : i64 = 1
    mut scale : i64 = 1
    mut counted := number
    while (counted >= 10) {
        counted = counted / 10
        digits = digits + 1
        scale = scale * 10
    }
    first_len := cstr_len(first)
    last_len := cstr_len(last)
    out := unsafe {
        ptr_cast($i8, malloc(first_len + digits + last_len + 1))
    }
    mut k : i64 = 0
    while (k < first_len) {
        byte_set(out, k, byte_at(first, k))
        k = k + 1
    }
    mut value := number
    mut written : i64 = 0
    while (written < digits) {
        digit := value / scale
        unsafe {
            byte_set(out, first_len + written, CH_0 + digit)
        }
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    k = 0
    while (k < last_len) {
        unsafe {
            byte_set(out, first_len + digits + k,
                byte_at(last, k))
        }
        k = k + 1
    }
    byte_set(out, first_len + digits + last_len, 0)
    out
}

// What a file holds, as one number. This is the whole of the cache: the
// compiler has just written what a module compiles to, so whether that module's
// object is stale is a question about those bytes and nothing else. No hash of
// the source, no interface fingerprint, no dependency graph, because the answer
// is already in hand. A file that is not there answers 0, which no emitted unit
// does, so the first build of a module builds it.
file_checksum :: fn(path: ^i8) -> i64 {
    if (unsafe { frost_rt_file_exists(path) } == 0) {
        return 0
    }
    text := unsafe { frost_rt_read_file(path) }
    length := cstr_len(text)
    mut sum : i64 = length + 1
    mut k : i64 = 0
    while (k < length) {
        sum = sum * 131 + byte_at(text, k)
        k = k + 1
    }
    sum
}

// The number a previous build left beside a module's object, or 0 for a module
// nothing has built yet.
stored_checksum :: fn(path: ^i8) -> i64 {
    if (unsafe { frost_rt_file_exists(path) } == 0) {
        return 0
    }
    text := unsafe { frost_rt_read_file(path) }
    length := cstr_len(text)
    mut value : i64 = 0
    mut negative : bool = false
    mut k : i64 = 0
    while (k < length) {
        byte := byte_at(text, k)
        if (byte == CH_MINUS) {
            negative = true
        }
        if (byte >= CH_0 && byte <= CH_9) {
            value = value * 10 + (byte - CH_0)
        }
        k = k + 1
    }
    if (negative) {
        return 0 - value
    }
    value
}

write_checksum :: fn(path: ^i8, value: i64) {
    if (unsafe { frost_rt_emit_open(path) } == 0) {
        report("frost: cannot write '")
        report_cstr(path)
        report("'")
        frost_rt_die()
    }
    frost_rt_emit_int(value)
    frost_rt_emit_close()
}

// Where the C runtime is. FROST_RUNTIME names it outright. Otherwise it is
// looked for beside the compiler and then up the directories a checkout puts it
// under, which is the search the standard library gets, so a compiler run from
// somewhere other than the directory it was built in still finds it.
runtime_source :: fn() -> ^i8 {
    named := unsafe { frost_rt_getenv("FROST_RUNTIME") }
    if (cstr_len(named) != 0) {
        return named
    }
    program := frost_rt_arg_at(0)
    length := cstr_len(program)
    if (length > 0) {
        mut directory := directory_part(program, length)
        mut tries : i64 = 0
        while (tries < 3) {
            here := joined_path(program, directory,
                "runtime/frost_runtime.c")
            if (unsafe { frost_rt_file_exists(here) } == 1) {
                return here
            }
            directory = directory_part(program, directory)
            tries = tries + 1
        }
    }
    "runtime/frost_runtime.c"
}

// Where the system keeps temporary files. The compiled runtime goes here rather
// than beside the program, so a link leaves nothing behind in the directory it
// was run from.
temp_directory :: fn() -> ^i8 {
    mut named := unsafe { frost_rt_getenv("TMPDIR") }
    if (cstr_len(named) == 0) {
        named = unsafe { frost_rt_getenv("TMP") }
    }
    if (cstr_len(named) == 0) {
        named = unsafe { frost_rt_getenv("TEMP") }
    }
    if (cstr_len(named) == 0) {
        named = "."
    }
    named
}

// The compiled C runtime, built once and linked thereafter. It is a compilation
// unit like any other and changes about as often as the C compiler does, so
// compiling it again for every link is most of what a build that assembled
// nothing spends. What the source holds is the name, so editing the runtime
// builds a new one and nothing else does.
cached_runtime_object :: fn() -> ^i8 {
    runtime := runtime_source()
    // A missing runtime checksums to the same 0 as any other missing file, so
    // saying which path was looked at beats letting the C compiler report a
    // file it was handed and letting the cache key collide meanwhile.
    if (unsafe { frost_rt_file_exists(runtime) } == 0) {
        report("frost: cannot find the runtime at '")
        report_cstr(runtime)
        report("'. FROST_RUNTIME names it, or install it beside the compiler\n")
        frost_rt_die()
    }
    mut key := file_checksum(runtime) % 1000000007
    if (key < 0) {
        key = 0 - key
    }
    object := join_number(join_two(temp_directory(), "/frost_runtime_"), key,
        ".o")
    if (unsafe { frost_rt_file_exists(object) } == 1) {
        return object
    }
    build := join_two(
        join_two(join_two(join_two(c_compiler(), " -c "), runtime), " -o "),
        object)
    if (unsafe { frost_rt_run_command(build) } != 0) {
        report("frost: the runtime did not compile: ")
        report_cstr(build)
        report("\n")
        frost_rt_die()
    }
    object
}

// The directory the objects go in, made if it is not there. The shell is what
// makes a directory on either platform, and the command differs, so this is one
// of the two places that knows which one it is running on.
make_directory :: fn(path: ^i8) {
    mut command := join_two("mkdir -p ", path)
    if (frost_rt_is_windows() == 1) {
        command = join_two(join_two("if not exist \"", path),
            "\" mkdir \"" )
        command = join_two(join_two(command, path), "\"")
    }
    unsafe { frost_rt_run_command(command) }
}

// An argument beginning with `-` that nothing above claimed is a mistake worth
// naming rather than a file name, since taking it as one produces a confusing
// error about an unreadable file much later.
looks_like_a_flag :: fn(text: ^i8) -> bool {
    cstr_len(text) > 0
        && byte_at(text, 0) == CH_MINUS
}

options_from_command_line :: fn() -> Options {
    mut options := Options {
        input = "",
        output = "",
        backend = Backend::Unset,
        link = 0,
        object = 0,
        assemble = 0,
        testing = 0,
        audit_unsafe = 0,
        libs = "",
        roots = arena_make($SearchRoot, 64),
        incremental = 0,
        build_dir = ".frost-build",
        help = 0,
        ok = 1,
    }
    count := frost_rt_arg_count()
    mut index : i64 = 1
    while (index < count) {
        argument := frost_rt_arg_at(index)
        if (cstr_eq(argument, "-h") || cstr_eq(argument, "--help")) {
            options.help = 1
            return options
        }
        if (cstr_eq(argument, "--emit-c")) {
            options.backend = Backend::C
        } else if (cstr_eq(argument, "--emit-asm")) {
            options.backend = Backend::Asm
        } else if (cstr_eq(argument, "--native") || cstr_eq(argument, "-n")) {
            // An object, which is what the bootstrap's `--native` answers with.
            // `--emit-asm` is the assembly on its own.
            options.backend = Backend::Asm
            options.object = 1
        } else if (cstr_eq(argument, "--libs")) {
            index = index + 1
            if (index >= count) {
                report("frost: --libs needs an object file or library")
                options.ok = 0
                return options
            }
            options.libs = join_two(join_two(options.libs, " "),
                frost_rt_arg_at(index))
        } else if (cstr_len(value_after(argument, "--libs=")) != 0) {
            options.libs = join_two(join_two(options.libs, " "),
                value_after(argument, "--libs="))
        } else if (cstr_len(value_after(argument, "--build-dir=")) != 0) {
            options.build_dir = value_after(argument, "--build-dir=")
        } else if (cstr_len(value_after(argument, "-L")) != 0) {
            add_root(options.roots, value_after(argument, "-L"))
        } else if (cstr_len(value_after(argument, "-o")) != 0) {
            options.output = value_after(argument, "-o")
        } else if (cstr_eq(argument, "--link") || cstr_eq(argument, "-l")) {
            options.link = 1
        } else if (cstr_eq(argument, "--run-ir")
            || cstr_eq(argument, "--freestanding")) {
            // Both name a path only the bootstrap has: it carries an IR
            // interpreter and a libc-free runtime, and this compiler carries
            // neither. Saying so beats reporting the option as unknown, which
            // reads as a spelling mistake.
            report("frost: '")
            report_cstr(argument)
            report("' is a bootstrap option, and this compiler has no such path")
            options.ok = 0
            return options
        } else if (cstr_eq(argument, "--assemble")) {
            options.assemble = 1
        } else if (cstr_eq(argument, "--incremental")) {
            // One object per module, and only the modules whose emitted code
            // changed are assembled again. A build that keeps objects is a
            // build that links them, so this links.
            options.incremental = 1
            options.link = 1
        } else if (cstr_eq(argument, "--build-dir")) {
            index = index + 1
            if (index >= count) {
                report("frost: --build-dir needs a directory")
                options.ok = 0
                return options
            }
            options.build_dir = frost_rt_arg_at(index)
        } else if (cstr_eq(argument, "--audit-unsafe")) {
            options.audit_unsafe = 1
        } else if (cstr_eq(argument, "--test")) {
            // Running the tests means building an executable and running it,
            // so a --test build always links as well.
            options.testing = 1
            options.link = 1
        } else if (cstr_eq(argument, "-L")) {
            index = index + 1
            if (index >= count) {
                report("frost: -L needs a directory")
                options.ok = 0
                return options
            }
            add_root(options.roots, frost_rt_arg_at(index))
        } else if (cstr_eq(argument, "-o")) {
            index = index + 1
            if (index >= count) {
                report("frost: -o needs a path")
                options.ok = 0
                return options
            }
            options.output = frost_rt_arg_at(index)
        } else if (looks_like_a_flag(argument)) {
            report("frost: unknown option '")
            report_cstr(argument)
            report("'")
            options.ok = 0
            return options
        } else {
            options.input = argument
        }
        index = index + 1
    }

    // The environment answers for whatever the arguments did not say, which is
    // what keeps the fixpoint checks and the older callers working unchanged.
    if (cstr_len(options.input) == 0) {
        options.input = unsafe { frost_rt_getenv("FROST_INPUT") }
    }
    // Linking produces a program, and the assembler turns this compiler's own
    // output into one for a fraction of what handing a C compiler a generated
    // translation unit costs. Emitting on its own stays C, which is the
    // portable answer and what a caller reading the output is asking for.
    if (options.backend == Backend::Unset) {
        named := unsafe { frost_rt_getenv("FROST_BACKEND") }
        if (cstr_eq(named, "asm")) {
            options.backend = Backend::Asm
        } else if (cstr_eq(named, "c")) {
            options.backend = Backend::C
        } else if (options.link == 1) {
            options.backend = Backend::Asm
        } else {
            options.backend = Backend::C
        }
    }
    options
}
