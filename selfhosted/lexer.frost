// The lexer turns source bytes into a flat arena of tokens, in one pass.

import "core.frost"

export str_range_eq, tokenize

// Whether `0` is followed by a radix mark, which is what makes the number that
// starts here hex or binary rather than decimal.
is_radix_mark :: fn(c: i64) -> bool {
    c == CH_LOWER_X || c == CH_UPPER_X || c == CH_LOWER_B || c == CH_UPPER_B
}

is_radix_digit :: fn(c: i64, base: i64) -> bool {
    if (base == 2) {
        return c == CH_0 || c == CH_0 + 1
    }
    (is_digit(c) || (c >= CH_LOWER_A && c <= CH_LOWER_F)
        || (c >= CH_UPPER_A && c <= CH_UPPER_F))
}

radix_digit :: fn(c: i64) -> i64 {
    if (c >= CH_LOWER_A && c <= CH_LOWER_F) {
        return c - CH_LOWER_A + 10
    }
    if (c >= CH_UPPER_A && c <= CH_UPPER_F) {
        return c - CH_UPPER_A + 10
    }
    c - CH_0
}

// An `e` with digits after it, or a sign and then digits. Anything else after a
// number is the next token, `1.eq(x)` among them.
starts_exponent :: fn(src: str, i: i64, len: i64) -> bool {
    held := byte_of(src, i, len)
    if (held != CH_LOWER_E && held != CH_UPPER_E) {
        return false
    }
    next := byte_of(src, i + 1, len)
    if (is_digit(next)) {
        return true
    }
    if (next != CH_PLUS && next != CH_MINUS) {
        return false
    }
    is_digit(byte_of(src, i + 2, len))
}

is_digit :: fn(c: i64) -> bool {
    c >= CH_0 && c <= CH_9
}

is_ident_start :: fn(c: i64) -> bool {
    ((c >= CH_LOWER_A && c <= CH_LOWER_Z)
        || (c >= CH_UPPER_A && c <= CH_UPPER_Z)
        || c == CH_UNDERSCORE)
}

is_ident_cont :: fn(c: i64) -> bool {
    is_ident_start(c) || (c >= CH_0 && c <= CH_9)
}

// ---------------------------------------------------------------------------
// Lexer. One pass over the source builds a flat arena of tokens, holding
// identifiers (keywords classified to their own kind), integer and string
// literals, and every operator and punctuation mark. Whitespace and `//`
// comments are dropped here so the parser never sees them.
// ---------------------------------------------------------------------------

byte_of :: fn(src: str, index: i64, len: i64) -> i64 {
    if (index >= len) {
        return -1
    }
    src[index]
}

// Every identifier is asked about every keyword, so this runs about a million
// times for a file of a few thousand lines. Comparing straight away answers on
// the first byte for almost every pair, where measuring the word's length first
// would walk it to its terminator before comparing anything. The terminator
// check at the end keeps a word that merely starts the same from matching.
str_range_eq :: fn(src: str, off: i64, len: i64, word: ^i8) -> bool {
    var k: i64 = 0
    while (k < len) {
        byte := byte_at(word, k)
        if (byte == 0 || src[off + k] != byte) {
            return false
        }
        k = k + 1
    }
    byte_at(word, len) == 0
}

// Every identifier in the source is asked whether it is a keyword, so asking
// about each in turn is one comparison per keyword for every name a program
// mentions. A keyword's length rules out all but a handful before any bytes
// are looked at.
classify_ident :: fn(src: str, off: i64, len: i64) -> TokenKind {
    if (len == 1 && str_range_eq(src, off, len, "_")) {
        return TokenKind::Underscore
    }
    if (len == 2) {
        if (str_range_eq(src, off, len, "fn")) {
            return TokenKind::KwFn
        }
        if (str_range_eq(src, off, len, "if")) {
            return TokenKind::KwIf
        }
        if (str_range_eq(src, off, len, "in")) {
            return TokenKind::KwIn
        }
    } else if (len == 3) {
        if (str_range_eq(src, off, len, "for")) {
            return TokenKind::KwFor
        }
        if (str_range_eq(src, off, len, "mut")) {
            return TokenKind::KwMut
        }
        if (str_range_eq(src, off, len, "ref")) {
            return TokenKind::KwRef
        }
        if (str_range_eq(src, off, len, "var")) {
            return TokenKind::KwVar
        }
    } else if (len == 4) {
        if (str_range_eq(src, off, len, "case")) {
            return TokenKind::KwCase
        }
        if (str_range_eq(src, off, len, "else")) {
            return TokenKind::KwElse
        }
        if (str_range_eq(src, off, len, "enum")) {
            return TokenKind::KwEnum
        }
        if (str_range_eq(src, off, len, "move")) {
            return TokenKind::KwMove
        }
        if (str_range_eq(src, off, len, "safe")) {
            return TokenKind::KwSafe
        }
        if (str_range_eq(src, off, len, "test")) {
            return TokenKind::KwTest
        }
        if (str_range_eq(src, off, len, "uses")) {
            return TokenKind::KwUses
        }
        if (str_range_eq(src, off, len, "with")) {
            return TokenKind::KwWith
        }
    } else if (len == 5) {
        if (str_range_eq(src, off, len, "break")) {
            return TokenKind::KwBreak
        }
        if (str_range_eq(src, off, len, "defer")) {
            return TokenKind::KwDefer
        }
        if (str_range_eq(src, off, len, "match")) {
            return TokenKind::KwMatch
        }
        if (str_range_eq(src, off, len, "where")) {
            return TokenKind::KwWhere
        }
        if (str_range_eq(src, off, len, "while")) {
            return TokenKind::KwWhile
        }
    } else if (len == 6) {
        if (str_range_eq(src, off, len, "export")) {
            return TokenKind::KwExport
        }
        if (str_range_eq(src, off, len, "extern")) {
            return TokenKind::KwExtern
        }
        if (str_range_eq(src, off, len, "import")) {
            return TokenKind::KwImport
        }
        if (str_range_eq(src, off, len, "inline")) {
            return TokenKind::KwInline
        }
        if (str_range_eq(src, off, len, "linear")) {
            return TokenKind::KwLinear
        }
        if (str_range_eq(src, off, len, "return")) {
            return TokenKind::KwReturn
        }
        if (str_range_eq(src, off, len, "struct")) {
            return TokenKind::KwStruct
        }
        if (str_range_eq(src, off, len, "unsafe")) {
            return TokenKind::KwUnsafe
        }
    } else if (len == 8) {
        if (str_range_eq(src, off, len, "continue")) {
            return TokenKind::KwContinue
        }
        if (str_range_eq(src, off, len, "distinct")) {
            return TokenKind::KwDistinct
        }
        if (str_range_eq(src, off, len, "errdefer")) {
            return TokenKind::KwErrDefer
        }
    }
    TokenKind::Ident
}

push_token :: fn(mut tokens: Arena<Token>, kind: TokenKind, off: i64, len: i64,
    value: i64) {
    id := arena_push(tokens, Token { kind = kind, off = off, len = len,
            value = value })
    id
}

lex_operator :: fn(src: str, i: i64, len: i64, mut tokens: Arena<Token>) -> i64 {
    c := byte_of(src, i, len)
    d := byte_of(src, i + 1, len)
    if (c == CH_COLON && d == CH_COLON) {
        push_token(tokens, TokenKind::Coloncolon, i, 2, 0)
        return i + 2
    }
    if (c == CH_COLON && d == CH_EQ) {
        push_token(tokens, TokenKind::Coloneq, i, 2, 0)
        return i + 2
    }
    if (c == CH_MINUS && d == CH_GT) {
        push_token(tokens, TokenKind::Arrow, i, 2, 0)
        return i + 2
    }
    if (c == CH_LT && d == CH_EQ) {
        push_token(tokens, TokenKind::Le, i, 2, 0)
        return i + 2
    }
    if (c == CH_GT && d == CH_EQ) {
        push_token(tokens, TokenKind::Ge, i, 2, 0)
        return i + 2
    }
    if (c == CH_LT && d == CH_LT) {
        push_token(tokens, TokenKind::Shl, i, 2, 0)
        return i + 2
    }
    if (c == CH_GT && d == CH_GT) {
        push_token(tokens, TokenKind::Shr, i, 2, 0)
        return i + 2
    }
    if (c == CH_EQ && d == CH_EQ) {
        push_token(tokens, TokenKind::Eqeq, i, 2, 0)
        return i + 2
    }
    if (c == CH_BANG && d == CH_EQ) {
        push_token(tokens, TokenKind::Ne, i, 2, 0)
        return i + 2
    }
    if (c == CH_AMP && d == CH_AMP) {
        push_token(tokens, TokenKind::Andand, i, 2, 0)
        return i + 2
    }
    if (c == CH_PIPE && d == CH_PIPE) {
        push_token(tokens, TokenKind::Oror, i, 2, 0)
        return i + 2
    }
    // `$...`, the compile-time list, is three dots and is taken whole. Reading
    // it a byte at a time leaves the last two to be read as a range.
    if (c == CH_DOT && d == CH_DOT && byte_of(src, i + 2, len) == CH_DOT) {
        push_token(tokens, TokenKind::Dot, i, 1, 0)
        push_token(tokens, TokenKind::Dot, i + 1, 1, 0)
        push_token(tokens, TokenKind::Dot, i + 2, 1, 0)
        return i + 3
    }
    // A range, which is written only between `in` and a `for`'s body. `..=`
    // reaches its bound and `..` stops before it.
    if (c == CH_DOT && d == CH_DOT) {
        if (byte_of(src, i + 2, len) == CH_EQ) {
            push_token(tokens, TokenKind::Dotdoteq, i, 3, 0)
            return i + 3
        }
        push_token(tokens, TokenKind::Dotdot, i, 2, 0)
        return i + 2
    }
    // TokenKind::Eof stands for "nothing matched" here. A byte that is none of the
    // operators below used to keep it and be pushed as an end-of-file token,
    // so the parser stopped where the byte was and the compiler wrote an empty
    // program and reported success. One stray byte silently truncated a file.
    var kind: TokenKind = TokenKind::Eof
    if (c == CH_LPAREN) { kind = TokenKind::Lparen }
    if (c == CH_RPAREN) { kind = TokenKind::Rparen }
    if (c == CH_LBRACE) { kind = TokenKind::Lbrace }
    if (c == CH_RBRACE) { kind = TokenKind::Rbrace }
    if (c == CH_LBRACKET) { kind = TokenKind::Lbracket }
    if (c == CH_RBRACKET) { kind = TokenKind::Rbracket }
    if (c == CH_COMMA) { kind = TokenKind::Comma }
    if (c == CH_DOT) { kind = TokenKind::Dot }
    if (c == CH_COLON) { kind = TokenKind::Colon }
    if (c == CH_CARET) { kind = TokenKind::Caret }
    if (c == CH_AMP) { kind = TokenKind::Amp }
    if (c == CH_PIPE) { kind = TokenKind::Pipe }
    if (c == CH_EQ) { kind = TokenKind::Assign }
    if (c == CH_PLUS) { kind = TokenKind::Plus }
    if (c == CH_MINUS) { kind = TokenKind::Minus }
    if (c == CH_STAR) { kind = TokenKind::Star }
    if (c == CH_BANG) { kind = TokenKind::Bang }
    if (c == CH_QUESTION) { kind = TokenKind::Question }
    if (c == CH_SLASH) { kind = TokenKind::Slash }
    if (c == CH_PERCENT) { kind = TokenKind::Percent }
    if (c == CH_LT) { kind = TokenKind::Lt }
    if (c == CH_GT) { kind = TokenKind::Gt }
    if (c == CH_DOLLAR) { kind = TokenKind::Dollar }
    // A semicolon used to be dropped with the whitespace, which made `[0; 4]`
    // lex as the two elements `0` and `4` and quietly build an array of two
    // rather than four. It is a token now, skipped where a statement ends.
    if (c == CH_SEMI) { kind = TokenKind::Semi }
    if (kind == TokenKind::Eof) {
        // A byte that is no operator becomes a token of its own rather than
        // the end of the compile. The parser refuses it where it stands, so
        // the fault is reported with a line and everything after it is still
        // read. A multi-byte character is taken whole, continuation bytes and
        // all, so the report shows the character the file holds rather than
        // its first byte.
        var span: i64 = 1
        while (i + span < len
            && byte_of(src, i + span, len) >= 128
            && byte_of(src, i + span, len) < 192) {
            span = span + 1
        }
        push_token(tokens, TokenKind::Illegal, i, span, 0)
        return i + span
    }
    push_token(tokens, kind, i, 1, 0)
    i + 1
}

tokenize :: fn(src: str, len: i64, mut tokens: Arena<Token>) {
    var i: i64 = 0
    // A byte-order mark, which some editors write at the head of a UTF-8 file.
    // It carries no meaning here and is not an operator, so it is stepped over
    // before the first token rather than reported as a stray byte.
    if (byte_of(src, 0, len) == 239 && byte_of(src, 1, len) == 187
        && byte_of(src, 2, len) == 191) {
        i = 3
    }
    while (i < len) {
        c := byte_of(src, i, len)
        if (c == CH_SPACE || c == CH_TAB || c == CH_LF || c == CH_CR) {
            i = i + 1
        } else if (c == CH_SLASH && byte_of(src, i + 1, len) == CH_SLASH) {
            while (i < len && byte_of(src, i, len) != CH_LF) {
                i = i + 1
            }
        } else if (is_digit(c)) {
            start := i
            var value: i64 = 0
            // `0x` and `0b`, read before the decimal path since both start with
            // a digit that is a number on its own. A C header writes its
            // constants in hex, and transcribing them into decimal by hand is a
            // step where a digit goes missing quietly.
            var base: i64 = 10
            if (c == CH_0 && is_radix_mark(byte_of(src, i + 1, len))) {
                mark := byte_of(src, i + 1, len)
                base = 16
                if (mark == CH_LOWER_B || mark == CH_UPPER_B) {
                    base = 2
                }
                i = i + 2
                while (is_radix_digit(byte_of(src, i, len), base)
                    || byte_of(src, i, len) == CH_UNDERSCORE) {
                    held := byte_of(src, i, len)
                    if (held != CH_UNDERSCORE) {
                        // Wrapping on purpose: `0xFFFFFFFFFFFFFFFF` is a bit
                        // pattern, and the digits build it by leaving the
                        // signed range on the way.
                        value = wrap_add(wrap_mul(value, base),
                            radix_digit(held))
                    }
                    i = i + 1
                }
                push_token(tokens, TokenKind::Int, start, i - start, value)
                continue
            }
            while (is_digit(byte_of(src, i, len))
                || byte_of(src, i, len) == CH_UNDERSCORE) {
                held := byte_of(src, i, len)
                if (held != CH_UNDERSCORE) {
                    value = wrap_add(wrap_mul(value, 10), held - CH_0)
                }
                i = i + 1
            }
            // A dot with a digit behind it continues the number rather than
            // starting a field access. The fractional part is not converted
            // here. A float literal keeps its byte range and both backends
            // hand the text to the tool that already knows how to read it.
            var is_float: bool = false
            if (byte_of(src, i, len) == CH_DOT
                && is_digit(byte_of(src, i + 1, len))) {
                is_float = true
                i = i + 1
                while (is_digit(byte_of(src, i, len))
                    || byte_of(src, i, len) == CH_UNDERSCORE) {
                    i = i + 1
                }
            }
            // An exponent, so a program can write 1e-6 rather than a run of
            // zeroes it has to count. The digits are handed on as they were
            // written, so nothing here reads the number.
            if (starts_exponent(src, i, len)) {
                is_float = true
                i = i + 1
                if (byte_of(src, i, len) == CH_PLUS
                    || byte_of(src, i, len) == CH_MINUS) {
                    i = i + 1
                }
                while (is_digit(byte_of(src, i, len))) {
                    i = i + 1
                }
            }
            if (is_float) {
                push_token(tokens, TokenKind::Float, start, i - start, 0)
            } else {
                push_token(tokens, TokenKind::Int, start, i - start, value)
            }
        } else if (is_ident_start(c)) {
            start := i
            while (is_ident_cont(byte_of(src, i, len))) {
                i = i + 1
            }
            length := i - start
            push_token(tokens, classify_ident(src, start, length), start,
                length, 0)
        } else if (c == CH_DQUOTE) {
            start := i
            i = i + 1
            while (i < len && byte_of(src, i, len) != CH_DQUOTE) {
                held := byte_of(src, i, len)
                if (held == CH_BACKSLASH) {
                    i = i + 1
                }
                i = i + 1
            }
            i = i + 1
            push_token(tokens, TokenKind::Str, start + 1, i - start - 2, 0)
        } else {
            i = lex_operator(src, i, len, tokens)
        }
    }
    push_token(tokens, TokenKind::Eof, len, 0, 0)
}

// ---------------------------------------------------------------------------
// Token cursor. The parser reads token kinds through these rather than bytes.
// ---------------------------------------------------------------------------
