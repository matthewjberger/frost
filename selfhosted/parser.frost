// The recursive-descent parser, and the re-parse that instantiates a generic.

import "core.frost"
import "lexer.frost"
import "cursor.frost"
import "imports.frost"
import "names.frost"
import "const_eval.frost"
import "types.frost"

import "layout.frost"
import "lint.frost"

export expand_includes, instance_fits_kind, tuple_is_first_for,
    mark_first_instances, instance_hash,
    check_discarded_resources, type_named,
    instance_params,
    parse_generic_instance, parse_program, join_synth_fns,
    function_literal_follows_at,
    record_mono_rets, refuse_dot_value,
    resolve_variant_fixups, struct_field_count, written_at

// The code a compile-time argument carries, with the cursor on the token after
// the `$`. The three kinds of argument are a number, a name that is a function
// or a constant, and a type, and each rides in the same i64 so the whole
// monomorphization machinery stays keyed on one integer per argument. This is
// what a call writes and what a declaration's `= default` says.
parse_compile_time :: fn(mut p: Parser) -> i64 {
    // `$8` is a compile-time value argument, carried like a type argument but
    // holding CONST_BASE plus the number. `$Entity` is a type argument.
    if (cur(p) == TokenKind::Int) {
        value := CONST_BASE + cur_val(p)
        advance(p)
        return value
    }
    // `$round_up(3, 4)` is the same argument written as a call, worked out
    // here, which is what makes a compile-time number one thing wherever it is
    // read.
    if (at_const_call(p)) {
        return CONST_BASE + const_size_here(p)
    }
    // `$fn(a: i64) -> i64 { a + 1 }` names a function the same way `$compare`
    // does, and the function is written where it is named. A body is what tells
    // it from the type `fn(i64) -> i64`, which carries none. What is made is an
    // ordinary function of this program under a name nobody wrote, joined to
    // the program once the declaration this sits in has been read.
    if (cur(p) == TokenKind::KwFn && function_literal_follows(p)) {
        number := p.synth_fns.count
        name_off := synth_numbered(p, "__anon_", number)
        name_len := 7 + digits_in(number)
        node := parse_function_named(p, name_off, name_len)
        arena_push(p.synth_fns, NodeRef { node = node })
        made := arena_at(p.arena, node)
        return FN_BASE + made.val
    }
    // `$compare` names a function rather than a type, and is carried as
    // FN_BASE plus its index the way a type argument carries a type code. The
    // name is interned rather than looked up, since the function it names may
    // be declared further down the file.
    if (cur(p) == TokenKind::Ident
        && is_type_name(p, cur_off(p), cur_len(p)) == false) {
        off := cur_off(p)
        len := cur_len(p)
        advance(p)
        return FN_BASE + intern_global(p, off, len)
    }
    parse_type(p)
}

// Whether the `fn` at the cursor opens a function written where it is named,
// rather than the type of one. A body is what tells them apart, so this looks
// past the parameter list and the return type for the brace that opens one.
function_literal_follows :: fn(mut p: Parser) -> bool {
    function_literal_follows_at(p, 1)
}

// The same look-ahead from a given token, which is one past the `fn` when there
// is one and the `(` itself when there is not.
function_literal_follows_at :: fn(mut p: Parser, start: i64) -> bool {
    mut at := start
    if (peek_kind(p, at) != TokenKind::Lparen) {
        return false
    }
    mut depth: i64 = 0
    while (true) {
        kind := peek_kind(p, at)
        if (kind == TokenKind::Eof) {
            return false
        }
        if (kind == TokenKind::Lparen) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen) {
            depth = depth - 1
            if (depth == 0) {
                at = at + 1
                break
            }
        }
        at = at + 1
    }
    // Past the parameters. A function says what it answers with or opens its
    // body right here, so anything else means the brackets held an expression
    // rather than a parameter list. Asked before the search below, which would
    // otherwise run to whatever brace came next in the file and read
    // `(value + to - 1) / to` as a function of `value` and `to`.
    after := peek_kind(p, at)
    if (after != TokenKind::Lbrace && after != TokenKind::Arrow
        && after != TokenKind::KwUses) {
        return false
    }
    // Whatever the return type is, the brace that opens a body comes after it,
    // and a comma or a closing bracket at the depth this started on is the
    // argument ending instead.
    depth = 0
    while (true) {
        kind := peek_kind(p, at)
        if (kind == TokenKind::Eof) {
            return false
        }
        if (kind == TokenKind::Lbrace && depth == 0) {
            return true
        }
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket
            || kind == TokenKind::Lt) {
            depth = depth + 1
        } else if ((kind == TokenKind::Rparen || kind == TokenKind::Rbracket)
            && depth == 0) {
            return false
        } else if (kind == TokenKind::Comma && depth == 0) {
            return false
        } else if (kind == TokenKind::Shr) {
            // `Vec<Vec<i64>>` closes two of them with one token, which is how
            // the lexer reads `>>`.
            depth = depth - 2
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket
            || kind == TokenKind::Gt) {
            depth = depth - 1
        }
        if (depth < 0) {
            // Read past a form whose shape is not decided yet: a `>` with no
            // `<` in front of it is not a bracket at all. No body was found.
            return false
        }
        at = at + 1
    }
    false
}

// A file's bytes, spliced in where `include_str("path")` was written. The
// four tokens become one string literal before anything is parsed, so nothing
// downstream knows the feature exists: the type walk sees a `str` and the
// emitters emit it the way they emit any other literal.
//
// The path is relative to the file the call is written in and nowhere else,
// which is what keeps a library's shader beside the module that uses it
// wherever the library is installed.
//
// The bytes land past the source's terminator, in the room synthesized names
// use, and they land in source form: a literal's content is escape sequences
// until an emitter walks it, so a backslash the file holds is written as two
// and a quote as an escaped one, and carriage returns are dropped so a file
// checked out either way reads the same bytes.
expand_includes :: fn(mut p: Parser) {
    mut read: i64 = 0
    mut write: i64 = 0
    while (read < p.tokens.count) {
        held := arena_at(p.tokens, read)
        kind := held.kind
        off := held.off
        len := held.len
        value := held.value
        if (kind == TokenKind::Ident
            && str_range_eq(p.src, off, len, "include_str")) {
            splice_include(p, read, write)
            read = read + 4
            write = write + 1
        } else {
            if (write != read) {
                mut moved := arena_at(p.tokens, write)
                moved.kind = kind
                moved.off = off
                moved.len = len
                moved.value = value
            }
            read = read + 1
            write = write + 1
        }
    }
    p.tokens.count = write
}

// One include, read and written into the token at `write`. The call has to be
// the literal shape `include_str("...")`: the file is opened while the
// program is compiled, so the path has to be known then.
splice_include :: fn(mut p: Parser, read: i64, write: i64) {
    at := arena_at(p.tokens, read).off
    if (read + 3 >= p.tokens.count
        || arena_at(p.tokens, read + 1).kind != TokenKind::Lparen
        || arena_at(p.tokens, read + 2).kind != TokenKind::Str
        || arena_at(p.tokens, read + 3).kind != TokenKind::Rparen) {
        report_where(p.modules, p.src, at)
        report("include_str takes one string literal naming a file, so the path is known while the program is being compiled")
        frost_rt_recover_escape()
    }
    if (p.modules.count == 0) {
        report("include_str: there is no file for the path to be relative to")
        frost_rt_recover_escape()
    }
    path_token := arena_at(p.tokens, read + 2)
    owner := arena_at(p.modules, module_at(p.modules, at))
    full := join_path(owner.path, p.src, path_token.off, path_token.len)
    if (unsafe { frost_rt_file_exists(full) } == 0) {
        report_where(p.modules, p.src, at)
        report("include_str: cannot read '")
        report_cstr(full)
        report("'")
        frost_rt_recover_escape()
    }
    raw := unsafe { frost_rt_read_file(full) }
    length := cstr_len(raw)
    synth_room_for(p, length * 2 + 1)
    start := p.synth_next
    mut into := start
    mut k: i64 = 0
    while (k < length) {
        b := byte_at(raw, k)
        if (b == CH_CR) {
            k = k + 1
            continue
        }
        if (b == CH_BACKSLASH || b == CH_DQUOTE) {
            p.src[into] = cast($u8, CH_BACKSLASH)
            into = into + 1
        }
        p.src[into] = cast($u8, b)
        into = into + 1
        k = k + 1
    }
    p.src[into] = 0
    p.synth_next = into + 1
    mut out := arena_at(p.tokens, write)
    out.kind = TokenKind::Str
    out.off = start
    out.len = into - start
    out.value = 0
}

parse_number :: fn(mut p: Parser) -> i64 {
    value := cur_val(p)
    at := cur_off(p)
    advance(p)
    new_node_at(p, NodeKind::Num, 0, 0, value, at)
}

// The count in `[value; n]`. It reads the same way an array's declared length
// does: a literal, a value bound for the generic being instantiated, or a
// module constant.
array_repeat_count :: fn(mut p: Parser) -> i64 {
    if (cur(p) == TokenKind::Int) {
        total := cur_val(p)
        advance(p)
        return total
    }
    bound := value_binding_of(p, cur_off(p), cur_len(p))
    mut total := bound
    // Whether the name stands for anything at all, which is a different
    // question from what it stands for: a count of -1 was read as a name
    // nothing declares, so `N :: 0 - 4` was reported as not being a constant,
    // which it is.
    mut named: bool = bound >= 0
    if (bound < 0 && is_const(p, cur_off(p), cur_len(p))) {
        total = const_value(p, cur_off(p), cur_len(p))
        named = true
    }
    // The generic's own parse, before any instantiation, where the count is
    // still the parameter's name. Nothing of that parse is emitted: the body is
    // read again with the parameter bound to a number for each instance, and
    // this stands in until then.
    if (total < 0 && names_gparam(p, cur_off(p), cur_len(p))) {
        advance(p)
        return 0
    }
    if (named == false) {
        report_where(p.modules, p.src, cur_off(p))
        report("'")
        report_src(p.src, cur_off(p), cur_len(p))
        report("' has no value at compile time, so this cannot be ")
        report("worked out before the program runs")
        frost_rt_recover_escape()
    }
    if (total < 0) {
        report_where(p.modules, p.src, cur_off(p))
        report("an array holds a number of elements that cannot be negative")
        frost_rt_recover_escape()
    }
    advance(p)
    total
}

parse_primary :: fn(mut p: Parser) -> i64 {
    kind := cur(p)
    if (kind == TokenKind::Int) {
        return parse_number(p)
    }
    // A float literal is its byte range, the way a string literal is, since
    // nothing here has to know what number the digits spell.
    if (kind == TokenKind::Float) {
        offset := cur_off(p)
        length := cur_len(p)
        advance(p)
        return new_named_node_at(p, NodeKind::Float, 0, offset, length, offset)
    }
    // `[a, b, c]`. The element type and the length both come from what is
    // written, so an array literal needs no annotation to have a type.
    if (kind == TokenKind::Lbracket) {
        advance(p)
        mut head: i64 = -1
        mut tail: i64 = -1
        mut count: i64 = 0
        // When a declared type says what this literal holds, its element type is
        // taken from there rather than guessed from the first element, so
        // `mut d : [20]u8 = [0, 0, ...]` is a run of bytes, not of i64. The
        // expectation is narrowed to the element for each item, so a literal of
        // arrays resolves the same way at every level.
        had_expected := is_array_ty(p.expected_type)
        mut elem_expected: i64 = 0
        if (had_expected) {
            elem_expected = array_element(p, p.expected_type)
        }
        saved_expected := p.expected_type
        p.expected_type = elem_expected
        while (cur(p) != TokenKind::Rbracket) {
            element := new_node(p, NodeKind::Arg, parse_expr(p), 0, 0)
            if (head == (-1)) {
                head = element
            } else {
                set_next(p, tail, element)
            }
            tail = element
            count = count + 1
            // `[value; n]` is the same value n times. The count is a literal or
            // a constant, since the elements are laid out here rather than at
            // run time, and it follows the one element the form allows.
            if (cur(p) == TokenKind::Semi) {
                advance(p)
                held := arena_at(p.arena, element)
                value := held.a
                total := array_repeat_count(p)
                while (count < total) {
                    copy := new_node(p, NodeKind::Arg, value, 0, 0)
                    set_next(p, tail, copy)
                    tail = copy
                    count = count + 1
                }
            }
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        p.expected_type = saved_expected
        advance(p)
        made := new_node(p, NodeKind::ArrayLit, head, 0, 0)
        node := arena_at(p.arena, made)
        node.c = count
        // A stored element type is kept as the code plus one, so zero still
        // means it was not set and the element is guessed from the first item.
        if (had_expected) {
            node.val = elem_expected + 1
        }
        return made
    }
    // The boolean literals. Predeclared meanings rather than reserved words:
    // the words always mean the booleans in expression position, and declaring
    // either as a name is refused where the declaration is read.
    // Each carries `bool`, the way a number written as a bit of a flags type
    // carries that type. A name bound to one holds a yes or no rather than the
    // number it travels as, which is what `!` reads to hold its operand to one.
    if (kind == TokenKind::Ident
        && str_range_eq(p.src, cur_off(p), cur_len(p), "true")) {
        advance(p)
        return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, 1)
    }
    if (kind == TokenKind::Ident
        && str_range_eq(p.src, cur_off(p), cur_len(p), "false")) {
        advance(p)
        return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, 0)
    }
    if (kind == TokenKind::Str) {
        offset := cur_off(p)
        length := cur_len(p)
        advance(p)
        // At the quote that opens it. The cursor has read the whole literal by
        // now and sits on what follows, so a complaint about the text was
        // landing on whatever came after it.
        return new_named_node_at(
            p,
            NodeKind::StrLit,
            0,
            offset,
            length,
            offset - 1
        )
    }
    if (kind == TokenKind::Dollar) {
        advance(p)
        return new_type_node(p, NodeKind::TypeVal, 0, parse_compile_time(p))
    }
    // `unsafe { expr }` where a value is wanted vouches for the one expression
    // inside, so `x := unsafe { ptr_cast(...) }` and a `data = unsafe { ... }`
    // field are how a wrapper hands an unsafe result up without a bare block.
    // Its span is recorded the same way the statement form's is, so the gate
    // sees the expression as written inside one.
    if (kind == TokenKind::KwUnsafe) {
        // The keyword, which is what a report about the block is about and
        // what a reader looks for on the line.
        start := cur_off(p)
        advance(p)
        p.unsafe_depth = p.unsafe_depth + 1
        advance(p)
        refuse_nested_function(p, cur_off(p))
        inner := parse_expr(p)
        advance(p)
        // The span ends past the closing brace, since a node made while parsing
        // the inner expression, a call for one, carries the position it ended
        // at, which is the brace itself.
        span_end := cur_off(p)
        p.unsafe_depth = p.unsafe_depth - 1
        arena_push(
            p.unsafe_spans,
            UnsafeSpan { start = start, end = span_end, used = 0 }
        )
        return inner
    }
    // An `if` used where a value is wanted takes the same road a `match` does:
    // bind a name, let each branch assign to it, queue the branch for the block
    // being parsed, and stand for the name.
    if (kind == TokenKind::KwIf) {
        name_off := synth_numbered(p, "__value", p.match_count)
        name_len := 7 + digits_in(p.match_count)
        p.match_count = p.match_count + 1
        seed := new_node(p, NodeKind::Num, 0, 0, 0)
        bind := new_let_node(p, seed, name_off, name_len, -1)
        chosen := parse_stmt(p)
        node := arena_at(p.arena, chosen)
        then_head := node.b
        else_head := node.val
        mut answered := assign_block_value(p, then_head, name_off, name_len)
        otherwise := assign_block_value(p, else_head, name_off, name_len)
        if (answered == (-1)) {
            answered = otherwise
        }
        bind_answer_type(p, bind, answered)
        arena_push(
            p.pending,
            LocalVar { name_off = bind, name_len = chosen, ty = 0, slot = 0 }
        )
        return new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            name_off
        )
    }
    // A match used where a value is wanted: bind a name, let each arm assign to
    // it, and stand for the name. The match itself is queued for the block,
    // which is the same road a `?` takes.
    if (kind == TokenKind::KwMatch) {
        name_off := synth_numbered(p, "__value", p.match_count)
        name_len := 7 + digits_in(p.match_count)
        p.match_count = p.match_count + 1
        seed := new_node(p, NodeKind::Num, 0, 0, 0)
        bind := new_let_node(p, seed, name_off, name_len, -1)
        chosen := parse_match(p)
        answered := assign_match_values(p, chosen, name_off, name_len)
        bind_answer_type(p, bind, answered)
        arena_push(
            p.pending,
            LocalVar { name_off = bind, name_len = chosen, ty = 0, slot = 0 }
        )
        return new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            name_off
        )
    }
    // `.Circle { radius = 5 }`, whose enum comes from what the context expects.
    if (kind == TokenKind::Dot) {
        return parse_inferred_variant(p)
    }
    // `{ x = 1, y = 2 }`, a struct literal that leaves out a type name the
    // context already carries. Every field is still named. An unresolved one is
    // an argument whose callee is written later, patched by the fixup pass.
    if (kind == TokenKind::Lbrace) {
        // The brace the literal opens with, taken before it is read, since a
        // report about the literal points at where it starts.
        at := cur_off(p)
        advance(p)
        // The second place to look is what a `return` in a fallible function
        // sets: the value it answers with is not a struct there, so a literal
        // written without a name is the failure.
        mut struct_ty := p.expected_type
        if (is_struct_ty(struct_ty) == false) {
            struct_ty = p.expected_alt
        }
        if (is_struct_ty(struct_ty) == false) {
            struct_ty = -1
        }
        head := parse_field_inits(p, struct_ty)
        return new_struct_lit(p, struct_ty, head, at)
    }
    // `(a: i64) -> i64 { a + 1 }` is the same function written without the `fn`
    // in front of it. A body is what tells it from a group, and a group with a
    // block after it is what a condition looks like, so the flag that keeps a
    // `{` from being read as a struct there keeps it from being read as a body
    // here.
    if (kind == TokenKind::Lparen && p.no_struct_lit == false
        && function_literal_follows_at(p, 0)) {
        written := cur_off(p)
        number := p.synth_fns.count
        name_off := synth_numbered(p, "__anon_", number)
        name_len := 7 + digits_in(number)
        node := parse_function_named(p, name_off, name_len)
        arena_push(p.synth_fns, NodeRef { node = node })
        return new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            written
        )
    }
    // `()` is a value nothing can be. The bootstrap reads it and refuses it
    // when it lowers, in these words and at the bracket that opened it, and a
    // refusal is one thing wherever it is written. Asked after the literal
    // above, since `() -> i64 { 1 }` is a function of no parameters.
    if (kind == TokenKind::Lparen && peek_kind(p, 1) == TokenKind::Rparen) {
        report_where(p.modules, p.src, cur_off(p))
        report("unsupported expression: ()")
        frost_rt_recover_escape()
    }
    if (kind == TokenKind::Lparen) {
        advance(p)
        inner := parse_expr(p)
        advance(p)
        return inner
    }
    // `fn(n: i64) -> i64 { n + 1 }` written where a value is wanted: the
    // function itself, under a name nobody wrote, and the name where it stood.
    // A field of `fn` type is filled this way, which is the shape C is handed.
    // The `$` form in `parse_compile_time` reads the same body; what differs is
    // that this one answers with a value and that one with the function.
    if (kind == TokenKind::KwFn && function_literal_follows(p)) {
        written := cur_off(p)
        number := p.synth_fns.count
        name_off := synth_numbered(p, "__anon_", number)
        name_len := 7 + digits_in(number)
        node := parse_function_named(p, name_off, name_len)
        arena_push(p.synth_fns, NodeRef { node = node })
        return new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            written
        )
    }
    // Everything past here reads a name. Any other token, a stray byte among
    // them, is refused where it stands, in the words the bootstrap says for
    // the same token, rather than being read as a name spelled by whatever
    // the bytes were.
    if (kind != TokenKind::Ident) {
        report_where(p.modules, p.src, cur_off(p))
        report("Token not valid for an expression: '")
        report_src(p.src, cur_off(p), cur_len(p))
        report("'")
        frost_rt_recover_escape()
    }
    offset := cur_off(p)
    length := cur_len(p)
    advance(p)
    // `Kind::Enemy { ... }` names a variant of an enum.
    if (cur(p) == TokenKind::Coloncolon) {
        advance(p)
        return parse_variant_value(p, offset, length)
    }
    if (cur(p) == TokenKind::Lparen) {
        if (str_range_eq(p.src, offset, length, "ptr_to")) {
            advance(p)
            inner := parse_expr(p)
            advance(p)
            // Placed where `ptr_to` is written rather than where its argument
            // closed, which is the token after it: a report about what the
            // address is of points at the whole of what takes it.
            return new_unary_at(p, NodeKind::AddrOf, inner, offset)
        }
        // `type_id(T)`: the number this compiler goes by for that type, which
        // it already has, since a type is a code here. What it is for is a
        // table keyed by type in a program whose contents are decided while it
        // runs.
        if (str_range_eq(p.src, offset, length, "type_id")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held >= 0) {
                refuse_variant_question(p, held, offset, length)
                entry := arena_at(p.field_bindings, held)
                field_ty := entry.ty
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, 0, field_ty)
            }
            if (unbound_template(p)) {
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, 0, 0)
            }
            ty := parse_type(p)
            advance(p)
            return new_node(p, NodeKind::Num, 0, 0, ty)
        }
        if (str_range_eq(p.src, offset, length, "sizeof")) {
            advance(p)
            // A `$` here says the name is a type rather than a value, the way
            // `cast` and `typename` take one. The type it names is read after
            // it, so a declared type written with a `$` is that type.
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            // `sizeof(field)` is the width of what that field holds. A field
            // reads as a named type here, so which of the two it is comes from
            // whether a `for` over `fields(T)` bound the name.
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held >= 0) {
                refuse_variant_question(p, held, offset, length)
                entry := arena_at(p.field_bindings, held)
                field_ty := entry.ty
                advance(p)
                advance(p)
                return new_type_node(p, NodeKind::Sizeof, 0, field_ty)
            }
            if (unbound_template(p)) {
                advance(p)
                advance(p)
                return new_type_node(p, NodeKind::Sizeof, 0, TY_I64)
            }
            ty := parse_type(p)
            advance(p)
            return new_type_node(p, NodeKind::Sizeof, 0, ty)
        }
        // What a type is aligned to, which is what an allocator has to start a
        // run of it on. Read the way `sizeof` is, and for the same reasons: a
        // `$` says the name is a type, and a name a `for` over `fields(T)`
        // bound is the field's type rather than a type of its own.
        if (str_range_eq(p.src, offset, length, "alignof")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held >= 0) {
                refuse_variant_question(p, held, offset, length)
                entry := arena_at(p.field_bindings, held)
                field_ty := entry.ty
                advance(p)
                advance(p)
                return new_type_node(p, NodeKind::Alignof, 0, field_ty)
            }
            if (unbound_template(p)) {
                advance(p)
                advance(p)
                return new_type_node(p, NodeKind::Alignof, 0, TY_I64)
            }
            ty := parse_type(p)
            advance(p)
            return new_type_node(p, NodeKind::Alignof, 0, ty)
        }
        // A type's own name, as text. The compiler knows it well enough to put
        // it in a diagnostic, and a registry that wants to be readable in a
        // file or a debugger wants the same string.
        if (str_range_eq(p.src, offset, length, "typename")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            // `typename(field)` is the name of what that field holds, the way
            // `type_id(field)` is its number. A field reads as a named type
            // here, so which of the two it is comes from whether a `for` over
            // `fields(T)` bound the name.
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held >= 0) {
                refuse_variant_question(p, held, offset, length)
                entry := arena_at(p.field_bindings, held)
                field_off, field_len := synth_type_name(p, entry.ty)
                advance(p)
                advance(p)
                return new_named_node(
                    p,
                    NodeKind::StrLit,
                    0,
                    field_off,
                    field_len
                )
            }
            if (unbound_template(p)) {
                advance(p)
                advance(p)
                return new_named_node(p, NodeKind::StrLit, 0, offset, 0)
            }
            ty := parse_type(p)
            advance(p)
            name_off, name_len := synth_type_name(p, ty)
            return new_named_node(p, NodeKind::StrLit, 0, name_off, name_len)
        }
        // The name the declaration gave a field or a variant, as text. Writing
        // a name is safe. Reading one back to find a field is what there is no
        // way to write, so a name leaves here and nothing takes one.
        if (str_range_eq(p.src, offset, length, "name_of")) {
            advance(p)
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held < 0) {
                if (unbound_template(p) == false) {
                    report_where(p.modules, p.src, cur_off(p))
                    report("name_of names a field or a variant, which is what ")
                    report("a `for` over `fields(T)` binds")
                    frost_rt_recover_escape()
                }
                advance(p)
                advance(p)
                return new_named_node(p, NodeKind::StrLit, 0, offset, 0)
            }
            entry := arena_at(p.field_bindings, held)
            named_off := entry.field_off
            named_len := entry.field_len
            advance(p)
            advance(p)
            return new_named_node(p, NodeKind::StrLit, 0, named_off, named_len)
        }
        // Where a field sits in the type that declares it, or the number
        // standing for a variant. The compiler worked this out to lay the type
        // out, and a layout table is the same number.
        if (str_range_eq(p.src, offset, length, "offset_of")) {
            advance(p)
            held := field_binding_of(p, cur_off(p), cur_len(p))
            if (held < 0) {
                if (unbound_template(p) == false) {
                    report_where(p.modules, p.src, cur_off(p))
                    report("offset_of names a field of a type, which is what a `for` over `fields(T)` binds")
                    frost_rt_recover_escape()
                }
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, 0, 0)
            }
            entry := arena_at(p.field_bindings, held)
            at := entry.at
            advance(p)
            advance(p)
            return new_node(p, NodeKind::Num, 0, 0, at)
        }
        // How many fields a type has, which is what sizes the table a walk over
        // them fills.
        if (str_range_eq(p.src, offset, length, "field_count")) {
            advance(p)
            // A type argument is written with the sigil the way it is anywhere
            // else, and `sizeof` and `alignof` read past one here. Left in
            // place, `field_count($T)` read the sigil as the type, answered
            // `i64`, and the function holding it was dropped without a word.
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            ty := parse_type(p)
            advance(p)
            // A type with no fields has no count. An enum is laid out as a
            // struct carrying the tag beside every variant's fields, so what it
            // counts is its variants, which is what a walk over one hands back.
            // A template's parameter is a placeholder until an instance binds
            // it, and that parse is thrown away and done again there.
            mut counts := is_struct_ty(ty)
            mut counts_variants: bool = false
            if (counts) {
                def := arena_at(p.structs, struct_index_of(ty))
                counts_variants = def.is_enum == 1
                counts = def.is_enum == 0
            }
            if (counts_variants) {
                return new_node(p, NodeKind::Num, 0, 0, variant_count(p, ty))
            }
            if (counts == false && ty != TY_PARAM) {
                report_where(p.modules, p.src, offset)
                report("`field_count` counts the fields of a struct or the ")
                report("variants of an enum, and '")
                report_type_name(p, ty)
                report("' is neither")
                frost_rt_recover_escape()
            }
            return new_node(p, NodeKind::Num, 0, 0, struct_field_count(p, ty))
        }
        // A type predicate asked of a field is answered here, wherever it is
        // asked, so a table may carry the answer as an ordinary field rather
        // than only decide a branch.
        if (is_type_predicate(p.src, offset, length)
            && peek_kind(p, 1) == TokenKind::Ident
            && peek_kind(p, 2) == TokenKind::Rparen) {
            held := field_binding_of(p, peek_off(p, 1), peek_len(p, 1))
            if (held >= 0) {
                entry := arena_at(p.field_bindings, held)
                if (entry.is_variant == 1 && already_said(p, offset) == false) {
                    report_where(p.modules, p.src, offset)
                    report("'")
                    report_src(p.src, entry.field_off, entry.field_len)
                    report("' is a variant of an enum, so it is asked about ")
                    report("with `name_of` and `offset_of`, and a type ")
                    report("predicate has nothing to read")
                    frost_rt_recover_escape()
                }
                field_ty := entry.ty
                answer := predicate_holds(p, offset, length, field_ty)
                advance(p)
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, answer)
            }
            // The type argument this instance was made for, which is what a
            // `where` bound at the call asks about. The same question written
            // in an `if` had no answer, so one vocabulary read two ways
            // depending on which of the two positions it stood in.
            bound := binding_of(p, peek_off(p, 1), peek_len(p, 1))
            if (names_a_type_binding(bound)) {
                answer := predicate_holds(p, offset, length, bound)
                advance(p)
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, answer)
            }
            if (unbound_template(p)) {
                advance(p)
                advance(p)
                advance(p)
                return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, 0)
            }
        }
        // The position it failed at is worth more than the fact that it did,
        // and the node already carries where it was written.
        if (str_range_eq(p.src, offset, length, "assert")) {
            advance(p)
            inner := parse_expr(p)
            advance(p)
            made := new_unary(p, NodeKind::Assert, inner)
            // The word itself, rather than wherever the cursor ended up after
            // reading the condition, which is the next line.
            node := arena_at(p.arena, made)
            node.pos = offset
            return made
        }
        // A slice carries its length, and a fixed array's is in its type, so
        // this reads one in constant time either way.
        if (str_range_eq(p.src, offset, length, "flags_has")) {
            advance(p)
            set := parse_expr(p)
            advance(p)
            wanted := parse_expr(p)
            advance(p)
            return lower_flags_has(p, set, wanted)
        }
        if (str_range_eq(p.src, offset, length, "wrap_add")) {
            return parse_wrapping(p, OP_WRAP_ADD)
        }
        if (str_range_eq(p.src, offset, length, "wrap_sub")) {
            return parse_wrapping(p, OP_WRAP_SUB)
        }
        if (str_range_eq(p.src, offset, length, "wrap_mul")) {
            return parse_wrapping(p, OP_WRAP_MUL)
        }
        // Reaching `live_slots` here is one written somewhere other than after
        // `in` of a `for`, where it is the subject of the walk. There is no
        // value it could be: the slots it names are walked, never held.
        if (str_range_eq(p.src, offset, length, "live_slots")) {
            report_where(p.modules, p.src, offset)
            report("`live_slots(c)` is the subject of a `for` and nothing else; ")
            report("write `for slot in live_slots(c)`")
            frost_rt_recover_escape()
        }
        if (str_range_eq(p.src, offset, length, "slice_len")
            || str_range_eq(p.src, offset, length, "str_len")) {
            // Which of the two words was written, so the check on the operand
            // says what the bootstrap says. A node this compiler made itself,
            // for a `for` over a run or for a live walk, carries 0 and is not
            // checked: it is not a call anybody wrote and its subject is
            // whatever the loop was given.
            mut written: i64 = 1
            if (str_range_eq(p.src, offset, length, "str_len")) {
                written = 2
            }
            advance(p)
            inner := parse_expr(p)
            advance(p)
            return arena_push(
                p.arena,
                Node {
                    kind = NodeKind::SliceLen,
                    a = inner,
                    b = 0,
                    c = 0,
                    val = written,
                    next = -1,
                    pos = offset
                },
            )
        }
        // `cast($u8, n)`: a conversion the reader asked for. Written the way
        // `ptr_cast` and `slice_from` are, so it needs no keyword and no new
        // precedence level, and what it is for is that a conversion which
        // loses something otherwise has no spelling: refusing one would leave
        // no way to say you meant it.
        if (str_range_eq(p.src, offset, length, "cast")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            ty := parse_type(p)
            advance(p)
            expr := parse_expr(p)
            advance(p)
            return new_type_node_at(p, NodeKind::Cast, expr, ty, offset)
        }
        if (str_range_eq(p.src, offset, length, "ptr_cast")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            ty := parse_type(p)
            advance(p)
            expr := parse_expr(p)
            advance(p)
            return new_type_node_at(p, NodeKind::PtrCast, expr, ty, offset)
        }
        if (str_range_eq(p.src, offset, length, "slice_from")) {
            advance(p)
            if (cur(p) == TokenKind::Dollar) {
                advance(p)
            }
            element := parse_type(p)
            advance(p)
            ptr := parse_expr(p)
            advance(p)
            len := parse_expr(p)
            advance(p)
            slice_ty := array_of(p, element, -1)
            return new_node(p, NodeKind::SliceFrom, ptr, len, slice_ty)
        }
        advance(p)
        // A name the compile-time `for` around this copy bound stands for what
        // that copy is for, and an element that is a function stands for the
        // function itself. Read here as well as where a name is read as a
        // value, because a call resolves its own name and would otherwise go
        // looking for the loop's name among the functions.
        called_off, called_len := alias_for(p, offset, length)
        note_called_name(p, called_off, called_len)
        fn_index := intern_global(p, called_off, called_len)
        args, args_unbound := parse_arg_list_for(p, fn_index)
        // A call whose arguments came from a compile-time list that is not
        // bound belongs to a template's own parse. It is marked here so that
        // nothing later asks it for a type, since the tuple it would name is
        // read from elements that do not exist yet.
        // The call's place is the name it calls, not the bracket the arguments
        // end at. A reader told a call is wrong is told where the call is, and
        // for a call whose arguments run over three lines those are two
        // different lines.
        made := new_node_at(
            p,
            NodeKind::Call,
            args,
            args_unbound,
            fn_index,
            offset
        )
        // A call in a template's own copy of a `for` over the list this
        // declaration takes, read while nothing is bound to it. What that read
        // builds is never emitted, and the loop's name names no function in it:
        // every instance reads the body again with the name standing for what
        // the call passed. Marked on the node rather than remembered by name,
        // so a name a loop happened to use says nothing about the same name
        // anywhere else.
        if (p.unbound_pack_for == 1) {
            arena_push(p.unemitted_calls, NodeRef { node = made })
        }
        // What a compile-time list was given is the type of each argument past
        // the ordinary parameters, and only here are the names in scope to say
        // what those types are. Every later pass reads the tuple this noted.
        // A call whose arguments came from a list that is not bound is one
        // this parse is not entitled to name a tuple for: the elements it read
        // belong to a template, and the real call is read again per instance.
        // Whether this call hands its own literal and its own list on, noted
        // while the names this declaration gave them are still in scope.
        note_format_forward(p, args, fn_index)
        // A call handing over a name this file declares further down. What the
        // name holds is not known here, and a list filed holding the guess names
        // an instance whose elements are numbers. The call is taken down and
        // read again once every declaration is known.
        if (args_unbound == 0 && takes_pack(p, fn_index)
            && args_name_a_later_declaration(p, args)) {
            hold_pending_tuple(p, made, fn_index, args)
        } else if (args_unbound == 0
            && pack_call_args(p, args, fn_index)) {
            note_type_args(
                p,
                p.call_pack_primary,
                p.call_xarg_start,
                p.call_xarg_count,
                generic_fn_of(p, fn_index) + 1,
                generic_fn_of(p, fn_index)
            )
            // Kept for the pass that reads what the list turned out to hold,
            // which is after every instance has been walked.
            note_format_call(p, args, fn_index)
        } else if (args_unbound == 0
            && generic_fn_of(p, fn_index) < 0
            && arena_at(p.fns, fn_index).defined == 0) {
            // The callee has not been declared yet, so nothing here says
            // whether it reads a compile-time parameter off an argument. What
            // the arguments hold is taken down while their names are in scope.
            hold_pending_tuple(p, made, fn_index, args)
        } else if (args_unbound == 0 && generic_fn_of(p, fn_index) >= 0) {
            owner := generic_fn_of(p, fn_index)
            // A generic one of whose compile-time parameters a value parameter
            // settles names its tuple through the types of its arguments, and
            // those are names the local table holds only here. The pass that
            // gathers tuples over the whole program runs with no local in
            // scope, so for these it is read here or not at all.
            if (first_settled_gparam(p, owner)) {
                // The tuple is read off the types of the arguments, and an
                // argument that is itself a call to a generic has that type
                // only once its instance has been parsed.
                mut arg := args
                while (arg != (-1)) {
                    entry := arena_at(p.arena, arg)
                    settle_call_answer(p, entry.a)
                    arg = entry.next
                }
                held := settled_type_args(p, args, owner)
                check_bundle_args(
                    p,
                    owner,
                    offset,
                    length,
                    held,
                    p.call_xarg_start,
                    offset
                )
                note_type_args(
                    p,
                    held,
                    p.call_xarg_start,
                    p.call_xarg_count,
                    0,
                    owner
                )
            } else {
                // A generic settling nothing takes every compile-time parameter
                // from what the call wrote, and a constant among them is a
                // bundle to weigh against the type its parameter declares. The
                // run is built the same way the settled road builds it, since
                // that walk reads a written argument wherever nothing settles
                // the parameter.
                if (names_a_constant(p, args)) {
                    bound := settled_type_args(p, args, owner)
                    check_bundle_args(
                        p,
                        owner,
                        offset,
                        length,
                        bound,
                        p.call_xarg_start,
                        offset
                    )
                }
                // A generic called over a plain type names it in the local
                // table and nowhere else, so the tuple is read here or not at
                // all.
                held := parse_call_type_args(p, args, owner)
                if (held >= 0) {
                    note_type_args(p, held, p.gargs.count, 0, 0, owner)
                }
            }
            // The instance this call names, parsed now rather than left for the
            // pass that gathers them. A call inside its body may read a tuple
            // off a name only this parse can say the type of, so the body has
            // to be read while that is still true.
            settle_call_answer(p, made)
        }
        // Where the name was written, which is where a reader looks when the
        // call is what is wrong. The node position is past the arguments by
        // the time the node exists.
        node := arena_at(p.arena, made)
        node.c = offset
        return made
    }
    // `Pair<i64, bool> { first = 7, second = true }` says which instance the
    // literal is of instead of leaving it to the context. The type is read the
    // way every other generic instance is: rewind to the name and let the type
    // parser instantiate it.
    // `empty<i64>(3)` after a name that is no generic type. A generic struct is
    // written that way, and the shape reads as the same thing for a call, which
    // is what other languages do with it. Frost writes a call's compile-time
    // argument among its arguments with a `$` on it, so what stands here is a
    // comparison of a name against a type, and both compilers found that out
    // somewhere further on and reported wherever they got to.
    if (cur(p) == TokenKind::Lt && generic_index_for(p, offset, length) < 0) {
        closed := angled_call_argument(p)
        if (closed >= 0) {
            report_where(p.modules, p.src, cur_off(p))
            report("a call writes a compile-time argument among its arguments, so this is written '")
            report_src(p.src, offset, length)
            report("($")
            // The type as it was written, token by token. Read off the tokens
            // rather than the source so that what the two compilers say does
            // not depend on where the reader put a space.
            mut at: i64 = 1
            while (at < closed) {
                report_src(p.src, peek_off(p, at), peek_len(p, at))
                at = at + 1
            }
            report(", ...)'")
            frost_rt_recover_escape()
        }
    }
    if (cur(p) == TokenKind::Lt && p.no_struct_lit == false
        && generic_index_for(p, offset, length) >= 0) {
        p.ti = p.ti - 1
        start_ti := p.ti
        struct_ty := parse_type(p)
        // `Held<i64>::None` writes the arguments on the value. They belong to
        // the type the value is bound to, and the value names the enum alone.
        // The type as it was written is read back from the tokens rather than
        // from the source, so what this says does not depend on where the
        // reader put a space.
        if (cur(p) == TokenKind::Coloncolon) {
            variant_off := peek_off(p, 1)
            variant_len := peek_len(p, 1)
            report_where(p.modules, p.src, offset)
            report("a generic enum's arguments go on the type a value is bound to, so this is written '")
            report_src(p.src, offset, length)
            report("::")
            report_src(p.src, variant_off, variant_len)
            report("' with the binding typed '")
            held_ti := p.ti
            p.ti = start_ti
            while (p.ti < held_ti) {
                report_src(p.src, cur_off(p), cur_len(p))
                advance(p)
            }
            report("'")
            frost_rt_recover_escape()
        }
        if (cur(p) != TokenKind::Lbrace) {
            report_where(p.modules, p.src, offset)
            report("a generic type named here is the type of a literal, so it is followed by its fields in braces")
            frost_rt_recover_escape()
        }
        advance(p)
        inits := parse_field_inits(p, struct_ty)
        return new_struct_lit(p, struct_ty, inits, offset)
    }
    if (cur(p) == TokenKind::Lbrace && p.no_struct_lit == false) {
        struct_ty := resolve_lit_type(p, offset, length)
        refuse_unknown_lit_type(p, struct_ty, offset, length)
        advance(p)
        // A literal whose instance is read off its own field values has to have
        // them parsed before the type exists, so the fields are read against no
        // expected type and the instance is made from what they turned out to
        // be.
        if (struct_ty == TY_INFER) {
            inits := parse_field_inits(p, TY_I64)
            made := instantiate_inferred(
                p,
                generic_index_for(p, offset, length),
                inits,
                offset,
                length
            )
            return new_struct_lit(p, made, inits, offset)
        }
        inits := parse_field_inits(p, struct_ty)
        return new_struct_lit(p, struct_ty, inits, offset)
    }
    // An occurrence of a value generic parameter in an expression, like the `N`
    // in `while (i < N)`, is the bound number once the body is re-parsed with
    // the argument in force.
    bound := value_binding_of(p, offset, length)
    if (bound >= 0) {
        return new_node(p, NodeKind::Num, 0, 0, bound)
    }
    // The generic's own parse, where a value parameter is still a name. Nothing
    // of that parse is emitted, and the body is read again with a number bound
    // for each instance, so this stands in until then.
    if (names_gparam(p, offset, length)) {
        // Reading a field of one is a use of the name it will be given, the
        // same as calling one: `$ops` binds to a constant whose fields are
        // functions, not to a number. The placeholder below is for a value
        // parameter, whose name stands for a number.
        if (cur(p) == TokenKind::Dot) {
            note_called_name(p, offset, length)
            return new_named_node_at(
                p,
                NodeKind::Var,
                0,
                offset,
                length,
                offset
            )
        }
        return new_node(p, NodeKind::Num, 0, 0, 0)
    }
    // A `mut` parameter of a scalar type is the caller's value, so the
    // signature holds a pointer and every mention of the name in the body reads
    // and writes through it. An aggregate is already reached by address, so
    // only a scalar is dereferenced here.
    param_ty := parse_param_type(p, offset, length)
    if (param_ty >= 0 && reads_through_borrow(p, param_ty)) {
        return read_through_borrow(p, offset, length)
    }
    // A `ref x := place` binding of a scalar is the same shape: the name holds
    // where the place is and reading it reads the place. Without this the name
    // was the address, so `bound == 9` compared an address against nine and
    // answered no for every place there is.
    local_ty := parse_local_type(p, offset, length)
    if (local_ty >= 0 && reads_through_borrow(p, local_ty)) {
        return read_through_borrow(p, offset, length)
    }
    // A name the compile-time `for` around this copy bound stands for the
    // element that copy is for.
    aliased_off, aliased_len := alias_for(p, offset, length)
    if (aliased_off != offset || aliased_len != length) {
        // Named for the element and placed where the reader wrote the name it
        // stands for. Placed at the name instead, a fault about it pointed into
        // the room past the source where that name was made up, so the line a
        // reader was shown read ` items__0 items__0 `.
        return new_named_node_at(
            p,
            NodeKind::Var,
            0,
            aliased_off,
            aliased_len,
            offset
        )
    }
    // A compile-time parameter bound to a name stands for that name, so what is
    // recorded here is the name the call site passed. The binding is in force
    // only while the instance is parsed, and every pass after the parse reads
    // the node, so the substitution happens now rather than being looked up
    // later.
    supplied := fn_binding_of(p, offset, length)
    if (supplied >= 0) {
        sym := arena_at(p.fns, supplied)
        sym_off := sym.off
        sym_len := sym.len
        return new_named_node(p, NodeKind::Var, 0, sym_off, sym_len)
    }
    new_named_node_at(p, NodeKind::Var, 0, offset, length, offset)
}

// Instantiate a generic struct against the bindings in force, for a bare
// `Name { ... }` literal inside a generic body. The primary argument is the
// current primary binding. Each further argument is the current binding of the
// matching parameter name, so a multi-parameter generic resolves as a whole.
instantiate_current :: fn(mut p: Parser, gi: i64) -> i64 {
    template := arena_at(p.structs, gi)
    xparam_start := template.xparam_start
    xparam_count := template.xparam_count
    run_start := p.gargs.count
    mut j: i64 = 0
    while (j < xparam_count) {
        param := arena_at(p.gparams, xparam_start + j)
        bound := type_code_for(p, param.name_off, param.name_len)
        arena_push(
            p.gargs,
            GArg {
                value = bound,
                is_type = 0,
                pending = -1,
                node = -1,
                const_off = 0,
                const_len = 0
            }
        )
        j = j + 1
    }
    instantiate(p, gi, p.type_binding, run_start, xparam_count)
}

// The generic a concrete instance struct came from, or -1 if the type is not an
// instance.
instance_generic_of :: fn(mut p: Parser, ty: i64) -> i64 {
    if (is_struct_ty(ty) == false) {
        return -1
    }
    si := struct_index_of(ty)
    mut i: i64 = 0
    while (i < p.instances.count) {
        entry := arena_at(p.instances, i)
        if (entry.struct_index == si) {
            return entry.generic_index
        }
        i = i + 1
    }
    -1
}

// What `resolve_lit_type` answers for a bare generic literal that nothing in
// the context names an instance for. It is not a type: the arguments come from
// the values the fields are given, and those are not parsed yet when the type is
// asked for.
TY_INFER :: -2

// The value written for a field the template declares as its type parameter, or
// -1 where the literal gives none. A template keeps only the token its fields
// start at, since every instance parses them again under its own bindings, so
// the declaration is read here as tokens rather than as recorded fields.
//
// Only a field written as the bare parameter name answers. `storage: [N]T` says
// what `T` is as well, but reading it means matching the shape of a type against
// the shape of a value, and the arguments can be written out instead.
param_typed_value :: fn(
    mut p: Parser,
    field_token: i64,
    tparam_off: i64,
    tparam_len: i64,
    inits: i64
) -> i64 {
    saved := p.ti
    p.ti = field_token
    mut found: i64 = -1
    mut depth: i64 = 0
    mut started: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lbrace) {
            depth = depth + 1
            started = 1
        }
        if (cur(p) == TokenKind::Rbrace) {
            depth = depth - 1
            if (started == 1 && depth <= 0) {
                p.ti = saved
                return found
            }
        }
        if (found < 0 && started == 1 && depth == 1
            && cur(p) == TokenKind::Ident
            && peek_kind(p, 1) == TokenKind::Colon
            && peek_kind(p, 2) == TokenKind::Ident
            && (peek_kind(p, 3) == TokenKind::Comma
                || peek_kind(p, 3) == TokenKind::Rbrace)) {
            fname_off := cur_off(p)
            fname_len := cur_len(p)
            advance(p)
            advance(p)
            if (cur_len(p) == tparam_len
                && bytes_equal(p.src, cur_off(p), tparam_off, tparam_len)) {
                found = init_value_for(p, inits, fname_off, fname_len)
            }
        }
        advance(p)
    }
    p.ti = saved
    found
}

// The value a literal gives one named field, or -1 where it names no such field.
init_value_for :: fn(
    mut p: Parser,
    inits: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    mut id := inits
    while (id != (-1)) {
        init := arena_at(p.arena, id)
        init_off := init.val
        init_len := init.c
        value := init.a
        next_init := init.next
        if (init_len == name_len
            && bytes_equal(p.src, init_off, name_off, name_len)) {
            return value
        }
        id = next_init
    }
    -1
}

// What one parameter is bound to, read off the value written for a field the
// template declares as that parameter, or -1 where no field carries it.
inferred_arg :: fn(
    mut p: Parser,
    field_token: i64,
    name_off: i64,
    name_len: i64,
    inits: i64
) -> i64 {
    value := param_typed_value(p, field_token, name_off, name_len, inits)
    if (value < 0) {
        return -1
    }
    type_of(p, value)
}

// The instance a bare `Name { ... }` makes when nothing named it. Every
// parameter is read off the field that declares it, so a generic taking several
// resolves as a whole, and one whose parameter no field carries by itself is
// left to the reader to write out.
instantiate_inferred :: fn(
    mut p: Parser,
    gi: i64,
    inits: i64,
    offset: i64,
    length: i64
) -> i64 {
    template := arena_at(p.structs, gi)
    xparam_start := template.xparam_start
    xparam_count := template.xparam_count
    field_token := template.field_token
    tparam_off := template.tparam_off
    tparam_len := template.tparam_len
    primary := inferred_arg(p, field_token, tparam_off, tparam_len, inits)
    if (primary < 0) {
        report_uninferable(p, offset, length)
    }
    run_start := p.gargs.count
    mut j: i64 = 0
    while (j < xparam_count) {
        param := arena_at(p.gparams, xparam_start + j)
        pname_off := param.name_off
        pname_len := param.name_len
        // A value parameter stands for a number rather than a type, so no
        // field's declared type is it and there is nothing to read it off.
        mut bound: i64 = -1
        if (param.is_value == 0) {
            bound = inferred_arg(p, field_token, pname_off, pname_len, inits)
        }
        if (bound < 0) {
            report_uninferable(p, offset, length)
        }
        arena_push(
            p.gargs,
            GArg {
                value = bound,
                is_type = 0,
                pending = -1,
                node = -1,
                const_off = 0,
                const_len = 0
            }
        )
        j = j + 1
    }
    instantiate(p, gi, primary, run_start, xparam_count)
}

report_uninferable :: fn(mut p: Parser, offset: i64, length: i64) {
    report_where(p.modules, p.src, offset)
    report("'")
    report_src(p.src, offset, length)
    report("' is generic and nothing here says which instance this literal is: write the arguments on the literal, as in '")
    report_src(p.src, offset, length)
    report("<i64> { ... }', or give the binding a declared type that names them")
    frost_rt_recover_escape()
}

// The struct type for a literal `Name { ... }`. A generic name resolves, under
// an active binding, to the instance for the bound arguments. That is how the
// bare `Arena { ... }` inside a generic function names the right instance.
resolve_lit_type :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    gi := generic_index_for(p, offset, length)
    if (gi >= 0) {
        if (p.binding_active == 1) {
            return instantiate_current(p, gi)
        }
        // At the top level there is no binding, so the instance comes from the
        // declared type this initializer is for, when that type is an instance
        // of the same generic.
        if (is_struct_ty(p.expected_type)
            && instance_generic_of(p, p.expected_type) == gi) {
            return p.expected_type
        }
        // The generic's own parse stands in with a placeholder. Nothing of that
        // parse is emitted and the body is read again per instance with the
        // arguments bound, so what it answers here is never what is compiled.
        if (p.type_param_len > 0) {
            return TY_I64
        }
        // Outside one, nothing here names the instance, so it is worked out
        // from the values the fields are given. That needs the fields parsed
        // first, which is the caller's job, so this says so rather than
        // answering. Carrying the placeholder on instead gave a struct literal
        // a type that is not a struct, and the emitters read a struct index out
        // of it and indexed a table with -1.
        return TY_INFER
    }
    // The name is asked about here and again by the caller, which refuses a
    // literal of a type nothing declares. Reported at one of them, so a reader
    // hears it once.
    held := p.type_check_names
    p.type_check_names = 0
    code := type_code_for(p, offset, length)
    p.type_check_names = held
    code
}

// A struct literal of a name nothing declares.
//
// `type_code_for` answers `i64` for a name it cannot find, which is the answer
// for a type name and the wrong one for the type of a literal: `i64` is not a
// struct, so every pass after this read a struct index out of it and indexed the
// struct table at 0 - STRUCT_BASE, which ended the compile with an arena
// complaining about -16. Refused here instead, in the words the bootstrap uses.
// A generic type's name is never an unknown one. Inside a template's own parse
// the literal stands in with a placeholder that is not a struct, and nothing of
// that parse is emitted: the body is read again per instance with the arguments
// bound, and there the name answers with the instance.
refuse_unknown_lit_type :: fn(
    mut p: Parser,
    ty: i64,
    offset: i64,
    length: i64
) {
    if (ty == TY_INFER || is_struct_ty(ty)) {
        return
    }
    if (generic_index_for(p, offset, length) >= 0) {
        return
    }
    report_where(p.modules, p.src, offset)
    report("'")
    report_src(p.src, offset, length)
    report("' is not a type this program declares")
    if (report_declared_elsewhere(p, offset, length) == false) {
        report_nearest_name(p, offset, length)
    }
    // Past the literal's own braces before the escape, because recovery reads
    // forward to the brace that ends the statement list and the next brace here
    // is the literal's. Left where it is, one undeclared name ended the function
    // it was written in and every statement after it read as a declaration.
    skip_brace_group(p)
    frost_rt_recover_escape()
}

// A balanced `{ ... }` from the brace the cursor is on, or nothing when it is
// not on one.
skip_brace_group :: fn(mut p: Parser) {
    if (cur(p) != TokenKind::Lbrace) {
        return
    }
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lbrace) {
            depth = depth + 1
        }
        if (cur(p) == TokenKind::Rbrace) {
            depth = depth - 1
            if (depth == 0) {
                advance(p)
                return
            }
        }
        advance(p)
    }
}

// Whether the token at `index` ends where the one after it begins.
//
// `!` carries two meanings and the space after it is what tells them apart:
// written against what follows it, it negates; written with a space on both
// sides in a return type, it marks a failure set. So this is the question the
// rule about it asks.
tokens_touch :: fn(mut p: Parser, index: i64) -> bool {
    if (index < 0 || index + 1 >= p.tokens.count) {
        return false
    }
    held := arena_at(p.tokens, index)
    next := arena_at(p.tokens, index + 1)
    held.off + held.len == next.off
}

// Forward to just past the brace that closes the match the cursor sits inside.
// A refusal among the arms leaves the cursor where no statement begins, and a
// resync from there reads patterns as statements: `_` before a colon is a
// binding, a variant name is a type, and one refusal becomes four about lines
// with nothing wrong.
skip_past_match :: fn(mut p: Parser) {
    mut depth: i64 = 1
    while (depth > 0 && cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lbrace) {
            depth = depth + 1
        }
        if (cur(p) == TokenKind::Rbrace) {
            depth = depth - 1
        }
        advance(p)
    }
}

// Apply any trailing `.field`, `^` deref, and `[index]` operators to a node.
// `e?` where the enclosing function answers with a failure set: bind the
// result, hand the failure on if that is what it holds, and stand for the value
// otherwise. The three statements are queued for the block being parsed, which
// is what lets a `?` sit anywhere an expression can rather than only where a
// statement can.
lower_try :: fn(mut p: Parser, value: i64) -> i64 {
    if (p.result_ty == (-1)) {
        // At what the `?` is written after, which is what the reader looks at.
        // Read off the cursor it named the token past the whole expression, so
        // a `?` on one line was reported on the next.
        report_where(p.modules, p.src, arena_at(p.arena, value).pos)
        report(
            "the `?` operator is only allowed in a function with a failure set; '"
        )
        if (p.result_fn >= 0 && p.result_fn < p.fns.count) {
            sym := arena_at(p.fns, p.result_fn)
            report_src(p.src, sym.off, sym.len)
        }
        report("' must declare `-> T ! E`")
        frost_rt_recover_escape()
    }
    name_off := synth_numbered(p, "__try", p.try_count)
    name_len := 5 + digits_in(p.try_count)
    p.try_count = p.try_count + 1

    bind := new_let_node(p, value, name_off, name_len, -1)
    held := new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off)
    tag := new_field_node(p, held, p.name_tag, 3)
    zero := new_node(p, NodeKind::Num, 0, 0, 0)
    failed := new_node(p, NodeKind::Bin, tag, zero, OP_NE)
    carried := new_field_node(
        p,
        new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off),
        p.name_err_error,
        9,
    )
    // A `?` hands the failure on, which is the function leaving, so whatever it
    // deferred runs here the way it runs at a `return` written out. Handing the
    // failure on without them is a resource left behind on exactly the path that
    // was meant to be the tidy one.
    hand_on := defer_before_return(
        p,
        new_result_value(p, p.result_ty, 1, p.name_err_error, 9, carried),
        cur_off(p),
        1,
    )
    guard := new_node(p, NodeKind::If, failed, hand_on, -1)
    arena_push(
        p.pending,
        LocalVar { name_off = bind, name_len = guard, ty = 0, slot = 0 }
    )
    new_field_node(
        p,
        new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off),
        p.name_ok_value,
        8,
    )
}

// A name holding a borrow of a scalar, read as the value it borrows. Assigning
// to it writes through, which is what a `Deref` over the name is on both sides.
read_through_borrow :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    held := new_named_node_at(p, NodeKind::Var, 0, offset, length, offset)
    made := new_unary(p, NodeKind::Deref, held)
    // Marked as a read through a borrow rather than through a raw pointer. The
    // unsafety gate walks the whole arena with no local types in hand, so what
    // a node reads through has to be recorded where the node is made, which is
    // here.
    node := arena_at(p.arena, made)
    node.val = 1
    made
}

// `flags_has(chosen, InitFlags::Video)`: whether every bit on the right is on
// in the left, which is `(chosen & wanted) == wanted`. The bits looked for are
// bound to a name first, so however they were written they are computed once
// rather than twice.
// `wrap_add(a, b)` and its two siblings, read where the cursor already sits on
// the opening parenthesis.
parse_wrapping :: fn(mut p: Parser, op: i64) -> i64 {
    advance(p)
    left := parse_expr(p)
    advance(p)
    right := parse_expr(p)
    advance(p)
    new_node(p, NodeKind::Bin, left, right, op)
}

lower_flags_has :: fn(mut p: Parser, set: i64, wanted: i64) -> i64 {
    node := arena_at(p.arena, wanted)
    kind := node.kind
    // A number or a name is read twice for free, so it is written twice rather
    // than bound. Keeping what was written is also what lets a diagnostic say
    // that a number was handed to a set of bits.
    if (kind == NodeKind::Num) {
        copy := new_node(p, NodeKind::Num, 0, node.b, node.val)
        narrowed := new_node(p, NodeKind::Bin, set, wanted, OP_BITAND)
        return new_node(p, NodeKind::Bin, narrowed, copy, OP_EQ)
    }
    if (kind == NodeKind::Var) {
        copy := new_named_node(p, NodeKind::Var, 0, node.val, node.c)
        narrowed := new_node(p, NodeKind::Bin, set, wanted, OP_BITAND)
        return new_node(p, NodeKind::Bin, narrowed, copy, OP_EQ)
    }
    name_off := synth_numbered(p, "__bits", p.match_count)
    name_len := 6 + digits_in(p.match_count)
    p.match_count = p.match_count + 1
    bind := new_let_node(p, wanted, name_off, name_len, -1)
    arena_push(
        p.pending,
        LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
    )
    held := new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off)
    narrowed := new_node(p, NodeKind::Bin, set, held, OP_BITAND)
    again := new_named_node_at(
        p,
        NodeKind::Var,
        0,
        name_off,
        name_len,
        name_off
    )
    new_node(p, NodeKind::Bin, narrowed, again, OP_EQ)
}

// A body's last expression is its answer, so in a fallible function that value
// is the ok side of the failure set just as an explicit `return` is.
// Mark a body's last statement as the value the function answers with, so the
// type walk asks of it what it asks of a `return`.
mark_trailing_answer :: fn(mut p: Parser, body: i64, ret: i64) {
    if (body == (-1)) {
        return
    }
    mut id := body
    mut last := body
    while (id != (-1)) {
        last = id
        id = node_next(p, id)
    }
    mut node := arena_at(p.arena, last)
    if (node.kind == NodeKind::ExprStmt && node.b == 0) {
        node.b = 1
        retype_answer_binding(p, body, node.a, ret)
    }
}

// A struct literal standing as a body's answer names no type, the same way one
// written after `return` names none. A `return` sets the type it takes while
// its value is read, and a body's last expression is read with nothing set, so
// the literal reached `new_struct_lit` with no type and its fields landed in a
// layout nobody had named: two of them came back swapped and three read past
// the frame. One field hid it, which is why it went unseen.
//
// Settled against what the function answers with, before a failure set wraps
// the answer, so `-> T ! E` types the literal as the T rather than as the pair.
settle_trailing_literal :: fn(mut p: Parser, body: i64, answer: i64) {
    if (body == (-1)) {
        return
    }
    mut id := body
    mut last := body
    while (id != (-1)) {
        last = id
        id = node_next(p, id)
    }
    node := arena_at(p.arena, last)
    kind := node.kind
    value := node.a
    then_head := node.b
    else_head := node.val
    if (kind == NodeKind::ExprStmt) {
        resolve_untyped_literal(p, value, answer)
        return
    }
    // An `if` standing at the end of a body answers from each of its branches,
    // and `return_trailing_branches` makes a return of each branch's own last
    // expression. A literal written in one is read at the answer, so it takes
    // the type there the same way, however far the branches nest.
    if (kind == NodeKind::If) {
        settle_trailing_literal(p, then_head, answer)
        settle_trailing_literal(p, else_head, answer)
    }
}

// A `match` or an `if` standing where a body's answer goes binds a name its
// arms assign to, and that name took its type from the first arm. The arms are
// read at the answer the same as a number written there is, so where each
// handed back a plain number and the answer is one, the name takes the answer's
// type. Without this the arms of `-> u32 { match k { case A: LOW ... } }` are
// the `i64` their constants fold to and the answer reads as a narrowing.
retype_answer_binding :: fn(mut p: Parser, body: i64, value: i64, ret: i64) {
    if (plain_number(ret) == false) {
        return
    }
    held := arena_at(p.arena, value)
    if (held.kind != NodeKind::Var) {
        return
    }
    name_off := held.val
    name_len := held.c
    // Only the name this parse made for a `match` or an `if` used as a value.
    // A name a reader wrote is a binding they gave a type to, and reading it at
    // the answer would take that type off them: `x := n` followed by `x` is an
    // `i64` handed to whatever the function answers with, and what that costs is
    // the answer position's question rather than something to settle by writing
    // a different type onto the binding.
    //
    // Where the name sits says which it is. Every name this parse makes up is
    // written past the source's terminator, so an offset tells them apart even
    // for a reader who writes `__value0` themselves; the spelling then says
    // which made-up name it is.
    if (name_off < p.synth_start
        || starts_with_name(p.src, name_off, name_len, "__value") == false) {
        return
    }
    mut id := body
    while (id != (-1)) {
        mut stmt := arena_at(p.arena, id)
        if (stmt.kind == NodeKind::Let && stmt.c == name_len
            && bytes_equal(p.src, stmt.val, name_off, name_len)
            && plain_number(stmt.b)) {
            stmt.b = ret
            return
        }
        id = node_next(p, id)
    }
}

// A number with no name of its own: the kind a literal is, and the kind the
// context gets to type.
plain_number :: fn(ty: i64) -> bool {
    if (is_distinct(ty)) {
        return false
    }
    (is_integer(ty) || is_float(ty))
}

wrap_trailing_ok :: fn(mut p: Parser, body: i64) {
    if (body == (-1)) {
        return
    }
    mut id := body
    mut last := body
    while (id != (-1)) {
        last = id
        id = node_next(p, id)
    }
    node := arena_at(p.arena, last)
    if (node.kind == NodeKind::ExprStmt) {
        node.a = wrap_result(p, node.a)
    }
}

parse_postfix :: fn(mut p: Parser, start: i64) -> i64 {
    mut node := start
    while (cur(p) == TokenKind::Dot || cur(p) == TokenKind::Caret
        || cur(p) == TokenKind::Question || cur(p) == TokenKind::Lbracket
        || cur(p) == TokenKind::Lparen) {
        // A `(` or a `[` that opens a line starts a statement of its own.
        if ((cur(p) == TokenKind::Lparen || cur(p) == TokenKind::Lbracket)
            && on_same_line(p) == false) {
            return node
        }
        // `ops.less(a, b)`: what is called is a value rather than a name, so
        // the call is through whatever the expression so far answered with.
        if (cur(p) == TokenKind::Lparen) {
            advance(p)
            mut head: i64 = -1
            mut tail: i64 = -1
            while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
                // A call through a value takes an aggregate by address, the
                // same as a call through a name, so an aggregate a call answers
                // with is bound first. Without the binding there is nothing to
                // take the address of.
                argument_at := written_at(p)
                argument := hold_struct_result(p, parse_expr(p))
                arena_at(p.arena, argument).pos = argument_at
                held := new_node(p, NodeKind::Arg, argument, 0, 0)
                if (head == (-1)) {
                    head = held
                    tail = held
                } else {
                    set_next(p, tail, held)
                    tail = held
                }
                if (cur(p) == TokenKind::Comma) {
                    advance(p)
                }
            }
            advance(p)
            node = new_node(p, NodeKind::CallPtr, node, head, 0)
            if (p.unbound_pack_for == 1) {
                held_ptr := arena_at(p.arena, node)
                held_ptr.c = 1
            }
        } else if (cur(p) == TokenKind::Question) {
            advance(p)
            node = lower_try(p, node)
        } else if (cur(p) == TokenKind::Dot) {
            advance(p)
            offset := cur_off(p)
            length := cur_len(p)
            advance(p)
            node = new_field_node(p, node, offset, length)
        } else if (cur(p) == TokenKind::Caret) {
            operand_at := arena_at(p.arena, node).pos
            advance(p)
            node = new_unary(p, NodeKind::Deref, node)
            // Where the read begins, which is the thing being read through. The
            // node is made after the `^`, so it carried whatever follows it.
            arena_at(p.arena, node).pos = operand_at
        } else {
            bracket := cur_off(p)
            advance(p)
            at := cur_off(p)
            index := parse_expr(p)
            // `xs[1..5]` names a run rather than an element. The range reads as
            // its first value and then the `..` is left where a `]` is wanted,
            // so what the reader was told was about the bracket.
            if (cur(p) == TokenKind::Dotdot || cur(p) == TokenKind::Dotdoteq) {
                report_where(p.modules, p.src, at)
                report(
                    "an index names one element, and this is a range; `slice_range` takes part of a run"
                )
                frost_rt_recover_escape()
            }
            advance(p)
            // `list[K]` is the Kth element of a compile-time list, which is a
            // name rather than an indexed read: the list is not a value and
            // there is nothing to index at run time.
            held := pack_element_at(p, node, index)
            if (held >= 0) {
                node = held
            } else {
                node = new_index(p, node, index, bracket)
            }
        }
    }
    node
}

// The element a `list[K]` names, or -1 when this is an ordinary index. The
// index has to be a literal, since which element it is has to be known here.
pack_element_at :: fn(mut p: Parser, base: i64, index: i64) -> i64 {
    base_node := arena_at(p.arena, base)
    if (base_node.kind != NodeKind::Var) {
        return -1
    }
    base_off := base_node.val
    base_len := base_node.c
    if (names_pack(p, base_off, base_len) == false) {
        return -1
    }
    index_node := arena_at(p.arena, index)
    if (index_node.kind != NodeKind::Num) {
        report_where(p.modules, p.src, index_node.pos)
        report("a compile-time list is indexed by a literal, since which element it is has to be known here")
        frost_rt_recover_escape()
    }
    at := index_node.val
    if (at < 0 || at >= p.pack_count) {
        report_where(p.modules, p.src, index_node.pos)
        report("this call gave the list fewer values than that")
        frost_rt_recover_escape()
    }
    name_off, name_len := pack_element_name(p, p.pack_off, p.pack_len, at)
    new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, index_node.pos)
}

parse_factor :: fn(mut p: Parser) -> i64 {
    parse_postfix(p, parse_primary(p))
}

parse_field_inits :: fn(mut p: Parser, struct_ty: i64) -> i64 {
    mut head: i64 = -1
    mut tail: i64 = -1
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        offset := cur_off(p)
        length := cur_len(p)
        advance(p)
        // A field is given its value with `=`. Stepped over without asking,
        // `Point { x: 1 }` read the colon as the token before the value and
        // took a literal the language does not have.
        if (cur(p) != TokenKind::Assign) {
            report_where(p.modules, p.src, cur_off(p))
            report("a field in a literal is given its value with '=', and ")
            report("this writes '")
            report_src(p.src, cur_off(p), cur_len(p))
            report("'")
            frost_rt_recover_escape()
        }
        advance(p)
        // A field's value is parsed with the field's own type expected, so a
        // nested generic literal like the inner `Pair { ... }` in a
        // `Pair<i64, Pair<i64, i64>>` resolves to the right instance.
        mut absent: i64 = 0
        // A field the struct does not carry, said before its type is asked
        // for. Asking unwinds out of the parse, so the rest of the function
        // read as declarations and one refusal became two. Reported without
        // unwinding, since the parse is refused as a whole once it is done.
        if (is_struct_ty(struct_ty)
            && struct_has_field(p, struct_ty, offset, length) == false) {
            report_where(p.modules, p.src, offset)
            report("struct '")
            report_type_name(p, struct_ty)
            report("' has no field '")
            report_src(p.src, offset, length)
            report("'")
            frost_rt_recover_note()
            absent = 1
        }
        saved_expected := p.expected_type
        // Asking for the type of a field that is not there is what unwinds, so
        // the value is parsed against nothing instead.
        if (absent == 1) {
            p.expected_type = TY_I64
        } else {
            p.expected_type = field_type(p, struct_ty, offset, length)
        }
        value_at := written_at(p)
        value := parse_expr(p)
        // The same as an argument: a node carries where the cursor was when it
        // was made, and a report about the value means where it begins.
        arena_at(p.arena, value).pos = value_at
        p.expected_type = saved_expected
        init := new_field_init(p, value, offset, length)
        if (head == (-1)) {
            head = init
            tail = init
        } else {
            set_next(p, tail, init)
            tail = init
        }
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    head
}

// A struct answered by a call has nowhere to live, and a struct is passed on by
// its address, so one handed straight to another call is bound first. The
// binding is what the address is taken of.
hold_struct_result :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call) {
        return value
    }
    // Where the call is written, read before anything pushes to the arena and
    // may move it.
    at := node.pos
    callee := arena_at(p.fns, node.val)
    if (is_aggregate(callee.ret_type) == false) {
        return value
    }
    name_off := synth_numbered(p, "__arg", p.match_count)
    name_len := 5 + digits_in(p.match_count)
    p.match_count = p.match_count + 1
    bind := new_let_node(p, value, name_off, name_len, -1)
    arena_push(
        p.pending,
        LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
    )
    // The name binds the call, so an argument written as the call reads the
    // same as one written as a name given the call.
    settle_call_answer(p, value)
    record_parse_local(p, name_off, name_len, binding_type(p, value), value)
    // At the call this name stands for. Given the name's own offset, every
    // report about the argument landed in the room past the source, on the
    // names the compiler interns rather than on anything written down.
    new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, at)
}

// The arguments of a call, with the callee's index when there is one. Each
// argument is parsed under the type the parameter declares, which is what a
// `.Variant` written there takes its enum from. A callee defined later in the
// program has no parameters yet, so the literal is recorded and patched once
// every signature is known.
// Whether the argument about to be read is the compile-time list itself,
// written as its own name and nothing else.
names_the_pack :: fn(mut p: Parser) -> bool {
    if (p.pack_len == 0) {
        return false
    }
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    if (cur_len(p) != p.pack_len) {
        return false
    }
    if (bytes_equal(p.src, cur_off(p), p.pack_off, p.pack_len) == false) {
        return false
    }
    peek_kind(p, 1) == TokenKind::Comma || peek_kind(p, 1) == TokenKind::Rparen
}

// Whether any argument of a call is written as a name nothing has declared yet.
// A local, a parameter, a constant already read and a function already read are
// all names this parse can type; what is left is a declaration further down the
// file, and typing one here answers with a number.
args_name_a_later_declaration :: fn(mut p: Parser, args: i64) -> bool {
    mut id := args
    while (id != (-1)) {
        entry := arena_at(p.arena, id)
        node := arena_at(p.arena, entry.a)
        if (node.kind == NodeKind::Var
            && local_exists(p, node.val, node.c) == false
            && parse_local_type(p, node.val, node.c) < 0
            && value_const_node(p, node.val, node.c) < 0
            && is_const(p, node.val, node.c) == false
            && global_is_defined(p, node.val, node.c) == false) {
            return true
        }
        id = entry.next
    }
    false
}

// Whether a name has already been read as a function of this program.
global_is_defined :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i: i64 = 0
    while (i < p.fns.count) {
        held := arena_at(p.fns, i)
        if (held.len == len && held.defined == 1
            && bytes_equal(p.src, held.off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// The same argument during a template's own parse, where the list this
// declaration takes has nothing bound to it yet. Handing the list on to another
// generic reads here as one ordinary name, and typing that name gave the callee
// a tuple built from a list that does not exist: the instance it named took the
// element as a number, and the real call went out to it. Marked the way the map
// form is, so nothing later asks this call for a type.
names_unbound_pack :: fn(mut p: Parser) -> bool {
    if (p.pack_len > 0 || p.decl_pack_len == 0) {
        return false
    }
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    if (cur_len(p) != p.decl_pack_len) {
        return false
    }
    if (bytes_equal(p.src, cur_off(p), p.decl_pack_off, p.decl_pack_len) == false) {
        return false
    }
    peek_kind(p, 1) == TokenKind::Comma || peek_kind(p, 1) == TokenKind::Rparen
}

// One argument per element of the list, in order: a value element is the
// parameter this instance took it under, a type element is the type itself.
// Where the thing about to be parsed was written. A text token records where
// its bytes begin, which is past the quote that opened it, and the quote is
// what the reader wrote.
written_at :: fn(mut p: Parser) -> i64 {
    if (cur(p) == TokenKind::Str) {
        return cur_off(p) - 1
    }
    cur_off(p)
}

splice_pack_arguments :: fn(
    mut p: Parser,
    head_in: i64,
    tail_in: i64,
    index_in: i64,
    at: i64
) -> (head: i64, tail: i64, index: i64) {
    mut head := head_in
    mut tail := tail_in
    mut index := index_in
    mut k: i64 = 0
    while (k < p.pack_count) {
        element := arena_at(p.gargs, p.pack_start + k)
        mut value: i64 = -1
        if (element.const_len > 0) {
            // The constant itself, so the callee reads it as one too and the
            // body it unrolls names the same function this one names.
            value = new_named_node_at(
                p,
                NodeKind::Var,
                0,
                element.const_off,
                element.const_len,
                at
            )
        } else if (element.is_type == 1) {
            value = new_type_node(p, NodeKind::TypeVal, 0, element.value)
        } else {
            name_off, name_len := pack_element_name(
                p,
                p.pack_off,
                p.pack_len,
                k
            )
            value = new_named_node_at(
                p,
                NodeKind::Var,
                0,
                name_off,
                name_len,
                at
            )
        }
        arg := new_node(p, NodeKind::Arg, value, 0, 0)
        if (head == (-1)) {
            head = arg
            tail = arg
        } else {
            set_next(p, tail, arg)
            tail = arg
        }
        index = index + 1
        k = k + 1
    }
    return head, tail, index
}

// `g(T) for T in list`: the expression once per element, with the element's
// name standing for it. The cursor is past the expression and on the `for`, so
// the header is read once and then the expression is read again per element
// from where it started.
splice_pack_map :: fn(
    mut p: Parser,
    argument_start: i64,
    parsed: i64,
    head_in: i64,
    tail_in: i64,
    index_in: i64
)
    -> (head: i64, tail: i64, index: i64) {
    advance(p)
    item_off := cur_off(p)
    item_len := cur_len(p)
    advance(p)
    advance(p)
    list_off := cur_off(p)
    list_len := cur_len(p)
    advance(p)
    after := p.ti
    // The template's own parse has no list bound, and everything it produces is
    // thrown away and read again per instance. So the expression is kept once
    // and the tokens are consumed, which is what a template parse is for.
    if (p.pack_len == 0) {
        p.args_unbound_map = 1
        arg := new_node(p, NodeKind::Arg, parsed, 0, 0)
        mut only_tail := tail_in
        mut only_head := head_in
        if (only_head == (-1)) {
            only_head = arg
        } else {
            set_next(p, only_tail, arg)
        }
        only_tail = arg
        return only_head, only_tail, index_in + 1
    }
    if (list_len != p.pack_len
        || bytes_equal(p.src, list_off, p.pack_off, p.pack_len) == false) {
        report_where(p.modules, p.src, list_off)
        report("'")
        report_src(p.src, list_off, list_len)
        report("' is not the compile-time list this function takes, and `for` in an argument list walks one")
        frost_rt_recover_escape()
    }
    mut head := head_in
    mut tail := tail_in
    mut index := index_in
    mut k: i64 = 0
    while (k < p.pack_count) {
        p.ti = argument_start
        element := arena_at(p.gargs, p.pack_start + k)
        element_ty := element.value
        mut mark: i64 = p.aliases.count
        mut type_mark: i64 = p.type_aliases.count
        if (element.is_type == 1) {
            arena_push(
                p.type_aliases,
                ConstDef {
                    name_off = item_off,
                    name_len = item_len,
                    value = element_ty,
                    kind = CONST_INT,
                    count = 0
                }
            )
        } else {
            name_off, name_len := pack_element_name(
                p,
                p.pack_off,
                p.pack_len,
                k
            )
            mark = push_alias(p, item_off, item_len, name_off, name_len)
        }
        value := hold_struct_result(p, parse_expr(p))
        p.aliases.count = mark
        p.type_aliases.count = type_mark
        arg := new_node(p, NodeKind::Arg, value, 0, 0)
        if (head == (-1)) {
            head = arg
            tail = arg
        } else {
            set_next(p, tail, arg)
            tail = arg
        }
        index = index + 1
        k = k + 1
    }
    p.ti = after
    return head, tail, index
}

parse_arg_list_for :: fn(
    mut p: Parser,
    callee: i64
) -> (head: i64, unbound: i64) {
    mut head: i64 = -1
    mut tail: i64 = -1
    mut index: i64 = 0
    // An argument that is itself a call reads its own list, and that reading
    // starts from nothing. What this list had found is kept, since a list inside
    // an unbound one is unbound too: `put_bytes($out, line, span(fmt, at, n))`
    // read the inner call and forgot that `$out` was a placeholder.
    outer_unbound := p.args_unbound_map
    p.args_unbound_map = 0
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        saved_expected := p.expected_type
        saved_alt := p.expected_alt
        if (callee >= 0) {
            entry := arena_at(p.fns, callee)
            params := entry.params
            mut declared := nth_param_type(p, params, index)
            // Asked rather than read off the number. A distinct type's code
            // sits above the borrow flag, so a `Key` parameter answered a bare
            // comparison as a borrow and the subtraction left a code standing
            // for nothing.
            if (is_borrow(declared)) {
                declared = pointee(p, declared)
            }
            p.expected_type = declared
            p.expected_alt = -1
        }
        // An argument list is the one place a compile-time list stands for
        // several things at once: naming it hands over its elements, and
        // `g(T) for T in list` hands the expression over once per element.
        // Both are what give a call an arity the list decides.
        argument_start := p.ti
        // Anything the argument queues for the block belongs to the argument.
        // A `g(T) for T in list` is read once to find the `for` and then again
        // per element, and that first read is thrown away, so what it queued
        // has to go with it.
        pending_mark := p.pending.count
        if (names_the_pack(p)) {
            pack_at := cur_off(p)
            advance(p)
            spliced_head, spliced_tail, spliced_index :=
            splice_pack_arguments(p, head, tail, index, pack_at)
            head = spliced_head
            tail = spliced_tail
            index = spliced_index
            p.expected_type = saved_expected
            p.expected_alt = saved_alt
        } else {
            if (names_unbound_pack(p)) {
                p.args_unbound_map = 1
            }
            // A node records where the cursor was when it was made, which for
            // anything with children is past all of them, so an argument that
            // is a literal or a call carries its own last token. What a report
            // about the argument means is where the reader started writing it.
            value_at := written_at(p)
            value := hold_struct_result(p, parse_expr(p))
            arena_at(p.arena, value).pos = value_at
            p.expected_type = saved_expected
            p.expected_alt = saved_alt
            if (cur(p) == TokenKind::KwFor) {
                p.pending.count = pending_mark
                mapped_head, mapped_tail, mapped_index :=
                splice_pack_map(p, argument_start, value, head, tail, index)
                head = mapped_head
                tail = mapped_tail
                index = mapped_index
            } else {
                if (callee >= 0) {
                    held := arena_at(p.arena, value)
                    if (held.kind == NodeKind::StructLit
                        && held.val == (-1)) {
                        arena_push(
                            p.variant_fixups,
                            VariantFixup {
                                lit = value,
                                callee = callee,
                                argument = index,
                                kind = FixupKind::Literal
                            }
                        )
                    }
                }
                arg := new_node(p, NodeKind::Arg, value, 0, 0)
                if (head == (-1)) {
                    head = arg
                    tail = arg
                } else {
                    set_next(p, tail, arg)
                    tail = arg
                }
                index = index + 1
            }
        }
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        } else if (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof
            && cur(p) != TokenKind::Illegal) {
            // A comma separates one argument from the next. A token that begins
            // no expression is reported as the token it is, by the walk that
            // reads the next argument.
            report_where(p.modules, p.src, cur_off(p))
            report("expected ',' between one element and the next, found '")
            report_src(p.src, cur_off(p), cur_len(p))
            report("'")
            frost_rt_recover_escape()
        }
    }
    advance(p)
    mine := p.args_unbound_map
    // The list this one sits in keeps what it had found, and takes this on
    // besides: an argument that is itself a call written against a template's
    // placeholders leaves the enclosing call with an argument whose type is a
    // guess. Without this, `put_bytes($out, line, span(fmt, at, n))` read the
    // inner call and forgot that `$out` was one.
    p.args_unbound_map = outer_unbound
    return head, mine
}

// Prefix `-` and `!`, binding tighter than every binary operator and looser
// than a postfix, which is what the precedence table says.
//
// There is no node kind for either, and that is not a shortcut. A negated
// number is folded into the number, so it stays the untyped literal it was and
// `m : Meters = -1` is still a literal taking a type from where it is written.
// A negated float carries a flag rather than becoming a subtraction, which is
// what keeps `-0.0` the number it was written as. Everything else becomes the
// arithmetic it means, `-x`, which `type_of` already answers correctly for
// floats, for distinct types and for every integer width, and `!x` becomes
// `x == false`, which is what it is.
//
// This layer was missing entirely. `-1` parsed, and `-z` did not: it was read
// as a subtraction with nothing on its left, and what came out was whatever
// happened to be lying there. That is why there is not one bare negative
// literal anywhere in the standard library or in this compiler.
parse_unary :: fn(mut p: Parser) -> i64 {
    kind := cur(p)
    start := cur_off(p)
    if (kind == TokenKind::Minus) {
        advance(p)
        if (cur(p) == TokenKind::Int) {
            value := cur_val(p)
            advance(p)
            return new_node_at(p, NodeKind::Num, 0, 0, -value, start)
        }
        if (cur(p) == TokenKind::Float) {
            offset := cur_off(p)
            length := cur_len(p)
            advance(p)
            made := new_named_node_at(
                p,
                NodeKind::Float,
                0,
                offset,
                length,
                start
            )
            mut node := arena_at(p.arena, made)
            node.b = 1
            return made
        }
        operand := parse_unary(p)
        // `-a` is written as a subtraction from nothing, and the nothing has to
        // be a number of the kind the other side holds: over a vector of floats
        // a whole number is not one a lane can take, and the reader who wrote a
        // minus was told a vector and an `i64` do not go together.
        mut zero := new_node_at(p, NodeKind::Num, 0, 0, 0, start)
        held := parse_time_type(p, operand)
        if (is_vector_ty(p, held)
            && is_float(array_element(p, vector_of(p, held)))) {
            written := p.synth_next
            synth_bytes(p, "0.0")
            p.src[p.synth_next] = 0
            p.synth_next = p.synth_next + 1
            zero = new_named_node_at(p, NodeKind::Float, 0, written, 3, start)
        }
        return new_arith(p, zero, operand, OP_SUB, start)
    }
    if (kind == TokenKind::Bang) {
        // Reported rather than escaped. The expression reads one way whichever
        // spacing it was written with, so the parse carries on and the reader
        // is told the one thing that is wrong.
        if (tokens_touch(p, p.ti) == false) {
            report_where(p.modules, p.src, cur_off(p))
            report("a `!` with a space after it marks a failure set, and this one negates; write it against what it negates, as `!ready`")
            frost_rt_recover_note()
        }
        advance(p)
        operand := parse_unary(p)
        zero := new_node_at(p, NodeKind::Num, 0, 0, 0, start)
        made := new_node_at(p, NodeKind::Bin, operand, zero, OP_EQ, start)
        // A comparison against false, so both backends carry it with the code
        // they already have. Marked as written with `!`, which is what holds
        // the operand to a yes or no: the node is otherwise what `x == false`
        // parses to, and that one takes whatever `==` takes.
        held := arena_at(p.arena, made)
        held.c = 1
        return made
    }
    parse_factor(p)
}

// The width a vector may be, in bytes. A register's worth: `[16]f32` is one
// AVX-512 register and `[4]f64` is half of one, and a length past this is a
// loop the reader would not see written down.
VECTOR_LIMIT :: 64

// The type a value has while the declaration is still being parsed, or -1
// where nothing here says.
//
// This never asks `type_of`. That walk instantiates a generic to work an answer
// out, and this one runs at every arithmetic operator in the program, so asking
// it built types nothing had asked for and filled an arena. Every shape below
// is a table lookup, and the shapes a vector can arrive as are the ones it
// knows: a name, an element of one, a field of one, an operator over two, a
// literal, and what a function was declared to answer with.
parse_time_type :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    kind := node.kind
    if (kind == NodeKind::Var) {
        return parse_local_type(p, node.val, node.c)
    }
    if (kind == NodeKind::Index) {
        base := parse_time_type(p, node.a)
        if (is_array_ty(base)) {
            return array_element(p, base)
        }
        return -1
    }
    if (kind == NodeKind::Field) {
        base := parse_time_type(p, node.a)
        if (base < 0) {
            return -1
        }
        return field_type_by_range(p, base, node.val, node.c)
    }
    if (kind == NodeKind::ArrayLit) {
        if (node.val != 0) {
            return array_of(p, node.val - 1, node.c)
        }
        return -1
    }
    if (kind == NodeKind::Call) {
        callee := arena_at(p.fns, node.val)
        return callee.ret_type
    }
    // An operator over a vector answers with that vector, and the operands are
    // still names the walks have not seen, so the question goes to them.
    if (kind == NodeKind::Bin && op_answers_truth(node.val) == false) {
        left := vector_of(p, parse_time_type(p, node.a))
        if (left >= 0) {
            return left
        }
        return vector_of(p, parse_time_type(p, node.b))
    }
    -1
}

// The type an assignment's place gives the value beside it, which is the
// context `phase = .Draining` reads its enum out of and `h = { a = 2 }` reads
// its struct out of. A `mut` parameter travels as an address, and the name
// stands for what it points at.
assign_context :: fn(mut p: Parser, place: i64) -> i64 {
    ty := parse_time_type(p, place)
    if (ty >= 0 && is_borrow(ty) && is_aggregate(pointee(p, ty))) {
        return pointee(p, ty)
    }
    ty
}

// Whether this type is a run of numbers a vector register holds: a fixed array
// of an integer or a float. A slice is not one, since its length is decided
// where the program runs.
is_vector_ty :: fn(mut p: Parser, ty: i64) -> bool {
    held := vector_of(p, ty)
    if (held < 0) {
        return false
    }
    element := array_element(p, held)
    is_integer(element) || is_float(element)
}

vector_op_text :: fn(op: i64) -> ^i8 {
    if (op == OP_ADD) { return "+" }
    if (op == OP_SUB) { return "-" }
    if (op == OP_MUL) { return "*" }
    if (op == OP_DIV) { return "/" }
    if (op == OP_MOD) { return "%" }
    if (op == OP_BITAND) { return "&" }
    if (op == OP_BITOR) { return "|" }
    if (op == OP_SHL) { return "<<" }
    if (op == OP_SHR) { return ">>" }
    if (op == OP_LT) { return "<" }
    if (op == OP_LE) { return "<=" }
    if (op == OP_GT) { return ">" }
    if (op == OP_GE) { return ">=" }
    if (op == OP_EQ) { return "==" }
    "!="
}

// One side of an elementwise operation, bound to a name so its lanes are read
// out of one place. A call written there is made once, which is what a lane
// per read of the expression would not give.
hold_vector_operand :: fn(mut p: Parser, value: i64, ty: i64) -> i64 {
    held := arena_at(p.arena, value)
    if (held.kind == NodeKind::Var || held.kind == NodeKind::Field) {
        return value
    }
    name_off := synth_numbered(p, "__lane", p.match_count)
    name_len := 6 + digits_in(p.match_count)
    p.match_count = p.match_count + 1
    bind := new_let_node(p, value, name_off, name_len, ty)
    arena_push(
        p.pending,
        LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
    )
    record_parse_local(p, name_off, name_len, ty, value)
    new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off)
}

// Two sides that do not go together. A vector reads by its length and element
// and anything else by its own name, written out here rather than by the type
// renderer, since the two compilers render a fixed array's length differently
// and a diagnostic is one sentence in one language.
report_mismatch :: fn(mut p: Parser, start: i64, vector: i64, other: i64) {
    report_where(p.modules, p.src, start)
    report_operand(p, vector)
    report(" and ")
    report_operand(p, other)
    report(" do not go together; elementwise arithmetic is over two of one ")
    report("vector type, or a vector and a number of its element type")
    frost_rt_recover_escape()
}

report_operand :: fn(mut p: Parser, ty: i64) {
    held := vector_of(p, ty)
    if (held < 0) {
        report("a ")
        report_type_name(p, ty)
        return
    }
    report_fmt("a vector of {} ", array_length(p, held))
    report_type_name(p, array_element(p, held))
}

// An arithmetic operator over two values, where a vector on either side means
// the operation is done once per lane.
//
// `a + b` over two `[4]f32` is four adds, so what a lane does is what a number
// does: a float rounds as one number does, and a whole number aborts on
// overflow and says where. The lanes are written out as an array literal bound
// to a name, so every backend carries this with the code it already has.
// The type a report names an operand by. A literal carries none of its own,
// since it takes the one the context wants, and named by that it read as `a
// value` where the reader wrote a number.
written_type :: fn(mut p: Parser, id: i64, held: i64) -> i64 {
    if (untyped_literal(p, id) == false) {
        return held
    }
    node := arena_at(p.arena, constant_node(p, id))
    if (node.kind == NodeKind::Float) {
        return TY_F64
    }
    if (node.kind == NodeKind::Num) {
        return TY_I64
    }
    held
}

// A number written beside a vector that the element's type can take.
//
// A literal takes the type the context wants, so `v * 2.0` beside a vector of
// `f32` is a float in every lane. A whole number is not one: what a lane holds
// is written as `2.0` where the lanes are floats, and asking only whether a
// literal was written let `v + 1` through as though it had been.
lane_literal :: fn(mut p: Parser, id: i64, element: i64) -> bool {
    if (untyped_literal(p, id) == false) {
        return false
    }
    node := arena_at(p.arena, constant_node(p, id))
    if (is_float(element)) {
        return node.kind == NodeKind::Float
    }
    node.kind == NodeKind::Num
}

new_arith :: fn(
    mut p: Parser,
    left: i64,
    right: i64,
    op: i64,
    start: i64
) -> i64 {
    left_ty := parse_time_type(p, left)
    right_ty := parse_time_type(p, right)
    left_vector := is_vector_ty(p, left_ty)
    right_vector := is_vector_ty(p, right_ty)
    if (left_vector == false && right_vector == false) {
        return new_node_at(p, NodeKind::Bin, left, right, op, start)
    }
    mut vector := vector_of(p, left_ty)
    if (left_vector == false) {
        vector = vector_of(p, right_ty)
    }
    element := array_element(p, vector)
    count := array_length(p, vector)
    if (left_vector && right_vector
        && vector_of(p, left_ty) != vector_of(p, right_ty)) {
        report_mismatch(p, start, vector, vector_of(p, right_ty))
    }
    if (left_vector == false && left_ty != element
        && lane_literal(p, left, element) == false) {
        report_mismatch(p, start, vector, written_type(p, left, left_ty))
    }
    if (right_vector == false && right_ty != element
        && lane_literal(p, right, element) == false) {
        report_mismatch(p, start, vector, written_type(p, right, right_ty))
    }
    if (count <= 0 || (count & (count - 1)) != 0) {
        report_where(p.modules, p.src, start)
        report_fmt(
            "elementwise arithmetic is over a vector whose length is a power of two, and {} is not one",
            count
        )
        frost_rt_recover_escape()
    }
    bytes := type_size(p, element) * count
    if (bytes > VECTOR_LIMIT) {
        report_where(p.modules, p.src, start)
        report_fmt(
            "elementwise arithmetic is over a vector of at most {} bytes, which is a register's worth, and this one is {}",
            VECTOR_LIMIT,
            bytes
        )
        frost_rt_recover_escape()
    }
    whole := is_integer(element)
    arithmetic := op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV
    bitwise := (op == OP_MOD || op == OP_BITAND || op == OP_BITOR
        || op == OP_SHL || op == OP_SHR)
    if (arithmetic == false && (whole == false || bitwise == false)) {
        report_where(p.modules, p.src, start)
        report("'")
        report_cstr(vector_op_text(op))
        report("' is not something two vectors answer; a vector takes '+', ")
        report("'-', '*' and '/', and one of whole numbers takes '%', '&', ")
        report("'|', '<<' and '>>' as well")
        frost_rt_recover_escape()
    }
    // A float vector stays one operation, which is what a packed instruction
    // is. A vector of whole numbers is written out lane by lane, because an
    // overflow aborts and says which lane it was, and a packed add has no way
    // to say that.
    if (whole == false && bytes % 16 == 0) {
        left_side := vector_operand(
            p,
            left,
            left_vector,
            vector,
            element,
            count
        )
        right_side := vector_operand(
            p,
            right,
            right_vector,
            vector,
            element,
            count
        )
        return new_node_at(p, NodeKind::Bin, left_side, right_side, op, start)
    }
    mut lhs := left
    mut rhs := right
    if (left_vector) {
        lhs = hold_vector_operand(p, left, left_ty)
    }
    if (right_vector) {
        rhs = hold_vector_operand(p, right, right_ty)
    }
    mut head: i64 = -1
    mut tail: i64 = -1
    mut lane: i64 = 0
    while (lane < count) {
        mut a := lhs
        mut b := rhs
        if (left_vector) {
            a = new_index(
                p,
                clone_place(p, lhs),
                new_node_at(p, NodeKind::Num, 0, 0, lane, start),
                start
            )
        }
        if (right_vector) {
            b = new_index(
                p,
                clone_place(p, rhs),
                new_node_at(p, NodeKind::Num, 0, 0, lane, start),
                start
            )
        }
        computed := new_node_at(p, NodeKind::Bin, a, b, op, start)
        item := new_node(p, NodeKind::Arg, computed, 0, 0)
        if (head == (-1)) {
            head = item
        } else {
            set_next(p, tail, item)
        }
        tail = item
        lane = lane + 1
    }
    made := new_node(p, NodeKind::ArrayLit, head, 0, 0)
    literal := arena_at(p.arena, made)
    literal.c = count
    literal.val = element + 1
    bind_vector(p, made, vector)
}

// A name bound to a vector value, so what follows reads it out of one place.
bind_vector :: fn(mut p: Parser, value: i64, vector: i64) -> i64 {
    name_off := synth_numbered(p, "__lane", p.match_count)
    name_len := 6 + digits_in(p.match_count)
    p.match_count = p.match_count + 1
    bind := new_let_node(p, value, name_off, name_len, vector)
    arena_push(
        p.pending,
        LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
    )
    record_parse_local(p, name_off, name_len, vector, value)
    new_named_node_at(p, NodeKind::Var, 0, name_off, name_len, name_off)
}

// One side of a packed operation as a vector. A number written beside a vector
// is that number in every lane, which is a literal of N copies rather than an
// instruction of its own.
vector_operand :: fn(
    mut p: Parser,
    value: i64,
    is_vector: bool,
    vector: i64,
    element: i64,
    count: i64
) -> i64 {
    if (is_vector) {
        return value
    }
    mut head: i64 = -1
    mut tail: i64 = -1
    mut lane: i64 = 0
    while (lane < count) {
        item := new_node(p, NodeKind::Arg, value, 0, 0)
        if (head == (-1)) {
            head = item
        } else {
            set_next(p, tail, item)
        }
        tail = item
        lane = lane + 1
    }
    made := new_node(p, NodeKind::ArrayLit, head, 0, 0)
    literal := arena_at(p.arena, made)
    literal.c = count
    literal.val = element + 1
    bind_vector(p, made, vector)
}

parse_mul :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_unary(p)
    mut kind := cur(p)
    while (joins_line(p) && (kind == TokenKind::Star || kind == TokenKind::Slash || kind == TokenKind::Percent)) {
        mut op: i64 = OP_MUL
        if (kind == TokenKind::Slash) {
            op = OP_DIV
        }
        if (kind == TokenKind::Percent) {
            op = OP_MOD
        }
        advance(p)
        right := parse_unary(p)
        left = new_arith(p, left, right, op, start)
        kind = cur(p)
    }
    left
}

parse_add :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_mul(p)
    mut kind := cur(p)
    // A `-` that opens a line negates what follows it rather than subtracting
    // it from the statement above, since a statement ends at the line break and
    // `-x` is a statement of its own. A `+` has no prefix form, so a line that
    // opens with one can only be the continuation of the line above it.
    while (joins_line(p) && (kind == TokenKind::Plus
            || (kind == TokenKind::Minus && on_same_line(p)))) {
        mut op: i64 = OP_ADD
        if (kind == TokenKind::Minus) {
            op = OP_SUB
        }
        advance(p)
        right := parse_mul(p)
        left = new_arith(p, left, right, op, start)
        kind = cur(p)
    }
    left
}

// The three bitwise levels sit between comparison and `+`, binding tighter than
// a comparison and looser than a shift, so `a & mask == 0` groups as the C it
// lowers to would. A shift binds tighter still, below `+`. None of the three is
// used in this compiler's own source, so their precedence does not touch the
// self-hosting fixpoint. They exist so handle packing, `(gen << 32) | index`,
// can be written in the language.
parse_shift :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_add(p)
    mut kind := cur(p)
    while (joins_line(p) && (kind == TokenKind::Shl || kind == TokenKind::Shr)) {
        mut op: i64 = OP_SHL
        if (kind == TokenKind::Shr) {
            op = OP_SHR
        }
        advance(p)
        right := parse_add(p)
        left = new_arith(p, left, right, op, start)
        kind = cur(p)
    }
    left
}

parse_bitand :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_shift(p)
    while (joins_line(p) && (cur(p) == TokenKind::Amp)) {
        advance(p)
        right := parse_shift(p)
        left = new_arith(p, left, right, OP_BITAND, start)
    }
    left
}

parse_bitor :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_bitand(p)
    while (joins_line(p) && (cur(p) == TokenKind::Pipe)) {
        advance(p)
        right := parse_bitand(p)
        left = new_arith(p, left, right, OP_BITOR, start)
    }
    left
}

// The right side of a comparison, read at the type the left side has where it
// is written as a leading dot. `key == .Left` names a value under whatever
// `key` is, and nothing but the other side says what that is. The bootstrap
// reads the two the same way round.
//
// Asked only of a leading dot, since deriving the type of an expression is
// what instantiates a generic it names, and every other operand says what it
// is on its own.
parse_cmp_right :: fn(mut p: Parser, left: i64) -> i64 {
    if (cur(p) != TokenKind::Dot) {
        return parse_bitor(p)
    }
    saved := p.expected_type
    p.expected_type = parse_time_type(p, left)
    right := parse_bitor(p)
    p.expected_type = saved
    right
}

parse_cmp :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    left := parse_bitor(p)
    kind := cur(p)
    if (kind == TokenKind::Lt) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_LT, start)
    }
    if (kind == TokenKind::Le) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_LE, start)
    }
    if (kind == TokenKind::Gt) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_GT, start)
    }
    if (kind == TokenKind::Ge) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_GE, start)
    }
    if (kind == TokenKind::Eqeq) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_EQ, start)
    }
    if (kind == TokenKind::Ne) {
        advance(p)
        right := parse_cmp_right(p, left)
        return new_arith(p, left, right, OP_NE, start)
    }
    left
}

parse_and :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_cmp(p)
    while (joins_line(p) && (cur(p) == TokenKind::Andand)) {
        advance(p)
        right := parse_cmp(p)
        left = new_node_at(p, NodeKind::Bin, left, right, OP_AND, start)
    }
    left
}

parse_expr :: fn(mut p: Parser) -> i64 {
    start := cur_off(p)
    mut left := parse_and(p)
    while (joins_line(p) && cur(p) == TokenKind::Oror) {
        advance(p)
        right := parse_and(p)
        left = new_node_at(p, NodeKind::Bin, left, right, OP_OR, start)
    }
    left
}

parse_block :: fn(mut p: Parser) -> i64 {
    advance(p)
    // A loop's names reach its body and no further. The head wrote them down
    // and this is the block they are for, so this is where they come off.
    mine := p.loop_body_mark
    p.loop_body_mark = -1
    p.block_depth = p.block_depth + 1
    head := parse_stmt_list(p, TokenKind::Rbrace)
    p.block_depth = p.block_depth - 1
    if (mine >= 0) {
        p.loop_names.count = mine
    }
    // The list stops at the closing brace or at the end of the file. Stepping
    // over a brace that is not there steps past the last token, and the next
    // walk to read one indexes the token arena out of range, which is an
    // internal fault where a file with a brace missing should get a report.
    if (cur(p) != TokenKind::Rbrace) {
        // A parse already recovering from a fault got here by resynchronizing
        // over the brace, so the block is closed and the reader has been told
        // what is wrong with the file. Saying a brace is missing as well would
        // name a second fault the file does not have.
        if (frost_rt_recover_failures() > 0) {
            return head
        }
        // At the last token rather than at the end of the file, which carries
        // no place a reader can look. That is the token the read stopped on,
        // which is the brace for an empty block and the last statement for one
        // that holds something.
        mut at := cur_off(p)
        if (p.ti > 0) {
            at = arena_at(p.tokens, p.ti - 1).off
        }
        report_where(p.modules, p.src, at)
        report("expected '}' to close this block, found the end of the file")
        frost_rt_recover_escape()
        return head
    }
    advance(p)
    head
}

// Close a generic argument list. The lexer runs two `>` together into one shift
// token, so a `>>` that ends a nested generic closes this one and leaves a `>`
// pending for the generic around it, as in `Vec<Vec<i64>>`.
consume_generic_close :: fn(mut p: Parser) {
    if (p.pending_gt == 1) {
        p.pending_gt = 0
    } else if (cur(p) == TokenKind::Shr) {
        advance(p)
        p.pending_gt = 1
    } else {
        advance(p)
    }
}

// Parse a type and return its type code. Each pointer prefix adds a pointer
// level (a borrow is a C pointer). A leading `$` marks a type
// parameter. If none is bound yet in the current generic, this use establishes
// it. `Generic<Arg>` instantiates the generic struct to a concrete one. A `<...>`
// on a non-generic name is consumed and treated as i64.
// What a layout answers is a number, and the three places this is called from
// read a type or a length. A reader who wrote one meant it as a compile-time
// number, and the order is what there is to say: the layout pass reads the
// types, and every one of these is settled before it does.
//
// Read on instead, the word was taken for a type name and each of its
// parentheses was what the reader was told about.
refuse_layout_answer :: fn(mut p: Parser) {
    if (cur(p) != TokenKind::Ident || peek_kind(p, 1) != TokenKind::Lparen) {
        return
    }
    if (names_a_layout(p, cur_off(p), cur_len(p)) == false) {
        return
    }
    report_where(p.modules, p.src, cur_off(p))
    report("'")
    report_src(p.src, cur_off(p), cur_len(p))
    report("' is answered once the types are read, and a ")
    report("compile-time value is worked out before that")
    frost_rt_recover_escape()
}

// Whether this name is one of the compile-time parameters the declaration being
// read takes: the one that fills the primary slot, or any of the rest written
// after it. `map_put` writes `$K` and `$V`, and asking only about the primary
// left every `$V` parameter reading as a type rather than as the parameter.
names_a_compile_time_param :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    if (p.type_param_len == len && p.type_param_len > 0
        && bytes_equal(p.src, off, p.type_param_off, len)) {
        return true
    }
    mut i: i64 = 0
    while (i < p.xparam_count) {
        param := arena_at(p.gparams, p.xparam_start + i)
        if (param.name_len == len
            && bytes_equal(p.src, param.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

parse_type :: fn(mut p: Parser) -> i64 {
    refuse_layout_answer(p)
    // `ref T` is a borrow of T: the same address a `^T` is, but one the
    // checker has proven points at a live value, so reaching through it is
    // not gated the way a raw pointer is.
    if (cur(p) == TokenKind::KwRef) {
        advance(p)
        return borrow_of(p, parse_type(p))
    }
    // `fn(T, U) -> R` is a function pointer: the address of a function of that
    // signature, a callable value. A `mut` parameter is a borrow, the same as a
    // `mut` parameter of a real function is. A `move` or plain one is the type
    // as written. With no `-> R` the function answers with nothing.
    if (cur(p) == TokenKind::KwFn) {
        advance(p)
        advance(p)
        param_start := p.proc_params.count
        mut param_count: i64 = 0
        while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
            mut is_mut: i64 = 0
            if (cur(p) == TokenKind::KwMut) {
                is_mut = 1
                advance(p)
            }
            if (cur(p) == TokenKind::KwMove) {
                advance(p)
            }
            // `value T` says C passes that parameter as the struct itself,
            // which is what a callback taking one is declared with. The callee
            // holds a borrow of it either way, so this is the same type a
            // definition's `value` parameter has and the two match without a
            // rule of their own. As a mode it is followed by the type it marks,
            // which is what tells it from a type named `value`.
            mut is_value: i64 = 0
            if (cur(p) == TokenKind::Ident && peek_kind(p, 1) != TokenKind::Comma
                && peek_kind(p, 1) != TokenKind::Rparen
                && str_range_eq(p.src, cur_off(p), cur_len(p), "value")) {
                is_value = 1
                advance(p)
            }
            mut param_ty := parse_type(p)
            if (is_mut == 1 && is_pointer(param_ty) == false) {
                param_ty = borrow_of(p, param_ty)
            }
            if (is_value == 1 && is_pointer(param_ty) == false) {
                param_ty = borrow_of(p, param_ty)
            }
            arena_push(
                p.proc_params,
                GArg {
                    value = param_ty,
                    is_type = 0,
                    pending = -1,
                    node = -1,
                    const_off = 0,
                    const_len = 0
                }
            )
            param_count = param_count + 1
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        advance(p)
        mut ret: i64 = TY_VOID
        if (cur(p) == TokenKind::Arrow) {
            advance(p)
            ret = parse_type(p)
        }
        return proc_of(p, ret, param_start, param_count)
    }
    mut pointer_levels: i64 = 0
    while (cur(p) == TokenKind::Caret) {
        advance(p)
        pointer_levels = pointer_levels + 1
    }
    // `[]T` is a slice and `[N]T` is a fixed array, and both are read before
    // the pointer levels above them so `^[]T` means what it looks like.
    if (cur(p) == TokenKind::Lbracket) {
        advance(p)
        // A length is a compile-time value like a constant's, and a layout is
        // worked out later than either. Named here rather than left to the
        // size parser, which met the `]` with nothing read and said so about
        // the bracket instead of about the word before it.
        refuse_layout_answer(p)
        mut length: i64 = -1
        length_at := cur_off(p)
        if (cur(p) != TokenKind::Rbracket) {
            p.size_known = 1
            length = parse_size_expr(p)
            // A length that works out below zero, and was worked out at all: a
            // slice writes none, and a generic's own parse reads its value
            // parameter as no number yet, and both of those read as -1 here.
            if (p.size_known == 1 && length < 0) {
                report_where(p.modules, p.src, length_at)
                report(
                    "an array holds a number of elements that cannot be negative"
                )
                frost_rt_recover_escape()
            }
        }
        advance(p)
        element := parse_type(p)
        mut made := array_of(p, element, length)
        mut level: i64 = 0
        while (level < pointer_levels) {
            made = pointer_to(p, made)
            level = level + 1
        }
        return made
    }
    // A call where a type is read is a compile-time number: the argument of
    // `Slab<T, N>`, or the `$N` a generic takes at a call. Both reach here, so
    // working it out here is what makes one rule out of two positions.
    if (at_const_call(p)) {
        return CONST_BASE + const_size_here(p)
    }
    // A call this file cannot name has no number to stand for. Read on, the
    // name was taken for a type and each of its parentheses became a report
    // about a type nothing declares.
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Lparen) {
        report_where(p.modules, p.src, cur_off(p))
        report("'")
        report_src(p.src, cur_off(p), cur_len(p))
        report("' is not a function this program declares, so there is ")
        report("nothing to work out here")
        frost_rt_recover_escape()
    }
    mut dollar: i64 = 0
    if (cur(p) == TokenKind::Dollar) {
        advance(p)
        dollar = 1
    }
    offset := cur_off(p)
    length := cur_len(p)
    advance(p)
    if (dollar == 1 && p.type_param_len == 0) {
        p.type_param_off = offset
        p.type_param_len = length
        p.saw_type_param = 1
    }
    mut base: i64 = TY_I64
    mut was_generic: i64 = 0
    if (cur(p) == TokenKind::Lt) {
        // `Handle<T>` is a scalar, an i64 that names a slab slot. Its element
        // type comes from the slab it indexes, so the argument is consumed and
        // dropped. It is not a generic instance, so it is passed by value.
        if (str_range_eq(p.src, offset, length, "Handle")) {
            advance(p)
            parse_type(p)
            consume_generic_close(p)
            base = TY_HANDLE
        } else {
            was_generic = 1
            gi := generic_index_for(p, offset, length)
            advance(p)
            // Collect the argument run. An integer argument is a value generic
            // like the `8` in `Slab<Entity, 8>`, carried as CONST_BASE plus the
            // number. Anything else is a type. The first is the primary argument
            // and the rest go to the `gargs` run this instance owns.
            // Arguments are collected on the argbuf stack first, since parsing
            // one that is itself a generic pushes to `gargs`. Copying this
            // level's arguments out afterwards keeps its run there contiguous.
            buf_start := p.argbuf.count
            mut count: i64 = 0
            mut all_concrete: i64 = 1
            while (cur(p) != TokenKind::Gt && cur(p) != TokenKind::Shr
                && p.pending_gt == 0 && cur(p) != TokenKind::Eof) {
                refuse_layout_answer(p)
                mut a: i64 = TY_I64
                if (cur(p) == TokenKind::Int) {
                    a = CONST_BASE + cur_val(p)
                    advance(p)
                }
                // A name that is no type is the constant it names, carried as
                // FN_BASE plus its index the way a `$ops` argument at a call
                // is. That is how a capability travels in a container's type:
                // `Map<Mask, i64, mask_keys>` says which bundle every operation
                // over one reads off it.
                // A name with a call after it is a compile-time number rather
                // than a constant standing for one, so it goes to the type
                // reader, which works the call out. Taken as a constant here it
                // swallowed the name and left the parentheses to be read as
                // types of their own, which is how `Bag<next_pow2(5)>` came to
                // be refused for a bracket while the bootstrap answered 8.
                else if (cur(p) == TokenKind::Ident
                    && peek_kind(p, 1) != TokenKind::Lparen
                    && is_type_name(p, cur_off(p), cur_len(p)) == false) {
                    arg_off := cur_off(p)
                    arg_len := cur_len(p)
                    advance(p)
                    a = FN_BASE + intern_global(p, arg_off, arg_len)
                } else {
                    a = parse_type(p)
                }
                if (a == TY_PARAM) {
                    all_concrete = 0
                }
                arena_push(
                    p.argbuf,
                    GArg {
                        value = a,
                        is_type = 0,
                        pending = -1,
                        node = -1,
                        const_off = 0,
                        const_len = 0
                    }
                )
                count = count + 1
                if (cur(p) == TokenKind::Comma) {
                    advance(p)
                }
            }
            consume_generic_close(p)
            mut first_arg: i64 = TY_I64
            xarg_start := p.gargs.count
            mut xarg_count: i64 = 0
            if (count > 0) {
                first := arena_at(p.argbuf, buf_start)
                first_arg = first.value
                mut j: i64 = 1
                while (j < count) {
                    entry := arena_at(p.argbuf, buf_start + j)
                    arena_push(
                        p.gargs,
                        GArg {
                            value = entry.value,
                            is_type = 0,
                            pending = -1,
                            node = -1,
                            const_off = 0,
                            const_len = 0
                        }
                    )
                    j = j + 1
                }
                xarg_count = count - 1
            }
            p.argbuf.count = buf_start
            // What the declaration says the arguments left out stand for, so
            // `Vec<i64>` and `Vec<i64, Heap>` are one type rather than two
            // names for the same fields.
            if (gi >= 0 && count > 0) {
                template := arena_at(p.structs, gi)
                mut at := xarg_count
                while (at < template.xparam_count) {
                    fallback := arena_at(
                        p.gparams,
                        template.xparam_start + at
                    ).fallback
                    if (fallback < 0) {
                        at = template.xparam_count
                    } else {
                        arena_push(
                            p.gargs,
                            GArg {
                                value = fallback,
                                is_type = 0,
                                pending = -1,
                                node = -1,
                                const_off = 0,
                                const_len = 0
                            }
                        )
                        xarg_count = xarg_count + 1
                        at = at + 1
                    }
                }
            }
            if (gi >= 0 && count == 0) {
                template := arena_at(p.structs, gi)
                if (template.tparam_fallback >= 0) {
                    first_arg = template.tparam_fallback
                }
            }
            // Only instantiate once every argument is concrete. While parsing a
            // generic template an argument is the TY_PARAM placeholder, and that
            // instance is created later with the parameters bound to real ones.
            if (gi >= 0 && all_concrete == 1) {
                base = instantiate(p, gi, first_arg, xarg_start, xarg_count)
            }
        }
    } else {
        base = type_code_for(p, offset, length)
        if (base == TY_PARAM) {
            p.saw_type_param = 1
        }
    }
    // Record whether this type named a generic-struct instance, so parse_params
    // can tell a `Foo<T>` template placeholder (which collapses to a scalar code)
    // apart from a real scalar and still borrow it by pointer.
    p.last_type_was_generic = was_generic
    // And whether it was the template's own compile-time parameter, written
    // bare. What a parameter node records is whatever instantiation was made
    // last, so the move walk needs the written form back, and reading it off
    // the recorded type asks about the wrong thing. Assigned here because every
    // path converges here: a nested read for `Vec<T>`'s own argument would
    // otherwise be the last word. A `^T` names a pointer to the parameter
    // rather than the parameter, so the levels are part of the answer.
    // Asked of the sigil rather than of the code the name resolved to. A
    // declaration is read once as the template, where the name is the
    // placeholder, and again per instance with it bound to a real type, and the
    // move walk reads whichever node came last; the `$` is there both times.
    // Reading the name instead matched a compile-time list's own elements, and
    // the compiler stopped building itself.
    p.last_type_was_param = 0
    if (dollar == 1 && pointer_levels == 0 && was_generic == 0
        && names_a_compile_time_param(p, offset, length)) {
        p.last_type_was_param = 1
    }
    mut result := base
    mut k: i64 = 0
    while (k < pointer_levels) {
        result = pointer_to(p, result)
        k = k + 1
    }
    result
}

parse_type_annotation :: fn(mut p: Parser) -> i64 {
    advance(p)
    parse_type(p)
}

// Parse `{ field : Type, ... }` into a linked list of fields, returning the head.
// Field types resolve under any active type-parameter binding.
// `align(N)` after a field's type: the field starts at a multiple of N.
//
// A struct's own alignment is the widest its fields ask for, so this is also
// how a struct is given one, and there is no second form saying the same thing
// about the whole declaration. The word is not a keyword, so a field may still
// be called `align`; the `(` after it is what marks the form.
parse_field_alignment :: fn(mut p: Parser, packed: i64) -> i64 {
    if (cur(p) != TokenKind::Ident || peek_is_word(p, 0, "align") == false
        || peek_kind(p, 1) != TokenKind::Lparen) {
        return 0
    }
    advance(p)
    advance(p)
    if (cur(p) != TokenKind::Int) {
        report_where(p.modules, p.src, cur_off(p))
        report("`align` takes a number, which is what a field starts at a multiple of")
        frost_rt_recover_escape()
    }
    value := cur_val(p)
    at := cur_off(p)
    advance(p)
    if (value <= 0 || (value & (value - 1)) != 0) {
        report_where(p.modules, p.src, at)
        report_fmt(
            "`align` takes a power of two, and {} is not one; an address is a multiple of a power of two or of nothing",
            value
        )
        frost_rt_recover_escape()
    }
    // `packed` says no field is padded and `align` says this one is, so a
    // declaration writing both says two things that cannot both hold.
    if (packed == 1) {
        report_where(p.modules, p.src, at)
        report("a `packed struct` pads no field, and `align` asks for this one to be padded; drop one of the two")
        frost_rt_recover_escape()
    }
    if (cur(p) != TokenKind::Rparen) {
        report_where(p.modules, p.src, cur_off(p))
        report("Expected ')' after the alignment")
        frost_rt_recover_escape()
    }
    advance(p)
    value
}

// A field names a type parameter by its name. The `$` is what declares one, and
// the declaration stands in the parameter list, so a sigil here is a second
// spelling for a name already written. It was read as the parameter by one
// compiler and left the other unable to say which instance a literal was.
//
// The body is read here, with the cursor on its `{`, so a template is weighed
// where it is written rather than once per instance, which is the only place
// its fields are otherwise parsed. A variant's payload sits one brace deeper
// and reads the same way.
// The index of a `$` anywhere in the type a field is given, or -1. The whole of
// the type, not only what opens it: `f: fn($T) -> $T` carries the sigil twice
// inside a function type, and it is the same second spelling there as it is on
// a bare name.
field_sigil_at :: fn(mut p: Parser, start: i64) -> i64 {
    mut ahead: i64 = start
    mut depth: i64 = 0
    while (true) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Eof) {
            return -1
        }
        if (kind == TokenKind::Dollar) {
            return ahead
        }
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket
            || kind == TokenKind::Lt) {
            depth = depth + 1
        }
        if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket
            || kind == TokenKind::Gt) {
            depth = depth - 1
        }
        // `Vec<Vec<i64>>` closes two at once: the lexer reads `>>` as the shift
        // it also spells.
        if (kind == TokenKind::Shr) {
            depth = depth - 2
        }
        // The comma between two fields is optional, so what ends this field is
        // the start of the next one as much as it is a comma or the brace. A
        // type never holds a name followed by a colon: a function type writes
        // what it takes and not what those are called.
        if (depth <= 0 && ahead > start && kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Colon) {
            return -1
        }
        if (depth <= 0
            && (kind == TokenKind::Comma || kind == TokenKind::Rbrace)) {
            return -1
        }
        ahead = ahead + 1
    }
    -1
}

refuse_field_sigils :: fn(mut p: Parser) {
    mut ahead: i64 = 0
    mut depth: i64 = 0
    mut started: i64 = 0
    while (started == 0 || depth > 0) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Eof) {
            return
        }
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
            started = 1
        }
        if (kind == TokenKind::Rbrace) {
            depth = depth - 1
        }
        if (kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Colon) {
            at := field_sigil_at(p, ahead + 2)
            if (at >= 0) {
                report_where(p.modules, p.src, peek_off(p, at))
                report("a field names a type parameter by its name, and '$' is what declares one, so '")
                report_src(p.src, peek_off(p, ahead), peek_len(p, ahead))
                report("' is written without it")
                frost_rt_recover_escape()
            }
        }
        ahead = ahead + 1
    }
}

parse_struct_fields :: fn(mut p: Parser, packed: i64) -> i64 {
    advance(p)
    mut head: i64 = -1
    mut tail: i64 = -1
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        // `for name in fields(T) { Type }` writes one field per field of what T
        // is bound to, each keeping the name its own declaration gave it. This
        // runs where the instance is read, since only there is T a type with
        // fields to walk.
        if (cur(p) == TokenKind::KwFor) {
            parse_field_walk(p, packed, head, tail)
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
            continue
        }
        field_offset := cur_off(p)
        field_length := cur_len(p)
        advance(p)
        // Where the field's type begins, which is the token past the colon the
        // cursor stands on. A name inside a type that nothing declares is
        // reported at the type rather than at the word, so `[N]Nope` is named
        // where a reader would go looking for it.
        type_at := peek_off(p, 1)
        pending_mark := p.pending_type_names.count
        // Read with the naming check off, so a name inside the type is written
        // down rather than said where it was met. Each is then said at the
        // type, which is what a reader is pointed at for a field: `[N]Nope` is
        // named where the field's type starts.
        held_check := p.type_check_names
        p.type_check_names = 0
        field_ty := parse_type_annotation(p)
        p.type_check_names = held_check
        mut moved := pending_mark
        while (moved < p.pending_type_names.count) {
            mut held := arena_at(p.pending_type_names, moved)
            held.ty = type_at
            moved = moved + 1
        }
        if (held_check == 1) {
            recheck_pending_type_names(p, pending_mark)
        }
        field_align := parse_field_alignment(p, packed)
        field := arena_push(
            p.fields,
            StructField {
                name_off = field_offset,
                name_len = field_length,
                ty = field_ty,
                next = -1,
                variant = -1,
                align = field_align
            },
        )
        if (head == (-1)) {
            head = field
            tail = field
        } else {
            set_field_next(p, tail, field)
            tail = field
        }
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    refuse_repeated_field(p, head)
    head
}

// A field is reached by its name, so two under one name are two things a reader
// cannot tell apart and one of them is unreachable. A walk writes a field per
// field of what it walks, so two walks over one type write every name twice.
refuse_repeated_field :: fn(mut p: Parser, head: i64) {
    mut outer := head
    while (outer != (-1)) {
        one := arena_at(p.fields, outer)
        mut inner := one.next
        while (inner != (-1)) {
            two := arena_at(p.fields, inner)
            if (two.name_len == one.name_len
                && bytes_equal(
                    p.src,
                    two.name_off,
                    one.name_off,
                    one.name_len
                )) {
                if (already_said(p, p.stmt_at) == false) {
                    report_where(p.modules, p.src, p.stmt_at)
                    report("'")
                    report_src(p.src, two.name_off, two.name_len)
                    report("' is declared twice here, and a field is reached ")
                    report("by its name")
                }
                frost_rt_recover_escape()
            }
            inner = two.next
        }
        outer = one.next
    }
}

// Read a generic's body once where it is declared, for what its fields say
// about the names inside them. The body is skipped where it is written and read
// again per instance, so a generic nothing instantiates was read nowhere at
// all: a field naming a type this program does not declare, or a length
// calling something over the value parameter, went through every pass without a
// word. The fields are thrown away; each instance parses its own.
// `for name in fields(T) { Type }` inside a struct body. One field per field of
// what T is bound to, keeping the name that field's own declaration gave it and
// the type the body wrote with the loop's name standing for what it holds.
//
// A template read with nothing bound has no type to walk, so the body is read
// once for its length and nothing is written down. That parse is thrown away
// and done again per instance, where T is a real type.
parse_field_walk :: fn(
    mut p: Parser,
    packed: i64,
    mut head: i64,
    mut tail: i64
) {
    advance(p)
    if (cur(p) != TokenKind::Ident) {
        report_where(p.modules, p.src, cur_off(p))
        report("a `for` in a struct body names what it walks")
        frost_rt_recover_escape()
    }
    loop_off := cur_off(p)
    loop_len := cur_len(p)
    advance(p)
    if (cur(p) != TokenKind::KwIn) {
        report_where(p.modules, p.src, cur_off(p))
        report("a `for` in a struct body names what it walks and then what ")
        report("it walks over")
        frost_rt_recover_escape()
    }
    advance(p)
    if (str_range_eq(p.src, cur_off(p), cur_len(p), "fields") == false
        || peek_kind(p, 1) != TokenKind::Lparen) {
        report_where(p.modules, p.src, cur_off(p))
        report("a `for` in a struct body walks `fields(T)`, which is the one ")
        report("list a declaration has")
        frost_rt_recover_escape()
    }
    advance(p)
    advance(p)
    walked := parse_type(p)
    advance(p)
    if (cur(p) != TokenKind::Lbrace) {
        report_where(p.modules, p.src, cur_off(p))
        report("a `for` in a struct body writes one type in braces")
        frost_rt_recover_escape()
    }
    body_at := p.ti
    // A template read with nothing bound to its parameter has no type to walk.
    // Nothing is bound to the loop's name either, so a name inside the body is
    // not one anything can resolve yet: the body is read for its length and
    // said nothing about, and the instance is where it is read again with the
    // binding in hand.
    if (walked == TY_PARAM) {
        skip_walk_body(p, packed)
        return
    }
    // An enum is laid out as a tag beside the active variant's payload, so one
    // array per field of one would be one array per piece of the compiler's own
    // layout. A walk in a struct body walks a struct.
    mut walks_a_struct := is_struct_ty(walked)
    if (walks_a_struct) {
        def := arena_at(p.structs, struct_index_of(walked))
        walks_a_struct = def.is_enum == 0
    }
    if (walks_a_struct == false) {
        // Said once. The instance is read again where it is written again, and
        // the declaration is the same one each time, so a second reading is a
        // second copy of one thing wrong rather than a second thing.
        if (already_said(p, p.stmt_at) == false) {
            report_where(p.modules, p.src, p.stmt_at)
            report("a `for` in a struct body walks a struct's fields, and '")
            report_type_name(p, walked)
            report("' is not a struct")
        }
        frost_rt_recover_escape()
    }
    def := arena_at(p.structs, struct_index_of(walked))
    mut fid := def.field_head
    // A struct with no fields writes no field here, and the body still has to
    // be read: left where it was, its tokens are read again as fields of the
    // declaration the walk sits in.
    if (fid == (-1)) {
        skip_walk_body(p, packed)
        return
    }
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        field_name_off := field.name_off
        field_name_len := field.name_len
        field_ty := field.ty
        next_field := field.next
        mark := p.gbindings.count
        arena_push(
            p.gbindings,
            GBinding {
                name_off = loop_off,
                name_len = loop_len,
                bound = field_ty
            }
        )
        p.ti = body_at
        advance(p)
        column_ty := parse_type(p)
        column_align := parse_field_alignment(p, packed)
        advance(p)
        p.gbindings.count = mark
        made := arena_push(
            p.fields,
            StructField {
                name_off = field_name_off,
                name_len = field_name_len,
                ty = column_ty,
                next = -1,
                variant = -1,
                align = column_align
            },
        )
        if (head == (-1)) {
            head = made
            tail = made
        } else {
            set_field_next(p, tail, made)
            tail = made
        }
        fid = next_field
    }
}

// Past the one type a walk's body writes, saying nothing about the names in it.
// The cursor is on the `{`.
skip_walk_body :: fn(mut p: Parser, packed: i64) {
    held_check := p.type_check_names
    pending_mark := p.pending_type_names.count
    p.type_check_names = 0
    advance(p)
    parse_type(p)
    parse_field_alignment(p, packed)
    advance(p)
    p.type_check_names = held_check
    p.pending_type_names.count = pending_mark
}

read_template_fields :: fn(mut p: Parser, field_token: i64, packed: i64) {
    saved_ti := p.ti
    saved_fields := p.fields.count
    saved_known := p.size_known
    p.ti = field_token
    parse_struct_fields(p, packed)
    p.fields.count = saved_fields
    p.size_known = saved_known
    p.ti = saved_ti
}

// Get or create the concrete struct for a generic instantiation. The template's
// fields are re-parsed with the type parameter bound to `arg`, producing a new
// struct whose emitted name is `<generic>_<index>`.
// Record a generic parameter as it is declared. The first fills the primary
// slot the single-parameter path already uses, so a one-parameter generic is
// stored and mangled exactly as before. Any further one is pushed to the
// `gparams` run this declaration owns. The kind is not kept. A parameter is a
// type or a value by what binds to it.
// What kind a compile-time parameter was declared with, read off the word after
// the colon the cursor is sitting on. `$N: usize` takes a number, and it is the
// only kind that does. `$T: Type` takes a type, `$less: fn(T, T) -> bool` takes
// a function, and `$ops: Ordering<T>` takes a constant of that type. All three
// bind to a name rather than to a number, which is the distinction that decides
// what may be bound.
kind_is_value :: fn(mut p: Parser) -> i64 {
    if (peek_is_word(p, 1, "usize")) {
        return 1
    }
    0
}

// Whether a compile-time parameter is declared with a struct type, which is
// what a capability bundle is: `$ops: Ordering<T>`. Such a parameter binds to a
// name and never to a type or a number, so it is marked as one where it is
// declared. Waiting for the body to use it would miss a body that only passes
// it on to another generic, which never names it as anything.
kind_is_bundle :: fn(mut p: Parser) -> i64 {
    if (peek_kind(p, 1) != TokenKind::Ident) {
        return 0
    }
    if (peek_is_word(p, 1, "Type") || peek_is_word(p, 1, "usize")) {
        return 0
    }
    1
}

// Note a compile-time parameter as it is declared, answering whether it filled
// the primary slot. The default it carries is written after the kind, so it is
// read once the annotation has been, and put back through `note_fallback`.
record_gparam :: fn(
    mut p: Parser,
    off: i64,
    len: i64,
    is_value: i64,
    fallback: i64
) -> i64 {
    if (p.type_param_len == 0) {
        p.type_param_off = off
        p.type_param_len = len
        p.tparam_is_value = is_value
        p.tparam_fallback = fallback
        // Written as a parameter of its own, so the call writes it.
        p.tparam_is_slot = 1
        p.xparam_start = p.gparams.count
        p.xparam_count = 0
    } else {
        arena_push(
            p.gparams,
            GParam {
                name_off = off,
                name_len = len,
                is_value = is_value,
                is_fn = 0,
                ty = -1,
                fallback = fallback,
                owner_off = p.params_owner_off
            }
        )
        p.xparam_count = p.xparam_count + 1
        p.saw_type_param = 1
        return 0
    }
    p.saw_type_param = 1
    1
}

// What `= Heap` after a compile-time parameter's kind says it stands for where
// a call writes nothing for it, or -1 where the declaration wrote none.
parse_fallback :: fn(mut p: Parser) -> i64 {
    if (cur(p) != TokenKind::Assign) {
        return -1
    }
    advance(p)
    parse_compile_time(p)
}

// Put that default on the parameter just recorded, whichever slot it took.
note_fallback :: fn(mut p: Parser, primary: i64, fallback: i64) {
    if (fallback < 0) {
        return
    }
    if (primary == 1) {
        p.tparam_fallback = fallback
        return
    }
    arena_at(p.gparams, p.gparams.count - 1).fallback = fallback
}

// The type a compile-time parameter declares, where what follows the colon is a
// bundle rather than a kind, read with this call's arguments bound so
// `$growing: Resizing<A>` answers `Resizing<Arena>` and not the template. -1
// where the parameter declares no bundle.
//
// The declaration's own tokens are read again rather than a type kept at the
// declaration, because a bundle names the generic's other parameters and a type
// worked out where it was written stands for none of them yet.
declared_bundle_type :: fn(
    mut p: Parser,
    gfn_index: i64,
    name_off: i64,
    name_len: i64,
    arg: i64,
    xarg_start: i64
) -> i64 {
    gfn := arena_at(p.generic_fns, gfn_index)
    held_ti := p.ti
    p.ti = gfn.token_start
    while (cur(p) != TokenKind::Lparen && cur(p) != TokenKind::Eof) {
        advance(p)
    }
    mut depth: i64 = 0
    mut at: i64 = -1
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Rparen) {
            depth = depth - 1
            if (depth == 0) {
                break
            }
        }
        if (kind == TokenKind::Lparen) {
            depth = depth + 1
        }
        if (kind == TokenKind::Dollar
            && word_is_gparam(p, 1, name_off, name_len)
            && peek_kind(p, 2) == TokenKind::Colon) {
            advance(p)
            advance(p)
            if (kind_is_bundle(p) == 1) {
                at = p.ti + 1
            }
            break
        }
        advance(p)
    }
    if (at < 0) {
        p.ti = held_ti
        return -1
    }
    held_param_off := p.type_param_off
    held_param_len := p.type_param_len
    held_binding := p.type_binding
    held_active := p.binding_active
    // What reading a type leaves behind, kept because this reads one in the
    // middle of a call rather than where a declaration is being taken down.
    held_was_generic := p.last_type_was_generic
    held_was_param := p.last_type_was_param
    held_saw_param := p.saw_type_param
    p.type_param_off = gfn.tparam_off
    p.type_param_len = gfn.tparam_len
    p.type_binding = arg
    p.binding_active = 1
    mark := push_bindings(
        p,
        gfn.tparam_off,
        gfn.tparam_len,
        gfn.xparam_start,
        gfn.xparam_count,
        arg,
        xarg_start
    )
    p.ti = at
    declared := parse_type(p)
    p.gbindings.count = mark
    p.type_param_off = held_param_off
    p.type_param_len = held_param_len
    p.type_binding = held_binding
    p.binding_active = held_active
    p.last_type_was_generic = held_was_generic
    p.last_type_was_param = held_was_param
    p.saw_type_param = held_saw_param
    p.ti = held_ti
    declared
}

// Whether any compile-time argument this call wrote names a constant, which is
// what a bundle arrives as. Asked before the run of bound arguments is built,
// so a call carrying only types pays a walk of its own argument list and
// nothing else.
names_a_constant :: fn(mut p: Parser, args: i64) -> bool {
    mut index: i64 = 0
    while (true) {
        held := nth_type_arg(p, args, index)
        if (held < 0) {
            return false
        }
        if (is_fn_arg(held)) {
            return true
        }
        index = index + 1
    }
    false
}

// The type a bundle constant was declared with, read off the literal its name
// stands for. -1 for an argument that names no constant.
argument_bundle_type :: fn(mut p: Parser, value: i64) -> i64 {
    if (is_fn_arg(value) == false) {
        return -1
    }
    entry := arena_at(p.fns, value - FN_BASE)
    node := value_const_node(p, entry.off, entry.len)
    if (node < 0) {
        return -1
    }
    type_of(p, node)
}

// What a call gave for each compile-time parameter the declaration wrote a
// bundle type on, against that type. A bundle is what the body reaches its
// fields through, so a constant of another bundle answers the call's own line
// rather than a field the specialized body cannot find.
check_bundle_args :: fn(
    mut p: Parser,
    gfn_index: i64,
    name_off: i64,
    name_len: i64,
    arg: i64,
    xarg_start: i64,
    at: i64
) {
    gfn := arena_at(p.generic_fns, gfn_index)
    mut index: i64 = -1
    while (index < gfn.xparam_count) {
        mut param_off := gfn.tparam_off
        mut param_len := gfn.tparam_len
        mut given := arg
        if (index >= 0) {
            param := arena_at(p.gparams, gfn.xparam_start + index)
            param_off = param.name_off
            param_len = param.name_len
            given = arena_at(p.gargs, xarg_start + index).value
        }
        index = index + 1
        if (param_len == 0) {
            continue
        }
        actual := argument_bundle_type(p, given)
        if (actual < 0 || is_struct_ty(actual) == false) {
            continue
        }
        declared := declared_bundle_type(
            p,
            gfn_index,
            param_off,
            param_len,
            arg,
            xarg_start
        )
        if (declared < 0 || is_struct_ty(declared) == false
            || declared == actual) {
            continue
        }
        held := arena_at(p.fns, given - FN_BASE)
        report_where(p.modules, p.src, at)
        report("'")
        report_src(p.src, held.off, held.len)
        report("' given to '")
        report_src(p.src, name_off, name_len)
        report("' as '")
        report_src(p.src, param_off, param_len)
        report("' is a '")
        report(instance_text(p, actual))
        report("', but '")
        report_src(p.src, param_off, param_len)
        report("' is declared as '")
        report(instance_text(p, declared))
        report("'")
        frost_rt_recover_escape()
    }
}

// Bind every parameter of a generic while its body is re-parsed. The first
// parameter uses the existing primary binding so the single-parameter path is
// unchanged. The rest are pushed onto the `gbindings` stack from the argument
// run and popped by restoring the stack's height afterwards. Returns the height
// to restore to.
push_bindings :: fn(
    mut p: Parser,
    tparam_off: i64,
    tparam_len: i64,
    xparam_start: i64,
    xparam_count: i64,
    arg: i64,
    xarg_start: i64
) -> i64 {
    mark := p.gbindings.count
    mut i: i64 = 0
    while (i < xparam_count) {
        param := arena_at(p.gparams, xparam_start + i)
        garg := arena_at(p.gargs, xarg_start + i)
        arena_push(
            p.gbindings,
            GBinding {
                name_off = param.name_off,
                name_len = param.name_len,
                bound = garg.value
            }
        )
        i = i + 1
    }
    mark
}

instantiate :: fn(
    mut p: Parser,
    generic_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64
) -> i64 {
    mut i: i64 = 0
    while (i < p.instances.count) {
        entry := arena_at(p.instances, i)
        if (entry.generic_index == generic_index && entry.arg == arg
            && entry.xarg_count == xarg_count
            && gargs_equal(p, entry.xarg_start, xarg_start, xarg_count)) {
            return STRUCT_BASE + entry.struct_index
        }
        i = i + 1
    }
    template := arena_at(p.structs, generic_index)
    name_off := template.name_off
    name_len := template.name_len
    template_linear := template.is_linear
    template_packed := template.is_packed
    tparam_off := template.tparam_off
    tparam_len := template.tparam_len
    xparam_start := template.xparam_start
    xparam_count := template.xparam_count
    field_token := template.field_token
    is_enum := template.is_enum

    // As many arguments as the declaration binds. One short, the bindings are
    // read past their end and the compiler died on the arena rather than on the
    // program.
    if (xparam_count != xarg_count) {
        report_command("generic ")
        if (is_enum == 1) {
            report("enum '")
        } else {
            report("struct '")
        }
        report_src(p.src, name_off, name_len)
        report("' expects ")
        report_int(xparam_count + 1)
        report(" type argument(s) but ")
        report_int(xarg_count + 1)
        report(" were given")
        report("\n")
        frost_rt_die()
    }

    saved_ti := p.ti
    saved_param_off := p.type_param_off
    saved_param_len := p.type_param_len
    saved_binding := p.type_binding
    saved_active := p.binding_active
    p.type_param_off = tparam_off
    p.type_param_len = tparam_len
    p.type_binding = arg
    p.binding_active = 1
    mark := push_bindings(
        p,
        tparam_off,
        tparam_len,
        xparam_start,
        xparam_count,
        arg,
        xarg_start
    )
    p.ti = field_token
    // An enum's variants are recorded against the index this instance will take,
    // which is the current end of the table so long as the body creates no
    // nested instance of its own, the same limitation the non-generic enum path
    // has.
    mut field_head: i64 = -1
    if (is_enum == 1) {
        field_head = parse_enum_body(p, STRUCT_BASE + p.structs.count)
    } else {
        field_head = parse_struct_fields(p, template_packed)
    }
    p.gbindings.count = mark
    p.ti = saved_ti
    p.type_param_off = saved_param_off
    p.type_param_len = saved_param_len
    p.type_binding = saved_binding
    p.binding_active = saved_active

    struct_index := p.structs.count
    arena_push(
        p.structs,
        StructDef {
            name_off = name_off,
            name_len = name_len,
            field_head = field_head,
            is_generic = 0,
            tparam_off = 0,
            tparam_len = 0,
            field_token = 0,
            instance_id = struct_index,
            is_linear = holds_linear(p, field_head, template_linear),
            emitted = 0,
            xparam_start = 0,
            xparam_count = 0,
            tparam_fallback = -1,
            is_enum = 0,
            declared = 1,
            is_multi = 0,
            is_result = 0,
            is_packed = template_packed
        },
    )
    arena_push(
        p.instances,
        Instance {
            generic_index = generic_index,
            arg = arg,
            xarg_start = xarg_start,
            xarg_count = xarg_count,
            struct_index = struct_index,
            asked_at = p.stmt_at
        },
    )
    STRUCT_BASE + struct_index
}

// The enum a `match` reads, or -1 where the subject is not one. A bare `.Name`
// arm names a variant of that enum, so two enums sharing a variant name are
// told apart by what is being matched rather than by whichever was declared
// first.
subject_enum_of :: fn(mut p: Parser, scrutinee: i64) -> i64 {
    mut ty := type_of(p, scrutinee)
    if (is_pointer(ty)) {
        ty = pointee(p, ty)
    }
    if (is_struct_ty(ty) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(ty))
    if (def.is_enum != 1) {
        return -1
    }
    ty
}

// A value named under a type, written with the type left out. There is one
// spelling and the type is part of it, so this says what to write rather than
// filling it in. The type is named where the context gives one, which is what
// turns the report into the edit.
// `at` is the dot the value was written with, which is where the whole of what
// is wrong begins. `off` and `len` are the name after it, which the report
// spells back with the type in front.
refuse_dot_value :: fn(mut p: Parser, ty: i64, off: i64, len: i64, at: i64) {
    refuse_dot_value_at(p, ty, off, len, at, 0)
}

// The same refusal, noted rather than escaped with while the statement holding
// the dot is still being read. Unwinding from mid-expression leaves the cursor
// there, and a resync reads the rest of the line as a declaration, so one fault
// is reported as two. The node is built either way and the program is refused
// once the file has had its say. A walk that runs after the parse passes 0 and
// leaves through the escape.
refuse_dot_value_at :: fn(
    mut p: Parser,
    ty: i64,
    off: i64,
    len: i64,
    at: i64,
    parsing: i64
) {
    // One per declaration. The parse carries on past this so the statement is
    // read whole, and every dot after the first in the same declaration is a
    // consequence of the same mistake.
    if (parsing == 1) {
        if (p.dot_noted == 1) {
            frost_rt_recover_note()
            return
        }
        p.dot_noted = 1
    }
    report_where(p.modules, p.src, at)
    if (ty < 0) {
        report("a value named under a type is written with the type in front of it, and there is no type here to name")
        frost_rt_recover_escape()
    }
    report("a value named under a type is written with the type in front of it, so this one is written `")
    report_base_type_name(p, ty)
    report("::")
    report_src(p.src, off, len)
    report("`")
    if (parsing == 1) {
        frost_rt_recover_note()
        return
    }
    frost_rt_recover_escape()
}

// Whether a case pattern `offset` tokens along names a variant. The dot form
// is recognized so the arm is read and refused where it is written, rather
// than falling through to whatever a bare `.` parses as.
at_variant_case :: fn(mut p: Parser, offset: i64) -> bool {
    if (peek_kind(p, offset) == TokenKind::Dot) {
        return true
    }
    (peek_kind(p, offset) == TokenKind::Ident
        && peek_kind(p, offset + 1) == TokenKind::Coloncolon)
}

// Past whichever of the two a case pattern was written with, leaving the
// cursor on the variant name.
skip_variant_qualifier :: fn(mut p: Parser) {
    advance(p)
    if (cur(p) == TokenKind::Coloncolon) {
        advance(p)
    }
}

// The `.Name` or `.Name { fields }` of one case, up to but not past the `:` or
// the `|` after it. Answers with the variant's tag, leaves which entry of
// `p.variants` it named in `p.case_variant`, and the bindings its fields opened
// in `p.case_bindings`.
parse_variant_pattern :: fn(mut p: Parser, subject: i64, enum_ty: i64) -> i64 {
    variant_off := cur_off(p)
    variant_len := cur_len(p)
    advance(p)
    mut index := find_variant(p, enum_ty, variant_off, variant_len)
    // A subject whose type is not yet known leaves the name to say which enum,
    // which is what every match had before a type could be asked for.
    if (index < 0 && enum_ty != (-1)) {
        index = find_variant(p, -1, variant_off, variant_len)
    }
    p.case_variant = index
    mut tag: i64 = 0
    if (index < 0) {
        // While parsing a generic template the enum instance a variant belongs
        // to does not exist yet. This parse is thrown away and re-done per
        // instance, where the variant resolves, so a placeholder tag stands in.
        if (p.saw_type_param == 1 && p.binding_active == 0) {
            tag = 0
        } else {
            report_where(p.modules, p.src, variant_off)
            report("no enum has a variant '")
            report_src(p.src, variant_off, variant_len)
            report("'")
            frost_rt_recover_escape()
        }
    } else {
        entry := arena_at(p.variants, index)
        tag = entry.tag
    }
    mut bindings: i64 = -1
    mut tail: i64 = -1
    if (cur(p) == TokenKind::Lbrace) {
        advance(p)
        while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
            field_off := cur_off(p)
            field_len := cur_len(p)
            advance(p)
            qualified := synth_join(
                p,
                variant_off,
                variant_len,
                field_off,
                field_len
            )
            // A field the variant does not carry. Left to the field read, it
            // came back as `struct 'Kind' has no field 'Monster_power'`, about
            // a name the compiler joined, at a place inside the run of names it
            // joined them in. The variant and the field are two words here and
            // the reader wrote both.
            if (index >= 0) {
                holder := arena_at(p.variants, index).enum_ty
                if (is_struct_ty(holder)) {
                    qlen := variant_len + field_len + 1
                    def := arena_at(p.structs, struct_index_of(holder))
                    mut fid := def.field_head
                    mut seen: i64 = 0
                    while (fid != (-1)) {
                        held := arena_at(p.fields, fid)
                        if (held.name_len == qlen
                            && bytes_equal(
                                p.src,
                                held.name_off,
                                qualified,
                                qlen
                            )) {
                            seen = 1
                        }
                        fid = held.next
                    }
                    if (seen == 0) {
                        report_where(p.modules, p.src, field_off)
                        report("variant '")
                        report_src(p.src, variant_off, variant_len)
                        report("' has no field '")
                        report_src(p.src, field_off, field_len)
                        report("'")
                        frost_rt_recover_note()
                    }
                }
            }
            read := new_field_node(
                p,
                subject,
                qualified,
                variant_len + field_len + 1
            )
            bind := new_let_node(p, read, field_off, field_len, -1)
            if (bindings == (-1)) {
                bindings = bind
            } else {
                set_next(p, tail, bind)
            }
            tail = bind
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        advance(p)
    }
    p.case_bindings = bindings
    tag
}

// Whether what the cursor is on opens a whole number: one written out, one
// under a minus, or a name a `::` declaration settled on one. A name in a case
// is the value it stands for, here and in a span alike, so `case CH_0:` and
// `case CH_0..=CH_9:` read the one name the one way.
at_case_number :: fn(mut p: Parser) -> bool {
    k := cur(p)
    if (k == TokenKind::Int) {
        return true
    }
    if (k == TokenKind::Minus) {
        return peek_kind(p, 1) == TokenKind::Int
    }
    // A decimal is read here so that the span it opens is what reports it,
    // rather than the arm falling through to whatever comes next.
    if (k == TokenKind::Float) {
        return true
    }
    if (k == TokenKind::Ident) {
        return is_const(p, cur_off(p), cur_len(p))
    }
    false
}

// The two booleans, which cover two values between them and so are patterns a
// reader can count, the way whole numbers and variants are.
at_case_boolean :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    (peek_is_word(p, 0, "true") || peek_is_word(p, 0, "false"))
}

// One end of a span.
parse_case_bound :: fn(mut p: Parser) -> i64 {
    mut sign: i64 = 1
    if (cur(p) == TokenKind::Minus) {
        sign = -1
        advance(p)
    }
    if (cur(p) == TokenKind::Int) {
        held := cur_val(p)
        advance(p)
        return sign * held
    }
    if (cur(p) == TokenKind::Ident && is_const(p, cur_off(p), cur_len(p))) {
        held := const_value(p, cur_off(p), cur_len(p))
        advance(p)
        return sign * held
    }
    report_where(p.modules, p.src, cur_off(p))
    // A decimal says the same thing wherever it stands in a case: at the head
    // of a span, at its end, or on its own. One fault, one wording.
    if (cur(p) == TokenKind::Float) {
        report("a case matches whole numbers, booleans and variants, so a decimal belongs in an `if`")
    } else {
        report("a case range runs between whole numbers, and this bound is not one")
    }
    frost_rt_recover_escape()
    0
}

// The number or span one alternative of a `case` covers, as a CaseAlt node.
parse_case_number :: fn(mut p: Parser) -> i64 {
    at := cur_off(p)
    low := parse_case_bound(p)
    if (cur(p) != TokenKind::Dotdot && cur(p) != TokenKind::Dotdoteq) {
        return new_case_alt(p, low, low, ALT_VALUE, ALT_NUMBER)
    }
    mut form := ALT_HALF_OPEN
    if (cur(p) == TokenKind::Dotdoteq) {
        form = ALT_INCLUSIVE
    }
    advance(p)
    high := parse_case_bound(p)
    mut holds := low < high
    if (form == ALT_INCLUSIVE) {
        holds = low <= high
    }
    if (holds == false) {
        report_where(p.modules, p.src, at)
        report_fmt("the case range {}", low)
        if (form == ALT_INCLUSIVE) {
            report("..=")
        } else {
            report("..")
        }
        report_fmt("{} covers nothing", high)
        frost_rt_recover_escape()
    }
    new_case_alt(p, low, high, form, ALT_NUMBER)
}

// Which of the three an alternative is: a number, a variant that resolved, or
// a variant that did not. Two alternatives are compared only where both are
// the same one of the first two, since a number and a variant are never one
// thing however their spans line up, and a variant that did not resolve stands
// for whatever the instance settles it to.
alt_family :: fn(mut p: Parser, alt: i64) -> i64 {
    node := arena_at(p.arena, alt)
    if (node.a == ALT_NUMBER) {
        return 0
    }
    if (node.a == ALT_UNRESOLVED) {
        return -1
    }
    1
}

// Whether two alternatives of one case name the same thing.
alts_are_one :: fn(mut p: Parser, left: i64, right: i64) -> bool {
    family := alt_family(p, left)
    if (family < 0 || family != alt_family(p, right)) {
        return false
    }
    a := arena_at(p.arena, left)
    a_low := a.val
    a_high := a.b
    a_form := a.c
    b := arena_at(p.arena, right)
    a_low == b.val && a_high == b.b && a_form == b.c
}

// How far right the arms above reach from `at`, staying inside `family`. The
// first answer says whether any of them stands on that number at all, since
// there is no number below the smallest to stand for "none of them did".
alt_reach_from :: fn(
    mut p: Parser,
    head: i64,
    family: i64,
    at: i64
) -> (found: bool, reach: i64) {
    mut found: bool = false
    mut best: i64 = 0
    mut cid := head
    while (cid != (-1)) {
        cnode := arena_at(p.arena, cid)
        mut earlier := cnode.b
        cid = cnode.next
        while (earlier != (-1)) {
            if (alt_family(p, earlier) == family) {
                low := alt_low(p, earlier)
                high := alt_high(p, earlier)
                if (low <= at && at <= high) {
                    if (found == false || high > best) {
                        best = high
                        found = true
                    }
                }
            }
            earlier = node_next(p, earlier)
        }
    }
    return found, best
}

// Whether the arms above hold every value one alternative covers.
//
// Walked rather than merged: stand at the lowest number wanted, jump to the far
// end of the widest span covering it, and repeat. A step that finds no span
// standing on its number is a number nobody covered, and every step that does
// find one moves strictly right, so this ends.
alt_is_covered :: fn(mut p: Parser, head: i64, held: i64) -> bool {
    family := alt_family(p, held)
    if (family < 0) {
        return false
    }
    high := alt_high(p, held)
    mut at := alt_low(p, held)
    mut settled: bool = false
    while (settled == false) {
        found, reach := alt_reach_from(p, head, family, at)
        if (found == false) {
            return false
        }
        // Tested before the step, since the largest number has nothing above
        // it and stepping past it would leave the range.
        if (reach >= high) {
            settled = true
        } else {
            at = reach + 1
        }
    }
    true
}

// Whether every value an arm covers is already taken by an arm above it. What
// an arm covers is the union of what its alternatives name, and it is read
// against the union of every arm above, which is the question a reader asks
// looking down the arms.
case_is_shadowed :: fn(mut p: Parser, head: i64, alts: i64) -> bool {
    mut held := alts
    while (held != (-1)) {
        if (alt_is_covered(p, head, held) == false) {
            return false
        }
        held = node_next(p, held)
    }
    alts != (-1)
}

// Turn each arm's trailing expression into an assignment to the name standing
// for the match's value. An arm that already does something else is left as it
// is, since it was not producing a value in the first place.
// A branch's last statement, when it produces a value, becomes an assignment to
// the name the whole construct stands for. This is what makes a branch an
// expression. Nothing about the branch itself changes, only where its answer
// goes. A branch ending in something with no value was never producing one and
// is left as it is.
// The type the branches answer with, written onto the binding they assign into.
// That binding is declared before a single branch has been read, so it is
// seeded with a zero and takes the type of one. A branch answering with a
// struct, an array or a float is a different width from that zero, so the
// seed goes and the type comes from here: the binding is storage the branches
// fill in, and it carries the type they fill it with.
bind_answer_type :: fn(mut p: Parser, bind: i64, answered: i64) {
    if (answered == (-1)) {
        return
    }
    mut node := arena_at(p.arena, bind)
    node.b = answered
    node.a = -1
}

// Answers with the type the branch hands back, or -1 where it hands back
// nothing. The name being written into is declared before any branch is parsed,
// so this is the only place its type can come from.
assign_block_value :: fn(
    mut p: Parser,
    head: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    if (head == (-1)) {
        return -1
    }
    mut last := head
    mut following := node_next(p, last)
    while (following != (-1)) {
        last = following
        following = node_next(p, last)
    }
    body := arena_at(p.arena, last)
    if (body.kind == NodeKind::ExprStmt && type_of(p, body.a) != TY_VOID) {
        answered := type_of(p, body.a)
        place := new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            name_off
        )
        body.kind = NodeKind::Assign
        body.b = body.a
        body.a = place
        return answered
    }
    -1
}

// A block's trailing expression, made into the answer it already was.
// Answers with the block's head, which is not the one it was given when a
// deferred statement was put in front of the return.
return_block_tail :: fn(mut p: Parser, head: i64) -> i64 {
    if (head == (-1)) {
        return head
    }
    mut previous: i64 = -1
    mut last := head
    mut following := node_next(p, last)
    while (following != (-1)) {
        previous = last
        last = following
        following = node_next(p, last)
    }
    body := arena_at(p.arena, last)
    kind := body.kind
    value := body.a
    at := body.pos
    if (kind != NodeKind::ExprStmt || type_of(p, value) == TY_VOID) {
        return head
    }
    // Through the road a written `return` takes, so a branch that answers runs
    // what the function deferred the way every other exit does.
    made := defer_before_return(p, value, at, 0)
    if (previous == (-1)) {
        return made
    }
    set_next(p, previous, made)
    head
}

// Whether this block ends in a `return`, which is what says a branch answers
// rather than falling out of the `if` it sits in.
block_returns :: fn(mut p: Parser, head: i64) -> bool {
    if (head == (-1)) {
        return false
    }
    mut last := head
    mut following := node_next(p, last)
    while (following != (-1)) {
        last = following
        following = node_next(p, last)
    }
    arena_at(p.arena, last).kind == NodeKind::Return
}

// A body ending in an `if` answers with whichever branch ran, so each branch's
// trailing expression becomes a return. A branch producing nothing is left
// alone, and a missing else falls through to the plain answer below.
return_trailing_branches :: fn(mut p: Parser, body: i64, ret: i64) {
    // A function that answers nothing has no answer for a branch to carry. Its
    // trailing `if` is a statement, and what each branch ends with is a
    // statement too, so turning one into a `return` said the function was
    // handing back a value it has nowhere to put.
    if (body == (-1) || ret == TY_VOID) {
        return
    }
    mut last := body
    mut following := node_next(p, last)
    while (following != (-1)) {
        last = following
        following = node_next(p, last)
    }
    node := arena_at(p.arena, last)
    if (node.kind != NodeKind::If) {
        return
    }
    then_head := node.b
    else_head := node.val
    // Both branches are rewritten before either is stored back, since pushing to
    // the arena can move it and a borrow taken first would be writing to where
    // it was.
    made_then := return_block_tail(p, then_head)
    made_else := return_block_tail(p, else_head)
    mut held := arena_at(p.arena, last)
    held.b = made_then
    held.val = made_else
}

// A match used where a value is wanted, whichever shape it took. A match on
// one value is a NodeKind::Match with a case per arm. A match on several is the
// chain of `if`s the tuple patterns stand for, so the arms are its branches.
assign_match_values :: fn(
    mut p: Parser,
    chosen: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    node := arena_at(p.arena, chosen)
    kind := node.kind
    if (kind == NodeKind::Match) {
        return assign_case_values(p, chosen, name_off, name_len)
    }
    assign_chain_values(p, chosen, name_off, name_len)
}

// The last statement of every branch of an `if` chain, made into the answer it
// already was. The chain's else is either another `if` or a block, so this is
// the branching counterpart of assign_block_value.
assign_chain_values :: fn(
    mut p: Parser,
    head: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    if (head == (-1)) {
        return -1
    }
    mut last := head
    mut following := node_next(p, last)
    while (following != (-1)) {
        last = following
        following = node_next(p, last)
    }
    node := arena_at(p.arena, last)
    if (node.kind == NodeKind::If) {
        then_head := node.b
        else_head := node.val
        answered := assign_chain_values(p, then_head, name_off, name_len)
        second := assign_chain_values(p, else_head, name_off, name_len)
        if (answered != (-1)) {
            return answered
        }
        return second
    }
    assign_block_value(p, last, name_off, name_len)
}

assign_case_values :: fn(
    mut p: Parser,
    match_node: i64,
    name_off: i64,
    name_len: i64
) -> i64 {
    node := arena_at(p.arena, match_node)
    mut answered: i64 = -1
    mut cid := node.b
    while (cid != (-1)) {
        case_node := arena_at(p.arena, cid)
        mut last := case_node.a
        // An arm with nothing in it has no last statement to give a value, so
        // there is nothing here to rewrite. Reading one anyway is what indexed
        // the node arena at -1, which a `match` written as a statement with one
        // side doing nothing is the ordinary way to reach.
        if (last == (-1)) {
            cid = case_node.next
            continue
        }
        mut following := node_next(p, last)
        while (following != (-1)) {
            last = following
            following = node_next(p, last)
        }
        body := arena_at(p.arena, last)
        // An arm that ends in something with no value, a call to a void
        // function say, was never producing one, so it is left as it is.
        if (body.kind == NodeKind::ExprStmt && type_of(p, body.a) != TY_VOID) {
            if (answered == (-1)) {
                answered = type_of(p, body.a)
            }
            place := new_named_node_at(
                p,
                NodeKind::Var,
                0,
                name_off,
                name_len,
                name_off
            )
            body.kind = NodeKind::Assign
            body.b = body.a
            body.a = place
        }
        cid = case_node.next
    }
    answered
}

// Whether what follows `match` is several values rather than one: a `(` with a
// comma at its own depth before the `)` that closes it.
match_is_tuple :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Lparen) {
        return false
    }
    mut offset: i64 = 1
    mut depth: i64 = 0
    while (peek_kind(p, offset) != TokenKind::Eof) {
        k := peek_kind(p, offset)
        if (k == TokenKind::Lparen) {
            depth = depth + 1
        }
        if (k == TokenKind::Rparen) {
            if (depth == 0) {
                return false
            }
            depth = depth - 1
        }
        if (k == TokenKind::Comma && depth == 0) {
            return true
        }
        offset = offset + 1
    }
    false
}

set_if_else :: fn(mut p: Parser, node_id: i64, else_head: i64) {
    node := arena_at(p.arena, node_id)
    node.val = else_head
}

// `match (a, b) { case (0, 0): ... }` compares several values at once. It is
// written out as the chain of comparisons it stands for: each value is bound
// once ahead of the chain, and an arm's test is the `and` of the elements its
// pattern names, with `_` naming none. An arm whose pattern is all wildcards,
// or a bare `case _`, ends the chain as its final else.
//
// No node kind and no backend learns anything new, the same as `for`. The
// cursor is on the `(`.
parse_tuple_match :: fn(mut p: Parser) -> i64 {
    advance(p)
    unique := p.arena.count
    mut count: i64 = 0
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        value := parse_expr(p)
        name_off := synth_numbered(p, "__tup", unique + count)
        name_len := 5 + digits_in(unique + count)
        bind := new_let_node(p, value, name_off, name_len, -1)
        arena_push(
            p.pending,
            LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
        )
        count = count + 1
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    advance(p)

    mut head: i64 = -1
    mut tail: i64 = -1
    mut closed: i64 = 0
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        advance(p)
        // Where this arm's pattern begins, for the same reason.
        case_at := cur_off(p)
        mut condition: i64 = -1
        if (cur(p) == TokenKind::Lparen) {
            advance(p)
            mut index: i64 = 0
            // Where the part being read began. What makes a part a range or an
            // alternative is read after its first value, so the cursor at that
            // point is on the `..` or the `|` and the part itself is behind it.
            mut part_at := cur_off(p)
            while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
                if (cur(p) == TokenKind::Pipe || cur(p) == TokenKind::Dotdot
                    || cur(p) == TokenKind::Dotdoteq) {
                    report_where(p.modules, p.src, part_at)
                    report("a tuple case compares one value per part, so an alternative or a range belongs in a match on one value")
                    frost_rt_recover_escape()
                }
                if (at_case_number(p) || at_case_boolean(p)) {
                    mut wanted: i64 = 0
                    if (at_case_boolean(p)) {
                        if (peek_is_word(p, 0, "true")) {
                            wanted = 1
                        }
                        advance(p)
                    } else {
                        wanted = parse_case_bound(p)
                    }
                    name_off := synth_numbered(p, "__tup", unique + index)
                    name_len := 5 + digits_in(unique + index)
                    held := new_named_node(
                        p,
                        NodeKind::Var,
                        0,
                        name_off,
                        name_len
                    )
                    literal := new_node(p, NodeKind::Num, 0, 0, wanted)
                    equals := new_node(p, NodeKind::Bin, held, literal, OP_EQ)
                    if (condition == (-1)) {
                        condition = equals
                    } else {
                        condition = new_node(
                            p,
                            NodeKind::Bin,
                            condition,
                            equals,
                            OP_AND
                        )
                    }
                } else if (cur(p) == TokenKind::Underscore) {
                    advance(p)
                } else {
                    // A part naming nothing the compiler can compare against
                    // used to be passed over, so `case (0, n):` compared the
                    // first part and let the second stand for everything while
                    // reading as though it named something.
                    report_where(p.modules, p.src, cur_off(p))
                    report("a name in a case is the value it stands for, and this one names no constant; `_` is the case that covers the rest")
                    frost_rt_recover_escape()
                }
                index = index + 1
                if (cur(p) == TokenKind::Comma) {
                    advance(p)
                    part_at = cur_off(p)
                }
            }
            advance(p)
        } else {
            advance(p)
        }
        advance(p)
        body := parse_arm(p)
        if (closed == 1) {
            report_where(p.modules, p.src, case_at)
            report("this case is covered by an earlier one, so nothing reaches it")
            // The arm is well formed; what is refused is that it can be
            // reached. Escaping here would abandon a parse that is in good
            // order and leave the resync looking for a statement at the brace
            // closing the match, so the reader was told twice and once wrongly.
            frost_rt_recover_note()
            // Nothing reaches it, so nothing is built for it. The arm that
            // closed the chain is its else and set no tail to thread onto, so
            // threading this one on read the arena at -1.
            continue
        }
        if (condition == (-1)) {
            // Matches whatever is left, so it is the chain's else and the last
            // arm that can run.
            if (head == (-1)) {
                head = body
            } else {
                set_if_else(p, tail, body)
            }
            closed = 1
        } else {
            branch := new_node(p, NodeKind::If, condition, body, -1)
            if (head == (-1)) {
                head = branch
            } else {
                set_if_else(p, tail, branch)
            }
            tail = branch
        }
    }
    advance(p)
    head
}

parse_match :: fn(mut p: Parser) -> i64 {
    // Where the `match` itself is, which is what a report about the match as a
    // whole is placed at. A match covering less than its type does is about the
    // match rather than about any one of its cases.
    match_at := cur_off(p)
    advance(p)
    if (match_is_tuple(p)) {
        return parse_tuple_match(p)
    }
    p.no_struct_lit = true
    mut scrutinee := parse_expr(p)
    p.no_struct_lit = false
    advance(p)
    // A variant pattern matches on which variant the value holds, so the thing
    // switched on is the tag rather than the value itself. The value is bound
    // first, since the arms read fields out of it too.
    mut subject: i64 = -1
    mut subject_enum: i64 = -1
    if (at_variant_case(p, 1)) {
        subject_enum = subject_enum_of(p, scrutinee)
        name_off := synth_numbered(p, "__match", p.match_count)
        name_len := 7 + digits_in(p.match_count)
        p.match_count = p.match_count + 1
        bind := new_let_node(p, scrutinee, name_off, name_len, -1)
        arena_push(
            p.pending,
            LocalVar { name_off = bind, name_len = bind, ty = 0, slot = 0 }
        )
        subject = new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            name_off
        )
        scrutinee = new_field_node(p, subject, p.name_tag, 3)
    }
    mut head: i64 = -1
    mut tail: i64 = -1
    // What the arms covered, for the exhaustiveness check below. `covered` is a
    // bit per tag, `checkable` goes to zero when a variant did not resolve (an
    // uninstantiated generic template) or the enum has more variants than bits.
    mut match_enum: i64 = -1
    mut covered: i64 = 0
    mut checkable: i64 = 1
    mut saw_default: i64 = 0
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        advance(p)
        // Where this arm's pattern begins, read before it is parsed. A report
        // about the arm belongs at what the reader wrote, and the cursor by
        // then is on the colon after it.
        case_at := cur_off(p)
        mut is_default: i64 = 0
        mut value: i64 = 0
        mut case_node: i64 = -1
        mut alts: i64 = -1
        mut bindings: i64 = -1
        mut written: i64 = 0
        mut reading: bool = true
        // An arm names one pattern or several joined by `|`, and the body runs
        // for any of them. What the arm covers is their union, which is what
        // keeps the rule about covering every variant a matter of counting.
        while (reading) {
            reading = false
            mut alt: i64 = -1
            if (at_variant_case(p, 0)) {
                dotted := cur(p) == TokenKind::Dot
                dot_off := cur_off(p)
                skip_variant_qualifier(p)
                // The enum an earlier arm settled on, so arms after the
                // first are read within it and a name two enums share is
                // the one this match is over.
                mut within := subject_enum
                if (within == (-1)) {
                    within = match_enum
                }
                if (dotted) {
                    // The enum a first arm is read against is not known from
                    // the subject here, which is why the variant is looked up
                    // by name at all. The one it names is what the report
                    // calls the type, so the reader is told what to write.
                    mut named := within
                    if (named < 0) {
                        held := find_variant(
                            p,
                            -1,
                            cur_off(p),
                            cur_len(p)
                        )
                        if (held >= 0) {
                            named = arena_at(p.variants, held).enum_ty
                        }
                    }
                    // Past the arms before reporting, for the reason the
                    // refusal below does it: the cursor sits among patterns,
                    // and a resync from there reads the rest of the match as
                    // statements and turns one refusal into four.
                    off := cur_off(p)
                    len := cur_len(p)
                    skip_past_match(p)
                    refuse_dot_value(p, named, off, len, dot_off)
                }
                tag := parse_variant_pattern(p, subject, within)
                index := p.case_variant
                if (index < 0) {
                    checkable = 0
                } else {
                    entry := arena_at(p.variants, index)
                    match_enum = entry.enum_ty
                    if (entry.tag >= 0 && entry.tag < 63) {
                        covered = covered | (1 << entry.tag)
                    } else {
                        checkable = 0
                    }
                }
                if (p.case_bindings != (-1)) {
                    if (written > 0 || cur(p) == TokenKind::Pipe) {
                        report_where(p.modules, p.src, cur_off(p))
                        report("an alternative binding payload fields holds one name to two shapes, so give it a case of its own")
                        // Past the arms to the brace that closes the match. The
                        // cursor sits among patterns, so a resync from here
                        // looks for a statement and finds `_` before a colon,
                        // which reads as a binding, and one refusal turns into
                        // four about lines with nothing wrong.
                        skip_past_match(p)
                        frost_rt_recover_escape()
                    }
                    bindings = p.case_bindings
                }
                value = tag
                mut entry_of := index
                if (entry_of < 0) {
                    entry_of = ALT_UNRESOLVED
                }
                alt = new_case_alt(p, tag, tag, ALT_VALUE, entry_of)
            } else if (at_case_boolean(p)) {
                // A boolean is stored as the number it is, so an arm over one
                // compares the way an arm over any other whole number does.
                mut held: i64 = 0
                if (peek_is_word(p, 0, "true")) {
                    held = 1
                }
                advance(p)
                alt = new_case_alt(p, held, held, ALT_VALUE, ALT_NUMBER)
                value = held
            } else if (at_case_number(p)) {
                alt = parse_case_number(p)
                value = alt_low(p, alt)
            } else if (cur(p) == TokenKind::Underscore) {
                is_default = 1
                advance(p)
            } else if (cur(p) == TokenKind::Str) {
                // A text token is recorded where its bytes start, which is past
                // the quote that opened it. What the reader wrote is the quote.
                report_where(p.modules, p.src, cur_off(p) - 1)
                report("a case matches whole numbers, booleans and variants, so text belongs in an `if`")
                frost_rt_recover_escape()
            } else {
                // A name that names no constant, and anything else that is not
                // a pattern. This used to be read as the arm that covers the
                // rest, which made `case n:` and `case "text":` arms that ran
                // for everything and said they ran for one thing.
                report_where(p.modules, p.src, cur_off(p))
                report("a name in a case is the value it stands for, and this one names no constant; `_` is the case that covers the rest")
                frost_rt_recover_escape()
            }
            if (alt != (-1)) {
                mut seen := alts
                while (seen != (-1)) {
                    if (alts_are_one(p, alt, seen)) {
                        report_where(p.modules, p.src, cur_off(p))
                        report("this alternative repeats one the same case already names")
                        frost_rt_recover_escape()
                    }
                    seen = node_next(p, seen)
                }
                alts = append_node(p, alts, alt)
            }
            written = written + 1
            if (cur(p) == TokenKind::Pipe) {
                advance(p)
                reading = true
            }
        }
        if (is_default == 1 && written > 1) {
            report_where(p.modules, p.src, cur_off(p))
            report("this alternative covers everything on its own, so give it a case of its own")
            frost_rt_recover_escape()
        }
        // `_` covers everything, so an arm below one is refused by the rule
        // about coverage rather than by a rule of its own.
        if (saw_default == 1 || case_is_shadowed(p, head, alts)) {
            report_where(p.modules, p.src, case_at)
            report("this case is covered by an earlier one, so nothing reaches it")
            // The arm is well formed; what is refused is that it can be
            // reached. Escaping here would abandon a parse that is in good
            // order and leave the resync looking for a statement at the brace
            // closing the match, so the reader was told twice and once wrongly.
            frost_rt_recover_note()
        }
        advance(p)
        body := parse_arm(p)
        case_node = new_case(
            p,
            append_node(p, bindings, body),
            value,
            is_default,
            alts
        )
        if (is_default == 1) {
            saw_default = 1
        }
        if (head == (-1)) {
            head = case_node
            tail = case_node
        } else {
            set_next(p, tail, case_node)
            tail = case_node
        }
    }
    if (saw_default == 0 && checkable == 1 && match_enum != (-1)) {
        check_match_covers(p, match_enum, covered, match_at)
    }
    advance(p)
    new_node(p, NodeKind::Match, scrutinee, head, 0)
}

// Every variant of the matched enum has to be covered, or a `case _` has to say
// what the rest do. Without this a missing variant falls through to whatever
// the match was going to answer with anyway, so adding a variant to an enum
// silently changes the meaning of every match on it rather than pointing at the
// places that now have a case to write.
check_match_covers :: fn(
    mut p: Parser,
    enum_ty: i64,
    covered: i64,
    match_at: i64
) {
    mut i: i64 = 0
    mut missing: i64 = 0
    while (i < p.variants.count) {
        entry := arena_at(p.variants, i)
        if (entry.enum_ty == enum_ty && entry.tag >= 0 && entry.tag < 63) {
            if ((covered & (1 << entry.tag)) == 0) {
                if (missing == 0) {
                    report_where(p.modules, p.src, match_at)
                    report_fmt(
                        "match on '{}' does not cover '.",
                        type_text(p, enum_ty)
                    )
                    report_src(p.src, entry.name_off, entry.name_len)
                    report("'")
                } else {
                    report(", '.")
                    report_src(p.src, entry.name_off, entry.name_len)
                    report("'")
                }
                missing = missing + 1
            }
        }
        i = i + 1
    }
    if (missing > 0) {
        report("; add the case or a `case _` for the rest")
        // The match is well formed; what is refused is what it leaves out. The
        // cursor sits on the brace that closes it, so escaping here hands the
        // resync a closing brace it reads as the block's own, the function ends
        // on it and the line after reads as a declaration.
        frost_rt_recover_note()
    }
}

// Whether an `unsafe` at statement position is a value used in a larger
// expression rather than a block of statements. It looks past the block's
// matching brace to the next token: a binary operator, `.`, `[`, `?` or `::`
// there continues an expression, so the block is a value.
unsafe_block_is_value :: fn(mut p: Parser) -> bool {
    mut offset: i64 = 1
    mut depth: i64 = 0
    mut started: i64 = 0
    while (peek_kind(p, offset) != TokenKind::Eof) {
        k := peek_kind(p, offset)
        if (k == TokenKind::Lbrace) {
            depth = depth + 1
            started = 1
        }
        if (k == TokenKind::Rbrace) {
            depth = depth - 1
            if (started == 1 && depth == 0) {
                next := peek_kind(p, offset + 1)
                return (next == TokenKind::Eqeq || next == TokenKind::Ne || next == TokenKind::Lt
                    || next == TokenKind::Le || next == TokenKind::Gt || next == TokenKind::Ge
                    || next == TokenKind::Plus || next == TokenKind::Minus || next == TokenKind::Star
                    || next == TokenKind::Slash || next == TokenKind::Percent
                    || next == TokenKind::Andand || next == TokenKind::Oror || next == TokenKind::Shl
                    || next == TokenKind::Shr || next == TokenKind::Amp || next == TokenKind::Pipe
                    || next == TokenKind::Dot || next == TokenKind::Lbracket
                    || next == TokenKind::Question || next == TokenKind::Coloncolon)
            }
        }
        offset = offset + 1
    }
    false
}

// `true` and `false` always mean the booleans in expression position, so a
// binding, parameter or constant by either name could never be read back.
// Refused where the declaration is read, in the words the bootstrap also says.
refuse_literal_name :: fn(mut p: Parser, offset: i64, length: i64) {
    if (str_range_eq(p.src, offset, length, "true")) {
        report_where(p.modules, p.src, offset)
        report("'true' always means the boolean, so it cannot be declared as a name")
        frost_rt_recover_escape()
    }
    if (str_range_eq(p.src, offset, length, "false")) {
        report_where(p.modules, p.src, offset)
        report("'false' always means the boolean, so it cannot be declared as a name")
        frost_rt_recover_escape()
    }
}

// A statement that binds several names to the values of one call. A name
// followed by a comma is nothing else at statement position.
starts_multi_binding :: fn(mut p: Parser) -> bool {
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Comma) {
        return true
    }
    // A `_` opens the list the same way a name does, since a caller may want
    // the second value and none of the first. A list of one is a list, so
    // `_ := call()` reads the same way and is how a caller says an answer was
    // meant to go unread.
    if (cur(p) == TokenKind::Underscore
        && (peek_kind(p, 1) == TokenKind::Comma
            || peek_kind(p, 1) == TokenKind::Coloneq)) {
        return true
    }
    (cur(p) == TokenKind::KwMut && peek_kind(p, 1) == TokenKind::Ident
        && peek_kind(p, 2) == TokenKind::Comma)
}

// An array's length: arithmetic over numbers, the constants a module declares,
// and the size parameters a generic binds. It is arithmetic and nothing else,
// so working one out is bounded by how it was written, the same bound every
// other compile-time construct in the language has.
//
// A generic body is parsed once per instantiation with its parameters bound, so
// every name in a length is a number by the time this reads it and the answer
// is a number too. The bootstrap carries the unbound ones as written and works
// them out when the generic is instantiated, which is the same language read
// two ways.
parse_size_expr :: fn(mut p: Parser) -> i64 {
    mut left := parse_size_term(p)
    while (cur(p) == TokenKind::Plus || cur(p) == TokenKind::Minus) {
        adding := cur(p) == TokenKind::Plus
        advance(p)
        right := parse_size_term(p)
        if (adding) {
            left = left + right
        } else {
            left = left - right
        }
    }
    left
}

parse_size_term :: fn(mut p: Parser) -> i64 {
    mut left := parse_size_atom(p)
    while (cur(p) == TokenKind::Star || cur(p) == TokenKind::Slash
        || cur(p) == TokenKind::Percent) {
        op := cur(p)
        advance(p)
        right := parse_size_atom(p)
        if (op == TokenKind::Star) {
            left = left * right
        } else if (op == TokenKind::Slash) {
            left = left / right
        } else {
            left = left % right
        }
    }
    left
}

// One compile-time number a call answers with, where the cursor stands on the
// call. The same answer wherever a compile-time number is read: an array's
// length, a generic's value argument, and the `$N` a call hands over.
const_size_here :: fn(mut p: Parser) -> i64 {
    at := cur_off(p)
    held := const_call_here(p, at)
    if (held.kind != CONST_INT) {
        report_where(p.modules, p.src, at)
        report("a compile-time size is a whole number and this answers with ")
        report("something else")
        frost_rt_recover_escape()
    }
    if (held.value < 0) {
        report_where(p.modules, p.src, at)
        report_fmt(
            "a compile-time size is a whole number that is not negative, and this answers with {}",
            held.value
        )
        frost_rt_recover_escape()
    }
    held.value
}

// A number, a name standing for one, a call this program can work out, or a
// bracketed length. A call is run here rather than left written down, which is
// what keeps a length one thing rather than two.
// Whether a name written as a length stands for a number an instance supplies:
// a compile-time parameter of the generic being read, or one already bound to
// something while its body is read again.
length_waits_for_an_instance :: fn(
    mut p: Parser,
    offset: i64,
    length: i64
) -> bool {
    if (binding_of(p, offset, length) >= 0) {
        return true
    }
    names_gparam(p, offset, length)
}

parse_size_atom :: fn(mut p: Parser) -> i64 {
    if (cur(p) == TokenKind::Lparen) {
        advance(p)
        inner := parse_size_expr(p)
        advance(p)
        return inner
    }
    if (cur(p) == TokenKind::Int) {
        held := cur_val(p)
        advance(p)
        return held
    }
    // `[Vertex; 4]` names a type and never calls one, so the `(` is what tells
    // a length that calls something from a length that names one.
    if (at_const_call(p)) {
        return const_size_here(p)
    }
    if (cur(p) != TokenKind::Ident) {
        report_where(p.modules, p.src, cur_off(p))
        report("an array's length is a number, a name standing for one, or ")
        report("arithmetic over those")
        frost_rt_recover_escape()
    }
    // A `[N]T` inside a generic body, where N is a value parameter, takes its
    // length from the bound number. Otherwise the name is a module constant.
    bound := value_binding_of(p, cur_off(p), cur_len(p))
    if (bound >= 0) {
        advance(p)
        return bound
    }
    // A name that stands for no number leaves the length unknown rather than
    // negative: inside a generic's own parse the value parameter is not bound
    // to anything yet, and every `[N]u8` in the standard library reads that way
    // until an instance supplies one.
    if (is_const(p, cur_off(p), cur_len(p)) == false) {
        // A name the program binds to nothing at all is not a length waiting
        // for an instance to supply one. Left unknown, `[Nope]i64` was a type
        // carrying a length nothing could ever give it, and what a reader was
        // told came from whichever pass asked its size first.
        if (length_waits_for_an_instance(p, cur_off(p), cur_len(p))
            == false) {
            report_where(p.modules, p.src, cur_off(p))
            report("'")
            report_src(p.src, cur_off(p), cur_len(p))
            report("' has no value at compile time, so this cannot be ")
            report("worked out before the program runs")
            frost_rt_recover_escape()
        }
        p.size_known = 0
    }
    held := const_value(p, cur_off(p), cur_len(p))
    advance(p)
    held
}

// A second copy of a named place, node for node, so a walk this writes out can
// read the same storage twice without two passes meeting one node down two
// paths. Only the shapes `live_slots` takes as a subject: a name, and a field
// of one.
clone_place :: fn(mut p: Parser, node_id: i64) -> i64 {
    held := arena_at(p.arena, node_id)
    kind := held.kind
    base := held.a
    name_off := held.b
    name_len := held.c
    val := held.val
    at := held.pos
    if (kind == NodeKind::Var) {
        return new_named_node_at(p, NodeKind::Var, 0, val, name_len, at)
    }
    if (kind == NodeKind::Field) {
        return new_field_node(p, clone_place(p, base), name_off, name_len)
    }
    node_id
}

// `for slot in live_slots(c) { ... }`, with the cursor on the body's opening brace.
//
// The container records which of its slots hold an element as one bit each in
// `live_words`, so this is written out as a walk of those bits: a word that is
// zero passes over sixty-four slots on one test, and a word with bits set gives
// up its lowest one at a time. No slot is asked whether it holds an element and
// no empty slot is reached, which is the difference from walking the capacity
// and testing.
//
// It is one loop rather than a loop over words holding a loop over bits,
// because `break` in the reader's body means leaving the walk, and a `break`
// written inside the inner of two loops leaves only that one. What that costs
// is a compare per element that is taken once every sixty-four times.
//
// `for rank, slot in live_slots(c)` counts the elements as it goes, which is what
// compacting into a packed buffer wants.
parse_for_live :: fn(
    mut p: Parser,
    first_off: i64,
    first_len: i64,
    item_off: i64,
    item_len: i64,
    has_index: i64,
    container: i64
) -> i64 {
    held := arena_at(p.arena, container)
    kind := held.kind
    at := held.pos
    if (kind != NodeKind::Var && kind != NodeKind::Field) {
        report_where(p.modules, p.src, at)
        report("`live_slots` walks a container that is named, not one that ")
        report("is worked out; bind it first and walk the name")
        frost_rt_recover_escape()
    }
    // What it was given. Left unasked, the walk was written out against a name
    // holding a number and the reader was told about the indexing that walk
    // does, which is not what the program says.
    walked := parse_time_type(p, container)
    if (is_slab_ty(p, walked) == false && is_columns_ty(p, walked) == false) {
        // At the `for`, which is what the sentence is about: the walk is the
        // thing that cannot be written, rather than the name it was given.
        report_where(p.modules, p.src, p.stmt_at)
        report("`live_slots` walks a generational container, and this is not ")
        report("one; write `live_slots(c)` where `c` is a `columns<T, N>` or ")
        report("a `Slab<T, N>`")
        frost_rt_recover_escape()
    }
    unique := p.arena.count

    word_off := synth_numbered(p, "__live_w", unique)
    word_len := 8 + digits_in(unique)
    bind_word := new_let_node(
        p,
        new_node(p, NodeKind::Num, 0, 0, 0),
        word_off,
        word_len,
        -1
    )

    bits_off := synth_numbered(p, "__live_bits", unique)
    bits_len := 11 + digits_in(unique)
    bind_bits := new_let_node(
        p,
        new_node(p, NodeKind::Num, 0, 0, 0),
        bits_off,
        bits_len,
        -1
    )

    base_off := synth_numbered(p, "__live_base", unique)
    base_len := 11 + digits_in(unique)
    bind_base := new_let_node(
        p,
        new_node(p, NodeKind::Num, 0, 0, 0),
        base_off,
        base_len,
        -1
    )

    // The container is read here and nowhere else in the walk, so a name that
    // stands for storage is not copied and nothing is evaluated twice.
    words_name := synth_literal(p, "live_words")
    words_field := new_field_node(
        p,
        container,
        words_name,
        cstr_len("live_words")
    )
    count_off := synth_numbered(p, "__live_n", unique)
    count_len := 8 + digits_in(unique)
    bind_count := new_let_node(
        p,
        new_unary(p, NodeKind::SliceLen, words_field),
        count_off,
        count_len,
        -1
    )

    mut rank_off: i64 = 0
    mut rank_len: i64 = 0
    mut bind_rank: i64 = -1
    if (has_index == 1) {
        rank_off = synth_numbered(p, "__live_rank", unique)
        rank_len = 11 + digits_in(unique)
        bind_rank = new_let_node(
            p,
            new_node(p, NodeKind::Num, 0, 0, 0),
            rank_off,
            rank_len,
            -1
        )
    }

    // More to walk while the word in hand still has a bit set, or there is
    // another word to take.
    bits_live := new_node(
        p,
        NodeKind::Bin,
        new_named_node(p, NodeKind::Var, 0, bits_off, bits_len),
        new_node(p, NodeKind::Num, 0, 0, 0),
        OP_NE
    )
    words_left := new_node(
        p,
        NodeKind::Bin,
        new_named_node(p, NodeKind::Var, 0, word_off, word_len),
        new_named_node(p, NodeKind::Var, 0, count_off, count_len),
        OP_LT
    )
    condition := new_node(p, NodeKind::Bin, bits_live, words_left, OP_OR)

    // Taking the next word, when the one in hand is spent.
    words_again := new_field_node(
        p,
        clone_place(p, container),
        words_name,
        cstr_len("live_words")
    )
    take_bits := new_node(
        p,
        NodeKind::Assign,
        new_named_node(p, NodeKind::Var, 0, bits_off, bits_len),
        new_index(
            p,
            words_again,
            new_named_node(p, NodeKind::Var, 0, word_off, word_len),
            at
        ),
        0
    )
    take_base := new_node(
        p,
        NodeKind::Assign,
        new_named_node(p, NodeKind::Var, 0, base_off, base_len),
        new_node(
            p,
            NodeKind::Bin,
            new_named_node(p, NodeKind::Var, 0, word_off, word_len),
            new_node(p, NodeKind::Num, 0, 0, 64),
            OP_MUL
        ),
        0
    )
    bump_word := new_node(
        p,
        NodeKind::Assign,
        new_named_node(p, NodeKind::Var, 0, word_off, word_len),
        new_node(
            p,
            NodeKind::Bin,
            new_named_node(p, NodeKind::Var, 0, word_off, word_len),
            new_node(p, NodeKind::Num, 0, 0, 1),
            OP_ADD
        ),
        0
    )
    again := new_node(p, NodeKind::Continue, 0, 0, 0)
    set_next(p, take_bits, take_base)
    set_next(p, take_base, bump_word)
    set_next(p, bump_word, again)
    spent := new_node(
        p,
        NodeKind::Bin,
        new_named_node(p, NodeKind::Var, 0, bits_off, bits_len),
        new_node(p, NodeKind::Num, 0, 0, 0),
        OP_EQ
    )
    refill := new_node(p, NodeKind::If, spent, take_bits, -1)

    // The lowest slot the word still names, and the word with that bit gone.
    bit_off := synth_numbered(p, "__live_bit", unique)
    bit_len := 10 + digits_in(unique)
    bind_bit := new_let_node(
        p,
        new_unary(
            p,
            NodeKind::TrailingZeros,
            new_named_node(p, NodeKind::Var, 0, bits_off, bits_len)
        ),
        bit_off,
        bit_len,
        -1
    )
    // Cleared before the reader's body, so a `continue` cannot leave the walk
    // reading the same slot for ever.
    one_bit := new_node(
        p,
        NodeKind::Bin,
        new_node(p, NodeKind::Num, 0, 0, 1),
        new_named_node(p, NodeKind::Var, 0, bit_off, bit_len),
        OP_SHL
    )
    without := new_node(
        p,
        NodeKind::Bin,
        new_node(p, NodeKind::Num, 0, 0, -1),
        one_bit,
        OP_SUB
    )
    drop_bit := new_node(
        p,
        NodeKind::Assign,
        new_named_node(p, NodeKind::Var, 0, bits_off, bits_len),
        new_node(
            p,
            NodeKind::Bin,
            new_named_node(p, NodeKind::Var, 0, bits_off, bits_len),
            without,
            OP_BITAND
        ),
        0
    )
    bind_slot := new_let_node(
        p,
        new_node(
            p,
            NodeKind::Bin,
            new_named_node(p, NodeKind::Var, 0, base_off, base_len),
            new_named_node(p, NodeKind::Var, 0, bit_off, bit_len),
            OP_ADD
        ),
        item_off,
        item_len,
        -1
    )

    set_next(p, refill, bind_bit)
    set_next(p, bind_bit, drop_bit)
    set_next(p, drop_bit, bind_slot)
    mut tail := bind_slot
    if (has_index == 1) {
        take_rank := new_let_node(
            p,
            new_named_node(p, NodeKind::Var, 0, rank_off, rank_len),
            first_off,
            first_len,
            -1
        )
        bump_rank := new_node(
            p,
            NodeKind::Assign,
            new_named_node(p, NodeKind::Var, 0, rank_off, rank_len),
            new_node(
                p,
                NodeKind::Bin,
                new_named_node(p, NodeKind::Var, 0, rank_off, rank_len),
                new_node(p, NodeKind::Num, 0, 0, 1),
                OP_ADD
            ),
            0
        )
        set_next(p, tail, take_rank)
        set_next(p, take_rank, bump_rank)
        tail = bump_rank
    }

    p.loop_depth = p.loop_depth + 1
    body := parse_block(p)
    p.loop_depth = p.loop_depth - 1
    set_next(p, tail, body)

    loop := new_node(p, NodeKind::While, condition, refill, 0)
    set_while_preamble(p, loop, -1)
    set_next(p, bind_word, bind_bits)
    set_next(p, bind_bits, bind_base)
    set_next(p, bind_base, bind_count)
    if (has_index == 1) {
        set_next(p, bind_count, bind_rank)
        set_next(p, bind_rank, loop)
    } else {
        set_next(p, bind_count, loop)
    }
    bind_word
}

// `for i in a..b { ... }`, written out as the counted loop it stands for, with
// the cursor on the body's opening brace. The reader's name is the counter
// itself, so nothing is indexed and no element is bound. The bound is read into
// a name once ahead of the loop, so a call in that position happens once rather
// than once per turn, and `..=` reaches it.
parse_for_range :: fn(
    mut p: Parser,
    first_off: i64,
    item_off: i64,
    item_len: i64,
    has_index: i64,
    start: i64,
    finish: i64,
    closed: i64
) -> i64 {
    if (has_index == 1) {
        report_where(p.modules, p.src, first_off)
        report("a `for` over a range binds one name, which is the number")
        frost_rt_recover_escape()
    }
    unique := p.arena.count
    end_off := synth_numbered(p, "__for_end", unique)
    end_len := 9 + digits_in(unique)
    bind_end := new_let_node(p, finish, end_off, end_len, -1)

    // The counter carries a name of its own and the reader's name is bound from
    // it inside the loop, which is what the walk over a sequence does with its
    // element. Two loops in one function would otherwise declare the reader's
    // name twice in one C scope, since a binding is emitted where it stands and
    // only a loop body opens a block.
    at_off := synth_numbered(p, "__for_at", unique)
    at_len := 8 + digits_in(unique)
    bind_at := new_let_node(p, start, at_off, at_len, -1)

    index_var := new_named_node(p, NodeKind::Var, 0, at_off, at_len)
    end_var := new_named_node(p, NodeKind::Var, 0, end_off, end_len)
    mut compare := OP_LT
    if (closed == 1) {
        compare = OP_LE
    }
    condition := new_node(p, NodeKind::Bin, index_var, end_var, compare)

    p.loop_depth = p.loop_depth + 1
    body := parse_block(p)
    p.loop_depth = p.loop_depth - 1

    at_again := new_named_node(p, NodeKind::Var, 0, at_off, at_len)
    bind_item := new_let_node(p, at_again, item_off, item_len, -1)
    set_next(p, bind_item, body)

    step_at := new_named_node(p, NodeKind::Var, 0, at_off, at_len)
    one := new_node(p, NodeKind::Num, 0, 0, 1)
    bumped := new_node(p, NodeKind::Bin, step_at, one, OP_ADD)
    step_place := new_named_node(p, NodeKind::Var, 0, at_off, at_len)
    step := new_node(p, NodeKind::Assign, step_place, bumped, 0)
    mut tail := bind_item
    mut following := node_next(p, tail)
    while (following != (-1)) {
        tail = following
        following = node_next(p, tail)
    }
    set_next(p, tail, step)

    loop := new_node(p, NodeKind::While, condition, bind_item, 0)
    set_while_preamble(p, loop, -1)
    set_next(p, bind_end, bind_at)
    set_next(p, bind_at, loop)
    bind_end
}

// The tokens an expression can open with. A statement that starts with
// anything else is a fault said where it stands, rather than a name made of
// whatever the token spells.
can_begin_expression :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Ident || kind == TokenKind::Str
        || kind == TokenKind::Int || kind == TokenKind::Float
        || kind == TokenKind::Bang || kind == TokenKind::Minus
        || kind == TokenKind::Amp || kind == TokenKind::Dollar
        || kind == TokenKind::Dot || kind == TokenKind::Lbrace
        || kind == TokenKind::Lbracket || kind == TokenKind::Lparen
        || kind == TokenKind::KwIf || kind == TokenKind::KwFn
        || kind == TokenKind::KwMatch || kind == TokenKind::KwUnsafe)
}

// `name :: fn` where a statement is expected. Asked from every place that
// reads what a body holds, because a body is read two ways: as a list of
// statements, and, where `unsafe { .. }` stands for a value, as one expression.
// Asked only at the first, a function declared inside the second was told
// about as a name with no variant called `fn`.
// How many brackets a statement opened and had not closed when it failed.
//
// The walk that resumes after a fault stops on the first closing brace with
// nothing open behind it, so it has to know what was already open: the block
// depth answers for blocks alone, and `x := unsafe { f :: fn .. }` failed
// inside a brace that opened no block, so the walk read that brace as the end
// of the function it was written in and every line after it as a declaration.
// The tokens the statement has read say it exactly, so they are what is asked.
left_open :: fn(p: Parser, from: i64, to: i64) -> i64 {
    mut open: i64 = 0
    mut at := from
    while (at < to && at < p.tokens.count) {
        kind := arena_at(p.tokens, at).kind
        if (kind == TokenKind::Lbrace || kind == TokenKind::Lparen
            || kind == TokenKind::Lbracket) {
            open = open + 1
        }
        if (kind == TokenKind::Rbrace || kind == TokenKind::Rparen
            || kind == TokenKind::Rbracket) {
            if (open > 0) {
                open = open - 1
            }
        }
        at = at + 1
    }
    open
}

refuse_nested_function :: fn(mut p: Parser, start: i64) {
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Coloncolon
        && peek_kind(p, 2) == TokenKind::KwFn) {
        report_where(p.modules, p.src, start)
        report(
            "a function is declared where a file's other declarations are, and '"
        )
        report_src(p.src, start, cur_len(p))
        report("' is declared inside a body")
        skip_declaration(p)
        frost_rt_recover_escape()
    }
}

parse_stmt :: fn(mut p: Parser) -> i64 {
    kind := cur(p)
    // Where the statement starts. Everything below builds its node after
    // reading what the statement is made of, by which point the cursor names
    // the statement after it.
    start := cur_off(p)

    // A type is declared where every other declaration is. Written in a body it
    // reads as a name reaching into a type for one of its values, and the
    // reader was told the type has no variant called `struct`.
    if (at_type_declaration(p)) {
        report_where(p.modules, p.src, start)
        report("a type is declared where a file's other declarations are, and '")
        report_src(p.src, start, cur_len(p))
        report("' is declared inside a body")
        skip_declaration(p)
        frost_rt_recover_escape()
    }

    // `$if`, the branch the compiler answers. The `$` is what says so: an
    // ordinary `if` over a type predicate reads the same way and is decided
    // somewhere else, and which one a reader was looking at came down to
    // whether a name in the condition happened to be a compile-time parameter.
    if (kind == TokenKind::Dollar && peek_kind(p, 1) == TokenKind::KwIf) {
        advance(p)
        // An `if` over what a type is has an answer here, and the branch that
        // cannot run is not parsed into the program at all. That is what lets
        // one body serve elements of different types: the branch that would not
        // compile for this one is gone before anything checks it.
        held_answer := expansion_answer(p)
        if (held_answer >= 0) {
            return parse_expansion_if(p, held_answer)
        }
        // A condition holding one of the predicates is one this answers,
        // whether or not it has what it needs to answer it here: a template is
        // read once with nothing bound, and an instance is read again with the
        // binding it was made for. Either way the branches are parsed and the
        // instance decides.
        if (condition_holds_a_predicate(p)) {
            return parse_stmt(p)
        }
        // A `$if` says the whole of its condition is answered here. One that is
        // not is a branch the program would take while it runs, written under
        // a word saying it would not.
        //
        // Said once. A generic's body is read again for every instance, and one
        // line written once is one mistake however many readings pass over it.
        if (already_said(p, peek_off(p, 2))) {
            return parse_stmt(p)
        }
        report_where(p.modules, p.src, peek_off(p, 2))
        report("a `$if` is answered while the body is expanded, and this ")
        report("condition is not: it reads something the program works out ")
        report("while it runs. Write `if` for a branch the program takes, and ")
        report("`$if` for one the compiler answers")
        frost_rt_recover_escape()
    }

    // A function is declared where every other declaration is, for the same
    // reason. Written in a body it read as a name reaching into a type, and the
    // reader was told the type has no variant called `fn`, then that `->` is
    // not a token an expression can hold.
    refuse_nested_function(p, start)

    // `ref x := place` binds a borrow of a place: an address that types as a
    // borrow, so reading a field through it needs no `unsafe` block, unlike a
    // raw pointer. It is how an arena element is reached without ptr_to.
    if (kind == TokenKind::KwRef) {
        advance(p)
        // What follows `ref` was taken on trust: whatever token sat where the
        // name goes became the name, and whatever sat where `:=` goes was
        // stepped over. `ref b a` bound `b` to `a` read as a place and was
        // taken, and `ref 7` walked off the end of the statement.
        if (cur(p) != TokenKind::Ident) {
            report_where(p.modules, p.src, cur_off(p))
            report("a name goes after `ref`, and this is not one")
            frost_rt_recover_escape()
        }
        name_off := cur_off(p)
        name_len := cur_len(p)
        refuse_literal_name(p, name_off, name_len)
        advance(p)
        if (cur(p) != TokenKind::Coloneq) {
            report_where(p.modules, p.src, cur_off(p))
            report("`:=` goes after the name a `ref` binds")
            frost_rt_recover_escape()
        }
        advance(p)
        place := parse_expr(p)
        value := new_unary(p, NodeKind::Ref, place)
        // What the name binds, which every other binding records and this one
        // did not. Without it the rest of the parse had no way to tell a name
        // holding a borrow from a name holding a number, so a scalar one was
        // read as the address it carries and `bound == 9` compared that address
        // against nine.
        //
        // Read off the parse's own table first. `binding_type` asks `type_of`,
        // which reads the table the emitters fill, and that one is empty while
        // a body is still being read: a borrow of a struct came back a borrow
        // of an i64, and the list element it became was a number.
        mut bound_ty := pack_local_type(p, place)
        if (bound_ty < 0) {
            bound_ty = binding_type(p, value)
        } else {
            bound_ty = borrow_of(p, bound_ty)
        }
        record_parse_local(p, name_off, name_len, bound_ty, value)
        return new_let_node(p, value, name_off, name_len, -1)
    }

    // `unsafe { ... }` is a block whose statements belong to the enclosing one.
    // The block is inlined, so what is emitted is identical to the same
    // statements written bare. Only its span is remembered, so the gate can
    // ask whether a node was written inside one.
    if (kind == TokenKind::KwUnsafe) {
        // An `unsafe { expr }` followed by an operator, as in
        // `unsafe { m.state[s] } == USED`, is one expression, not a block of
        // statements, so it goes through the expression path where the operator
        // is applied to the value the block stands for.
        if (unsafe_block_is_value(p)) {
            expr := parse_expr(p)
            if (cur(p) == TokenKind::Assign) {
                advance(p)
                saved_expected := p.expected_type
                p.expected_type = assign_context(p, expr)
                value := parse_expr(p)
                p.expected_type = saved_expected
                return new_node_at(p, NodeKind::Assign, expr, value, 0, start)
            }
            return new_unary_at(p, NodeKind::ExprStmt, expr, start)
        }
        start := cur_off(p)
        advance(p)
        p.unsafe_depth = p.unsafe_depth + 1
        body := parse_block(p)
        p.unsafe_depth = p.unsafe_depth - 1
        arena_push(
            p.unsafe_spans,
            UnsafeSpan { start = start, end = cur_off(p), used = 0 }
        )
        return body
    }

    // `_ := call()` names one value rather than a list of them. The answer is
    // read and bound under a name no source can spell, so a resource is still
    // taken and still owed to a consumer. Taken apart as a list it asked the
    // callee for a field of a return type list it never declared, and said so
    // at the top of the file.
    if (cur(p) == TokenKind::Underscore
        && peek_kind(p, 1) == TokenKind::Coloneq) {
        at := cur_off(p)
        advance(p)
        advance(p)
        value := parse_expr(p)
        unique := p.arena.count
        name_off := synth_numbered(p, "__discard", unique)
        name_len := 9 + digits_in(unique)
        bind := new_let_node(p, value, name_off, name_len, -1)
        // At the `_`. The binding carries the name the compiler made up, whose
        // offset is in the room past the source, and the walk that refuses a
        // dropped resource reports where the reader wrote it.
        mut spot := arena_at(p.arena, bind)
        spot.pos = at
        return bind
    }

    // `quotient, remainder := divide(a, b)`, and `mut` in front of any name the
    // body goes on to write. The names are walked twice: once to reach the
    // `:=`, so the call is bound to a temporary first, and once to bind each
    // name to its field of that temporary.
    if (starts_multi_binding(p)) {
        names_at := p.ti
        while (cur(p) != TokenKind::Coloneq && cur(p) != TokenKind::Eof) {
            advance(p)
        }
        advance(p)
        unique := p.arena.count
        temp_off := synth_numbered(p, "__multi", unique)
        temp_len := 7 + digits_in(unique)
        value := parse_expr(p)
        // The one call entitled to answer with a return type list, since this
        // is where the list is taken apart again. `check_multi_call_bound`
        // reads this and refuses every other one.
        arena_push(
            p.multi_calls,
            LocalVar { name_off = value, name_len = 0, ty = 0, slot = 0 }
        )
        after := p.ti
        head := new_let_node(p, value, temp_off, temp_len, -1)
        mut tail := head
        mut index: i64 = 0
        callee := call_target(p, value)
        p.ti = names_at
        while (cur(p) != TokenKind::Coloneq && cur(p) != TokenKind::Eof) {
            if (cur(p) == TokenKind::Ident && cur_len(p) == 3
                && str_range_eq(p.src, cur_off(p), 3, "var")
                && peek_kind(p, 1) == TokenKind::Ident) {
                report_where(p.modules, p.src, cur_off(p))
                report("a local that is reassigned is declared with `mut`, the word a parameter that writes the caller's value carries")
                frost_rt_recover_escape()
            }
            mut assignable: i64 = 0
            // Where the `mut` is, since it is the word the reader takes away.
            mut assignable_at := cur_off(p)
            if (cur(p) == TokenKind::KwMut) {
                assignable = 1
                advance(p)
            }
            // `_` takes a value the caller has no use for. The list binds one
            // name per value the call answers with, so without it a caller
            // wanting only the first has to invent a name for the rest, and
            // that name is a live binding somebody can read by mistake. The
            // field is still read, into storage under a name no source can
            // spell and a fresh one per discard: a linear value is a resource
            // somebody owes a consumer, and dropping the read would lose it
            // without a word.
            mut name_off := cur_off(p)
            mut name_len := cur_len(p)
            if (cur(p) == TokenKind::Underscore) {
                if (assignable == 1) {
                    report_where(p.modules, p.src, assignable_at)
                    report("`mut` makes a binding assignable and `_` binds nothing; write `_` on its own")
                    frost_rt_recover_escape()
                }
                // A resource taken by a `_` is refused once the resources are
                // settled. Said there rather than by the move walk, which runs
                // on what this rewrite left behind and would name the storage
                // below, a name nothing in the program spells.
                arena_push(
                    p.multi_discards,
                    LocalVar {
                        name_off = callee,
                        name_len = index,
                        ty = name_off,
                        slot = 0
                    }
                )
                held := p.arena.count
                name_off = synth_numbered(p, "__discard", held)
                name_len = 9 + digits_in(held)
            } else {
                refuse_literal_name(p, name_off, name_len)
            }
            at := cur_off(p)
            advance(p)
            base := new_named_node(p, NodeKind::Var, 0, temp_off, temp_len)
            field := synth_numbered(p, "value", index)
            access := new_field_node(p, base, field, 5 + digits_in(index))
            // At the name this value is bound to. The node reads a field of a
            // temporary the compiler made, whose position is in the room past
            // the source, and a report about the binding belongs where the
            // binding is written.
            mut spot := arena_at(p.arena, access)
            spot.pos = at
            // The field is called whatever the signature called that value. A
            // callee written later in the program has no signature yet, so the
            // name is patched once every one is parsed.
            if (resolve_multi_field(p, access, callee, index) == false) {
                arena_push(
                    p.variant_fixups,
                    VariantFixup {
                        lit = access,
                        callee = callee,
                        argument = index,
                        kind = FixupKind::MultiField
                    }
                )
            }
            bind := new_let_node(p, access, name_off, name_len, -1)
            mut bound := arena_at(p.arena, bind)
            bound.pos = at
            set_next(p, tail, bind)
            tail = bind
            index = index + 1
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        p.ti = after
        return head
    }

    // `var` is an ordinary name and opens nothing, so an older file reads as a
    // name followed by a binding. Named here rather than left to whatever that
    // parses as, which is a complaint about the second word.
    if (kind == TokenKind::Ident && cur_len(p) == 3
        && str_range_eq(p.src, cur_off(p), 3, "var")
        && peek_kind(p, 1) == TokenKind::Ident
        && (peek_kind(p, 2) == TokenKind::Coloneq
            || peek_kind(p, 2) == TokenKind::Colon
            || peek_kind(p, 2) == TokenKind::Comma)) {
        report_where(p.modules, p.src, cur_off(p))
        report("a local that is reassigned is declared with `mut`, the word a parameter that writes the caller's value carries")
        frost_rt_recover_escape()
    }
    if (kind == TokenKind::KwMut) {
        advance(p)
        offset := cur_off(p)
        length := cur_len(p)
        refuse_literal_name(p, offset, length)
        advance(p)
        mut ann: i64 = -1
        if (cur(p) == TokenKind::Colon) {
            ann = parse_type_annotation(p)
            advance(p)
        } else {
            advance(p)
        }
        saved_expected := p.expected_type
        p.expected_type = ann
        value := parse_expr(p)
        p.expected_type = saved_expected
        // What the name binds, recorded the way the two immutable forms above
        // record theirs, so an argument at a call below it can be typed where
        // it is written.
        if (ann >= 0) {
            record_parse_local(p, offset, length, ann, -1)
        } else {
            settle_call_answer(p, value)
            record_parse_local(p, offset, length, binding_type(p, value), value)
        }
        return new_let_node(p, value, offset, length, ann)
    }

    // `defer Stmt` runs `Stmt` where the function leaves, last deferred first.
    // Nothing of it stands here: the token index is kept and the statement is
    // read again at each exit, so no node kind, no pass and no backend learns
    // anything new.
    //
    // Only at the top level of a body. Deeper, what it means is not what it
    // reads as: it would run where the function leaves rather than where the
    // block does, and one written in a loop would run once, after the loop, with
    // whatever the loop left behind rather than once a turn.
    if (kind == TokenKind::KwDefer || kind == TokenKind::KwErrDefer) {
        on_failure := 0
        if (kind == TokenKind::KwErrDefer) {
            on_failure = 1
        }
        // An `errdefer` in a function that cannot fail names an exit that
        // function does not have.
        if (on_failure == 1 && p.result_ty == (-1)) {
            report_where(p.modules, p.src, cur_off(p))
            report("`errdefer` runs where a function leaves through its ")
            report("failure set, and this one has none; write `-> T ! E`, or ")
            report("`defer` to run it however the function leaves")
            frost_rt_recover_escape()
        }
        if (p.block_depth != p.defer_depth) {
            report_where(p.modules, p.src, cur_off(p))
            report("a `defer` belongs at the top level of a body, since it runs where the function leaves rather than where this block does")
            frost_rt_recover_escape()
        }
        advance(p)
        started := p.ti
        // What this function had bound by the time the `defer` was written. A
        // name bound past this point is a different binding from the one the
        // deferred statement names, which is what the check below refuses.
        bound := p.parse_locals.count
        // A `defer` runs where the function leaves, so one that leaves the
        // function is read again at the exit it makes, which makes another
        // exit. Both compilers ran out of stack on it rather than saying so.
        if (cur(p) == TokenKind::KwReturn) {
            report_where(p.modules, p.src, cur_off(p))
            report("a `defer` runs where the function leaves, and a `return` ")
            report("inside one would leave it again")
            frost_rt_recover_escape()
        }
        parse_stmt(p)
        arena_push(
            p.defers,
            LocalVar {
                name_off = started,
                name_len = p.ti,
                ty = bound,
                slot = on_failure
            }
        )
        return nothing_statement(p)
    }
    if (kind == TokenKind::KwReturn) {
        advance(p)
        if (cur(p) == TokenKind::Rbrace) {
            return defer_before_return(p, -1, start, 0)
        }
        saved_expected := p.expected_type
        saved_alt := p.expected_alt
        p.expected_type = p.ok_ty
        p.expected_alt = p.failure_ty
        mut value := parse_expr(p)
        p.expected_type = saved_expected
        p.expected_alt = saved_alt
        if (cur(p) == TokenKind::Comma) {
            value = multi_return_value(p, value)
        }
        // A `return` handing back the failure side is the function leaving
        // through its failure set, which is the exit an `errdefer` names.
        // Passed as an ordinary exit, the copies were left out and the resource
        // the `errdefer` was written to release was read as never released.
        // The `?` path already says so; this is the same exit written out.
        mut failing: i64 = 0
        if (p.result_ty != (-1)) {
            if (returns_failure(p, value)) {
                failing = 1
            }
            value = wrap_result(p, value)
        }
        return defer_before_return(p, value, start, failing)
    }
    if (kind == TokenKind::KwIf) {
        // An ordinary `if` whose condition the expansion can answer. The branch
        // it decides is decided there, and a body under it may write what only
        // one of the two arguments makes sense for, so the word saying so is
        // what the reader writes.
        if (expansion_answer(p) >= 0) {
            report_where(p.modules, p.src, peek_off(p, 2))
            report("this condition is answered while the body is expanded, ")
            report("so the branch it decides is written `$if` rather than ")
            report("`if`")
            frost_rt_recover_escape()
        }
        // Where the `if` is written. Read off the cursor once the branches are
        // parsed, the node named the brace that closes the last of them, so a
        // report about the statement landed at its end.
        if_at := cur_off(p)
        advance(p)
        advance(p)
        condition := parse_expr(p)
        advance(p)
        then_head := parse_block(p)
        mut else_head: i64 = -1
        if (cur(p) == TokenKind::KwElse) {
            advance(p)
            if (cur(p) == TokenKind::KwIf
                || (cur(p) == TokenKind::Dollar
                    && peek_kind(p, 1) == TokenKind::KwIf)) {
                else_head = parse_stmt(p)
            } else {
                else_head = parse_block(p)
            }
        }
        return new_node_at(
            p,
            NodeKind::If,
            condition,
            then_head,
            else_head,
            if_at
        )
    }
    // `for item in items { ... }` over a slice, an array or a `str`, and
    // `for index, item in items` when the position is wanted too.
    //
    // It is written out here as the index-and-bound loop it stands for, so no
    // node kind, no pass and no backend learns anything new. The sequence and
    // its length are bound once before the loop, so a call in that position
    // happens once and a body that grows the same container does not walk what
    // it just added.
    if (kind == TokenKind::KwFor) {
        advance(p)
        first_off := cur_off(p)
        first_len := cur_len(p)
        refuse_literal_name(p, first_off, first_len)
        advance(p)
        mut item_off := first_off
        mut item_len := first_len
        mut has_index: i64 = 0
        // What this loop names, held while its body is read. The body's block
        // takes them off again.
        p.loop_body_mark = p.loop_names.count
        arena_push(
            p.loop_names,
            Cap { ty = 0, off = first_off, len = first_len }
        )
        if (cur(p) == TokenKind::Comma) {
            advance(p)
            item_off = cur_off(p)
            item_len = cur_len(p)
            refuse_literal_name(p, item_off, item_len)
            advance(p)
            has_index = 1
            arena_push(
                p.loop_names,
                Cap { ty = 0, off = item_off, len = item_len }
            )
        }
        if (cur(p) != TokenKind::KwIn) {
            report_where(p.modules, p.src, cur_off(p))
            report("a `for` needs `in` between the name and what it walks")
            frost_rt_recover_escape()
        }
        advance(p)
        // A `for` over a compile-time list is not a loop: the list has a length
        // the instance knows, so the body is read once per element with the
        // loop's name standing for that element. Nothing of the list survives
        // the parse.
        if (names_pack(p, cur_off(p), cur_len(p))
            && peek_kind(p, 1) == TokenKind::Lbrace) {
            advance(p)
            return unroll_pack(p, item_off, item_len)
        }
        // A `for` over a type's fields is not a loop either. The list is the
        // struct's own field list, so its length is fixed by a declaration.
        if (str_range_eq(p.src, cur_off(p), cur_len(p), "fields")
            && peek_kind(p, 1) == TokenKind::Lparen) {
            // Where `fields` is written, for a report about what it was given.
            // Read at the point the walk gives up, the cursor names the body's
            // `{` and the caret landed past the closing parenthesis.
            walk_at := cur_off(p)
            advance(p)
            advance(p)
            // A template's own reading has nothing bound to the name a list
            // element is reached under, so there is no type to walk and no name
            // to say anything about. That reading is thrown away and done again
            // per element, where the name is a type.
            held_check := p.type_check_names
            pending_mark := p.pending_type_names.count
            if (unbound_template(p)) {
                p.type_check_names = 0
            }
            walked := parse_type(p)
            p.type_check_names = held_check
            unknown := p.pending_type_names.count > pending_mark
            p.pending_type_names.count = pending_mark
            advance(p)
            if (unknown) {
                parse_block(p)
                return nothing_statement(p)
            }
            return unroll_fields(p, item_off, item_len, walked, walk_at)
        }
        // `for slot in live_slots(c)` walks the slots of a generational container
        // that hold an element, in slot order, and nothing else.
        if (str_range_eq(p.src, cur_off(p), cur_len(p), "live_slots")
            && peek_kind(p, 1) == TokenKind::Lparen) {
            advance(p)
            advance(p)
            held_lit := p.no_struct_lit
            p.no_struct_lit = false
            container := parse_expr(p)
            p.no_struct_lit = held_lit
            advance(p)
            return parse_for_live(
                p,
                first_off,
                first_len,
                item_off,
                item_len,
                has_index,
                container
            )
        }
        // A name followed by a brace is a struct literal everywhere else, and
        // the brace here opens the body, so the literal is not available.
        held_no_lit := p.no_struct_lit
        p.no_struct_lit = true
        sequence := parse_expr(p)
        // `for i in a..b` walks the numbers rather than a sequence, so it takes
        // the counted loop straight rather than reaching one through a length
        // and an index.
        mut range_end: i64 = -1
        mut range_closed: i64 = 0
        if (cur(p) == TokenKind::Dotdot || cur(p) == TokenKind::Dotdoteq) {
            if (cur(p) == TokenKind::Dotdoteq) {
                range_closed = 1
            }
            advance(p)
            range_end = parse_expr(p)
        }
        p.no_struct_lit = held_no_lit
        if (range_end != (-1)) {
            return parse_for_range(
                p,
                first_off,
                item_off,
                item_len,
                has_index,
                sequence,
                range_end,
                range_closed
            )
        }

        unique := p.arena.count
        // A name is already evaluated once and already carries its own type, so
        // it is walked where it stands. Anything else is bound first, so a call
        // in that position happens once rather than once per element. A string
        // literal is bound as a `str` rather than left as the `^i8` it would
        // otherwise infer, so walking it is bounds-checked like any other
        // sequence instead of asking the reader for an `unsafe` block.
        seq_node := arena_at(p.arena, sequence)
        seq_kind := seq_node.kind
        seq_at := seq_node.pos
        in_place := seq_kind == NodeKind::Var
        mut seq_off := seq_node.val
        mut seq_len := seq_node.c
        mut bind_seq: i64 = -1
        if (in_place == false) {
            mut annotation: i64 = -1
            if (seq_kind == NodeKind::StrLit) {
                annotation = array_of(p, TY_U8, -1)
            }
            seq_off = synth_numbered(p, "__for_seq", unique)
            seq_len = 9 + digits_in(unique)
            bind_seq = new_let_node(p, sequence, seq_off, seq_len, annotation)
        }

        seq_var := new_named_node(p, NodeKind::Var, 0, seq_off, seq_len)
        length := new_unary(p, NodeKind::SliceLen, seq_var)
        // What this `for` walks, asked of the length it takes. A `for` is a
        // `while` over an index by the time anything can ask, so the question
        // is written onto the one node that still names the sequence, and
        // answered in the pass that has the locals. Left unmarked, a number was
        // indexed, the element came back as a slice of itself, and the reader
        // was told about a format string where the element was printed.
        mut len_node := arena_at(p.arena, length)
        len_node.val = 3
        len_node.pos = start
        len_off := synth_numbered(p, "__for_len", unique)
        len_len := 9 + digits_in(unique)
        bind_len := new_let_node(p, length, len_off, len_len, -1)

        mut index_off := item_off
        mut index_len := item_len
        if (has_index == 1) {
            index_off = first_off
            index_len = first_len
        } else {
            index_off = synth_numbered(p, "__for_at", unique)
            index_len = 8 + digits_in(unique)
        }
        zero := new_node(p, NodeKind::Num, 0, 0, 0)
        bind_index := new_let_node(p, zero, index_off, index_len, -1)

        index_var := new_named_node(p, NodeKind::Var, 0, index_off, index_len)
        len_var := new_named_node(p, NodeKind::Var, 0, len_off, len_len)
        condition := new_node(p, NodeKind::Bin, index_var, len_var, OP_LT)

        // A `for` over the list this declaration takes, read while nothing is
        // bound to it, is the template's own copy of the body and is never
        // emitted. What is written through the loop's name names no function
        // here and names one in every copy that is.
        held_pack_for := p.unbound_pack_for
        if (in_place
            && p.pack_len == 0
            && p.decl_pack_len > 0
            && seq_len == p.decl_pack_len
            && bytes_equal(p.src, seq_off, p.decl_pack_off, p.decl_pack_len)) {
            p.unbound_pack_for = 1
        }
        p.loop_depth = p.loop_depth + 1
        body := parse_block(p)
        p.loop_depth = p.loop_depth - 1
        p.unbound_pack_for = held_pack_for

        // The element, bound under the name the reader wrote, ahead of the
        // body they wrote.
        seq_again := new_named_node(p, NodeKind::Var, 0, seq_off, seq_len)
        at_again := new_named_node(p, NodeKind::Var, 0, index_off, index_len)
        element := new_index(p, seq_again, at_again, seq_at)
        bind_item := new_let_node(p, element, item_off, item_len, -1)
        set_next(p, bind_item, body)

        // The step, after everything the body does.
        step_at := new_named_node(p, NodeKind::Var, 0, index_off, index_len)
        one := new_node(p, NodeKind::Num, 0, 0, 1)
        bumped := new_node(p, NodeKind::Bin, step_at, one, OP_ADD)
        step_place := new_named_node(p, NodeKind::Var, 0, index_off, index_len)
        step := new_node(p, NodeKind::Assign, step_place, bumped, 0)
        mut tail := bind_item
        mut following := node_next(p, tail)
        while (following != (-1)) {
            tail = following
            following = node_next(p, tail)
        }
        set_next(p, tail, step)

        loop := new_node(p, NodeKind::While, condition, bind_item, 0)
        // The condition needs nothing set up ahead of it, and an unset preamble
        // is -1 rather than 0, which is a real node.
        set_while_preamble(p, loop, -1)
        set_next(p, bind_len, bind_index)
        set_next(p, bind_index, loop)
        if (in_place) {
            return bind_len
        }
        set_next(p, bind_seq, bind_len)
        return bind_seq
    }
    // Leaving a loop, and going round it again. Which loop is the innermost
    // one, so there is nothing to carry: the emitters know where they are.
    if (kind == TokenKind::KwBreak) {
        if (p.loop_depth == 0) {
            report_where(p.modules, p.src, start)
            report("break outside loop")
            frost_rt_recover_note()
        }
        advance(p)
        return new_node(p, NodeKind::Break, 0, 0, 0)
    }
    if (kind == TokenKind::KwContinue) {
        if (p.loop_depth == 0) {
            report_where(p.modules, p.src, start)
            report("continue outside loop")
            frost_rt_recover_note()
        }
        advance(p)
        return new_node(p, NodeKind::Continue, 0, 0, 0)
    }
    if (kind == TokenKind::KwWhile) {
        // Where the `while` is written, the way an `if`'s is: read off the
        // cursor once the body is parsed, the node named the brace closing it.
        while_at := cur_off(p)
        advance(p)
        advance(p)
        // Anything the condition needs set up, a `?` or a match used as a
        // value, belongs to the loop rather than to the statement before it,
        // since the condition is asked again every time round.
        mark := p.pending.count
        condition := parse_expr(p)
        preamble := flush_pending(p, mark, -1)
        advance(p)
        p.loop_depth = p.loop_depth + 1
        body := parse_block(p)
        p.loop_depth = p.loop_depth - 1
        loop := new_node_at(p, NodeKind::While, condition, body, 0, while_at)
        set_while_preamble(p, loop, preamble)
        return loop
    }
    // `with arena { ... }` supplies an allocation capability to everything the
    // block calls. The block is the region. It is a plain scope once the calls
    // inside it have been handed the arena.
    if (kind == TokenKind::KwWith) {
        advance(p)
        name_offset := cur_off(p)
        name_length := cur_len(p)
        advance(p)
        body := parse_block(p)
        return new_named_node(p, NodeKind::With, body, name_offset, name_length)
    }

    // A local binding `x := e` or `x : T = e` is recognised by the token after
    // the name, so the name is not consumed early for the other cases.
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Coloneq) {
        offset := cur_off(p)
        length := cur_len(p)
        refuse_literal_name(p, offset, length)
        advance(p)
        advance(p)
        value := parse_expr(p)
        refuse_unbound_variant(p, value)
        // What the name binds is recorded for the rest of this parse, so an
        // argument at a call below it can be typed where it is written. It is
        // read the way the emitters read the same binding: the two tables name
        // one specialization between them, so an answer either gives alone
        // names a body the other never defines.
        settle_call_answer(p, value)
        record_parse_local(p, offset, length, binding_type(p, value), value)
        return new_let_node(p, value, offset, length, -1)
    }
    if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Colon) {
        offset := cur_off(p)
        length := cur_len(p)
        refuse_literal_name(p, offset, length)
        advance(p)
        ann := parse_type_annotation(p)
        advance(p)
        saved_expected := p.expected_type
        p.expected_type = ann
        value := parse_expr(p)
        p.expected_type = saved_expected
        record_parse_local(p, offset, length, ann, -1)
        return new_let_node(p, value, offset, length, ann)
    }

    // Otherwise the statement starts with a full expression. If `=` follows it is
    // an assignment to that place. Otherwise it is an expression statement (a
    // call). This is how `p.x = e`, `node^.next = e`, and `close(f)` are handled.
    if (can_begin_expression(kind) == false) {
        report_where(p.modules, p.src, cur_off(p))
        report("expected a statement, found '")
        report_src(p.src, cur_off(p), cur_len(p))
        report("'")
        frost_rt_recover_escape()
    }
    expr := parse_expr(p)
    if (cur(p) == TokenKind::Assign) {
        refuse_write_to_a_loop_name(p, expr)
        advance(p)
        // The place is the context the value is read in, the same way an
        // annotation is, so `phase = .Draining` names its enum by the place it
        // lands in and a struct literal leaves out its name there too.
        saved_expected := p.expected_type
        p.expected_type = assign_context(p, expr)
        value := parse_expr(p)
        p.expected_type = saved_expected
        return new_node_at(p, NodeKind::Assign, expr, value, 0, start)
    }
    // At the token the statement starts with, taken before the expression is
    // parsed. Reading it off the parser afterwards named the token past the
    // expression, so a diagnostic about the value a block answers with landed
    // on the closing brace.
    new_unary_at(p, NodeKind::ExprStmt, expr, start)
}

// Everything a `?` or a match queued while this statement was being parsed goes
// in ahead of it, in the order it was written. Each queued entry is a run of
// one or two statements, given by its first and last.
// A write to what a `for` names.
//
// The element binds the way a parameter of its type would, so a scalar is a
// copy of what the container holds and writing to it changes nothing. Both
// compilers took the write and emitted it, and the container came out of the
// loop as it went in. What the reader meant is a write to the element, which
// is the container and the index.
refuse_write_to_a_loop_name :: fn(mut p: Parser, place: i64) {
    node := arena_at(p.arena, place)
    if (node.kind != NodeKind::Var) {
        return
    }
    mut i: i64 = 0
    while (i < p.loop_names.count) {
        held := arena_at(p.loop_names, i)
        if (held.len == node.c
            && bytes_equal(p.src, held.off, node.val, node.c)) {
            report_where(p.modules, p.src, node.pos)
            report("'")
            report_src(p.src, node.val, node.c)
            report("' is what the loop names, and writing to it changes ")
            report("nothing: the element binds the way a parameter of its ")
            report("type would. Write to the container at the index, or bind ")
            report("what you want to keep before the loop")
            frost_rt_recover_escape()
        }
        i = i + 1
    }
}

flush_pending :: fn(mut p: Parser, mark: i64, statement: i64) -> i64 {
    mut head: i64 = -1
    mut tail: i64 = -1
    mut q := mark
    while (q < p.pending.count) {
        queued := arena_at(p.pending, q)
        first := queued.name_off
        last := queued.name_len
        if (head == (-1)) {
            head = first
        } else {
            set_next(p, tail, first)
        }
        if (first != last) {
            set_next(p, first, last)
        }
        tail = last
        q = q + 1
    }
    p.pending.count = mark
    if (head == (-1)) {
        return statement
    }
    if (statement != (-1)) {
        set_next(p, tail, statement)
    }
    head
}

set_while_preamble :: fn(mut p: Parser, loop: i64, preamble: i64) {
    node := arena_at(p.arena, loop)
    node.c = preamble
}

// The statement a match arm runs, with anything its own parse queued placed
// ahead of it rather than hoisted out of the arm.
parse_arm :: fn(mut p: Parser) -> i64 {
    // A brace after the colon opens a block, not a struct literal. An arm runs
    // statements far more often than it answers with an unnamed value, and an
    // arm that wants one names its type.
    if (cur(p) == TokenKind::Lbrace) {
        return parse_block(p)
    }
    // An arm answers with a value or runs a block. A statement written bare
    // after the colon is neither, and what it wants is the braces the block
    // form already has.
    if (cur(p) == TokenKind::KwReturn || cur(p) == TokenKind::KwBreak
        || cur(p) == TokenKind::KwContinue || at_arm_assignment(p)) {
        if (already_said(p, cur_off(p)) == false) {
            report_where(p.modules, p.src, cur_off(p))
            report("an arm of a `match` is an expression or a block, and this ")
            report("is a statement")
        }
        frost_rt_recover_escape()
    }
    mark := p.pending.count
    statement := parse_stmt(p)
    flush_pending(p, mark, statement)
}

// Whether an assignment stands where the cursor is: a name, whatever indices
// and fields follow it, and an `=` behind those.
at_arm_assignment :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    mut ahead: i64 = 1
    mut depth: i64 = 0
    while (peek_kind(p, ahead) != TokenKind::Eof) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Lbracket) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbracket) {
            depth = depth - 1
        } else if (depth == 0 && kind == TokenKind::Assign) {
            return true
        } else if (depth == 0 && kind != TokenKind::Dot
            && kind != TokenKind::Ident) {
            return false
        }
        ahead = ahead + 1
    }
    false
}

// Whether this fault has already been said at this place. A template's body is
// read once for the declaration and again for each instance, and a walk's body
// once per field, so one mistake reaches a reader once per reading.
already_said :: fn(mut p: Parser, at: i64) -> bool {
    if (p.said_at == at) {
        return true
    }
    p.said_at = at
    false
}

// A statement that opens with `-` where another statement came before it.
//
// `parse_add` carries an expression across a line break for `+` and refuses to
// for `-`, since a `-` that opens a line negates what follows rather than
// subtracting it from the line above. That rule is deliberate and closes a real
// hazard, but it leaves another: a long expression broken across lines keeps
// its terms when the break lands before a plus and drops them when it lands
// before a minus. Half a sum survives and the answer is wrong with nothing
// pointing at the line.
//
// So a statement opening with a minus is refused where it follows another one
// and is not the block's own value. What it would have done is negate something
// and drop it, which no program means; what it usually is, is the rest of the
// line above. A block ending in `-1` is untouched: that one is the value.
//
// Asked of the token rather than of what was parsed. A statement may flush
// synthesized ones around itself and those carry positions belonging to
// whatever they were desugared from, so the tokens are the only thing here that
// is certainly what the source says.
refuse_minus_continuation :: fn(mut p: Parser, at: i64) {
    report_where(p.modules, p.src, at)
    report("this line opens with '-', so it negates what follows rather than")
    report(" continuing the line above, and nothing reads what it works out.")
    report(" Two readings are open here and they are different programs: this")
    report(" line standing on its own as a negative value, and this line joined")
    report(" to the one above as a subtraction. A statement ends at the end of")
    report(" a line, so the first is what is written. Write the whole")
    report(" expression on one line, or leave the '-' at the end of the line")
    report(" above where it says a subtraction is meant")
    frost_rt_recover_escape()
}

// One statement of a block, run with an escape armed so a fault ends the
// statement rather than the declaration around it. The pending mark and the
// depths ride along, because an escape mid-statement leaves them where the
// fault found them and the loop has to put them back: a stale unsafe depth
// would swallow the unsafety faults of everything after it, and a stale
// expected type would type later literals against a context that is gone.
StmtTurn :: struct {
    parser: ^u8,
    mark: i64,
    depth: i64,
    unsafe_depth: i64,
    defer_depth: i64,
    expected_type: i64,
    statement: i64,
    // Where the statement began, for the same reason the declaration turn
    // carries it: a compile-time call reads a body elsewhere in the file, and
    // a fault leaves through the escape rather than through the return that
    // puts the cursor back.
    ti: i64,
}

parse_stmt_guarded :: fn(raw: ^u8) {
    turn := unsafe { ptr_cast($StmtTurn, raw) }
    parser := unsafe { ptr_cast($Parser, turn^.parser) }
    parsed := unsafe { parse_stmt(parser^) }
    statement := unsafe { flush_pending(parser^, turn^.mark, parsed) }
    unsafe { turn^.statement = statement }
}

// After a fault inside a block, skip to the next token that begins a
// statement, without crossing the token that closes the block. Always makes
// progress, so recovery cannot loop.
synchronize_statement :: fn(mut p: Parser, terminator: TokenKind, open: i64) {
    // Only the braces opened past the cursor are counted, so a statement that
    // failed while its own body was still unread is walked over whole. Left
    // uncounted, `for slot in live_slots(made()) { print(...) }` ended the walk
    // on the loop body's closing brace, which the statement list took for its
    // own: the function ended there and everything after it read as a
    // declaration, so one refusal was told twice and the second time wrongly.
    //
    // `open` is how many blocks the fault was found inside of, which the walk
    // has to come back out of before a closing brace means this statement's
    // own. A refusal reported inside `take(if (c) { .. })` left one open, and
    // the brace closing the `if` ended the function it was written in.
    mut depth: i64 = open
    if (cur(p) != terminator && cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lbrace) {
            depth = depth + 1
        }
        advance(p)
    }
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
            advance(p)
            continue
        }
        if (kind == TokenKind::Rbrace) {
            if (depth == 0) {
                return
            }
            depth = depth - 1
            advance(p)
            continue
        }
        // A run and an argument list are counted the way a block is. A
        // statement that failed with a bracket still open would otherwise be
        // resumed inside it, and the token that closes the run read as the
        // start of the next statement, so one fault was told twice: once
        // truly, and once about a bracket the reader had just been told about.
        if (kind == TokenKind::Lbracket || kind == TokenKind::Lparen) {
            depth = depth + 1
            advance(p)
            continue
        }
        // One with nothing open behind it closes a run the fault was found
        // inside, so it is walked over. Stopping on it would read the closer
        // as the start of the next statement, which is the fault this counting
        // is here to prevent.
        if (kind == TokenKind::Rbracket || kind == TokenKind::Rparen) {
            if (depth > 0) {
                depth = depth - 1
            }
            advance(p)
            continue
        }
        if (depth > 0) {
            advance(p)
            continue
        }
        if (kind == terminator) {
            return
        }
        if (kind == TokenKind::Semi) {
            return
        }
        if (kind == TokenKind::KwReturn || kind == TokenKind::KwIf
            || kind == TokenKind::KwWhile || kind == TokenKind::KwFor
            || kind == TokenKind::KwMatch || kind == TokenKind::KwDefer
            || kind == TokenKind::KwErrDefer
            || kind == TokenKind::KwBreak || kind == TokenKind::KwContinue
            || kind == TokenKind::KwMut
            || kind == TokenKind::KwRef
            || kind == TokenKind::KwWith) {
            return
        }
        if (kind == TokenKind::Ident
            && (peek_kind(p, 1) == TokenKind::Coloneq
                || peek_kind(p, 1) == TokenKind::Colon)) {
            return
        }
        advance(p)
    }
}

// The column the line holding an offset begins its text at. Read from the line
// rather than from the token, since a token's offset is where its text starts
// and a string literal's text starts after the quote.
column_at :: fn(src: str, off: i64) -> i64 {
    mut start := off
    while (start > 0 && src[start - 1] != CH_LF) {
        start = start - 1
    }
    mut first := start
    while (first < off
        && (src[first] == CH_SPACE || src[first] == CH_TAB)) {
        first = first + 1
    }
    first - start + 1
}

// The lookahead of the type in `name<T>(...)`, or -1 where what stands here is
// something else. The cursor is on the `<`.
//
// One type and no comma. `f(a < b, c > (d))` is two arguments, each an ordinary
// comparison, and reading the comma as a separator between type arguments is
// what makes this shape ambiguous in the languages that do take it. Without a
// comma there is nothing to lose: `(a < b) > (c)` weighs a truth value against
// a number, which no program this would refuse could have done anyway.
angled_call_argument :: fn(mut p: Parser) -> i64 {
    mut ahead: i64 = 1
    mut named: i64 = 0
    while (true) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Ident) {
            if (named == 1) {
                return -1
            }
            named = 1
        } else if (kind == TokenKind::Gt) {
            if (peek_kind(p, ahead + 1) == TokenKind::Lparen && named == 1) {
                return ahead
            }
            return -1
        } else if (kind != TokenKind::Caret && kind != TokenKind::Lbracket
            && kind != TokenKind::Rbracket && kind != TokenKind::Int) {
            return -1
        }
        ahead = ahead + 1
    }
    -1
}

// Whether a token joins the line it opens to the line above it. A `-` is not
// one: it opens a statement by negating what follows.
continues_an_expression :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Plus || kind == TokenKind::Star
        || kind == TokenKind::Slash || kind == TokenKind::Percent
        || kind == TokenKind::Andand || kind == TokenKind::Oror
        || kind == TokenKind::Pipe || kind == TokenKind::Amp
        || kind == TokenKind::Eqeq || kind == TokenKind::Ne
        || kind == TokenKind::Lt || kind == TokenKind::Le
        || kind == TokenKind::Gt || kind == TokenKind::Ge
        || kind == TokenKind::Shl || kind == TokenKind::Shr
        || kind == TokenKind::Dot)
}

parse_stmt_list :: fn(mut p: Parser, terminator: TokenKind) -> i64 {
    mut head: i64 = -1
    mut tail: i64 = -1
    // The column every statement of this block begins at, set by the first.
    mut block_column: i64 = 0
    // The brace this list opens after. A statement sharing its line is not
    // indented relative to anything.
    mut previous_at: i64 = 0
    if (p.ti > 0) {
        previous_at = arena_at(p.tokens, p.ti - 1).off
    }
    // A statement may end with a semicolon, which says nothing the line break
    // has not already said. It is a token rather than whitespace so that an
    // array repeat count can be told from an element.
    while (cur(p) == TokenKind::Semi) {
        advance(p)
    }
    while (cur(p) != terminator && cur(p) != TokenKind::Eof) {
        // Where this statement began, and whether it opened with a minus after
        // something else. Read before parsing, since parsing moves the cursor.
        // A line break ends a statement, so an operator that opens a line has
        // nothing above it to join to.
        if (continues_an_expression(cur(p))) {
            report_where(p.modules, p.src, cur_off(p))
            report("a line cannot open with '")
            report_src(p.src, cur_off(p), cur_len(p))
            report("': a line break ends a statement, so there is nothing above for it to join to. Put the operator at the end of the line above, or the whole expression inside brackets, where a line break says nothing")
            frost_rt_recover_note()
            synchronize_statement(p, terminator, 0)
            continue
        }
        opened_with_minus := head != (-1) && cur(p) == TokenKind::Minus
        minus_at := cur_off(p)
        // Every statement of a block begins at the same column. One indented
        // past its neighbours reads as a continuation of the line above, and a
        // continuation that parses as a statement of its own is an expression
        // that lost the operator joining it to that line.
        stmt_at := cur_off(p)
        // What the statement is about, which is the name a binding gives rather
        // than the word saying the binding is assignable. A report about an
        // instance the statement asked for is placed here, and `mut` is not
        // what the reader has to look at.
        p.stmt_at = stmt_at
        if (cur(p) == TokenKind::KwMut) {
            p.stmt_at = peek_off(p, 1)
        }
        if (block_column > 0 && breaks_between(p.src, previous_at, stmt_at)
            && column_at(p.src, stmt_at) > block_column
            && in_lifted(p, stmt_at) == false) {
            report_where(p.modules, p.src, stmt_at)
            report("this line is indented past the statement above it, so it reads as continuing that line, and it begins a statement of its own. An expression broken over lines carries the operator that joins them at the end of the first, or is written inside brackets")
            frost_rt_recover_note()
        }
        // A statement sharing the line the block opens on is not indented
        // relative to anything, so it sets no column for the rest to keep.
        if (block_column == 0 && breaks_between(p.src, previous_at, stmt_at)) {
            block_column = column_at(p.src, stmt_at)
        }
        previous_at = stmt_at
        mark := p.pending.count
        mut turn := StmtTurn {
            parser = unsafe { ptr_cast($u8, ptr_to(p)) },
            mark = mark,
            depth = p.block_depth,
            unsafe_depth = p.unsafe_depth,
            defer_depth = p.defer_depth,
            expected_type = p.expected_type,
            statement = -1,
            ti = p.ti
        }
        escaped := unsafe {
            frost_rt_recover_run(
                parse_stmt_guarded,
                ptr_cast($u8, ptr_to(turn))
            )
        }
        if (escaped == 1) {
            open := left_open(p, turn.ti, p.ti)
            p.pending.count = mark
            p.block_depth = turn.depth
            p.unsafe_depth = turn.unsafe_depth
            p.defer_depth = turn.defer_depth
            p.expected_type = turn.expected_type
            // Only ever forward, the way the declaration loop does it.
            if (p.ti < turn.ti) {
                p.ti = turn.ti
            }
            synchronize_statement(p, terminator, open)
            while (cur(p) == TokenKind::Semi) {
                advance(p)
            }
            continue
        }
        statement := turn.statement
        mut last := statement
        mut following := node_next(p, last)
        while (following != (-1)) {
            last = following
            following = node_next(p, last)
        }
        if (head == (-1)) {
            head = statement
        } else {
            set_next(p, tail, statement)
        }
        tail = last
        while (cur(p) == TokenKind::Semi) {
            advance(p)
        }
        // The terminator here means that statement was the block's value, and a
        // block whose value is `-1` is ordinary. Anything else after it means
        // the minus opened a statement whose answer nothing reads.
        if (opened_with_minus && cur(p) != terminator) {
            refuse_minus_continuation(p, minus_at)
        }
    }
    head
}

// What an `if` over a type predicate answers, or -1 when the condition is not
// one. The vocabulary is the `where` clause's, asked here of a value rather
// than of a type parameter, since inside an unrolled body the
// element's type is what there is to ask about.
//
// The cursor sits on the `(` of the condition. It is left where it was.
expansion_answer :: fn(mut p: Parser) -> i64 {
    // Only inside an instance. A template is read once with nothing bound, and
    // an ordinary function has no expansion time at all, so its `is_float(x)`
    // is a call to whatever it declared under that name.
    if (p.binding_active == 0 && p.pack_count == 0) {
        return -1
    }
    if (peek_kind(p, 1) != TokenKind::Lparen) {
        return -1
    }
    // `!is_linear(T)`, the other way a bound is written. The word after the
    // bang is read the same way and the answer is turned over.
    mut at: i64 = 2
    mut negate: bool = false
    if (peek_kind(p, at) == TokenKind::Bang) {
        negate = true
        at = at + 1
    }
    if (peek_kind(p, at) != TokenKind::Ident
        || peek_kind(p, at + 1) != TokenKind::Lparen
        || peek_kind(p, at + 2) != TokenKind::Ident
        || peek_kind(p, at + 3) != TokenKind::Rparen
        || peek_kind(p, at + 4) != TokenKind::Rparen) {
        return -1
    }
    name_off := peek_off(p, at)
    name_len := peek_len(p, at)
    if (is_type_predicate(p.src, name_off, name_len) == false) {
        return -1
    }
    subject_off, subject_len := alias_for(
        p,
        peek_off(p, at + 2),
        peek_len(p, at + 2)
    )
    mut ty := parse_param_type(p, subject_off, subject_len)
    if (ty < 0) {
        // The type argument this instance was made for, which is what a
        // `where` bound at the call asks about. The same question written in an
        // `if` had no answer, so one vocabulary read two ways depending on
        // which of the two positions it stood in.
        bound := binding_of(p, subject_off, subject_len)
        if (names_a_type_binding(bound) == false) {
            return -1
        }
        ty = bound
    }
    answer := predicate_holds(p, name_off, name_len, ty)
    if (answer < 0) {
        return -1
    }
    if (negate) {
        return 1 - answer
    }
    answer
}

// Whether the condition the cursor's `if` opens calls one of the type
// predicates, read off the tokens between its parentheses.
//
// A `$if` over one is answered where the body is expanded, and whether the
// answer is available at this reading is a question about which reading this
// is rather than about what the reader wrote.
condition_holds_a_predicate :: fn(mut p: Parser) -> bool {
    mut depth: i64 = 0
    mut ahead: i64 = 1
    while (true) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Eof) {
            return false
        }
        if (kind == TokenKind::Lparen) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen) {
            depth = depth - 1
            if (depth == 0) {
                return false
            }
        } else if (kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Lparen
            && is_type_predicate(
                p.src,
                peek_off(p, ahead),
                peek_len(p, ahead)
            )) {
            return true
        }
        ahead = ahead + 1
    }
    false
}

// Whether a compile-time binding holds a type, which is what a predicate has an
// answer for. The value, function-pointer and chosen-function ranges sit above
// the type codes and below the `distinct` ones, so a `distinct` type answers
// here the way the type it is represented by would.
names_a_type_binding :: fn(bound: i64) -> bool {
    bound >= 0 && (bound < CONST_BASE || bound >= DISTINCT_BASE)
}

// Whether this is a template being read with nothing bound to it. That parse is
// thrown away and done again per instance, where every compile-time question
// about a type has a real answer, so here a placeholder stands in rather than a
// diagnostic about a name that is about to mean something.
unbound_template :: fn(mut p: Parser) -> bool {
    p.saw_type_param == 1 && p.binding_active == 0
}

// A variant holds no one type, so a question about what it holds has nothing to
// read. Asked where a walk over an enum bound one, this says so and names the
// word that was written.
refuse_variant_question :: fn(
    mut p: Parser,
    held: i64,
    word_off: i64,
    word_len: i64
) {
    entry := arena_at(p.field_bindings, held)
    if (entry.is_variant == 0 || already_said(p, word_off)) {
        return
    }
    report_where(p.modules, p.src, word_off)
    report("'")
    report_src(p.src, entry.field_off, entry.field_len)
    report("' is a variant of an enum, so it is asked about with `name_of` ")
    report("and `offset_of`, and '")
    report_src(p.src, word_off, word_len)
    report("' reads a type")
    frost_rt_recover_escape()
}

// How many variants an enum has.
variant_count :: fn(mut p: Parser, ty: i64) -> i64 {
    mut counted: i64 = 0
    mut index: i64 = 0
    while (index < p.variants.count) {
        variant := arena_at(p.variants, index)
        if (variant.enum_ty == ty) {
            counted = counted + 1
        }
        index = index + 1
    }
    counted
}

// How many fields a type has, or zero for a type that is not a struct.
struct_field_count :: fn(mut p: Parser, ty: i64) -> i64 {
    if (is_struct_ty(ty) == false) {
        return 0
    }
    def := arena_at(p.structs, struct_index_of(ty))
    mut fid := def.field_head
    mut counted: i64 = 0
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        counted = counted + 1
        fid = field.next
    }
    counted
}

// Read the body of a `for` over a type's fields once per field, with the loop's
// name bound to that field, and answer the statements that came out. The cursor
// is on the body's `{`, and it is left past the body however many times it was
// read.
unroll_fields :: fn(
    mut p: Parser,
    item_off: i64,
    item_len: i64,
    walked: i64,
    walk_at: i64
) -> i64 {
    // An enum is laid out as a struct carrying the tag beside every variant's
    // fields, so its own fields are the compiler's layout rather than anything
    // the reader wrote. What a reader means by walking one is its variants, and
    // that is what it answers with.
    mut walks_a_struct := is_struct_ty(walked)
    mut walks_an_enum: bool = false
    if (walks_a_struct) {
        def := arena_at(p.structs, struct_index_of(walked))
        walks_an_enum = def.is_enum == 1
        walks_a_struct = def.is_enum == 0
    }
    if (walks_an_enum) {
        return unroll_variants(p, item_off, item_len, walked)
    }
    if (walks_a_struct == false) {
        // A template is read once with nothing bound, so the type parameter is
        // still a placeholder there and there is nothing to walk yet. That
        // parse is thrown away and done again per instance, where it is a real
        // type. Anything else with no fields is a mistake.
        if (walked == TY_PARAM) {
            parse_block(p)
            return nothing_statement(p)
        }
        if (already_said(p, walk_at) == false) {
            report_where(p.modules, p.src, walk_at)
            report("a `for` over `fields(T)` walks a struct's fields or an ")
            report("enum's variants, and this is neither")
        }
        frost_rt_recover_escape()
    }
    body_start := p.ti
    mut head: i64 = -1
    mut tail: i64 = -1
    def := arena_at(p.structs, struct_index_of(walked))
    packed := def.is_packed
    mut fid := def.field_head
    mut running: i64 = 0
    mut any: i64 = 0
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        field_ty := field.ty
        next_field := field.next
        running = align_up(
            running,
            field_align(p, packed, field.align, field_ty)
        )
        at := running
        running = running + type_size(p, field_ty)
        p.ti = body_start
        mark := p.field_bindings.count
        arena_push(
            p.field_bindings,
            WalkedField {
                name_off = item_off,
                name_len = item_len,
                field_off = field.name_off,
                field_len = field.name_len,
                ty = field_ty,
                at = at,
                is_variant = 0
            }
        )
        copy := parse_block(p)
        p.field_bindings.count = mark
        any = 1
        mut id := copy
        while (id != (-1)) {
            following := node_next(p, id)
            if (head == (-1)) {
                head = id
            } else {
                set_next(p, tail, id)
            }
            tail = id
            id = following
        }
        fid = next_field
    }
    if (any == 0) {
        p.ti = body_start
        parse_block(p)
        return nothing_statement(p)
    }
    if (head == (-1)) {
        return nothing_statement(p)
    }
    head
}

// Read the body of a `for` over an enum's variants once per variant, with the
// loop's name bound to that variant. A variant holds no one type, so its name
// and the number standing for it are the whole of what it answers.
unroll_variants :: fn(
    mut p: Parser,
    item_off: i64,
    item_len: i64,
    walked: i64
) -> i64 {
    body_start := p.ti
    mut head: i64 = -1
    mut tail: i64 = -1
    mut any: i64 = 0
    mut index: i64 = 0
    while (index < p.variants.count) {
        variant := arena_at(p.variants, index)
        if (variant.enum_ty == walked) {
            p.ti = body_start
            mark := p.field_bindings.count
            arena_push(
                p.field_bindings,
                WalkedField {
                    name_off = item_off,
                    name_len = item_len,
                    field_off = variant.name_off,
                    field_len = variant.name_len,
                    ty = TY_I64,
                    at = variant.tag,
                    is_variant = 1
                }
            )
            copy := parse_block(p)
            p.field_bindings.count = mark
            any = 1
            mut id := copy
            while (id != (-1)) {
                following := node_next(p, id)
                if (head == (-1)) {
                    head = id
                } else {
                    set_next(p, tail, id)
                }
                tail = id
                id = following
            }
        }
        index = index + 1
    }
    if (any == 0) {
        p.ti = body_start
        parse_block(p)
        return nothing_statement(p)
    }
    if (head == (-1)) {
        return nothing_statement(p)
    }
    head
}

// A statement that does nothing, for a compile-time branch that was not taken
// or a list that had no elements. Something has to stand where a statement was
// written, and this is what costs nothing to emit.
// A statement standing for nothing, which is what a compile-time walk over no
// fields leaves behind. Marked as the compiler's own, so the walk that reads a
// body's last statement as the value the function answers with passes over it:
// it stands where the reader wrote nothing.
nothing_statement :: fn(mut p: Parser) -> i64 {
    zero := new_node(p, NodeKind::Num, 0, 0, 0)
    made := new_unary(p, NodeKind::ExprStmt, zero)
    mut node := arena_at(p.arena, made)
    node.b = 2
    made
}

// Whether this function binds this name past `from`. Locals are recorded in
// declaration order and never popped, so everything past a mark is what was
// bound after the point that mark was taken.
bound_after :: fn(mut p: Parser, from: i64, off: i64, len: i64) -> bool {
    mut i := from
    while (i < p.parse_locals.count) {
        entry := arena_at(p.parse_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// A deferred statement is copied to each exit and its names are resolved there,
// so a name it mentions that is bound again below the `defer` reads as that
// later binding rather than the one in scope where the `defer` was written.
// Neither is what the line looks like, and one of them is a slot the path taken
// never wrote, so it is refused where it is written rather than given a meaning
// nobody would predict.
check_defer_shadowing :: fn(mut p: Parser) {
    mut k := p.defer_base
    while (k < p.defers.count) {
        site := arena_at(p.defers, k)
        start := site.name_off
        finish := site.name_len
        bound := site.ty
        mut t := start
        while (t < finish) {
            token := arena_at(p.tokens, t)
            kind := token.kind
            off := token.off
            len := token.len
            if (kind == TokenKind::Ident && bound_after(p, bound, off, len)) {
                report_where(p.modules, p.src, off)
                report("this name is bound again below the `defer` that mentions it, and a `defer` is copied to every exit, so the copy would read that binding rather than the one in scope here")
                frost_rt_recover_escape()
            }
            t = t + 1
        }
        k = k + 1
    }
}

// The statements this function put off, written out again where it leaves. Each
// was recorded as the token index of the statement after the keyword, so a copy
// is made by reading those tokens once more rather than by copying nodes, which
// is the road a compile-time `for` already takes over its body. The last one
// deferred is the first one run, so the walk goes back down the list.
defer_copies :: fn(mut p: Parser, failing: i64) -> i64 {
    saved := p.ti
    mut head: i64 = -1
    mut k := p.defers.count
    while (k > p.defer_base) {
        k = k - 1
        site := arena_at(p.defers, k)
        // One that answers only to a failure is passed over at every other
        // exit, which is the whole of what tells the two apart.
        if (site.slot == 1 && failing == 0) {
            continue
        }
        p.ti = site.name_off
        head = append_node(p, head, parse_stmt(p))
    }
    p.ti = saved
    head
}

// A `return`, with whatever was deferred run in front of it. The value is worked
// out first and bound to a name, because a deferred statement runs after the
// answer is settled and must not be able to change what is handed back.
defer_before_return :: fn(
    mut p: Parser,
    value: i64,
    start: i64,
    failing: i64
) -> i64 {
    if (p.defers.count <= p.defer_base) {
        return new_node_at(p, NodeKind::Return, value, 0, 0, start)
    }
    mut head: i64 = -1
    mut answer := value
    if (value != (-1)) {
        name_off := synth_numbered(p, "__defer", p.defer_count)
        name_len := 7 + digits_in(p.defer_count)
        p.defer_count = p.defer_count + 1
        head = new_let_node(p, value, name_off, name_len, -1)
        answer = new_named_node_at(
            p,
            NodeKind::Var,
            0,
            name_off,
            name_len,
            name_off
        )
    }
    head = append_node(p, head, defer_copies(p, failing))
    append_node(p, head, new_node_at(p, NodeKind::Return, answer, 0, 0, start))
}

// The body of a function that deferred something, with the copies put where it
// falls off the end. A body ending in a `return` already has them, since the
// `return` carried its own. A body whose last statement is the value it answers
// with binds that value first, so the deferred statements run between working
// the answer out and handing it back, which is the order a `return` gets.
defer_trailing :: fn(mut p: Parser, body: i64, ret: i64) -> i64 {
    if (p.defers.count <= p.defer_base || body == (-1)) {
        return body
    }
    mut previous: i64 = -1
    mut last := body
    mut following := node_next(p, last)
    while (following != (-1)) {
        previous = last
        last = following
        following = node_next(p, last)
    }
    node := arena_at(p.arena, last)
    if (node.kind == NodeKind::Return) {
        return body
    }
    // An `if` whose branches both answer has already run them, one copy per
    // branch, and nothing reaches past it. Appending here would put the copies
    // after a statement that always returns and take the answer with them.
    if (node.kind == NodeKind::If && block_returns(p, node.b)
        && block_returns(p, node.val)) {
        return body
    }
    if (node.kind != NodeKind::ExprStmt || ret == TY_VOID) {
        return append_node(p, body, defer_copies(p, 0))
    }
    value := node.a
    at := node.pos
    name_off := synth_numbered(p, "__defer", p.defer_count)
    name_len := 7 + digits_in(p.defer_count)
    p.defer_count = p.defer_count + 1
    bind := new_let_node(p, value, name_off, name_len, -1)
    reader := new_named_node_at(
        p,
        NodeKind::Var,
        0,
        name_off,
        name_len,
        name_off
    )
    mut tail := append_node(p, bind, defer_copies(p, 0))
    tail = append_node(p, tail, new_unary_at(p, NodeKind::ExprStmt, reader, at))
    if (previous == (-1)) {
        return tail
    }
    set_next(p, previous, tail)
    body
}

// Whether a name is the compile-time list this instance bound. A template being
// read with nothing bound answers false, since there is no list there yet.
names_pack :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (p.pack_len > 0 && p.pack_len == len
        && bytes_equal(p.src, p.pack_off, off, len))
}

// Read the body of a compile-time `for` once per element, with the loop's name
// bound to that element, and answer the statements that came out. The cursor is
// on the body's `{`, and it is left past the body however many times it was
// read. An empty list reads the body once and keeps none of it, which is what
// makes the tokens get consumed either way.
unroll_pack :: fn(mut p: Parser, item_off: i64, item_len: i64) -> i64 {
    body_start := p.ti
    mut head: i64 = -1
    mut tail: i64 = -1
    mut k: i64 = 0
    while (k < p.pack_count) {
        p.ti = body_start
        element := arena_at(p.gargs, p.pack_start + k)
        element_ty := element.value
        element_is_type := element.is_type
        // A value element is a parameter of this instance, so the loop's name
        // is read as that parameter's name. A type element is not a value at
        // all: the loop's name is a type, so it goes in the type-alias table
        // for this one copy of the body.
        mut mark: i64 = p.aliases.count
        mut type_mark: i64 = p.type_aliases.count
        if (element.const_len > 0) {
            // A record constant is written into the body under its own name, so
            // the loop's name stands for the constant rather than for a
            // parameter holding a copy of it. A field read is then read off a
            // constant, and a call through a field that names a function is a
            // call to that function.
            mark = push_alias(
                p,
                item_off,
                item_len,
                element.const_off,
                element.const_len
            )
        } else if (element_is_type == 1 && is_fn_arg(element_ty)) {
            // A function element is written into the body under its own name,
            // the way a record constant is. The loop's name then stands for the
            // function rather than for a type, so a call on it is a call to
            // that function: a call names the function it goes to, and this is
            // the name it goes to.
            named := arena_at(p.fns, element_ty - FN_BASE)
            mark = push_alias(p, item_off, item_len, named.off, named.len)
        } else if (element_is_type == 1) {
            arena_push(
                p.type_aliases,
                ConstDef {
                    name_off = item_off,
                    name_len = item_len,
                    value = element_ty,
                    kind = CONST_INT,
                    count = 0
                }
            )
        } else {
            name_off, name_len := pack_element_name(
                p,
                p.pack_off,
                p.pack_len,
                k
            )
            mark = push_alias(p, item_off, item_len, name_off, name_len)
        }
        copy := parse_block(p)
        p.aliases.count = mark
        p.type_aliases.count = type_mark
        mut id := copy
        while (id != (-1)) {
            following := node_next(p, id)
            if (head == (-1)) {
                head = id
            } else {
                set_next(p, tail, id)
            }
            tail = id
            id = following
        }
        k = k + 1
    }
    if (p.pack_count == 0) {
        // Nothing runs, and the body is read once anyway to leave the cursor
        // past it. What that read builds is thrown away, so a call written
        // through the loop's name names no function in it and never will.
        p.ti = body_start
        held_none := p.unbound_pack_for
        p.unbound_pack_for = 1
        parse_block(p)
        p.unbound_pack_for = held_none
        return nothing_statement(p)
    }
    if (head == (-1)) {
        return nothing_statement(p)
    }
    head
}

// Read an `if` whose condition this pass answered: keep the branch that runs,
// and read past the one that does not without keeping any of it.
parse_expansion_if :: fn(mut p: Parser, taken: i64) -> i64 {
    // `if`, then the whole parenthesised condition however it was written, so
    // a bang in front of the predicate is walked over with the rest of it.
    advance(p)
    advance(p)
    mut depth: i64 = 1
    while (depth > 0 && cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lparen) {
            depth = depth + 1
        } else if (cur(p) == TokenKind::Rparen) {
            depth = depth - 1
        }
        advance(p)
    }
    kept := parse_block(p)
    mut other: i64 = -1
    if (cur(p) == TokenKind::KwElse) {
        advance(p)
        // `else if` continues the chain, and the next `if` is read the way this
        // one was: a predicate over the same element is answered here too, and
        // a condition that is not one is the ordinary runtime `if`. Reading it
        // is what moves the cursor past a branch this element does not take.
        if (cur(p) == TokenKind::KwIf
            || (cur(p) == TokenKind::Dollar
                && peek_kind(p, 1) == TokenKind::KwIf)) {
            other = parse_stmt(p)
        } else {
            other = parse_block(p)
        }
    }
    if (taken == 1) {
        if (kept == (-1)) {
            return nothing_statement(p)
        }
        return kept
    }
    if (other == (-1)) {
        return nothing_statement(p)
    }
    other
}

parse_params :: fn(mut p: Parser) -> i64 {
    mut head: i64 = -1
    mut tail: i64 = -1
    // How many ordinary parameters have been read, which is what says where a
    // compile-time list starts taking arguments at a call.
    mut fixed: i64 = 0
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        // A parameter list holds parameters and the commas between them, so a
        // token that begins neither is a list the reader did not close. Read
        // on, `fn(a: i64 { a }` took the brace for a parameter's name and the
        // one closing the body for its type, and every declaration below it
        // was read as more of this one.
        if (cur(p) != TokenKind::Ident && cur(p) != TokenKind::KwMut
            && cur(p) != TokenKind::KwMove
            && cur(p) != TokenKind::Dollar) {
            report_where(p.modules, p.src, cur_off(p))
            report("Expected a parameter name in parameter list, found '")
            report_src(p.src, cur_off(p), cur_len(p))
            report("'")
            frost_rt_recover_escape()
        }
        // Capture the parameter mode. `mut` (write) is 1, `move` is 2, and an
        // unmarked read is 0.
        mut mode: i64 = 0
        if (cur(p) == TokenKind::KwMut) {
            mode = 1
            advance(p)
        }
        if (cur(p) == TokenKind::KwMove) {
            mode = 2
            advance(p)
        }
        // `value` on an `extern` parameter says the struct crosses to C the way
        // C passes one, split across registers or pushed on the stack by the
        // target's rule rather than handed over as an address. It is a word
        // rather than a keyword, so a parameter may still be called `value`;
        // what tells them apart is that a mode is followed by the name and a
        // name is followed by its type.
        mut by_value: i64 = 0
        if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Ident
            && str_range_eq(p.src, cur_off(p), cur_len(p), "value")) {
            by_value = 1
            advance(p)
        }
        // `format fmt: str` says the argument written here is a string literal
        // and that its holes are counted against the compile-time list the
        // parameter list ends with. A word rather than a keyword, so a
        // parameter may still be called `format`.
        if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Ident
            && str_range_eq(p.src, cur_off(p), cur_len(p), "format")) {
            p.decl_pack_format = fixed
            advance(p)
            p.decl_format_off = cur_off(p)
            p.decl_format_len = cur_len(p)
        }
        // `args: $...` is a compile-time list rather than a value: each call
        // has its own count and its own types. The template reads no parameter
        // for it, and an instance reads one per element the call gave, each
        // with that argument's type, so an element is a name the body can use
        // and a value the call evaluates once.
        if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Colon
            && peek_kind(p, 2) == TokenKind::Dollar
            && peek_kind(p, 3) == TokenKind::Dot
            && peek_kind(p, 4) == TokenKind::Dot
            && peek_kind(p, 5) == TokenKind::Dot) {
            pack_off := cur_off(p)
            pack_len := cur_len(p)
            advance(p)
            advance(p)
            advance(p)
            advance(p)
            advance(p)
            advance(p)
            p.decl_pack_off = pack_off
            p.decl_pack_len = pack_len
            p.decl_pack_fixed = fixed
            p.saw_type_param = 1
            mut k: i64 = 0
            while (k < p.pack_count) {
                element := arena_at(p.gargs, p.pack_start + k)
                element_ty := element.value
                // A type element takes no parameter. It is a name the body
                // writes where a type belongs, and nothing arrives for it.
                if (element.is_type == 0) {
                    name_off, name_len := pack_element_name(
                        p,
                        pack_off,
                        pack_len,
                        k
                    )
                    held := arena_push(
                        p.arena,
                        Node {
                            kind = NodeKind::Param,
                            a = 0,
                            b = element_ty,
                            c = name_len,
                            val = name_off,
                            next = -1,
                            pos = pack_off
                        },
                    )
                    record_parse_local(p, name_off, name_len, element_ty, -1)
                    // An element of a compile-time list is written `$...` and
                    // stands for whatever the call handed over, so its node
                    // holds the last call's type the way a `$T` parameter does
                    // and the same substitution puts the right one back. It is
                    // recorded here because nothing parsed a type for it: the
                    // list's elements are synthesized from what the call gave.
                    arena_push(
                        p.template_params,
                        LocalVar {
                            name_off = held,
                            name_len = 0,
                            ty = 0,
                            slot = 0
                        }
                    )
                    if (head == (-1)) {
                        head = held
                        tail = held
                    } else {
                        set_next(p, tail, held)
                        tail = held
                    }
                }
                k = k + 1
            }
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        } else if (cur(p) == TokenKind::Dollar) {
            advance(p)
            poff := cur_off(p)
            plen := cur_len(p)
            refuse_literal_name(p, poff, plen)
            advance(p)
            primary := record_gparam(p, poff, plen, kind_is_value(p), -1)
            // A bundle parameter binds to a name whether or not the body ever
            // names it, so it is marked here rather than by being used.
            if (kind_is_bundle(p) == 1) {
                note_called_name(p, poff, plen)
            }
            mut declared := parse_type_annotation(p)
            // A parameter declared to take a function is one whether or not
            // this body calls it. Handing it on to another generic is as much
            // a use as calling it, and a body that only handed it on left the
            // declaration reading as a type parameter, so no instance was made
            // and the call linked to a name nothing defined.
            if (declared >= 0 && is_proc(declared)) {
                note_called_name(p, poff, plen)
            }
            note_fallback(p, primary, parse_fallback(p))
            // An instance re-parses the declaration with its arguments bound,
            // so the same parameter is written down again under the types this
            // one was given. Only the declaration's own reading is kept, since
            // the walks that ask are the ones that walk the declaration, and
            // holding both would leave the name standing for two types.
            if (p.binding_active == 1) {
                declared = -1
            }
            // A compile-time parameter given a function is called by name in
            // the body, and nothing declares that name. Every one of them is
            // remembered rather than only those written `fn(..)`, since the
            // kind after the colon does not decide what binds to it. A name
            // that turns out to stand for a type is never called, so nothing
            // is lost by holding it here.
            arena_push(
                p.cfn_params,
                GParam {
                    name_off = poff,
                    name_len = plen,
                    is_value = 0,
                    is_fn = 1,
                    ty = declared,
                    fallback = -1,
                    owner_off = p.params_owner_off
                }
            )
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        } else {
            offset := cur_off(p)
            length := cur_len(p)
            refuse_literal_name(p, offset, length)
            advance(p)
            mut ty := parse_type_annotation(p)
            // Whether it was written as the template's own parameter, held
            // before the borrow flag goes on and before anything else reads a
            // type. What the node records is a type, and the move walk needs to
            // know which spelling put it there.
            wrote_param := p.last_type_was_param
            // A mode borrow of a value is passed by pointer, and the call site
            // takes its address automatically (auto_borrow = 1). `mut` always
            // borrows. An unmarked read borrows a struct or generic instance and
            // passes a scalar by value. An already pointer-typed annotation
            // (a raw pointer) or a `move` stays as written.
            // A `value` parameter is only about placement, so it borrows here
            // the way an unmarked aggregate does and the type it was written
            // with is remembered before the borrow flag goes on.
            if (by_value == 1 && is_aggregate(ty) == false) {
                report_where(p.modules, p.src, offset)
                report("only an aggregate can be written 'value'; a scalar already goes to C by value")
                frost_rt_recover_escape()
            }
            mut auto_borrow: i64 = 0
            if (is_pointer(ty) == false) {
                if (mode == 1) {
                    auto_borrow = 1
                }
                if (by_value == 1) {
                    auto_borrow = 1
                }
                if (mode == 0 && is_aggregate(ty)) {
                    auto_borrow = 1
                }
                if (mode == 0 && p.last_type_was_generic == 1) {
                    auto_borrow = 1
                }
            }
            if (auto_borrow == 1) {
                ty = borrow_of(p, ty)
            }
            // A `move` parameter takes the value itself however wide it is, and
            // is marked so, since whether a read parameter borrows depends on
            // the type it was given and a `move` never does.
            if (mode == 2) {
                auto_borrow = 2
            }
            param := arena_push(
                p.arena,
                Node {
                    kind = NodeKind::Param,
                    a = auto_borrow,
                    b = ty,
                    c = length,
                    val = offset,
                    next = -1,
                    pos = cur_off(p)
                },
            )
            if (wrote_param == 1) {
                arena_push(
                    p.template_params,
                    LocalVar {
                        name_off = param,
                        name_len = 0,
                        ty = 0,
                        slot = 0
                    }
                )
            }
            // A `mut` parameter borrows exclusively. Record it so the exclusivity
            // check can tell it from a shared read of an aggregate, which the
            // auto-borrow flag alone cannot.
            if (mode == 1) {
                arena_push(
                    p.mut_params,
                    LocalVar {
                        name_off = param,
                        name_len = 0,
                        ty = 0,
                        slot = 0
                    }
                )
            }
            if (by_value == 1) {
                arena_push(
                    p.value_params,
                    LocalVar {
                        name_off = param,
                        name_len = 0,
                        ty = 0,
                        slot = 0
                    }
                )
            }
            // What a name binds is recorded for the parse too, so an argument
            // at a call in this body can be typed where it is written.
            record_parse_local(p, offset, length, ty, -1)
            fixed = fixed + 1
            if (head == (-1)) {
                head = param
                tail = param
            } else {
                set_next(p, tail, param)
                tail = param
            }
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
    }
    advance(p)
    head
}

// A definition is `name :: fn(params) -> ret { body }`. The name, `::`, and `fn`
// are consumed here. An optional `-> type` return annotation is parsed and
// discarded (every function still lowers to an int64_t C function).
parse_function :: fn(mut p: Parser) -> i64 {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    advance(p)
    advance(p)
    parse_function_named(p, name_offset, name_length)
}

// The same, for a function whose name is not in the source: a function written
// where it is used has one made for it. The cursor is on the `fn`, which is
// where reading a declaration's name leaves it.
parse_function_named :: fn(
    mut p: Parser,
    name_offset: i64,
    name_length: i64
) -> i64 {
    // What this function's names bind is recorded as it is parsed and dropped
    // when the parse is done, so the table holds one function's worth rather
    // than the program's and a later pass starts from nothing.
    locals_mark := p.parse_locals.count
    saved_param_start := p.parse_param_start
    saved_param_end := p.parse_param_end
    // `name :: inline fn(...)` marks a function the C backend forces inline. The
    // keyword sits between the `::` and the `fn`, so it is consumed here before
    // the `fn` is stepped over like any other declaration.
    mut wants_inline: i64 = 0
    if (cur(p) == TokenKind::KwInline) {
        wants_inline = 1
        advance(p)
    }
    // A function written where it is used may be spelled with the `(` alone.
    // There is no `fn` to step over then, and the parameters start here.
    if (cur(p) == TokenKind::KwFn) {
        advance(p)
    }
    check_name_is_free(p, name_offset, name_length)
    fn_index := intern_global(p, name_offset, name_length)
    if (wants_inline == 1) {
        mark_inline(p, fn_index)
    }
    mut is_main: i64 = 0
    if (is_main_name(p.src, name_offset, name_length)) {
        is_main = 1
    }
    advance(p)
    p.params_owner_off = name_offset
    mut params := parse_params(p)
    p.parse_param_start = locals_mark
    p.parse_param_end = p.parse_locals.count
    set_params(p, fn_index, params)
    mark_defined(p, fn_index)
    mut ret: i64 = TY_VOID
    p.multi_ty = -1
    p.multi_count = 0
    // `-> (i64, i64)` is a return type list: several values from one call,
    // standing for the struct `synth_multi_struct` makes for it.
    if (cur(p) == TokenKind::Arrow) {
        advance(p)
        if (cur(p) == TokenKind::Lparen) {
            list_at := cur_off(p)
            advance(p)
            ret = synth_multi_struct(p, list_at)
            p.multi_ty = ret
        } else {
            ret = parse_type(p)
        }
    }
    // `-> T ! E` answers with a T or fails with an E. The function's real
    // return type is the struct standing for the pair, so everything after this
    // handles an ordinary struct return.
    mut failure: i64 = -1
    // What the function answers with, before a failure set wraps it. A `return`
    // is parsed under this, so a `.Variant` there names a variant of it or of
    // the failure set beside it.
    p.ok_ty = ret
    if (cur(p) == TokenKind::Bang) {
        if (tokens_touch(p, p.ti - 1) || tokens_touch(p, p.ti)) {
            report_where(p.modules, p.src, cur_off(p))
            report("a `!` against what follows it negates, and this one marks a failure set; write `-> T ! E`, with a space on both sides")
            frost_rt_recover_note()
        }
        advance(p)
        failure = parse_type(p)
        ret = synth_result_struct(p, ret, failure)
    }
    p.result_ty = ret
    p.failure_ty = failure
    p.result_fn = fn_index
    if (failure == (-1)) {
        p.result_ty = -1
    }
    p.last_return_type = ret
    set_ret_type(p, fn_index, ret)
    // `-> T uses A` draws an allocation capability. It is an implicit trailing
    // parameter that borrows the source, so after this the function is ordinary
    // and only the call sites need to know to supply it.
    // `uses A, B` draws more than one source. Each becomes an implicit
    // parameter its body reaches by the type's own name lowercased, in the
    // order they were written, and a call supplies one argument for each.
    if (cur(p) == TokenKind::KwUses) {
        advance(p)
        mut reading: i64 = 1
        while (reading == 1) {
            cap_name_off := cur_off(p)
            cap_name_len := cur_len(p)
            cap_ty := parse_type(p)
            binding := synth_capability_name(p, cap_name_off, cap_name_len)
            held_ty := borrow_of(p, cap_ty)
            capability := arena_push(
                p.arena,
                Node {
                    kind = NodeKind::Param,
                    a = 1,
                    b = held_ty,
                    c = cap_name_len,
                    val = binding,
                    next = -1,
                    pos = cur_off(p)
                },
            )
            // What the name binds is recorded for the parse, the way an
            // ordinary parameter's is. A generic one of whose compile-time
            // parameters a value parameter settles reads its tuple off the
            // types of its arguments, and only the parse holds them: without
            // this, `bump_carve($i64, bump, n)` under `uses Bump<1024>` filed a
            // tuple with the settled `N` missing while the call emitted the
            // whole one, so the instance was called and never defined.
            record_parse_local(p, binding, cap_name_len, held_ty, -1)
            params = append_node(p, params, capability)
            set_params(p, fn_index, params)
            set_uses(p, fn_index, cap_ty, binding, cap_name_len)
            reading = 0
            if (cur(p) == TokenKind::Comma) {
                advance(p)
                reading = 1
            }
        }
    }
    // `where is_numeric(T)` holds the generic to what its body needs. It is
    // skipped here and read again at each call with that call's arguments
    // bound, since what it asks about is the arguments rather than the body.
    p.bound_token = -1
    if (cur(p) == TokenKind::KwWhere) {
        advance(p)
        p.bound_token = p.ti
        while (cur(p) != TokenKind::Lbrace && cur(p) != TokenKind::Eof) {
            // `else "..."` is what the declaration says when the bound does not
            // hold. One string, so what a reader is told is settled where the
            // bound is written rather than worked out at the call.
            if (cur(p) == TokenKind::KwElse) {
                advance(p)
                if (cur(p) != TokenKind::Str) {
                    report_where(p.modules, p.src, p.ti)
                    report("`where ... else` is followed by one string, ")
                    report("which is what the reader is told")
                    frost_rt_recover_escape()
                }
            }
            advance(p)
        }
    }
    // A function literal inside this one defers on its own account, so the list
    // is marked here and cut back to the mark when the body is done, and the
    // depth a `defer` is allowed at is this body's own.
    saved_defer_base := p.defer_base
    saved_defer_depth := p.defer_depth
    p.defer_base = p.defers.count
    p.defer_depth = p.block_depth + 1
    // What the function answers with, held across the body: a function literal
    // written inside this one reads a signature of its own and leaves `ok_ty`
    // naming that one.
    answer_ty := p.ok_ty
    mut body := parse_block(p)
    check_defer_shadowing(p)
    settle_trailing_literal(p, body, answer_ty)
    if (p.result_ty != (-1)) {
        wrap_trailing_ok(p, body)
    }
    // A body's last expression is its answer, so it is marked as one and held
    // to what a written `return` is held to. Without the mark the type walk
    // sees a statement like any other, and a function could answer with a
    // distinct type by writing its representation and leaving `return` off.
    mark_trailing_answer(p, body, ret)
    // The branches of an answering `if` become returns first, so each carries
    // what was deferred the way a written `return` does. Afterwards there is
    // nothing left for the trailing walk to put copies in front of.
    return_trailing_branches(p, body, ret)
    body = defer_trailing(p, body, ret)
    p.defers.count = p.defer_base
    p.defer_base = saved_defer_base
    p.defer_depth = saved_defer_depth
    made := new_func_node(p, body, params, fn_index, is_main)
    p.parse_locals.count = locals_mark
    p.parse_local_values.count = locals_mark
    p.parse_param_start = saved_param_start
    p.parse_param_end = saved_param_end
    made
}

// A struct definition. A plain `name :: struct { ... }` parses its fields now. A
// generic `name :: struct($T: Type) { ... }` records its type parameter and the
// token index of its `{`, then skips the body. Each instantiation re-parses the
// fields with the parameter bound.
parse_struct :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    check_name_is_free(p, name_offset, name_length)
    entry_index := predeclared_index(p, name_offset, name_length)
    advance(p)
    advance(p)
    // `Name :: linear struct { ... }` marks a resource that must be consumed
    // exactly once, so the keyword sits between `::` and `struct`.
    mut linear_flag: i64 = 0
    if (cur(p) == TokenKind::KwLinear) {
        linear_flag = 1
        advance(p)
    }
    // `Name :: packed struct { ... }` puts every field at the next byte. The
    // word is not a keyword, so a local, a field and a parameter may all still
    // be called `packed`; the `struct` after it is what marks the declaration.
    mut packed_flag: i64 = 0
    if (at_packed_struct(p, 0)) {
        packed_flag = 1
        advance(p)
    }
    advance(p)
    if (cur(p) == TokenKind::Lparen) {
        advance(p)
        // Collect every parameter. A parameter is a type parameter or a value
        // one by what binds to it, not by how it is declared, so the kind after
        // the colon is parsed and dropped. The first fills the primary slot the
        // single-parameter path already uses. The rest form this struct's run in
        // the shared `gparams` arena.
        p.type_param_len = 0
        p.xparam_count = 0
        p.xparam_start = p.gparams.count
        while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
            advance(p)
            poff := cur_off(p)
            plen := cur_len(p)
            refuse_literal_name(p, poff, plen)
            advance(p)
            primary := record_gparam(p, poff, plen, kind_is_value(p), -1)
            parse_type_annotation(p)
            note_fallback(p, primary, parse_fallback(p))
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        advance(p)
        tparam_off := p.type_param_off
        tparam_len := p.type_param_len
        tparam_fallback := p.tparam_fallback
        xparam_start := p.xparam_start
        xparam_count := p.xparam_count
        refuse_field_sigils(p)
        field_token := p.ti
        mut brace_depth: i64 = 0
        mut started: i64 = 0
        while (started == 0 || brace_depth > 0) {
            if (cur(p) == TokenKind::Lbrace) {
                brace_depth = brace_depth + 1
                started = 1
            }
            if (cur(p) == TokenKind::Rbrace) {
                brace_depth = brace_depth - 1
            }
            advance(p)
        }
        record_struct(
            p,
            entry_index,
            StructDef {
                name_off = name_offset,
                name_len = name_length,
                field_head = -1,
                is_generic = 1,
                tparam_off = tparam_off,
                tparam_len = tparam_len,
                field_token = field_token,
                instance_id = -1,
                is_linear = linear_flag,
                emitted = 0,
                xparam_start = xparam_start,
                xparam_count = xparam_count,
                tparam_fallback = tparam_fallback,
                is_enum = 0,
                declared = 1,
                is_multi = 0,
                is_result = 0,
                is_packed = packed_flag
            }
        )
        refuse_generic_values_block(p, name_offset, name_length)
        read_template_fields(p, field_token, packed_flag)
    } else {
        refuse_field_sigils(p)
        head := parse_struct_fields(p, packed_flag)
        record_struct(
            p,
            entry_index,
            StructDef {
                name_off = name_offset,
                name_len = name_length,
                field_head = head,
                is_generic = 0,
                tparam_off = 0,
                tparam_len = 0,
                field_token = 0,
                instance_id = -1,
                is_linear = holds_linear(p, head, linear_flag),
                emitted = 0,
                xparam_start = 0,
                xparam_count = 0,
                tparam_fallback = -1,
                is_enum = 0,
                declared = 1,
                is_multi = 0,
                is_result = 0,
                is_packed = packed_flag
            }
        )
        read_values_block(
            p,
            STRUCT_BASE + struct_index_for(p, entry_index),
            name_offset,
            name_length,
            -1
        )
    }
}

// Where in the struct table the declaration just recorded sits: the slot it was
// predeclared into, or the one it was appended to.
struct_index_for :: fn(mut p: Parser, entry_index: i64) -> i64 {
    if (entry_index >= 0) {
        return entry_index
    }
    p.structs.count - 1
}

// Whether a struct has to be consumed: it was written `linear`, or it holds a
// value that was. A struct holding a resource is a resource, otherwise wrapping
// one in an ordinary struct would launder the obligation away. A field's type is
// resolved by the time its struct is recorded, so this is a walk of the fields
// and nothing more.
holds_linear :: fn(mut p: Parser, field_head: i64, declared: i64) -> i64 {
    if (declared == 1) {
        return 1
    }
    mut id := field_head
    while (id != (-1)) {
        field := arena_at(p.fields, id)
        if (is_linear_type(p, field.ty)) {
            return 1
        }
        id = field.next
    }
    0
}

// ---------------------------------------------------------------------------
// Enums. `Kind :: enum { Player, Enemy { damage: i64 } }` is a struct carrying
// a tag beside every variant's fields, each field named for the variant it came
// from. A variant is then a tag value and a set of field names rather than a
// type of its own, which is why construction, field access and matching all
// reduce to what the compiler already does with structs and integers.
//
// The tag says which variant is live, so no two variants are ever readable at
// once and they are laid at the same offset: an enum is its tag plus its widest
// variant. The C backend writes that as one anonymous union holding an
// anonymous struct per variant, which keeps every field reachable by the flat
// name it was declared under. The bootstrap reaches the same number by its own
// route, and `an_enum_is_the_same_width_under_both_compilers` holds them to it.
// ---------------------------------------------------------------------------

// The variant of `enum_ty` with this name, or -1. A pattern written `.Circle`
// names no enum, so a variant is found by its own name. Two enums that each
// carry a variant of the same name are told apart by the scrutinee's type when
// there is one.
// The type a name stands for, or -1 where it stands for something else. Asked
// where a `.` follows a name, so nothing is reported: a name that is no type at
// all is a different fault and is already said elsewhere.
type_named :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.is_generic == 0 && entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)
            && name_visible(p, entry.name_off, entry.name_len, off)) {
            return STRUCT_BASE + i
        }
        i = i + 1
    }
    -1
}

find_variant :: fn(mut p: Parser, enum_ty: i64, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.variants.count) {
        entry := arena_at(p.variants, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            if (enum_ty == (-1) || entry.enum_ty == enum_ty) {
                return i
            }
        }
        i = i + 1
    }
    -1
}

// `Name :: enum { A, B { x: i64 } }`. The fields of every variant are laid out
// in one struct behind a tag, each under the name of the variant it came from.
// Parse an enum body, the `{ Variant, Variant { field: T } }` after the name,
// with the cursor on the opening brace. Returns the head of the field chain: a
// tag field followed by every variant's fields, each named for the variant it
// came from. The variants are recorded against `enum_ty`, so an instance parses
// its own variants under its own type.
parse_enum_body :: fn(mut p: Parser, enum_ty: i64) -> i64 {
    advance(p)
    result_field_names(p)
    tag_field := arena_push(
        p.fields,
        StructField {
            name_off = p.name_tag,
            name_len = 3,
            ty = TY_I32,
            next = -1,
            variant = -1,
            align = 0
        },
    )
    mut tail := tag_field
    mut tag: i64 = 0
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        variant_off := cur_off(p)
        variant_len := cur_len(p)
        advance(p)
        arena_push(
            p.variants,
            Variant {
                enum_ty = enum_ty,
                name_off = variant_off,
                name_len = variant_len,
                tag = tag
            },
        )
        if (cur(p) == TokenKind::Lbrace) {
            advance(p)
            while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
                field_off := cur_off(p)
                field_len := cur_len(p)
                advance(p)
                field_ty := parse_type_annotation(p)
                qualified := synth_join(
                    p,
                    variant_off,
                    variant_len,
                    field_off,
                    field_len
                )
                field := arena_push(
                    p.fields,
                    StructField {
                        name_off = qualified,
                        name_len = variant_len + field_len + 1,
                        ty = field_ty,
                        next = -1,
                        variant = tag,
                        align = 0
                    },
                )
                set_next_field(p, tail, field)
                tail = field
                if (cur(p) == TokenKind::Comma) {
                    advance(p)
                }
            }
            advance(p)
        }
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
        tag = tag + 1
    }
    advance(p)
    tag_field
}

// The same reading a generic struct's fields get, for a generic enum's
// variants. The variants and their fields are thrown away; each instance
// records its own against its own index.
read_template_variants :: fn(mut p: Parser, field_token: i64) {
    saved_ti := p.ti
    saved_fields := p.fields.count
    saved_variants := p.variants.count
    saved_known := p.size_known
    p.ti = field_token
    parse_enum_body(p, -1)
    p.fields.count = saved_fields
    p.variants.count = saved_variants
    p.size_known = saved_known
    p.ti = saved_ti
}

parse_enum :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    check_name_is_free(p, name_offset, name_length)
    entry_index := predeclared_index(p, name_offset, name_length)
    advance(p)
    advance(p)
    // `Name :: linear enum { ... }` marks a resource that must be consumed
    // exactly once, the same as a linear struct does, so the keyword sits
    // between `::` and `enum`.
    mut linear_flag: i64 = 0
    if (cur(p) == TokenKind::KwLinear) {
        linear_flag = 1
        advance(p)
    }
    advance(p)
    // `Name :: enum($T: Type) { ... }` is a generic enum. Like a generic struct
    // it records its parameters and the token of its `{`, skips the body, and is
    // re-parsed once per argument tuple with the parameters bound.
    if (cur(p) == TokenKind::Lparen) {
        advance(p)
        p.type_param_len = 0
        p.xparam_count = 0
        p.xparam_start = p.gparams.count
        while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
            advance(p)
            poff := cur_off(p)
            plen := cur_len(p)
            refuse_literal_name(p, poff, plen)
            advance(p)
            primary := record_gparam(p, poff, plen, kind_is_value(p), -1)
            parse_type_annotation(p)
            note_fallback(p, primary, parse_fallback(p))
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        advance(p)
        tparam_off := p.type_param_off
        tparam_len := p.type_param_len
        tparam_fallback := p.tparam_fallback
        xparam_start := p.xparam_start
        xparam_count := p.xparam_count
        refuse_field_sigils(p)
        field_token := p.ti
        mut brace_depth: i64 = 0
        mut started: i64 = 0
        while (started == 0 || brace_depth > 0) {
            if (cur(p) == TokenKind::Lbrace) {
                brace_depth = brace_depth + 1
                started = 1
            }
            if (cur(p) == TokenKind::Rbrace) {
                brace_depth = brace_depth - 1
            }
            advance(p)
        }
        record_struct(
            p,
            entry_index,
            StructDef {
                name_off = name_offset,
                name_len = name_length,
                field_head = -1,
                is_generic = 1,
                tparam_off = tparam_off,
                tparam_len = tparam_len,
                field_token = field_token,
                instance_id = -1,
                is_linear = linear_flag,
                emitted = 0,
                xparam_start = xparam_start,
                xparam_count = xparam_count,
                tparam_fallback = tparam_fallback,
                is_enum = 1,
                declared = 1,
                is_multi = 0,
                is_result = 0,
                is_packed = 0
            }
        )
        refuse_generic_values_block(p, name_offset, name_length)
        read_template_variants(p, field_token)
        return
    }
    // The enum's own index is known before its body is, since a variant has to
    // record which enum it belongs to.
    mut enum_index := entry_index
    if (enum_index < 0) {
        enum_index = p.structs.count
    }
    enum_ty := STRUCT_BASE + enum_index
    refuse_field_sigils(p)
    field_head := parse_enum_body(p, enum_ty)
    record_struct(
        p,
        entry_index,
        StructDef {
            name_off = name_offset,
            name_len = name_length,
            field_head = field_head,
            is_generic = 0,
            tparam_off = 0,
            tparam_len = 0,
            field_token = 0,
            instance_id = -1,
            is_linear = linear_flag,
            emitted = 0,
            xparam_start = 0,
            xparam_count = 0,
            tparam_fallback = -1,
            is_enum = 1,
            declared = 1,
            is_multi = 0,
            is_result = 0,
            is_packed = 0
        }
    )
    read_values_block(p, enum_ty, name_offset, name_length, enum_ty)
}

// `Kind::Enemy { damage = 15 }`, or `Kind::Player` with nothing to carry. The
// value is the enum's struct with the variant's tag and the fields it was
// given, under the names the declaration gave them.
parse_variant_value :: fn(mut p: Parser, enum_off: i64, enum_len: i64) -> i64 {
    enum_ty := resolve_lit_type(p, enum_off, enum_len)
    variant_off := cur_off(p)
    variant_len := cur_len(p)
    advance(p)
    // `InitFlags::Video` reads the same way and is one bit of a flags type: a
    // number carrying that type rather than a value with a tag. The type rides
    // on the node so that what it is does not depend on where it was written.
    if (is_flags_type(p, enum_ty)) {
        value := flag_bit_value(p, enum_ty, variant_off, variant_len)
        if (value < 0) {
            report_where(p.modules, p.src, variant_off)
            report("'")
            report_src(p.src, enum_off, enum_len)
            report("' names no bit called '")
            report_src(p.src, variant_off, variant_len)
            report("'")
            frost_rt_recover_escape()
        }
        return new_node(p, NodeKind::Num, 0, enum_ty + 1, value)
    }
    // `Key::Left` and `Vec3::ZERO`, a value the type names under itself. The
    // value is its expression wherever it is written, read at the type the
    // declaration gives it, so a number written under a distinct type comes
    // out as that type and not as the number.
    index := type_value_index(p, enum_ty, variant_off, variant_len)
    if (index >= 0) {
        if (cur(p) == TokenKind::Lbrace) {
            // At the type, which is where `Type::Name` begins. The complaint
            // names the whole of it, so pointing at the half after the `::`
            // underlines less than it is about.
            report_where(p.modules, p.src, enum_off)
            report("'")
            report_src(p.src, enum_off, enum_len)
            report("::")
            report_src(p.src, variant_off, variant_len)
            report("' is a value named under a type, so it carries nothing")
            frost_rt_recover_escape()
        }
        // At the type name, which is where the whole of `Vec3::ZERO` begins.
        // The value's own name underlines less than the report is about, the
        // way the refusal above it already says.
        return type_value_node(p, index, enum_off)
    }
    // A name under a type that names values, where no variant answers to it
    // either. The type's own values are the set a near name is looked for in.
    // Asked of an enum by whether it is one, since here an enum is a struct
    // type and a struct is where this rule has something to say.
    if (names_values(p, enum_ty) && names_an_enum(p, enum_ty) == false) {
        report_where(p.modules, p.src, enum_off)
        report("'")
        report_src(p.src, enum_off, enum_len)
        report("' names no value called '")
        report_src(p.src, variant_off, variant_len)
        report("'")
        report_nearest_value(p, enum_ty, variant_off, variant_len)
        frost_rt_recover_escape()
    }
    parse_variant_body(p, enum_ty, enum_off, enum_len, variant_off, variant_len)
}

// Whether a type code names an enum. Every enum is laid out as a struct here,
// so the code alone does not say, and the declaration's own flag is what does.
names_an_enum :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_struct_ty(ty) == false) {
        return false
    }
    arena_at(p.structs, struct_index_of(ty)).is_enum == 1
}

// The value name a misspelling was probably meant to be, out of the ones this
// type names, chosen the way an unknown variable's near name is and said in
// the same words. An ambiguous suggestion is withheld for the reason it is
// there: a guess a reader takes without checking is worse than none.
report_nearest_value :: fn(mut p: Parser, ty: i64, off: i64, len: i64) {
    mut best: i64 = -1
    mut best_distance: i64 = 0
    mut ties: i64 = 0
    mut i: i64 = 0
    while (i < p.type_values.count) {
        entry := arena_at(p.type_values, i)
        // The name itself is the one suggestion that helps nobody. Both halves
        // of the comparison are needed: `bytes_equal` reads `len` bytes, so a
        // value whose name merely opens with what was written reads as equal
        // to it and would be passed over.
        same := (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len))
        if (entry.ty == ty && same == false) {
            held := name_distance(
                p.src,
                entry.name_off,
                entry.name_len,
                off,
                len
            )
            if (held * 3 <= len * 2) {
                if (best < 0 || held < best_distance) {
                    best = i
                    best_distance = held
                    ties = 1
                } else if (held == best_distance) {
                    ties = ties + 1
                }
            }
        }
        i = i + 1
    }
    if (ties != 1) {
        return
    }
    entry := arena_at(p.type_values, best)
    report(" (did you mean '")
    report_src(p.src, entry.name_off, entry.name_len)
    report("'?)")
}

// The `{ field = value }` of a variant literal and the literal itself, with the
// enum already decided. `enum_off`/`enum_len` name the enum for the diagnostic;
// a leading dot has no such name and passes its variant's range instead.
parse_variant_body :: fn(
    mut p: Parser,
    enum_ty: i64,
    enum_off: i64,
    enum_len: i64,
    variant_off: i64,
    variant_len: i64
) -> i64 {
    // -1 is a `.Variant` whose enum is not decided yet, so there is nothing to
    // look the variant up in. The fixup pass resolves it once every signature
    // is known.
    mut index: i64 = -1
    if (enum_ty != (-1)) {
        index = find_variant(p, enum_ty, variant_off, variant_len)
    }
    mut variant_tag: i64 = 0
    if (index < 0) {
        // A construction in a generic template names a variant of an instance
        // that does not exist yet. This parse is thrown away and re-done per
        // instance where it resolves, so a placeholder tag stands in for now.
        if (enum_ty == (-1)
            || (p.saw_type_param == 1 && p.binding_active == 0)) {
            variant_tag = 0
        } else {
            report_where(p.modules, p.src, variant_off)
            report("'")
            report_src(p.src, enum_off, enum_len)
            report("' has no variant '")
            report_src(p.src, variant_off, variant_len)
            report("'")
            frost_rt_recover_escape()
        }
    } else {
        entry := arena_at(p.variants, index)
        variant_tag = entry.tag
    }
    tag_value := new_node(p, NodeKind::Num, 0, 0, variant_tag)
    head := new_field_init(p, tag_value, p.name_tag, 3)
    mut tail := head
    if (cur(p) == TokenKind::Lbrace && p.no_struct_lit == false) {
        advance(p)
        while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
            field_off := cur_off(p)
            field_len := cur_len(p)
            advance(p)
            // A field is given its value with `=`, the same as a struct's.
            if (cur(p) != TokenKind::Assign) {
                report_where(p.modules, p.src, cur_off(p))
                report("a field in a literal is given its value with '=', and ")
                report("this writes '")
                report_src(p.src, cur_off(p), cur_len(p))
                report("'")
                frost_rt_recover_escape()
            }
            advance(p)
            // An enum's fields are laid out under the name of the variant they
            // came from, so that is the name the field's type is looked up by,
            // and a nested literal is parsed under it.
            qualified := synth_join(
                p,
                variant_off,
                variant_len,
                field_off,
                field_len
            )
            saved_field_expected := p.expected_type
            p.expected_type = field_type(
                p,
                enum_ty,
                qualified,
                variant_len + field_len + 1
            )
            value := parse_expr(p)
            p.expected_type = saved_field_expected
            init := new_field_init(
                p,
                value,
                qualified,
                variant_len + field_len + 1
            )
            set_next(p, tail, init)
            tail = init
            if (cur(p) == TokenKind::Comma) {
                advance(p)
            }
        }
        advance(p)
    }
    // At the enum the literal names, which is where a reader looks. Read off
    // the cursor it named the token past the whole literal, so a report about
    // one written on its own line landed on the line after it.
    lit := new_struct_lit(p, enum_ty, head, enum_off)
    // An unresolved dot carries the variant it named, so the fixup pass can
    // look it up in the enum the callee's parameter turns out to be.
    if (enum_ty == (-1)) {
        node := arena_at(p.arena, lit)
        node.b = variant_off
        node.c = variant_len
    }
    lit
}

// The enum a `.Variant` belongs to: the type the context expects, or the second
// place to look when the first does not have the variant. -1 when neither does,
// which leaves the literal for the fixup pass.
expected_variant_enum :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    if (is_struct_ty(p.expected_type)
        && find_variant(p, p.expected_type, off, len) >= 0) {
        return p.expected_type
    }
    if (is_struct_ty(p.expected_alt)
        && find_variant(p, p.expected_alt, off, len) >= 0) {
        return p.expected_alt
    }
    -1
}

// The value a `.Name` elides, where the type the context expects names one.
// The two places a variant is looked for are the two looked in here, and for
// the same reason: a return in a fallible function has an answer type and an
// error type, and either may be what was meant.
expected_named_value :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    held := type_value_index(p, p.expected_type, off, len)
    if (held >= 0) {
        return held
    }
    type_value_index(p, p.expected_alt, off, len)
}

// A `.Name` bound to a name that says no type. Everywhere else one is written
// there is a type to name in the report; a `:=` has none, so this is where the
// message says there is nothing to name rather than naming it.
refuse_unbound_variant :: fn(mut p: Parser, value: i64) {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::StructLit || node.val != (-1) || node.c == 0) {
        return
    }
    report_where(p.modules, p.src, node.pos)
    report("a value named under a type is written with the type in front of it, and there is no type here to name")
    frost_rt_recover_escape()
}

// `.Variant` and `.Variant { field = value }`, the construction counterpart of
// the `case .Variant` a match arm writes. The enum is whatever the context
// expects rather than something the reader repeats.
parse_inferred_variant :: fn(mut p: Parser) -> i64 {
    dot_off := cur_off(p)
    advance(p)
    variant_off := cur_off(p)
    variant_len := cur_len(p)
    advance(p)
    // A value named under a type, written with the type left out. Refused
    // where the context names the type, so the report carries the edit; a
    // context that names none leaves the node for the fixup pass, which
    // refuses it once the type it lands in is known.
    named := expected_named_value(p, variant_off, variant_len)
    if (named >= 0) {
        entry := arena_at(p.type_values, named)
        refuse_dot_value_at(p, entry.ty, variant_off, variant_len, dot_off, 1)
    }
    enum_ty := expected_variant_enum(p, variant_off, variant_len)
    if (enum_ty >= 0) {
        refuse_dot_value_at(p, enum_ty, variant_off, variant_len, dot_off, 1)
    }
    lit := parse_variant_body(
        p,
        enum_ty,
        variant_off,
        variant_len,
        variant_off,
        variant_len
    )
    // The dot, rather than wherever the reading of the literal ended. A walk
    // that runs after the parse reports off this, and a `.Name` nothing gave a
    // type to was being reported at the token after the whole of it.
    mut node := arena_at(p.arena, lit)
    node.pos = dot_off
    lit
}

// One literal that named no type, now that the type it is written into is
// known. A `.Variant` carries the variant's name on the node and needs its tag
// filled in as well as its type. A `{ ... }` needs only the type. Either way
// the fields are walked, so a literal nested inside one resolves too.
resolve_untyped_literal :: fn(mut p: Parser, node_id: i64, wanted: i64) {
    node := arena_at(p.arena, node_id)
    if (node.kind != NodeKind::StructLit || node.val != (-1)) {
        return
    }
    mut struct_ty := wanted
    // The same question the argument list asks, and for the same reason: a
    // distinct type is not a borrow, whatever its code compares as.
    if (is_borrow(struct_ty)) {
        struct_ty = pointee(p, struct_ty)
    }
    name_off := node.b
    name_len := node.c
    position := node.pos
    // A `.Name` whose type is known only now that the place it lands in is.
    // The type is named in the report, which is the edit the reader makes.
    if (name_len != 0) {
        refuse_dot_value(p, struct_ty, name_off, name_len, position)
        named := type_value_index(p, struct_ty, name_off, name_len)
        if (named >= 0) {
            value := arena_at(p.arena, type_value_node(p, named, position))
            kind := value.kind
            a := value.a
            b := value.b
            c := value.c
            val := value.val
            mut held := arena_at(p.arena, node_id)
            held.kind = kind
            held.a = a
            held.b = b
            held.c = c
            held.val = val
            return
        }
    }
    if (is_struct_ty(struct_ty) == false) {
        report_where(p.modules, p.src, position)
        report("this literal takes its type from what the context expects, and there is no struct or enum type there")
        frost_rt_recover_escape()
    }
    node.val = struct_ty
    node.b = 0
    node.c = 0
    inits := node.a
    // A variant names itself on the node, so its tag is looked up here.
    if (name_len != 0) {
        index := find_variant(p, struct_ty, name_off, name_len)
        if (index < 0) {
            report_where(p.modules, p.src, name_off)
            report("'.")
            report_src(p.src, name_off, name_len)
            report("' is not a variant of the type this context expects")
            frost_rt_recover_escape()
        }
        entry := arena_at(p.variants, index)
        tag := entry.tag
        first := arena_at(p.arena, inits)
        tag_node := first.a
        held := arena_at(p.arena, tag_node)
        held.val = tag
    }
    mut id := inits
    while (id != (-1)) {
        init := arena_at(p.arena, id)
        value := init.a
        field_off := init.val
        field_len := init.c
        following := init.next
        resolve_untyped_literal(
            p,
            value,
            field_type(p, struct_ty, field_off, field_len)
        )
        id = following
    }
}

// The function a call names, or -1 for anything else. A list binding takes its
// field names from the signature of the call it binds.
call_target :: fn(mut p: Parser, value: i64) -> i64 {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call) {
        return -1
    }
    node.val
}

// Name one field of a list binding after the value the callee's return type
// list declared at that position. False when the callee has no signature yet,
// which leaves it for the fixup pass.
resolve_multi_field :: fn(
    mut p: Parser,
    node_id: i64,
    callee: i64,
    index: i64
) -> bool {
    if (callee < 0) {
        return false
    }
    entry := arena_at(p.fns, callee)
    ret := entry.ret_type
    fid := nth_field(p, ret, index)
    if (fid < 0) {
        return false
    }
    field := arena_at(p.fields, fid)
    off := field.name_off
    length := field.name_len
    node := arena_at(p.arena, node_id)
    node.val = off
    node.c = length
    true
}

// A `_` in a binding list, held to the values that may be dropped. A resource
// is consumed exactly once, so taking one and naming it nothing loses it.
//
// Called once, after `settle_linear_types` has answered for every declaration,
// since a struct holding a resource is one and that is settled at the end of
// the parse. Run before then it would ask a flag that is not in yet.
check_discarded_resources :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.multi_discards.count) {
        entry := arena_at(p.multi_discards, i)
        callee := entry.name_off
        index := entry.name_len
        at := entry.ty
        if (callee >= 0) {
            sym := arena_at(p.fns, callee)
            // An index names one value of a return type list, and -1 names the
            // whole answer, which is what a lone `_` takes.
            mut dropped: i64 = -1
            if (index == (-1)) {
                dropped = sym.ret_type
            } else {
                fid := nth_field(p, sym.ret_type, index)
                if (fid >= 0) {
                    dropped = arena_at(p.fields, fid).ty
                }
            }
            if (dropped >= 0 && is_linear_type(p, dropped)) {
                report_where(p.modules, p.src, at)
                report("this `_` drops a '")
                report_type_name(p, dropped)
                report("', which is consumed exactly once; bind it to a name and consume it")
                frost_rt_recover_escape()
            }
        }
        i = i + 1
    }
}

// Everything an earlier parse left unresolved, now that every signature is
// parsed: a literal that named no type, and a field of a list binding whose
// callee was written later.
//
// A body is parsed in two places: the whole file, once, and a generic's body
// again for every instance, which happens while the checks and the emitters
// run. Anything that has to see every body is called from both places, or it
// walks the file and never walks an instance.
resolve_variant_fixups :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.variant_fixups.count) {
        fixup := arena_at(p.variant_fixups, i)
        lit_id := fixup.lit
        argument := fixup.argument
        target := fixup.callee
        kind := fixup.kind
        if (kind == FixupKind::MultiField) {
            if (resolve_multi_field(p, lit_id, target, argument) == false) {
                // At the binding. `argument` counts which value of the list
                // this one names, and reading a count as an offset put every
                // such report on the first line of the first file.
                held := arena_at(p.arena, lit_id)
                report_where(p.modules, p.src, held.pos)
                // Two faults wear the same shape here: a call that answers no
                // list at all, and one that answers a shorter one than the
                // binding names. The callee's answer tells them apart.
                answer := arena_at(p.fns, target).ret_type
                mut lists: i64 = 0
                if (is_struct_ty(answer)) {
                    def := arena_at(p.structs, struct_index_of(answer))
                    if (def.name_len > 7
                        && str_range_eq(p.src, def.name_off, 7, "__Multi")) {
                        lists = 1
                    }
                }
                if (lists == 1) {
                    report(
                        "this binding names more values than the call returns"
                    )
                } else {
                    report("this binding names the values of a call whose signature is not a return type list")
                }
                frost_rt_recover_escape()
            }
        } else {
            callee := arena_at(p.fns, target)
            params := callee.params
            declared := nth_param_type(p, params, argument)
            resolve_untyped_literal(p, lit_id, declared)
        }
        i = i + 1
    }
    p.variant_fixups.count = 0
}

// ---------------------------------------------------------------------------
// Failure sets. `-> T ! E` says a function answers with a T or fails with an E,
// and `e?` hands the failure on. Both lower to what the compiler already has: a
// failure set is a struct carrying which of the two it holds beside both, and
// `?` is a binding, a test and a return, written out where the call sits.
//
// A tag beside both payloads rather than a space-saving union: the two are
// never both live, but reading either one is then a plain field of a plain
// struct, which every backend already does.
// ---------------------------------------------------------------------------

// The field names a failure set's struct uses, made once and shared.
result_field_names :: fn(mut p: Parser) {
    if (p.name_tag == 0) {
        p.name_tag = synth_literal(p, "tag")
        p.name_value = synth_literal(p, "value")
        p.name_error = synth_literal(p, "error")
        p.name_ok = synth_literal(p, "Ok")
        p.name_err = synth_literal(p, "Err")
        p.name_ok_value = synth_join(p, p.name_ok, 2, p.name_value, 5)
        p.name_err_error = synth_join(p, p.name_err, 3, p.name_error, 5)
    }
}

// The struct standing for `T ! E`, made fresh per function so its payload types
// are the ones that function declared.
// Whether the result of a fallible function has to be consumed, which it does
// when either half of it does. Without this a resource handed back through a
// failure set could be dropped by ignoring the call.
result_is_linear :: fn(mut p: Parser, ok: i64, bad: i64) -> i64 {
    if (is_linear_type(p, ok) || is_linear_type(p, bad)) {
        return 1
    }
    0
}

// The enum an earlier `-> T ! E` already made for this pair, or -1. The two
// types decide the enum and nothing else does, so two signatures that answer
// the same way answer with one type. Made twice, it is one name standing for
// two structs, which the C it is emitted as writes out twice.
find_result_struct :: fn(mut p: Parser, ok: i64, bad: i64) -> i64 {
    mut index: i64 = 0
    while (index < p.results.count) {
        held := arena_at(p.results, index)
        if (held.ok == ok && held.bad == bad) {
            return held.ty
        }
        index = index + 1
    }
    -1
}

synth_result_struct :: fn(mut p: Parser, ok: i64, bad: i64) -> i64 {
    held := find_result_struct(p, ok, bad)
    if (held >= 0) {
        return held
    }
    result_field_names(p)
    tag := arena_push(
        p.fields,
        StructField {
            name_off = p.name_tag,
            name_len = 3,
            ty = TY_I64,
            next = -1,
            variant = -1,
            align = 0
        },
    )
    value := arena_push(
        p.fields,
        StructField {
            name_off = p.name_ok_value,
            name_len = 8,
            ty = ok,
            next = -1,
            variant = -1,
            align = 0
        },
    )
    bad_field := arena_push(
        p.fields,
        StructField {
            name_off = p.name_err_error,
            name_len = 9,
            ty = bad,
            next = -1,
            variant = -1,
            align = 0
        },
    )
    set_next_field(p, tag, value)
    set_next_field(p, value, bad_field)
    // The name a program writes to reach the two variants. One enum per
    // `(T, E)` with the same shape every time, so it is named the way any
    // generic's instance is, and the values under a failure set need no
    // spelling of their own. The arguments are part of the name, which is what
    // keeps two failure sets in one program two types.
    name, name_length := synth_result_name(p, ok, bad)
    index := arena_push(
        p.structs,
        StructDef {
            name_off = name,
            name_len = name_length,
            field_head = tag,
            is_generic = 0,
            tparam_off = 0,
            tparam_len = 0,
            field_token = 0,
            instance_id = -1,
            is_linear = result_is_linear(p, ok, bad),
            emitted = 0,
            xparam_start = 0,
            xparam_count = 0,
            tparam_fallback = -1,
            is_enum = 1,
            declared = 1,
            is_multi = 0,
            is_result = 1,
            is_packed = 0
        },
    )
    result_ty := STRUCT_BASE + index
    // Recorded under the pair it was made for, which is what the next
    // signature answering the same way finds instead of making a second one.
    arena_push(p.results, ResultEnum { ok = ok, bad = bad, ty = result_ty })
    arena_push(
        p.variants,
        Variant {
            enum_ty = result_ty,
            name_off = p.name_ok,
            name_len = 2,
            tag = 0
        },
    )
    arena_push(
        p.variants,
        Variant {
            enum_ty = result_ty,
            name_off = p.name_err,
            name_len = 3,
            tag = 1
        },
    )
    result_ty
}

// ---------------------------------------------------------------------------
// Multiple return values. `-> (i64, i64)` is a return type list, not a tuple
// type: the list becomes one struct whose fields are `value0`, `value1` and so
// on, `return a, b` becomes a literal of it, and `x, y := f()` becomes the call
// bound to a temporary and one field read per name. Everything after the parse
// handles an ordinary struct return, which both backends already do.
// ---------------------------------------------------------------------------

// The nth field of a struct, or -1 past the end. A return type list's values
// are its fields in order, so this is what turns a position at a `return` into
// the name the signature gave it.
nth_field :: fn(mut p: Parser, struct_ty: i64, index: i64) -> i64 {
    if (is_struct_ty(struct_ty) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(struct_ty))
    mut fid := def.field_head
    mut at: i64 = 0
    while (fid != (-1)) {
        if (at == index) {
            return fid
        }
        held := arena_at(p.fields, fid)
        fid = held.next
        at = at + 1
    }
    -1
}

// The struct standing for the list, made fresh per function so its field types
// are the ones that function declared. A value the signature named keeps that
// name as its field, so `return { quotient = .. }` writes what the signature
// reads. The `(` has been consumed.
synth_multi_struct :: fn(mut p: Parser, list_at: i64) -> i64 {
    mut head: i64 = -1
    mut tail: i64 = -1
    mut count: i64 = 0
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        mut name_off: i64 = -1
        mut name_len: i64 = 0
        if (cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Colon) {
            name_off = cur_off(p)
            name_len = cur_len(p)
            advance(p)
            advance(p)
        }
        held := parse_type(p)
        // A name says which value is which, and it is the field a `return` by
        // name writes. A list that left one out had that field called `value0`,
        // a spelling this compiler chose and the language never offered.
        if (name_off == (-1)) {
            // At the list, since what is wrong is the list rather than the
            // one value the read happened to stop on.
            report_where(p.modules, p.src, list_at)
            report("a return type list names every value; write `-> (name: T, name: T)`")
            frost_rt_recover_escape()
        }
        name := name_off
        length := name_len
        field := arena_push(
            p.fields,
            StructField {
                name_off = name,
                name_len = length,
                ty = held,
                next = -1,
                variant = -1,
                align = 0
            },
        )
        if (head == (-1)) {
            head = field
        } else {
            set_next_field(p, tail, field)
        }
        tail = field
        count = count + 1
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    if (count < 2) {
        report_where(p.modules, p.src, cur_off(p))
        report("a return type list holds two or more types; write `-> T` for one")
        frost_rt_recover_escape()
    }
    struct_name := synth_numbered(p, "__Multi", p.structs.count)
    index := arena_push(
        p.structs,
        StructDef {
            name_off = struct_name,
            name_len = 7 + digits_in(p.structs.count),
            field_head = head,
            is_generic = 0,
            tparam_off = 0,
            tparam_len = 0,
            field_token = 0,
            instance_id = -1,
            is_linear = 0,
            emitted = 0,
            xparam_start = 0,
            xparam_count = 0,
            tparam_fallback = -1,
            is_enum = 0,
            declared = 1,
            is_multi = 1,
            is_result = 0,
            is_packed = 0
        },
    )
    p.multi_count = count
    STRUCT_BASE + index
}

// The name of a return type list's nth value, as a byte range in the source.
// The signature's name when it gave one, and the synthesized `valueN` when it
// did not, which is what the struct's field is called either way.
multi_field_name_off :: fn(mut p: Parser, index: i64) -> i64 {
    fid := nth_field(p, p.multi_ty, index)
    field := arena_at(p.fields, fid)
    field.name_off
}

multi_field_name_len :: fn(mut p: Parser, index: i64) -> i64 {
    fid := nth_field(p, p.multi_ty, index)
    field := arena_at(p.fields, fid)
    field.name_len
}

// `return a, b` as the literal of the struct the list stands for. The first
// value is already parsed.
multi_return_value :: fn(mut p: Parser, first: i64) -> i64 {
    if (p.multi_ty == (-1)) {
        report_where(p.modules, p.src, cur_off(p))
        report("this `return` lists several values and the function returns one")
        frost_rt_recover_escape()
    }
    init := new_field_init(
        p,
        first,
        multi_field_name_off(p, 0),
        multi_field_name_len(p, 0)
    )
    mut tail := init
    mut count: i64 = 1
    while (cur(p) == TokenKind::Comma) {
        advance(p)
        value := parse_expr(p)
        following := new_field_init(
            p,
            value,
            multi_field_name_off(p, count),
            multi_field_name_len(p, count)
        )
        set_next(p, tail, following)
        tail = following
        count = count + 1
    }
    if (count != p.multi_count) {
        report_where(p.modules, p.src, cur_off(p))
        report("this `return` lists a different number of values than the function returns")
        frost_rt_recover_escape()
    }
    new_struct_lit(p, p.multi_ty, init, cur_off(p))
}

set_next_field :: fn(mut p: Parser, id: i64, following: i64) {
    field := arena_at(p.fields, id)
    field.next = following
}

// Which side of the failure set a returned value is. Building the error type is
// how a function fails. Anything else is the value it answers with. A value
// already of the error type but not built here reads as an ok value, the same
// way the reference compiler reads it.
returns_failure :: fn(mut p: Parser, value: i64) -> bool {
    if (p.failure_ty == (-1)) {
        return false
    }
    node := arena_at(p.arena, value)
    node.kind == NodeKind::StructLit && node.val == p.failure_ty
}

// Wrap a returned value as whichever side of the failure set it is.
wrap_result :: fn(mut p: Parser, value: i64) -> i64 {
    if (returns_failure(p, value)) {
        return new_result_value(p, p.result_ty, 1, p.name_err_error, 9, value)
    }
    new_result_value(p, p.result_ty, 0, p.name_ok_value, 8, value)
}

// `Result { tag = <which>, <name> = <payload> }`, the value a fallible function
// answers with. The other payload is left alone, since which one is live is
// what the tag says.
new_result_value :: fn(
    mut p: Parser,
    result_ty: i64,
    which: i64,
    name_off: i64,
    name_len: i64,
    payload: i64
) -> i64 {
    which_node := arena_push(
        p.arena,
        Node {
            kind = NodeKind::Num,
            a = 0,
            b = 0,
            c = 0,
            val = which,
            next = -1,
            pos = cur_off(p)
        },
    )
    tag_init := new_field_init(p, which_node, p.name_tag, 3)
    payload_init := new_field_init(p, payload, name_off, name_len)
    set_next(p, tag_init, payload_init)
    new_struct_lit(p, result_ty, tag_init, cur_off(p))
}

// Whether the source at `offset` begins with `text`, for the two name spaces a
// program may not define into.
starts_with_name :: fn(src: str, offset: i64, length: i64, text: str) -> bool {
    wanted := str_len(text)
    if (length < wanted) {
        return false
    }
    mut k: i64 = 0
    while (k < wanted) {
        if (src[offset + k] != text[k]) {
            return false
        }
        k = k + 1
    }
    true
}

// A name-keeping definition is emitted under the name it was written under, so
// two of them by one name are one symbol, and the runtime is linked into every
// program. `frost_rt_` is what the runtime emits and `frost_u_` is what the
// bootstrap's C backend names an ordinary function, so a program defining
// either would replace something every program calls.
refuse_reserved_name :: fn(mut p: Parser, offset: i64, length: i64) {
    if (p.runtime_names == 1) {
        return
    }
    if (starts_with_name(p.src, offset, length, "frost_rt_") == false
        && starts_with_name(p.src, offset, length, "frost_u_") == false) {
        return
    }
    report_where(p.modules, p.src, offset)
    report("'")
    report_src(p.src, offset, length)
    report("' keeps the name it is written under, and 'frost_rt_' and 'frost_u_' are the runtime's and the compiler's own, so a definition here would replace what every program calls")
    frost_rt_recover_escape()
}

// An extern declaration `name :: extern fn(params) -> ret`. The name is marked
// extern so calls emit it verbatim, and the node carries params and return type
// so a C prototype can be emitted. `val` is the fn index, `b` the params, `c`
// the return type.
parse_extern :: fn(mut p: Parser) -> i64 {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    advance(p)
    advance(p)
    // `safe extern fn` says this one was audited, so the gate lets its calls
    // stand outside a block.
    mut audited: i64 = 0
    if (cur(p) == TokenKind::KwSafe) {
        audited = 1
        advance(p)
    }
    advance(p)
    advance(p)
    fn_index := intern_global(p, name_offset, name_length)
    mark_extern(p, fn_index)
    if (audited == 1) {
        mark_safe(p, fn_index)
    }
    advance(p)
    p.params_owner_off = name_offset
    params := parse_params(p)
    set_params(p, fn_index, params)
    mark_defined(p, fn_index)
    mut ret: i64 = TY_VOID
    if (cur(p) == TokenKind::Arrow) {
        advance(p)
        ret = parse_type(p)
    }
    set_ret_type(p, fn_index, ret)
    // A body makes this a definition rather than a declaration: the function is
    // written here and keeps the name it was written under, where an ordinary
    // one is emitted as `mf_<index>`. That is what lets Frost supply a symbol C
    // already calls by name, which is what the runtime is.
    if (cur(p) == TokenKind::Lbrace) {
        refuse_reserved_name(p, name_offset, name_length)
        clear_extern(p, fn_index)
        mark_keeps_name(p, fn_index)
        p.type_param_off = 0
        p.type_param_len = 0
        p.saw_type_param = 0
        p.tparam_is_slot = 0
        p.tparam_fallback = -1
        p.tparam_fallback = -1
        p.tparam_called = 0
        p.bound_token = -1
        p.decl_pack_off = 0
        p.decl_pack_len = 0
        p.decl_pack_fixed = 0
        p.decl_pack_format = -1
        p.unbound_pack_for = 0
        p.decl_format_len = 0
        body := parse_block(p)
        return new_func_node(p, body, params, fn_index, 0)
    }
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Extern,
            a = 0,
            b = params,
            c = ret,
            val = fn_index,
            next = -1,
            pos = cur_off(p)
        },
    )
}

// A constant `name :: value`, registered for inlining at use sites.
// The integer operators a constant expression combines names with. One after
// `NAME :: OtherName` is what marks the whole line a constant rather than an
// `Enum::Variant` access, which never carries a trailing operator, keeping the
// two apart the same way the bootstrap does.
is_arith_op :: fn(kind: TokenKind) -> bool {
    if (kind == TokenKind::Plus) { return true }
    if (kind == TokenKind::Minus) { return true }
    if (kind == TokenKind::Star) { return true }
    if (kind == TokenKind::Slash) { return true }
    if (kind == TokenKind::Percent) { return true }
    if (kind == TokenKind::Shl) { return true }
    if (kind == TokenKind::Shr) { return true }
    if (kind == TokenKind::Amp) { return true }
    if (kind == TokenKind::Pipe) { return true }
    false
}

// Fold a constant expression to its integer value. A constant is an integer
// literal, another constant named earlier, or those combined with the integer
// operators, all evaluated here so a `[N]T` size or a layout offset can be
// written as `A + B` rather than a magic number. Anything that is not one of
// those (a call, a float, a name that is not a constant) is refused.
fold_const :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Num) {
        return node.val
    }
    if (kind == NodeKind::Var) {
        if (is_const(p, node.val, node.c) == false) {
            report_where(p.modules, p.src, node.val)
            report("'")
            report_src(p.src, node.val, node.c)
            report("' is not a constant, so it cannot appear in a constant")
            frost_rt_recover_escape()
        }
        return const_value(p, node.val, node.c)
    }
    if (kind == NodeKind::Bin) {
        left := fold_const(p, node.a)
        right := fold_const(p, node.b)
        op := node.val
        // Where the leftmost value under this is written, rather than where
        // this expression starts. A `(` is a token the expression starts at
        // and the other compiler keeps no record of, so the two pointed at
        // different columns for a constant written inside parentheses.
        at := leftmost_written(p, id)
        // Worked out with the checks written out, because the compiler's own
        // arithmetic traps: a constant that overflows killed the compiler where
        // it stood, with a fault and a stack address instead of a report about
        // the program.
        if (op == OP_ADD) {
            sum := wrap_add(left, right)
            if ((left > 0 && right > 0 && sum < 0)
                || (left < 0 && right < 0 && sum >= 0)) {
                const_overflows_at(p, at)
            }
            return sum
        }
        if (op == OP_SUB) {
            held := wrap_sub(left, right)
            if ((left >= 0 && right < 0 && held < 0)
                || (left < 0 && right > 0 && held >= 0)) {
                const_overflows_at(p, at)
            }
            return held
        }
        if (op == OP_MUL) {
            held := wrap_mul(left, right)
            if (left != 0 && (held / left != right)) {
                const_overflows_at(p, at)
            }
            return held
        }
        // The smallest i64 divided by -1 is one past the largest, which is the
        // one division that answers nothing without dividing by zero. Left to
        // the division itself it took the compiler down with it.
        if (op == OP_DIV) {
            if (right == 0) {
                report_where(p.modules, p.src, at)
                report("this divides by zero")
                frost_rt_recover_escape()
            }
            if (left == (-9223372036854775807 - 1) && right == (-1)) {
                const_overflows_at(p, at)
            }
            return left / right
        }
        if (op == OP_MOD) {
            if (right == 0) {
                report_where(p.modules, p.src, at)
                report("this divides by zero")
                frost_rt_recover_escape()
            }
            // The remainder of the smallest by minus one is nothing, and that
            // is what the machine answers. Only the quotient leaves the range.
            if (right == (-1)) {
                return 0
            }
            return left % right
        }
        if (op == OP_SHL) { return left << right }
        if (op == OP_SHR) { return left >> right }
        if (op == OP_BITAND) { return left & right }
        if (op == OP_BITOR) { return left | right }
    }
    report_where(p.modules, p.src, node.pos)
    report("this is not a constant expression")
    frost_rt_recover_escape()
    0
}

// Where the leftmost value under an expression is written. An operator node
// begins at the first token of what it is written over, and a `(` is one; the
// value inside it is what a report about the arithmetic names.
leftmost_written :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Bin && node.a != (-1)) {
        return leftmost_written(p, node.a)
    }
    node.pos
}

// `Meters :: distinct i64`, a name of its own for another type's
// representation. The name goes in the alias table like any other type name,
// but what it stands for is a code of its own rather than the inner type, so
// two of them over the same representation are two types. The alias table's
// position is the identity, which is unique by construction and stable, since
// nothing is ever removed from it.
parse_distinct :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    check_name_is_free(p, name_offset, name_length)
    advance(p)
    advance(p)
    advance(p)
    inner := parse_type(p)
    ty := distinct_type(inner, p.type_aliases.count)
    arena_push(
        p.type_aliases,
        ConstDef {
            name_off = name_offset,
            name_len = name_length,
            value = ty,
            kind = CONST_INT,
            count = 0
        },
    )
    read_values_block(p, ty, name_offset, name_length, -1)
}

// Whether a brace here opens the block of values a type names under itself.
// What follows the brace is a declaration, and a struct literal written with
// no name sets its fields with `=`, so the `::` is what tells the two apart.
at_values_block :: fn(mut p: Parser) -> bool {
    (cur(p) == TokenKind::Lbrace && peek_kind(p, 1) == TokenKind::Ident
        && peek_kind(p, 2) == TokenKind::Coloncolon)
}

// `Key :: distinct i64 { Left :: 80 }`: the values a type names under itself.
// Each is reached as `Key::Left`, which is where a variant and a bit of a set
// are already reached, and elides to `.Left` where the context names the type.
//
// The names are taken here and each value is read the first time it is named.
// A value may name a type declared further down the file, and no type below
// this one has been read yet, so reading a value now would read it against
// types that are not there.
//
// `variants_of` is the enum a name may already be a variant of, or -1 where the
// declaration has no variants.
// A generic declaration is one type for each set of arguments given to it, so
// there is no single type for a value to be a value of, and nothing to write
// `Box::EMPTY` at.
refuse_generic_values_block :: fn(mut p: Parser, type_off: i64, type_len: i64) {
    if (at_values_block(p) == false) {
        return
    }
    report_where(p.modules, p.src, cur_off(p))
    report("a type names values of itself, and a generic declaration is one type for each set of arguments given to it, so '")
    report_src(p.src, type_off, type_len)
    report("' names none")
    frost_rt_recover_escape()
}

read_values_block :: fn(
    mut p: Parser,
    ty: i64,
    type_off: i64,
    type_len: i64,
    variants_of: i64
) {
    if (at_values_block(p) == false) {
        return
    }
    // The brace this opens, which is the block a report about it is about.
    block_at := cur_off(p)
    advance(p)
    while (cur(p) != TokenKind::Rbrace) {
        if (cur(p) == TokenKind::Eof) {
            report_where(p.modules, p.src, block_at)
            report("the values '")
            report_src(p.src, type_off, type_len)
            report("' names are written inside braces, and this block is not closed")
            frost_rt_recover_escape()
        }
        if (cur(p) != TokenKind::Ident) {
            report_where(p.modules, p.src, cur_off(p))
            report(
                "a type names each of its values with a name, and this is not one"
            )
            frost_rt_recover_escape()
        }
        value_off := cur_off(p)
        value_len := cur_len(p)
        if (peek_kind(p, 1) != TokenKind::Coloncolon) {
            report_where(p.modules, p.src, value_off)
            report("'")
            report_src(p.src, value_off, value_len)
            report("' is a value named under '")
            report_src(p.src, type_off, type_len)
            report("', so it is written as '")
            report_src(p.src, value_off, value_len)
            report(" :: <value>'")
            frost_rt_recover_escape()
        }
        if (type_value_index(p, ty, value_off, value_len) >= 0) {
            report_where(p.modules, p.src, value_off)
            report("a type names each of its values once, and '")
            report_src(p.src, type_off, type_len)
            report("' names '")
            report_src(p.src, value_off, value_len)
            report("' twice")
            frost_rt_recover_escape()
        }
        if (variants_of != (-1)
            && find_variant(p, variants_of, value_off, value_len) >= 0) {
            report_where(p.modules, p.src, value_off)
            report("a type names each of its values once, and '")
            report_src(p.src, type_off, type_len)
            report("' names '")
            report_src(p.src, value_off, value_len)
            report("' as a variant and as a value")
            frost_rt_recover_escape()
        }
        advance(p)
        advance(p)
        // The value stands on the line its `::` is on. Without this a name
        // with nothing after it took the entry below for its value, and the
        // block came out one value short with nothing said about it.
        if (cur(p) == TokenKind::Rbrace || on_same_line(p) == false) {
            report_where(p.modules, p.src, value_off)
            report("'")
            report_src(p.src, value_off, value_len)
            report("' is a value named under '")
            report_src(p.src, type_off, type_len)
            report("', and it is written after its '::'")
            frost_rt_recover_escape()
        }
        record_type_value(p, ty, value_off, value_len, p.ti)
        skip_value_expression(p)
    }
    advance(p)
}

// Past one value's expression, to the name that opens the next or to the brace
// that closes the block. A value may be written with braces of its own, so the
// end is found at the depth the entries are written at.
//
// A value ends where a line does, which is where every other statement in the
// language ends. Reading the end off the next `Name ::` instead cut a value
// short at `Key::Left`, whose two tokens are the two an entry opens with.
//
// A break inside brackets says nothing, which `joins_line` answers, so a value
// written over several lines inside braces is one value.
skip_value_expression :: fn(mut p: Parser) {
    // Braces are counted here and the round and square ones by `advance`, which
    // is what `joins_line` reads. A literal written over several lines is
    // inside one of the three, so between them every break that says nothing is
    // accounted for.
    mut depth: i64 = 0
    mut started: i64 = 0
    mut previous := TokenKind::Eof
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Rbrace && depth == 0) {
            return
        }
        if (started == 1 && depth == 0 && joins_line(p) == false) {
            return
        }
        // A second value opening on this one's line. `Key::Left` is the same
        // two tokens, and what tells them apart is what comes before: a value
        // is finished where a name begins the next, and an operator or a `::`
        // leaves one unfinished.
        if (started == 1 && depth == 0 && kind == TokenKind::Ident
            && peek_kind(p, 1) == TokenKind::Coloncolon
            && token_ends_a_value(previous)) {
            report_where(p.modules, p.src, cur_off(p))
            report(
                "a type names each of its values on a line of its own, and this one follows another"
            )
            frost_rt_recover_escape()
        }
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace) {
            depth = depth - 1
        }
        started = 1
        previous = kind
        advance(p)
    }
}

// Whether a token can end a value, which is what says the name after it opens
// something new rather than continuing what is being read.
token_ends_a_value :: fn(kind: TokenKind) -> bool {
    (kind == TokenKind::Ident || kind == TokenKind::Int
        || kind == TokenKind::Float || kind == TokenKind::Str
        || kind == TokenKind::Rparen || kind == TokenKind::Rbracket
        || kind == TokenKind::Rbrace)
}

// The node a value named under a type stands for, read the first time the
// value is named and remembered after.
//
// Read where it is named rather than where it is declared, for the reason a
// constant is: the declaration is in the tables long before the types a value
// may be written in terms of are, and a value nobody names asks nothing of the
// program. `at` is where the reader wrote the name, so what the value turns out
// to be is complained about there.
type_value_node :: fn(mut p: Parser, index: i64, at: i64) -> i64 {
    entry := arena_at(p.type_values, index)
    if (entry.node != (-1)) {
        return entry.node
    }
    ty := entry.ty
    name_off := entry.name_off
    name_len := entry.name_len
    saved := p.ti
    saved_expected := p.expected_type
    p.ti = entry.token
    p.expected_type = ty
    node := parse_expr(p)
    p.ti = saved
    p.expected_type = saved_expected
    // A number has no type of its own until something gives it one, and this
    // is what gives it one: the type it is declared under rides on the node,
    // the way a bit of a set carries the set it is a bit of. Without it
    // `Key::Left` would be the number 80 wherever it was written.
    mut written_num := arena_at(p.arena, node)
    if (written_num.kind == NodeKind::Num && written_num.b == 0
        && is_integer(ty)) {
        written_num.b = ty + 1
    }
    held := type_of(p, node)
    if (held != ty) {
        report_where(p.modules, p.src, at)
        report("a value named under a type is a value of that type, so '")
        report_type_name(p, ty)
        report("::")
        report_src(p.src, name_off, name_len)
        report("' is a ")
        report_type_name(p, ty)
        report(" and this is a ")
        report_type_name(p, held)
        frost_rt_recover_escape()
    }
    mut written := arena_at(p.type_values, index)
    written.node = node
    node
}

// `InitFlags :: flags u32 { Video :: 32 }`, a named set of bits with
// a type of its own. The type is a distinct one over the written integer, so
// everything that already knows what a distinct type is needs no change, and
// the names go in the bit table under it. The word is not a keyword, so what
// says this is a declaration is the shape: the word, a scalar type, a brace.
parse_flags :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    advance(p)
    advance(p)
    advance(p)
    repr_offset := cur_off(p)
    repr := parse_type(p)
    if (is_integer(repr) == false) {
        report_where(p.modules, p.src, repr_offset)
        report("'")
        report_src(p.src, name_offset, name_length)
        report("' is a set of bits, so it is written over an integer type; '")
        report_type_name(p, repr)
        report("' is not one")
        frost_rt_recover_escape()
    }
    ty := distinct_type(repr, p.type_aliases.count)
    arena_push(
        p.type_aliases,
        ConstDef {
            name_off = name_offset,
            name_len = name_length,
            value = ty,
            kind = CONST_INT,
            count = 0
        },
    )
    advance(p)
    // What a bit takes when it states no number. The first is 1 and each bit
    // that is one bit doubles it, so a run of bare names is 1, 2, 4, 8. A
    // number that is not one bit (`None :: 0`, an `All :: 15` closing a set)
    // leaves it where it stood, which is what lets those open and close a
    // block of bare names.
    mut counter: i64 = 1
    width := integer_bits(repr)
    mut count: i64 = 0
    // A bit is declared the way every value named under a type is, with `::`,
    // and separated from the next by the line it is on. What a bit may hold is
    // the difference between the two blocks: a number a C header fixed, rather
    // than an expression, and a bit may hold nothing at all and take the
    // number its place gives it.
    while (cur(p) != TokenKind::Rbrace) {
        if (cur(p) == TokenKind::Eof) {
            report_where(p.modules, p.src, name_offset)
            report("the bits '")
            report_src(p.src, name_offset, name_length)
            report("' names are written inside braces, and this block is not closed")
            frost_rt_recover_escape()
        }
        // A bare name has no `::` to end it, so where one bit stops and the
        // next starts is the line, which is what separates one declaration
        // from the next everywhere else in the language.
        if (count > 0 && on_same_line(p)) {
            report_where(p.modules, p.src, cur_off(p))
            report(
                "a set of bits names each of them on a line of its own, and this one follows another"
            )
            frost_rt_recover_escape()
        }
        if (cur(p) != TokenKind::Ident) {
            report_where(p.modules, p.src, cur_off(p))
            report(
                "a set of bits names each of them with a name, and this is not one"
            )
            frost_rt_recover_escape()
        }
        bit_off := cur_off(p)
        bit_len := cur_len(p)
        advance(p)
        mut value: i64 = counter
        if (cur(p) == TokenKind::Coloncolon && on_same_line(p)) {
            advance(p)
            if (cur(p) != TokenKind::Int) {
                report_where(p.modules, p.src, bit_off)
                report("a bit of '")
                report_src(p.src, name_offset, name_length)
                report("' is a number a C header wrote down, and this is not one")
                frost_rt_recover_escape()
            }
            value = cur_val(p)
            advance(p)
        } else if (on_same_line(p) && cur(p) != TokenKind::Rbrace
            && cur(p) != TokenKind::Ident) {
            report_where(p.modules, p.src, bit_off)
            report("a bit of a set is declared the way every value named under a type is, so '")
            report_src(p.src, bit_off, bit_len)
            report("' is written as '")
            report_src(p.src, bit_off, bit_len)
            report(" :: 32'")
            frost_rt_recover_escape()
        }
        if (bit_ordinal(value) > width) {
            report_where(p.modules, p.src, bit_off)
            report("a set over '")
            report_type_name(p, repr)
            report("' holds ")
            report_int(width)
            report(" bits, and '")
            report_src(p.src, bit_off, bit_len)
            report("' is the ")
            report_ordinal(bit_ordinal(value))
            frost_rt_recover_escape()
        }
        held := flag_bit_holding(p, ty, value)
        if (held >= 0) {
            entry := arena_at(p.flag_bits, held)
            report_where(p.modules, p.src, bit_off)
            report("each bit of a set holds a number of its own, and '")
            report_src(p.src, bit_off, bit_len)
            report("' holds the same one as '")
            report_src(p.src, entry.name_off, entry.name_len)
            report("'")
            frost_rt_recover_escape()
        }
        if (value > 0 && one_bit(value)) {
            counter = value * 2
        }
        record_flag_bit(p, ty, bit_off, bit_len, value)
        count = count + 1
    }
    advance(p)
}

// `name :: Type { field = value }`, a constant whose value is a struct. The
// literal is parsed here and kept as a node, and naming the constant anywhere
// writes that node out again, so the value exists wherever it is used and
// nowhere else. This is what a capability bundle is declared as.
parse_value_const :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    check_name_is_free(p, name_offset, name_length)
    advance(p)
    advance(p)
    value := parse_expr(p)
    arena_push(
        p.value_consts,
        ConstDef {
            name_off = name_offset,
            name_len = name_length,
            value = value,
            kind = CONST_INT,
            count = 0
        },
    )
}

parse_const :: fn(mut p: Parser) {
    name_offset := cur_off(p)
    name_length := cur_len(p)
    check_name_is_free(p, name_offset, name_length)
    advance(p)
    advance(p)
    // A value that calls something is worked out over the tokens rather than
    // over a parse of them. The callee's signature has not been read yet, so
    // reading the arguments against it would type them by a signature that is
    // not there.
    // A value that calls something, reads an item out of a run, or reads a
    // field is worked out over the tokens rather than over a parse of them.
    // The callee's signature has not been read yet, so reading the arguments
    // against it would type them by a signature that is not there.
    //
    // A shape that only might fold, a run or a set of named values written
    // out, is tried quietly: what comes of it is recorded where it worked and
    // the declaration is left for the value-constant pass where it did not.
    if (const_fold_ahead(p) || const_call_ahead(p)) {
        at := cur_off(p)
        resume := p.ti
        asked := const_asks_folding(p)
        if (asked == false) {
            p.const_quiet = p.const_quiet + 1
        }
        p.const_failed = 0
        p.const_needs_layout = 0
        held := const_expr_here(p, at)
        if (asked == false) {
            p.const_quiet = p.const_quiet - 1
        }
        if (p.const_failed == 0) {
            register_const_value(p, name_offset, name_length, held)
            return
        }
        // One that asked a type what it measures is set aside, not refused. It
        // is worked out again once the types have been read, which is where a
        // layout has an answer, and refused there if it still has none.
        if (p.const_needs_layout == 1) {
            arena_push(p.const_deferred, resume - 2)
            p.const_needs_layout = 0
        }
        p.ti = resume
        skip_declaration(p)
        return
    }
    value_node := parse_expr(p)
    value := fold_const(p, value_node)
    register_const(p, name_offset, name_length, value)
}

// The node a worked-out value writes out to, so what a compile-time call
// answered reaches the program the way writing it there would. A run and a set
// of named values are built item by item out of what the evaluator holds.
folded_const_node :: fn(
    mut p: Parser,
    kind: i64,
    value: i64,
    count: i64
) -> i64 {
    if (kind == CONST_BOOL) {
        return new_node(p, NodeKind::Num, 0, TY_BOOL + 1, value)
    }
    if (kind == CONST_TEXT) {
        return new_named_node(p, NodeKind::StrLit, 0, value, count)
    }
    if (kind == CONST_ARRAY) {
        mut head: i64 = -1
        mut tail: i64 = -1
        mut i: i64 = 0
        while (i < count) {
            item := arena_at(p.const_items, value + i)
            item_kind := item.kind
            item_value := item.value
            item_count := item.count
            held := folded_const_node(p, item_kind, item_value, item_count)
            element := new_node(p, NodeKind::Arg, held, 0, 0)
            if (head == (-1)) {
                head = element
            } else {
                set_next(p, tail, element)
            }
            tail = element
            i = i + 1
        }
        made := new_node(p, NodeKind::ArrayLit, head, 0, 0)
        literal := arena_at(p.arena, made)
        literal.c = count
        return made
    }
    if (kind == CONST_RECORD) {
        record := arena_at(p.const_records, value)
        type_off := record.name_off
        type_len := record.name_len
        start := record.start
        fields := record.count
        mut head: i64 = -1
        mut tail: i64 = -1
        mut i: i64 = 0
        while (i < fields) {
            item := arena_at(p.const_items, start + i)
            item_kind := item.kind
            item_value := item.value
            item_count := item.count
            name_off := item.name_off
            name_len := item.name_len
            held := folded_const_node(p, item_kind, item_value, item_count)
            init := new_field_init(p, held, name_off, name_len)
            if (head == (-1)) {
                head = init
            } else {
                set_next(p, tail, init)
            }
            tail = init
            i = i + 1
        }
        // The type is resolved the way a literal written here resolves it, so
        // the value reaches the program as the one the reader would have
        // written. A template names no instance on its own, and the instance is
        // read off the field values, which are already in hand.
        struct_ty := resolve_lit_type(p, type_off, type_len)
        refuse_unknown_lit_type(p, struct_ty, type_off, type_len)
        if (struct_ty == TY_INFER) {
            made := instantiate_inferred(
                p,
                generic_index_for(p, type_off, type_len),
                head,
                type_off,
                type_len
            )
            return new_struct_lit(p, made, head, type_off)
        }
        return new_struct_lit(p, struct_ty, head, type_off)
    }
    new_node(p, NodeKind::Num, 0, 0, value)
}

// The constant declared at this name, where what it worked out to is more than
// a whole number, as a node every use of the name writes out again.
register_folded_const :: fn(mut p: Parser, off: i64, len: i64) {
    mut i: i64 = 0
    while (i < p.const_aggregates.count) {
        entry := arena_at(p.const_aggregates, i)
        if (entry.name_off == off) {
            kind := entry.kind
            value := entry.value
            count := entry.count
            node := folded_const_node(p, kind, value, count)
            arena_push(
                p.value_consts,
                ConstDef {
                    name_off = off,
                    name_len = len,
                    value = node,
                    kind = CONST_INT,
                    count = 0
                },
            )
            return
        }
        i = i + 1
    }
}

// A constant whatever kind it turned out to be. A whole number lands in the
// table every other reader already looks at; the rest carry their kind beside
// it, and only the compile-time evaluator reads those.
register_const_value :: fn(
    mut p: Parser,
    off: i64,
    len: i64,
    held: ConstValue
) {
    if (held.kind == CONST_INT) {
        register_const(p, off, len, held.value)
        return
    }
    arena_push(
        p.const_aggregates,
        ConstDef {
            name_off = off,
            name_len = len,
            value = held.value,
            kind = held.kind,
            count = held.count
        },
    )
}

// `test "name" { ... }`. The body becomes an ordinary function under a name the
// compiler makes up, so everything after the parser treats it as one, and the
// name it was given is kept beside it for the runner to print.
parse_test :: fn(mut p: Parser) -> i64 {
    advance(p)
    name_off := cur_off(p)
    name_len := cur_len(p)
    advance(p)
    // A `test` whose body does not open where one should says what is in the
    // way. Without this the words after the name were read as an expression
    // and the reader was told a struct had no field named after the first
    // thing inside the body.
    if (cur(p) == TokenKind::KwUses) {
        report_where(p.modules, p.src, cur_off(p))
        report("a `test` body is run by the test runner, which supplies nothing, so a test draws no capability")
        frost_rt_recover_escape()
    }
    // A test body is a body like any other and names no type parameter, so the
    // state a generic template left behind is cleared here the way parsing a
    // function clears it. Without this, a `test` written under a template read
    // every type name as that template's unbound parameter: `sizeof(Point)` in
    // a test below a `fn($T: Type)` answered the placeholder's width rather
    // than the struct's.
    p.type_param_off = 0
    p.type_param_len = 0
    p.saw_type_param = 0
    p.tparam_is_slot = 0
    p.tparam_fallback = -1
    p.tparam_called = 0
    p.bound_token = -1
    p.decl_pack_off = 0
    p.decl_pack_len = 0
    p.decl_pack_fixed = 0
    p.decl_pack_format = -1
    p.unbound_pack_for = 0
    p.decl_format_len = 0
    fn_name_off := synth_numbered(p, "__test", p.tests.count)
    fn_name_len := 6 + digits_in(p.tests.count)
    fn_index := intern_global(p, fn_name_off, fn_name_len)
    mark_defined(p, fn_index)
    set_ret_type(p, fn_index, TY_VOID)
    set_params(p, fn_index, -1)
    arena_push(
        p.tests,
        TestCase {
            name_off = name_off,
            name_len = name_len,
            fn_index = fn_index
        }
    )
    // A test body is a function body and defers like one. Without its own mark
    // a `defer` written in a test was left on the list for whatever was parsed
    // next to run.
    saved_defer_base := p.defer_base
    saved_defer_depth := p.defer_depth
    p.defer_base = p.defers.count
    p.defer_depth = p.block_depth + 1
    mut body := parse_block(p)
    check_defer_shadowing(p)
    body = defer_trailing(p, body, TY_VOID)
    p.defers.count = p.defer_base
    p.defer_base = saved_defer_base
    p.defer_depth = saved_defer_depth
    made := new_func_node(p, body, -1, fn_index, 0)
    node := arena_at(p.arena, made)
    // A test is marked here rather than looked up later, which is what lets a
    // build that is not running tests leave them out entirely.
    node.c = 2
    // Where the test was written, rather than wherever the cursor ended up
    // after its body. The name it was given is synthesized and sits past every
    // module, so this is what says which module the test belongs to, and a
    // per-module build emits it there.
    node.pos = name_off
    made
}

// Every type this file declares, by name, before any body is read. A type name
// is resolved where it is written, so a field or a literal naming a type
// declared further down the file would otherwise resolve to nothing and be
// taken for an i64: `sizeof` then agrees by coincidence and the program is
// silently wrong. The entries here hold the name and nothing else until the
// declaration is reached.
predeclare_types :: fn(mut p: Parser) {
    start := p.ti
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace) {
            depth = depth - 1
        } else if (depth == 0 && kind == TokenKind::Ident
            && peek_kind(p, 1) == TokenKind::Coloncolon) {
            mut at: i64 = 2
            if (peek_kind(p, at) == TokenKind::KwLinear) {
                at = at + 1
            }
            if (at_packed_struct(p, at)) {
                at = at + 1
            }
            named := peek_kind(p, at)
            if (named == TokenKind::KwStruct || named == TokenKind::KwEnum) {
                mut generic: i64 = 0
                if (peek_kind(p, at + 1) == TokenKind::Lparen) {
                    generic = 1
                }
                mut holds_variants: i64 = 0
                if (named == TokenKind::KwEnum) {
                    holds_variants = 1
                }
                arena_push(
                    p.structs,
                    StructDef {
                        name_off = cur_off(p),
                        name_len = cur_len(p),
                        field_head = -1,
                        is_generic = generic,
                        tparam_off = 0,
                        tparam_len = 0,
                        field_token = 0,
                        instance_id = -1,
                        is_linear = 0,
                        emitted = 0,
                        xparam_start = 0,
                        xparam_count = 0,
                        tparam_fallback = -1,
                        is_enum = holds_variants,
                        declared = 0,
                        is_multi = 0,
                        is_result = 0,
                        is_packed = 0
                    },
                )
            }
        }
        advance(p)
    }
    p.ti = start
}

// The entry the pre-pass made for this name, or -1. The declarations are
// reached in the order the pre-pass saw them, so the first entry still holding
// only a name is this declaration's.
predeclared_index :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.declared == 0 && entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
        i = i + 1
    }
    -1
}

// Put a declaration in the table, filling in the entry the pre-pass made for
// it. A type the pre-pass did not see, which is one this compiler synthesizes,
// takes an entry of its own.
record_struct :: fn(mut p: Parser, index: i64, made: StructDef) -> i64 {
    if (index < 0) {
        return arena_push(p.structs, made)
    }
    entry := arena_at(p.structs, index)
    entry.field_head = made.field_head
    entry.is_generic = made.is_generic
    entry.tparam_off = made.tparam_off
    entry.tparam_len = made.tparam_len
    entry.field_token = made.field_token
    entry.is_linear = made.is_linear
    entry.xparam_start = made.xparam_start
    entry.xparam_count = made.xparam_count
    entry.is_enum = made.is_enum
    entry.is_packed = made.is_packed
    entry.declared = 1
    index
}

// A struct holding a resource is a resource, and a field may name a type
// declared after the struct that holds it, whose own obligation was not known
// when that struct was recorded. This settles the question for every type at
// once, going round until nothing changes, so the answer does not depend on
// the order the declarations were written in.
settle_linear_types :: fn(mut p: Parser) {
    mut changed: i64 = 1
    while (changed == 1) {
        changed = 0
        mut i: i64 = 0
        while (i < p.structs.count) {
            entry := arena_at(p.structs, i)
            head := entry.field_head
            was := entry.is_linear
            // The struct a return type list stands for is left out. It is the
            // one aggregate a program cannot hold: the parser builds it at a
            // `return`, takes it apart at the binding that reads it, and reads
            // every field exactly once on the way. So its obligation is the sum
            // of its fields' obligations, and each of those lands on a name the
            // binding introduced, which is tracked. Counted as a resource it was
            // one nothing consumes, and a list carrying a `linear` value was
            // refused however correctly the caller consumed it.
            if (entry.is_multi == 1) {
                was = 1
            }
            if (was == 0 && holds_linear(p, head, 0) == 1) {
                again := arena_at(p.structs, i)
                again.is_linear = 1
                changed = 1
            }
            i = i + 1
        }
    }
}

// Whether the parser is at the start of a top-level declaration, which is a
// name followed by `::`, or a `test` block.
at_declaration_start :: fn(mut p: Parser) -> bool {
    if (cur(p) == TokenKind::KwTest) {
        return true
    }
    cur(p) == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Coloncolon
}

// Whether the declaration here is a compile-time integer constant. An array
// length may name one, so these are read before the types are.
at_const_declaration :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident || peek_kind(p, 1) != TokenKind::Coloncolon) {
        return false
    }
    third := peek_kind(p, 2)
    if (third == TokenKind::Int || third == TokenKind::Lparen) {
        return true
    }
    // A negative one, which is what a sentinel is written as now that a prefix
    // minus works. The number after the sign is what makes it a constant rather
    // than the start of something else.
    if (third == TokenKind::Minus && peek_kind(p, 3) == TokenKind::Int) {
        return true
    }
    if (third != TokenKind::Ident) {
        return false
    }
    // A call the compiler works out, `LANES :: round_up(300, 64)`, an item of
    // a run, `SLOTS :: TABLE[2]`, or a field of a set of named values,
    // `Y :: ORIGIN.y`. What follows the name is what says so, and whether the
    // name reaches anything is settled where the value is worked out.
    fourth := peek_kind(p, 3)
    if (fourth == TokenKind::Lparen || fourth == TokenKind::Lbracket
        || fourth == TokenKind::Dot) {
        return true
    }
    if (is_arith_op(fourth)) {
        return true
    }
    // `DEPTH :: TEXTURE_DEPTH24`, a name standing for a name. What follows used
    // to have to be an operator, because `Enum::Variant` is these same tokens
    // and is an expression. Asking whether the second name is already a
    // constant tells them apart without one: a variant's type is not, and a
    // constant this one is written in terms of has been read by the time this
    // is, since a constant may only name one written above it.
    is_const(p, peek_off(p, 2), peek_len(p, 2))
}

// Whether `packed struct` stands this far along. `packed` is a word rather
// than a keyword, so the `struct` after it is what says this is a declaration
// head and not a name.
at_packed_struct :: fn(mut p: Parser, at: i64) -> bool {
    peek_is_word(p, at, "packed") && peek_kind(p, at + 1) == TokenKind::KwStruct
}

// Whether the declaration here introduces a type rather than a value.
at_type_declaration :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident || peek_kind(p, 1) != TokenKind::Coloncolon) {
        return false
    }
    third := peek_kind(p, 2)
    if (third == TokenKind::KwEnum || third == TokenKind::KwStruct
        || third == TokenKind::KwLinear || third == TokenKind::KwDistinct) {
        return true
    }
    if (at_packed_struct(p, 2)) {
        return true
    }
    (third == TokenKind::Ident && peek_is_word(p, 2, "flags")
        && peek_kind(p, 4) == TokenKind::Lbrace)
}

// Whether the declaration here is one the compile-time evaluator should try,
// over and above the integer constants. A run, a run of bytes, or a set of
// named values: each is worked out where it can be, and left for the
// value-constant pass where it cannot.
at_folded_declaration :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident
        || peek_kind(p, 1) != TokenKind::Coloncolon) {
        return false
    }
    third := peek_kind(p, 2)
    if (third == TokenKind::Lbracket || third == TokenKind::Str) {
        return true
    }
    (third == TokenKind::Ident && peek_kind(p, 3) == TokenKind::Lbrace
        && is_type_name(p, peek_off(p, 2), peek_len(p, 2)))
}

// Advance past the declaration here without reading it, which is what lets one
// walk of the file take the type declarations and the next take the rest.
skip_declaration :: fn(mut p: Parser) {
    advance(p)
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace) {
            // A brace this walk did not open closes the body the declaration
            // was written inside of, so the declaration ends here. Stepping
            // over it drove the count below zero, where no later brace could
            // bring it back, and the walk ate the rest of the file: a function
            // declared in a body took every line after it along with it, and
            // the cursor came to rest past the last token.
            if (depth == 0) {
                return
            }
            depth = depth - 1
        } else if (depth == 0 && at_declaration_start(p)) {
            return
        }
        advance(p)
    }
}

// Every compile-time integer constant, before the types that may size an array
// by one.
//
// A constant may name one written below it, the way a function may call one and
// a struct may hold one. A `Name :: OtherName` whose other name is not a
// constant yet is set aside rather than read here, and the ones set aside are
// worked out again while each round settles something new, so which of the two
// is written first stops mattering. One that never settles is left alone: the
// declaration pass refuses it where it is written, which is where the reader
// has to change it.
parse_constant_declarations :: fn(mut p: Parser) {
    while (cur(p) != TokenKind::Eof) {
        if (at_const_declaration(p) || at_folded_declaration(p)) {
            // With an escape armed, the way the declaration loop reads its
            // own. A value that cannot be worked out ends this constant and
            // the pass reads the next, so a program is told everything that is
            // wrong with it rather than the first thing.
            mut turn := RecoverTurn {
                parser = unsafe { ptr_cast($u8, ptr_to(p)) },
                item = -1,
                block_depth = p.block_depth,
                unsafe_depth = p.unsafe_depth,
                defer_depth = p.defer_depth,
                ti = p.ti
            }
            escaped := unsafe {
                frost_rt_recover_run(
                    parse_constant_guarded,
                    ptr_cast($u8, ptr_to(turn))
                )
            }
            if (escaped == 1) {
                p.block_depth = turn.block_depth
                p.unsafe_depth = turn.unsafe_depth
                p.defer_depth = turn.defer_depth
                p.ti = turn.ti
                skip_declaration(p)
            }
        } else {
            // A `Name :: OtherName` at the top level, where the other name is
            // no constant yet. It may be one written further down, so the
            // declaration's own token is kept and read again below.
            if (cur(p) == TokenKind::Ident
                && peek_kind(p, 1) == TokenKind::Coloncolon
                && peek_kind(p, 2) == TokenKind::Ident
                && peek_kind(p, 3) != TokenKind::Coloncolon) {
                arena_push(p.const_pending, p.ti)
            }
            skip_declaration(p)
        }
    }
    settle_pending_constants(p)
}

// The constants set aside for naming one that had not been read yet. Each round
// reads every one still unsettled, and the rounds go on while one of them
// settles, so a chain of names settles from its end. Nothing is reported here:
// one that never settles is refused where it is written, by the pass that reads
// the declaration.
settle_pending_constants :: fn(mut p: Parser) {
    mut settled: i64 = -1
    while (p.consts.count != settled) {
        settled = p.consts.count
        mut i: i64 = 0
        while (i < p.const_pending.count) {
            p.ti = arena_at(p.const_pending, i)
            name_off := cur_off(p)
            name_len := cur_len(p)
            value_off := peek_off(p, 2)
            value_len := peek_len(p, 2)
            if (is_const(p, name_off, name_len) == false
                && is_const(p, value_off, value_len)) {
                check_name_is_free(p, name_off, name_len)
                register_const(
                    p,
                    name_off,
                    name_len,
                    const_value(p, value_off, value_len)
                )
            }
            i = i + 1
        }
    }
}

parse_constant_guarded :: fn(raw: ^u8) {
    turn := unsafe { ptr_cast($RecoverTurn, raw) }
    parser := unsafe { ptr_cast($Parser, turn^.parser) }
    unsafe { parse_const(parser^) }
}

// What one `sizeof(T)` and its siblings measure, left at the call's own token
// for the evaluator to read back. The cursor is on the name and is left past
// the closing parenthesis.
note_one_layout :: fn(mut p: Parser) {
    at := p.ti
    name_off := cur_off(p)
    name_len := cur_len(p)
    advance(p)
    advance(p)
    ty := parse_type(p)
    if (cur(p) == TokenKind::Rparen) {
        advance(p)
    }
    mut kind: i64 = CONST_INT
    mut value: i64 = 0
    mut count: i64 = 0
    if (str_range_eq(p.src, name_off, name_len, "sizeof")) {
        value = type_size(p, ty)
    } else if (str_range_eq(p.src, name_off, name_len, "alignof")) {
        value = align_of(p, ty)
    } else if (str_range_eq(p.src, name_off, name_len, "field_count")) {
        value = struct_field_count(p, ty)
    } else {
        kind = CONST_TEXT
        held_off, held_len := synth_type_name(p, ty)
        value = held_off
        count = held_len
    }
    arena_push(
        p.const_layouts,
        ConstLayout { at = at, kind = kind, value = value, count = count }
    )
}

// Every measurement one declaration's value asks for, worked out and left where
// it was asked. The cursor is on the value and is left wherever the walk ended.
note_layout_answers :: fn(mut p: Parser) {
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket
            || kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket
            || kind == TokenKind::Rbrace) {
            depth = depth - 1
        } else if (depth == 0 && at_declaration_start(p)) {
            return
        }
        if (kind == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Lparen
            && names_a_measurement(p, cur_off(p), cur_len(p))) {
            note_one_layout(p)
        } else {
            advance(p)
        }
    }
}

// Every constant set aside for asking a type what it measures. The types have
// been read by now, so each measurement is worked out and left at the call that
// asked for it, and the value is worked out again over those answers.
parse_layout_constants :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.const_deferred.count) {
        mut turn := RecoverTurn {
            parser = unsafe { ptr_cast($u8, ptr_to(p)) },
            item = -1,
            block_depth = p.block_depth,
            unsafe_depth = p.unsafe_depth,
            defer_depth = p.defer_depth,
            ti = arena_at(p.const_deferred, i)
        }
        // With an escape armed, the way every other pass reads its own. A
        // measurement that has no answer even now says so and ends this
        // constant; unarmed, it left through an escape nothing caught and the
        // compile stopped without a word.
        unsafe {
            frost_rt_recover_run(
                parse_layout_guarded,
                ptr_cast($u8, ptr_to(turn))
            )
        }
        p.const_layouts_ready = 0
        i = i + 1
    }
}

parse_layout_guarded :: fn(raw: ^u8) {
    turn := unsafe { ptr_cast($RecoverTurn, raw) }
    parser := unsafe { ptr_cast($Parser, turn^.parser) }
    at := unsafe { turn^.ti }
    unsafe { settle_one_layout_constant(parser^, at) }
}

// One constant that asked a type what it measures, worked out now that the
// types have been read. `at` is the declaration's own token.
settle_one_layout_constant :: fn(mut p: Parser, at: i64) {
    p.ti = at
    name_offset := cur_off(p)
    name_length := cur_len(p)
    advance(p)
    advance(p)
    note_layout_answers(p)
    p.ti = at + 2
    p.const_layouts_ready = 1
    p.const_failed = 0
    held := const_expr_here(p, cur_off(p))
    p.const_layouts_ready = 0
    if (p.const_failed == 0) {
        register_const_value(p, name_offset, name_length, held)
    }
}

// Every constant whose value came out as more than a whole number, as the node
// that value writes out to. A whole number lands in the table the size parser
// reads; the rest reach the program where the name is read, the way a literal
// written there would. This runs after the types, since a set of named values
// names one.
parse_folded_constants :: fn(mut p: Parser) {
    while (cur(p) != TokenKind::Eof) {
        if (at_const_declaration(p)) {
            register_folded_const(p, cur_off(p), cur_len(p))
        }
        skip_declaration(p)
    }
}

// Every type declaration, before any function body is read. A body may write a
// literal of a type declared below it, and the fields are checked where the
// literal is written, so the bodies of the types have to be in hand first.
parse_type_declarations :: fn(mut p: Parser) {
    while (cur(p) != TokenKind::Eof) {
        if (at_type_declaration(p) == false) {
            skip_declaration(p)
        } else {
            third := peek_kind(p, 2)
            if (third == TokenKind::KwEnum
                || (third == TokenKind::KwLinear
                    && peek_kind(p, 3) == TokenKind::KwEnum)) {
                parse_enum(p)
            } else if (third == TokenKind::KwStruct
                || third == TokenKind::KwLinear
                || at_packed_struct(p, 2)) {
                parse_struct(p)
            } else if (third == TokenKind::KwDistinct) {
                parse_distinct(p)
            } else {
                parse_flags(p)
            }
        }
    }
}

// One declaration of the top-level loop, answering the item to append or -1
// for a form that emits nothing here: a type or constant already read by the
// pre-passes, or a generic recorded for monomorphization. Split out so the
// loop can run it with an escape armed and a fault ends this declaration
// rather than the compile.
// Whether a `Name :: OtherName` is the whole declaration, which is what the
// token after the other name says: the end of the file, or the head of the
// next declaration.
bare_name_ends_declaration :: fn(mut p: Parser) -> bool {
    after := peek_kind(p, 3)
    if (after == TokenKind::Eof || after == TokenKind::KwTest
        || after == TokenKind::KwImport || after == TokenKind::KwExport) {
        return true
    }
    (after == TokenKind::Ident && peek_kind(p, 4) == TokenKind::Coloncolon)
}

parse_one_declaration :: fn(mut p: Parser) -> i64 {
    if ((cur(p) != TokenKind::Ident
            || peek_kind(p, 1) != TokenKind::Coloncolon)
        && cur(p) != TokenKind::KwTest) {
        // A token no declaration can start, or a name with no `::` after it.
        // Say so where it is written; the loop skips to the next head and
        // keeps reading.
        report_where(p.modules, p.src, cur_off(p))
        // A binding written here is a reader reaching for state every function
        // can see. There are none and there will be none, so the three shapes
        // that carry state instead are named where the reach happens.
        if (cur(p) == TokenKind::KwMut) {
            report("a binding at the top level would be state every function ")
            report("can see, and there are none. What holds state is a `mut` ")
            report("parameter, a value the caller owns and passes down, or ")
            report("`uses` on the function and a `with` block around the call")
            frost_rt_recover_escape()
        }
        report("expected a declaration head, `import`, `export`, or `test`,")
        report(" found '")
        report_src(p.src, cur_off(p), cur_len(p))
        report("'")
        frost_rt_recover_escape()
    }
    third := peek_kind(p, 2)
    if (cur(p) == TokenKind::KwTest) {
        return parse_test(p)
    }
    refuse_literal_name(p, cur_off(p), cur_len(p))
    if (at_type_declaration(p)) {
        // Already read, before any body was.
        skip_declaration(p)
        return -1
    }
    if (third == TokenKind::KwExtern || third == TokenKind::KwSafe) {
        return parse_extern(p)
    }
    if (at_const_declaration(p)) {
        // A constant, whose value is an integer expression: a literal, a
        // parenthesized combination, or an earlier constant combined with
        // another by an operator. A bare `Name :: OtherName` is left alone,
        // so `Enum::Variant` is not read as a constant. Already read, with
        // the other constants, before the types.
        skip_declaration(p)
        return -1
    }
    // A constant whose value is a boolean. The words are names rather than
    // keywords, so they are told apart here instead of by their token kind.
    if (third == TokenKind::Ident
        && (peek_is_word(p, 2, "true") || peek_is_word(p, 2, "false"))) {
        parse_value_const(p)
        return -1
    }
    if (third == TokenKind::Ident
        && (peek_kind(p, 3) == TokenKind::Lbrace
            || peek_kind(p, 3) == TokenKind::Lt)) {
        // A constant whose value is a struct. The brace, or the generic
        // arguments before it, is what tells this from a bare
        // `Name :: OtherName`.
        parse_value_const(p)
        return -1
    }
    if (third == TokenKind::Str || third == TokenKind::Float
        || third == TokenKind::Lbracket
        || (third == TokenKind::Minus
            && peek_kind(p, 3) == TokenKind::Float)) {
        // A constant whose value is a literal this compiler folds no
        // arithmetic over. It is kept as the literal's node and written out
        // again wherever the name is read, so it reaches each use the way a
        // literal written there would, including the length a `str` or an
        // array carries.
        //
        // A sign in front of a float belongs here rather than with the
        // integer constants above, which fold to a number: the value stays
        // the literal's node and the minus is part of the expression parsed
        // into it. Without this a negative float constant was read as a
        // declaration this compiler does not know.
        parse_value_const(p)
        return -1
    }
    // `Type::NAME :: value` written at the top level. A value under a type is
    // declared in that type's own block, and read from the outside this is one
    // name declared twice, which is what the reader was told before.
    if (third == TokenKind::Ident && peek_kind(p, 3) == TokenKind::Coloncolon) {
        report_where(p.modules, p.src, cur_off(p))
        report(
            "a value under a type is declared in that type's own block, as in `Name :: struct { .. } { VALUE :: .. }`"
        )
        frost_rt_recover_escape()
    }
    // `Name :: OtherName`. The constant pass has settled it where the other
    // name is a constant, and where it is not the value is no value: a type's
    // name or a function's has none before the program runs, so this constant
    // has none either. Said at the name, which is the word that has to change.
    //
    // Only where the declaration ends there. `Id :: opaque i64` reads as this
    // shape and then runs on, and what runs on is a token no declaration
    // starts, which is what the loop below says about it.
    if (third == TokenKind::Ident) {
        if (bare_name_ends_declaration(p)) {
            report_where(p.modules, p.src, peek_off(p, 2))
            report("'")
            report_src(p.src, peek_off(p, 2), peek_len(p, 2))
            report("' is not a constant, so it cannot appear in a constant")
            frost_rt_recover_escape()
        }
        advance(p)
        advance(p)
        advance(p)
        return -1
    }
    if (third != TokenKind::KwFn && third != TokenKind::KwInline) {
        // Everything above is a form the language has. What follows the `::`
        // opens neither one of them nor a value, so it is named where it is
        // written: read as a function instead, it misparsed into a crash far
        // from the text that caused it.
        report_where(p.modules, p.src, peek_off(p, 2))
        if (can_begin_expression(third)) {
            report("expected a declaration head, `import`, `export`, or `test`,")
            report(" found '")
            report_src(p.src, peek_off(p, 2), peek_len(p, 2))
            report("'")
            frost_rt_recover_escape()
        }
        report(
            "a declaration is a value or one of `fn`, `struct`, `enum`, `distinct`, `flags`, `extern`, and this is '"
        )
        report_src(p.src, peek_off(p, 2), peek_len(p, 2))
        report("'")
        frost_rt_recover_escape()
    }
    // A function. Reset the type-parameter state, remember where it
    // starts, and parse it. If it turned out to reference a type
    // parameter it is a generic template, recorded for monomorphization
    // and kept out of the emitted program list.
    p.type_param_off = 0
    p.type_param_len = 0
    p.saw_type_param = 0
    p.tparam_is_slot = 0
    p.tparam_fallback = -1
    p.tparam_called = 0
    p.bound_token = -1
    p.decl_pack_off = 0
    p.decl_pack_len = 0
    p.decl_pack_fixed = 0
    p.decl_pack_format = -1
    p.unbound_pack_for = 0
    p.decl_format_len = 0
    start := p.ti
    item := parse_function(p)
    if (p.saw_type_param == 1) {
        node := arena_at(p.arena, item)
        fn_index := node.val
        tparam_off := p.type_param_off
        tparam_len := p.type_param_len
        record_generic_fn(
            p,
            fn_index,
            tparam_off,
            tparam_len,
            p.tparam_is_value,
            p.tparam_called,
            p.tparam_is_slot,
            p.xparam_start,
            p.xparam_count,
            start,
            p.bound_token,
            p.decl_pack_off,
            p.decl_pack_len,
            p.decl_pack_fixed,
            p.decl_pack_format,
            p.decl_format_off,
            p.decl_format_len
        )
        return -1
    }
    item
}

// The parser and the answer of one recovered turn, handed through the raw
// pointer the runtime's recovery runner takes, the way a thread body takes
// its job.
// The depths a half-parsed declaration can leave raised ride along, because
// an escape mid-`unsafe`, mid-`defer`, or mid-block leaves them where the
// fault found them and the loop has to put them back before the next head.
RecoverTurn :: struct {
    parser: ^u8,
    item: i64,
    block_depth: i64,
    unsafe_depth: i64,
    defer_depth: i64,
    // Where the declaration began. A compile-time call moves the cursor into
    // the body it is running and puts it back when it answers, and a fault
    // leaves through the escape rather than through the putting back. Without
    // this the cursor stayed inside that body, the next synchronize found the
    // same declaration again, and the loop reported one fault forever.
    ti: i64,
}

parse_declaration_guarded :: fn(raw: ^u8) {
    turn := unsafe { ptr_cast($RecoverTurn, raw) }
    parser := unsafe { ptr_cast($Parser, turn^.parser) }
    unsafe { parser^.dot_noted = 0 }
    item := unsafe { parse_one_declaration(parser^) }
    unsafe { turn^.item = item }
}

// After a fault, skip to the next token that begins a declaration: a name
// followed by `::`, or a `test` block. Always makes progress, so recovery
// cannot loop.
synchronize_declaration :: fn(mut p: Parser) {
    if (cur(p) != TokenKind::Eof) {
        advance(p)
    }
    while (cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::KwTest) {
            return
        }
        if (cur(p) == TokenKind::Ident
            && peek_kind(p, 1) == TokenKind::Coloncolon) {
            return
        }
        advance(p)
    }
}

// The three the build is for, as constants a program may read and a `when` may
// choose on. They are declared here rather than in a file every program would
// have to import, since which machine a build is for is not something a library
// hands out. Their names are written into the source buffer, so they are looked
// up by the same byte comparison every other name is.
predeclare_target :: fn(mut p: Parser) {
    which := frost_rt_target_os()
    mut i: i64 = 0
    while (i < 3) {
        at := p.synth_next
        if (i == 0) {
            synth_bytes(p, "TARGET_WINDOWS")
        } else if (i == 1) {
            synth_bytes(p, "TARGET_LINUX")
        } else {
            synth_bytes(p, "TARGET_MACOS")
        }
        mut held: i64 = 0
        if (which == i) {
            held = 1
        }
        register_const(p, at, p.synth_next - at, held)
        arena_at(p.consts, p.consts.count - 1).kind = CONST_BOOL
        i = i + 1
    }
}

// Which the name stands for, or -1 for a name that is not one of the three. A
// `when` chooses on what the build is for, which is known before anything is
// read, so this is the whole vocabulary a condition is written over.
when_target :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    which := frost_rt_target_os()
    mut wanted: i64 = -1
    if (str_range_eq(p.src, off, len, "TARGET_WINDOWS")) { wanted = 0 }
    if (str_range_eq(p.src, off, len, "TARGET_LINUX")) { wanted = 1 }
    if (str_range_eq(p.src, off, len, "TARGET_MACOS")) { wanted = 2 }
    if (wanted < 0) {
        return -1
    }
    if (which == wanted) {
        return 1
    }
    0
}

when_term :: fn(mut p: Parser, at: i64) -> (held: i64, next: i64) {
    token := arena_at(p.tokens, at)
    if (token.kind == TokenKind::Bang) {
        inner, past := when_term(p, at + 1)
        return 1 - inner, past
    }
    if (token.kind == TokenKind::Lparen) {
        inner, past := when_or(p, at + 1)
        if (arena_at(p.tokens, past).kind == TokenKind::Rparen) {
            return inner, past + 1
        }
        return inner, past
    }
    if (token.kind != TokenKind::Ident) {
        report_where(p.modules, p.src, token.off)
        report("a `when` chooses on the target, so its condition is the target constants joined by `&&`, `||` and `!`")
        frost_rt_recover_escape()
    }
    held := when_target(p, token.off, token.len)
    if (held < 0) {
        report_where(p.modules, p.src, token.off)
        report_fmt(
            "'{}' is not one of the targets a `when` chooses on, ",
            source_text(p.src, token.off, token.len)
        )
        report("which are TARGET_WINDOWS, TARGET_LINUX and TARGET_MACOS")
        frost_rt_recover_escape()
    }
    return held, at + 1
}

when_and :: fn(mut p: Parser, at: i64) -> (held: i64, next: i64) {
    mut held, mut past := when_term(p, at)
    while (arena_at(p.tokens, past).kind == TokenKind::Andand) {
        right, after := when_term(p, past + 1)
        if (right == 0) { held = 0 }
        past = after
    }
    return held, past
}

when_or :: fn(mut p: Parser, at: i64) -> (held: i64, next: i64) {
    mut held, mut past := when_and(p, at)
    while (arena_at(p.tokens, past).kind == TokenKind::Oror) {
        right, after := when_and(p, past + 1)
        if (right == 1) { held = 1 }
        past = after
    }
    return held, past
}

// Past the token closing a run opened at `at`.
past_run :: fn(
    mut p: Parser,
    at: i64,
    open: TokenKind,
    close: TokenKind
) -> i64 {
    mut depth: i64 = 0
    mut i := at
    while (i < p.tokens.count) {
        kind := arena_at(p.tokens, i).kind
        if (kind == open) {
            depth = depth + 1
        } else if (kind == close) {
            depth = depth - 1
            if (depth == 0) {
                return i + 1
            }
        }
        i = i + 1
    }
    p.tokens.count
}

// Whether `when` opens a compile-time conditional at this token. The word is
// not reserved, so a program may still call a function by that name, and what
// tells them apart is that a call is not followed by a block.
opens_when :: fn(mut p: Parser, at: i64) -> bool {
    if (at + 1 >= p.tokens.count) {
        return false
    }
    token := arena_at(p.tokens, at)
    if (token.kind != TokenKind::KwWhen) {
        return false
    }
    arena_at(p.tokens, at + 1).kind == TokenKind::Lparen
}

// Past the whole construct opening at `at`, however many `else when` arms it
// carries.
past_when :: fn(mut p: Parser, at: i64) -> i64 {
    after_condition := past_run(p, at + 1, TokenKind::Lparen, TokenKind::Rparen)
    after_block := past_run(
        p,
        after_condition,
        TokenKind::Lbrace,
        TokenKind::Rbrace
    )
    if (after_block < p.tokens.count
        && arena_at(p.tokens, after_block).kind == TokenKind::KwElse) {
        if (opens_when(p, after_block + 1)) {
            return past_when(p, after_block + 1)
        }
        return past_run(
            p,
            after_block + 1,
            TokenKind::Lbrace,
            TokenKind::Rbrace
        )
    }
    after_block
}

// A compile-time conditional, decided while the tokens are still tokens.
//
// The branch that is not taken is removed from the stream, so nothing after
// this reads it: no name is interned, no type is laid out, and the emitted
// output does not depend on it having been there. What the taken branch holds
// stands where the `when` stood, which is what lets one choose between
// declarations as well as between statements, and is why the block opens no
// scope of its own: a name bound inside one is bound for what follows it, the
// way a name written without the `when` would be.
resolve_when :: fn(mut p: Parser) {
    mut going: bool = true
    while (going) {
        mut at: i64 = -1
        mut i: i64 = 0
        while (i < p.tokens.count && at < 0) {
            if (opens_when(p, i)) {
                at = i
            }
            i = i + 1
        }
        if (at < 0) {
            going = false
        } else {
            settle_when(p, at)
        }
    }
    p.ti = 0
}

settle_when :: fn(mut p: Parser, at: i64) {
    after_condition := past_run(p, at + 1, TokenKind::Lparen, TokenKind::Rparen)
    holds, _unused := when_or(p, at + 2)
    after_block := past_run(
        p,
        after_condition,
        TokenKind::Lbrace,
        TokenKind::Rbrace
    )
    mut from: i64 = at
    mut to: i64 = at
    if (holds == 1) {
        from = after_condition + 1
        to = after_block - 1
    }
    mut past := after_block
    if (after_block < p.tokens.count
        && arena_at(p.tokens, after_block).kind == TokenKind::KwElse) {
        opens := after_block + 1
        if (opens_when(p, opens)) {
            past = past_when(p, opens)
            if (holds == 0) {
                from = opens
                to = past
            }
        } else {
            past = past_run(p, opens, TokenKind::Lbrace, TokenKind::Rbrace)
            if (holds == 0) {
                from = opens + 1
                to = past - 1
            }
        }
    }
    // The lines the branch came from, so the rule that every statement of a
    // block begins at the same column is not asked about them: they begin one
    // level in from the block they now belong to.
    if (to > from) {
        arena_push(
            p.when_lifted,
            LocalVar {
                name_off = arena_at(p.tokens, from).off,
                name_len = arena_at(p.tokens, to - 1).off,
                ty = 0,
                slot = 0
            }
        )
    }
    mut write: i64 = at
    mut read := from
    while (read < to) {
        copy_token(p, read, write)
        write = write + 1
        read = read + 1
    }
    read = past
    while (read < p.tokens.count) {
        copy_token(p, read, write)
        write = write + 1
        read = read + 1
    }
    p.tokens.count = write
}

copy_token :: fn(mut p: Parser, from: i64, to: i64) {
    kind := arena_at(p.tokens, from).kind
    off := arena_at(p.tokens, from).off
    len := arena_at(p.tokens, from).len
    value := arena_at(p.tokens, from).value
    held := arena_at(p.tokens, to)
    held.kind = kind
    held.off = off
    held.len = len
    held.value = value
}

// Whether this offset sits in a branch a `when` kept.
in_lifted :: fn(mut p: Parser, off: i64) -> bool {
    mut i: i64 = 0
    while (i < p.when_lifted.count) {
        entry := arena_at(p.when_lifted, i)
        if (off >= entry.name_off && off <= entry.name_len) {
            return true
        }
        i = i + 1
    }
    false
}

// Every decimal literal spelling a number sixty-four bits cannot hold. Read off
// the tokens, before any pass reads one as a value, since a literal stands
// wherever a number does and there is no one place a pass would meet them all.
refuse_oversized_numbers :: fn(mut p: Parser) {
    mut i: i64 = 0
    while (i < p.tokens.count) {
        held := arena_at(p.tokens, i)
        if (held.kind == TokenKind::BigInt) {
            report_where(p.modules, p.src, held.off)
            report_src(p.src, held.off, held.len)
            report(" does not fit in sixty-four bits")
            frost_rt_recover_escape()
        }
        i = i + 1
    }
}

parse_program :: fn(mut p: Parser) -> i64 {
    refuse_oversized_numbers(p)
    predeclare_target(p)
    resolve_when(p)
    predeclare_types(p)
    start := p.ti
    // Every function a compile-time call may run, before the constants that
    // call one are read.
    record_const_functions(p)
    p.ti = start
    parse_constant_declarations(p)
    p.ti = start
    parse_type_declarations(p)
    // Every declaration is in the tables now, so a type name that resolves to
    // nothing is a name nothing declares.
    p.type_check_names = 1
    recheck_pending_type_names(p, 0)
    p.ti = start
    parse_layout_constants(p)
    p.ti = start
    parse_folded_constants(p)
    p.ti = start
    mut head: i64 = -1
    mut tail: i64 = -1
    while (cur(p) != TokenKind::Eof) {
        mut turn := RecoverTurn {
            parser = unsafe { ptr_cast($u8, ptr_to(p)) },
            item = -1,
            block_depth = p.block_depth,
            unsafe_depth = p.unsafe_depth,
            defer_depth = p.defer_depth,
            ti = p.ti
        }
        escaped := unsafe {
            frost_rt_recover_run(
                parse_declaration_guarded,
                ptr_cast($u8, ptr_to(turn))
            )
        }
        if (escaped == 1) {
            p.block_depth = turn.block_depth
            p.unsafe_depth = turn.unsafe_depth
            p.defer_depth = turn.defer_depth
            // Only ever forward. A fault normally leaves the cursor further
            // along than it began, and that is what the synchronize below
            // reads; what this catches is a cursor left behind where it began.
            if (p.ti < turn.ti) {
                p.ti = turn.ti
            }
            synchronize_declaration(p)
        } else if (turn.item != (-1)) {
            if (head == (-1)) {
                head = turn.item
                tail = turn.item
            } else {
                set_next(p, tail, turn.item)
                tail = turn.item
            }
        }
    }
    settle_linear_types(p)
    head
}

// Every function written where it was used, joined to the end of the program.
// Each is an ordinary declaration node, so every pass that walks the program
// reaches them without knowing where they came from.
//
// Called once every instance has been parsed rather than at the end of the
// parse. Most instances are parsed where the call to them is read, but the
// fixpoint that settles what a forwarded list holds may ask for one after that,
// and a function written inside the body it re-reads is made there.
join_synth_fns :: fn(mut p: Parser, program: i64) -> i64 {
    if (p.synth_fns.count == 0) {
        return program
    }
    mut head := program
    mut tail := program
    while (tail != (-1) && node_next(p, tail) != (-1)) {
        tail = node_next(p, tail)
    }
    mut synth: i64 = 0
    while (synth < p.synth_fns.count) {
        made := arena_at(p.synth_fns, synth)
        if (head == (-1)) {
            head = made.node
            tail = made.node
        } else {
            set_next(p, tail, made.node)
            tail = made.node
        }
        synth = synth + 1
    }
    head
}

// ---------------------------------------------------------------------------
// Code generation. Walk the arena and emit a C translation unit.
// ---------------------------------------------------------------------------

// Re-parse a generic function with its type parameter bound to `arg`, returning
// the concrete FUNC node. The return type is left in p.last_return_type.
//
// Parsed once per instantiation and remembered. The result depends on nothing
// but the template and the argument, and three passes ask for the same one: the
// return-type pass, the prototype pass and the body pass. Parsing it once is
// worth more here than anywhere else in this compiler, because a template is
// the one thing it reads more than once.
// The parameter list of the instance a call names. A generic's symbol carries
// whichever instance was parsed last, so reading types off it is right only in
// a program that uses the generic once. This parses (or recalls) the instance
// this call asks for and answers with its parameters. -1 when the callee is not
// generic, or when the call is inside a template and its arguments are the
// enclosing parameters rather than types.
// Parse the instance a call names, so that what it answers with is known
// before a name is bound to it. A name bound from a call to a generic is read
// for the tuple of the next call, and that call is what asks for the instance,
// so without this the second call names a tuple nothing was instantiated for.
//
// The whole parser runs over another declaration here, and everything the
// enclosing one has worked out lives in the parser rather than on a stack, so
// it is put aside and put back. The depth guard is for a generic that calls
// itself: an instance is remembered only once its body is read, so a body
// reading its own answer would ask for the instance it is inside.
settle_call_answer :: fn(mut p: Parser, value: i64) {
    if (p.mono_on_demand == 0 || p.mono_depth >= MONO_DEPTH_MAX) {
        return
    }
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call || node.b == 1) {
        return
    }
    gi := generic_fn_of(p, node.val)
    if (gi < 0 || takes_pack(p, node.val)) {
        return
    }
    arg := call_args_for(p, node.a, node.val)
    xstart := p.call_xarg_start
    xcount := p.call_xarg_count
    if (arg < 0 || arg == TY_PARAM
        || instance_fits_kind(p, gi, arg, xstart, xcount, 0, gi) == false) {
        return
    }
    // The tuple goes in the table beside the instance. What is emitted is read
    // off that table, so an instance parsed here and left out of it is a body
    // every call to it names and nothing defines.
    note_type_args(p, arg, xstart, xcount, 0, gi)
    held := hold_declaration(p)
    p.mono_depth = p.mono_depth + 1
    made := parse_generic_instance(p, gi, arg, xstart, xcount)
    p.mono_depth = p.mono_depth - 1
    answer := p.last_return_type
    restore_declaration(p, held)
    record_mono_ret(p, arena_at(p.arena, made).val, arg, xstart, xcount, answer)
}

instance_params :: fn(mut p: Parser, fn_index: i64, args: i64) -> i64 {
    gi := generic_fn_of(p, fn_index)
    if (gi < 0) {
        return -1
    }
    arg := call_args_for(p, args, fn_index)
    xstart := p.call_xarg_start
    xcount := p.call_xarg_count
    mut is_pack: i64 = 0
    if (takes_pack(p, fn_index)) {
        is_pack = gi + 1
    }
    // The tuple is this call's own, so the generic it belongs to is the one
    // being asked about. A tuple nothing in scope could name is -1, and there
    // is no instance to reach for from here.
    if (arg < 0 || arg == TY_PARAM
        || instance_fits_kind(p, gi, arg, xstart, xcount, is_pack, gi)
        == false) {
        return -1
    }
    held_ret := p.last_return_type
    node := parse_generic_instance(p, gi, arg, xstart, xcount)
    p.last_return_type = held_ret
    fnode := arena_at(p.arena, node)
    fnode.b
}

// Whether an argument tuple can stand in for a generic's parameters.
//
// A tuple a call made belongs to the generic that call named, and to no other.
// A generic struct's instance names no function and carries -1, which every
// generic accepts, since that is where a function generic over the same type
// gets its instance from.
//
// What is rejected beyond the owner:
//
// A generic taking more parameters than the tuple has arguments has nothing to
// bind the rest to, and reading them would run off the end of the tuple's run.
//
// A parameter the body calls has to be bound to a function, and a parameter
// the body uses as a type has to be bound to a type. Binding a called
// parameter to a type leaves the body calling a name that no longer stands for
// anything, which is not merely dead: it emits a call to a symbol that was
// never defined, and the program fails to link.
//
// What a compile-time list was given is a run of ordinary types with no
// parameters to bind them to, so it fits only the generic that takes a list,
// and a generic that takes one fits nothing else.
instance_fits_kind :: fn(
    mut p: Parser,
    gfn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64,
    is_pack: i64,
    owner: i64
) -> bool {
    if (owner >= 0 && owner != gfn_index) {
        return false
    }
    // A tuple a generic struct instance offers goes to the generics that take
    // one of those, which is what brings `vec_get<Table>` into being from
    // `Vec<Table>` alone. It does not go to every other generic that happens to
    // accept the same kinds: a set of arguments one declaration was written
    // with is not an argument list every generic was called with.
    template := owner_template(owner)
    if (template >= 0 && generic_takes_template(p, gfn_index, template) == false) {
        return false
    }
    gfn := arena_at(p.generic_fns, gfn_index)
    if (gfn.pack_len > 0) {
        return is_pack == gfn_index + 1
    }
    if (is_pack != 0) {
        return false
    }
    if (xarg_count < gfn.xparam_count) {
        return false
    }
    if (is_fn_arg(arg) != (gfn.tparam_is_fn == 1)) {
        return false
    }
    if (is_number(arg) != (gfn.tparam_is_value == 1)) {
        return false
    }
    mut i: i64 = 0
    while (i < gfn.xparam_count) {
        param := arena_at(p.gparams, gfn.xparam_start + i)
        garg := arena_at(p.gargs, xarg_start + i)
        if (is_fn_arg(garg.value) != (param.is_fn == 1)) {
            return false
        }
        if (is_number(garg.value) != (param.is_value == 1)) {
            return false
        }
        i = i + 1
    }
    true
}

// Whether this is the first tuple in the table carrying these types that this
// generic accepts.
//
// One tuple of types can sit in the table more than once under different
// owners: a call names its callee, and a generic struct written with the same
// types names nothing. A generic accepting both would be emitted twice under
// one name, which no assembler takes. Which entry survives does not matter,
// since they carry the same types; that exactly one does is what matters.
tuple_is_first_for :: fn(mut p: Parser, gfn_index: i64, at: i64) -> bool {
    used := arena_at(p.type_args, at)
    arg := used.arg
    xstart := used.xarg_start
    xcount := used.xarg_count
    is_pack := used.is_pack
    mut i: i64 = 0
    while (i < at) {
        other := arena_at(p.type_args, i)
        other_start := other.xarg_start
        other_owner := other.owner
        if (other.arg == arg && other.xarg_count == xcount
            && other.is_pack == is_pack
            && gargs_equal(p, other_start, xstart, xcount)
            && instance_fits_kind(
                p,
                gfn_index,
                arg,
                other_start,
                xcount,
                is_pack,
                other_owner
            )) {
            return false
        }
        i = i + 1
    }
    true
}

// A stand-in for one instance's identity, so that two which cannot be the same
// are told apart without walking their arguments. Two that collide here are
// still weighed in full, so this only has to be cheap and spread out.
instance_hash :: fn(mut p: Parser, at: i64) -> i64 {
    used := arena_at(p.type_args, at)
    mut sum := wrap_mul(used.arg, 2654435761)
    sum = wrap_add(wrap_mul(sum, 33), used.xarg_count)
    sum = wrap_add(wrap_mul(sum, 33), used.is_pack)
    mut i: i64 = 0
    while (i < used.xarg_count) {
        held := arena_at(p.gargs, used.xarg_start + i)
        sum = wrap_add(wrap_mul(sum, 33), held.value)
        i = i + 1
    }
    sum & 4611686018427387903
}

// Which instances are the first of their kind for this generic, marked for the
// whole list at once.
//
// Asked one at a time, each answer walks every instance before it, so a program
// is charged the square of its specializations once for every generic it
// declares. 10,240 of them across 64 generics is three billion steps. A table
// of what has been seen answers each one in a step, and the walk that decides
// which of two entries survives is unchanged: the first to reach a slot keeps
// it, exactly as the first in the list did.
mark_first_instances :: fn(
    mut p: Parser,
    gfn_index: i64,
    mut firsts: Arena<InstanceSlot>,
    mut table: Arena<InstanceSlot>
) {
    while (firsts.count < p.type_args.count) {
        arena_push(firsts, InstanceSlot { at = 0, mark = 0 })
    }
    // Two slots for every instance, so a table never fills and the probe below
    // always reaches an empty one.
    mut slots: i64 = 16
    while (slots < p.type_args.count * 2) {
        slots = slots * 2
    }
    while (table.count < slots) {
        arena_push(table, InstanceSlot { at = 0, mark = 0 })
    }
    stamp := gfn_index + 1
    mut at: i64 = 0
    while (at < p.type_args.count) {
        used := arena_at(p.type_args, at)
        arg := used.arg
        xstart := used.xarg_start
        xcount := used.xarg_count
        is_pack := used.is_pack
        if (instance_fits_kind(p, gfn_index, arg, xstart, xcount, is_pack, used.owner)) {
            mut probe := instance_hash(p, at) & (slots - 1)
            mut seen: bool = false
            while (arena_at(table, probe).mark == stamp) {
                other_at := arena_at(table, probe).at
                other := arena_at(p.type_args, other_at)
                if (other.arg == arg && other.xarg_count == xcount
                    && other.is_pack == is_pack
                    && gargs_equal(p, other.xarg_start, xstart, xcount)) {
                    seen = true
                    break
                }
                probe = (probe + 1) & (slots - 1)
            }
            if (seen == false) {
                arena_at(table, probe).at = at
                arena_at(table, probe).mark = stamp
                arena_at(firsts, at).mark = stamp
            }
        }
        at = at + 1
    }
}

// Whether an argument is a compile-time number rather than a type or a
// function. A number rides above CONST_BASE and below the bases above it.
is_number :: fn(arg: i64) -> bool {
    arg >= CONST_BASE && arg < PROC_BASE
}

// Note that the declaration being parsed calls this name. A compile-time
// parameter called by name is one a function binds to, which is what tells
// `$less` from `$T` when the instances are made. The declaration's own
// parameters are the only names this can match, since a call to anything else
// is a call to a declared function.
note_called_name :: fn(mut p: Parser, offset: i64, length: i64) {
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        p.tparam_called = 1
        return
    }
    mut i: i64 = 0
    while (i < p.xparam_count) {
        param := arena_at(p.gparams, p.xparam_start + i)
        if (param.name_len == length
            && bytes_equal(p.src, param.name_off, offset, length)) {
            param.is_fn = 1
            return
        }
        i = i + 1
    }
}

parse_generic_instance :: fn(
    mut p: Parser,
    gfn_index: i64,
    arg: i64,
    xarg_start: i64,
    xarg_count: i64
) -> i64 {
    mut i: i64 = 0
    while (i < p.mono_nodes.count) {
        held := arena_at(p.mono_nodes, i)
        if (held.gfn_index == gfn_index && held.arg == arg
            && held.xarg_count == xarg_count
            && gargs_equal(p, held.xarg_start, xarg_start, xarg_count)) {
            p.last_return_type = held.ret
            return held.node
        }
        i = i + 1
    }
    gfn := arena_at(p.generic_fns, gfn_index)
    tparam_off := gfn.tparam_off
    tparam_len := gfn.tparam_len
    xparam_start := gfn.xparam_start
    xparam_count := gfn.xparam_count
    token_start := gfn.token_start
    pack_off := gfn.pack_off
    pack_len := gfn.pack_len
    saved_ti := p.ti
    // The names an enclosing compile-time `for` bound are not this body's. It is
    // read as the declaration it is, and a parameter of it that happens to spell
    // what a loop outside spells is that parameter.
    saved_alias_floor := p.alias_floor
    p.alias_floor = p.aliases.count
    saved_pack_off := p.pack_off
    saved_pack_len := p.pack_len
    saved_pack_start := p.pack_start
    saved_pack_count := p.pack_count
    // What the declaration wrote, which this parse reads a body against rather
    // than working out again. A call in that body handing on its own literal
    // and its own list is recognised by these, so an instance that did not have
    // them would read the same forward as a call writing a literal it never
    // wrote.
    saved_format_off := p.decl_format_off
    saved_format_len := p.decl_format_len
    p.decl_format_off = gfn.format_off
    p.decl_format_len = gfn.format_len
    p.pack_off = pack_off
    p.pack_len = pack_len
    // The run a pack call left behind holds this generic's own compile-time
    // arguments first and the list's elements after them, so the elements start
    // past however many the declaration wrote.
    p.pack_start = xarg_start + xparam_count
    p.pack_count = 0
    if (pack_len > 0) {
        p.pack_count = xarg_count - xparam_count
    }
    saved_off := p.type_param_off
    saved_len := p.type_param_len
    saved_bind := p.type_binding
    saved_active := p.binding_active
    p.type_param_off = tparam_off
    p.type_param_len = tparam_len
    p.type_binding = arg
    p.binding_active = 1
    mark := push_bindings(
        p,
        tparam_off,
        tparam_len,
        xparam_start,
        xparam_count,
        arg,
        xarg_start
    )
    p.ti = token_start
    // Parsing an instance derives types under the bindings just pushed, and the
    // implicit-return check calls type_of while they are live. Those answers hold
    // only for this parse, so the cache is off across it and only emit, which
    // sees the instance's settled types, writes to it.
    saved_cache := p.type_cache_on
    p.type_cache_on = 0
    node := parse_function(p)
    // An instance is parsed after every signature is known, so anything its
    // body still owes is settled here rather than waiting for a pass that has
    // already run.
    resolve_variant_fixups(p)
    p.type_cache_on = saved_cache
    p.gbindings.count = mark
    p.ti = saved_ti
    p.pack_off = saved_pack_off
    p.pack_len = saved_pack_len
    p.pack_start = saved_pack_start
    p.pack_count = saved_pack_count
    p.decl_format_off = saved_format_off
    p.decl_format_len = saved_format_len
    p.type_param_off = saved_off
    p.type_param_len = saved_len
    p.type_binding = saved_bind
    p.binding_active = saved_active
    p.alias_floor = saved_alias_floor
    arena_push(
        p.mono_nodes,
        MonoNode {
            gfn_index = gfn_index,
            arg = arg,
            xarg_start = xarg_start,
            xarg_count = xarg_count,
            node = node,
            ret = p.last_return_type
        }
    )
    node
}

// Work out every monomorphization's concrete return type. A call needs it to
// type its result and to know whether to hand in a buffer for a struct, and the
// template's own return type still mentions the type parameter. This runs
// before anything is checked or emitted, so both backends see the same answer.
record_mono_rets :: fn(mut p: Parser) {
    mut gi: i64 = 0
    while (gi < p.generic_fns.count) {
        mut ii: i64 = 0
        while (ii < p.type_args.count) {
            used := arena_at(p.type_args, ii)
            arg := used.arg
            xstart := used.xarg_start
            xcount := used.xarg_count
            is_pack := used.is_pack
            owner := used.owner
            if (instance_fits_kind(p, gi, arg, xstart, xcount, is_pack, owner) && tuple_is_first_for(p, gi, ii)) {
                node := parse_generic_instance(p, gi, arg, xstart, xcount)
                fnode := arena_at(p.arena, node)
                record_mono_ret(
                    p,
                    fnode.val,
                    arg,
                    xstart,
                    xcount,
                    p.last_return_type
                )
            }
            ii = ii + 1
        }
        gi = gi + 1
    }
}

// Whether a struct carries a field of this name.
struct_has_field :: fn(mut p: Parser, ty: i64, off: i64, len: i64) -> bool {
    def := arena_at(p.structs, struct_index_of(ty))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return true
        }
        fid = field.next
    }
    false
}

// What a constant that cannot be worked out says. The wording is the one the
// compile-time evaluator uses for the same fault reached the other way.
const_overflows_at :: fn(mut p: Parser, at: i64) {
    report_where(p.modules, p.src, at)
    report("this overflows an i64")
    frost_rt_recover_escape()
}
