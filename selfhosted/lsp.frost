// A language server for Frost, spoken over standard input and output.
//
// One process, started once by an editor and asked about a file after every
// keystroke. What it answers with is what a build would say about the same
// text: the same passes run over the buffer on screen, so a report an editor
// underlines is a report the build would refuse on.
//
// Written here rather than beside the editor, because everything an answer
// needs is what the compiler already built. A definition is a row in the symbol
// table, a diagnostic is a report the passes wrote, and a completion is the
// exported surface `frost api` walks. Spoken from outside, each of those was a
// process started and a program read again.
//
// The protocol is JSON-RPC over a `Content-Length` header, which is what the
// Language Server Protocol says and what every editor speaks.

import "core.frost"
import "json.frost"
import "cli.frost"
import "api.frost"
import "imports.frost"
import "names.frost"
import "build.frost"
import "format.frost"
import "lint.frost"
import "lexer.frost"

export lsp_command

// How much room a document's text starts with. An arena reserves sixteen times
// what it is made with and commits into that, so a file larger than this costs
// a commit rather than a copy, and the address a view names never moves.
DOC_ROOM :: 262144

// How many documents an editor may hold open at once. A closed one keeps its
// buffers, since the next file opened takes the slot rather than a new arena.
DOC_MAX :: 256

// How much of a run of taken-back ids to hold. A reader moving a caret sends
// one for each request they left behind, and the ones still waiting are the
// last few.
CANCEL_ROOM :: 2048

// One file an editor has open, and the text it has rather than the text on
// disk. The buffers are reused across edits: an editor sends the whole document
// on every keystroke, and a fresh allocation for each would be a megabyte a
// second on a large file.
Doc :: struct {
    uri: Arena<u8>,
    path: Arena<u8>,
    text: Arena<u8>,
    version: i64,
    live: i64,
    // Whether the text changed since the last check. A burst of
    // keystrokes is one check rather than one for each, so the text a
    // change carries waits here until nothing else is on the way in.
    dirty: i64,
}

// A file the last round of findings was published for. An editor keeps what it
// was last told about a file until it is told something else, so a file whose
// last report is gone has to be told there are none rather than left as it was.
Published :: struct {
    path: Arena<u8>,
    // Which document the check that reported about this file was about.
    // A file is told there is nothing left only by the document whose
    // check last found something in it: checking one file has nothing to
    // say about what another file was told.
    doc: i64,
    live: i64,
}

// What the server knows between one question and the next. Threaded rather than
// held in a global, which the language does not have.
Server :: struct {
    docs: Arena<Doc>,
    published: Arena<Published>,
    root: Arena<u8>,
    scratch: Arena<u8>,
    other: Arena<u8>,
    named: Arena<u8>,
    reports: Arena<u8>,
    // The records the last check wrote, and which document they are about.
    // An editor asks for the fixes at the caret every time it moves, and the
    // answer is what the check already found.
    held_reports: Arena<u8>,
    held_for: i64,
    modules: Arena<u8>,
    sources: Arena<u8>,
    walking: Arena<u8>,
    each: Arena<u8>,
    // Where the last name looked up is declared: the file, the name in it,
    // and the head it was written under.
    found: Arena<u8>,
    found_off: i64,
    found_len: i64,
    head_off: i64,
    head_to: i64,
    read_back: Arena<u8>,
    body: Arena<u8>,
    // The ids the editor took back before this got to them.
    cancelled: Arena<u8>,
    going: i64,
    ready: i64,
}

lsp_command :: fn() -> i64 {
    // Every refusal comes back to whoever asked rather than ending the process,
    // and every report is a record rather than a block of text, so the answers
    // carry places and fixes a reader can act on.
    frost_rt_serving_on()
    frost_rt_json_reports()
    mut server := Server {
        docs = arena_make($Doc, DOC_MAX),
        published = arena_make($Published, 256),
        root = arena_make($u8, 4096),
        scratch = arena_make($u8, 65536),
        other = arena_make($u8, 65536),
        named = arena_make($u8, 4096),
        reports = arena_make($u8, 262144),
        held_reports = arena_make($u8, 262144),
        held_for = -1,
        modules = arena_make($u8, 65536),
        sources = arena_make($u8, 262144),
        walking = arena_make($u8, 65536),
        each = arena_make($u8, 4096),
        found = arena_make($u8, 4096),
        found_off = 0,
        found_len = 0,
        head_off = 0,
        head_to = 0,
        read_back = arena_make($u8, DOC_ROOM),
        body = arena_make($u8, DOC_ROOM),
        cancelled = arena_make($u8, 4096),
        going = 1,
        ready = 0,
    }
    while (server.going == 1) {
        if (read_body(server.body) == false) {
            server.going = 0
        } else {
            answer_one(server)
            settle_dirty(server)
        }
    }
    0
}

// ---------------------------------------------------------------------------
// Bytes
// ---------------------------------------------------------------------------

// The bytes an arena holds, as a slice. The storage is the arena's, which is
// the caller's, so the view lives exactly as long as what it reads.
bytes_view :: fn(mut a: Arena<u8>) -> str {
    unsafe { slice_from($u8, a.data, a.count) }
}

// The bytes an arena holds as a C string, for the runtime calls that take one.
// Everything written through `bytes_byte` leaves a terminator past the count,
// so what this points at is terminated without the count including it.
bytes_cstr :: fn(mut a: Arena<u8>) -> ^i8 {
    unsafe { ptr_cast($i8, a.data) }
}

bytes_reset :: fn(mut a: Arena<u8>) {
    a.count = 0
    arena_push(a, cast($u8, 0))
    a.count = 0
}

bytes_byte :: fn(mut a: Arena<u8>, value: i64) {
    arena_push(a, cast($u8, value & 255))
    // The terminator sits past the count, so the count stays the length and
    // the bytes are still a C string.
    arena_push(a, cast($u8, 0))
    a.count = a.count - 1
}

bytes_str :: fn(mut a: Arena<u8>, text: str) {
    for index, byte in text {
        bytes_byte(a, cast($i64, byte))
    }
}

bytes_cstr_in :: fn(mut a: Arena<u8>, text: ^i8) {
    length := cstr_len(text)
    mut at: i64 = 0
    while (at < length) {
        bytes_byte(a, byte_at(text, at))
        at = at + 1
    }
}

bytes_int :: fn(mut a: Arena<u8>, value: i64) {
    if (value < 0) {
        bytes_byte(a, CH_MINUS)
        bytes_int(a, 0 - value)
        return
    }
    if (value >= 10) {
        bytes_int(a, value / 10)
    }
    bytes_byte(a, 48 + value % 10)
}

// Whether a run of bytes holds this text.
bytes_same :: fn(mut a: Arena<u8>, text: str) -> bool {
    if (a.count != str_len(text)) {
        return false
    }
    held := bytes_view(a)
    for index, byte in text {
        if (cast($i64, held[index]) != cast($i64, byte)) {
            return false
        }
    }
    true
}

// ---------------------------------------------------------------------------
// Framing
// ---------------------------------------------------------------------------

// One message off standard input, header and body. Answers false where the
// stream ended, which is what an editor closing the pipe looks like.
read_body :: fn(mut body: Arena<u8>) -> bool {
    mut length: i64 = -1
    mut reading: bool = true
    while (reading) {
        line := unsafe { frost_rt_stdin_line() }
        if (frost_rt_stdin_ended() == 1) {
            return false
        }
        if (cstr_len(line) == 0) {
            reading = false
        } else {
            wanted := header_length(line)
            if (wanted >= 0) {
                length = wanted
            }
        }
    }
    if (length < 0) {
        return false
    }
    raw := unsafe { frost_rt_stdin_bytes(length) }
    if (frost_rt_stdin_ended() == 1) {
        return false
    }
    bytes_reset(body)
    mut at: i64 = 0
    while (at < length) {
        bytes_byte(body, byte_at(raw, at))
        at = at + 1
    }
    true
}

// The number a `Content-Length` header carries, or -1 for any other header. The
// name is matched without regard to case, which the protocol allows.
header_length :: fn(line: ^i8) -> i64 {
    name := "content-length:"
    wanted := str_len(name)
    if (cstr_len(line) < wanted) {
        return -1
    }
    mut at: i64 = 0
    while (at < wanted) {
        mut held := byte_at(line, at)
        if (held >= CH_UPPER_A && held <= CH_UPPER_Z) {
            held = held + 32
        }
        if (held != cast($i64, name[at])) {
            return -1
        }
        at = at + 1
    }
    mut value: i64 = 0
    mut seen: i64 = 0
    mut index := wanted
    length := cstr_len(line)
    while (index < length) {
        byte := byte_at(line, index)
        if (byte >= 48 && byte <= 57) {
            value = value * 10 + byte - 48
            seen = 1
        }
        index = index + 1
    }
    if (seen == 0) {
        return -1
    }
    value
}

// ---------------------------------------------------------------------------
// Writing
// ---------------------------------------------------------------------------

// A message goes into memory first so its length is known before its header is
// written, which is what the framing asks for.
say_open :: fn() {
    emit_to_memory()
}

say_send :: fn() {
    held := emit_memory_text()
    emit_text("Content-Length: ")
    frost_rt_emit_int(str_len(held))
    emit_text("\r\n\r\n")
    emit_text(held)
    // A build lets the close write what it emitted; a server writes an answer
    // and then waits to be read, so what it wrote has to have left first.
    frost_rt_emit_flush()
}

// A JSON string with its quotes, escaped the way the format asks. A byte below
// a space has no literal spelling, so it goes out as the four hex digits the
// format names it by.
say_string :: fn(text: str) {
    emit_text("\"")
    for index, byte in text {
        say_escaped(cast($i64, byte))
    }
    emit_text("\"")
}

say_escaped :: fn(byte: i64) {
    if (byte == CH_DQUOTE || byte == CH_BACKSLASH) {
        frost_rt_emit_char(CH_BACKSLASH)
        frost_rt_emit_char(byte)
        return
    }
    if (byte == CH_LF) {
        emit_text("\\n")
        return
    }
    if (byte == CH_CR) {
        emit_text("\\r")
        return
    }
    if (byte == CH_TAB) {
        emit_text("\\t")
        return
    }
    if (byte < 32) {
        emit_text("\\u00")
        frost_rt_emit_char(hex_digit(byte / 16))
        frost_rt_emit_char(hex_digit(byte % 16))
        return
    }
    frost_rt_emit_char(byte)
}

hex_digit :: fn(value: i64) -> i64 {
    if (value < 10) {
        return 48 + value
    }
    87 + value
}

say_cstr :: fn(text: ^i8) {
    emit_text("\"")
    length := cstr_len(text)
    mut at: i64 = 0
    while (at < length) {
        say_escaped(byte_at(text, at))
        at = at + 1
    }
    emit_text("\"")
}

// The head of a reply, which carries back the id it answers.
say_result_head :: fn(mut document: Json, request: i64) {
    emit_text("{\"jsonrpc\":\"2.0\",\"id\":")
    say_id(document, request)
    emit_text(",\"result\":")
}

// The id as it arrived. A request may number itself or name itself, and the
// reply has to carry back what it was given rather than a reading of it.
say_id :: fn(mut document: Json, request: i64) {
    id := json_member(document, request, "id")
    if (json_kind(document, id) == JsonKind::String) {
        emit_text("\"")
        say_raw_string(document, id)
        emit_text("\"")
        return
    }
    if (json_kind(document, id) == JsonKind::Number) {
        frost_rt_emit_int(json_number(document, id))
        return
    }
    emit_text("null")
}

// A string node's bytes as they were written, escapes and all, which is what
// goes back out where nothing read them.
say_raw_string :: fn(mut document: Json, node: i64) {
    source := document.source
    off := json_text_off(document, node)
    len := json_text_len(document, node)
    mut at: i64 = 0
    while (at < len) {
        frost_rt_emit_char(cast($i64, source[off + at]))
        at = at + 1
    }
}

say_position :: fn(line: i64, character: i64) {
    emit_text("{\"line\":")
    frost_rt_emit_int(line)
    emit_text(",\"character\":")
    frost_rt_emit_int(character)
    emit_text("}")
}

say_range :: fn(
    from_line: i64,
    from_character: i64,
    to_line: i64,
    to_character: i64
) {
    emit_text("{\"start\":")
    say_position(from_line, from_character)
    emit_text(",\"end\":")
    say_position(to_line, to_character)
    emit_text("}")
}

// ---------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------

// How many bytes the character starting with this one takes. A byte that is
// neither a lead nor an ASCII one is a stray continuation, and stepping over it
// one at a time is what keeps a walk moving through text that is not valid.
utf8_width :: fn(byte: i64) -> i64 {
    if (byte < 192) {
        return 1
    }
    if (byte < 224) {
        return 2
    }
    if (byte < 240) {
        return 3
    }
    4
}

// How many units the protocol counts this character as. It measures positions
// in UTF-16, where everything below the first supplementary plane is one unit
// and everything above it is a pair.
utf16_units :: fn(byte: i64) -> i64 {
    if (byte < 240) {
        return 1
    }
    2
}

// The byte a protocol position names, counting lines from zero and characters
// in UTF-16 units.
place_offset :: fn(text: str, line: i64, character: i64) -> i64 {
    length := str_len(text)
    mut at: i64 = 0
    mut seen: i64 = 0
    while (seen < line && at < length) {
        if (cast($i64, text[at]) == CH_LF) {
            seen = seen + 1
        }
        at = at + 1
    }
    mut units: i64 = 0
    while (units < character && at < length) {
        byte := cast($i64, text[at])
        if (byte == CH_LF) {
            return at
        }
        units = units + utf16_units(byte)
        at = at + utf8_width(byte)
    }
    at
}

// The line a byte is on, counted from zero.
place_line :: fn(text: str, offset: i64) -> i64 {
    length := str_len(text)
    mut at: i64 = 0
    mut line: i64 = 0
    while (at < offset && at < length) {
        if (cast($i64, text[at]) == CH_LF) {
            line = line + 1
        }
        at = at + 1
    }
    line
}

// The character a byte is at, in the units the protocol counts.
place_character :: fn(text: str, offset: i64) -> i64 {
    length := str_len(text)
    mut start: i64 = 0
    mut at: i64 = 0
    while (at < offset && at < length) {
        if (cast($i64, text[at]) == CH_LF) {
            start = at + 1
        }
        at = at + 1
    }
    mut units: i64 = 0
    mut walk := start
    while (walk < offset && walk < length) {
        byte := cast($i64, text[walk])
        units = units + utf16_units(byte)
        walk = walk + utf8_width(byte)
    }
    units
}

// Whether a byte may be part of a name.
name_byte :: fn(byte: i64) -> bool {
    (byte >= CH_LOWER_A && byte <= CH_LOWER_Z) ||
        (byte >= CH_UPPER_A && byte <= CH_UPPER_Z) ||
        (byte >= 48 && byte <= 57) ||
        byte == CH_UNDERSCORE
}

// Where the name under a byte starts. A byte that is not part of one starts
// nothing, and the offset comes back unchanged.
name_start :: fn(text: str, offset: i64) -> i64 {
    mut at := offset
    if (at >= str_len(text)) {
        return offset
    }
    while (at > 0 && name_byte(cast($i64, text[at - 1]))) {
        at = at - 1
    }
    at
}

// Where the name under a byte ends.
name_end :: fn(text: str, offset: i64) -> i64 {
    length := str_len(text)
    mut at := offset
    while (at < length && name_byte(cast($i64, text[at]))) {
        at = at + 1
    }
    at
}

// ---------------------------------------------------------------------------
// Names for files
// ---------------------------------------------------------------------------

hex_value :: fn(byte: i64) -> i64 {
    if (byte >= 48 && byte <= 57) {
        return byte - 48
    }
    if (byte >= 97 && byte <= 102) {
        return byte - 87
    }
    if (byte >= 65 && byte <= 70) {
        return byte - 55
    }
    -1
}

// Whether a byte stands for itself in a URI. Everything else is written as the
// per cent sign and two digits, which is what an editor sends and what it
// compares against when a diagnostic comes back.
uri_plain :: fn(byte: i64) -> bool {
    (byte >= CH_LOWER_A && byte <= CH_LOWER_Z) ||
        (byte >= CH_UPPER_A && byte <= CH_UPPER_Z) ||
        (byte >= 48 && byte <= 57) ||
        byte == CH_MINUS || byte == CH_DOT ||
        byte == CH_UNDERSCORE || byte == 126 ||
        byte == CH_SLASH
}

// The file a URI names, written out as a path. `file:///c%3A/x/y.frost` names
// `c:/x/y.frost`: the slash before a drive letter belongs to the URI rather
// than to the path.
path_of_uri :: fn(mut out: Arena<u8>, text: str) {
    bytes_reset(out)
    length := str_len(text)
    mut at: i64 = 0
    if (length >= 7 && text_is(text, 0, "file://")) {
        at = 7
    }
    if (drive_follows(text, at)) {
        at = at + 1
    }
    while (at < length) {
        byte := cast($i64, text[at])
        if (byte == 37 && at + 2 < length) {
            high := hex_value(cast($i64, text[at + 1]))
            low := hex_value(cast($i64, text[at + 2]))
            if (high >= 0 && low >= 0) {
                bytes_byte(out, high * 16 + low)
                at = at + 3
                continue
            }
        }
        bytes_byte(out, byte)
        at = at + 1
    }
}

// Whether a slash here is the one a drive letter is written behind.
drive_follows :: fn(text: str, at: i64) -> bool {
    length := str_len(text)
    if (at >= length || cast($i64, text[at]) != CH_SLASH) {
        return false
    }
    if (at + 2 >= length) {
        return false
    }
    letter := cast($i64, text[at + 1])
    upper := (letter >= CH_UPPER_A && letter <= CH_UPPER_Z)
    lower := (letter >= CH_LOWER_A && letter <= CH_LOWER_Z)
    if (upper == false && lower == false) {
        return false
    }
    after := cast($i64, text[at + 2])
    if (after == CH_COLON) {
        return true
    }
    (after == 37 && at + 4 < length
        && hex_value(cast($i64, text[at + 3])) == 3
        && hex_value(cast($i64, text[at + 4])) == 10)
}

// The URI for a path, written the way an editor writes one, so a diagnostic
// published for a file lands on the buffer the editor already has open.
uri_of_path :: fn(mut out: Arena<u8>, path: str) {
    bytes_reset(out)
    bytes_str(out, "file://")
    length := str_len(path)
    if (length > 0 && cast($i64, path[0]) != CH_SLASH) {
        bytes_byte(out, CH_SLASH)
    }
    mut at: i64 = 0
    while (at < length) {
        mut byte := cast($i64, path[at])
        if (byte == CH_BACKSLASH) {
            byte = CH_SLASH
        }
        if (uri_plain(byte)) {
            bytes_byte(out, byte)
        } else {
            bytes_byte(out, 37)
            bytes_byte(out, hex_upper(byte / 16))
            bytes_byte(out, hex_upper(byte % 16))
        }
        at = at + 1
    }
}

hex_upper :: fn(value: i64) -> i64 {
    if (value < 10) {
        return 48 + value
    }
    55 + value
}

// Whether the text at an offset is this word.
text_is :: fn(text: str, at: i64, word: str) -> bool {
    wanted := str_len(word)
    if (at + wanted > str_len(text)) {
        return false
    }
    mut k: i64 = 0
    while (k < wanted) {
        if (cast($i64, text[at + k]) != cast($i64, word[k])) {
            return false
        }
        k = k + 1
    }
    true
}

// Whether two paths name the same file. A separator is either slash and, on the
// host where the system says so, a letter is either case.
same_path :: fn(one: str, other: str) -> bool {
    if (str_len(one) != str_len(other)) {
        return false
    }
    folding := frost_rt_is_windows() == 1
    mut at: i64 = 0
    while (at < str_len(one)) {
        mut left := cast($i64, one[at])
        mut right := cast($i64, other[at])
        if (left == CH_BACKSLASH) {
            left = CH_SLASH
        }
        if (right == CH_BACKSLASH) {
            right = CH_SLASH
        }
        if (folding) {
            if (left >= CH_UPPER_A && left <= CH_UPPER_Z) {
                left = left + 32
            }
            if (right >= CH_UPPER_A && right <= CH_UPPER_Z) {
                right = right + 32
            }
        }
        if (left != right) {
            return false
        }
        at = at + 1
    }
    true
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

// The document a URI names, or -1. A closed one keeps its buffers, so a match
// only counts while it is open.
doc_of_uri :: fn(mut s: Server, wanted: str) -> i64 {
    mut at: i64 = 0
    while (at < s.docs.count) {
        ref held := arena_at(s.docs, at)
        if (held.live == 1 && same_path(bytes_view(held.uri), wanted)) {
            return at
        }
        at = at + 1
    }
    -1
}

// A slot for this URI: the one it already has, a closed one to take over, or a
// new one.
doc_take :: fn(mut s: Server, wanted: str) -> i64 {
    held := doc_of_uri(s, wanted)
    if (held >= 0) {
        return held
    }
    mut at: i64 = 0
    while (at < s.docs.count) {
        ref slot := arena_at(s.docs, at)
        if (slot.live == 0) {
            slot.live = 1
            slot.version = 0
            slot.dirty = 0
            bytes_reset(slot.uri)
            bytes_str(slot.uri, wanted)
            path_of_uri(slot.path, wanted)
            bytes_reset(slot.text)
            return at
        }
        at = at + 1
    }
    if (s.docs.count >= DOC_MAX) {
        return -1
    }
    made := arena_push(
        s.docs,
        Doc {
            uri = arena_make($u8, 1024),
            path = arena_make($u8, 1024),
            text = arena_make($u8, DOC_ROOM),
            version = 0,
            live = 1,
            dirty = 0,
        }
    )
    ref slot := arena_at(s.docs, made)
    bytes_reset(slot.uri)
    bytes_str(slot.uri, wanted)
    path_of_uri(slot.path, wanted)
    bytes_reset(slot.text)
    made
}

// The document a request is about, or -1 where it names none.
doc_of_request :: fn(mut s: Server, mut document: Json, request: i64) -> i64 {
    params := json_member(document, request, "params")
    named := json_member(document, params, "textDocument")
    uri := json_member(document, named, "uri")
    if (uri < 0) {
        return -1
    }
    bytes_reset(s.scratch)
    bytes_json(s.scratch, document, uri)
    doc_of_uri(s, bytes_view(s.scratch))
}

// A string node's text, with the escapes the format writes read back into the
// bytes they stand for.
bytes_json :: fn(mut a: Arena<u8>, mut document: Json, node: i64) {
    source := document.source
    off := json_text_off(document, node)
    len := json_text_len(document, node)
    mut at: i64 = 0
    while (at < len) {
        byte := cast($i64, source[off + at])
        if (byte != CH_BACKSLASH || at + 1 >= len) {
            bytes_byte(a, byte)
            at = at + 1
            continue
        }
        next := cast($i64, source[off + at + 1])
        at = at + 2
        if (next == CH_LOWER_N) {
            bytes_byte(a, CH_LF)
            continue
        }
        if (next == 114) {
            bytes_byte(a, CH_CR)
            continue
        }
        if (next == CH_LOWER_T) {
            bytes_byte(a, CH_TAB)
            continue
        }
        if (next == CH_LOWER_B) {
            bytes_byte(a, 8)
            continue
        }
        if (next == CH_LOWER_F) {
            bytes_byte(a, 12)
            continue
        }
        if (next == 117 && at + 4 <= len) {
            mut point := hex_four(source, off + at)
            at = at + 4
            // A character above the first plane arrives as the two halves of a
            // surrogate pair, which are one character rather than two.
            if (point >= 55296 && point <= 56319 && at + 6 <= len
                && cast($i64, source[off + at]) == CH_BACKSLASH
                && cast($i64, source[off + at + 1]) == 117) {
                low := hex_four(source, off + at + 2)
                if (low >= 56320 && low <= 57343) {
                    point = 65536 + (point - 55296) * 1024 + (low - 56320)
                    at = at + 6
                }
            }
            bytes_utf8(a, point)
            continue
        }
        bytes_byte(a, next)
    }
}

hex_four :: fn(text: str, at: i64) -> i64 {
    mut value: i64 = 0
    mut k: i64 = 0
    while (k < 4) {
        digit := hex_value(cast($i64, text[at + k]))
        if (digit < 0) {
            return 0
        }
        value = value * 16 + digit
        k = k + 1
    }
    value
}

// A character written as the bytes that stand for it.
bytes_utf8 :: fn(mut a: Arena<u8>, point: i64) {
    if (point < 128) {
        bytes_byte(a, point)
        return
    }
    if (point < 2048) {
        bytes_byte(a, 192 + point / 64)
        bytes_byte(a, 128 + point % 64)
        return
    }
    if (point < 65536) {
        bytes_byte(a, 224 + point / 4096)
        bytes_byte(a, 128 + (point / 64) % 64)
        bytes_byte(a, 128 + point % 64)
        return
    }
    bytes_byte(a, 240 + point / 262144)
    bytes_byte(a, 128 + (point / 4096) % 64)
    bytes_byte(a, 128 + (point / 64) % 64)
    bytes_byte(a, 128 + point % 64)
}

// ---------------------------------------------------------------------------
// Dispatch
// ---------------------------------------------------------------------------

answer_one :: fn(mut s: Server) {
    mut document := json_parse(bytes_view(s.body))
    request := json_root(document)
    if (request >= 0) {
        answer_request(s, document, request)
    }
    json_free(document)
}

answer_request :: fn(mut s: Server, mut document: Json, request: i64) {
    method := json_member(document, request, "method")
    if (method < 0) {
        return
    }
    if (json_text_eq(document, method, "$/cancelRequest")) {
        note_cancelled(s, document, request)
        return
    }
    // A request the editor took back is answered with what the protocol says
    // to answer, rather than with work nobody is waiting for.
    if (was_cancelled(s, document, request)) {
        say_cancelled(document, request)
        return
    }
    if (json_text_eq(document, method, "initialize")) {
        answer_initialize(s, document, request)
        return
    }
    if (json_text_eq(document, method, "initialized")) {
        s.ready = 1
        return
    }
    if (json_text_eq(document, method, "shutdown")) {
        say_open()
        say_result_head(document, request)
        emit_text("null}")
        say_send()
        return
    }
    if (json_text_eq(document, method, "exit")) {
        s.going = 0
        return
    }
    if (json_text_eq(document, method, "textDocument/didOpen")) {
        answer_opened(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/didChange")) {
        answer_changed(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/didSave")) {
        doc := doc_of_request(s, document, request)
        if (doc >= 0) {
            publish_findings(s, doc)
        }
        return
    }
    if (json_text_eq(document, method, "textDocument/didClose")) {
        doc := doc_of_request(s, document, request)
        if (doc >= 0) {
            ref held := arena_at(s.docs, doc)
            held.live = 0
            forget_published(s, doc)
        }
        return
    }
    if (json_text_eq(document, method, "textDocument/formatting")) {
        answer_formatting(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/rangeFormatting")) {
        answer_range_formatting(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/onTypeFormatting")) {
        answer_on_type_formatting(s, document, request)
        return
    }
    if (json_text_eq(document, method, "completionItem/resolve")) {
        answer_completion_resolve(s, document, request)
        return
    }
    if (json_text_eq(document, method, "workspace/didChangeWatchedFiles")) {
        answer_watched_changed(s)
        return
    }
    if (json_text_eq(document, method, "textDocument/definition")) {
        answer_definition(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/declaration")) {
        answer_declaration(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/typeDefinition")) {
        answer_type_definition(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/implementation")) {
        answer_implementation(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/selectionRange")) {
        answer_selection_range(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/documentLink")) {
        answer_document_links(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/linkedEditingRange")) {
        answer_linked_editing(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/hover")) {
        answer_hover(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/documentSymbol")) {
        answer_document_symbols(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/references")) {
        answer_references(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/documentHighlight")) {
        answer_highlights(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/signatureHelp")) {
        answer_signature(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/completion")) {
        answer_completion(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/rename")) {
        answer_rename(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/prepareRename")) {
        answer_prepare_rename(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/foldingRange")) {
        answer_folding(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/semanticTokens/full")) {
        answer_semantic_tokens(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/codeAction")) {
        answer_code_actions(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/inlayHint")) {
        answer_inlay_hints(s, document, request)
        return
    }
    if (json_text_eq(document, method,
        "textDocument/prepareCallHierarchy")) {
        answer_prepare_hierarchy(s, document, request)
        return
    }
    if (json_text_eq(document, method, "callHierarchy/incomingCalls")) {
        answer_incoming_calls(s, document, request)
        return
    }
    if (json_text_eq(document, method, "callHierarchy/outgoingCalls")) {
        answer_outgoing_calls(s, document, request)
        return
    }
    if (json_text_eq(document, method,
        "textDocument/prepareTypeHierarchy")) {
        answer_prepare_type_hierarchy(s, document, request)
        return
    }
    if (json_text_eq(document, method, "typeHierarchy/supertypes")) {
        answer_supertypes(s, document, request)
        return
    }
    if (json_text_eq(document, method, "typeHierarchy/subtypes")) {
        answer_subtypes(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/codeLens")) {
        answer_code_lenses(s, document, request)
        return
    }
    if (json_text_eq(document, method, "textDocument/diagnostic")) {
        answer_pull_diagnostics(s, document, request)
        return
    }
    if (json_text_eq(document, method, "workspace/diagnostic")) {
        answer_workspace_diagnostics(s, document, request)
        return
    }
    if (json_text_eq(document, method, "codeLens/resolve")) {
        answer_code_lens_resolve(s, document, request)
        return
    }
    if (json_text_eq(document, method, "workspace/symbol")) {
        answer_workspace_symbols(s, document, request)
        return
    }
    // A request the server does not serve still gets an answer, since whoever
    // asked is waiting for one. A notification, which has no id, gets nothing.
    if (json_member(document, request, "id") >= 0) {
        say_open()
        say_result_head(document, request)
        emit_text("null}")
        say_send()
    }
}

answer_initialize :: fn(mut s: Server, mut document: Json, request: i64) {
    params := json_member(document, request, "params")
    root := json_member(document, params, "rootUri")
    if (root >= 0 && json_kind(document, root) == JsonKind::String) {
        bytes_reset(s.scratch)
        bytes_json(s.scratch, document, root)
        path_of_uri(s.root, bytes_view(s.scratch))
    }
    say_open()
    say_result_head(document, request)
    emit_text("{\"capabilities\":{")
    // The whole document arrives on every change. A Frost source is read end to
    // end by every pass anyway, so keeping a copy up to date by ranges would
    // save nothing the check does not spend.
    emit_text("\"textDocumentSync\":{\"openClose\":true,\"change\":2,\"save\":true},")
    emit_text("\"hoverProvider\":true,")
    emit_text("\"definitionProvider\":true,")
    emit_text("\"declarationProvider\":true,")
    emit_text("\"typeDefinitionProvider\":true,")
    emit_text("\"implementationProvider\":true,")
    emit_text("\"selectionRangeProvider\":true,")
    emit_text("\"linkedEditingRangeProvider\":true,")
    emit_text("\"documentLinkProvider\":{\"resolveProvider\":false},")
    emit_text("\"referencesProvider\":true,")
    emit_text("\"documentHighlightProvider\":true,")
    emit_text("\"documentSymbolProvider\":true,")
    emit_text("\"workspaceSymbolProvider\":true,")
    emit_text("\"documentFormattingProvider\":true,")
    emit_text("\"documentRangeFormattingProvider\":true,")
    emit_text("\"documentOnTypeFormattingProvider\":")
    emit_text("{\"firstTriggerCharacter\":\"}\"},")
    emit_text("\"foldingRangeProvider\":true,")
    emit_text("\"semanticTokensProvider\":{\"legend\":")
    say_token_legend()
    emit_text(",\"full\":true},")
    emit_text("\"renameProvider\":{\"prepareProvider\":true},")
    emit_text("\"codeActionProvider\":true,")
    emit_text("\"inlayHintProvider\":true,")
    emit_text("\"callHierarchyProvider\":true,")
    emit_text("\"typeHierarchyProvider\":true,")
    emit_text("\"codeLensProvider\":{\"resolveProvider\":true},")
    emit_text("\"diagnosticProvider\":{\"interFileDependencies\":true,")
    emit_text("\"workspaceDiagnostics\":true},")
    emit_text("\"completionProvider\":{\"resolveProvider\":true},")
    emit_text("\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]}")
    emit_text("},\"serverInfo\":{\"name\":\"frost\",\"version\":\"1\"}}}")
    say_send()
}

answer_opened :: fn(mut s: Server, mut document: Json, request: i64) {
    params := json_member(document, request, "params")
    named := json_member(document, params, "textDocument")
    uri := json_member(document, named, "uri")
    if (uri < 0) {
        return
    }
    bytes_reset(s.scratch)
    bytes_json(s.scratch, document, uri)
    doc := doc_take(s, bytes_view(s.scratch))
    if (doc < 0) {
        return
    }
    text := json_member(document, named, "text")
    version := json_member(document, named, "version")
    ref held := arena_at(s.docs, doc)
    bytes_reset(held.text)
    bytes_json(held.text, document, text)
    held.version = json_number(document, version)
    publish_findings(s, doc)
}

answer_changed :: fn(mut s: Server, mut document: Json, request: i64) {
    params := json_member(document, request, "params")
    named := json_member(document, params, "textDocument")
    uri := json_member(document, named, "uri")
    if (uri < 0) {
        return
    }
    bytes_reset(s.scratch)
    bytes_json(s.scratch, document, uri)
    doc := doc_take(s, bytes_view(s.scratch))
    if (doc < 0) {
        return
    }
    changes := json_member(document, params, "contentChanges")
    count := json_count(document, changes)
    if (count < 1) {
        return
    }
    // Each one in turn: a change is written against the text the one before
    // it left, so taking only the last would put its bytes at places that
    // moved.
    mut index: i64 = 0
    while (index < count) {
        apply_change(s, doc, document, json_at(document, changes, index))
        index = index + 1
    }
    version := json_member(document, named, "version")
    ref held := arena_at(s.docs, doc)
    held.version = json_number(document, version)
    // Checked once the reader stops, rather than once for each key. What
    // is already on the way in carries text that replaces this.
    held.dirty = 1
}

// The check a change put off. Run when nothing else is on the way in, so a
// burst of keystrokes costs one check rather than one for each of them.
settle_dirty :: fn(mut s: Server) {
    if (frost_rt_stdin_waiting() == 1) {
        return
    }
    mut at: i64 = 0
    while (at < s.docs.count) {
        mut wanted: i64 = -1
        ref held := arena_at(s.docs, at)
        if (held.live == 1 && held.dirty == 1) {
            held.dirty = 0
            wanted = at
        }
        if (wanted >= 0) {
            publish_findings(s, wanted)
        }
        at = at + 1
    }
}

// ---------------------------------------------------------------------------
// Running the passes
// ---------------------------------------------------------------------------

// What a check needs to reach past the recovery mark. The call that arms one
// takes a function and a pointer rather than a body that closes over what is in
// scope, so what the body needs travels in this.
CheckTurn :: struct {
    server: ^u8,
    parser: ^u8,
    doc: i64,
    linting: i64,
}

// What a build of this document would be told to do. The roots and the layers
// are read out of the project's manifest by the check itself, so they start
// empty the way a command line leaves them.
lsp_options :: fn(mut s: Server, doc: i64) -> Options {
    ref held := arena_at(s.docs, doc)
    Options {
        input = bytes_cstr(held.path),
        output = "",
        backend = Backend::Unset,
        link = 0,
        object = 0,
        assemble = 0,
        testing = 0,
        running = 0,
        run_args = "",
        audit_unsafe = 0,
        linting = 0,
        debug_lines = 0,
        libs = "",
        roots = arena_make($SearchRoot, 64),
        layers = arena_make($Layer, 16),
        incremental = 0,
        build_dir = ".frost-build",
        help = 0,
        ok = 1,
    }
}

check_guarded :: fn(raw: ^u8) {
    unsafe {
        turn := ptr_cast($CheckTurn, raw)
        server := ptr_cast($Server, turn^.server)
        parser := ptr_cast($Parser, turn^.parser)
        read_and_check(parser^, lsp_options(server^, turn^.doc))
        if (turn^.linting == 1) {
            lint_program(parser^)
        }
    }
}

// The passes run over the buffer on screen, with everything they take recorded
// so it can go back in one call, and with a mark armed so a refusal comes back
// here rather than ending the process.
//
// What is read out of the parser has to be read before the close: every table
// it names is inside the scope.
run_check :: fn(mut s: Server, doc: i64, mut parser: Parser, linting: i64) {
    // What earlier checks recovered from, given up. The count is what a build
    // is refused on, and a buffer is refused for what is wrong with it.
    frost_rt_recover_clear()
    ref held := arena_at(s.docs, doc)
    path := bytes_cstr(held.path)
    text := bytes_cstr(held.text)
    unsafe { frost_rt_hold_file(path, text) }
    mut turn := CheckTurn {
        server = unsafe { ptr_cast($u8, ptr_to(s)) },
        parser = unsafe { ptr_cast($u8, ptr_to(parser)) },
        doc = doc,
        linting = linting,
    }
    unsafe {
        frost_rt_recover_run(check_guarded, ptr_cast($u8, ptr_to(turn)))
    }
}

// ---------------------------------------------------------------------------
// Findings
// ---------------------------------------------------------------------------

publish_findings :: fn(mut s: Server, doc: i64) {
    mut at: i64 = 0
    while (at < s.published.count) {
        ref seen := arena_at(s.published, at)
        if (seen.doc == doc) {
            seen.live = 0
        }
        at = at + 1
    }
    // What it finds is kept, so the fixes at the caret are answered from this
    // check rather than from one of their own.
    check_into_reports(s, doc)
    mut found := json_parse(bytes_view(s.reports))
    publish_each(s, doc, found)
    json_free(found)
    // A file with nothing wrong is told so, or what it was last told about
    // stays under text that no longer says it.
    ref about := arena_at(s.docs, doc)
    if (already_published(s, doc, bytes_view(about.path)) == false) {
        note_published(s, doc, bytes_view(about.path))
        uri_of_path(s.other, bytes_view(about.path))
        say_open()
        emit_text("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        say_string(bytes_view(s.other))
        emit_text(",\"diagnostics\":[]}}")
        say_send()
    }
    // A file that had reports last time and has none now is told so, or the
    // editor keeps underlining what is no longer there.
    mut index: i64 = 0
    while (index < s.published.count) {
        ref seen := arena_at(s.published, index)
        // Told there is nothing left only where nothing else still has
        // something to say about it: two documents that import one file both
        // report about it, and one of them going quiet is not both.
        if (seen.doc == doc && seen.live == 0 && seen.path.count > 0
            && spoken_for(s, doc, bytes_view(seen.path)) == false) {
            uri_of_path(s.other, bytes_view(seen.path))
            say_open()
            emit_text("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
            say_string(bytes_view(s.other))
            emit_text(",\"diagnostics\":[]}}")
            say_send()
            bytes_reset(seen.path)
        }
        index = index + 1
    }
}

// Whether this round has already told the editor about a file.
already_published :: fn(mut s: Server, doc: i64, path: str) -> bool {
    mut at: i64 = 0
    while (at < s.published.count) {
        ref held := arena_at(s.published, at)
        if (held.doc == doc && held.live == 1 && held.path.count > 0
            && same_path(bytes_view(held.path), path)) {
            return true
        }
        at = at + 1
    }
    false
}

// The files the check read: the name each is reported under, then where it
// is, each ending in a terminator.
//
// Copied out while the check is alive. Everything it took goes back in one
// call, and what an answer needs after that has to sit where the call does
// not reach.
hold_modules :: fn(mut s: Server, mut parser: Parser) {
    bytes_reset(s.modules)
    mut at: i64 = 0
    while (at < parser.modules.count) {
        entry := arena_at(parser.modules, at)
        bytes_cstr_in(s.modules, entry.name)
        bytes_byte(s.modules, 0)
        bytes_cstr_in(s.modules, entry.path)
        bytes_byte(s.modules, 0)
        at = at + 1
    }
}

// Where the file a report names is on this machine, read out of what was
// held. Answers nothing where no file was read under that name.
held_path_of :: fn(mut s: Server, named: str) -> str {
    text := bytes_view(s.modules)
    length := str_len(text)
    mut at: i64 = 0
    while (at < length) {
        name_ends := run_end(text, at)
        value := name_ends + 1
        value_ends := run_end(text, value)
        if (same_path(source_text(text, at, name_ends - at), named)) {
            return source_text(text, value, value_ends - value)
        }
        at = value_ends + 1
    }
    ""
}

// Where the run of bytes starting here stops, which is the terminator after
// it.
run_end :: fn(text: str, at: i64) -> i64 {
    length := str_len(text)
    mut walk := at
    while (walk < length && cast($i64, text[walk]) != 0) {
        walk = walk + 1
    }
    walk
}

// Everything the run wrote, as one array. The report machinery writes one
// record on each line, since that is what a build's error stream is read as; a
// reader that takes the whole run at once wants them together.
records_as_array :: fn(mut out: Arena<u8>, records: ^i8) {
    bytes_reset(out)
    bytes_byte(out, CH_LBRACKET)
    length := cstr_len(records)
    mut at: i64 = 0
    while (at < length) {
        byte := byte_at(records, at)
        if (byte == CH_LF) {
            // The newline after the last record ends it rather than separating
            // it from another.
            if (at + 1 < length) {
                bytes_byte(out, CH_COMMA)
            }
        } else {
            bytes_byte(out, byte)
        }
        at = at + 1
    }
    bytes_byte(out, CH_RBRACKET)
}

// Whether two string nodes hold the same text.
json_same_text :: fn(mut document: Json, one: i64, other: i64) -> bool {
    if (one < 0 || other < 0) {
        return one < 0 && other < 0
    }
    len := json_text_len(document, one)
    if (len != json_text_len(document, other)) {
        return false
    }
    source := document.source
    a := json_text_off(document, one)
    b := json_text_off(document, other)
    mut k: i64 = 0
    while (k < len) {
        if (cast($i64, source[a + k]) != cast($i64, source[b + k])) {
            return false
        }
        k = k + 1
    }
    true
}

// The byte a report's line and column name. Both count from one, and the column
// counts bytes, which is what the compiler's own header does.
report_offset :: fn(text: str, line: i64, column: i64) -> i64 {
    length := str_len(text)
    mut at: i64 = 0
    mut seen: i64 = 1
    while (seen < line && at < length) {
        if (cast($i64, text[at]) == CH_LF) {
            seen = seen + 1
        }
        at = at + 1
    }
    mut held: i64 = 1
    while (held < column && at < length && cast($i64, text[at]) != CH_LF) {
        at = at + 1
        held = held + 1
    }
    at
}

// The text of a file: the buffer on screen where the editor has it open, and
// what is on disk otherwise.
text_of_path :: fn(mut s: Server, path: str) -> str {
    mut at: i64 = 0
    while (at < s.docs.count) {
        ref held := arena_at(s.docs, at)
        if (held.live == 1 && same_path(bytes_view(held.path), path)) {
            return bytes_view(held.text)
        }
        at = at + 1
    }
    // The name goes into a buffer of its own, since `path` may be a view into
    // the one the text lands in.
    bytes_reset(s.named)
    bytes_str(s.named, path)
    raw := unsafe { frost_rt_read_file(bytes_cstr(s.named)) }
    bytes_reset(s.read_back)
    bytes_cstr_in(s.read_back, raw)
    bytes_view(s.read_back)
}

// One notification per file the run had something to say about, each carrying
// every record for that file. A record with no place belongs to the file that
// was asked about.
publish_each :: fn(mut s: Server, doc: i64, mut found: Json) {
    root := json_root(found)
    count := json_count(found, root)
    mut index: i64 = 0
    while (index < count) {
        record := json_at(found, root, index)
        file := json_member(found, record, "file")
        if (first_for_file(found, root, index, file)) {
            publish_file(s, doc, found, root, file)
        }
        index = index + 1
    }
}

// Whether this record is the first one about its file, which is what decides
// where a notification is written.
// Whether this record is the first one about its file, which is what decides
// where a notification is written.
first_for_file :: fn(mut found: Json, root: i64, index: i64, file: i64) -> bool {
    mut earlier: i64 = 0
    while (earlier < index) {
        held := json_at(found, root, earlier)
        if (json_same_text(found, json_member(found, held, "file"), file)) {
            return false
        }
        earlier = earlier + 1
    }
    true
}

publish_file :: fn(
    mut s: Server,
    doc: i64,
    mut found: Json,
    root: i64,
    file: i64
) {
    // A record with no place is about the file that was asked about, and
    // its own path is what the editor knows it by.
    bytes_reset(s.other)
    if (file >= 0 && json_kind(found, file) == JsonKind::String) {
        bytes_json(s.other, found, file)
        name_as_path(s)
    } else {
        ref held := arena_at(s.docs, doc)
        bytes_str(s.other, bytes_view(held.path))
    }
    note_published(s, doc, bytes_view(s.other))
    text := text_of_path(s, bytes_view(s.other))
    uri_of_path(s.scratch, bytes_view(s.other))
    say_open()
    emit_text("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
    say_string(bytes_view(s.scratch))
    emit_text(",\"diagnostics\":[")
    count := json_count(found, root)
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < count) {
        record := json_at(found, root, index)
        if (json_same_text(found, json_member(found, record, "file"), file)) {
            if (written > 0) {
                emit_text(",")
            }
            say_diagnostic(found, record, text)
            written = written + 1
        }
        index = index + 1
    }
    emit_text("]}}")
    say_send()
}

// The name a report calls a file, turned into where that file is. A report
// names a file the way a build writes it in its output, which is not where
// the file is; an editor knows it by where it is.
name_as_path :: fn(mut s: Server) {
    held := held_path_of(s, bytes_view(s.other))
    if (str_len(held) == 0) {
        return
    }
    // What was held is a buffer of its own, so emptying this one leaves
    // what is being copied where it is.
    bytes_reset(s.other)
    bytes_str(s.other, held)
}

// This file is one the editor has been told about, so it can be told there is
// nothing left when the last report about it goes.
note_published :: fn(mut s: Server, doc: i64, path: str) {
    mut at: i64 = 0
    while (at < s.published.count) {
        ref held := arena_at(s.published, at)
        if (held.doc == doc && held.path.count > 0
            && same_path(bytes_view(held.path), path)) {
            held.live = 1
            return
        }
        at = at + 1
    }
    mut index: i64 = 0
    while (index < s.published.count) {
        ref held := arena_at(s.published, index)
        if (held.path.count == 0) {
            bytes_reset(held.path)
            bytes_str(held.path, path)
            held.doc = doc
            held.live = 1
            return
        }
        index = index + 1
    }
    made := arena_push(
        s.published,
        Published { path = arena_make($u8, 1024), doc = doc, live = 1 }
    )
    ref held := arena_at(s.published, made)
    bytes_reset(held.path)
    bytes_str(held.path, path)
}

say_diagnostic :: fn(mut found: Json, record: i64, text: str) {
    line := json_number(found, json_member(found, record, "line"))
    column := json_number(found, json_member(found, record, "column"))
    offset := report_offset(text, line, column)
    // The caret sits on one byte, and what a reader wants underlined is the
    // name it points into. A place that is not a name stays one byte wide.
    mut ends := name_end(text, offset)
    if (ends == offset && offset < str_len(text)) {
        ends = offset + 1
    }
    emit_text("{\"range\":")
    say_range(
        place_line(text, offset),
        place_character(text, offset),
        place_line(text, ends),
        place_character(text, ends)
    )
    emit_text(",\"severity\":")
    severity := json_member(found, record, "severity")
    if (json_text_eq(found, severity, "warning")) {
        emit_text("2")
    } else {
        emit_text("1")
    }
    emit_text(",\"source\":\"frost\",\"message\":\"")
    say_raw_string(found, json_member(found, record, "message"))
    emit_text("\"}")
}

// ---------------------------------------------------------------------------
// Formatting
// ---------------------------------------------------------------------------

// The whole document, laid out. One edit covering everything, since the
// formatter reads a file and writes a file rather than telling anyone which
// lines it moved.
answer_formatting :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    laid_out := lay_out(s, doc)
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    say_open()
    say_result_head(document, request)
    if (str_len(laid_out) == 0) {
        emit_text("null}")
        say_send()
        return
    }
    emit_text("[{\"range\":")
    // From the first byte to the last, which is all of it however the text
    // ends.
    say_range(
        0,
        0,
        place_line(text, str_len(text)),
        place_character(text, str_len(text))
    )
    emit_text(",\"newText\":")
    say_string(laid_out)
    emit_text("}]}")
    say_send()
}

// The document as the formatter writes it. The formatter emits, so the text is
// taken out of the emit buffer and put where a reply can be written around it.
lay_out :: fn(mut s: Server, doc: i64) -> str {
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    emit_to_memory()
    format_source(text, str_len(text))
    written := emit_memory_text()
    bytes_reset(s.read_back)
    bytes_str(s.read_back, written)
    bytes_view(s.read_back)
}
// ---------------------------------------------------------------------------
// Where a name is written
// ---------------------------------------------------------------------------

// The name under a request's position, put where every answer reads it from,
// and where it starts. Answers -1 where the position is not in one.
//
// The buffer is the server's own rather than one handed in: a call weighing the
// server against a buffer inside it is the aliasing the exclusivity rule
// refuses, and it is right to.
name_at_position :: fn(
    mut s: Server,
    mut document: Json,
    request: i64,
    doc: i64
) -> i64 {
    params := json_member(document, request, "params")
    position := json_member(document, params, "position")
    line := json_number(document, json_member(document, position, "line"))
    character := json_number(
        document,
        json_member(document, position, "character")
    )
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    offset := place_offset(text, line, character)
    starts := name_start(text, offset)
    ends := name_end(text, starts)
    if (ends == starts) {
        return -1
    }
    bytes_reset(s.other)
    mut at := starts
    while (at < ends) {
        bytes_byte(s.other, cast($i64, text[at]))
        at = at + 1
    }
    starts
}

answer_definition :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    text := text_of_path(s, bytes_view(s.found))
    uri_of_path(s.scratch, bytes_view(s.found))
    say_open()
    say_result_head(document, request)
    emit_text("{\"uri\":")
    say_string(bytes_view(s.scratch))
    emit_text(",\"range\":")
    ends := s.found_off + s.found_len
    say_range(
        place_line(text, s.found_off),
        place_character(text, s.found_off),
        place_line(text, ends),
        place_character(text, ends)
    )
    emit_text("}}")
    say_send()
}

say_null_result :: fn(mut document: Json, request: i64) {
    say_open()
    say_result_head(document, request)
    emit_text("null}")
    say_send()
}

// ---------------------------------------------------------------------------
// What a name is
// ---------------------------------------------------------------------------

// The declaration head a name was written under, and the comment block above
// it, which is what a reader hovering over a call wants to see.
answer_hover :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    text := text_of_path(s, bytes_view(s.found))
    say_open()
    say_result_head(document, request)
    emit_text("{\"contents\":{\"kind\":\"markdown\",\"value\":")
    say_hover_text(text, s.head_off, s.head_to)
    emit_text("}}}")
    say_send()
}

// A fenced block holding the declaration, with whatever the author wrote above
// it under the fence.
// A fenced block holding the declaration, with whatever the author wrote
// above it under the fence.
say_hover_text :: fn(text: str, head_off: i64, head_to: i64) {
    emit_text("\"```frost\\n")
    say_escaped_range(text, head_off, head_to)
    emit_text("\\n```")
    notes := comment_above(text, head_off)
    if (notes < head_off) {
        emit_text("\\n\\n")
        say_comment_range(text, notes, head_off)
    }
    emit_text("\"")
}

say_escaped_range :: fn(text: str, from: i64, to: i64) {
    mut at := from
    while (at < to) {
        say_escaped(cast($i64, text[at]))
        at = at + 1
    }
}

// A comment block written out as prose: the two slashes and the space after
// them are what marks it as a comment rather than part of what it says.
say_comment_range :: fn(text: str, from: i64, to: i64) {
    mut at := from
    while (at < to) {
        ends := line_end(text, to, at)
        mut start := at
        while (start < ends && cast($i64, text[start]) == CH_SPACE) {
            start = start + 1
        }
        if (start + 1 < ends && cast($i64, text[start]) == CH_SLASH
            && cast($i64, text[start + 1]) == CH_SLASH) {
            start = start + 2
            if (start < ends && cast($i64, text[start]) == CH_SPACE) {
                start = start + 1
            }
        }
        say_escaped_range(text, start, ends)
        emit_text("\\n")
        at = ends + 1
    }
}

// The start of the line an offset is on.
line_start_of :: fn(text: str, off: i64) -> i64 {
    mut at := off
    while (at > 0 && cast($i64, text[at - 1]) != CH_LF) {
        at = at - 1
    }
    at
}

// Where the comment block written directly above a line begins, or the line
// itself where nothing is written above it.
comment_above :: fn(text: str, starts: i64) -> i64 {
    mut at := starts
    mut lines: i64 = 0
    while (at > 0 && lines < HEAD_LINES_MAX) {
        above := line_start_of(text, at - 1)
        mut walk := above
        while (walk < at && cast($i64, text[walk]) == CH_SPACE) {
            walk = walk + 1
        }
        if (walk + 1 >= at || cast($i64, text[walk]) != CH_SLASH ||
            cast($i64, text[walk + 1]) != CH_SLASH) {
            return at
        }
        at = above
        lines = lines + 1
    }
    at
}

// ---------------------------------------------------------------------------
// What a file declares
// ---------------------------------------------------------------------------

// Every top-level declaration in the document, in the order they are written.
// Read off the tables the passes filled, so a name is what the compiler
// resolved rather than what a pattern matched.
answer_document_symbols :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_symbols_of(text, "")
    emit_text("]}")
    say_send()
}

// Every name written anywhere under the workspace, narrowed by what was asked
// for. A walk over the sources rather than a check, since the question is about
// every file rather than about one.
answer_workspace_symbols :: fn(mut s: Server, mut document: Json, request: i64) {
    params := json_member(document, request, "params")
    query := json_member(document, params, "query")
    walk_sources(s)
    bytes_reset(s.other)
    if (query >= 0) {
        bytes_json(s.other, document, query)
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            written = written + say_workspace_symbols_of(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    emit_text("]}")
    say_send()
}

// The declarations a text holds, as the protocol's own nested shape. Read off
// the source rather than off a parse, so a file that does not compile still
// answers, which is what an editor asking while a line is half-written needs.
say_symbols_of :: fn(text: str, prefix: str) {
    length := source_end_of(text)
    mut at: i64 = 0
    mut written: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            if (written > 0) {
                emit_text(",")
            }
            say_one_symbol(text, at, named, ends, length)
            written = written + 1
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
}

say_one_symbol :: fn(
    text: str,
    at: i64,
    named: i64,
    ends: i64,
    length: i64
) {
    emit_text("{\"name\":")
    say_string_range(text, at, at + named)
    emit_text(",\"kind\":")
    frost_rt_emit_int(symbol_kind(text, at, named, ends))
    emit_text(",\"range\":")
    // The whole declaration, body and all, which is what an outline highlights
    // when a reader picks a name out of it.
    ends_at := declaration_extent(text, at, ends, length)
    say_range(
        place_line(text, at),
        0,
        place_line(text, ends_at),
        place_character(text, ends_at)
    )
    emit_text(",\"selectionRange\":")
    say_range(
        place_line(text, at),
        place_character(text, at),
        place_line(text, at + named),
        place_character(text, at + named)
    )
    emit_text("}")
}

// One name, as the shape a workspace search answers with, which carries the
// file it is in rather than sitting inside a document's list. Answers how many
// were written.
say_workspace_symbols_of :: fn(
    text: str,
    uri: str,
    wanted: str,
    already: i64
) -> i64 {
    length := source_end_of(text)
    mut at: i64 = 0
    mut written: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0 && name_holds(text, at, named, wanted)) {
            if (already + written > 0) {
                emit_text(",")
            }
            emit_text("{\"name\":")
            say_string_range(text, at, at + named)
            emit_text(",\"kind\":")
            frost_rt_emit_int(symbol_kind(text, at, named, ends))
            emit_text(",\"location\":{\"uri\":")
            say_string(uri)
            emit_text(",\"range\":")
            say_range(
                place_line(text, at),
                place_character(text, at),
                place_line(text, at + named),
                place_character(text, at + named)
            )
            emit_text("}}")
            written = written + 1
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    written
}

// Whether a name holds what was searched for, without regard to case, which is
// what a reader typing part of one expects.
name_holds :: fn(text: str, at: i64, named: i64, wanted: str) -> bool {
    length := str_len(wanted)
    if (length == 0) {
        return true
    }
    if (length > named) {
        return false
    }
    mut start: i64 = 0
    while (start + length <= named) {
        mut k: i64 = 0
        mut same: bool = true
        while (k < length && same) {
            if (folded(cast($i64, text[at + start + k]))
                != folded(cast($i64, wanted[k]))) {
                same = false
            }
            k = k + 1
        }
        if (same) {
            return true
        }
        start = start + 1
    }
    false
}

folded :: fn(byte: i64) -> i64 {
    if (byte >= CH_UPPER_A && byte <= CH_UPPER_Z) {
        return byte + 32
    }
    byte
}

// Which of the protocol's kinds a declaration is. The numbers are the
// protocol's own: 12 a function, 23 a struct, 10 an enum, 14 a constant.
symbol_kind :: fn(text: str, at: i64, named: i64, ends: i64) -> i64 {
    mut walk := at + named
    while (walk < ends && cast($i64, text[walk]) == CH_SPACE) {
        walk = walk + 1
    }
    // Past the `::` and the space after it, which is where the declaration
    // says what kind it is.
    if (walk + 2 < ends && cast($i64, text[walk]) == CH_COLON) {
        walk = walk + 2
    }
    while (walk < ends && cast($i64, text[walk]) == CH_SPACE) {
        walk = walk + 1
    }
    if (text_is(text, walk, "fn") || text_is(text, walk, "extern fn") ||
        text_is(text, walk, "safe extern fn")) {
        return 12
    }
    if (text_is(text, walk, "struct") || text_is(text, walk, "linear struct") ||
        text_is(text, walk, "packed struct")) {
        return 23
    }
    if (text_is(text, walk, "enum")) {
        return 10
    }
    if (text_is(text, walk, "bundle")) {
        return 11
    }
    14
}

say_string_range :: fn(text: str, from: i64, to: i64) {
    emit_text("\"")
    say_escaped_range(text, from, to)
    emit_text("\"")
}

// Where the text of a buffer stops. A document is what an editor holds, so it
// has no room for made-up names after it the way a compiled program does, and
// the whole of it is text.
source_end_of :: fn(text: str) -> i64 {
    str_len(text)
}

// ---------------------------------------------------------------------------
// Where a name is used
// ---------------------------------------------------------------------------

// Every place a name is written across the files on screen. Counted over the
// source rather than over the parse: the namespace is flat, so a name written
// anywhere is the same name, and a walk over the text finds it in a table of
// function pointers and in an export line as well as in a call.
answer_references :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    // The walk first: it writes into the buffer the name lands in.
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            written = written + say_uses_in(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    emit_text("]}")
    say_send()
}

// Every place a name is written in the file on screen, as the shape an editor
// paints under the caret.
answer_highlights :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    wanted := bytes_view(s.other)
    width := str_len(wanted)
    length := str_len(text)
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                if (written > 0) {
                    emit_text(",")
                }
                emit_text("{\"range\":")
                say_range(
                    place_line(text, found),
                    place_character(text, found),
                    place_line(text, found + width),
                    place_character(text, found + width)
                )
                emit_text("}")
                written = written + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    emit_text("]}")
    say_send()
}

// Where a run that is not code ends: a line comment at the line it is on, a
// block comment at its close, a string at its closing quote. Answers the
// offset it was given where code starts there.
//
// A name written in a comment or inside a string is text that reads like the
// name and is something else. Renaming through one writes over what a reader
// wrote, and pointing at one sends them where the name is not.
past_non_code :: fn(text: str, at: i64) -> i64 {
    length := str_len(text)
    one := cast($i64, text[at])
    if (one == CH_DQUOTE) {
        mut past := at + 1
        while (past < length && cast($i64, text[past]) != CH_DQUOTE) {
            if (cast($i64, text[past]) == CH_BACKSLASH) {
                past = past + 1
            }
            past = past + 1
        }
        if (past < length) {
            return past + 1
        }
        return length
    }
    if (one != CH_SLASH || at + 1 >= length) {
        return at
    }
    next := cast($i64, text[at + 1])
    if (next == CH_SLASH) {
        mut past := at + 2
        while (past < length && cast($i64, text[past]) != CH_LF) {
            past = past + 1
        }
        return past
    }
    if (next == CH_STAR) {
        // The first close ends it, whatever sits between, which is how the
        // lexer reads one. An unclosed one runs to the end of the file.
        mut past := at + 2
        while (past + 1 < length) {
            if (cast($i64, text[past]) == CH_STAR
                && cast($i64, text[past + 1]) == CH_SLASH) {
                return past + 2
            }
            past = past + 1
        }
        return length
    }
    at
}

// Whether a block comment is still open where this line ends, given whether
// one was open where it started.
//
// A walk that reads a file a line at a time carries this from line to line. A
// declaration written inside a block comment reads exactly like one written
// beside it, and an outline that lists it sends a reader to a line that is
// text.
comment_runs_past :: fn(text: str, at: i64, ends: i64, open: bool) -> bool {
    mut inside := open
    mut walk := at
    while (walk < ends) {
        byte := cast($i64, text[walk])
        if (inside) {
            if (byte == CH_STAR && walk + 1 < ends
                && cast($i64, text[walk + 1]) == CH_SLASH) {
                inside = false
                walk = walk + 2
            } else {
                walk = walk + 1
            }
        } else {
            if (byte == CH_DQUOTE) {
                walk = past_non_code(text, walk)
            } else {
                if (byte == CH_SLASH && walk + 1 < ends
                    && cast($i64, text[walk + 1]) == CH_SLASH) {
                    return false
                }
                if (byte == CH_SLASH && walk + 1 < ends
                    && cast($i64, text[walk + 1]) == CH_STAR) {
                    inside = true
                    walk = walk + 2
                } else {
                    walk = walk + 1
                }
            }
        }
    }
    inside
}

// Whether the name starts exactly here, as a whole word rather than as part of
// a longer one. Answers where it starts, so a walk may step past it.
name_written_at :: fn(text: str, at: i64, wanted: str) -> i64 {
    length := str_len(wanted)
    if (at + length > str_len(text)) {
        return -1
    }
    if (at > 0 && name_byte(cast($i64, text[at - 1]))) {
        return -1
    }
    mut k: i64 = 0
    while (k < length) {
        if (cast($i64, text[at + k]) != cast($i64, wanted[k])) {
            return -1
        }
        k = k + 1
    }
    if (at + length < str_len(text)
        && name_byte(cast($i64, text[at + length]))) {
        return -1
    }
    at
}

say_uses_in :: fn(text: str, uri: str, wanted: str, already: i64) -> i64 {
    length := str_len(text)
    width := str_len(wanted)
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                if (already + written > 0) {
                    emit_text(",")
                }
                emit_text("{\"uri\":")
                say_string(uri)
                emit_text(",\"range\":")
                say_range(
                    place_line(text, found),
                    place_character(text, found),
                    place_line(text, found + width),
                    place_character(text, found + width)
                )
                emit_text("}")
                written = written + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    written
}

// ---------------------------------------------------------------------------
// Renaming
// ---------------------------------------------------------------------------

// What the editor underlines while a new name is typed: the extent of the one
// under the caret.
answer_prepare_rename :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    starts := name_at_position(s, document, request, doc)
    if (starts < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    ends := starts + s.other.count
    say_open()
    say_result_head(document, request)
    say_range(
        place_line(text, starts),
        place_character(text, starts),
        place_line(text, ends),
        place_character(text, ends)
    )
    emit_text("}")
    say_send()
}

// Every place the name is written, replaced. The namespace is flat, so a name
// means one thing across the whole program, and every place it is written has
// to change together.
answer_rename :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    params := json_member(document, request, "params")
    fresh := json_member(document, params, "newName")
    if (fresh < 0) {
        say_null_result(document, request)
        return
    }
    bytes_reset(s.reports)
    bytes_json(s.reports, document, fresh)
    say_open()
    say_result_head(document, request)
    emit_text("{\"changes\":{")
    mut files: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            files = files + say_edits_in(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                bytes_view(s.reports),
                files
            )
        }
        index = index + 1
    }
    emit_text("}}}")
    say_send()
}

// The edits one file needs, under its own URI, or nothing where the name is not
// written in it. Answers 1 where it wrote a file's entry.
say_edits_in :: fn(
    text: str,
    uri: str,
    wanted: str,
    fresh: str,
    already: i64
) -> i64 {
    length := str_len(text)
    width := str_len(wanted)
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                if (written == 0) {
                    if (already > 0) {
                        emit_text(",")
                    }
                    say_string(uri)
                    emit_text(":[")
                } else {
                    emit_text(",")
                }
                emit_text("{\"range\":")
                say_range(
                    place_line(text, found),
                    place_character(text, found),
                    place_line(text, found + width),
                    place_character(text, found + width)
                )
                emit_text(",\"newText\":")
                say_string(fresh)
                emit_text("}")
                written = written + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    if (written == 0) {
        return 0
    }
    emit_text("]")
    1
}

// ---------------------------------------------------------------------------
// Folding
// ---------------------------------------------------------------------------

// Where a brace opens and where it closes, which is what an editor folds by.
// Read off the text, since a file being edited is often one an editor cannot
// parse and folding it is the moment a reader most wants it.
answer_folding :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    length := str_len(text)
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
            continue
        }
        byte := cast($i64, text[at])
        if (byte == CH_LBRACE) {
            closes := matching_brace(text, at)
            from := place_line(text, at)
            to := place_line(text, closes)
            if (to > from + 1) {
                if (written > 0) {
                    emit_text(",")
                }
                emit_text("{\"startLine\":")
                frost_rt_emit_int(from)
                emit_text(",\"endLine\":")
                frost_rt_emit_int(to - 1)
                emit_text("}")
                written = written + 1
            }
        }
        at = at + 1
    }
    emit_text("]}")
    say_send()
}

// Where the brace opened here closes, or the end of the text where nothing
// closes it. Text and comments are stepped over, so a brace written inside
// either counts for nothing.
matching_brace :: fn(text: str, opens: i64) -> i64 {
    length := str_len(text)
    mut depth: i64 = 0
    mut at := opens
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
            continue
        }
        byte := cast($i64, text[at])
        if (byte == CH_LBRACE) {
            depth = depth + 1
        }
        if (byte == CH_RBRACE) {
            depth = depth - 1
            if (depth == 0) {
                return at
            }
        }
        at = at + 1
    }
    length
}

// ---------------------------------------------------------------------------
// Completion
// ---------------------------------------------------------------------------

// Every name the workspace declares, narrowed to what has been typed. A flat
// namespace gives up the narrowing a `.` provides in a method language, so the
// prefix a family shares is what a reader narrows by, and this is that list.
answer_completion :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    // What is already typed, which is a name that has not been finished
    // rather than one the caret is inside.
    prefix_at_position(s, document, request, doc)
    say_open()
    say_result_head(document, request)
    emit_text("{\"isIncomplete\":false,\"items\":[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            written = written + say_completions_in(
                text,
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    written = written + say_keyword_completions(bytes_view(s.other), written)
    emit_text("]}}")
    say_send()
}

// What has been typed up to the caret, which is what a list is narrowed by.
prefix_at_position :: fn(
    mut s: Server,
    mut document: Json,
    request: i64,
    doc: i64
) {
    params := json_member(document, request, "params")
    position := json_member(document, params, "position")
    line := json_number(document, json_member(document, position, "line"))
    character := json_number(
        document,
        json_member(document, position, "character")
    )
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    offset := place_offset(text, line, character)
    starts := name_start(text, offset)
    bytes_reset(s.other)
    mut at := starts
    while (at < offset) {
        bytes_byte(s.other, cast($i64, text[at]))
        at = at + 1
    }
}

// The declarations one file holds whose names begin with what was typed. The
// head each was written under travels with it, so a reader picking one out of
// the list is reading the signature rather than guessing at it.
say_completions_in :: fn(text: str, prefix: str, already: i64) -> i64 {
    length := str_len(text)
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0
            && begins_with_prefix(text, at, named, prefix)) {
            if (already + written > 0) {
                emit_text(",")
            }
            emit_text("{\"label\":")
            say_string_range(text, at, at + named)
            emit_text(",\"kind\":")
            frost_rt_emit_int(completion_kind(text, at, named, ends))
            emit_text(",\"detail\":")
            head := head_end(text, length, at, ends)
            say_string_range(text, at, head)
            emit_text("}")
            written = written + 1
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    written
}

// Whether a name begins with what was typed. Matched without regard to case,
// which is what a reader typing a lowercase start of a type name expects.
begins_with_prefix :: fn(
    text: str,
    at: i64,
    named: i64,
    prefix: str
) -> bool {
    length := str_len(prefix)
    if (length == 0) {
        return true
    }
    if (length > named) {
        return false
    }
    mut k: i64 = 0
    while (k < length) {
        if (folded(cast($i64, text[at + k])) != folded(cast($i64, prefix[k]))) {
            return false
        }
        k = k + 1
    }
    true
}

// Which of the protocol's kinds a completion is: 3 a function, 22 a struct, 13
// an enum, 21 a constant, 14 a keyword.
completion_kind :: fn(text: str, at: i64, named: i64, ends: i64) -> i64 {
    kind := symbol_kind(text, at, named, ends)
    if (kind == 12) {
        return 3
    }
    if (kind == 23) {
        return 22
    }
    if (kind == 10) {
        return 13
    }
    if (kind == 11) {
        return 8
    }
    21
}

// The words the language itself spells, which a reader typing one wants
// finished the same way a name is.
say_keyword_completions :: fn(prefix: str, already: i64) -> i64 {
    words := "fn struct enum bundle extern safe mut move value ref import export while for in if else match case return continue break defer unsafe when uses with distinct linear packed align where test true false and or not"
    length := str_len(words)
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        mut ends := at
        while (ends < length && cast($i64, words[ends]) != CH_SPACE) {
            ends = ends + 1
        }
        if (begins_with_prefix(words, at, ends - at, prefix)) {
            if (already + written > 0) {
                emit_text(",")
            }
            emit_text("{\"label\":")
            say_string_range(words, at, ends)
            emit_text(",\"kind\":14}")
            written = written + 1
        }
        at = ends + 1
    }
    written
}

// ---------------------------------------------------------------------------
// The fixes the reports carry
// ---------------------------------------------------------------------------

// A report that knows the answer says so, and this hands that answer to the
// editor as an edit it can apply. A reader told what is wrong and where the
// answer goes has one keystroke left.
answer_code_actions :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    // A change whose check is still waiting is one this answer would be about
    // the wrong text of. The edit an editor applies is a range, and a range
    // read off text that has been replaced lands somewhere else.
    if (doc >= 0) {
        mut wanted: i64 = -1
        ref about := arena_at(s.docs, doc)
        if (about.dirty == 1) {
            about.dirty = 0
            wanted = doc
        }
        if (wanted >= 0) {
            publish_findings(s, wanted)
        }
    }
    if (doc < 0 || doc != s.held_for) {
        say_open()
        say_result_head(document, request)
        emit_text("[]}")
        say_send()
        return
    }
    params := json_member(document, request, "params")
    asked := json_member(document, params, "range")
    from := json_member(document, asked, "start")
    to := json_member(document, asked, "end")
    from_line := json_number(document, json_member(document, from, "line"))
    to_line := json_number(document, json_member(document, to, "line"))
    mut found := json_parse(bytes_view(s.held_reports))
    ref held := arena_at(s.docs, doc)
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_fixes(s, found, doc, from_line, to_line, bytes_view(held.text))
    emit_text("]}")
    say_send()
    json_free(found)
}

say_fixes :: fn(
    mut s: Server,
    mut found: Json,
    doc: i64,
    from_line: i64,
    to_line: i64,
    text: str
) {
    root := json_root(found)
    count := json_count(found, root)
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < count) {
        record := json_at(found, root, index)
        fix := json_member(found, record, "fix")
        line := json_number(found, json_member(found, record, "line")) - 1
        if (fix >= 0 && line >= from_line && line <= to_line) {
            if (written > 0) {
                emit_text(",")
            }
            say_one_fix(s, found, record, fix, doc, text)
            written = written + 1
        }
        index = index + 1
    }
}

say_one_fix :: fn(
    mut s: Server,
    mut found: Json,
    record: i64,
    fix: i64,
    doc: i64,
    text: str
) {
    span := json_member(found, fix, "span")
    from := json_number(found, json_at(found, span, 0))
    to := json_number(found, json_at(found, span, 1))
    certain := json_member(found, fix, "certain")
    bytes_reset(s.other)
    file := json_member(found, fix, "file")
    if (file >= 0 && json_kind(found, file) == JsonKind::String) {
        bytes_json(s.other, found, file)
        name_as_path(s)
    } else {
        ref held := arena_at(s.docs, doc)
        bytes_str(s.other, bytes_view(held.path))
    }
    uri_of_path(s.scratch, bytes_view(s.other))
    // What the edit does rather than what is wrong with the line. The message
    // is already under the caret; the title is read off a menu.
    replacement := json_member(found, fix, "replacement")
    emit_text("{\"title\":\"")
    if (json_text_len(found, replacement) == 0) {
        emit_text("Take this out")
    } else {
        emit_text("Write ")
        say_raw_string(found, replacement)
        emit_text(" here")
    }
    emit_text("\",\"kind\":\"quickfix\"")
    if (json_kind(found, certain) == JsonKind::True) {
        emit_text(",\"isPreferred\":true")
    }
    emit_text(",\"edit\":{\"changes\":{")
    say_string(bytes_view(s.scratch))
    emit_text(":[{\"range\":")
    say_range(
        place_line(text, from),
        place_character(text, from),
        place_line(text, to),
        place_character(text, to)
    )
    emit_text(",\"newText\":")
    say_string_of_node(found, replacement)
    emit_text("}]}}}")
}

// A string node written back out with its own escapes kept, which is what goes
// where nothing read them.
say_string_of_node :: fn(mut found: Json, node: i64) {
    emit_text("\"")
    say_raw_string(found, node)
    emit_text("\"")
}

// Where a declaration stops: the brace it opens, where it opens one, and the
// end of what it was written across otherwise.
declaration_extent :: fn(
    text: str,
    at: i64,
    ends: i64,
    length: i64
) -> i64 {
    head := head_end(text, length, at, ends)
    // A head stops in front of the brace a body opens, since what a reader
    // reads is the signature. What a declaration covers is the body with it,
    // so the brace is looked for past the head rather than inside it.
    mut walk := head
    while (walk < length && cast($i64, text[walk]) != CH_LF) {
        if (cast($i64, text[walk]) == CH_LBRACE) {
            return matching_brace(text, walk) + 1
        }
        walk = walk + 1
    }
    head
}

// Whether a file some other document reported about still has something said
// about it.
// What a document was saying about the files it read, given up when it closes.
//
// A file no other open document reports about is told there is nothing left,
// and every entry this document holds stops standing for it. Without the
// second part, a file another document later goes quiet about stays underlined
// on the word of a document nobody has open.
forget_published :: fn(mut s: Server, doc: i64) {
    mut at: i64 = 0
    while (at < s.published.count) {
        ref seen := arena_at(s.published, at)
        if (seen.doc == doc) {
            seen.live = 0
        }
        at = at + 1
    }
    mut index: i64 = 0
    while (index < s.published.count) {
        ref seen := arena_at(s.published, index)
        if (seen.doc == doc && seen.path.count > 0) {
            if (spoken_for(s, doc, bytes_view(seen.path)) == false) {
                uri_of_path(s.other, bytes_view(seen.path))
                say_open()
                emit_text("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
                say_string(bytes_view(s.other))
                emit_text(",\"diagnostics\":[]}}")
                say_send()
            }
            bytes_reset(seen.path)
        }
        index = index + 1
    }
}

spoken_for :: fn(mut s: Server, doc: i64, path: str) -> bool {
    mut at: i64 = 0
    while (at < s.published.count) {
        ref held := arena_at(s.published, at)
        if (held.doc != doc && held.live == 1 && held.path.count > 0
            && same_path(bytes_view(held.path), path)) {
            return true
        }
        at = at + 1
    }
    false
}

// ---------------------------------------------------------------------------
// The files under the workspace
// ---------------------------------------------------------------------------

// How deep the walk goes. A project nests its sources a few directories down;
// anything past this is a loop somebody made with a link.
WALK_DEPTH :: 16

// Every Frost source under the workspace, as paths, each ending in a
// terminator.
//
// Read fresh for each question rather than held, since a file written outside
// the editor is one a reader expects to find. What it costs is the directory
// entries; the files themselves are read only where an answer needs them.
walk_sources :: fn(mut s: Server) {
    bytes_reset(s.sources)
    if (s.root.count == 0) {
        // With no workspace named, what is open is what there is.
        mut at: i64 = 0
        while (at < s.docs.count) {
            ref held := arena_at(s.docs, at)
            if (held.live == 1) {
                bytes_str(s.sources, bytes_view(held.path))
                bytes_byte(s.sources, 0)
            }
            at = at + 1
        }
        return
    }
    bytes_reset(s.named)
    bytes_str(s.named, bytes_view(s.root))
    walk_under(s, 0, s.named.count, 0)
}

// One directory, then the ones below it. The runtime holds one walk at a time,
// so the names come out first and the walk into them follows: reading a
// directory inside another would take the handle the outer one is standing on.
//
// The directory being walked is the run of bytes `from` through `to` in the
// buffer of names, which is where each one below it is written in turn.
walk_under :: fn(mut s: Server, from: i64, to: i64, depth: i64) {
    if (depth > WALK_DEPTH) {
        return
    }
    bytes_reset(s.other)
    named := bytes_view(s.named)
    mut at := from
    while (at < to) {
        bytes_byte(s.other, cast($i64, named[at]))
        at = at + 1
    }
    if (unsafe { frost_rt_dir_open(bytes_cstr(s.other)) } == 0) {
        return
    }
    // Where the names this directory holds start, so the walk into each of
    // them can be written after the ones already held.
    start := s.walking.count
    mut entry := unsafe { frost_rt_dir_next() }
    while (cstr_len(entry) != 0) {
        if (walked_into(entry)) {
            bytes_byte(s.walking, frost_rt_dir_entry_is_dir())
            bytes_cstr_in(s.walking, entry)
            bytes_byte(s.walking, 0)
        }
        entry = unsafe { frost_rt_dir_next() }
    }
    frost_rt_dir_close()
    mut walk := start
    while (walk < s.walking.count) {
        held := bytes_view(s.walking)
        is_dir := cast($i64, held[walk])
        name_at := walk + 1
        name_ends := run_end(held, name_at)
        // The full path, written into the buffer of names past what is there.
        was := s.named.count
        bytes_byte(s.named, CH_SLASH)
        mut k := name_at
        while (k < name_ends) {
            byte := cast($i64, held[k])
            bytes_byte(s.named, byte)
            k = k + 1
        }
        if (is_dir == 1) {
            walk_under(s, from, s.named.count, depth + 1)
        } else if (ends_in_frost(bytes_view(s.walking), name_at, name_ends)) {
            whole := bytes_view(s.named)
            mut index := from
            while (index < s.named.count) {
                bytes_byte(s.sources, cast($i64, whole[index]))
                index = index + 1
            }
            bytes_byte(s.sources, 0)
        }
        s.named.count = was
        walk = name_ends + 1
    }
    s.walking.count = start
}

// Whether a directory entry is one a project keeps sources under. A name
// beginning with a dot is the tooling own, and `target` holds what a build
// wrote.
walked_into :: fn(name: ^i8) -> bool {
    if (cstr_len(name) == 0 || byte_at(name, 0) == CH_DOT) {
        return false
    }
    cstr_eq(name, "target") == false
}

ends_in_frost :: fn(text: str, from: i64, to: i64) -> bool {
    if (to - from < 7) {
        return false
    }
    named := ".frost"
    mut k: i64 = 0
    while (k < 6) {
        if (cast($i64, text[to - 6 + k]) != cast($i64, named[k])) {
            return false
        }
        k = k + 1
    }
    true
}

// How many sources the walk found, and where each one is, so a caller reads
// them one after the other without holding a view into the buffer while it
// writes into another.
source_at :: fn(mut s: Server, index: i64) -> i64 {
    text := bytes_view(s.sources)
    length := str_len(text)
    mut at: i64 = 0
    mut seen: i64 = 0
    while (at < length) {
        if (seen == index) {
            return at
        }
        at = run_end(text, at) + 1
        seen = seen + 1
    }
    -1
}

source_count :: fn(mut s: Server) -> i64 {
    text := bytes_view(s.sources)
    length := str_len(text)
    mut at: i64 = 0
    mut seen: i64 = 0
    while (at < length) {
        at = run_end(text, at) + 1
        seen = seen + 1
    }
    seen
}


// One of the sources the walk found, in a buffer of its own, since reading
// the file it names writes into the others.
source_into :: fn(mut s: Server, index: i64) -> bool {
    at := source_at(s, index)
    if (at < 0) {
        return false
    }
    text := bytes_view(s.sources)
    ends := run_end(text, at)
    bytes_reset(s.each)
    mut k := at
    while (k < ends) {
        bytes_byte(s.each, cast($i64, text[k]))
        k = k + 1
    }
    true
}

// ---------------------------------------------------------------------------
// The call being written
// ---------------------------------------------------------------------------

// The head of the function whose arguments are being written, and which of
// its parameters the caret is in.
//
// Read back from the caret rather than out of the parse: a call with its
// arguments half written is a call the parser refuses, and that is exactly
// when a reader wants to be told what goes there.
answer_signature :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    params := json_member(document, request, "params")
    position := json_member(document, params, "position")
    line := json_number(document, json_member(document, position, "line"))
    character := json_number(
        document,
        json_member(document, position, "character")
    )
    mut caret: i64 = 0
    ref about := arena_at(s.docs, doc)
    caret = place_offset(bytes_view(about.text), line, character)
    opens := call_opens(bytes_view(about.text), caret)
    if (opens < 0) {
        say_null_result(document, request)
        return
    }
    filling := argument_at(bytes_view(about.text), opens, caret)
    // The name in front of the bracket, which is what the call names.
    text := bytes_view(about.text)
    ends := name_end(text, name_start(text, opens - 1))
    starts := name_start(text, opens - 1)
    if (ends <= starts) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    bytes_reset(s.other)
    mut k := starts
    while (k < ends) {
        bytes_byte(s.other, cast($i64, text[k]))
        k = k + 1
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("{\"signatures\":[{\"label\":")
    flatten_head(s)
    say_string(bytes_view(s.reports))
    emit_text(",\"parameters\":[")
    say_parameters(bytes_view(s.reports))
    emit_text("]}],\"activeSignature\":0,\"activeParameter\":")
    frost_rt_emit_int(filling)
    emit_text("}}")
    say_send()
}

// Where the bracket the caret is inside opens, or -1 where it is inside none.
// Text and comments are stepped over, so a bracket written in either counts
// for nothing.
call_opens :: fn(text: str, caret: i64) -> i64 {
    mut opens: Arena<i64> = arena_make($i64, 64)
    mut at: i64 = 0
    while (at < caret) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
            continue
        }
        byte := cast($i64, text[at])
        if (byte == CH_LPAREN) {
            arena_push(opens, at)
        }
        if (byte == CH_RPAREN && opens.count > 0) {
            opens.count = opens.count - 1
        }
        at = at + 1
    }
    if (opens.count == 0) {
        return -1
    }
    arena_at(opens, opens.count - 1)
}

// Which argument the caret is in, counting the commas written at the depth
// the bracket opened.
argument_at :: fn(text: str, opens: i64, caret: i64) -> i64 {
    mut depth: i64 = 0
    mut seen: i64 = 0
    mut at := opens + 1
    while (at < caret) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
            continue
        }
        byte := cast($i64, text[at])
        if (byte == CH_LPAREN || byte == CH_LBRACKET || byte == CH_LBRACE) {
            depth = depth + 1
        }
        if (byte == CH_RPAREN || byte == CH_RBRACKET || byte == CH_RBRACE) {
            depth = depth - 1
        }
        if (byte == CH_COMMA && depth == 0) {
            seen = seen + 1
        }
        at = at + 1
    }
    seen
}

// The declaration head of the name held, put where the answer reads it from.
// Where the name held is declared, and the head it was written under. The
// namespace is flat, so at most one declaration answers to a name and the
// first one found is it.
//
// Read off the source rather than off a parse, so a file that does not
// compile still answers, which is what an editor asking while a line is
// half-written needs.
find_declaration :: fn(mut s: Server) -> bool {
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            if (declared_in(s, text)) {
                bytes_reset(s.found)
                bytes_str(s.found, bytes_view(s.each))
                return true
            }
        }
        index = index + 1
    }
    false
}

declared_in :: fn(mut s: Server, text: str) -> bool {
    wanted := bytes_view(s.other)
    length := str_len(text)
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        held := declaration_head(text, at, ends)
        if (!commented && held == str_len(wanted)
            && name_written_at(text, at, wanted) == at) {
            s.found_off = at
            s.found_len = held
            s.head_off = at
            s.head_to = head_end(text, length, at, ends)
            return true
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    false
}

// Each parameter of a head, as the text of it, so an editor can underline the
// one the caret is in. The list is what is between the brackets the parameters
// are written in, split on the commas written at that depth.
say_parameters :: fn(head: str) {
    length := str_len(head)
    mut opens: i64 = -1
    mut at: i64 = 0
    while (at < length && opens < 0) {
        if (cast($i64, head[at]) == CH_LPAREN) {
            opens = at
        }
        at = at + 1
    }
    if (opens < 0) {
        return
    }
    mut depth: i64 = 0
    mut from := opens + 1
    mut written: i64 = 0
    mut walk := opens + 1
    while (walk < length) {
        byte := cast($i64, head[walk])
        if (byte == CH_LPAREN || byte == CH_LBRACKET || byte == CH_LT) {
            depth = depth + 1
        }
        if (byte == CH_RBRACKET || byte == CH_GT) {
            depth = depth - 1
        }
        if (byte == CH_RPAREN && depth == 0) {
            written = written + say_one_parameter(head, from, walk, written)
            return
        }
        if (byte == CH_RPAREN) {
            depth = depth - 1
        }
        if (byte == CH_COMMA && depth == 0) {
            written = written + say_one_parameter(head, from, walk, written)
            from = walk + 1
        }
        walk = walk + 1
    }
}

say_one_parameter :: fn(head: str, from: i64, to: i64, already: i64) -> i64 {
    mut starts := from
    while (starts < to && cast($i64, head[starts]) == CH_SPACE) {
        starts = starts + 1
    }
    mut ends := to
    while (ends > starts && cast($i64, head[ends - 1]) == CH_SPACE) {
        ends = ends - 1
    }
    if (ends <= starts) {
        return 0
    }
    if (already > 0) {
        emit_text(",")
    }
    emit_text("{\"label\":")
    say_string_range(head, starts, ends)
    emit_text("}")
    1
}


// The head that was found, on one line, which is what a signature is shown
// as. A head written across several lines carries its breaks; the panel it
// goes in has one line.
flatten_head :: fn(mut s: Server) {
    text := text_of_path(s, bytes_view(s.found))
    bytes_reset(s.reports)
    mut at := s.head_off
    mut spaced: i64 = 0
    while (at < s.head_to) {
        byte := cast($i64, text[at])
        if (byte == CH_LF || byte == CH_SPACE) {
            if (spaced == 0) {
                bytes_byte(s.reports, CH_SPACE)
                spaced = 1
            }
        } else {
            bytes_byte(s.reports, byte)
            spaced = 0
        }
        at = at + 1
    }
}

// ---------------------------------------------------------------------------
// Where a name is declared, what its type is, and what works on it
// ---------------------------------------------------------------------------

// The place a name was declared, written as one Location.
//
// Shared by go to definition and go to declaration. A Frost name space is flat
// and a name is declared once, so the two questions have one answer and an
// editor that asks either gets it.
say_declaration_place :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    say_found_place(s, document, request)
}

// The declaration the last lookup found, as one Location.
say_found_place :: fn(mut s: Server, mut document: Json, request: i64) {
    text := text_of_path(s, bytes_view(s.found))
    uri_of_path(s.scratch, bytes_view(s.found))
    say_open()
    say_result_head(document, request)
    emit_text("{\"uri\":")
    say_string(bytes_view(s.scratch))
    emit_text(",\"range\":")
    ends := s.found_off + s.found_len
    say_range(
        place_line(text, s.found_off),
        place_character(text, s.found_off),
        place_line(text, ends),
        place_character(text, ends)
    )
    emit_text("}}")
    say_send()
}

answer_declaration :: fn(mut s: Server, mut document: Json, request: i64) {
    say_declaration_place(s, document, request)
}

// Whether the head a name is declared under says the name is a type.
//
// A reader who asks for the type of a type is asking about that same
// declaration, so the question ends where it started.
head_declares_a_type :: fn(text: str, head_off: i64, named: i64) -> bool {
    length := str_len(text)
    mut at := head_off + named
    while (at < length && cast($i64, text[at]) == CH_SPACE) {
        at = at + 1
    }
    if (at + 1 < length && cast($i64, text[at]) == CH_COLON
        && cast($i64, text[at + 1]) == CH_COLON) {
        at = at + 2
    }
    while (at < length && cast($i64, text[at]) == CH_SPACE) {
        at = at + 1
    }
    text_is(text, at, "struct") || text_is(text, at, "enum") ||
        text_is(text, at, "distinct") || text_is(text, at, "flags") ||
        text_is(text, at, "packed") || text_is(text, at, "linear") ||
        text_is(text, at, "type")
}

// The type a name was written with, put in `s.named`.
//
// Read off the text rather than off a check, since the question is asked while
// a file is being edited and often does not compile. Two shapes carry a type:
// `name: Type` and `name := Type {`, which covers a local, a field and a
// parameter.
type_written_for :: fn(mut s: Server, text: str, wanted: str) -> bool {
    length := str_len(text)
    width := str_len(wanted)
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                if (type_after(s, text, found + width)) {
                    return true
                }
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    false
}

// The name of the type written after this offset, where one is.
type_after :: fn(mut s: Server, text: str, from: i64) -> bool {
    length := str_len(text)
    mut walk := from
    while (walk < length && cast($i64, text[walk]) == CH_SPACE) {
        walk = walk + 1
    }
    if (walk + 1 >= length || cast($i64, text[walk]) != CH_COLON) {
        return false
    }
    next := cast($i64, text[walk + 1])
    if (next == CH_COLON) {
        return false
    }
    mut starts := walk + 1
    if (next == CH_EQ) {
        starts = walk + 2
    }
    while (starts < length && cast($i64, text[starts]) == CH_SPACE) {
        starts = starts + 1
    }
    // A view, a pointer or an array of a type is that type, as far as a reader
    // asking where it is declared is concerned.
    while (starts < length
        && (cast($i64, text[starts]) == CH_LBRACKET
            || cast($i64, text[starts]) == CH_RBRACKET
            || cast($i64, text[starts]) == CH_CARET)) {
        starts = starts + 1
    }
    ends := name_end(text, starts)
    if (ends == starts) {
        return false
    }
    bytes_reset(s.named)
    mut copy := starts
    while (copy < ends) {
        bytes_byte(s.named, cast($i64, text[copy]))
        copy = copy + 1
    }
    true
}

answer_type_definition :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s)) {
        held := text_of_path(s, bytes_view(s.found))
        if (head_declares_a_type(held, s.head_off, s.found_len)) {
            say_found_place(s, document, request)
            return
        }
    }
    ref about := arena_at(s.docs, doc)
    if (type_written_for(s, bytes_view(about.text), bytes_view(s.other))
        == false) {
        say_null_result(document, request)
        return
    }
    bytes_reset(s.other)
    bytes_str(s.other, bytes_view(s.named))
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    say_found_place(s, document, request)
}

// Whether a declaration head between two offsets names a type.
head_takes :: fn(text: str, from: i64, to: i64, wanted: str) -> bool {
    mut at := from
    while (at < to) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0 && found < to) {
                return true
            }
            at = at + 1
        }
    }
    false
}

// Every function written against a type: the ones whose head names it.
//
// Frost has no methods, so what stands in for them is the set of functions
// that take the type. A reader on a struct asking for its implementations is
// asking what operates on it.
say_workers_on :: fn(text: str, uri: str, wanted: str, already: i64) -> i64 {
    length := str_len(text)
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            head := head_end(text, length, at, ends)
            // A function only. A type that holds a field of this one is what
            // the hierarchy above it is for, not what works on it.
            if (symbol_kind(text, at, named, ends) == 12 &&
                head_takes(text, at + named, head, wanted)) {
                if (already + written > 0) {
                    emit_text(",")
                }
                emit_text("{\"uri\":")
                say_string(uri)
                emit_text(",\"range\":")
                say_range(
                    place_line(text, at),
                    place_character(text, at),
                    place_line(text, at + named),
                    place_character(text, at + named)
                )
                emit_text("}")
                written = written + 1
            }
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    written
}

answer_implementation :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            written = written + say_workers_on(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    // A function is its own implementation. Nothing takes it, and a reader
    // who asked is owed the place it is written rather than an empty list.
    if (written == 0 && find_declaration(s)) {
        held := text_of_path(s, bytes_view(s.found))
        uri_of_path(s.scratch, bytes_view(s.found))
        emit_text("{\"uri\":")
        say_string(bytes_view(s.scratch))
        emit_text(",\"range\":")
        stops := s.found_off + s.found_len
        say_range(
            place_line(held, s.found_off),
            place_character(held, s.found_off),
            place_line(held, stops),
            place_character(held, stops)
        )
        emit_text("}")
    }
    emit_text("]}")
    say_send()
}

// ---------------------------------------------------------------------------
// Widening a selection
// ---------------------------------------------------------------------------

// The runs a caret sits inside, innermost first: the name it is on, then each
// bracket that holds it, then the declaration, then the file.
//
// An editor widens a selection one step at a time by walking this chain, so
// each range holds the one in front of it.
answer_selection_range :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    params := json_member(document, request, "params")
    places := json_member(document, params, "positions")
    count := json_count(document, places)
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut index: i64 = 0
    while (index < count) {
        if (index > 0) {
            emit_text(",")
        }
        place := json_at(document, places, index)
        line := json_number(document, json_member(document, place, "line"))
        character := json_number(
            document,
            json_member(document, place, "character")
        )
        say_widening(text, place_offset(text, line, character))
        index = index + 1
    }
    emit_text("]}")
    say_send()
}

// One chain, innermost first. The protocol reads the range at the top as the
// one a first widening gives, and each `parent` as the step after it.
say_widening :: fn(text: str, caret: i64) {
    length := str_len(text)
    from := name_start(text, caret)
    to := name_end(text, from)
    starts := declaration_around(text, caret)
    mut opened: i64 = 0
    if (to > from) {
        emit_text("{\"range\":")
        say_range(
            place_line(text, from),
            place_character(text, from),
            place_line(text, to),
            place_character(text, to)
        )
        opened = opened + 1
    }
    if (starts >= 0) {
        if (opened > 0) {
            emit_text(",\"parent\":")
        }
        ends := line_end(text, length, starts)
        stops := declaration_extent(text, starts, ends, length)
        emit_text("{\"range\":")
        say_range(
            place_line(text, starts),
            0,
            place_line(text, stops),
            place_character(text, stops)
        )
        opened = opened + 1
    }
    if (opened > 0) {
        emit_text(",\"parent\":")
    }
    emit_text("{\"range\":")
    say_range(0, 0, place_line(text, length), place_character(text, length))
    opened = opened + 1
    mut shut: i64 = 0
    while (shut < opened) {
        emit_text("}")
        shut = shut + 1
    }
}

// Where the declaration holding this offset opens, or -1 where the offset is
// between declarations.
declaration_around :: fn(text: str, caret: i64) -> i64 {
    length := str_len(text)
    mut at: i64 = 0
    mut held: i64 = -1
    mut commented: bool = false
    while (at < length && at <= caret) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            held = at
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    if (held < 0) {
        return -1
    }
    ends := line_end(text, length, held)
    if (declaration_extent(text, held, ends, length) < caret) {
        return -1
    }
    held
}

// ---------------------------------------------------------------------------
// The files a file names
// ---------------------------------------------------------------------------

// Every `import` line, as a link to the file it names.
//
// A path is written relative to the file that holds it, so it is joined onto
// that file's own directory before it is given as a URI.
answer_document_links :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    length := str_len(text)
    bytes_reset(s.walking)
    bytes_str(s.walking, bytes_view(held.path))
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        if (!commented && text_is(text, at, "import")) {
            opens := quote_after(text, at, ends)
            if (opens >= 0) {
                closes := quote_after(text, opens + 1, ends)
                if (closes > opens) {
                    if (written > 0) {
                        emit_text(",")
                    }
                    emit_text("{\"range\":")
                    say_range(
                        place_line(text, opens + 1),
                        place_character(text, opens + 1),
                        place_line(text, closes),
                        place_character(text, closes)
                    )
                    emit_text(",\"target\":")
                    beside(s, bytes_view(s.walking), text, opens + 1, closes)
                    uri_of_path(s.scratch, bytes_view(s.other))
                    say_string(bytes_view(s.scratch))
                    emit_text("}")
                    written = written + 1
                }
            }
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    emit_text("]}")
    say_send()
}

// Where the next quote on this line is, or -1.
quote_after :: fn(text: str, from: i64, to: i64) -> i64 {
    mut at := from
    while (at < to) {
        if (cast($i64, text[at]) == CH_DQUOTE) {
            return at
        }
        at = at + 1
    }
    -1
}

// A path written beside a file, put in `s.other`: the file's own directory
// with the written path joined onto it, and each `..` walked back out.
beside :: fn(mut s: Server, holder: str, text: str, from: i64, to: i64) {
    bytes_reset(s.other)
    length := str_len(holder)
    mut cut := length
    while (cut > 0 && separator(cast($i64, holder[cut - 1])) == false) {
        cut = cut - 1
    }
    mut at: i64 = 0
    while (at < cut) {
        bytes_byte(s.other, cast($i64, holder[at]))
        at = at + 1
    }
    mut walk := from
    while (walk < to) {
        if (text_is(text, walk, "../")) {
            s.other.count = one_back(s.other)
            walk = walk + 3
        } else {
            bytes_byte(s.other, cast($i64, text[walk]))
            walk = walk + 1
        }
    }
}

separator :: fn(byte: i64) -> bool {
    byte == CH_SLASH || byte == CH_BACKSLASH
}

// Where a path ends one directory back: past the separator it ends on, then
// back to the one before that.
one_back :: fn(mut a: Arena<u8>) -> i64 {
    held := bytes_view(a)
    mut back := str_len(held)
    if (back > 0) {
        back = back - 1
    }
    while (back > 0 && separator(cast($i64, held[back - 1])) == false) {
        back = back - 1
    }
    back
}

// ---------------------------------------------------------------------------
// Editing one name in several places at once
// ---------------------------------------------------------------------------

// Where the name under the caret is written in this file, so an editor changes
// every one of them as the reader types.
//
// This file only. A change that has to reach other files is a rename, which is
// its own request and its own undo step.
answer_linked_editing :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    wanted := bytes_view(s.other)
    width := str_len(wanted)
    length := str_len(text)
    say_open()
    say_result_head(document, request)
    emit_text("{\"ranges\":[")
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                if (written > 0) {
                    emit_text(",")
                }
                say_range(
                    place_line(text, found),
                    place_character(text, found),
                    place_line(text, found + width),
                    place_character(text, found + width)
                )
                written = written + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    emit_text("]}}")
    say_send()
}

// ---------------------------------------------------------------------------
// Laying out part of a file
// ---------------------------------------------------------------------------

// The declarations a range touches, each replaced by its formatted self.
//
// The formatter reflows, so the file it writes has its own line count and a
// line in one is not a line in the other. What does hold across the two is the
// sequence of declarations: the formatter writes the same ones in the same
// order. So the nth declaration of the buffer is replaced by the nth of the
// laid-out text, and only where the reader's range reaches it.
answer_range_formatting :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    laid_out := lay_out(s, doc)
    if (str_len(laid_out) == 0) {
        say_null_result(document, request)
        return
    }
    // Held apart from the arena the layout is in, so the walk over one is not
    // a walk over storage the other is being read from.
    bytes_reset(s.walking)
    bytes_str(s.walking, laid_out)
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    params := json_member(document, request, "params")
    span := json_member(document, params, "range")
    from := json_number(
        document,
        json_member(document, json_member(document, span, "start"), "line")
    )
    to := json_number(
        document,
        json_member(document, json_member(document, span, "end"), "line")
    )
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_declaration_edits(s, text, from, to)
    emit_text("]}")
    say_send()
}

// One edit for each declaration the lines between `from` and `to` reach.
say_declaration_edits :: fn(mut s: Server, text: str, from: i64, to: i64) {
    length := str_len(text)
    mut written: i64 = 0
    mut seen: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            stops := declaration_extent(text, at, ends, length)
            opens := place_line(text, at)
            closes := place_line(text, stops)
            if (opens <= to && closes >= from) {
                if (written > 0) {
                    emit_text(",")
                }
                emit_text("{\"range\":")
                say_range(opens, 0, closes, place_character(text, stops))
                emit_text(",\"newText\":")
                say_nth_declaration(s, seen)
                emit_text("}")
                written = written + 1
            }
            seen = seen + 1
            at = line_end(text, length, stops) + 1
        } else {
            commented = comment_runs_past(text, at, ends, commented)
            at = ends + 1
        }
    }
}

// The nth declaration of the laid-out text, written as a JSON string.
say_nth_declaration :: fn(mut s: Server, wanted: i64) {
    text := bytes_view(s.walking)
    length := str_len(text)
    mut seen: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            stops := declaration_extent(text, at, ends, length)
            if (seen == wanted) {
                say_string_range(text, at, stops)
                return
            }
            seen = seen + 1
            at = line_end(text, length, stops) + 1
        } else {
            commented = comment_runs_past(text, at, ends, commented)
            at = ends + 1
        }
    }
    say_string("")
}

// ---------------------------------------------------------------------------
// Laying out a line as it is typed
// ---------------------------------------------------------------------------

// The indentation a line takes once the reader closes a brace on it.
//
// A closing brace lines up with the line that opened it. Answered while the
// reader types rather than after, which is the one moment the answer is worth
// anything.
answer_on_type_formatting :: fn(
    mut s: Server,
    mut document: Json,
    request: i64
) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    length := str_len(text)
    params := json_member(document, request, "params")
    place := json_member(document, params, "position")
    line := json_number(document, json_member(document, place, "line"))
    character := json_number(
        document,
        json_member(document, place, "character")
    )
    caret := place_offset(text, line, character)
    // The brace the reader just wrote, which the caret sits after.
    mut closes := caret - 1
    while (closes >= 0 && cast($i64, text[closes]) == CH_SPACE) {
        closes = closes - 1
    }
    if (closes < 0 || cast($i64, text[closes]) != CH_RBRACE) {
        say_null_result(document, request)
        return
    }
    opens := brace_opens(text, closes)
    if (opens < 0) {
        say_null_result(document, request)
        return
    }
    wanted := indent_of(text, length, opens)
    starts := line_starts(text, closes)
    mut inside := starts
    while (inside < length && cast($i64, text[inside]) == CH_SPACE) {
        inside = inside + 1
    }
    if (inside - starts == wanted) {
        say_open()
        say_result_head(document, request)
        emit_text("[]}")
        say_send()
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("[{\"range\":")
    say_range(
        place_line(text, starts),
        0,
        place_line(text, inside),
        place_character(text, inside)
    )
    emit_text(",\"newText\":")
    say_spaces(wanted)
    emit_text("}]}")
    say_send()
}

// A JSON string of that many spaces.
say_spaces :: fn(count: i64) {
    emit_text("\"")
    mut at: i64 = 0
    while (at < count) {
        frost_rt_emit_char(CH_SPACE)
        at = at + 1
    }
    emit_text("\"")
}

// Where the line holding an offset starts.
line_starts :: fn(text: str, at: i64) -> i64 {
    mut walk := at
    while (walk > 0 && cast($i64, text[walk - 1]) != CH_LF) {
        walk = walk - 1
    }
    walk
}

// How many spaces the line holding an offset opens with.
indent_of :: fn(text: str, length: i64, at: i64) -> i64 {
    starts := line_starts(text, at)
    mut walk := starts
    while (walk < length && cast($i64, text[walk]) == CH_SPACE) {
        walk = walk + 1
    }
    walk - starts
}

// Where the brace that this one closes was opened, or -1 where it closes
// nothing. Comments and text are stepped over, so a brace written in either
// counts for nothing.
brace_opens :: fn(text: str, closes: i64) -> i64 {
    mut opens: Arena<i64> = arena_make($i64, 64)
    mut at: i64 = 0
    while (at < closes) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            byte := cast($i64, text[at])
            if (byte == CH_LBRACE) {
                arena_push(opens, at)
            }
            if (byte == CH_RBRACE && opens.count > 0) {
                opens.count = opens.count - 1
            }
            at = at + 1
        }
    }
    if (opens.count == 0) {
        return -1
    }
    arena_at(opens, opens.count - 1)
}

// ---------------------------------------------------------------------------
// Filling out one completion
// ---------------------------------------------------------------------------

// The item as it arrived, with the comment above its declaration added.
//
// A list of names is cheap to write and a comment block for each of them is
// not, so the list carries the names and this fills in the one a reader has
// moved onto.
answer_completion_resolve :: fn(
    mut s: Server,
    mut document: Json,
    request: i64
) {
    params := json_member(document, request, "params")
    label := json_member(document, params, "label")
    if (label < 0 || json_kind(document, label) != JsonKind::String) {
        say_null_result(document, request)
        return
    }
    // The walk holds each directory it opens in `s.other`, so the name has to
    // go in after it rather than before.
    walk_sources(s)
    bytes_reset(s.other)
    bytes_json(s.other, document, label)
    say_open()
    say_result_head(document, request)
    emit_text("{\"label\":")
    say_string(bytes_view(s.other))
    kind := json_member(document, params, "kind")
    if (kind >= 0) {
        emit_text(",\"kind\":")
        frost_rt_emit_int(json_number(document, kind))
    }
    if (find_declaration(s)) {
        flatten_head(s)
        emit_text(",\"detail\":")
        say_string(bytes_view(s.reports))
        emit_text(",\"documentation\":{\"kind\":\"markdown\",\"value\":")
        say_comment_above(s)
        emit_text("}")
    }
    emit_text("}}")
    say_send()
}

// The comment block written above the declaration the last lookup found, as a
// JSON string. Empty where nothing was written above it.
say_comment_above :: fn(mut s: Server) {
    text := text_of_path(s, bytes_view(s.found))
    from := comment_block_above(text, s.found_off)
    if (from >= s.found_off) {
        say_string("")
        return
    }
    emit_text("\"")
    mut at := from
    while (at < s.found_off) {
        ends := line_end(text, str_len(text), at)
        mut walk := at
        while (walk < ends && cast($i64, text[walk]) == CH_SPACE) {
            walk = walk + 1
        }
        if (walk + 1 < ends && cast($i64, text[walk]) == CH_SLASH
            && cast($i64, text[walk + 1]) == CH_SLASH) {
            walk = walk + 2
            if (walk < ends && cast($i64, text[walk]) == CH_SPACE) {
                walk = walk + 1
            }
        }
        while (walk < ends) {
            say_escaped(cast($i64, text[walk]))
            walk = walk + 1
        }
        emit_text("\\n")
        at = ends + 1
    }
    emit_text("\"")
}

// Where the run of comment lines directly above a declaration starts.
comment_block_above :: fn(text: str, at: i64) -> i64 {
    mut from := at
    while (from > 0) {
        above := line_starts(text, from - 1)
        mut walk := above
        while (walk < from && cast($i64, text[walk]) == CH_SPACE) {
            walk = walk + 1
        }
        if (walk + 1 >= from || cast($i64, text[walk]) != CH_SLASH
            || cast($i64, text[walk + 1]) != CH_SLASH) {
            return from
        }
        from = above
    }
    from
}

// ---------------------------------------------------------------------------
// A request the editor took back
// ---------------------------------------------------------------------------

// The id as text, whichever of the two shapes it arrived in.
id_into :: fn(mut a: Arena<u8>, mut document: Json, id: i64) {
    bytes_reset(a)
    if (json_kind(document, id) == JsonKind::String) {
        bytes_json(a, document, id)
        return
    }
    bytes_int(a, json_number(document, id))
}

// An id the editor said it no longer wants an answer to.
note_cancelled :: fn(mut s: Server, mut document: Json, request: i64) {
    params := json_member(document, request, "params")
    id := json_member(document, params, "id")
    if (id < 0) {
        return
    }
    id_into(s.each, document, id)
    // Held as a run so a walk reads them one after the other. Only the ones
    // still waiting matter, and a burst of them is what an editor sends while
    // a reader moves the caret.
    if (s.cancelled.count > CANCEL_ROOM) {
        s.cancelled.count = 0
    }
    bytes_str(s.cancelled, bytes_view(s.each))
    bytes_byte(s.cancelled, 0)
}

// Whether this request was taken back before it was reached, and forget it
// either way: an id is used once.
was_cancelled :: fn(mut s: Server, mut document: Json, request: i64) -> bool {
    if (s.cancelled.count == 0) {
        return false
    }
    id := json_member(document, request, "id")
    if (id < 0) {
        return false
    }
    id_into(s.each, document, id)
    wanted := bytes_view(s.each)
    held := bytes_view(s.cancelled)
    length := str_len(held)
    mut at: i64 = 0
    while (at < length) {
        ends := run_end(held, at)
        if (same_run(held, at, ends, wanted)) {
            return true
        }
        at = ends + 1
    }
    false
}

// Whether the run between two offsets is this text.
same_run :: fn(held: str, from: i64, to: i64, wanted: str) -> bool {
    if (to - from != str_len(wanted)) {
        return false
    }
    mut at: i64 = 0
    while (at < to - from) {
        if (cast($i64, held[from + at]) != cast($i64, wanted[at])) {
            return false
        }
        at = at + 1
    }
    true
}

// What the protocol says a request nobody is waiting for any more is answered
// with.
say_cancelled :: fn(mut document: Json, request: i64) {
    say_open()
    emit_text("{\"jsonrpc\":\"2.0\",\"id\":")
    say_id(document, request)
    emit_text(",\"error\":{\"code\":-32800,\"message\":")
    say_string("the editor took this request back")
    emit_text("}}")
    say_send()
}

// ---------------------------------------------------------------------------
// A file that changed outside the editor
// ---------------------------------------------------------------------------

// Everything on screen, checked again.
//
// A file written by a build, by a branch changing under the editor, or by
// another window is one an open document may import, and what a check said
// about it was true of the text that is gone.
answer_watched_changed :: fn(mut s: Server) {
    mut at: i64 = 0
    while (at < s.docs.count) {
        mut wanted: i64 = -1
        ref held := arena_at(s.docs, at)
        if (held.live == 1) {
            wanted = at
        }
        if (wanted >= 0) {
            publish_findings(s, wanted)
        }
        at = at + 1
    }
}

// ---------------------------------------------------------------------------
// Colouring by what a name is
// ---------------------------------------------------------------------------

// The types a token is coloured as, in the order the legend names them. The
// numbers are what goes over the wire, so the two have to stay in step.
TOKEN_KEYWORD :: 0
TOKEN_FUNCTION :: 1
TOKEN_TYPE :: 2
TOKEN_PARAMETER :: 3
TOKEN_VARIABLE :: 4
TOKEN_PROPERTY :: 5
TOKEN_STRING :: 6
TOKEN_NUMBER :: 7

// The one modifier: a name at the place it is declared rather than used.
TOKEN_DECLARED :: 1

say_token_legend :: fn() {
    emit_text("{\"tokenTypes\":[")
    emit_text("\"keyword\",\"function\",\"type\",\"parameter\",")
    emit_text("\"variable\",\"property\",\"string\",\"number\"")
    emit_text("],\"tokenModifiers\":[\"declaration\"]}")
}

// Every token of a buffer, coloured by what the name is rather than by what it
// looks like.
//
// A grammar colours a call and a type the same, because from the outside they
// are both a name. The compiler knows which is which, so the editor is told.
answer_semantic_tokens :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    length := str_len(text)
    mut tokens: Arena<Token> = arena_make($Token, 4096)
    tokenize(text, length, tokens)
    say_open()
    say_result_head(document, request)
    emit_text("{\"data\":[")
    say_token_data(text, length, tokens)
    emit_text("]}}")
    say_send()
}

// The five numbers each token is written as, each line and character given as
// how far it is from the token before it.
say_token_data :: fn(text: str, length: i64, mut tokens: Arena<Token>) {
    mut line: i64 = 0
    mut character: i64 = 0
    mut at: i64 = 0
    mut last_line: i64 = 0
    mut last_character: i64 = 0
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < tokens.count) {
        kind := token_colour(text, tokens, index)
        if (kind >= 0) {
            ref one := arena_at(tokens, index)
            off := one.off
            span := one.len
            // Up to where this token opens, counting what was stepped over.
            while (at < off && at < length) {
                byte := cast($i64, text[at])
                if (byte == CH_LF) {
                    line = line + 1
                    character = 0
                } else {
                    character = character + utf16_units(byte)
                }
                at = at + 1
            }
            width := token_width(text, length, off, span)
            if (written > 0) {
                emit_text(",")
            }
            frost_rt_emit_int(line - last_line)
            emit_text(",")
            if (line == last_line) {
                frost_rt_emit_int(character - last_character)
            } else {
                frost_rt_emit_int(character)
            }
            emit_text(",")
            frost_rt_emit_int(width)
            emit_text(",")
            frost_rt_emit_int(kind)
            emit_text(",")
            frost_rt_emit_int(token_modifiers(text, tokens, index))
            last_line = line
            last_character = character
            written = written + 1
        }
        index = index + 1
    }
}

// How wide a token is in UTF-16 units, counted to the end of the line it opens
// on. A token the protocol takes has to sit on one line.
token_width :: fn(text: str, length: i64, off: i64, span: i64) -> i64 {
    mut units: i64 = 0
    mut at := off
    while (at < off + span && at < length) {
        byte := cast($i64, text[at])
        if (byte == CH_LF) {
            return units
        }
        units = units + utf16_units(byte)
        at = at + 1
    }
    units
}

// Which colour a token takes, or -1 for one the grammar already colours.
token_colour :: fn(text: str, mut tokens: Arena<Token>, index: i64) -> i64 {
    ref one := arena_at(tokens, index)
    kind := one.kind
    if (kind == TokenKind::Str) {
        return TOKEN_STRING
    }
    if (kind == TokenKind::Int || kind == TokenKind::Float ||
        kind == TokenKind::BigInt) {
        return TOKEN_NUMBER
    }
    if (is_word_token(kind)) {
        return TOKEN_KEYWORD
    }
    if (kind != TokenKind::Ident) {
        return -1
    }
    if (index > 0 && kind_at(tokens, index - 1) == TokenKind::Dot) {
        return TOKEN_PROPERTY
    }
    after := kind_at(tokens, index + 1)
    if (after == TokenKind::Coloncolon) {
        return declared_colour(text, tokens, index)
    }
    if (after == TokenKind::Lparen) {
        return TOKEN_FUNCTION
    }
    if (after == TokenKind::Colon) {
        return TOKEN_PARAMETER
    }
    if (upper_first(text, arena_at(tokens, index).off)) {
        return TOKEN_TYPE
    }
    TOKEN_VARIABLE
}

// Whether a name written here is being declared rather than used.
token_modifiers :: fn(text: str, mut tokens: Arena<Token>, index: i64) -> i64 {
    if (kind_at(tokens, index) != TokenKind::Ident) {
        return 0
    }
    if (kind_at(tokens, index + 1) != TokenKind::Coloncolon) {
        return 0
    }
    TOKEN_DECLARED
}

// What a declaration declares, read off the word after its `::`.
declared_colour :: fn(text: str, mut tokens: Arena<Token>, index: i64) -> i64 {
    mut walk := index + 2
    // A declaration may say `safe extern fn` or `packed struct` before the
    // word that says what it is.
    while (walk < tokens.count && is_word_token(kind_at(tokens, walk)) &&
        opens_a_type(kind_at(tokens, walk)) == false &&
        kind_at(tokens, walk) != TokenKind::KwFn) {
        walk = walk + 1
    }
    if (walk >= tokens.count) {
        return TOKEN_VARIABLE
    }
    if (kind_at(tokens, walk) == TokenKind::KwFn) {
        return TOKEN_FUNCTION
    }
    if (opens_a_type(kind_at(tokens, walk))) {
        return TOKEN_TYPE
    }
    TOKEN_VARIABLE
}

opens_a_type :: fn(kind: TokenKind) -> bool {
    kind == TokenKind::KwStruct || kind == TokenKind::KwEnum ||
        kind == TokenKind::KwDistinct
}

kind_at :: fn(mut tokens: Arena<Token>, index: i64) -> TokenKind {
    if (index < 0 || index >= tokens.count) {
        return TokenKind::Eof
    }
    arena_at(tokens, index).kind
}

// Whether a name opens with a capital, which is what a type is written with.
upper_first :: fn(text: str, off: i64) -> bool {
    if (off >= str_len(text)) {
        return false
    }
    byte := cast($i64, text[off])
    byte >= CH_UPPER_A && byte <= CH_UPPER_Z
}

// Whether a token is one of the language's own words.
is_word_token :: fn(kind: TokenKind) -> bool {
    kind == TokenKind::KwFn || kind == TokenKind::KwIf ||
        kind == TokenKind::KwWhen || kind == TokenKind::KwElse ||
        kind == TokenKind::KwWhile || kind == TokenKind::KwBreak ||
        kind == TokenKind::KwContinue || kind == TokenKind::KwReturn ||
        kind == TokenKind::KwStruct || kind == TokenKind::KwMatch ||
        kind == TokenKind::KwCase || kind == TokenKind::KwExtern ||
        kind == TokenKind::KwMut || kind == TokenKind::KwMove ||
        kind == TokenKind::KwLinear || kind == TokenKind::KwUses ||
        kind == TokenKind::KwWith || kind == TokenKind::KwImport ||
        kind == TokenKind::KwExport || kind == TokenKind::KwEnum ||
        kind == TokenKind::KwTest || kind == TokenKind::KwUnsafe ||
        kind == TokenKind::KwDistinct || kind == TokenKind::KwWhere ||
        kind == TokenKind::KwSafe || kind == TokenKind::KwRef ||
        kind == TokenKind::KwInline || kind == TokenKind::KwDefer ||
        kind == TokenKind::KwErrDefer || kind == TokenKind::KwFor ||
        kind == TokenKind::KwIn
}

// ---------------------------------------------------------------------------
// The parameter names a call leaves out
// ---------------------------------------------------------------------------

// A hint in front of each argument, naming the parameter it is given to.
//
// A call reads `wide("x", 2)` and says nothing about which of the two is
// which. The head does, and it is in another file.
answer_inlay_hints :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    ref held := arena_at(s.docs, doc)
    bytes_reset(s.walking)
    bytes_str(s.walking, bytes_view(held.text))
    params := json_member(document, request, "params")
    span := json_member(document, params, "range")
    from := json_number(
        document,
        json_member(document, json_member(document, span, "start"), "line")
    )
    to := json_number(
        document,
        json_member(document, json_member(document, span, "end"), "line")
    )
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_call_hints(s, from, to)
    emit_text("]}")
    say_send()
}

// Each call written between two lines, with the name of every parameter its
// arguments go to.
say_call_hints :: fn(mut s: Server, from: i64, to: i64) {
    text := bytes_view(s.walking)
    length := str_len(text)
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            starts := name_start(text, at)
            ends := name_end(text, starts)
            if (ends > starts && starts == at && ends < length &&
                cast($i64, text[ends]) == CH_LPAREN) {
                line := place_line(text, starts)
                if (line >= from && line <= to) {
                    written = written + say_hints_of_call(s, starts, ends,
                        written)
                }
                at = ends
            } else {
                at = at + 1
            }
        }
    }
}

// The hints for one call, which needs the head the name was declared under.
say_hints_of_call :: fn(
    mut s: Server,
    starts: i64,
    opens: i64,
    already: i64
) -> i64 {
    held := bytes_view(s.walking)
    bytes_reset(s.other)
    mut at := starts
    while (at < opens) {
        bytes_byte(s.other, cast($i64, held[at]))
        at = at + 1
    }
    if (find_declaration(s) == false) {
        return 0
    }
    flatten_head(s)
    // Copied out, since the walk over the arguments reads the buffer the head
    // is in while it names each one.
    bytes_reset(s.scratch)
    bytes_str(s.scratch, bytes_view(s.reports))
    say_argument_hints(s, opens, already)
}

// One hint for each argument, at the byte it opens on.
say_argument_hints :: fn(mut s: Server, opens: i64, already: i64) -> i64 {
    text := bytes_view(s.walking)
    head := bytes_view(s.scratch)
    length := str_len(text)
    mut written: i64 = 0
    mut which: i64 = 0
    mut depth: i64 = 0
    mut from := opens + 1
    mut walk := opens + 1
    while (walk < length) {
        byte := cast($i64, text[walk])
        if (byte == CH_LPAREN || byte == CH_LBRACKET || byte == CH_LBRACE) {
            depth = depth + 1
        }
        if (byte == CH_RBRACKET || byte == CH_RBRACE) {
            depth = depth - 1
        }
        if (byte == CH_RPAREN && depth == 0) {
            written = written + say_one_hint(text, head, from, walk, which,
                already + written)
            return written
        }
        if (byte == CH_RPAREN) {
            depth = depth - 1
        }
        if (byte == CH_COMMA && depth == 0) {
            written = written + say_one_hint(text, head, from, walk, which,
                already + written)
            which = which + 1
            from = walk + 1
        }
        walk = walk + 1
    }
    written
}

// The hint for one argument, where the head names a parameter for it and the
// argument is not already written as that name.
say_one_hint :: fn(
    text: str,
    head: str,
    from: i64,
    to: i64,
    which: i64,
    already: i64
) -> i64 {
    mut opens := from
    while (opens < to && cast($i64, text[opens]) == CH_SPACE) {
        opens = opens + 1
    }
    if (opens >= to) {
        return 0
    }
    named := parameter_named(head, which)
    if (str_len(named) == 0) {
        return 0
    }
    if (name_written_at(text, opens, named) == opens) {
        return 0
    }
    if (already > 0) {
        emit_text(",")
    }
    emit_text("{\"position\":")
    emit_text("{\"line\":")
    frost_rt_emit_int(place_line(text, opens))
    emit_text(",\"character\":")
    frost_rt_emit_int(place_character(text, opens))
    emit_text("},\"label\":")
    say_labelled(named)
    emit_text(",\"kind\":2,\"paddingRight\":true}")
    1
}

// The label a hint carries, which is the name and the colon a reader reads it
// with.
say_labelled :: fn(named: str) {
    emit_text("\"")
    mut at: i64 = 0
    while (at < str_len(named)) {
        say_escaped(cast($i64, named[at]))
        at = at + 1
    }
    emit_text(":\"")
}

// The name of the nth parameter of a head, or nothing where the head has no
// such parameter.
//
// A parameter is written as a name, then a colon, then its type, and the
// permission words in front of the name are not the name.
parameter_named :: fn(head: str, which: i64) -> str {
    length := str_len(head)
    mut opens: i64 = -1
    mut at: i64 = 0
    while (at < length && opens < 0) {
        if (cast($i64, head[at]) == CH_LPAREN) {
            opens = at
        }
        at = at + 1
    }
    if (opens < 0) {
        return ""
    }
    mut depth: i64 = 0
    mut seen: i64 = 0
    mut from := opens + 1
    mut walk := opens + 1
    while (walk < length) {
        byte := cast($i64, head[walk])
        if (byte == CH_LPAREN || byte == CH_LBRACKET || byte == CH_LT) {
            depth = depth + 1
        }
        if (byte == CH_RBRACKET || byte == CH_GT) {
            depth = depth - 1
        }
        if (byte == CH_RPAREN && depth == 0) {
            if (seen == which) {
                return parameter_name_in(head, from, walk)
            }
            return ""
        }
        if (byte == CH_RPAREN) {
            depth = depth - 1
        }
        if (byte == CH_COMMA && depth == 0) {
            if (seen == which) {
                return parameter_name_in(head, from, walk)
            }
            seen = seen + 1
            from = walk + 1
        }
        walk = walk + 1
    }
    ""
}

// The name inside one parameter: the last word written before its colon.
parameter_name_in :: fn(head: str, from: i64, to: i64) -> str {
    mut colon := -1
    mut at := from
    while (at < to && colon < 0) {
        if (cast($i64, head[at]) == CH_COLON) {
            colon = at
        }
        at = at + 1
    }
    if (colon < 0) {
        return ""
    }
    mut ends := colon
    while (ends > from && cast($i64, head[ends - 1]) == CH_SPACE) {
        ends = ends - 1
    }
    mut starts := ends
    while (starts > from && name_byte(cast($i64, head[starts - 1]))) {
        starts = starts - 1
    }
    if (ends == starts) {
        return ""
    }
    source_text(head, starts, ends - starts)
}

// ---------------------------------------------------------------------------
// How much of a program names a declaration
// ---------------------------------------------------------------------------

// One lens over each declaration, with nothing written on it yet.
//
// Counting what names a declaration means reading every file, and a file holds
// many declarations. The editor asks for the one it is about to show, and that
// is what is counted.
answer_code_lenses :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    length := str_len(text)
    bytes_reset(s.scratch)
    bytes_str(s.scratch, bytes_view(held.uri))
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            if (written > 0) {
                emit_text(",")
            }
            emit_text("{\"range\":")
            say_range(
                place_line(text, at),
                place_character(text, at),
                place_line(text, at + named),
                place_character(text, at + named)
            )
            emit_text(",\"data\":{\"uri\":")
            say_string(bytes_view(s.scratch))
            emit_text(",\"name\":")
            say_string_range(text, at, at + named)
            emit_text("}}")
            written = written + 1
        }
        commented = comment_runs_past(text, at, ends, commented)
        at = ends + 1
    }
    emit_text("]}")
    say_send()
}

// The lens as it arrived, with the count written onto it.
answer_code_lens_resolve :: fn(
    mut s: Server,
    mut document: Json,
    request: i64
) {
    params := json_member(document, request, "params")
    data := json_member(document, params, "data")
    named := json_member(document, data, "name")
    span := json_member(document, params, "range")
    if (named < 0 || span < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    bytes_reset(s.other)
    bytes_json(s.other, document, named)
    count := times_written(s)
    say_open()
    say_result_head(document, request)
    emit_text("{\"range\":")
    say_raw_range(document, span)
    emit_text(",\"command\":{\"title\":")
    say_use_count(count)
    emit_text(",\"command\":\"\"}}}")
    say_send()
}

// A range as it arrived, written back out.
say_raw_range :: fn(mut document: Json, span: i64) {
    starts := json_member(document, span, "start")
    ends := json_member(document, span, "end")
    say_range(
        json_number(document, json_member(document, starts, "line")),
        json_number(document, json_member(document, starts, "character")),
        json_number(document, json_member(document, ends, "line")),
        json_number(document, json_member(document, ends, "character"))
    )
}

// What the lens says: how many places name it, counting the declaration
// itself out.
say_use_count :: fn(count: i64) {
    emit_text("\"")
    if (count == 0) {
        emit_text("no uses")
        emit_text("\"")
        return
    }
    frost_rt_emit_int(count)
    if (count == 1) {
        emit_text(" use")
    } else {
        emit_text(" uses")
    }
    emit_text("\"")
}

// How many places across the workspace write the name in `s.other`, less the
// one that declares it.
times_written :: fn(mut s: Server) -> i64 {
    mut total: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            total = total + written_in(text, bytes_view(s.other))
        }
        index = index + 1
    }
    if (total > 0) {
        return total - 1
    }
    0
}

// How many times a name is written in one text, comments and strings aside.
written_in :: fn(text: str, wanted: str) -> i64 {
    length := str_len(text)
    width := str_len(wanted)
    mut seen: i64 = 0
    mut at: i64 = 0
    while (at < length) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0) {
                seen = seen + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    seen
}

// ---------------------------------------------------------------------------
// What calls a name, and what it calls
// ---------------------------------------------------------------------------

// One item of a hierarchy: the declaration a name was written under, named,
// with the whole declaration as its range and the name as what to select.
say_hierarchy_item :: fn(text: str, uri: str, at: i64, named: i64) {
    length := str_len(text)
    ends := line_end(text, length, at)
    stops := declaration_extent(text, at, ends, length)
    emit_text("{\"name\":")
    say_string_range(text, at, at + named)
    emit_text(",\"kind\":")
    frost_rt_emit_int(symbol_kind(text, at, named, ends))
    emit_text(",\"uri\":")
    say_string(uri)
    emit_text(",\"range\":")
    say_range(
        place_line(text, at),
        0,
        place_line(text, stops),
        place_character(text, stops)
    )
    emit_text(",\"selectionRange\":")
    say_range(
        place_line(text, at),
        place_character(text, at),
        place_line(text, at + named),
        place_character(text, at + named)
    )
    emit_text("}")
}

// The declaration the caret is on or inside, as the one item a hierarchy
// starts from.
answer_prepare_hierarchy :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    walk_sources(s)
    if (name_at_position(s, document, request, doc) < 0) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    text := text_of_path(s, bytes_view(s.found))
    uri_of_path(s.scratch, bytes_view(s.found))
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_hierarchy_item(text, bytes_view(s.scratch), s.found_off, s.found_len)
    emit_text("]}")
    say_send()
}

// The name a hierarchy request carries back, put in `s.other`.
//
// Answers false where the request names nothing, which is a request built by
// something other than the item this server wrote.
hierarchy_name :: fn(mut s: Server, mut document: Json, request: i64) -> bool {
    params := json_member(document, request, "params")
    item := json_member(document, params, "item")
    if (item < 0) {
        return false
    }
    named := json_member(document, item, "name")
    if (named < 0 || json_kind(document, named) != JsonKind::String) {
        return false
    }
    walk_sources(s)
    bytes_reset(s.other)
    bytes_json(s.other, document, named)
    true
}

// Every declaration whose body writes this name, each with the places it does.
answer_incoming_calls :: fn(mut s: Server, mut document: Json, request: i64) {
    if (hierarchy_name(s, document, request) == false) {
        say_null_result(document, request)
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            written = written + say_callers_in(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    emit_text("]}")
    say_send()
}

// Each declaration of one file that writes a name inside its body.
say_callers_in :: fn(text: str, uri: str, wanted: str, already: i64) -> i64 {
    length := str_len(text)
    width := str_len(wanted)
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            stops := declaration_extent(text, at, ends, length)
            // Past the name it declares, so a function is not a caller of
            // itself for being written at its own head.
            calls := writes_between(text, at + named, stops, wanted)
            if (calls > 0) {
                if (already + written > 0) {
                    emit_text(",")
                }
                emit_text("{\"from\":")
                say_hierarchy_item(text, uri, at, named)
                emit_text(",\"fromRanges\":[")
                say_ranges_between(text, at + named, stops, wanted, width)
                emit_text("]}")
                written = written + 1
            }
            at = line_end(text, length, stops) + 1
        } else {
            commented = comment_runs_past(text, at, ends, commented)
            at = ends + 1
        }
    }
    written
}

// How many times a name is written between two offsets.
writes_between :: fn(text: str, from: i64, to: i64, wanted: str) -> i64 {
    width := str_len(wanted)
    mut seen: i64 = 0
    mut at := from
    while (at < to) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0 && found < to) {
                seen = seen + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
    seen
}

// Each of those places, as a range.
say_ranges_between :: fn(
    text: str,
    from: i64,
    to: i64,
    wanted: str,
    width: i64
) {
    mut written: i64 = 0
    mut at := from
    while (at < to) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(text, at, wanted)
            if (found >= 0 && found < to) {
                if (written > 0) {
                    emit_text(",")
                }
                say_range(
                    place_line(text, found),
                    place_character(text, found),
                    place_line(text, found + width),
                    place_character(text, found + width)
                )
                written = written + 1
                at = found + width
            } else {
                at = at + 1
            }
        }
    }
}

// Every name this declaration calls, each with the places it calls it.
answer_outgoing_calls :: fn(mut s: Server, mut document: Json, request: i64) {
    if (hierarchy_name(s, document, request) == false) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    // The body, copied out: the walk names each call while reading it, and
    // naming one reads the file it is declared in.
    text := text_of_path(s, bytes_view(s.found))
    length := str_len(text)
    ends := line_end(text, length, s.found_off)
    stops := declaration_extent(text, s.found_off, ends, length)
    bytes_reset(s.walking)
    mut copy := s.found_off + s.found_len
    while (copy < stops) {
        bytes_byte(s.walking, cast($i64, text[copy]))
        copy = copy + 1
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_called_by(s)
    emit_text("]}")
    say_send()
}

// Each distinct name called inside the body held in `s.walking`.
say_called_by :: fn(mut s: Server) {
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < str_len(bytes_view(s.walking))) {
        held := bytes_view(s.walking)
        length := str_len(held)
        past := past_non_code(held, at)
        if (past > at) {
            at = past
        } else {
            starts := name_start(held, at)
            names := name_end(held, starts)
            if (names > starts && starts == at && names < length &&
                cast($i64, held[names]) == CH_LPAREN &&
                first_call_of(held, at, starts, names)) {
                written = written + say_one_called(s, starts, names, written)
                at = names
            } else {
                at = at + 1
            }
        }
    }
}

// Whether this is the first place the body calls this name, which is what
// decides where the list of its ranges is written.
first_call_of :: fn(held: str, upto: i64, starts: i64, names: i64) -> bool {
    wanted := source_text(held, starts, names - starts)
    mut at: i64 = 0
    while (at < upto) {
        past := past_non_code(held, at)
        if (past > at) {
            at = past
        } else {
            found := name_written_at(held, at, wanted)
            if (found >= 0 && found + str_len(wanted) < str_len(held) &&
                cast($i64, held[found + str_len(wanted)]) == CH_LPAREN) {
                return false
            }
            at = at + 1
        }
    }
    true
}

// One name the body calls, with where it is declared and every place this
// body calls it.
say_one_called :: fn(
    mut s: Server,
    starts: i64,
    names: i64,
    already: i64
) -> i64 {
    held := bytes_view(s.walking)
    bytes_reset(s.named)
    mut at := starts
    while (at < names) {
        bytes_byte(s.named, cast($i64, held[at]))
        at = at + 1
    }
    bytes_reset(s.other)
    bytes_str(s.other, bytes_view(s.named))
    if (find_declaration(s) == false) {
        return 0
    }
    text := text_of_path(s, bytes_view(s.found))
    uri_of_path(s.scratch, bytes_view(s.found))
    if (already > 0) {
        emit_text(",")
    }
    emit_text("{\"to\":")
    say_hierarchy_item(text, bytes_view(s.scratch), s.found_off, s.found_len)
    emit_text(",\"fromRanges\":[")
    body := bytes_view(s.walking)
    say_ranges_between(
        body,
        0,
        str_len(body),
        bytes_view(s.named),
        str_len(bytes_view(s.named))
    )
    emit_text("]}")
    1
}

// ---------------------------------------------------------------------------
// What a type holds, and what holds it
// ---------------------------------------------------------------------------

// The type the caret is on, as the one item a hierarchy starts from.
answer_prepare_type_hierarchy :: fn(
    mut s: Server,
    mut document: Json,
    request: i64
) {
    answer_prepare_hierarchy(s, document, request)
}

// The types that hold this one.
//
// Frost declares no hierarchy: a bundle is answered by the shape of what is
// given to it rather than by a word written on a type. What is written down is
// what holds what, so that is the hierarchy a reader is shown: above a type
// are the types with a field of it.
answer_supertypes :: fn(mut s: Server, mut document: Json, request: i64) {
    if (hierarchy_name(s, document, request) == false) {
        say_null_result(document, request)
        return
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    mut written: i64 = 0
    count := source_count(s)
    mut index: i64 = 0
    while (index < count) {
        if (source_into(s, index)) {
            text := text_of_path(s, bytes_view(s.each))
            uri_of_path(s.scratch, bytes_view(s.each))
            written = written + say_holders_of(
                text,
                bytes_view(s.scratch),
                bytes_view(s.other),
                written
            )
        }
        index = index + 1
    }
    emit_text("]}")
    say_send()
}

// Each type of one file with a field written as this type.
say_holders_of :: fn(text: str, uri: str, wanted: str, already: i64) -> i64 {
    length := str_len(text)
    mut written: i64 = 0
    mut at: i64 = 0
    mut commented: bool = false
    while (at < length) {
        ends := line_end(text, length, at)
        named := declaration_head(text, at, ends)
        if (!commented && named > 0) {
            stops := declaration_extent(text, at, ends, length)
            if (head_declares_a_type(text, at, named) &&
                field_typed(text, at + named, stops, wanted)) {
                if (already + written > 0) {
                    emit_text(",")
                }
                say_hierarchy_item(text, uri, at, named)
                written = written + 1
            }
            at = line_end(text, length, stops) + 1
        } else {
            commented = comment_runs_past(text, at, ends, commented)
            at = ends + 1
        }
    }
    written
}

// Whether a field written between two offsets carries this type: a colon, then
// the name, whatever view or pointer is written between them.
field_typed :: fn(text: str, from: i64, to: i64, wanted: str) -> bool {
    mut at := from
    while (at < to) {
        past := past_non_code(text, at)
        if (past > at) {
            at = past
        } else {
            if (cast($i64, text[at]) == CH_COLON && at + 1 < to &&
                cast($i64, text[at + 1]) != CH_COLON) {
                mut walk := at + 1
                while (walk < to && (cast($i64, text[walk]) == CH_SPACE ||
                    cast($i64, text[walk]) == CH_LBRACKET ||
                    cast($i64, text[walk]) == CH_RBRACKET ||
                    cast($i64, text[walk]) == CH_CARET)) {
                    walk = walk + 1
                }
                if (name_written_at(text, walk, wanted) == walk) {
                    return true
                }
            }
            at = at + 1
        }
    }
    false
}

// The types this one holds: the type of each of its fields that the workspace
// declares.
answer_subtypes :: fn(mut s: Server, mut document: Json, request: i64) {
    if (hierarchy_name(s, document, request) == false) {
        say_null_result(document, request)
        return
    }
    if (find_declaration(s) == false) {
        say_null_result(document, request)
        return
    }
    text := text_of_path(s, bytes_view(s.found))
    length := str_len(text)
    ends := line_end(text, length, s.found_off)
    stops := declaration_extent(text, s.found_off, ends, length)
    bytes_reset(s.walking)
    mut copy := s.found_off + s.found_len
    while (copy < stops) {
        bytes_byte(s.walking, cast($i64, text[copy]))
        copy = copy + 1
    }
    say_open()
    say_result_head(document, request)
    emit_text("[")
    say_field_types(s)
    emit_text("]}")
    say_send()
}

// Each field type of the body held in `s.walking`, once each.
say_field_types :: fn(mut s: Server) {
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < str_len(bytes_view(s.walking))) {
        held := bytes_view(s.walking)
        length := str_len(held)
        past := past_non_code(held, at)
        if (past > at) {
            at = past
        } else {
            if (cast($i64, held[at]) == CH_COLON && at + 1 < length &&
                cast($i64, held[at + 1]) != CH_COLON) {
                mut walk := at + 1
                while (walk < length && (cast($i64, held[walk]) == CH_SPACE ||
                    cast($i64, held[walk]) == CH_LBRACKET ||
                    cast($i64, held[walk]) == CH_RBRACKET ||
                    cast($i64, held[walk]) == CH_CARET)) {
                    walk = walk + 1
                }
                names := name_end(held, walk)
                if (names > walk && first_type_at(held, at, walk, names)) {
                    written = written + say_one_field_type(s, walk, names,
                        written)
                }
            }
            at = at + 1
        }
    }
}

// Whether this is the first field written with this type.
first_type_at :: fn(held: str, upto: i64, walk: i64, names: i64) -> bool {
    wanted := source_text(held, walk, names - walk)
    mut at: i64 = 0
    while (at < upto) {
        if (cast($i64, held[at]) == CH_COLON && at + 1 < str_len(held) &&
            cast($i64, held[at + 1]) != CH_COLON) {
            mut inner := at + 1
            while (inner < str_len(held) &&
                (cast($i64, held[inner]) == CH_SPACE ||
                cast($i64, held[inner]) == CH_LBRACKET ||
                cast($i64, held[inner]) == CH_RBRACKET ||
                cast($i64, held[inner]) == CH_CARET)) {
                inner = inner + 1
            }
            if (name_written_at(held, inner, wanted) == inner) {
                return false
            }
        }
        at = at + 1
    }
    true
}

// One field type, where the workspace declares it. A builtin is a type the
// reader cannot be taken to, so it is left out.
say_one_field_type :: fn(
    mut s: Server,
    walk: i64,
    names: i64,
    already: i64
) -> i64 {
    held := bytes_view(s.walking)
    bytes_reset(s.other)
    mut at := walk
    while (at < names) {
        bytes_byte(s.other, cast($i64, held[at]))
        at = at + 1
    }
    if (find_declaration(s) == false) {
        return 0
    }
    text := text_of_path(s, bytes_view(s.found))
    if (head_declares_a_type(text, s.found_off, s.found_len) == false) {
        return 0
    }
    uri_of_path(s.scratch, bytes_view(s.found))
    if (already > 0) {
        emit_text(",")
    }
    say_hierarchy_item(text, bytes_view(s.scratch), s.found_off, s.found_len)
    1
}

// ---------------------------------------------------------------------------
// Reports the editor asks for
// ---------------------------------------------------------------------------

// One check of a document, with what it found left in `s.reports`.
//
// Shared by the reports the server sends on its own and the ones an editor
// asks for. A check leaks by design and everything it took goes back in one
// call, so what an answer needs after that is copied out before the call.
check_into_reports :: fn(mut s: Server, doc: i64) {
    frost_rt_take_open()
    mut parser := new_parser(lsp_options(s, doc))
    run_check(s, doc, parser, 1)
    records := unsafe { frost_rt_report_take() }
    hold_modules(s, parser)
    frost_rt_take_close()
    records_as_array(s.reports, records)
    bytes_reset(s.held_reports)
    bytes_str(s.held_reports, bytes_view(s.reports))
    s.held_for = doc
}

// What is wrong with one buffer, answered rather than sent.
//
// An editor that asks rather than waits knows which file it is showing, and
// gets the answer for that one at the moment it needs it.
answer_pull_diagnostics :: fn(mut s: Server, mut document: Json, request: i64) {
    doc := doc_of_request(s, document, request)
    if (doc < 0) {
        say_null_result(document, request)
        return
    }
    check_into_reports(s, doc)
    say_open()
    say_result_head(document, request)
    emit_text("{\"kind\":\"full\",\"items\":[")
    say_items_of(s, doc)
    emit_text("]}}")
    say_send()
}

// The records about one document, written as the protocol's diagnostics.
say_items_of :: fn(mut s: Server, doc: i64) {
    bytes_reset(s.scratch)
    ref about := arena_at(s.docs, doc)
    bytes_str(s.scratch, bytes_view(about.path))
    mut found := json_parse(bytes_view(s.held_reports))
    root := json_root(found)
    count := json_count(found, root)
    text := text_of_path(s, bytes_view(s.scratch))
    mut written: i64 = 0
    mut index: i64 = 0
    while (index < count) {
        record := json_at(found, root, index)
        if (record_is_about(s, found, record, doc)) {
            if (written > 0) {
                emit_text(",")
            }
            say_diagnostic(found, record, text)
            written = written + 1
        }
        index = index + 1
    }
    json_free(found)
}

// Whether a record is about the file this document holds.
//
// A record names a file the way a build writes it, which is not where the file
// is, and a record with no place is about the file that was asked about.
record_is_about :: fn(
    mut s: Server,
    mut found: Json,
    record: i64,
    doc: i64
) -> bool {
    file := json_member(found, record, "file")
    if (file < 0 || json_kind(found, file) != JsonKind::String) {
        return true
    }
    bytes_reset(s.other)
    bytes_json(s.other, found, file)
    name_as_path(s)
    ref about := arena_at(s.docs, doc)
    same_path(bytes_view(s.other), bytes_view(about.path))
}

// What is wrong with everything on screen, answered rather than sent.
answer_workspace_diagnostics :: fn(
    mut s: Server,
    mut document: Json,
    request: i64
) {
    say_open()
    say_result_head(document, request)
    emit_text("{\"items\":[")
    mut written: i64 = 0
    mut at: i64 = 0
    while (at < s.docs.count) {
        mut wanted: i64 = -1
        mut version: i64 = 0
        ref held := arena_at(s.docs, at)
        if (held.live == 1) {
            wanted = at
            version = held.version
        }
        if (wanted >= 0) {
            check_into_reports(s, wanted)
            if (written > 0) {
                emit_text(",")
            }
            emit_text("{\"kind\":\"full\",\"uri\":")
            say_document_uri(s, wanted)
            emit_text(",\"version\":")
            frost_rt_emit_int(version)
            emit_text(",\"items\":[")
            say_items_of(s, wanted)
            emit_text("]}")
            written = written + 1
        }
        at = at + 1
    }
    emit_text("]}}")
    say_send()
}

// The URI a document is known by.
say_document_uri :: fn(mut s: Server, doc: i64) {
    bytes_reset(s.other)
    ref held := arena_at(s.docs, doc)
    bytes_str(s.other, bytes_view(held.uri))
    say_string(bytes_view(s.other))
}

// ---------------------------------------------------------------------------
// A change that carries only what changed
// ---------------------------------------------------------------------------

// One change applied to the buffer.
//
// A change with no range replaces the whole text, which is what the editor
// sends when it has nothing better to say. One with a range replaces the bytes
// between two places, which is what a keystroke is.
apply_change :: fn(mut s: Server, doc: i64, mut document: Json, change: i64) {
    span := json_member(document, change, "range")
    written := json_member(document, change, "text")
    if (span < 0) {
        ref whole := arena_at(s.docs, doc)
        bytes_reset(whole.text)
        bytes_json(whole.text, document, written)
        return
    }
    starts := json_member(document, span, "start")
    ends := json_member(document, span, "end")
    // The new text is built beside the old one, since the bytes it keeps are
    // read from the buffer it replaces.
    bytes_reset(s.scratch)
    mut from: i64 = 0
    mut to: i64 = 0
    ref held := arena_at(s.docs, doc)
    text := bytes_view(held.text)
    from = place_offset(
        text,
        json_number(document, json_member(document, starts, "line")),
        json_number(document, json_member(document, starts, "character"))
    )
    to = place_offset(
        text,
        json_number(document, json_member(document, ends, "line")),
        json_number(document, json_member(document, ends, "character"))
    )
    length := str_len(text)
    mut at: i64 = 0
    while (at < from && at < length) {
        bytes_byte(s.scratch, cast($i64, text[at]))
        at = at + 1
    }
    bytes_json(s.scratch, document, written)
    mut walk := to
    while (walk < length) {
        bytes_byte(s.scratch, cast($i64, text[walk]))
        walk = walk + 1
    }
    ref into := arena_at(s.docs, doc)
    bytes_reset(into.text)
    bytes_str(into.text, bytes_view(s.scratch))
}
