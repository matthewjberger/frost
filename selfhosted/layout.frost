// Sizes, alignments and field offsets. C works these out for itself, so this
// is what the assembly backend needs and the C backend does not.

import "core.frost"
import "names.frost"

export align_of, align_up, alloc_temp, field_offset, is_unsigned, payload_base,
    scalar_size, type_size

// What the C compiler would compute, because the two backends have to agree.
// A scalar is as wide as its name says, a pointer is a word, and a struct is
// its fields laid end to end, each on its own alignment, rounded up to the
// widest alignment among them.
//
// A field may itself be a struct, so a size cannot be counted rather than
// measured. Parser carries eleven arenas and an arena is three words, not one.
scalar_size :: fn(held: i64) -> i64 {
    ty := distinct_repr(held)
    if (is_pointer(ty)) {
        return 8
    }
    if (ty == TY_I8 || ty == TY_U8 || ty == TY_BOOL) {
        return 1
    }
    if (ty == TY_I16 || ty == TY_U16) {
        return 2
    }
    if (ty == TY_I32 || ty == TY_U32 || ty == TY_F32) {
        return 4
    }
    8
}

// Which of the two extensions a narrow value takes on its way into a register.
// A `bool` is a 0 or a 1 in one byte, so it zero-extends.
is_unsigned :: fn(held: i64) -> bool {
    ty := distinct_repr(held)
    is_pointer(ty) == false
        && (ty == TY_BOOL || ty == TY_U8 || ty == TY_U16 || ty == TY_U32
            || ty == TY_U64 || ty == TY_USIZE)
}

align_up :: fn(offset: i64, alignment: i64) -> i64 {
    (offset + alignment - 1) / alignment * alignment
}

align_of :: fn(mut p: Parser, ty: i64) -> i64 {
    if (is_array_ty(ty)) {
        // A slice is a pointer beside a length, so it aligns like a word. A
        // fixed array aligns like the thing it holds.
        if (is_slice_ty(p, ty)) {
            return 8
        }
        return align_of(p, array_element(p, ty))
    }
    if (is_struct_ty(ty) == false) {
        return scalar_size(ty)
    }
    def := arena_at(p.structs, struct_index_of(ty))
    mut fid := def.field_head
    mut widest : i64 = 1
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        one := align_of(p, field.ty)
        if (one > widest) {
            widest = one
        }
        fid = field.next
    }
    widest
}

// Where an enum's payload starts: after the tag, on the widest alignment any
// variant's field asks for. Every variant is laid from here, so no two of them
// are ever both readable and the enum is as wide as its largest.
payload_base :: fn(mut p: Parser, field_head: i64) -> i64 {
    mut fid := field_head
    mut after_tag : i64 = 0
    mut widest : i64 = 1
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.variant < 0) {
            after_tag = align_up(after_tag, align_of(p, field.ty))
                + type_size(p, field.ty)
        } else {
            one := align_of(p, field.ty)
            if (one > widest) {
                widest = one
            }
        }
        fid = field.next
    }
    align_up(after_tag, widest)
}

type_size :: fn(mut p: Parser, ty: i64) -> i64 {
    if (is_array_ty(ty)) {
        if (is_slice_ty(p, ty)) {
            return 16
        }
        return type_size(p, array_element(p, ty)) * array_length(p, ty)
    }
    if (is_struct_ty(ty) == false) {
        return scalar_size(ty)
    }
    def := arena_at(p.structs, struct_index_of(ty))
    base := payload_base(p, def.field_head)
    mut fid := def.field_head
    mut total : i64 = 0
    mut running : i64 = base
    mut carried : i64 = -1
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.variant < 0) {
            total = align_up(total, align_of(p, field.ty))
                + type_size(p, field.ty)
        } else {
            if (field.variant != carried) {
                carried = field.variant
                running = base
            }
            running = align_up(running, align_of(p, field.ty))
                + type_size(p, field.ty)
            if (running > total) {
                total = running
            }
        }
        fid = field.next
    }
    align_up(total, align_of(p, ty))
}

field_offset :: fn(mut p: Parser, struct_ty: i64, off: i64, len: i64) -> i64 {
    mut base := struct_ty
    if (is_pointer(base)) {
        base = pointee(base)
    }
    if (is_struct_ty(base) == false) {
        return 0
    }
    def := arena_at(p.structs, struct_index_of(base))
    start := payload_base(p, def.field_head)
    mut fid := def.field_head
    mut running : i64 = 0
    mut carried : i64 = -1
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.variant >= 0 && field.variant != carried) {
            carried = field.variant
            running = start
        }
        running = align_up(running, align_of(p, field.ty))
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return running
        }
        running = running + type_size(p, field.ty)
        fid = field.next
    }
    0
}

// Carve a temporary out of the frame, for a struct literal that is used as a
// value rather than stored straight into a local. Temporaries come out of the
// same downward-growing run the locals do, so one number says how wide a
// function's frame has to be and the two cannot grow into each other.
alloc_temp :: fn(mut p: Parser, size: i64) -> i64 {
    p.frame_used = p.frame_used + align_up(size, 8)
    -p.frame_used
}

