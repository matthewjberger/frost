// Working a call out where a compile-time value is read.
//
// A constant and an array length are needed before any body is parsed, so this
// reads the callee straight off the tokens rather than off a tree. What it
// understands is the whole-number half of the language: parameters and locals,
// arithmetic and comparison, `if`, `while`, `for`, `match`, `return`, and calls
// to other functions written the same way, itself included. Everything else is
// refused where it is written, naming what stopped it.
//
// What bounds the work is the step count and the nesting depth. A step that
// calls itself is counted by both, so nothing here reads the shape of the call
// graph to know a compile finishes.

import "core.frost"
import "lexer.frost"
import "cursor.frost"
import "imports.frost"
import "names.frost"

export record_const_functions, const_fn_index, const_call, const_arg_push,
    const_arg_mark, const_call_ahead, const_expr_here, const_call_here,
    at_const_call, const_int, const_bool, const_fold_ahead,
    const_asks_folding, names_a_layout, names_a_measurement,
    names_a_bound_measurement

// How far one evaluation may run. A body may loop, so how long it takes is not
// read off the text, and this is what says a compile finishes.
CONST_STEPS :: 1000000

// How deep calls may nest. A call may reach itself, so this is the whole of
// what bounds a chain: a step that calls itself and a long chain of distinct
// functions are the same shape once one of them is counted.
CONST_DEPTH :: 32

// What a statement did: ran, left the call with a value, or left a loop.
FLOW_RAN :: 0
FLOW_LEFT :: 1
FLOW_BROKE :: 2
FLOW_CONTINUED :: 3
// An expression statement, which is a value where it is the last one of a
// block and nothing where it is not.
FLOW_VALUE :: 4

// Whether this is the smallest i64. Its magnitude is one past the largest, so
// it is the one value whose negation has no answer, and it is asked for that
// way rather than written down: a literal of it has no spelling that reads back
// as itself.
const_is_min :: fn(value: i64) -> bool {
    value < 0 && wrap_sub(0, value) == value
}

const_int :: fn(value: i64) -> ConstValue {
    ConstValue { kind = CONST_INT, value = value, count = 0 }
}

const_bool :: fn(held: bool) -> ConstValue {
    mut value: i64 = 0
    if (held) { value = 1 }
    ConstValue { kind = CONST_BOOL, value = value, count = 0 }
}

// Every top-level `name :: fn`, as the token its `fn` sits at. Collected once,
// before any constant is read, because a constant may call a function written
// below the line that calls it.
record_const_functions :: fn(mut p: Parser) {
    start := p.ti
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace || kind == TokenKind::Lparen
            || kind == TokenKind::Lbracket) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace || kind == TokenKind::Rparen
            || kind == TokenKind::Rbracket) {
            depth = depth - 1
        } else if (depth == 0 && kind == TokenKind::Ident
            && peek_kind(p, 1) == TokenKind::Coloncolon
            && peek_kind(p, 2) == TokenKind::KwFn) {
            arena_push(
                p.const_fns,
                ConstFn {
                    name_off = cur_off(p),
                    name_len = cur_len(p),
                    at = p.ti + 2,
                    ran = 0,
                }
            )
        }
        advance(p)
    }
    p.ti = start
}

// Which recorded function this name reaches from where it was written, or -1.
// A file may name what it declares and what the files it imports export, which
// is the rule every other name follows.
const_fn_index :: fn(mut p: Parser, off: i64, len: i64, use_off: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.const_fns.count) {
        entry := arena_at(p.const_fns, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)
            && name_visible(p, entry.name_off, entry.name_len, use_off)) {
            arena_at(p.const_fns, i).ran = 1
            return i
        }
        i = i + 1
    }
    -1
}

// Whether the declaration value the cursor stands at calls anything. A name
// followed by `(` is a call and nothing else is, and the value ends where the
// next declaration head begins.
const_call_ahead :: fn(mut p: Parser) -> bool {
    mut ahead: i64 = 0
    mut depth: i64 = 0
    while (peek_kind(p, ahead) != TokenKind::Eof) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket
            || kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket
            || kind == TokenKind::Rbrace) {
            depth = depth - 1
        } else if (depth == 0 && ahead > 0 && kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Coloncolon) {
            return false
        }
        if (kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Lparen) {
            return true
        }
        ahead = ahead + 1
    }
    false
}

// Whether a compile-time value the compiler can work out stands where the
// cursor is: a call to a function this file can name, or an item or a field of
// a constant that holds a run of them. `[Vertex; 4]` names a type and is
// neither, so what follows the name is what tells them apart.
at_const_call :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    after := peek_kind(p, 1)
    if (after == TokenKind::Lparen) {
        return const_fn_index(p, cur_off(p), cur_len(p), cur_off(p)) >= 0
    }
    if (after != TokenKind::Lbracket && after != TokenKind::Dot) {
        return false
    }
    const_names_a_value(p, cur_off(p), cur_len(p))
}

// One value worked out where the cursor stands, and nothing after it. A `>`
// past a call closes the generic arguments it sits inside, and read as an
// expression it would be a comparison; the arithmetic around a length belongs
// to the size parser, which is what asks for this.
const_call_here :: fn(mut p: Parser, at: i64) -> ConstValue {
    p.const_steps = 0
    const_factor(p, at)
}

// Whether the declaration value the cursor stands at is one the evaluator
// should try. A run, a set of named values, a run of bytes, or a name with a
// call, an index or a field after it.
const_fold_ahead :: fn(mut p: Parser) -> bool {
    if (cur(p) == TokenKind::Lbracket || cur(p) == TokenKind::Str) {
        return true
    }
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    after := peek_kind(p, 1)
    if (after == TokenKind::Lbrace) {
        return is_type_name(p, cur_off(p), cur_len(p))
    }
    (after == TokenKind::Lparen || after == TokenKind::Lbracket
        || after == TokenKind::Dot)
}

// Whether the value asked to be worked out, rather than only being something
// that might be. A call, an index and a field each name something the compiler
// is expected to settle, so failing to settle one is a fault; a literal that
// happens not to fold is left alone, the way it always was.
const_asks_folding :: fn(mut p: Parser) -> bool {
    mut ahead: i64 = 0
    mut depth: i64 = 0
    while (peek_kind(p, ahead) != TokenKind::Eof) {
        kind := peek_kind(p, ahead)
        if (kind == TokenKind::Lparen || kind == TokenKind::Lbracket
            || kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket
            || kind == TokenKind::Rbrace) {
            depth = depth - 1
        } else if (depth == 0 && ahead > 0 && kind == TokenKind::Ident
            && peek_kind(p, ahead + 1) == TokenKind::Coloncolon) {
            return false
        } else if (depth == 0 && ahead > 0 && kind == TokenKind::KwTest) {
            // A `test` opens a declaration the way a name and a `::` do.
            // Without it the scan read straight through the block and took a
            // call written inside it for one this value asked to fold, which
            // turned a value the pass was meant to leave alone into a refusal.
            return false
        }
        if (kind == TokenKind::Ident) {
            after := peek_kind(p, ahead + 1)
            if (after == TokenKind::Lparen || after == TokenKind::Lbracket
                || after == TokenKind::Dot) {
                return true
            }
        }
        ahead = ahead + 1
    }
    false
}

// One expression worked out where the cursor stands, leaving the cursor past
// it. This is what a length calling a function reads: the call is run where it
// is written, so every argument has to be known there.
const_expr_here :: fn(mut p: Parser, at: i64) -> ConstValue {
    p.const_steps = 0
    const_expr(p, at)
}

const_arg_mark :: fn(mut p: Parser) -> i64 {
    p.const_args.count
}

const_arg_push :: fn(mut p: Parser, held: ConstValue) {
    arena_push(p.const_args, held)
}

// The start of a refusal. Under a try nothing is written and nothing escapes:
// the flag is what the try reads, and the value that comes back is a zero
// nobody records.
const_fault :: fn(mut p: Parser, at: i64) {
    p.const_failed = 1
    // A reading that is only being set aside says nothing about what it met on
    // the way: the placeholder standing where a measurement will go is not the
    // value, so what it divides by or compares against is not either.
    if (p.const_quiet > 0 || p.const_needs_layout == 1) {
        return
    }
    if (const_fault_told(p, at)) {
        p.const_repeat = 1
        return
    }
    p.const_repeat = 0
    arena_push(p.const_faults, at)
    report_where(p.modules, p.src, at)
}

// Whether a constant fault at this offset has already been reported.
const_fault_told :: fn(mut p: Parser, at: i64) -> bool {
    mut i: i64 = 0
    while (i < p.const_faults.count) {
        if (arena_at(p.const_faults, i) == at) {
            return true
        }
        i = i + 1
    }
    false
}

creport :: fn(mut p: Parser, text: str) {
    if (p.const_quiet == 0 && p.const_repeat == 0) {
        report(text)
    }
}

creport_int :: fn(mut p: Parser, value: i64) {
    if (p.const_quiet == 0 && p.const_repeat == 0) {
        report_int(value)
    }
}

creport_src :: fn(mut p: Parser, off: i64, len: i64) {
    if (p.const_quiet == 0 && p.const_repeat == 0) {
        report_src(p.src, off, len)
    }
}

// The end of a refusal. A try carries on with a value nobody keeps.
const_stop :: fn(mut p: Parser) {
    if (p.const_quiet == 0 && p.const_needs_layout == 0) {
        frost_rt_recover_escape()
    }
}

const_spend :: fn(mut p: Parser, at: i64) {
    p.const_steps = p.const_steps + 1
    if (p.const_steps > CONST_STEPS) {
        const_fault(p, at)
        creport(p, "working this out at compile time took more than ")
        creport_int(p, CONST_STEPS)
        creport(p, " steps, which is as far as it goes")
        const_stop(p)
    }
}

// Run a recorded function over the arguments already on the stack, and answer
// what it left with. The cursor is saved and put back, so a call worked out in
// the middle of a parse leaves the parse where it was.
const_call :: fn(
    mut p: Parser,
    index: i64,
    arg_start: i64,
    arg_count: i64,
    at: i64
) -> ConstValue {
    entry := arena_at(p.const_fns, index)
    name_off := entry.name_off
    name_len := entry.name_len
    body_at := entry.at
    if (p.const_depth >= CONST_DEPTH) {
        const_fault(p, at)
        creport(p, "a compile-time call may nest ")
        creport_int(p, CONST_DEPTH)
        creport(p, " deep and '")
        creport_src(p, name_off, name_len)
        creport(p, "' is deeper")
        const_stop(p)
    }
    saved := p.ti
    locals_mark := p.const_locals.count
    p.ti = body_at
    advance(p)
    // The parameters, bound to what the call handed over. A mode word or a
    // `$` in front of one says the parameter is not a plain value, which is
    // not something a compile-time call carries.
    if (cur(p) != TokenKind::Lparen) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(p, "' is not a function this program declares, so there is ")
        creport(p, "nothing to work out here")
        const_stop(p)
    }
    advance(p)
    mut taken: i64 = 0
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        if (cur(p) != TokenKind::Ident) {
            const_fault(p, at)
            creport(p, "'")
            creport_src(p, name_off, name_len)
            creport(
                p,
                "' takes a parameter a compile-time call cannot hand over"
            )
            const_stop(p)
        }
        // A contextual mode word stands in front of the name rather than being
        // the name, and reads as an ordinary identifier until the shape after
        // it says otherwise. Two names in a row is that shape.
        if (peek_kind(p, 1) == TokenKind::Ident) {
            advance(p)
        }
        param_off := cur_off(p)
        param_len := cur_len(p)
        advance(p)
        if (cur(p) == TokenKind::Colon) {
            advance(p)
            const_skip_type(p)
        }
        if (taken < arg_count) {
            given := arena_at(p.const_args, arg_start + taken)
            arena_push(
                p.const_locals,
                ConstLocal {
                    name_off = param_off,
                    name_len = param_len,
                    kind = given.kind,
                    value = given.value,
                    count = given.count
                }
            )
        }
        taken = taken + 1
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    if (taken != arg_count) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(p, "' takes ")
        creport_int(p, taken)
        creport(p, " arguments and ")
        creport_int(p, arg_count)
        creport(p, " were written")
        const_stop(p)
    }
    if (cur(p) == TokenKind::Arrow) {
        advance(p)
        const_skip_type(p)
    }
    if (cur(p) != TokenKind::Lbrace) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(p, "' is not a function this program declares, so there is ")
        creport(p, "nothing to work out here")
        const_stop(p)
    }
    p.const_depth = p.const_depth + 1
    answered := const_block(p, at)
    p.const_depth = p.const_depth - 1
    p.const_locals.count = locals_mark
    p.ti = saved
    p.const_args.count = arg_start
    if (answered.flow != FLOW_LEFT) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(
            p,
            "' reached its end without a value, so there is nothing for "
        )
        creport(p, "the constant to be")
        const_stop(p)
    }
    ConstValue {
        kind = answered.kind,
        value = answered.value,
        count = answered.count
    }
}

// Past a type written after a `:` or an `->`, which a compile-time call reads
// and does not use: what the arithmetic answers is decided by the values.
const_skip_type :: fn(mut p: Parser) {
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbracket || kind == TokenKind::Lparen) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbracket) {
            depth = depth - 1
        } else if (kind == TokenKind::Rparen) {
            if (depth == 0) {
                return
            }
            depth = depth - 1
        } else if (depth == 0
            && (kind == TokenKind::Comma || kind == TokenKind::Lbrace
                || kind == TokenKind::Assign)) {
            return
        }
        advance(p)
    }
}

// The statements between `{` and `}`, with the cursor on the `{`. A block
// answers with its trailing expression, so the last statement leaves with a
// value where an earlier one would only have run.
const_block :: fn(mut p: Parser, at: i64) -> ConstFlow {
    advance(p)
    mut answered := ConstFlow {
        flow = FLOW_RAN,
        kind = CONST_INT,
        value = 0,
        count = 0
    }
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        const_spend(p, at)
        held := const_stmt(p, at)
        if (held.flow != FLOW_RAN && held.flow != FLOW_VALUE) {
            const_skip_to_close(p)
            advance(p)
            return held
        }
        answered = held
    }
    advance(p)
    if (answered.flow == FLOW_VALUE) {
        return ConstFlow {
            flow = FLOW_LEFT,
            kind = answered.kind,
            value = answered.value,
            count = answered.count
        }
    }
    ConstFlow { flow = FLOW_RAN, kind = CONST_INT, value = 0, count = 0 }
}

// Past the rest of the block the cursor is inside, leaving it on the `}`.
const_skip_to_close :: fn(mut p: Parser) {
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace) {
            if (depth == 0) {
                return
            }
            depth = depth - 1
        }
        advance(p)
    }
}

// Past a whole `{ ... }`, for the arm of an `if` that was not taken.
const_skip_block :: fn(mut p: Parser) {
    advance(p)
    const_skip_to_close(p)
    advance(p)
}

const_local_index :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut i: i64 = p.const_locals.count
    while (i > 0) {
        i = i - 1
        entry := arena_at(p.const_locals, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
    }
    -1
}

const_stmt :: fn(mut p: Parser, at: i64) -> ConstFlow {
    kind := cur(p)
    if (kind == TokenKind::KwReturn) {
        advance(p)
        held := const_expr(p, at)
        return ConstFlow {
            flow = FLOW_LEFT,
            kind = held.kind,
            value = held.value,
            count = held.count
        }
    }
    if (kind == TokenKind::KwBreak) {
        advance(p)
        return ConstFlow {
            flow = FLOW_BROKE,
            kind = CONST_INT,
            value = 0,
            count = 0
        }
    }
    if (kind == TokenKind::KwContinue) {
        advance(p)
        return ConstFlow {
            flow = FLOW_CONTINUED,
            kind = CONST_INT,
            value = 0,
            count = 0
        }
    }
    if (kind == TokenKind::KwIf) {
        return const_if(p, at)
    }
    if (kind == TokenKind::KwWhile) {
        return const_while(p, at)
    }
    if (kind == TokenKind::KwFor) {
        return const_for(p, at)
    }
    if (kind == TokenKind::KwMatch) {
        return const_match(p, at)
    }
    if (kind == TokenKind::Lbrace) {
        return const_block(p, at)
    }
    // `mut name : T = expr` and `name := expr` both bind. A `mut` written
    // without a type is the same binding with a word in front of it.
    if (kind == TokenKind::KwMut) {
        advance(p)
        return const_bind(p, at)
    }
    if (kind == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Coloneq) {
        return const_bind(p, at)
    }
    if (kind == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Colon) {
        return const_bind(p, at)
    }
    if (kind == TokenKind::Ident && peek_kind(p, 1) == TokenKind::Assign) {
        name_off := cur_off(p)
        name_len := cur_len(p)
        advance(p)
        advance(p)
        held := const_expr(p, at)
        slot := const_local_index(p, name_off, name_len)
        if (slot < 0) {
            const_fault(p, at)
            creport(p, "'")
            creport_src(p, name_off, name_len)
            creport(
                p,
                "' is not a name this call knows, so there is nothing to "
            )
            creport(p, "write to")
            const_stop(p)
        }
        entry := arena_at(p.const_locals, slot)
        entry.kind = held.kind
        entry.value = held.value
        entry.count = held.count
        return ConstFlow {
            flow = FLOW_RAN,
            kind = CONST_INT,
            value = 0,
            count = 0
        }
    }
    // A write to an element or a field, which is the one assignment a
    // compile-time call has no answer for. The shape is read here so what is
    // named is the write, rather than the first token the value reader met and
    // could not use.
    if (at_place_write(p)) {
        const_fault(p, at)
        creport(p, "a compile-time call writes to a name and nothing else")
        const_stop(p)
    }
    held := const_expr(p, at)
    ConstFlow {
        flow = FLOW_VALUE,
        kind = held.kind,
        value = held.value,
        count = held.count
    }
}

// Whether a write to a place stands where the cursor is: a name with indices
// or fields after it, and an `=` behind those. Brackets nest, so an index that
// is itself an index is one place and not two.
at_place_write :: fn(mut p: Parser) -> bool {
    if (cur(p) != TokenKind::Ident) {
        return false
    }
    mut ahead: i64 = 1
    mut depth: i64 = 0
    mut previous := cur_off(p) + cur_len(p)
    while (peek_kind(p, ahead) != TokenKind::Eof) {
        kind := peek_kind(p, ahead)
        // A place and the `=` behind it are one statement, so a line break ends
        // the search. Without it `out[index]` on one line and `index = index + 1`
        // on the next read as one write to a place, and a body doing that was
        // refused for something nobody wrote. A break inside brackets says
        // nothing, which is the rule everywhere else.
        if (depth == 0 && breaks_between(p.src, previous, peek_off(p, ahead))) {
            return false
        }
        if (kind == TokenKind::Lbracket) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbracket) {
            depth = depth - 1
        } else if (depth == 0 && kind == TokenKind::Assign) {
            return ahead > 1
        } else if (depth == 0 && kind != TokenKind::Dot
            && kind != TokenKind::Ident) {
            return false
        }
        previous = peek_off(p, ahead) + peek_len(p, ahead)
        ahead = ahead + 1
    }
    false
}

// `name := expr`, `name : T = expr`, with the cursor on the name.
const_bind :: fn(mut p: Parser, at: i64) -> ConstFlow {
    if (cur(p) != TokenKind::Ident) {
        const_fault(p, at)
        creport(p, "this is not something a compile-time call may do")
        const_stop(p)
    }
    name_off := cur_off(p)
    name_len := cur_len(p)
    advance(p)
    if (cur(p) == TokenKind::Colon) {
        advance(p)
        const_skip_type(p)
    }
    // What stands after the name is what binds it. Anything else is a write to
    // a place worked out while the program runs, an element or a field, which
    // is the one assignment a compile-time call has no answer for.
    if (cur(p) != TokenKind::Coloneq && cur(p) != TokenKind::Assign) {
        const_fault(p, at)
        creport(p, "a compile-time call writes to a name and nothing else")
        const_stop(p)
    }
    advance(p)
    held := const_expr(p, at)
    arena_push(
        p.const_locals,
        ConstLocal {
            name_off = name_off,
            name_len = name_len,
            kind = held.kind,
            value = held.value,
            count = held.count
        }
    )
    ConstFlow { flow = FLOW_RAN, kind = CONST_INT, value = 0, count = 0 }
}

const_condition :: fn(mut p: Parser, at: i64, word: ^i8) -> bool {
    advance(p)
    held := const_expr(p, at)
    advance(p)
    if (held.kind != CONST_BOOL) {
        const_fault(p, at)
        creport(p, "an ")
        report_cstr(word)
        creport(
            p,
            " is decided at compile time by asking its condition, which "
        )
        creport(p, "has to be a yes or no")
        const_stop(p)
    }
    held.value == 1
}

const_if :: fn(mut p: Parser, at: i64) -> ConstFlow {
    advance(p)
    holds := const_condition(p, at, "`if`")
    mut answered := ConstFlow {
        flow = FLOW_RAN,
        kind = CONST_INT,
        value = 0,
        count = 0
    }
    if (holds) {
        answered = const_block(p, at)
    } else {
        const_skip_block(p)
    }
    if (cur(p) == TokenKind::KwElse) {
        advance(p)
        if (holds) {
            if (cur(p) == TokenKind::KwIf) {
                const_skip_if(p)
            } else {
                const_skip_block(p)
            }
            return answered
        }
        if (cur(p) == TokenKind::KwIf) {
            return const_if(p, at)
        }
        return const_block(p, at)
    }
    answered
}

// Past an `if` that was not taken, however many `else if` arms it carries.
const_skip_if :: fn(mut p: Parser) {
    advance(p)
    advance(p)
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lparen) {
            depth = depth + 1
        } else if (kind == TokenKind::Rparen) {
            if (depth == 0) {
                advance(p)
                break
            }
            depth = depth - 1
        }
        advance(p)
    }
    const_skip_block(p)
    if (cur(p) == TokenKind::KwElse) {
        advance(p)
        if (cur(p) == TokenKind::KwIf) {
            const_skip_if(p)
        } else {
            const_skip_block(p)
        }
    }
}

const_while :: fn(mut p: Parser, at: i64) -> ConstFlow {
    head := p.ti
    while (true) {
        const_spend(p, at)
        p.ti = head
        advance(p)
        holds := const_condition(p, at, "a `while`")
        if (holds == false) {
            const_skip_block(p)
            return ConstFlow {
                flow = FLOW_RAN,
                kind = CONST_INT,
                value = 0,
                count = 0
            }
        }
        answered := const_block(p, at)
        if (answered.flow == FLOW_LEFT) {
            return answered
        }
        if (answered.flow == FLOW_BROKE) {
            return ConstFlow {
                flow = FLOW_RAN,
                kind = CONST_INT,
                value = 0,
                count = 0
            }
        }
    }
    ConstFlow { flow = FLOW_RAN, kind = CONST_INT, value = 0, count = 0 }
}

// A `for` over a span of whole numbers, or over a run already worked out. Both
// have a length before the body is read, so what the walk costs is bounded the
// way the step count bounds a `while`. `for index, item in run` names the
// position as well as the element.
const_for :: fn(mut p: Parser, at: i64) -> ConstFlow {
    advance(p)
    if (cur(p) != TokenKind::Ident) {
        const_fault(p, at)
        creport(p, "a `for` names what it walks")
        const_stop(p)
    }
    first_off := cur_off(p)
    first_len := cur_len(p)
    advance(p)
    mut second_off: i64 = 0
    mut second_len: i64 = 0
    mut named_two: bool = false
    if (cur(p) == TokenKind::Comma) {
        advance(p)
        second_off = cur_off(p)
        second_len = cur_len(p)
        named_two = true
        advance(p)
    }
    if (cur(p) != TokenKind::KwIn) {
        const_fault(p, at)
        creport(p, "a `for` names what it walks and then what it walks over")
        const_stop(p)
    }
    advance(p)
    low := const_expr(p, at)
    mut over_span: bool = false
    mut inclusive: bool = false
    mut high := const_int(0)
    if (cur(p) == TokenKind::Dotdot || cur(p) == TokenKind::Dotdoteq) {
        over_span = true
        inclusive = cur(p) == TokenKind::Dotdoteq
        advance(p)
        high = const_expr(p, at)
    }
    mut count: i64 = 0
    mut start: i64 = 0
    mut from: i64 = 0
    if (over_span) {
        if (low.kind != CONST_INT || high.kind != CONST_INT) {
            const_fault(p, at)
            creport(p, "a `for` over a span walks whole numbers")
            const_stop(p)
        }
        from = low.value
        mut last := high.value
        if (inclusive == false) {
            last = high.value - 1
        }
        count = last - from + 1
        if (count < 0) {
            count = 0
        }
    } else if (low.kind == CONST_ARRAY || low.kind == CONST_TEXT) {
        start = low.value
        count = low.count
    } else {
        const_fault(p, at)
        creport(p, "a `for` walks a span or a run of values, and this is ")
        creport(p, "neither")
        const_stop(p)
    }
    if (cur(p) != TokenKind::Lbrace) {
        const_fault(p, at)
        creport(p, "a `for` walks over a block")
        const_stop(p)
    }
    body_at := p.ti
    locals_mark := p.const_locals.count
    mut answered := ConstFlow {
        flow = FLOW_RAN,
        kind = CONST_INT,
        value = 0,
        count = 0
    }
    mut left: bool = false
    mut index: i64 = 0
    while (index < count) {
        const_spend(p, at)
        p.const_locals.count = locals_mark
        mut item := const_int(from + index)
        if (over_span == false) {
            if (low.kind == CONST_TEXT) {
                item = const_int(p.src[start + index])
            } else {
                entry := arena_at(p.const_items, start + index)
                item = ConstValue {
                    kind = entry.kind,
                    value = entry.value,
                    count = entry.count
                }
            }
        }
        if (named_two) {
            arena_push(
                p.const_locals,
                ConstLocal {
                    name_off = first_off,
                    name_len = first_len,
                    kind = CONST_INT,
                    value = index,
                    count = 0
                }
            )
            arena_push(
                p.const_locals,
                ConstLocal {
                    name_off = second_off,
                    name_len = second_len,
                    kind = item.kind,
                    value = item.value,
                    count = item.count
                }
            )
        } else {
            arena_push(
                p.const_locals,
                ConstLocal {
                    name_off = first_off,
                    name_len = first_len,
                    kind = item.kind,
                    value = item.value,
                    count = item.count
                }
            )
        }
        p.ti = body_at
        held := const_block(p, at)
        if (held.flow == FLOW_LEFT) {
            answered = held
            left = true
            break
        }
        if (held.flow == FLOW_BROKE) {
            break
        }
        index = index + 1
    }
    p.const_locals.count = locals_mark
    p.ti = body_at
    const_skip_block(p)
    if (left) {
        return answered
    }
    ConstFlow { flow = FLOW_RAN, kind = CONST_INT, value = 0, count = 0 }
}

// The arm a `match` takes. The subject is worked out first, so which arm it is
// settled before any of them is read, and the arms that were not taken are
// read for their length and worked out nowhere.
const_match :: fn(mut p: Parser, at: i64) -> ConstFlow {
    advance(p)
    if (cur(p) != TokenKind::Lparen) {
        const_fault(p, at)
        creport(p, "a `match` names what it reads")
        const_stop(p)
    }
    advance(p)
    subject := const_expr(p, at)
    advance(p)
    if (cur(p) != TokenKind::Lbrace) {
        const_fault(p, at)
        creport(p, "a `match` reads a block of arms")
        const_stop(p)
    }
    advance(p)
    mut answered := ConstFlow {
        flow = FLOW_RAN,
        kind = CONST_INT,
        value = 0,
        count = 0
    }
    mut taken: bool = false
    while (cur(p) == TokenKind::KwCase) {
        advance(p)
        covers := const_pattern(p, at, subject)
        if (cur(p) != TokenKind::Colon) {
            const_fault(p, at)
            creport(p, "an arm of a `match` is a pattern and then a ':'")
            const_stop(p)
        }
        advance(p)
        if (covers && taken == false) {
            taken = true
            if (cur(p) == TokenKind::Lbrace) {
                answered = const_block(p, at)
            } else {
                held := const_expr(p, at)
                answered = ConstFlow {
                    flow = FLOW_LEFT,
                    kind = held.kind,
                    value = held.value,
                    count = held.count
                }
            }
        } else {
            const_skip_arm(p)
        }
    }
    advance(p)
    // No arm taken, so the `match` answered nothing and the body it stands in
    // reaches its end without a value. A `match` over a whole number covers
    // every one of them or the exhaustiveness rule has already refused it, so
    // this is only reached for a program that is refused anyway, and what a
    // reader is told is that the constant has nothing to be.
    answered
}

// Past an arm that was not taken, leaving the cursor on the next `case` or on
// the `}` that ends the arms.
const_skip_arm :: fn(mut p: Parser) {
    if (cur(p) == TokenKind::Lbrace) {
        const_skip_block(p)
        return
    }
    mut depth: i64 = 0
    while (cur(p) != TokenKind::Eof) {
        kind := cur(p)
        if (kind == TokenKind::Lbrace || kind == TokenKind::Lparen
            || kind == TokenKind::Lbracket) {
            depth = depth + 1
        } else if (kind == TokenKind::Rbrace) {
            if (depth == 0) {
                return
            }
            depth = depth - 1
        } else if (kind == TokenKind::Rparen || kind == TokenKind::Rbracket) {
            depth = depth - 1
        } else if (depth == 0 && kind == TokenKind::KwCase) {
            return
        }
        advance(p)
    }
}

// Whether an arm's pattern covers what the subject worked out to. Every
// alternative under one arm is read, so the cursor ends on the ':' whichever of
// them answered.
const_pattern :: fn(mut p: Parser, at: i64, subject: ConstValue) -> bool {
    mut covers: bool = false
    mut more: bool = true
    while (more) {
        if (const_pattern_one(p, at, subject)) {
            covers = true
        }
        more = cur(p) == TokenKind::Pipe
        if (more) {
            advance(p)
        }
    }
    covers
}

// One alternative: a whole number, a yes or no, a span of whole numbers, or
// `_`, which is what a `case` may name anywhere. Text belongs in an `if` and a
// variant is not a compile-time value, so neither covers anything here.
const_pattern_one :: fn(mut p: Parser, at: i64, subject: ConstValue) -> bool {
    if (cur(p) == TokenKind::Underscore) {
        advance(p)
        return true
    }
    if (cur(p) == TokenKind::Ident
        && peek_kind(p, 1) == TokenKind::Coloncolon) {
        advance(p)
        advance(p)
        advance(p)
        return false
    }
    if (cur(p) == TokenKind::Str) {
        advance(p)
        return false
    }
    low := const_unary(p, at)
    if (cur(p) == TokenKind::Dotdot || cur(p) == TokenKind::Dotdoteq) {
        inclusive := cur(p) == TokenKind::Dotdoteq
        advance(p)
        high := const_unary(p, at)
        if (subject.kind != CONST_INT || low.kind != CONST_INT
            || high.kind != CONST_INT) {
            const_fault(p, at)
            creport(p, "a span of whole numbers covers whole numbers")
            const_stop(p)
            return false
        }
        if (subject.value < low.value) {
            return false
        }
        if (inclusive) {
            return subject.value <= high.value
        }
        return subject.value < high.value
    }
    if (low.kind != subject.kind) {
        return false
    }
    low.value == subject.value
}

// The expression grammar, level for level with the one the parser uses, so a
// spelling means here what it means where the program runs.
// `&&` and `||` answer without asking the right side when the left one settles
// it, the way they do where the program runs. The tokens of the side that goes
// unasked are still read, since that is what says where the expression ends,
// and nothing is worked out while they are.
const_expr :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_and(p, at)
    while (cur(p) == TokenKind::Oror) {
        advance(p)
        settled := left.kind == CONST_BOOL && left.value == 1
        if (settled) { p.const_quiet = p.const_quiet + 1 }
        right := const_and(p, at)
        if (settled) {
            p.const_quiet = p.const_quiet - 1
            left = const_bool(true)
        } else {
            left = const_bools(p, at, left, right, OP_OR)
        }
    }
    left
}

const_and :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_cmp(p, at)
    while (cur(p) == TokenKind::Andand) {
        advance(p)
        settled := left.kind == CONST_BOOL && left.value == 0
        if (settled) { p.const_quiet = p.const_quiet + 1 }
        right := const_cmp(p, at)
        if (settled) {
            p.const_quiet = p.const_quiet - 1
            left = const_bool(false)
        } else {
            left = const_bools(p, at, left, right, OP_AND)
        }
    }
    left
}

const_cmp :: fn(mut p: Parser, at: i64) -> ConstValue {
    left := const_bitor(p, at)
    kind := cur(p)
    if (kind == TokenKind::Lt) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_LT)
    }
    if (kind == TokenKind::Le) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_LE)
    }
    if (kind == TokenKind::Gt) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_GT)
    }
    if (kind == TokenKind::Ge) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_GE)
    }
    if (kind == TokenKind::Eqeq) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_EQ)
    }
    if (kind == TokenKind::Ne) {
        advance(p)
        return const_compare(p, at, left, const_bitor(p, at), OP_NE)
    }
    left
}

const_bitor :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_bitand(p, at)
    while (cur(p) == TokenKind::Pipe) {
        advance(p)
        right := const_bitand(p, at)
        left = const_ints(p, at, left, right, OP_BITOR)
    }
    left
}

const_bitand :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_shift(p, at)
    while (cur(p) == TokenKind::Amp) {
        advance(p)
        right := const_shift(p, at)
        left = const_ints(p, at, left, right, OP_BITAND)
    }
    left
}

const_shift :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_add(p, at)
    while (cur(p) == TokenKind::Shl || cur(p) == TokenKind::Shr) {
        mut op: i64 = OP_SHL
        if (cur(p) == TokenKind::Shr) {
            op = OP_SHR
        }
        advance(p)
        right := const_add(p, at)
        left = const_ints(p, at, left, right, op)
    }
    left
}

const_add :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_mul(p, at)
    while (cur(p) == TokenKind::Plus || cur(p) == TokenKind::Minus) {
        mut op: i64 = OP_ADD
        if (cur(p) == TokenKind::Minus) {
            op = OP_SUB
        }
        advance(p)
        right := const_mul(p, at)
        left = const_ints(p, at, left, right, op)
    }
    left
}

const_mul :: fn(mut p: Parser, at: i64) -> ConstValue {
    mut left := const_unary(p, at)
    while (cur(p) == TokenKind::Star || cur(p) == TokenKind::Slash
        || cur(p) == TokenKind::Percent) {
        mut op: i64 = OP_MUL
        if (cur(p) == TokenKind::Slash) {
            op = OP_DIV
        }
        if (cur(p) == TokenKind::Percent) {
            op = OP_MOD
        }
        advance(p)
        right := const_unary(p, at)
        left = const_ints(p, at, left, right, op)
    }
    left
}

const_unary :: fn(mut p: Parser, at: i64) -> ConstValue {
    if (cur(p) == TokenKind::Minus) {
        advance(p)
        held := const_unary(p, at)
        return const_ints(p, at, const_int(0), held, OP_SUB)
    }
    if (cur(p) == TokenKind::Bang) {
        advance(p)
        held := const_unary(p, at)
        if (held.kind != CONST_BOOL) {
            const_fault(p, at)
            creport(p, "'!' has no meaning for a whole number")
            const_stop(p)
        }
        return const_bool(held.value == 0)
    }
    const_factor(p, at)
}

// One `[a, b, c]` or `[value; n]`, with the cursor on the `[`. Every element is
// worked out once, here, and the run is held: an element may itself be a call,
// and reading the run again would run it again.
const_array :: fn(mut p: Parser, at: i64) -> ConstValue {
    advance(p)
    // Gathered aside rather than straight into `const_items`: an element may
    // itself be an aggregate, and working one out pushes there too, so a run
    // gathered in place is not the items beside each other.
    mark := p.const_scratch.count
    mut count: i64 = 0
    while (cur(p) != TokenKind::Rbracket && cur(p) != TokenKind::Eof) {
        held := const_expr(p, at)
        arena_push(
            p.const_scratch,
            ConstItem {
                name_off = 0,
                name_len = 0,
                kind = held.kind,
                value = held.value,
                count = held.count
            }
        )
        count = count + 1
        // `[value; n]` is the same value n times, which is the one place a
        // literal says how many rather than listing them.
        if (cur(p) == TokenKind::Semi) {
            advance(p)
            total := const_expr(p, at)
            if (total.kind != CONST_INT || total.value < 0) {
                const_fault(p, at)
                creport(p, "a run is written so many long, and a length is a ")
                creport(p, "whole number that is not negative")
                const_stop(p)
            }
            while (count < total.value) {
                const_spend(p, at)
                arena_push(
                    p.const_scratch,
                    ConstItem {
                        name_off = 0,
                        name_len = 0,
                        kind = held.kind,
                        value = held.value,
                        count = held.count
                    }
                )
                count = count + 1
            }
        }
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    start := const_gather(p, mark)
    ConstValue { kind = CONST_ARRAY, value = start, count = count }
}

// The run gathered since this mark, copied into `const_items` so its items are
// the ones beside each other, and the scratch cut back to where it was.
const_gather :: fn(mut p: Parser, mark: i64) -> i64 {
    start := p.const_items.count
    mut i := mark
    while (i < p.const_scratch.count) {
        held := arena_at(p.const_scratch, i)
        arena_push(
            p.const_items,
            ConstItem {
                name_off = held.name_off,
                name_len = held.name_len,
                kind = held.kind,
                value = held.value,
                count = held.count
            }
        )
        i = i + 1
    }
    p.const_scratch.count = mark
    start
}

// One `Name { field = value, ... }`, with the cursor on the `{` and the type's
// name behind it. Every field is named at the literal, so what a field reads is
// decided here without a layout; the type's name is kept because writing the
// value back into the program writes a literal of that type.
const_record :: fn(
    mut p: Parser,
    at: i64,
    type_off: i64,
    type_len: i64
) -> ConstValue {
    advance(p)
    // Gathered aside for the reason a run is: a field may itself be an
    // aggregate, and working one out pushes to `const_items` too.
    mark := p.const_scratch.count
    mut count: i64 = 0
    while (cur(p) != TokenKind::Rbrace && cur(p) != TokenKind::Eof) {
        name_off := cur_off(p)
        name_len := cur_len(p)
        advance(p)
        advance(p)
        held := const_expr(p, at)
        arena_push(
            p.const_scratch,
            ConstItem {
                name_off = name_off,
                name_len = name_len,
                kind = held.kind,
                value = held.value,
                count = held.count
            }
        )
        count = count + 1
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    start := const_gather(p, mark)
    held := p.const_records.count
    arena_push(
        p.const_records,
        ConstRecord {
            name_off = type_off,
            name_len = type_len,
            start = start,
            count = count
        }
    )
    ConstValue { kind = CONST_RECORD, value = held, count = count }
}

// Where an index lands, or what is wrong with it. Bounds are decided here,
// where the index is written, so reading past the end is a compile error rather
// than an abort the program was going to reach.
const_in_range :: fn(mut p: Parser, at: i64, index: i64, count: i64) -> i64 {
    if (count == 0) {
        const_fault(p, at)
        creport(p, "this reads item ")
        creport_int(p, index)
        creport(p, " of a run of nothing, which has no items")
        const_stop(p)
        return -1
    }
    if (index < 0 || index >= count) {
        const_fault(p, at)
        creport(p, "this reads item ")
        creport_int(p, index)
        creport(p, " of a run of ")
        creport_int(p, count)
        creport(p, ", whose items are numbered 0 to ")
        creport_int(p, count - 1)
        const_stop(p)
        return -1
    }
    index
}

// `base[index]` and `base.field`, however many of each follow a value.
const_postfix :: fn(mut p: Parser, at: i64, held_in: ConstValue) -> ConstValue {
    mut held := held_in
    while (cur(p) == TokenKind::Lbracket || cur(p) == TokenKind::Dot) {
        if (cur(p) == TokenKind::Lbracket) {
            advance(p)
            index := const_expr(p, at)
            advance(p)
            if (index.kind != CONST_INT) {
                const_fault(p, at)
                creport(
                    p,
                    "what is read out of a run is named by a whole number"
                )
                const_stop(p)
            }
            if (held.kind == CONST_TEXT) {
                place := const_in_range(p, at, index.value, held.count)
                if (place < 0) {
                    return const_int(0)
                }
                held = const_int(p.src[held.value + place])
            } else if (held.kind == CONST_ARRAY) {
                place := const_in_range(p, at, index.value, held.count)
                if (place < 0) {
                    return const_int(0)
                }
                item := arena_at(p.const_items, held.value + place)
                held = ConstValue {
                    kind = item.kind,
                    value = item.value,
                    count = item.count
                }
            } else {
                const_fault(p, at)
                creport(p, "this is not something an index reads")
                const_stop(p)
                return const_int(0)
            }
        } else {
            advance(p)
            name_off := cur_off(p)
            name_len := cur_len(p)
            advance(p)
            if (held.kind != CONST_RECORD) {
                const_fault(p, at)
                creport(p, "this has no field to read")
                const_stop(p)
                return const_int(0)
            }
            record := arena_at(p.const_records, held.value)
            mut i: i64 = 0
            mut found: i64 = -1
            while (i < record.count) {
                item := arena_at(p.const_items, record.start + i)
                if (item.name_len == name_len
                    && bytes_equal(p.src, item.name_off, name_off, name_len)) {
                    found = record.start + i
                }
                i = i + 1
            }
            if (found < 0) {
                const_fault(p, at)
                creport(p, "this has no field called '")
                creport_src(p, name_off, name_len)
                creport(p, "'")
                const_stop(p)
                return const_int(0)
            }
            item := arena_at(p.const_items, found)
            held = ConstValue {
                kind = item.kind,
                value = item.value,
                count = item.count
            }
        }
    }
    held
}

const_factor :: fn(mut p: Parser, at: i64) -> ConstValue {
    const_spend(p, at)
    kind := cur(p)
    if (p.const_quiet > 0 && kind == TokenKind::Float) {
        advance(p)
        return const_int(0)
    }
    if (kind == TokenKind::Int) {
        value := cur_val(p)
        advance(p)
        return const_int(value)
    }
    if (kind == TokenKind::Float) {
        const_fault(p, at)
        creport(
            p,
            "a compile-time value is a whole number or a yes or no, and "
        )
        creport(p, "this is a number with a fraction")
        const_stop(p)
    }
    if (kind == TokenKind::Lparen) {
        advance(p)
        held := const_expr(p, at)
        advance(p)
        return const_postfix(p, at, held)
    }
    if (kind == TokenKind::Str) {
        offset := cur_off(p)
        length := cur_len(p)
        advance(p)
        return const_postfix(
            p,
            at,
            ConstValue { kind = CONST_TEXT, value = offset, count = length }
        )
    }
    if (kind == TokenKind::Lbracket) {
        return const_postfix(p, at, const_array(p, at))
    }
    // A `match` written where a value is read. The arms answer the way a block
    // does, so the one that was taken leaves with a value.
    if (kind == TokenKind::KwMatch) {
        held := const_match(p, at)
        if (held.flow != FLOW_LEFT) {
            const_fault(p, at)
            creport(p, "this `match` answers with nothing, so there is no ")
            creport(p, "value here")
            const_stop(p)
            return const_int(0)
        }
        return ConstValue {
            kind = held.kind,
            value = held.value,
            count = held.count
        }
    }
    if (kind == TokenKind::Ident) {
        name_off := cur_off(p)
        name_len := cur_len(p)
        if (str_range_eq(p.src, name_off, name_len, "true")) {
            advance(p)
            return const_bool(true)
        }
        if (str_range_eq(p.src, name_off, name_len, "false")) {
            advance(p)
            return const_bool(false)
        }
        if (peek_kind(p, 1) == TokenKind::Lparen) {
            return const_postfix(
                p,
                at,
                const_named_call(p, at, name_off, name_len)
            )
        }
        // `Name { field = value }`, a set of named values written out. The
        // type's own name is read and dropped: every field is named at the
        // literal, so nothing here needs the declaration.
        if (peek_kind(p, 1) == TokenKind::Lbrace
            && is_type_name(p, name_off, name_len)) {
            advance(p)
            return const_postfix(p, at, const_record(p, at, name_off, name_len))
        }
        slot := const_local_index(p, name_off, name_len)
        if (slot >= 0) {
            advance(p)
            entry := arena_at(p.const_locals, slot)
            return const_postfix(
                p,
                at,
                ConstValue {
                    kind = entry.kind,
                    value = entry.value,
                    count = entry.count
                }
            )
        }
        if (const_names_a_value(p, name_off, name_len)) {
            advance(p)
            return const_postfix(p, at, const_named(p, name_off, name_len))
        }
        if (p.const_quiet > 0) {
            advance(p)
            return const_int(0)
        }
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(
            p,
            "' has no value at compile time, so this cannot be worked out "
        )
        creport(p, "before the program runs")
        const_stop(p)
    }
    const_fault(p, at)
    // A reading that is only being tried says nothing about what it met. The
    // value is set aside for the pass that keeps it as a node, which is where
    // a name under a type and a function are read, so meeting one here is not
    // a fault to tell a reader about.
    if (p.const_quiet > 0) {
        return const_int(0)
    }
    report("this is not something a compile-time call may do")
    frost_rt_recover_escape()
    const_int(0)
}

const_named_call :: fn(
    mut p: Parser,
    at: i64,
    name_off: i64,
    name_len: i64
) -> ConstValue {
    // What a type answers once it has been laid out. Each is answered by the
    // layout pass, which reads the types after every constant has settled, so
    // the order is what is named rather than the site: a reader who writes
    // `sizeof` in a constant is told when a layout exists.
    if (names_a_layout(p, name_off, name_len)) {
        // Worked out already, by the pass that can read a type, and left at
        // this call's own token. The tokens of the call are walked over here
        // rather than read, since what they say has an answer already.
        answer_at := layout_answer_at(p, p.ti)
        if (answer_at >= 0) {
            entry := arena_at(p.const_layouts, answer_at)
            answered := ConstValue {
                kind = entry.kind,
                value = entry.value,
                count = entry.count
            }
            advance(p)
            const_skip_parens(p)
            return const_postfix(p, at, answered)
        }
        // Nothing has read the types yet. A measurement is set aside rather
        // than refused, and worked out again where the types have been read.
        // The other two are answered later than that, so they are refused here.
        if (p.const_layouts_ready == 0
            && names_a_measurement(p, name_off, name_len)) {
            // Marked and walked over rather than left through an escape. An
            // escaped turn is counted, and the compile refuses at the end on
            // the count, so a constant that was only set aside would have
            // refused the program after being settled. What stands here is a
            // placeholder nothing keeps: `const_failed` says the reading is
            // worth nothing, and `const_needs_layout` silences the rest of it.
            p.const_needs_layout = 1
            p.const_failed = 1
            advance(p)
            const_skip_parens(p)
            return const_int(0)
        }
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(p, "' is answered once the types are read, and a ")
        creport(p, "compile-time value is worked out before that")
        const_stop(p)
    }
    index := const_fn_index(p, name_off, name_len, name_off)
    advance(p)
    advance(p)
    mark := p.const_args.count
    while (cur(p) != TokenKind::Rparen && cur(p) != TokenKind::Eof) {
        held := const_expr(p, at)
        arena_push(p.const_args, held)
        if (cur(p) == TokenKind::Comma) {
            advance(p)
        }
    }
    advance(p)
    count := p.const_args.count - mark
    if (p.const_quiet > 0) {
        p.const_args.count = mark
        return const_int(0)
    }
    // The three that keep the low bits. They are builtins the parser reads at
    // a call rather than functions a program declares, and they exist so a
    // value may leave its range on purpose: a hash worked out before the
    // program runs comes out the same as one worked out while it does.
    // The two that read a length, which are builtins the parser reads at a
    // call rather than functions a program declares.
    if (str_range_eq(p.src, name_off, name_len, "str_len")
        || str_range_eq(p.src, name_off, name_len, "slice_len")) {
        if (count != 1) {
            const_length_fault(p, at, name_off, name_len)
        }
        only := arena_at(p.const_args, mark)
        if (only.kind != CONST_TEXT && only.kind != CONST_ARRAY) {
            const_length_fault(p, at, name_off, name_len)
        }
        held := only.count
        p.const_args.count = mark
        return const_int(held)
    }
    if (is_wrapping_name(p, name_off, name_len)) {
        held := const_wrapped(p, at, name_off, name_len, mark, count)
        p.const_args.count = mark
        return held
    }
    if (index < 0) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, name_off, name_len)
        creport(p, "' is not a function this program declares, so there is ")
        creport(p, "nothing to work out here")
        const_stop(p)
    }
    saved := p.ti
    answered := const_call(p, index, mark, count, at)
    p.ti = saved
    answered
}

const_length_fault :: fn(mut p: Parser, at: i64, off: i64, len: i64) {
    const_fault(p, at)
    report("'")
    report_src(p.src, off, len)
    report("' reads the length of a run, and this is not one")
    frost_rt_recover_escape()
}

// Which recorded answer stands at this token, or -1 where none does.
layout_answer_at :: fn(mut p: Parser, at: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.const_layouts.count) {
        if (arena_at(p.const_layouts, i).at == at) {
            return i
        }
        i = i + 1
    }
    -1
}

// Past a `( ... )` with the cursor on the `(`, however deep it nests.
const_skip_parens :: fn(mut p: Parser) {
    mut depth: i64 = 0
    mut going: bool = true
    while (going && cur(p) != TokenKind::Eof) {
        if (cur(p) == TokenKind::Lparen) {
            depth = depth + 1
        } else if (cur(p) == TokenKind::Rparen) {
            depth = depth - 1
            if (depth == 0) {
                going = false
            }
        }
        advance(p)
    }
}

// Whether this name is one a type measures. These are what a constant may ask
// for, since a measurement is what the layout pass works out and a constant is
// worked out again after it. `type_id` is settled while the program is emitted
// and `offset_of` names a field rather than a type, so neither is one of these.
// What a bound may weigh against a number. A bound is arithmetic, so it takes
// the three that answer with one; `typename` answers with text, which is a
// measurement a constant may ask for and not one a bound can compare.
names_a_bound_measurement :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "sizeof")
        || str_range_eq(p.src, off, len, "alignof")
        || str_range_eq(p.src, off, len, "field_count"))
}

names_a_measurement :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "sizeof")
        || str_range_eq(p.src, off, len, "alignof")
        || str_range_eq(p.src, off, len, "field_count")
        || str_range_eq(p.src, off, len, "typename"))
}

// Whether this name is one a type answers once it is laid out.
names_a_layout :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "sizeof")
        || str_range_eq(p.src, off, len, "alignof")
        || str_range_eq(p.src, off, len, "offset_of")
        || str_range_eq(p.src, off, len, "field_count")
        || str_range_eq(p.src, off, len, "typename")
        || str_range_eq(p.src, off, len, "type_id"))
}

is_wrapping_name :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "wrap_add")
        || str_range_eq(p.src, off, len, "wrap_sub")
        || str_range_eq(p.src, off, len, "wrap_mul"))
}

const_wrapped :: fn(
    mut p: Parser,
    at: i64,
    off: i64,
    len: i64,
    mark: i64,
    count: i64
) -> ConstValue {
    if (count != 2) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, off, len)
        creport(
            p,
            "' keeps the low bits of two whole numbers, and this is not "
        )
        creport(p, "two of them")
        const_stop(p)
    }
    first := arena_at(p.const_args, mark)
    second := arena_at(p.const_args, mark + 1)
    if (first.kind != CONST_INT || second.kind != CONST_INT) {
        const_fault(p, at)
        creport(p, "'")
        creport_src(p, off, len)
        creport(
            p,
            "' keeps the low bits of two whole numbers, and this is not "
        )
        creport(p, "two of them")
        const_stop(p)
    }
    a := first.value
    b := second.value
    if (str_range_eq(p.src, off, len, "wrap_add")) {
        return const_int(wrap_add(a, b))
    }
    if (str_range_eq(p.src, off, len, "wrap_sub")) {
        return const_int(wrap_sub(a, b))
    }
    const_int(wrap_mul(a, b))
}

// What a constant stands for, whatever kind it is. A plain integer keeps the
// shape every other reader of the table sees.
const_named :: fn(mut p: Parser, off: i64, len: i64) -> ConstValue {
    mut i: i64 = 0
    while (i < p.const_aggregates.count) {
        entry := arena_at(p.const_aggregates, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)
            && name_visible(p, entry.name_off, entry.name_len, off)) {
            return ConstValue {
                kind = entry.kind,
                value = entry.value,
                count = entry.count
            }
        }
        i = i + 1
    }
    const_int(const_value(p, off, len))
}

// Whether a name stands for a constant of any kind, which is what says a name
// in a compile-time position has an answer.
const_names_a_value :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    if (is_const(p, off, len)) {
        return true
    }
    mut i: i64 = 0
    while (i < p.const_aggregates.count) {
        entry := arena_at(p.const_aggregates, i)
        if (entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)
            && name_visible(p, entry.name_off, entry.name_len, off)) {
            return true
        }
        i = i + 1
    }
    false
}

const_bools :: fn(
    mut p: Parser,
    at: i64,
    left: ConstValue,
    right: ConstValue,
    op: i64
) -> ConstValue {
    if (p.const_quiet > 0) {
        return const_int(0)
    }
    if (left.kind != CONST_BOOL || right.kind != CONST_BOOL) {
        const_fault(p, at)
        creport(p, "'&&' and '||' join two yes-or-no answers")
        const_stop(p)
    }
    if (op == OP_AND) {
        return const_bool(left.value == 1 && right.value == 1)
    }
    const_bool(left.value == 1 || right.value == 1)
}

const_compare :: fn(
    mut p: Parser,
    at: i64,
    left: ConstValue,
    right: ConstValue,
    op: i64
) -> ConstValue {
    if (p.const_quiet > 0) {
        return const_int(0)
    }
    if (left.kind != right.kind) {
        const_fault(p, at)
        creport(
            p,
            "this joins a whole number to a yes or no, and a compile-time "
        )
        creport(p, "value is worked out over one kind at a time")
        const_stop(p)
    }
    if (left.kind == CONST_BOOL && op != OP_EQ && op != OP_NE) {
        const_fault(p, at)
        creport(p, "a yes or no is compared and nothing else")
        const_stop(p)
    }
    if (op == OP_LT) { return const_bool(left.value < right.value) }
    if (op == OP_LE) { return const_bool(left.value <= right.value) }
    if (op == OP_GT) { return const_bool(left.value > right.value) }
    if (op == OP_GE) { return const_bool(left.value >= right.value) }
    if (op == OP_EQ) { return const_bool(left.value == right.value) }
    const_bool(left.value != right.value)
}

const_overflows :: fn(mut p: Parser, at: i64) {
    const_fault(p, at)
    report("this overflows an i64")
    frost_rt_recover_escape()
}

const_ints :: fn(
    mut p: Parser,
    at: i64,
    left: ConstValue,
    right: ConstValue,
    op: i64
) -> ConstValue {
    if (p.const_quiet > 0) {
        return const_int(0)
    }
    if (left.kind != CONST_INT || right.kind != CONST_INT) {
        const_fault(p, at)
        creport(
            p,
            "this joins a whole number to a yes or no, and a compile-time "
        )
        creport(p, "value is worked out over one kind at a time")
        const_stop(p)
    }
    a := left.value
    b := right.value
    if (op == OP_ADD) {
        sum := wrap_add(a, b)
        if ((a > 0 && b > 0 && sum < 0) || (a < 0 && b < 0 && sum >= 0)) {
            const_overflows(p, at)
        }
        return const_int(sum)
    }
    if (op == OP_SUB) {
        held := wrap_sub(a, b)
        if ((a >= 0 && b < 0 && held < 0) || (a < 0 && b > 0 && held >= 0)) {
            const_overflows(p, at)
        }
        return const_int(held)
    }
    if (op == OP_MUL) {
        if (a == 0 || b == 0) {
            return const_int(0)
        }
        if (a == (-1) && const_is_min(b)) {
            const_overflows(p, at)
        }
        if (b == (-1) && const_is_min(a)) {
            const_overflows(p, at)
        }
        held := wrap_mul(a, b)
        if (held / b != a) {
            const_overflows(p, at)
        }
        return const_int(held)
    }
    if (op == OP_DIV || op == OP_MOD) {
        if (b == 0) {
            const_fault(p, at)
            creport(p, "this divides by zero")
            const_stop(p)
        }
        // The remainder of the smallest by minus one is nothing, and that is
        // what the machine answers. Only the quotient leaves the range, so
        // refusing the remainder here would refuse arithmetic the program
        // would have carried out.
        if (op == OP_MOD && b == (-1)) {
            return const_int(0)
        }
        if (const_is_min(a) && b == (-1)) {
            const_overflows(p, at)
            return const_int(0)
        }
        if (op == OP_DIV) {
            return const_int(a / b)
        }
        return const_int(a % b)
    }
    if (op == OP_SHL || op == OP_SHR) {
        if (b < 0 || b > 63) {
            const_overflows(p, at)
        }
        if (op == OP_SHL) {
            return const_int(a << b)
        }
        return const_int(a >> b)
    }
    if (op == OP_BITAND) {
        return const_int(a & b)
    }
    if (op == OP_BITOR) {
        return const_int(a | b)
    }
    const_fault(p, at)
    report("this operator has no compile-time answer for two whole numbers")
    frost_rt_recover_escape()
    const_int(0)
}
