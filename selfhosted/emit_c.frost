// The C backend: a translation unit walked out of the AST.

import "core.frost"
import "imports.frost"
import "layout.frost"
import "lexer.frost"
import "names.frost"
import "types.frost"
import "parser.frost"
import "emit.frost"
import "emit_asm.frost"

export emit_program

emit_op :: fn(op: i64) {
    match op {
        case 0: emit_text(" + ")
        case 1: emit_text(" - ")
        case 2: emit_text(" * ")
        case 3: emit_text(" / ")
        case 4: emit_text(" % ")
        case 5: emit_text(" < ")
        case 6: emit_text(" > ")
        case 7: emit_text(" <= ")
        case 8: emit_text(" >= ")
        case 9: emit_text(" == ")
        case 10: emit_text(" != ")
        case 11: emit_text(" && ")
        case 12: emit_text(" || ")
        case 13: emit_text(" << ")
        case 14: emit_text(" >> ")
        case 15: emit_text(" & ")
        case 16: emit_text(" | ")
        case 17: emit_text(" + ")
        case 18: emit_text(" - ")
        case _: emit_text(" * ")
    }
}

// A struct's C name: its source name, plus the module that declared it when
// that is not the root, since two files may each keep a private struct of the
// same name, and plus `_<instance_id>` for a monomorphized instance.
// An array becomes a slice of the whole of itself wherever one is wanted. That
// is the only implicit conversion between aggregates the language has, and it
// is written out here rather than left to C, which would not do it.
// `c[h] = value` scatters the element's fields into the columns' per-field
// arrays at the handle's validated slot. Each field stores independently and
// re-validates the handle, which aborts identically if it is stale. This is the
// SoA write, a scatter made visible rather than hidden behind a whole-struct
// store.
emit_columns_scatter :: fn(mut p: Parser, cbase: i64, cbase_ty: i64,
    cthrough: i64, cindex: i64, value: i64) {
    value_ty := type_of(p, value)
    gens_ty := slab_field_type(p, cthrough, "generations")
    count := array_length(p, gens_ty)
    def := arena_at(p.structs, struct_index_of(cthrough))
    var fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        field_off := field.name_off
        field_len := field.name_len
        field_next := field.next
        if (is_columns_bookkeeping(p, field_off, field_len) == false) {
            emit_text("(")
            emit_expr(p, cbase)
            if (is_pointer(cbase_ty)) {
                emit_text(")->")
            } else {
                emit_text(").")
            }
            emit_field_name(p, field_off, field_len)
            emit_text(".items[frost_rt_slot(")
            emit_expr(p, cindex)
            emit_text(", ")
            frost_rt_emit_int(count)
            emit_text(", (")
            emit_expr(p, cbase)
            if (is_pointer(cbase_ty)) {
                emit_text(")->generations.items)]")
            } else {
                emit_text(").generations.items)]")
            }
            emit_text(" = ")
            if (is_pointer(value_ty)) {
                emit_text("(*(")
                emit_expr(p, value)
                emit_text(")).")
            } else {
                emit_text("(")
                emit_expr(p, value)
                emit_text(").")
            }
            emit_field_name(p, field_off, field_len)
            emit_text(";\n")
        }
        fid = field_next
    }
}

// Whether an expression names storage rather than producing a value: a name, a
// field of one, an element, or what a pointer points at. Everything else has no
// address until it is given one.
is_place_node :: fn(mut p: Parser, id: i64) -> bool {
    kind := arena_at(p.arena, id).kind
    (kind == NodeKind::Var || kind == NodeKind::Field
        || kind == NodeKind::Index || kind == NodeKind::Deref)
}

emit_coerced :: fn(mut p: Parser, value_in: i64, want: i64) {
    // A constant whose value is a literal stands for that literal here, so a
    // text constant reaching a `str` is coerced the way the literal written in
    // its place would be, length and all, rather than as the name.
    var value := value_in
    named := arena_at(p.arena, value)
    if (named.kind == NodeKind::Var
        && local_exists(p, named.val, named.c) == false) {
        held := value_const_node(p, named.val, named.c)
        if (held >= 0) {
            value = held
        }
    }
    // A zeroed columns container. Zero sets every generation and free slot to 0.
    // `columns_reset` lays out the free list before the container is used.
    if (is_columns_new_call(p, value)) {
        emit_text("(")
        emit_ctype(p, want)
        emit_text("){0}")
        return
    }
    have := type_of(p, value)
    // A string literal reaching a `str`. The length is counted from the source
    // rather than measured at run time, since an escape is two bytes written
    // and one byte held.
    if (is_array_ty(want) && is_slice_ty(p, want) && is_pointer(have)) {
        node := arena_at(p.arena, value)
        if (node.kind == NodeKind::StrLit) {
            emit_text("(")
            emit_ctype(p, want)
            emit_text("){ (unsigned char*)")
            emit_expr(p, value)
            emit_text(", ")
            frost_rt_emit_int(literal_length(p.src, node.val, node.c))
            emit_text(" }")
            return
        }
    }
    // A read parameter of struct type arrives as a borrow, so the name holds
    // the address of the value rather than the value. Writing it into a place
    // of the struct's own type is a copy of what it points at: `items[row] =
    // value` in a setter whose component is a struct is this, and without the
    // dereference C is handed a pointer where a struct belongs.
    if (is_aggregate(want) && is_pointer(have) && pointee(p, have) == want) {
        emit_text("(*")
        emit_expr(p, value)
        emit_text(")")
        return
    }
    if (is_array_ty(want) && is_array_ty(have) && is_slice_ty(p, want)
        && is_slice_ty(p, have) == false) {
        emit_text("(")
        emit_ctype(p, want)
        emit_text("){ (")
        emit_expr(p, value)
        emit_text(").items, ")
        frost_rt_emit_int(array_length(p, have))
        emit_text(" }")
        return
    }
    // The same slice, where the array is reached through an address rather than
    // held: a parameter of array type is a borrow, so what the name holds is
    // where the caller's array is. The length is the one the array's type
    // carries either way. Without this the address was written where a slice
    // belongs and what read it for a length read whatever sat beside it.
    if (is_array_ty(want) && is_slice_ty(p, want) && is_pointer(have)
        && is_array_ty(pointee(p, have))
        && is_slice_ty(p, pointee(p, have)) == false) {
        emit_text("(")
        emit_ctype(p, want)
        emit_text("){ (*")
        emit_expr(p, value)
        emit_text(").items, ")
        frost_rt_emit_int(array_length(p, pointee(p, have)))
        emit_text(" }")
        return
    }
    emit_expr(p, value)
}

// A field name is written into C exactly as the source spells it, so a field
// called `struct` or `int` would be a syntax error there rather than a field.
// Frost reserves none of these, and a C header being bound may well use one, so
// such a name is prefixed. Every place a field name is written goes through
// `emit_field_name`, which is what keeps the declaration and its uses agreeing.
is_c_keyword :: fn(src: str, off: i64, len: i64) -> bool {
    (str_range_eq(src, off, len, "auto")
        || str_range_eq(src, off, len, "bool")
        || str_range_eq(src, off, len, "break")
        || str_range_eq(src, off, len, "case")
        || str_range_eq(src, off, len, "char")
        || str_range_eq(src, off, len, "const")
        || str_range_eq(src, off, len, "continue")
        || str_range_eq(src, off, len, "default")
        || str_range_eq(src, off, len, "do")
        || str_range_eq(src, off, len, "double")
        || str_range_eq(src, off, len, "else")
        || str_range_eq(src, off, len, "enum")
        || str_range_eq(src, off, len, "extern")
        || str_range_eq(src, off, len, "float")
        || str_range_eq(src, off, len, "for")
        || str_range_eq(src, off, len, "goto")
        || str_range_eq(src, off, len, "if")
        || str_range_eq(src, off, len, "inline")
        || str_range_eq(src, off, len, "int")
        || str_range_eq(src, off, len, "long")
        || str_range_eq(src, off, len, "register")
        || str_range_eq(src, off, len, "restrict")
        || str_range_eq(src, off, len, "return")
        || str_range_eq(src, off, len, "short")
        || str_range_eq(src, off, len, "signed")
        || str_range_eq(src, off, len, "sizeof")
        || str_range_eq(src, off, len, "static")
        || str_range_eq(src, off, len, "struct")
        || str_range_eq(src, off, len, "switch")
        || str_range_eq(src, off, len, "typedef")
        || str_range_eq(src, off, len, "union")
        || str_range_eq(src, off, len, "unsigned")
        || str_range_eq(src, off, len, "void")
        || str_range_eq(src, off, len, "volatile")
        || str_range_eq(src, off, len, "while"))
}

emit_field_name :: fn(mut p: Parser, off: i64, len: i64) {
    if (is_c_keyword(p.src, off, len)) {
        emit_text("frost_f_")
    }
    emit_source(p.src, off, len)
}

// A local is written into C exactly as the source spells it, and Frost reserves
// none of C's words, so a variable called `auto` or `register` would be a
// syntax error there rather than a variable. Every place a local or parameter
// name is written goes through this, which is what keeps a declaration and its
// uses agreeing. An extern's name is not one of these: that name is the C
// symbol being linked against and is written as it is.
emit_local_name :: fn(mut p: Parser, off: i64, len: i64) {
    if (is_c_keyword(p.src, off, len)) {
        emit_text("frost_l_")
    }
    emit_source(p.src, off, len)
}

emit_struct_name :: fn(mut p: Parser, struct_index: i64) {
    def := arena_at(p.structs, struct_index)
    name_off := def.name_off
    name_len := def.name_len
    instance_id := def.instance_id
    emit_source(p.src, name_off, name_len)
    owner := module_at(p.modules, name_off)
    if (owner > 0) {
        emit_text("_m")
        frost_rt_emit_int(owner)
    }
    if (instance_id >= 0) {
        emit_text("_")
        frost_rt_emit_int(instance_id)
    }
}

emit_ctype :: fn(mut p: Parser, held: i64) {
    // A distinct type is its representation in C. The name is Frost's, and it
    // is checked before anything is emitted.
    ty := distinct_repr(held)
    // A function pointer is a plain `void*` at every place it is declared. Its
    // real signature is written only as a cast at the call site, so the name
    // never has to go inside a `(*name)(...)` declarator.
    if (is_proc(ty)) {
        emit_text("void*")
        return
    }
    if (is_pointer(ty)) {
        emit_ctype(p, pointee(p, ty))
        emit_text("*")
        return
    }
    if (ty == TY_I64 || ty == TY_ISIZE || ty == TY_HANDLE) {
        emit_text("int64_t")
        return
    }
    if (ty == TY_I32) {
        emit_text("int32_t")
        return
    }
    if (ty == TY_I16) {
        emit_text("int16_t")
        return
    }
    if (ty == TY_I8) {
        emit_text("char")
        return
    }
    if (ty == TY_U64 || ty == TY_USIZE) {
        emit_text("uint64_t")
        return
    }
    if (ty == TY_U32) {
        emit_text("uint32_t")
        return
    }
    if (ty == TY_U16) {
        emit_text("uint16_t")
        return
    }
    if (ty == TY_U8) {
        emit_text("unsigned char")
        return
    }
    if (ty == TY_F64) {
        emit_text("double")
        return
    }
    if (ty == TY_F32) {
        emit_text("float")
        return
    }
    if (ty == TY_BOOL) {
        emit_text("int8_t")
        return
    }
    if (ty == TY_VOID) {
        emit_text("void")
        return
    }
    if (is_array_ty(ty)) {
        emit_text("struct __arr")
        frost_rt_emit_int(array_index_of(ty))
        return
    }
    emit_text("struct ")
    emit_struct_name(p, struct_index_of(ty))
}

emit_struct_lit :: fn(mut p: Parser, struct_ty: i64, inits: i64) {
    emit_text("(struct ")
    emit_struct_name(p, struct_index_of(struct_ty))
    emit_text("){ ")
    var id := inits
    var first: bool = true
    while (id != (-1)) {
        if (first == false) {
            emit_text(", ")
        }
        first = false
        node := arena_at(p.arena, id)
        off := node.val
        len := node.c
        value := node.a
        next_id := node.next
        emit_text(".")
        emit_field_name(p, off, len)
        emit_text(" = ")
        // A struct handed to a generic arrives as an address, since that is how
        // a read parameter of struct type travels, so storing it into a field
        // of struct type reads through it.
        field_ty := field_type(p, struct_ty, off, len)
        value_ty := type_of(p, value)
        if (is_struct_ty(field_ty) && is_pointer(value_ty)) {
            emit_text("(*(")
            emit_expr(p, value)
            emit_text("))")
        } else {
            // Every other field takes the value the way a parameter of that
            // type would, so a string literal reaching a `str` field is given
            // its length here rather than stored as a bare pointer.
            emit_coerced(p, value, field_ty)
        }
        id = next_id
    }
    emit_text(" }")
}

// An integer written where C reads an expression. Every integer in Frost is
// sixty-four bits wide, and a small decimal literal in C is an `int`, so
// `1 << 63` written without the suffix shifts a thirty-two bit one and answers
// with whatever that host does. The suffix is what makes the literal the width
// the language says it is.
// The smallest i64 has no C literal of its own: `-9223372036854775808` reads as
// a negation of a number one past the largest signed one, so C makes it
// unsigned and warns. Written as one more than it plus one less, both halves
// fit.
emit_wide_int :: fn(value: i64) {
    if (value < 0 && wrap_sub(0, value) == value) {
        emit_text("(-9223372036854775807LL - 1)")
        return
    }
    frost_rt_emit_int(value)
    emit_text("LL")
}

emit_expr :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Num) {
        emit_wide_int(node.val)
        return
    }
    // The digits as written. C reads a decimal literal the same way the source
    // means it, so nothing here converts one. A sign in front when the literal
    // was written negative, which is carried on the node rather than turned
    // into a subtraction so that -0.0 stays the number it was written as.
    if (kind == NodeKind::Float) {
        if (node.b == 1) {
            emit_text("-")
        }
        emit_source(p.src, node.val, node.c)
        // A decimal constant is a double in C. The suffix is what makes it the
        // single-precision number the context asked for, so two of them are
        // added at the width they were read at rather than at double and
        // rounded once at the end.
        if (node.a == 1) {
            emit_text("f")
        }
        return
    }
    if (kind == NodeKind::Var) {
        off := node.val
        len := node.c
        if (is_const(p, off, len)) {
            emit_wide_int(const_value(p, off, len))
        } else {
            // Neither a constant nor anything in scope, so the name does not
            // exist. Without this the name would be emitted verbatim and only
            // whatever compiles the output would notice.
            if (local_exists(p, off, len) == false) {
                // A name that is a global function, used where a value is
                // wanted, is that function's address: a `void*` the call site
                // casts back to the signature before calling through it.
                fi := fn_index_of(p, off, len)
                if (fi >= 0) {
                    emit_text("(void*)mf_")
                    frost_rt_emit_int(fi)
                    return
                }
                // A struct constant is written out where it is named.
                value_node := value_const_node(p, off, len)
                if (value_node >= 0) {
                    emit_expr(p, value_node)
                    return
                }
                report_where(p.modules, p.src, off)
                report("unknown variable '")
                report_src(p.src, off, len)
                report("'")
                frost_rt_die()
            }
            emit_local_name(p, off, len)
        }
        return
    }
    if (kind == NodeKind::StrLit) {
        emit_text("\"")
        emit_string_content(p.src, node.val, node.c)
        emit_text("\"")
        return
    }
    if (kind == NodeKind::TypeVal) {
        return
    }
    if (kind == NodeKind::CallPtr) {
        // A call through a constant bundle's field is a call to the function
        // that field names, with nothing loaded and nothing dispatched.
        direct := bundle_field_fn(p, node.a)
        if (direct >= 0) {
            emit_text("mf_")
            frost_rt_emit_int(direct)
            emit_text("(")
            emit_args(p, node.b, direct)
            emit_text(")")
            return
        }
        callee_ty := type_of(p, node.a)
        if (is_proc(callee_ty) == false) {
            report_where(p.modules, p.src, node.pos)
            report("this is called, so it has to be a function, and it is a ")
            report_type_name(p, callee_ty)
            frost_rt_die()
        }
        emit_indirect_call(p, 0, 0, node.a, callee_ty, node.b)
        return
    }
    if (kind == NodeKind::Call) {
        fn_index := node.val
        args := node.a
        // A call whose name is a local of function-pointer type is indirect: the
        // value is cast back to the signature and called through.
        csym := arena_at(p.fns, fn_index)
        if (local_exists(p, csym.off, csym.len)) {
            callee_ty := lookup_local(p, csym.off, csym.len)
            if (is_proc(callee_ty)) {
                emit_indirect_call(p, csym.off, csym.len, -1, callee_ty,
                    args)
                return
            }
        }
        if (generic_fn_of(p, fn_index) >= 0) {
            arg := call_args_for(p, args, fn_index)
            emit_mono_name(p, fn_index, arg, p.call_xarg_start,
                p.call_xarg_count)
            emit_text("(")
            emit_args(p, args, fn_index)
            emit_text(")")
            return
        }
        emit_fn_symbol(p, fn_index)
        emit_text("(")
        emit_args(p, args, fn_index)
        emit_text(")")
        return
    }
    if (kind == NodeKind::Field) {
        base := node.a
        off := node.val
        len := node.c
        // A columns element field `c[h].field`: pick the field's own column
        // array, then index it by the handle's checked slot. SoA selects the
        // field before indexing, so this is one recognized shape rather than a
        // field offset added after a slab-style index. The handle is validated
        // by `frost_rt_slot` exactly as a slab's is.
        base_node := arena_at(p.arena, base)
        if (base_node.kind == NodeKind::Index) {
            cbase := base_node.a
            cindex := base_node.b
            cbase_ty := type_of(p, cbase)
            var cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(p, cthrough)
            }
            if (type_of(p, cindex) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                gens_ty := slab_field_type(p, cthrough, "generations")
                emit_text("(")
                emit_expr(p, cbase)
                if (is_pointer(cbase_ty)) {
                    emit_text(")->")
                } else {
                    emit_text(").")
                }
                emit_field_name(p, off, len)
                emit_text(".items[frost_rt_slot(")
                emit_expr(p, cindex)
                emit_text(", ")
                frost_rt_emit_int(array_length(p, gens_ty))
                emit_text(", (")
                emit_expr(p, cbase)
                if (is_pointer(cbase_ty)) {
                    emit_text(")->generations.items)]")
                } else {
                    emit_text(").generations.items)]")
                }
                return
            }
        }
        base_ty := type_of(p, base)
        // Resolve the field for its own sake: field_type rejects a name the
        // struct does not carry, which emitting alone would not notice.
        field_type(p, base_ty, off, len)
        if (is_pointer(base_ty)) {
            emit_text("(*(")
            emit_expr(p, base)
            emit_text("))")
        } else {
            emit_expr(p, base)
        }
        emit_text(".")
        emit_field_name(p, off, len)
        return
    }
    if (kind == NodeKind::Deref) {
        inner := node.a
        emit_text("(*(")
        emit_expr(p, inner)
        emit_text("))")
        return
    }
    if (kind == NodeKind::Index) {
        base := node.a
        index := node.b
        base_ty := type_of(p, base)
        var through := base_ty
        if (is_pointer(through)) {
            through = pointee(p, through)
        }
        // Indexing a slab by a handle: the handle names a slot, and the slot is
        // reached only after `frost_rt_slot` unpacks its index, bounds-checks it
        // against the storage run, and matches its generation against the live
        // one. The result is the storage element, an lvalue, so a place-deref
        // like `slab[handle].hp = 75` writes through it in place.
        if (type_of(p, index) == TY_HANDLE && is_slab_ty(p, through)) {
            storage_ty := slab_field_type(p, through, "storage")
            emit_text("(")
            emit_expr(p, base)
            if (is_pointer(base_ty)) {
                emit_text(")->storage.items[frost_rt_slot(")
            } else {
                emit_text(").storage.items[frost_rt_slot(")
            }
            emit_expr(p, index)
            emit_text(", ")
            frost_rt_emit_int(array_length(p, storage_ty))
            emit_text(", (")
            emit_expr(p, base)
            if (is_pointer(base_ty)) {
                emit_text(")->generations.items)]")
            } else {
                emit_text(").generations.items)]")
            }
            return
        }
        // A literal, whose bytes are in the read-only section: naming it
        // produces their address and how many there are was counted at the
        // source, so the read is checked against a number written here. The
        // cast is what makes a byte past 127 the same number it is in the other
        // backend, since C reads a plain string as signed.
        base_node := arena_at(p.arena, constant_node(p, base))
        if (base_node.kind == NodeKind::StrLit) {
            emit_text("((unsigned char)")
            emit_expr(p, base)
            emit_text("[frost_index(")
            emit_expr(p, index)
            emit_text(", ")
            frost_rt_emit_int(literal_length(p.src, base_node.val, base_node.c))
            emit_text(")])")
            return
        }
        // An array and a slice are both a named C struct, so the run of
        // elements inside one has to be named before it can be indexed. The
        // index is bounds-checked against the length, a constant for a fixed
        // array and the slice's own field for a slice, so an out-of-range
        // access aborts rather than reading past the run.
        //
        // A borrow of a slice is the slice, since that is what a `mut []T`
        // parameter is. A raw pointer to one is not: `^str` is a run of strings
        // and indexing it is the arithmetic below, which is what a container
        // holding slices as its elements needs.
        if (is_array_ty(through)
            && (is_raw_pointer(base_ty) == false || is_array_ty(base_ty))) {
            emit_text("(")
            emit_expr(p, base)
            if (is_pointer(base_ty)) {
                emit_text(")->")
            } else {
                emit_text(").")
            }
            if (is_slice_ty(p, through)) {
                emit_text("data[")
            } else {
                emit_text("items[")
            }
            emit_text("frost_index(")
            emit_expr(p, index)
            emit_text(", ")
            if (is_slice_ty(p, through)) {
                emit_text("(")
                emit_expr(p, base)
                if (is_pointer(base_ty)) {
                    emit_text(")->len")
                } else {
                    emit_text(").len")
                }
            } else {
                frost_rt_emit_int(array_length(p, through))
            }
            emit_text(")]")
            return
        }
        emit_expr(p, base)
        emit_text("[")
        emit_expr(p, index)
        emit_text("]")
        return
    }
    if (kind == NodeKind::Assert) {
        emit_text("frost_rt_assert_at((signed char)(")
        emit_expr(p, node.a)
        emit_text("), \"")
        emit_position(p.modules, p.src, node.pos)
        emit_text("\")")
        return
    }
    // Asked only of a word the walk has already found to be nonzero, which is
    // the one input where the answer is not defined.
    if (kind == NodeKind::TrailingZeros) {
        emit_text("((int64_t)__builtin_ctzll((uint64_t)(")
        emit_expr(p, node.a)
        emit_text(")))")
        return
    }
    if (kind == NodeKind::SliceLen) {
        // An array's length is in its type, so this is a constant there and a
        // field read only for a slice, which carries its own.
        inner := node.a
        // A literal has no length beside it, so its own is counted here. A name
        // standing for one is the literal, since a constant is written out
        // where it is used and there is nothing else there to read a length off.
        held := arena_at(p.arena, constant_node(p, inner))
        if (held.kind == NodeKind::StrLit) {
            frost_rt_emit_int(literal_length(p.src, held.val, held.c))
            return
        }
        var inner_ty := type_of(p, inner)
        var through: bool = false
        if (is_pointer(inner_ty)) {
            inner_ty = pointee(p, inner_ty)
            through = true
        }
        if (is_array_ty(inner_ty) && is_slice_ty(p, inner_ty) == false) {
            frost_rt_emit_int(array_length(p, inner_ty))
            return
        }
        emit_text("(")
        emit_expr(p, inner)
        if (through) {
            emit_text(")->len")
        } else {
            emit_text(").len")
        }
        return
    }
    if (kind == NodeKind::ArrayLit) {
        held := type_of(p, id)
        emit_text("(")
        emit_ctype(p, held)
        emit_text("){{")
        // Each element written as the element type wants it. A string literal
        // is a `char*` on its own and a pointer beside a length where a `str` is
        // wanted, so `[2]str` initialized from literals emitted the bare
        // pointers into a struct of two fields and the C compiler refused it.
        var want: i64 = -1
        if (is_array_ty(held)) {
            want = array_element(p, held)
        }
        var element := node.a
        while (element != (-1)) {
            enode := arena_at(p.arena, element)
            if (want >= 0) {
                emit_coerced(p, enode.a, want)
            } else {
                emit_expr(p, enode.a)
            }
            element = enode.next
            if (element != (-1)) {
                emit_text(", ")
            }
        }
        emit_text("}}")
        return
    }
    if (kind == NodeKind::SliceFrom) {
        emit_text("(")
        emit_ctype(p, node.val)
        emit_text("){ (")
        emit_expr(p, node.a)
        emit_text("), frost_length(")
        emit_expr(p, node.b)
        emit_text(") }")
        return
    }
    if (kind == NodeKind::AddrOf || kind == NodeKind::Ref) {
        inner := node.a
        // `ptr_to` of a name that is already an address, a `mut` aggregate
        // parameter or a `ref` binding, answers the address it carries: the
        // caller's storage, not the cell the address sits in.
        inner_node := arena_at(p.arena, inner)
        if (kind == NodeKind::AddrOf && inner_node.kind == NodeKind::Var
            && is_borrow(type_of(p, inner))) {
            emit_text("(")
            emit_expr(p, inner)
            emit_text(")")
            return
        }
        emit_text("(&(")
        emit_expr(p, inner)
        emit_text("))")
        return
    }
    if (kind == NodeKind::Cast) {
        emit_text("((")
        emit_ctype(p, node.val)
        emit_text(")(")
        emit_expr(p, node.a)
        emit_text("))")
        return
    }
    if (kind == NodeKind::PtrCast) {
        target := node.val
        expr := node.a
        emit_text("(")
        emit_ctype(p, target)
        emit_text("*)(")
        emit_expr(p, expr)
        emit_text(")")
        return
    }
    if (kind == NodeKind::Sizeof) {
        target := node.val
        emit_text("sizeof(")
        emit_ctype(p, target)
        emit_text(")")
        return
    }
    if (kind == NodeKind::StructLit) {
        struct_ty := node.val
        inits := node.a
        emit_struct_lit(p, struct_ty, inits)
        return
    }
    lower_enum_compare(p, id)
    bin := arena_at(p.arena, id)
    left := bin.a
    op := bin.val
    right := bin.b
    ty := type_of(p, id)
    // Two vectors, done lane by lane. A statement expression is what lets an
    // array come out of an expression in C; the operands are named first, so
    // each is evaluated once however many lanes read it. The C compiler folds
    // the run of lanes back into packed instructions.
    if (is_array_ty(ty) && is_slice_ty(p, ty) == false) {
        emit_vector_bin(p, left, op, right, ty)
        return
    }
    if (arith_checked(p, op, ty)) {
        emit_checked_bin(p, left, op, right, ty)
        return
    }
    emit_text("(")
    emit_expr(p, left)
    emit_op(op)
    emit_expr(p, right)
    emit_text(")")
}

// Two vectors as a statement expression: the operands under names of their
// own, then one lane at a time into a result of the same type.
emit_vector_bin :: fn(mut p: Parser, left: i64, op: i64, right: i64,
    ty: i64) {
    count := array_length(p, ty)
    emit_text("({ ")
    emit_ctype(p, ty)
    emit_text(" __va = (")
    emit_coerced(p, left, ty)
    emit_text("); ")
    emit_ctype(p, ty)
    emit_text(" __vb = (")
    emit_coerced(p, right, ty)
    emit_text("); ")
    emit_ctype(p, ty)
    emit_text(" __vr; ")
    var lane: i64 = 0
    while (lane < count) {
        emit_text("__vr.items[")
        frost_rt_emit_int(lane)
        emit_text("] = __va.items[")
        frost_rt_emit_int(lane)
        emit_text("]")
        emit_op(op)
        emit_text("__vb.items[")
        frost_rt_emit_int(lane)
        emit_text("]; ")
        lane = lane + 1
    }
    emit_text("__vr; })")
}

// Whether an operation can leave the range of the type it is computed at. A
// comparison answers a truth value, a bitwise operation stays inside, and
// anything that is not an integer is a float or a pointer.
arith_checked :: fn(mut p: Parser, op: i64, ty: i64) -> bool {
    if (is_integer(ty) == false) {
        return false
    }
    (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV
        || op == OP_MOD || op == OP_SHL || op == OP_SHR)
}

// A 64-bit operation is checked where it is done, since there is no wider place
// to do it. A narrower one is computed at 64 bits, where neither operand can
// overflow, and the answer is held to the range its own type means.
//
// Both operands are read into names before the check sees them, because C
// sequences neither a call's arguments nor an operator's operands, and the other
// two backends evaluate left to right. Without this, `take(10) + take(32)`
// answered with the two calls the other way round.
emit_checked_bin :: fn(mut p: Parser, left: i64, op: i64, right: i64, ty: i64) {
    signed := is_unsigned(ty) == false
    slot := p.arith_site
    if (slot >= ARITH_SLOTS) {
        report("frost: more checked arithmetic in one function than there are ")
        report("slots to read its operands into\n")
        frost_rt_die()
    }
    p.arith_site = slot + 1
    emit_text("(frost_t[")
    frost_rt_emit_int(slot)
    emit_text("] = (")
    emit_expr(p, left)
    emit_text("), ")
    // A shift moves by less than the width of what it shifts, and the answer
    // then fits by construction, so the amount is what is answered for.
    if (op == OP_SHL || op == OP_SHR) {
        // The slot is signed, so an unsigned right shift has to say so or the
        // sign bit is carried down instead of a zero. A left shift is done on
        // the bit pattern whatever the type: moving a one into the sign bit of
        // a signed C type is undefined, and slot sixty-three of a liveness word
        // is exactly that shift.
        unsigned_form := signed == false || op == OP_SHL
        emit_text("frost_narrow((")
        if (unsigned_form) {
            emit_text("(int64_t)((uint64_t)frost_t[")
            frost_rt_emit_int(slot)
            emit_text("]")
        } else {
            emit_text("frost_t[")
            frost_rt_emit_int(slot)
            emit_text("]")
        }
        emit_op(op)
        emit_text("frost_shift((")
        emit_expr(p, right)
        emit_text("), ")
        frost_rt_emit_int(scalar_size(ty) * 8)
        emit_text("))")
        if (unsigned_form) {
            emit_text(")")
        }
        emit_text(", ")
        frost_rt_emit_int(scalar_size(ty) * 8)
        emit_text(", ")
        if (signed) {
            emit_text("1")
        } else {
            emit_text("0")
        }
        emit_text(", 7))")
        return
    }
    if (scalar_size(ty) == 8 || op == OP_DIV || op == OP_MOD) {
        // Bound first: an aggregate argument travels by address, and a call is
        // not something an address can be taken of.
        helper := arith_wide_helper(op, signed)
        emit_text(helper)
        emit_text("(frost_t[")
        frost_rt_emit_int(slot)
        emit_text("], (")
        emit_expr(p, right)
        emit_text(")))")
        return
    }
    emit_text("frost_narrow((frost_t[")
    frost_rt_emit_int(slot)
    emit_text("]")
    emit_op(op)
    emit_text("(")
    emit_expr(p, right)
    emit_text(")), ")
    frost_rt_emit_int(scalar_size(ty) * 8)
    emit_text(", ")
    if (signed) {
        emit_text("1")
    } else {
        emit_text("0")
    }
    // The operation, so the sentence an overflow gets is the same one the other
    // backends give for it.
    emit_text(", ")
    frost_rt_emit_int(op)
    emit_text("))")
}

// How many checked operations one function may hold. Reaching it is a refusal
// rather than a wrong slot, since two sites sharing one would read each other's
// operand.
ARITH_SLOTS :: 256

arith_wide_helper :: fn(op: i64, signed: bool) -> str {
    if (op == OP_ADD) {
        if (signed) { return "frost_add_i64" }
        return "frost_add_u64"
    }
    if (op == OP_SUB) {
        if (signed) { return "frost_sub_i64" }
        return "frost_sub_u64"
    }
    if (op == OP_MUL) {
        if (signed) { return "frost_mul_i64" }
        return "frost_mul_u64"
    }
    if (op == OP_DIV) {
        if (signed) { return "frost_div_i64" }
        return "frost_div_u64"
    }
    if (signed) { return "frost_rem_i64" }
    "frost_rem_u64"
}

// A call through a function-pointer value. The value is a `void*`, so it is
// cast back to the real signature, `ret(*)(params)`, and called. Aggregate
// parameter and return types are `char*`, since aggregates travel by address,
// matching how the callee was compiled.
// The callee is written either as a name, when a local holds the pointer, or
// as an expression, when it is a field or anything else that answers with one.
emit_indirect_call :: fn(mut p: Parser, off: i64, len: i64, callee_node: i64,
    callee_ty: i64, args: i64) {
    ret := proc_ret(p, callee_ty)
    count := proc_param_count(p, callee_ty)
    emit_text("((")
    // The return type as the callee was compiled with it. A Frost function
    // answers with a struct by value in C, so a cast saying otherwise would
    // not match the definition it is calling.
    emit_ctype(p, ret)
    emit_text("(*)(")
    var i: i64 = 0
    while (i < count) {
        if (i > 0) {
            emit_text(", ")
        }
        param_ty := proc_param_at(p, callee_ty, i)
        // A struct, a fixed array and a slice all travel by address, which is
        // how every definition takes one, so the signature says a pointer to
        // the type. Saying the value itself agrees with the callee on one
        // target and not another: a sixteen-byte struct goes in two registers
        // under the System V convention while the callee reads one pointer, and
        // goes as a hidden pointer under the Windows one, where the two happen
        // to line up.
        emit_ctype(p, param_ty)
        if (is_aggregate(param_ty)) {
            emit_text("*")
        }
        i = i + 1
    }
    emit_text("))(")
    if (callee_node >= 0) {
        emit_text("(")
        emit_expr(p, callee_node)
        emit_text(")")
    } else {
        emit_local_name(p, off, len)
    }
    emit_text("))(")
    var id := args
    var first: bool = true
    var at: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        if (first == false) {
            emit_text(", ")
        }
        // The signature says how each argument travels, the same as a direct
        // call's parameter list does: a mode borrow is a pointer there, so a
        // value handed to one has its address taken. Without this a `mut`
        // parameter of a function pointer was handed the struct itself.
        var param_ty: i64 = -1
        if (at < count) {
            param_ty = proc_param_at(p, callee_ty, at)
        }
        arg_ty := type_of(p, node.a)
        var by_address: bool = false
        if (param_ty >= 0 && is_pointer(arg_ty) == false) {
            if (is_aggregate(param_ty)) {
                by_address = true
            } else if (is_pointer(param_ty)
                && is_aggregate(pointee(p, param_ty))) {
                by_address = true
            }
        }
        if (by_address) {
            emit_text("(&(")
            emit_expr(p, node.a)
            emit_text("))")
        } else {
            emit_expr(p, node.a)
        }
        first = false
        at = at + 1
        id = node.next
    }
    emit_text(")")
}

// Emit call arguments, skipping type-value arguments (they are erased since a
// type parameter is not a runtime value).
emit_args :: fn(mut p: Parser, head: i64, fn_index: i64) {
    var id := head
    var first: bool = true
    sym := arena_at(p.fns, fn_index)
    // The instance this call names, when the callee is generic, since the
    // symbol's list belongs to whichever instance was parsed last.
    var param: i64 = instance_params(p, fn_index, head)
    // Whether that answered. When it did, the list is this call's own instance
    // and says exactly how each argument is passed. When it did not, the
    // symbol's list is whichever instance was parsed last, which is right only
    // in a program that uses the generic once.
    var param_from_instance: i64 = 1
    if (param == (-1)) {
        param = sym.params
        param_from_instance = 0
    }
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        value := node.a
        next_id := node.next
        vnode := arena_at(p.arena, value)
        if (vnode.kind != NodeKind::TypeVal) {
            if (first == false) {
                emit_text(", ")
            }
            first = false
            // Auto-borrow: an argument passed to a mode-borrow (pointer)
            // parameter has its address taken here, unless it is already a
            // pointer (a borrow forwarded onward).
            var borrow: i64 = 0
            var param_next: i64 = -1
            var have_param: i64 = 0
            var param_ty: i64 = -1
            var param_auto: i64 = 0
            if (param != (-1)) {
                pnode := arena_at(p.arena, param)
                param_auto = pnode.a
                param_ty = pnode.b
                param_next = pnode.next
                have_param = 1
                arg_ty := type_of(p, value)
                if (param_auto == 1 && is_pointer(arg_ty) == false) {
                    borrow = 1
                }
                // A string literal is already a pointer, so the rule above
                // leaves it alone, but a `str` parameter wants a slice built
                // from it and handed over by address like any other aggregate.
                // An array reached through a borrow is the same shape: the
                // argument is an address and the parameter wants the slice made
                // from it. Only an argument that is already a slice is passed
                // through, since there is nothing left to build.
                if (param_auto == 1 && is_pointer(param_ty)
                    && is_slice_ty(p, pointee(p, param_ty))
                    && is_pointer(arg_ty)
                    && is_slice_ty(p, pointee(p, arg_ty)) == false) {
                    borrow = 1
                }
                // A generic call whose instance could not be resolved has no
                // parameter list of its own: the symbol's belongs to whichever
                // instantiation was parsed last, so it cannot say how this call
                // passes its arguments. The rule is then the one the parameter
                // modes encode, read off the argument alone: a struct borrows,
                // everything else is passed as it is. Where the instance did
                // answer, its list is exact and this is not, since a `mut`
                // parameter takes an address whatever it is bound to.
                if (param_from_instance == 0 && generic_fn_of(p, fn_index) >= 0) {
                    borrow = 0
                    if (param_auto != 2 && is_aggregate(arg_ty)) {
                        borrow = 1
                    }
                }
            // Check the argument against the parameter. A generic
            // template's parameter types are placeholders bound per
            // instantiation, so they carry nothing to check against. An
            // auto-borrowed argument is a value whose address is taken
            // here, so it answers to the pointee rather than the pointer.
            }
            // A string literal reaching a parameter of slice type, where the
            // parameter belongs to a generic: the literal is a pointer to
            // bytes, the parameter wants the slice built from it, and an
            // aggregate travels by address. `map_put($str, ..., "ada", 36)` is
            // this, and without it C is handed the bytes where a slice belongs.
            var want_ty := param_ty
            if (is_pointer(want_ty)) {
                want_ty = pointee(p, want_ty)
            }
            // Only where the parameter borrows. A generic taking its value
            // outright is handed the slice itself, and handing it an address
            // there is the wrong type rather than an extra indirection.
            literal_slice := (have_param == 1 && param_auto == 1
                && arena_at(p.arena, value).kind == NodeKind::StrLit
                && is_array_ty(want_ty) && is_slice_ty(p, want_ty))
            literal_value := (have_param == 1 && param_auto != 1
                && arena_at(p.arena, value).kind == NodeKind::StrLit
                && is_array_ty(want_ty) && is_slice_ty(p, want_ty))
            if (literal_slice) {
                emit_text("(&")
                emit_coerced(p, value, want_ty)
                emit_text(")")
            } else if (literal_value) {
                emit_coerced(p, value, want_ty)
            } else if (borrow == 1 && have_param == 1
                && param_node_by_value(p, param)) {
                borrow = 0
                emit_expr(p, value)
            } else if (borrow == 1) {
                // A borrowed parameter takes an address, and an array reaching
                // a slice parameter has to become one first. The slice itself
                // is what the callee is handed the address of.
                want := pointee(p, param_ty)
                if (is_array_ty(want) && is_slice_ty(p, want)) {
                    emit_text("(&")
                    emit_coerced(p, value, want)
                    emit_text(")")
                } else if (is_place_node(p, value)) {
                    emit_text("(&(")
                    emit_expr(p, value)
                    emit_text("))")
                } else {
                    // A value with nowhere to point at: what a call answered
                    // with. C refuses `&f()`, and a literal of one element
                    // gives it somewhere, since an array's element is an
                    // lvalue and a compound literal lives as long as the block
                    // it is written in, which outlasts the call it is an
                    // argument to.
                    emit_text("(&((")
                    emit_ctype(p, want)
                    emit_text("[1]){ ")
                    emit_expr(p, value)
                    emit_text(" })[0])")
                }
            } else if (have_param == 1) {
                emit_coerced(p, value, param_ty)
            } else {
                emit_expr(p, value)
            }
            if (have_param == 1) {
                param = param_next
            }
        }
        id = next_id
    }
    // The capabilities are the last arguments, supplied by the caller's
    // context rather than written at the call, one per source the callee draws.
    var cap: i64 = 0
    while (cap < cap_count_of(p, fn_index)) {
        if (first == false || cap > 0) {
            emit_text(", ")
        }
        emit_capability_argument(p, fn_index, cap)
        cap = cap + 1
    }
}

// The name a match compares its value out of. A node id is unique, so two
// matches in one function name two values.
emit_match_value :: fn(id: i64) {
    emit_text("__mv")
    frost_rt_emit_int(id)
}

// What one arm compares that value against: an `or` of one test per pattern
// the arm names, and a span written out as the two comparisons it stands for.
emit_case_test :: fn(mut p: Parser, match_id: i64, cid: i64) {
    var alt := case_alts(p, cid)
    var written: i64 = 0
    while (alt != (-1)) {
        anode := arena_at(p.arena, alt)
        form := anode.c
        low := anode.val
        high := anode.b
        next_alt := anode.next
        if (written == 1) {
            emit_text(" || ")
        }
        if (form == ALT_VALUE) {
            emit_match_value(match_id)
            emit_text(" == ")
            frost_rt_emit_int(low)
        } else {
            emit_text("(")
            emit_match_value(match_id)
            emit_text(" >= ")
            frost_rt_emit_int(low)
            emit_text(" && ")
            emit_match_value(match_id)
            if (form == ALT_INCLUSIVE) {
                emit_text(" <= ")
            } else {
                emit_text(" < ")
            }
            frost_rt_emit_int(high)
            emit_text(")")
        }
        written = 1
        alt = next_alt
    }
}

emit_stmt :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    kind := node.kind
    if (kind == NodeKind::Let) {
        value := node.a
        annotation := node.b
        off := node.val
        len := node.c
        var ty := annotation
        if (annotation == (-1)) {
            ty = binding_type(p, value)
        }
        emit_ctype(p, ty)
        emit_text(" ")
        emit_local_name(p, off, len)
        // Storage a branch fills in. It is zeroed rather than left as it is, so
        // a branch that hands back nothing leaves a value that is the same on
        // every run.
        if (value == (-1)) {
            emit_text(" = {0};\n")
            record_local(p, off, len, ty)
            return
        }
        emit_text(" = ")
        emit_coerced(p, value, ty)
        emit_text(";\n")
        record_local(p, off, len, ty)
        return
    }
    if (kind == NodeKind::Assign) {
        place := node.a
        value := node.b
        // `c[h] = value`: scatter the whole element into the columns' per-field
        // arrays at the handle's slot. Recognized before the scalar type check,
        // since the place has no single element type to compare against.
        place_node := arena_at(p.arena, place)
        if (place_node.kind == NodeKind::Index) {
            cbase := place_node.a
            cindex := place_node.b
            cbase_ty := type_of(p, cbase)
            var cthrough := cbase_ty
            if (is_pointer(cthrough)) {
                cthrough = pointee(p, cthrough)
            }
            if (type_of(p, cindex) == TY_HANDLE
                && is_columns_ty(p, cthrough)) {
                emit_columns_scatter(p, cbase, cbase_ty, cthrough, cindex, value)
                return
            }
        }
        place_ty := place_type(p, place)
        // The name of an aggregate `mut` parameter is the address it travels
        // as, so writing the whole value goes through it rather than over it.
        if (place_ty != type_of(p, place)) {
            emit_text("(*")
            emit_expr(p, place)
            emit_text(") = ")
            emit_coerced(p, value, place_ty)
            emit_text(";\n")
            return
        }
        emit_expr(p, place)
        emit_text(" = ")
        emit_coerced(p, value, place_ty)
        emit_text(";\n")
        return
    }
    if (kind == NodeKind::ExprStmt) {
        emit_expr(p, node.a)
        emit_text(";\n")
        return
    }
    // A chain of comparisons rather than a `switch`. C's `break` leaves a
    // switch, and Frost's leaves the loop around it, so an arm holding one
    // meant two things: the assembly backend and the bootstrap left the loop
    // and this one left the match and went round again.
    //
    // The value is compared once, out of a name of its own, since the arms of
    // a match on a call would otherwise call it once each. An arm that matches
    // everything closes the chain, so nothing after it is written: nothing
    // reaches it.
    if (kind == NodeKind::Match) {
        scrutinee := node.a
        cases := node.b
        emit_text("{\n")
        subject_ty := type_of(p, scrutinee)
        emit_ctype(p, subject_ty)
        emit_text(" ")
        emit_match_value(id)
        emit_text(" = ")
        emit_expr(p, scrutinee)
        emit_text(";\n")
        var cid := cases
        var written: i64 = 0
        var closed: i64 = 0
        while (cid != (-1) && closed == 0) {
            cnode := arena_at(p.arena, cid)
            is_default := cnode.c
            body := cnode.a
            next_case := cnode.next
            if (written == 1) {
                emit_text("else ")
            }
            if (is_default == 1) {
                closed = 1
            } else {
                emit_text("if (")
                emit_case_test(p, id, cid)
                emit_text(") ")
            }
            emit_text("{\n")
            emit_list(p, body)
            emit_text("}\n")
            written = 1
            cid = next_case
        }
        emit_text("}\n")
        return
    }

    if (kind == NodeKind::Return) {
        value := node.a
        if (value == (-1)) {
            emit_text("return 0;\n")
        } else {
            // Through the same coercion an assignment takes, since what is
            // being returned reaches a place of the function's return type
            // exactly as an assigned value reaches the type of what it is
            // assigned to. A string literal answered as a `str` is the case
            // that needs it: the literal is a pointer and the place carries a
            // length beside it.
            emit_text("return (")
            emit_coerced(p, value, p.current_ret)
            emit_text(");\n")
        }
        return
    }
    if (kind == NodeKind::If) {
        cond := node.a
        then_head := node.b
        else_head := node.val
        emit_text("if (")
        emit_expr(p, cond)
        emit_text(") {\n")
        emit_list(p, then_head)
        emit_text("}")
        if (else_head != (-1)) {
            emit_text(" else {\n")
            emit_list(p, else_head)
            emit_text("}")
        }
        emit_text("\n")
        return
    }
    if (kind == NodeKind::Break) {
        emit_text("break;\n")
        return
    }
    // C's `continue` in the `while (1)` form below runs the preamble again
    // before the test, which is what a condition needing statements means.
    if (kind == NodeKind::Continue) {
        emit_text("continue;\n")
        return
    }
    if (kind == NodeKind::While) {
        cond := node.a
        body := node.b
        preamble := node.c
        if (preamble == (-1)) {
            emit_text("while (")
            emit_expr(p, cond)
            emit_text(") {\n")
            emit_list(p, body)
            emit_text("}\n")
            return
        }
        // The condition needs statements run before it can be asked, and it is
        // asked again every time round, so the test moves inside the loop.
        emit_text("while (1) {\n")
        emit_list(p, preamble)
        emit_text("if (!(")
        emit_expr(p, cond)
        emit_text(")) break;\n")
        emit_list(p, body)
        emit_text("}\n")
        return
    }
    if (kind == NodeKind::With) {
        mark := push_provider(p, node.val, node.c, 1)
        emit_text("{\n")
        emit_list(p, node.a)
        emit_text("}\n")
        p.providers.count = mark
        return
    }
}

// One capability a call to `fn_index` is handed, emitted as an argument. A
// forwarded one is already a pointer and passes straight through. A region
// supplies the arena by address, the way any borrow is passed.
emit_capability_argument :: fn(mut p: Parser, fn_index: i64, index: i64) {
    found := provider_for(p, fn_index, index)
    if (found < 0) {
        report_missing_capability(p, fn_index, index)
    }
    held := arena_at(p.providers, found)
    if (held.borrow == 1) {
        emit_text("(&(")
        emit_source(p.src, held.off, held.len)
        emit_text("))")
        return
    }
    emit_source(p.src, held.off, held.len)
}

emit_list :: fn(mut p: Parser, head: i64) {
    var id := head
    while (id != (-1)) {
        emit_stmt(p, id)
        node := arena_at(p.arena, id)
        id = node.next
    }
}

emit_param_signature :: fn(mut p: Parser, head: i64) {
    if (head == (-1)) {
        emit_text("void")
        return
    }
    var id := head
    var first: bool = true
    var index: i64 = 0
    while (id != (-1)) {
        if (first == false) {
            emit_text(", ")
        }
        first = false
        node := arena_at(p.arena, id)
        var ty := node.b
        off := node.val
        len := node.c
        next_id := node.next
        // A `value` parameter is the struct itself rather than a borrow of it.
        // The C compiler is what knows how this target passes one, so it is
        // handed a real struct type and left to apply the rule. The name takes
        // a suffix so that a definition can bind the body's name to its
        // address. See emit_value_param_bindings.
        by_value := param_node_by_value(p, id)
        if (by_value) {
            ty = pointee(p, ty)
        }
        emit_ctype(p, ty)
        emit_text(" ")
        emit_local_name(p, off, len)
        if (by_value) {
            emit_text("__v")
        }
        index = index + 1
        id = next_id
    }
}

record_params :: fn(mut p: Parser, head: i64) {
    var id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        ty := node.b
        off := node.val
        len := node.c
        next_id := node.next
        record_local(p, off, len, ty)
        id = next_id
    }
}

// The linkage qualifier a `inline fn` gets in C: static so it needs no external
// definition and always_inline so the C compiler folds it rather than merely
// being allowed to. A prototype and its definition both carry it, or the two
// would disagree on linkage. A function not marked inline gets nothing.
emit_inline_qualifier :: fn(mut p: Parser, fn_index: i64) {
    sym := arena_at(p.fns, fn_index)
    if (sym.is_inline == 1) {
        emit_text("static inline __attribute__((always_inline)) ")
    }
}

emit_prototypes :: fn(mut p: Parser, head: i64) {
    var id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        fn_index := node.val
        params := node.b
        is_main := node.c
        next_id := node.next
        // A test that is not being run is left out entirely, so a program that
        // carries one links without needing the test runtime.
        if (kind == NodeKind::Func && (is_main != 1 || p.testing == 1)
            && (is_main != 2 || p.testing == 1)) {
            sym := arena_at(p.fns, fn_index)
            emit_inline_qualifier(p, fn_index)
            if (sym.ret_type == TY_VOID) {
                emit_text("int64_t")
            } else {
                emit_ctype(p, sym.ret_type)
            }
            emit_text(" ")
            emit_fn_symbol(p, fn_index)
            emit_text("(")
            emit_param_signature(p, params)
            emit_text(");\n")
        }
        id = next_id
    }
}

emit_extern_prototypes :: fn(mut p: Parser, head: i64) {
    var id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        fn_index := node.val
        params := node.b
        ret := node.c
        next_id := node.next
        if (kind == NodeKind::Extern) {
            sym := arena_at(p.fns, fn_index)
            name_off := sym.off
            name_len := sym.len
            emit_ctype(p, ret)
            emit_text(" ")
            emit_source(p.src, name_off, name_len)
            emit_text("(")
            emit_param_signature(p, params)
            emit_text(");\n")
        }
        id = next_id
    }
}

// One C struct per array type, so `[N]T` and `[]T` are values C can hold, pass,
// return and assign. A fixed array wraps the run itself, a slice wraps a
// pointer to one beside its length.
// Forward-declare every struct tag, user and array alike, so a member that is a
// pointer to one resolves whatever order the definitions come in. A slice's
// `T* data` is such a pointer, which is what lets a slice struct be defined
// before the user struct that embeds it.
emit_type_forward_decls :: fn(mut p: Parser) {
    var i: i64 = 0
    while (i < p.structs.count) {
        def := arena_at(p.structs, i)
        if (def.is_generic == 0) {
            emit_text("struct ")
            emit_struct_name(p, i)
            emit_text(";\n")
        }
        i = i + 1
    }
    i = 0
    while (i < p.arrays.count) {
        emit_text("struct __arr")
        frost_rt_emit_int(i)
        emit_text(";\n")
        i = i + 1
    }
}

// A slice is a pointer and a length, so it embeds only a pointer to its element
// and needs no more than the forward declaration above. Emitting these before
// the user structs is what lets a struct hold a `[]T` field by value. `want_slice`
// is 1 for the slices, 0 for the fixed arrays, whose element sits inside them by
// value and so must follow the struct it names.
// A C struct definition must follow every type it holds by value. A struct
// holds its non-pointer struct and fixed-array fields inline, and a fixed array
// holds its element inline, so those are emitted first. A pointer or slice field
// is content with the forward declaration and creates no ordering constraint.
// The compiler's own structs hold only scalars, pointers, and slices, so this
// only bites a program that puts a fixed array inside a struct, like a slab.
emit_type_dep :: fn(mut p: Parser, ty: i64) {
    if (is_struct_ty(ty)) {
        emit_struct_ordered(p, struct_index_of(ty))
    }
    if (is_array_ty(ty)) {
        emit_array_ordered(p, array_index_of(ty))
    }
}

emit_array_ordered :: fn(mut p: Parser, i: i64) {
    def := arena_at(p.arrays, i)
    if (def.emitted == 1) {
        return
    }
    def.emitted = 1
    element := def.element
    length := def.length
    // A `[]T` or `[N]T` in a generic function's signature registers an array
    // whose element is the type parameter itself, an artifact of parsing the
    // template. It is never named in the emitted program, which uses the
    // concrete per-instance arrays, so it is not defined here.
    var bare := element
    while (is_pointer(bare)) {
        bare = pointee(p, bare)
    }
    if (bare == TY_PARAM) {
        return
    }
    if (length >= 0) {
        emit_type_dep(p, element)
    }
    emit_text("struct __arr")
    frost_rt_emit_int(i)
    emit_text(" { ")
    if (length < 0) {
        emit_ctype(p, element)
        emit_text("* data; int64_t len; };\n")
    } else {
        emit_ctype(p, element)
        emit_text(" items[")
        frost_rt_emit_int(length)
        emit_text("]; };\n")
    }
}

emit_struct_ordered :: fn(mut p: Parser, i: i64) {
    def := arena_at(p.structs, i)
    if (def.is_generic == 1) {
        return
    }
    if (def.emitted == 1) {
        return
    }
    def.emitted = 1
    field_head := def.field_head
    var fid := field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        dep := field.ty
        next_field := field.next
        emit_type_dep(p, dep)
        fid = next_field
    }
    emit_text("struct ")
    emit_struct_name(p, i)
    emit_text(" {\n")
    fid = field_head
    // A variant's payload goes inside an anonymous struct inside one anonymous
    // union, so no two variants occupy the same bytes twice and every field is
    // still reached by the flat name it was declared under. C11 makes a member
    // of an anonymous struct or union a member of what contains it, which is
    // what lets `.Circle_radius` name it both here and at an initializer.
    var opened: i64 = 0
    var carried: i64 = -1
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        fty := field.ty
        off := field.name_off
        len := field.name_len
        which := field.variant
        next_field := field.next
        if (which >= 0) {
            if (opened == 0) {
                emit_text("union {\n")
                opened = 1
            }
            if (which != carried) {
                if (carried >= 0) {
                    emit_text("};\n")
                }
                carried = which
                emit_text("struct {\n")
            }
        }
        emit_ctype(p, fty)
        emit_text(" ")
        emit_field_name(p, off, len)
        // C lays this struct out, so a stated alignment has to reach it as one
        // C knows. A member's `aligned` gives the member that minimum and the
        // struct at least as much, which is what the assembly backend computes
        // for the same declaration.
        if (field.align > 0) {
            emit_text(" __attribute__((aligned(")
            frost_rt_emit_int(field.align)
            emit_text(")))")
        }
        emit_text(";\n")
        fid = next_field
    }
    if (carried >= 0) {
        emit_text("};\n")
    }
    if (opened == 1) {
        emit_text("};\n")
    }
    if (def.is_packed == 1) {
        emit_text("} __attribute__((packed));\n")
    } else {
        emit_text("};\n")
    }
}

// Emit every struct and array definition in dependency order. Structs are the
// roots. An array reached by none of them is emitted by the trailing sweep.
emit_type_defs :: fn(mut p: Parser) {
    // Each type is emitted once per unit, and a per-module build emits several,
    // so the mark that says "already written" is cleared at the start of each
    // one. Every unit carries every definition, since a C unit cannot use a
    // type it has not seen.
    var cleared: i64 = 0
    while (cleared < p.structs.count) {
        def := arena_at(p.structs, cleared)
        def.emitted = 0
        cleared = cleared + 1
    }
    cleared = 0
    while (cleared < p.arrays.count) {
        held := arena_at(p.arrays, cleared)
        held.emitted = 0
        cleared = cleared + 1
    }
    var i: i64 = 0
    while (i < p.structs.count) {
        emit_struct_ordered(p, i)
        i = i + 1
    }
    i = 0
    while (i < p.arrays.count) {
        emit_array_ordered(p, i)
        i = i + 1
    }
}

// Emit a function body, treating a trailing expression statement as the return
// value (Frost's implicit return) and appending a `return 0;` fallthrough only
// when the body does not already end in a return or a value.
// The return C wants where a body can fall off its end. Every branch of the
// body may already have returned, so nothing here is read; C still wants a
// value of the declared type, and a zero is one for a number and not one for a
// struct or an array.
emit_fallthrough_return :: fn(mut p: Parser) {
    if (is_aggregate(p.current_ret)) {
        emit_text("return (")
        emit_ctype(p, p.current_ret)
        emit_text("){0};\n")
        return
    }
    emit_text("return 0;\n")
}

emit_function_body :: fn(mut p: Parser, body: i64) {
    // Somewhere to read a checked operation's left operand into. C sequences
    // neither a call's arguments nor an operator's operands, and the comma
    // operator does, so a checked operation reads its left side into a slot
    // here and the whole of its right side happens after that. One slot per
    // site, since a site's own value is dead by the time the next one starts.
    p.arith_site = 0
    emit_text("int64_t frost_t[")
    frost_rt_emit_int(ARITH_SLOTS)
    emit_text("]; (void)frost_t;\n")
    if (body == (-1)) {
        emit_fallthrough_return(p)
        return
    }
    var id := body
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (next_id == (-1)) {
            // A body ending in a call answers with what that call answered
            // with, unless the function answers with nothing, where the value
            // is dropped. `spawning_system` ends in `ecs_spawn(world)` and
            // hands back no entity.
            if (kind == NodeKind::ExprStmt && type_of(p, node.a) != TY_VOID
                && p.current_ret != TY_VOID) {
                emit_text("return (")
                emit_coerced(p, node.a, p.current_ret)
                emit_text(");\n")
            } else {
                emit_stmt(p, id)
                if (kind != NodeKind::Return) {
                    emit_fallthrough_return(p)
                }
            }
        } else {
            emit_stmt(p, id)
        }
        id = next_id
    }
}

emit_function :: fn(mut p: Parser, id: i64) {
    node := arena_at(p.arena, id)
    fn_index := node.val
    body := node.a
    params := node.b
    is_main := node.c
    sym := arena_at(p.fns, fn_index)
    p.current_ret = sym.ret_type
    p.current_fn_off = sym.off
    p.current_fn_len = sym.len
    p.locals.count = 0
    p.frame_used = 0
    record_params(p, params)
    begin_provider(p, fn_index)
    // In a test build the runner is the entry point, so the program's own main
    // is emitted as an ordinary function and never called.
    if (is_main == 1 && p.testing == 0) {
        emit_text("int main(void) {\n")
    } else {
        // The declared return type, so a function may return a pointer or a
        // struct rather than everything answering as an integer. A function
        // that declares nothing still lowers to int64_t, since the body falls
        // through to `return 0`.
        emit_inline_qualifier(p, fn_index)
        if (sym.ret_type == TY_VOID) {
            emit_text("int64_t")
        } else {
            emit_ctype(p, sym.ret_type)
        }
        emit_text(" ")
        emit_fn_symbol(p, fn_index)
        emit_text("(")
        emit_param_signature(p, params)
        emit_text(") {\n")
    }
    emit_value_param_bindings(p, params)
    emit_function_body(p, body)
    emit_text("}\n")
}

// A parameter C passed as the struct arrives as a value, and the body reads a
// struct through an address, so it is given one to point at. The parameter
// itself carries a suffix in the signature and this binds the name the body
// uses. The struct is the callee's own copy, which is what by value means.
emit_value_param_bindings :: fn(mut p: Parser, params: i64) {
    var id := params
    var index: i64 = 0
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        off := node.val
        len := node.c
        ty := node.b
        next_id := node.next
        if (param_node_by_value(p, id)) {
            emit_text("    ")
            emit_ctype(p, ty)
            emit_text(" ")
            emit_local_name(p, off, len)
            emit_text(" = &")
            emit_local_name(p, off, len)
            emit_text("__v;\n")
        }
        index = index + 1
        id = next_id
    }
}

// One argument's contribution to a mangled name: a type argument is `_t<code>`,
// a value argument `_c<number>`, and a function argument `_f<index>`. Both a
// call and its definition mangle through here, so the two always agree.
emit_mangled_arg :: fn(mut p: Parser, arg: i64) {
    if (arg >= FN_BASE) {
        emit_text("_f")
        frost_rt_emit_int(arg - FN_BASE)
    } else if (arg >= CONST_BASE) {
        emit_text("_c")
        frost_rt_emit_int(arg - CONST_BASE)
    } else {
        emit_text("_t")
        frost_rt_emit_int(arg)
    }
}

// What a function is called in the emitted C. A C library's name, and a
// function written as `extern fn` with a body, are both spelled the way they
// were written, because something outside this translation unit names them.
// Everything else is `mf_<index>`, which cannot collide with anything.
emit_fn_symbol :: fn(mut p: Parser, fn_index: i64) {
    sym := arena_at(p.fns, fn_index)
    if (sym.is_extern == 1 || sym.keeps_name == 1) {
        emit_source(p.src, sym.off, sym.len)
        return
    }
    emit_text("mf_")
    frost_rt_emit_int(fn_index)
}

// The mangled name of a monomorphization: `mf_<index>` then every argument in
// the tuple. A one-argument generic emits `mf_<index>_t<code>`, byte for byte
// what it did before value and multi-parameter generics existed.
emit_mono_name :: fn(mut p: Parser, fn_index: i64, arg: i64, xarg_start: i64,
    xarg_count: i64) {
    emit_text("mf_")
    frost_rt_emit_int(fn_index)
    emit_mangled_arg(p, arg)
    var i: i64 = 0
    while (i < xarg_count) {
        garg := arena_at(p.gargs, xarg_start + i)
        emit_mangled_arg(p, garg.value)
        i = i + 1
    }
}

emit_mono_function :: fn(mut p: Parser, id: i64, arg: i64, xarg_start: i64,
    xarg_count: i64, ret: i64) {
    node := arena_at(p.arena, id)
    fn_index := node.val
    body := node.a
    params := node.b
    msym := arena_at(p.fns, fn_index)
    p.current_ret = ret
    p.current_fn_off = msym.off
    p.current_fn_len = msym.len
    p.locals.count = 0
    p.frame_used = 0
    record_params(p, params)
    begin_provider(p, fn_index)
    // A function that answers with nothing still lowers to int64_t, since the
    // body falls through to `return 0`, exactly as a non-generic one does.
    emit_inline_qualifier(p, fn_index)
    if (ret == TY_VOID) {
        emit_text("int64_t")
    } else {
        emit_ctype(p, ret)
    }
    emit_text(" ")
    emit_mono_name(p, fn_index, arg, xarg_start, xarg_count)
    emit_text("(")
    emit_param_signature(p, params)
    emit_text(") {\n")
    emit_function_body(p, body)
    emit_text("}\n")
}

emit_mono_prototype :: fn(mut p: Parser, id: i64, arg: i64, xarg_start: i64,
    xarg_count: i64, ret: i64) {
    node := arena_at(p.arena, id)
    fn_index := node.val
    params := node.b
    emit_inline_qualifier(p, fn_index)
    if (ret == TY_VOID) {
        emit_text("int64_t")
    } else {
        emit_ctype(p, ret)
    }
    emit_text(" ")
    emit_mono_name(p, fn_index, arg, xarg_start, xarg_count)
    emit_text("(")
    emit_param_signature(p, params)
    emit_text(");\n")
}

// ---------------------------------------------------------------------------
// The translation unit. The runtime prototypes come first, then every type,
// then a prototype per function and specialization, then the bodies. A C unit
// cannot call what it has not seen, so a per-module build repeats everything
// but the bodies in each unit.
// ---------------------------------------------------------------------------

emit_program :: fn(mut p: Parser, head: i64) {
    emit_text("void frost_rt_assert_at(signed char, const char*);\n")
    emit_text("int64_t frost_rt_check_index(int64_t, int64_t);\n")
    // The index check as a comparison the C compiler can see, so the ones it
    // can prove cost nothing and the rest cost a compare. The runtime holds the
    // message and the abort, and only an index outside the run reaches them.
    // Unsigned, which is what makes one comparison answer for a negative index
    // as well as for one past the end.
    emit_text("static inline int64_t frost_index(int64_t i, int64_t n) {\n")
    emit_text("  if ((uint64_t)i >= (uint64_t)n) { frost_rt_check_index(i, n); }\n")
    emit_text("  return i;\n")
    emit_text("}\n")
    // The same unsigned comparison that answers for a negative index would read
    // a negative length as enormous and let every index through, so a length is
    // answered for once where the slice is built rather than at each access.
    // Arithmetic whose result does not fit the type it is computed at has no
    // right answer, so it stops rather than wrapping. Each is a comparison the
    // hardware was doing anyway, and the call sits on the branch that failed.
    emit_text("void frost_rt_arith_trap(int64_t);\n")
    emit_text("static inline int64_t frost_add_i64(int64_t a, int64_t b) {\n")
    emit_text("  if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b))\n")
    emit_text("    frost_rt_arith_trap(0);\n  return a + b;\n}\n")
    emit_text("static inline int64_t frost_sub_i64(int64_t a, int64_t b) {\n")
    emit_text("  if ((b < 0 && a > INT64_MAX + b) || (b > 0 && a < INT64_MIN + b))\n")
    emit_text("    frost_rt_arith_trap(1);\n  return a - b;\n}\n")
    emit_text("static inline int64_t frost_mul_i64(int64_t a, int64_t b) {\n")
    emit_text("  if (a != 0 && b != 0) {\n")
    emit_text("    int64_t r = (int64_t)((uint64_t)a * (uint64_t)b);\n")
    emit_text("    if (r / b != a) frost_rt_arith_trap(2);\n    return r;\n  }\n")
    emit_text("  return 0;\n}\n")
    emit_text("static inline uint64_t frost_add_u64(uint64_t a, uint64_t b) {\n")
    emit_text("  if (a > UINT64_MAX - b) frost_rt_arith_trap(0);\n  return a + b;\n}\n")
    emit_text("static inline uint64_t frost_sub_u64(uint64_t a, uint64_t b) {\n")
    emit_text("  if (a < b) frost_rt_arith_trap(1);\n  return a - b;\n}\n")
    emit_text("static inline uint64_t frost_mul_u64(uint64_t a, uint64_t b) {\n")
    emit_text("  if (a != 0 && b > UINT64_MAX / a) frost_rt_arith_trap(2);\n")
    emit_text("  return a * b;\n}\n")
    emit_text("static inline int64_t frost_div_i64(int64_t a, int64_t b) {\n")
    emit_text("  if (b == 0) frost_rt_arith_trap(3);\n")
    emit_text("  if (a == INT64_MIN && b == -1) frost_rt_arith_trap(5);\n")
    emit_text("  return a / b;\n}\n")
    emit_text("static inline int64_t frost_rem_i64(int64_t a, int64_t b) {\n")
    emit_text("  if (b == 0) frost_rt_arith_trap(4);\n")
    emit_text("  if (a == INT64_MIN && b == -1) return 0;\n  return a % b;\n}\n")
    emit_text("static inline uint64_t frost_div_u64(uint64_t a, uint64_t b) {\n")
    emit_text("  if (b == 0) frost_rt_arith_trap(3);\n  return a / b;\n}\n")
    emit_text("static inline uint64_t frost_rem_u64(uint64_t a, uint64_t b) {\n")
    emit_text("  if (b == 0) frost_rt_arith_trap(4);\n  return a % b;\n}\n")
    emit_text("static inline int64_t frost_narrow(int64_t v, int64_t bits, int64_t is_signed, int64_t what) {\n")
    // A full-width value has nothing to narrow to, and building its bound would
    // shift a one into the sign bit, which is the overflow this is here for.
    emit_text("  if (bits >= 64) return v;\n")
    emit_text("  if (is_signed) {\n")
    emit_text("    int64_t hi = ((int64_t)1 << (bits - 1)) - 1;\n")
    emit_text("    if (v < -hi - 1 || v > hi) frost_rt_arith_trap(what);\n")
    emit_text("  } else {\n")
    emit_text("    if (v < 0 || (uint64_t)v > (((uint64_t)1 << bits) - 1))\n")
    emit_text("      frost_rt_arith_trap(what);\n  }\n  return v;\n}\n")
    // A shift moves by less than the width of what it shifts. The hardware
    // answers a wider one by masking, which is a different shift than the one
    // that was written.
    emit_text("static inline int64_t frost_shift(int64_t by, int64_t bits) {\n")
    emit_text("  if (by < 0 || by >= bits) frost_rt_arith_trap(7);\n")
    emit_text("  return by;\n}\n")
    emit_text("int64_t frost_rt_check_length(int64_t);\n")
    emit_text("static inline int64_t frost_length(int64_t n) {\n")
    emit_text("  if (n < 0) { frost_rt_check_length(n); }\n")
    emit_text("  return n;\n")
    emit_text("}\n")
    emit_text("int64_t frost_rt_slot(int64_t, int64_t, const int64_t*);\n")
    emit_type_forward_decls(p)
    emit_type_defs(p)
    emit_extern_prototypes(p, head)

    // Prototypes for each monomorphization, so they may be called before defined.
    var gi: i64 = 0
    while (gi < p.generic_fns.count) {
        var ii: i64 = 0
        while (ii < p.type_args.count) {
            used := arena_at(p.type_args, ii)
            arg := used.arg
            xstart := used.xarg_start
            xcount := used.xarg_count
            is_pack := used.is_pack
            owner := used.owner
            if (instance_fits_kind(p, gi, arg, xstart, xcount, is_pack,
                    owner) && tuple_is_first_for(p, gi, ii)) {
                node := parse_generic_instance(p, gi, arg, xstart, xcount)
                ret := p.last_return_type
                emit_mono_prototype(p, node, arg, xstart, xcount, ret)
            }
            ii = ii + 1
        }
        gi = gi + 1
    }

    emit_prototypes(p, head)

    // Monomorphized function definitions, in the unit that declared the
    // template. Every unit carries the prototypes above, so a call from
    // anywhere else links to this one.
    gi = 0
    while (gi < p.generic_fns.count) {
        if (unit_owns_generic(p, gi)) {
            var ii: i64 = 0
            while (ii < p.type_args.count) {
                used := arena_at(p.type_args, ii)
                arg := used.arg
                xstart := used.xarg_start
                xcount := used.xarg_count
                is_pack := used.is_pack
                owner := used.owner
                if (instance_fits_kind(p, gi, arg, xstart, xcount, is_pack,
                        owner) && tuple_is_first_for(p, gi, ii)) {
                    node := parse_generic_instance(p, gi, arg, xstart, xcount)
                    ret := p.last_return_type
                    emit_mono_function(p, node, arg, xstart, xcount, ret)
                }
                ii = ii + 1
            }
        }
        gi = gi + 1
    }

    var id := head
    while (id != (-1)) {
        node := arena_at(p.arena, id)
        kind := node.kind
        next_id := node.next
        if (kind == NodeKind::Func && (node.c != 2 || p.testing == 1)
            && unit_owns(p, id)) {
            emit_function(p, id)
        }
        id = next_id
    }

    // One entry point however many units there are, in the first, which is the
    // file the build was pointed at.
    if (p.testing == 1 && p.emit_module <= 0) {
        emit_test_main(p)
    }
}

// The entry point a `--test` build gets instead of the program's own. Each body
// is handed to the runner as a function pointer rather than called here,
// because a failing assertion has to escape back into the runner without ending
// the run, and the setjmp that allows that has to own the call.
emit_test_main :: fn(mut p: Parser) {
    emit_text("void frost_rt_test_run(const char*, void(*)(void));\n")
    emit_text("int64_t frost_rt_test_summary(void);\n")
    emit_text("int main(void) {\n")
    var i: i64 = 0
    while (i < p.tests.count) {
        entry := arena_at(p.tests, i)
        // Only the tests of the file that was named. A module's own tests are
        // its to run, so importing one does not drag its test blocks into the
        // run of whatever imported it. The root is module zero, since it is
        // recorded before the files it imports even though its text is laid
        // down after them.
        if (module_at(p.modules, entry.name_off) == 0) {
            emit_text("frost_rt_test_run(\"")
            emit_string_content(p.src, entry.name_off, entry.name_len)
            emit_text("\", (void(*)(void))mf_")
            frost_rt_emit_int(entry.fn_index)
            emit_text(");\n")
        }
        i = i + 1
    }
    // The summary answers with how many failed, which is what the process
    // exits on.
    emit_text("return (int)frost_rt_test_summary();\n}\n")
}

// ---------------------------------------------------------------------------
// Checks. The compiler answers for its own errors rather than deferring them to
// whatever compiles its output. Every node ever parsed lives in one arena, so a
// linear scan over it reaches every call without walking the tree.
// ---------------------------------------------------------------------------
