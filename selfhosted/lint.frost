// What `frost lint` reports, and it is what the bootstrap's `src/lint.rs`
// reports, in the same words.
//
// Findings, not faults: a build never refuses on one. They are read off the
// tables the passes already fill.

import "core.frost"
import "imports.frost"
import "lexer.frost"
import "names.frost"

export lint_program

// A function nothing reaches.
//
// `main` is a root, and every other name written anywhere but its own
// declaration is reached. Counted over the tokens rather than the syntax,
// because a name is reached in more ways than a call: `$handler` hands a
// function to a generic, a table of function pointers names one, and an export
// list names one. A wrong finding sends a reader to delete working code, so the
// question asked is the conservative one.
lint_program :: fn(mut p: Parser) -> i64 {
    mut found: i64 = 0
    mut index: i64 = 0
    while (index < p.fns.count) {
        sym := arena_at(p.fns, index)
        // The file the command named, which is module 0. Everything below it is
        // a module it imports, and what is unreached there is a finding about
        // that file rather than about this one.
        if (sym.defined == 1 && sym.len > 0
            && module_at(p.modules, sym.off) == 0) {
            // A name a module hands out is reached by whoever imports it, and
            // this program is not the only one that will. Reported, an exported
            // function nothing here calls sent a reader to delete what another
            // program is written against.
            // A function a C caller names is emitted under the name it was
            // written under, and what names it is outside this program. The
            // Frost half of the runtime is written this way, and reported it
            // sends a reader to delete what every program is linked against.
            if (sym.keeps_name == 0
                && mentions_of(p, sym.off, sym.len) <= 1
                && offered_to_importers(p, sym.off, sym.len) == false
                && begins_with(p.src, sym.off, sym.len, "__test") == false
                && str_range_eq(p.src, sym.off, sym.len, "main") == false) {
                report_where(p.modules, p.src, sym.off)
                report("'")
                report_src(p.src, sym.off, sym.len)
                report("' is never called, and nothing names it")
                report_warning_end()
                found = found + 1
            }
        }
        index = index + 1
    }
    found
}

// Whether a module hands this name to whoever imports it.
//
// An export list is blanked out of the source once it has been read, so its
// names are kept in a buffer of their own and the two are compared across the
// pair rather than within one.
offered_to_importers :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut at: i64 = 0
    while (at < p.exports.count) {
        held := arena_at(p.exports, at)
        if (held.len == len
            && same_across(p.export_names, held.off, p.src, off, len)) {
            return true
        }
        at = at + 1
    }
    false
}

same_across :: fn(
    one: str,
    one_off: i64,
    other: str,
    other_off: i64,
    length: i64
) -> bool {
    mut k: i64 = 0
    while (k < length) {
        if (one[one_off + k] != other[other_off + k]) {
            return false
        }
        k = k + 1
    }
    true
}

// A body the compiler names for a `test` block. Nothing calls one; the runner
// does.
begins_with :: fn(src: str, off: i64, len: i64, prefix: str) -> bool {
    wanted := str_len(prefix)
    if (wanted > len) {
        return false
    }
    mut k: i64 = 0
    while (k < wanted) {
        if (src[off + k] != prefix[k]) {
            return false
        }
        k = k + 1
    }
    true
}

// How many times a name is written as an identifier.
mentions_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut count: i64 = 0
    mut index: i64 = 0
    while (index < p.tokens.count) {
        token := arena_at(p.tokens, index)
        if (token.kind == TokenKind::Ident && token.len == len
            && bytes_equal(p.src, token.off, off, len)) {
            count = count + 1
        }
        index = index + 1
    }
    count
}
