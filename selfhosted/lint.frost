// What `frost lint` reports, and it is what the bootstrap's `src/lint.rs`
// reports, in the same words.
//
// Findings, not faults: a build never refuses on one. They are read off the
// tables the passes already fill.

import "core.frost"
import "imports.frost"
import "lexer.frost"
import "names.frost"

export lint_program, nearest_name

// A function nothing reaches.
//
// `main` is a root, and every other name written anywhere but its own
// declaration is reached. Counted over the tokens rather than the syntax,
// because a name is reached in more ways than a call: `$handler` hands a
// function to a generic, a table of function pointers names one, and an export
// list names one. A wrong finding sends a reader to delete working code, so the
// question asked is the conservative one.
lint_program :: fn(mut p: Parser) -> i64 {
    var found: i64 = 0
    var index: i64 = 0
    while (index < p.fns.count) {
        sym := arena_at(p.fns, index)
        if (sym.defined == 1 && sym.len > 0) {
            if (mentions_of(p, sym.off, sym.len) <= 1
                && str_range_eq(p.src, sym.off, sym.len, "main") == false) {
                report_where(p.modules, p.src, sym.off)
                report("'")
                report_src(p.src, sym.off, sym.len)
                report("' is never called, and nothing names it")
                report("\n")
                found = found + 1
            }
        }
        index = index + 1
    }
    found
}

// The declared name nearest to one that is not declared, or -1 when no name is
// near enough or two are equally near. A guess a reader takes without checking
// is worse than no suggestion, so an ambiguous one is withheld.
//
// Answers the index into the symbol table, since the name itself is a range in
// the source.
nearest_name :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    var best: i64 = -1
    var best_distance: i64 = 0
    var ties: i64 = 0
    var index: i64 = 0
    while (index < p.fns.count) {
        sym := arena_at(p.fns, index)
        if (sym.len > 0 && bytes_equal(p.src, sym.off, off, len) == false) {
            held := name_distance(p.src, sym.off, sym.len, off, len)
            // Near enough to be a misspelling rather than a different word.
            if (held * 3 <= len * 2) {
                if (best < 0 || held < best_distance) {
                    best = index
                    best_distance = held
                    ties = 1
                } else if (held == best_distance) {
                    ties = ties + 1
                }
            }
        }
        index = index + 1
    }
    if (ties != 1) {
        return -1
    }
    best
}

// How many single-character edits turn one name into the other.
name_distance :: fn(src: str, a_off: i64, a_len: i64, b_off: i64,
    b_len: i64) -> i64 {
    if (a_len > 64 || b_len > 64) {
        return 999
    }
    var row: [65]i64 = [0; 65]
    var j: i64 = 0
    while (j <= b_len) {
        row[j] = j
        j = j + 1
    }
    var i: i64 = 0
    while (i < a_len) {
        var previous := row[0]
        row[0] = i + 1
        j = 0
        while (j < b_len) {
            var cost: i64 = 1
            if (src[a_off + i] == src[b_off + j]) {
                cost = 0
            }
            replaced := previous + cost
            previous = row[j + 1]
            var best := row[j] + 1
            if (row[j + 1] + 1 < best) {
                best = row[j + 1] + 1
            }
            if (replaced < best) {
                best = replaced
            }
            row[j + 1] = best
            j = j + 1
        }
        i = i + 1
    }
    row[b_len]
}

// How many times a name is written as an identifier.
mentions_of :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    var count: i64 = 0
    var index: i64 = 0
    while (index < p.tokens.count) {
        token := arena_at(p.tokens, index)
        if (token.kind == TokenKind::Ident && token.len == len
            && bytes_equal(p.src, token.off, off, len)) {
            count = count + 1
        }
        index = index + 1
    }
    count
}
