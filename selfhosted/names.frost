// Whether there is room for `wanted` more bytes past the source, said here
// rather than found out by writing over whatever follows the buffer. The room
// is fixed and every synthesized name spends it for good, so a program that
// asks for more than there is has to be told, not left to corrupt itself.
synth_room_for :: fn(mut p: Parser, wanted: i64) {
    if (p.synth_next + wanted < str_len(p.src)) {
        return
    }
    report("frost: the compiler ran out of room for the names it makes up")
    frost_rt_die()
}

// Copy a literal name into the room past the source and answer its offset, for
// a name the compiler needs that no source spells.
synth_literal :: fn(mut p: Parser, word: ^i8) -> i64 {
    synth_room_for(p, cstr_len(word) + 1)
    start := p.synth_next
    length := cstr_len(word)
    mut k: i64 = 0
    while (k < length) {
        p.src[start + k] = cast($u8, byte_at(word, k))
        k = k + 1
    }
    p.src[start + length] = 0
    p.synth_next = start + length + 1
    start
}

digits_in :: fn(number: i64) -> i64 {
    mut value := number
    mut digits: i64 = 1
    while (value >= 10) {
        value = value / 10
        digits = digits + 1
    }
    digits
}

// A name with a number after it, so each `?` and each failure set gets one of
// its own. Its length is the word's plus the number's digits.
synth_numbered :: fn(mut p: Parser, word: ^i8, number: i64) -> i64 {
    start := synth_literal(p, word)
    digits := digits_in(number)
    mut scale: i64 = 1
    mut left: i64 = 1
    while (left < digits) {
        scale = scale * 10
        left = left + 1
    }
    mut value := number
    mut written: i64 = 0
    while (written < digits) {
        digit := value / scale
        p.src[p.synth_next - 1 + written] = cast($u8, CH_0 + digit)
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    p.src[p.synth_next - 1 + digits] = 0
    p.synth_next = p.synth_next + digits
    start
}

// Two source names joined by an underscore, for a field that belongs to one
// variant of an enum: `Enemy` and `damage` become `Enemy_damage`. Two variants
// may each carry a `damage` and they stay apart.
synth_join :: fn(
    mut p: Parser,
    first_off: i64,
    first_len: i64,
    second_off: i64,
    second_len: i64
) -> i64 {
    synth_room_for(p, first_len + second_len + 2)
    start := p.synth_next
    mut k: i64 = 0
    while (k < first_len) {
        p.src[start + k] = p.src[first_off + k]
        k = k + 1
    }
    p.src[start + first_len] = CH_UNDERSCORE
    k = 0
    while (k < second_len) {
        p.src[start + first_len + 1 + k] = p.src[second_off + k]
        k = k + 1
    }
    p.src[start + first_len + 1 + second_len] = 0
    p.synth_next = start + first_len + second_len + 2
    start
}

// The binding a `uses Arena` function draws: the capability type's name with
// its first letter lowercased, so `uses Arena<256>` binds `arena` and the body
// names it the way the caller's `with arena` block does.
synth_capability_name :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    start := p.synth_next
    mut k: i64 = 0
    while (k < len) {
        mut byte := p.src[off + k]
        if (k == 0 && byte >= CH_UPPER_A && byte <= CH_UPPER_Z) {
            byte = byte + 32
        }
        p.src[start + k] = byte
        k = k + 1
    }
    p.src[start + len] = 0
    p.synth_next = start + len + 1
    start
}

// The same comparison across two buffers, for a name kept somewhere other than
// the source it was read from.
bytes_equal_across :: fn(
    first: str,
    first_off: i64,
    second: str,
    second_off: i64,
    length: i64
) -> bool {
    mut k: i64 = 0
    while (k < length) {
        if (first[first_off + k]
            != second[second_off + k]) {
            return false
        }
        k = k + 1
    }
    true
}

bytes_equal :: fn(src: str, first: i64, second: i64, length: i64) -> bool {
    mut k: i64 = 0
    while (k < length) {
        if (src[first + k] != src[second + k]) {
            return false
        }
        k = k + 1
    }
    true
}

// A name the program declares and the file naming it cannot reach.
//
// Saying such a name is not there is false, and a reader who believes it writes
// the declaration a second time instead of adding one word to an export line.
// Answered before the nearest name, since the nearest name to a name that
// exists is itself.
report_declared_elsewhere :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    mut i: i64 = 0
    while (i < p.declared.count) {
        entry := arena_at(p.declared, i)
        if (entry.len == len && bytes_equal(p.src, entry.off, off, len)) {
            held := arena_at(p.modules, entry.module)
            // By file name. What a module is called otherwise depends on where
            // the build was started from, and this sentence is compared word
            // for word.
            report(" (declared in ")
            report_cstr(file_name(held.name))
            report("; add it to the export line there)")
            return true
        }
        i = i + 1
    }
    false
}

// One number for the bytes of a name.
fn_name_hash :: fn(src: str, off: i64, len: i64) -> i64 {
    mut sum: i64 = len + 1
    mut k: i64 = 0
    while (k < len) {
        sum = wrap_add(wrap_mul(sum, 33), src[off + k])
        k = k + 1
    }
    sum & 4611686018427387903
}

// File one function under its name. The slot is the first free one at or after
// where the name hashes to, so everything written under one name lies between
// there and the next free slot.
fn_names_place :: fn(mut p: Parser, index: i64) {
    entry := arena_at(p.fns, index)
    cap := p.fn_names.count
    mut at := fn_name_hash(p.src, entry.off, entry.len) % cap
    while (arena_at(p.fn_names, at).at == 1) {
        at = at + 1
        if (at == cap) {
            at = 0
        }
    }
    arena_at(p.fn_names, at).at = 1
    arena_at(p.fn_names, at).mark = index
}

// Every function declared so far, filed. Kept under half full, so a walk from
// where a name hashes to always reaches a free slot and stops.
fn_names_sync :: fn(mut p: Parser) {
    wanted := p.fns.count * 2 + 64
    if (p.fn_names.count < wanted) {
        mut cap: i64 = 1024
        while (cap < wanted) {
            cap = cap * 2
        }
        p.fn_names.count = 0
        mut k: i64 = 0
        while (k < cap) {
            arena_push(p.fn_names, InstanceSlot { at = 0, mark = -1 })
            k = k + 1
        }
        p.fn_names_upto = 0
    }
    while (p.fn_names_upto < p.fns.count) {
        fn_names_place(p, p.fn_names_upto)
        p.fn_names_upto = p.fn_names_upto + 1
    }
}

// The functions written under this name, in the order they were declared.
//
// Declaration order is what the answer turns on: which of two functions a name
// reaches is the one written first, and a refusal that names two modules names
// them in that order. The walk gives that order without sorting for it. Two
// functions of one name hash to one slot, each is filed in the first free slot
// at or after it, and so the one filed first is always the nearer of the two to
// where the walk starts. A rebuild files them by index, which is that order
// again.
// The answer lands in `p.fn_name_hits`, which the caller reads. One list serves
// every caller because no lookup runs inside another: reading a name weighs
// visibility and which module wrote it, and neither of those reads a name.
fn_names_matching :: fn(mut p: Parser, off: i64, len: i64) {
    p.fn_name_hits.count = 0
    fn_names_sync(p)
    cap := p.fn_names.count
    if (cap == 0) {
        return
    }
    mut at := fn_name_hash(p.src, off, len) % cap
    while (arena_at(p.fn_names, at).at == 1) {
        held := arena_at(p.fn_names, at).mark
        entry := arena_at(p.fns, held)
        if (entry.len == len && bytes_equal(p.src, entry.off, off, len)) {
            arena_push(p.fn_name_hits, InstanceSlot { at = held, mark = 0 })
        }
        at = at + 1
        if (at == cap) {
            at = 0
        }
    }
}

intern_global :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    // A `$f` parameter stands for the function the call site passed, so inside
    // an instance the name resolves to that function and nothing is looked up.
    supplied := fn_binding_of(p, offset, length)
    if (supplied >= 0) {
        return supplied
    }
    // A renamed import is looked up under the name the module declares, and
    // only in that module.
    mut sought_off := offset
    mut sought_len := length
    mut wanted: i64 = -1
    held := rename_for(p, offset, length)
    if (held >= 0) {
        entry := arena_at(p.renames, held)
        sought_off = entry.exported_off
        sought_len = entry.exported_len
        wanted = entry.imported
    }
    fn_names_matching(p, sought_off, sought_len)
    mut i: i64 = 0
    mut found: i64 = -1
    while (i < p.fn_name_hits.count) {
        index := arena_at(p.fn_name_hits, i).at
        entry := arena_at(p.fns, index)
        if (name_visible(p, entry.off, entry.len, offset)
            && (wanted < 0 || module_at(p.modules, entry.off) == wanted)) {
            if (found < 0) {
                found = index
                // Nothing else can match unless two modules in this program
                // export the same name, so the rest of the scan is skipped in
                // every program that does not.
                if (p.shared_exports == 0) {
                    return found
                }
            } else {
                // Two modules this file imports both offer the name, and it
                // wrote the name, so there is no answer to give.
                held := arena_at(p.fns, found)
                report_where(p.modules, p.src, offset)
                report("'")
                report_src(p.src, offset, length)
                report("' is exported by two modules this file imports, ")
                // By file name. What either compiler calls a module otherwise
                // depends on where the build was started from, and this
                // sentence is compared word for word.
                first := arena_at(p.modules, module_at(p.modules, held.off))
                report_cstr(file_name(first.name))
                report(" and ")
                second := arena_at(p.modules, module_at(p.modules, entry.off))
                report_cstr(file_name(second.name))
                report("; read one of them under another name with `import \"...\" (")
                report_src(p.src, offset, length)
                report(" as ...)`")
                frost_rt_die()
            }
        }
        i = i + 1
    }
    if (found >= 0) {
        return found
    }
    arena_push(
        p.fns,
        Sym {
            off = offset,
            len = length,
            is_extern = 0,
            is_safe = 0,
            is_inline = 0,
            keeps_name = 0,
            ret_type = TY_I64,
            params = -1,
            defined = 0,
            call_faulted = 0,
            cap_start = 0,
            cap_count = 0
        },
    )
}

// A name becomes defined when its `fn` or `extern fn` is parsed. A name that is
// only ever called is interned but never defined, which is a call to a function
// that does not exist.
mark_defined :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.defined = 1
}

mark_extern :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_extern = 1
}

// The declaration turned out to carry a body, so this name is not a C library's
// after all: it is written here and only its spelling is C's.
clear_extern :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_extern = 0
}

// `extern fn` with a body: written here, and emitted under the name it was
// written under so a C caller finds it.
mark_keeps_name :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.keeps_name = 1
}

// `safe extern fn`: the author vouched for this one, so its calls are not gated.
mark_safe :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_safe = 1
}

// `inline fn`: the C backend qualifies the definition so it is always folded in.
mark_inline :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_inline = 1
}

set_ret_type :: fn(mut p: Parser, fn_index: i64, ret: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.ret_type = ret
}

set_params :: fn(mut p: Parser, fn_index: i64, params: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.params = params
}

// Record one more capability for a function. They are pushed in the order they
// were declared, so a function's run is contiguous and its first push is what
// fixes where the run starts.
set_uses :: fn(mut p: Parser, fn_index: i64, ty: i64, off: i64, len: i64) {
    start := arena_push(p.caps, Cap { ty = ty, off = off, len = len })
    entry := arena_at(p.fns, fn_index)
    if (entry.cap_count == 0) {
        entry.cap_start = start
    }
    entry.cap_count = entry.cap_count + 1
}

// The nth capability a function draws.
cap_at :: fn(mut p: Parser, fn_index: i64, index: i64) -> Cap {
    sym := arena_at(p.fns, fn_index)
    held := arena_at(p.caps, sym.cap_start + index)
    Cap { ty = held.ty, off = held.off, len = held.len }
}

cap_count_of :: fn(mut p: Parser, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    sym.cap_count
}

node_next :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    node.next
}

append_node :: fn(mut p: Parser, head: i64, extra: i64) -> i64 {
    if (head == (-1)) {
        return extra
    }
    mut tail := head
    mut following := node_next(p, tail)
    while (following != (-1)) {
        tail = following
        following = node_next(p, tail)
    }
    set_next(p, tail, extra)
    head
}

record_generic_fn :: fn(
    mut p: Parser,
    fn_index: i64,
    tparam_off: i64,
    tparam_len: i64,
    tparam_is_value: i64,
    tparam_is_fn: i64,
    tparam_is_slot: i64,
    xparam_start: i64,
    xparam_count: i64,
    token_start: i64,
    bound_token: i64,
    pack_off: i64,
    pack_len: i64,
    pack_fixed: i64,
    pack_format: i64,
    format_off: i64,
    format_len: i64
) {
    // Read here rather than handed in. The symbol's return type is the
    // template's until an instance is parsed and rewrites it, and nothing has
    // been parsed for this one yet, so this is the last moment the declared
    // shape can be read off it.
    template_ret := arena_at(p.fns, fn_index).ret_type
    tparam_fallback := p.tparam_fallback
    arena_push(
        p.generic_fns,
        GenericFn {
            fn_index = fn_index,
            tparam_off = tparam_off,
            tparam_len = tparam_len,
            tparam_is_value = tparam_is_value,
            tparam_is_fn = tparam_is_fn,
            tparam_is_slot = tparam_is_slot,
            xparam_start = xparam_start,
            xparam_count = xparam_count,
            token_start = token_start,
            bound_token = bound_token,
            pack_off = pack_off,
            pack_len = pack_len,
            pack_fixed = pack_fixed,
            pack_format = pack_format,
            format_off = format_off,
            format_len = format_len,
            template_ret = template_ret,
            tparam_fallback = tparam_fallback
        },
    )
}

// The name a compile-time list's nth element takes: the list's own name, two
// underscores and the position. It is a name the body can be read against and a
// parameter the call fills once.
pack_element_name :: fn(
    mut p: Parser,
    off: i64,
    len: i64,
    index: i64
) -> (start: i64, length: i64) {
    start := p.synth_next
    mut k: i64 = 0
    while (k < len) {
        p.src[start + k] = p.src[off + k]
        k = k + 1
    }
    p.src[start + len] = CH_UNDERSCORE
    p.src[start + len + 1] = CH_UNDERSCORE
    digits := digits_in(index)
    mut scale: i64 = 1
    mut left: i64 = 1
    while (left < digits) {
        scale = scale * 10
        left = left + 1
    }
    mut value := index
    mut written: i64 = 0
    while (written < digits) {
        digit := value / scale
        p.src[start + len + 2 + written] = cast($u8, CH_0 + digit)
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    total := len + 2 + digits
    p.src[start + total] = 0
    p.synth_next = start + total + 1
    return start, total
}

// Bind one name to another while a body is read again, and answer the height to
// restore afterwards.
push_alias :: fn(
    mut p: Parser,
    from_off: i64,
    from_len: i64,
    to_off: i64,
    to_len: i64
) -> i64 {
    mark := p.aliases.count
    arena_push(
        p.aliases,
        Alias {
            from_off = from_off,
            from_len = from_len,
            to_off = to_off,
            to_len = to_len
        }
    )
    mark
}

// The name in force for a name being read, following the aliases a compile-time
// `for` put there. The most recent wins, so a nested loop shadows an outer one.
alias_for :: fn(
    mut p: Parser,
    off: i64,
    len: i64
) -> (start: i64, length: i64) {
    mut i: i64 = p.aliases.count
    while (i > p.alias_floor) {
        i = i - 1
        held := arena_at(p.aliases, i)
        if (held.from_len == len
            && bytes_equal(p.src, held.from_off, off, len)) {
            return held.to_off, held.to_len
        }
    }
    return off, len
}

// Register `name :: value` in the constant table. Duplicate names are harmless
// since lookup takes the first.
register_const :: fn(mut p: Parser, offset: i64, length: i64, value: i64) {
    arena_push(
        p.consts,
        ConstDef {
            name_off = offset,
            name_len = length,
            value = value,
            kind = CONST_INT,
            count = 0
        },
    )
}

// Refuse a declaration whose name the compiler already owns.
//
// A compiler name means one thing wherever it is written, and a program that
// declares one gave a second meaning to a spelling nothing distinguishes. The
// two compilers answered differently: the bootstrap let the declaration win and
// said nothing, and this one kept reading the name as its own, so `slice_len(4)`
// was a call there and a length here. Refused where it is written, so the reader
// is told at the declaration rather than at a call that behaves oddly.
check_name_is_not_the_compiler_s :: fn(mut p: Parser, off: i64, len: i64) {
    if (is_compiler_name(p, off, len) == false) {
        return
    }
    report_where(p.modules, p.src, off)
    report("'")
    report_src(p.src, off, len)
    report("' is the compiler's own, and a name means one thing wherever it ")
    report("is written; call it something else")
    // Recovered rather than ended, so a file that names two of them is told
    // about both. The declaration this stands at is abandoned either way.
    frost_rt_recover_escape()
}

// The names the compiler reads as its own wherever they are called. Held here
// as a list rather than found by asking each reader, since what makes them
// reserved is that a program may not declare one, and that question is asked in
// one place.
is_compiler_name :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "alignof")
        || str_range_eq(p.src, off, len, "assert")
        || str_range_eq(p.src, off, len, "cast")
        || str_range_eq(p.src, off, len, "flags_has")
        || str_range_eq(p.src, off, len, "live_slots")
        || str_range_eq(p.src, off, len, "ptr_cast")
        || str_range_eq(p.src, off, len, "ptr_to")
        || str_range_eq(p.src, off, len, "sizeof")
        || str_range_eq(p.src, off, len, "slice_from")
        || str_range_eq(p.src, off, len, "slice_len")
        || str_range_eq(p.src, off, len, "str_len")
        || str_range_eq(p.src, off, len, "TARGET_LINUX")
        || str_range_eq(p.src, off, len, "TARGET_MACOS")
        || str_range_eq(p.src, off, len, "TARGET_WINDOWS")
        || str_range_eq(p.src, off, len, "type_id")
        || str_range_eq(p.src, off, len, "typename")
        || str_range_eq(p.src, off, len, "wrap_add")
        || str_range_eq(p.src, off, len, "wrap_mul")
        || str_range_eq(p.src, off, len, "wrap_sub"))
}

// Refuse a declaration whose name one of this module's imports already offers.
//
// The namespace is flat, so two declarations of one name are two things called
// the same thing and there is no qualifying one of them. The name interns to one
// symbol, so both bodies were emitted under it and what caught that was whichever
// assembler or C compiler read the output. The way out is to rename one of them,
// or to read the import under another name.
//
// Asked where the declaration is made, since by the time the program is parsed
// the two have become one symbol and there is nothing left to compare.
check_name_is_free :: fn(mut p: Parser, off: i64, len: i64) {
    check_name_is_not_the_compiler_s(p, off, len)
    owner := module_at(p.modules, off)
    if (owner < 0) {
        return
    }
    check_name_is_not_declared_twice(p, owner, off, len)
    mut i: i64 = 0
    while (i < p.exports.count) {
        entry := arena_at(p.exports, i)
        module := entry.module
        entry_off := entry.off
        entry_len := entry.len
        if (module != owner && entry_len == len
            && bytes_equal_across(p.export_names, entry_off, p.src, off, len)
            && imports_module(p, owner, module)
            && renamed_away(p, owner, off, len) == false) {
            report_where(p.modules, p.src, off)
            report("'")
            report_src(p.src, off, len)
            report("' is declared here and also arrives from an import; rename one of them, or read the import under another name with `import \"...\" (")
            report_src(p.src, off, len)
            report(" as ...)`")
            frost_rt_recover_escape()
        }
        i = i + 1
    }
}

// Refuse a name this file has already declared.
//
// The namespace is flat, so two declarations of one name are two things called
// the same thing and nothing tells them apart at a use. Every table is asked,
// since the two need not be the same kind of declaration, and only what stands
// earlier in the file counts, so the second one is what the reader is told
// about and the pair is named once.
check_name_is_not_declared_twice :: fn(
    mut p: Parser,
    owner: i64,
    off: i64,
    len: i64
) {
    // An entry at this very offset is this declaration seen again, which is
    // what a generic function is: its body is parsed once where it is written
    // and once more for every instance a call asks for.
    //
    // Only what stands earlier in the file is a report, so the pair is named
    // once and at the second of the two. Some declarations are recorded by a
    // pass that runs before the parse, so the table holds names from further
    // down by the time one above them is read.
    mut seen: i64 = 0
    mut i: i64 = 0
    while (i < p.declared.count) {
        entry := arena_at(p.declared, i)
        if (entry.module == owner && entry.len == len
            && bytes_equal(p.src, entry.off, off, len)) {
            if (entry.off == off) {
                seen = 1
            } else if (entry.off < off) {
                report_declared_twice(p, off, len)
            }
        }
        i = i + 1
    }
    if (seen == 0) {
        arena_push(p.declared, Export { module = owner, off = off, len = len })
    }
}

report_declared_twice :: fn(mut p: Parser, off: i64, len: i64) {
    report_where(p.modules, p.src, off)
    report("'")
    report_src(p.src, off, len)
    report("' is declared twice here, and a name means one thing wherever it ")
    report("is written; rename one of them")
    frost_rt_recover_escape()
}

// Whether this module read that name under another one, which is what keeps both
// and is the way out the diagnostic names. A rename's two names live in the
// source buffer by the time the parser runs.
renamed_away :: fn(mut p: Parser, importer: i64, off: i64, len: i64) -> bool {
    mut i: i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        if (entry.importer == importer && entry.exported_len == len
            && bytes_equal(p.src, entry.exported_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// Whether a declaration whose name sits at `decl_off` may be named from
// `use_off`. A file's own names are its own to use. Another file's are only
// what it exported. The declaration's offset is what says which file wrote it,
// so no table has to carry an owner.
//
// A program compiled from one file has one module and every name is in it, so
// this answers true on the first comparison and costs nothing.
name_visible :: fn(mut p: Parser, decl_off: i64, decl_len: i64, use_off: i64)
    -> bool {
    owner := module_at(p.modules, decl_off)
    user := module_at(p.modules, use_off)
    if (owner == user) {
        return true
    }
    // An import says what a file may name. A module the file did not import
    // has nothing to offer it, however the name got into the program.
    if (imports_module(p, user, owner) == false) {
        return false
    }
    mut i: i64 = 0
    while (i < p.exports.count) {
        entry := arena_at(p.exports, i)
        if (entry.module == owner && entry.len == decl_len
            && bytes_equal_across(
                p.export_names,
                entry.off,
                p.src,
                decl_off,
                decl_len
            )) {
            return true
        }
        i = i + 1
    }
    false
}

// Move each rename's two names into the source buffer, where every name lives
// once the parser is running. They were copied out of the import line before it
// was blanked.
place_renames :: fn(mut p: Parser, held: str) {
    mut i: i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        local_len := entry.local_len
        exported_len := entry.exported_len
        local_from := entry.local_off
        exported_from := entry.exported_off
        local_at := p.synth_next
        copy_name(p.src, local_at, held, local_from, local_len)
        p.src[local_at + local_len] = 0
        exported_at := local_at + local_len + 1
        copy_name(p.src, exported_at, held, exported_from, exported_len)
        p.src[exported_at + exported_len] = 0
        p.synth_next = exported_at + exported_len + 1
        moved := arena_at(p.renames, i)
        moved.local_off = local_at
        moved.exported_off = exported_at
        i = i + 1
    }
}

// The rename a file wrote for a name it is using, or -1. A file reads a name
// under whatever it called it, and the module it came from is pinned, so two
// imports offering the same name stay apart.
rename_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.renames.count == 0) {
        return -1
    }
    user := module_at(p.modules, offset)
    mut i: i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        if (entry.importer == user && entry.local_len == length
            && bytes_equal(p.src, entry.local_off, offset, length)) {
            return i
        }
        i = i + 1
    }
    -1
}

// Whether one module imports another directly. A file compiled on its own has
// no modules recorded and no edges, and everything in it belongs to the root,
// which the caller has already answered for.
imports_module :: fn(mut p: Parser, importer: i64, imported: i64) -> bool {
    mut i: i64 = 0
    while (i < p.import_edges.count) {
        edge := arena_at(p.import_edges, i)
        if (edge.importer == importer && edge.imported == imported) {
            return true
        }
        i = i + 1
    }
    false
}

// If a name is a declared constant, return its value through `out` (as the
// return) and true, otherwise false. Consts are looked up by byte comparison.
const_value :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.consts.count) {
        entry := arena_at(p.consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

// The node a struct constant's literal parsed to, or -1 for a name that is not
// one. A struct constant is its value wherever it is named, so every use writes
// that node out again rather than referring to storage somewhere.
// Where the declaration of a value constant writes its name. Two calls naming
// one constant write it at two offsets, and what tells one constant from another
// has to be the constant rather than the occurrence.
value_const_name_off :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.value_consts.count) {
        entry := arena_at(p.value_consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return entry.name_off
        }
        i = i + 1
    }
    -1
}

value_const_node :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.value_consts.count) {
        entry := arena_at(p.value_consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

is_const :: fn(mut p: Parser, offset: i64, length: i64) -> bool {
    mut i: i64 = 0
    while (i < p.consts.count) {
        entry := arena_at(p.consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return true
        }
        i = i + 1
    }
    false
}

is_main_name :: fn(src: str, offset: i64, length: i64) -> bool {
    if (length != 4) {
        return false
    }
    (src[offset] == 109 && src[offset + 1] == 97
        && src[offset + 2] == 105
        && src[offset + 3] == 110)
}

// ---------------------------------------------------------------------------
// Parsing.
// ---------------------------------------------------------------------------

// Where a node is, for a diagnostic to point at.
//
// The plain forms stamp where the cursor is now, which is after the node's
// children have been read, so a node built out of anything carries the offset
// of the token past it. That is why every diagnostic this compiler wrote landed
// one construct late: an error about a binding on line five was reported at the
// statement on line eight.
//
// The `_at` forms take the offset instead, and a parser that builds a node out
// of children captures it before reading them. The plain forms stay for the
// nodes with no children, where now and the start are the same place.
new_node_at :: fn(
    mut p: Parser,
    kind: NodeKind,
    a: i64,
    b: i64,
    val: i64,
    at: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = kind,
            a = a,
            b = b,
            c = 0,
            val = val,
            next = -1,
            pos = at
        },
    )
}

new_node :: fn(mut p: Parser, kind: NodeKind, a: i64, b: i64, val: i64) -> i64 {
    held := cur_off(p)
    new_node_at(p, kind, a, b, val, held)
}

// A node that names a local by its source byte range: `val` is the offset and
// `c` is the length, so code generation re-emits the identifier text directly.
// This is what lets locals become named C variables instead of `v[]` slots.
new_named_node_at :: fn(
    mut p: Parser,
    kind: NodeKind,
    child: i64,
    offset: i64,
    length: i64,
    at: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = kind,
            a = child,
            b = 0,
            c = length,
            val = offset,
            next = -1,
            pos = at
        },
    )
}

new_named_node :: fn(
    mut p: Parser,
    kind: NodeKind,
    child: i64,
    offset: i64,
    length: i64
) -> i64 {
    held := cur_off(p)
    new_named_node_at(p, kind, child, offset, length, held)
}

// A local binding. `b` carries the annotated type, or -1 to infer the type from
// the initializer. An annotation wins where the initializer alone does not pin
// the type down, as a value read back at a narrower type than it was stored.
new_let_node :: fn(
    mut p: Parser,
    value: i64,
    offset: i64,
    length: i64,
    annotation: i64
) -> i64 {
    arena_push(
        p.arena,
    // The name it binds, which is where the binding is. The cursor is past
    // the whole statement by now, since the value has been read.
        Node { kind = NodeKind::Let, a = value, b = annotation, c = length,
            val = offset, next = -1, pos = offset },
    )
}

new_func_node :: fn(
    mut p: Parser,
    body: i64,
    params: i64,
    fn_index: i64,
    is_main: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Func,
            a = body,
            b = params,
            c = is_main,
            val = fn_index,
            next = -1,
            pos = cur_off(p),
        },
    )
}

set_next :: fn(mut p: Parser, id: i64, next_id: i64) {
    node := arena_at(p.arena, id)
    node.next = next_id
}

// A field access `base.name`: `a` is the base expression, `val`/`c` the field
// name's byte range.
new_field_node :: fn(
    mut p: Parser,
    base: i64,
    offset: i64,
    length: i64
) -> i64 {
    // Where the access is written, which is where its base is. Read off the
    // parser instead, it named the token after the field name, so a report
    // about reaching a field landed past the expression holding it: for the
    // last one in a body, on the closing brace.
    mut at := cur_off(p)
    if (base >= 0 && base < p.arena.count) {
        at = arena_at(p.arena, base).pos
    }
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Field,
            a = base,
            b = 0,
            c = length,
            val = offset,
            next = -1,
            pos = at
        },
    )
}

// A struct literal `Name { ... }`: `val` is the struct's table index and `a` is
// the head of a linked list of NodeKind::FieldInit nodes.
new_struct_lit :: fn(
    mut p: Parser,
    struct_index: i64,
    inits: i64,
    at: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::StructLit,
            a = inits,
            b = 0,
            c = 0,
            val = struct_index,
            next = -1,
            pos = at
        },
    )
}

// One `name = value` inside a struct literal: `a` is the value, `val`/`c` the
// field name's byte range, `next` the following initializer.
new_field_init :: fn(
    mut p: Parser,
    value: i64,
    offset: i64,
    length: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::FieldInit,
            a = value,
            b = 0,
            c = length,
            val = offset,
            next = -1,
            pos = cur_off(p)
        },
    )
}

set_field_next :: fn(mut p: Parser, id: i64, next_id: i64) {
    field := arena_at(p.fields, id)
    field.next = next_id
}

// A `distinct` type, a name of its own for another type's representation.
is_distinct :: fn(ty: i64) -> bool {
    ty >= DISTINCT_BASE
}

// What a distinct type is represented by, which is what everything but the
// identity check wants: its size, its alignment, how it travels to C, and which
// register it goes in. Anything else answers with itself, so this can sit at the
// front of every type predicate.
distinct_repr :: fn(ty: i64) -> i64 {
    if (ty < DISTINCT_BASE) {
        return ty
    }
    (ty - DISTINCT_BASE) / DISTINCT_STRIDE
}

// Whether a type code is a set of bits rather than an ordinary distinct type.
// The bit table is the only record of the difference, so this asks it. A
// program has a handful of these, and the answer is wanted only where a flags
// type could be one of the operands.
is_flags_type :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_distinct(ty) == false) {
        return false
    }
    mut i: i64 = 0
    while (i < p.flag_bits.count) {
        entry := arena_at(p.flag_bits, i)
        if (entry.ty == ty) {
            return true
        }
        i = i + 1
    }
    false
}

// The number a bit of `ty` stands for, or -1 when the type names no such bit.
flag_bit_value :: fn(mut p: Parser, ty: i64, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.flag_bits.count) {
        entry := arena_at(p.flag_bits, i)
        if (entry.ty == ty && entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

// Where in the table the bit of `ty` holding `value` sits, or -1 when the type
// names no bit holding it. A set names each of its bits a number of its own,
// and this is what a declaration asks to find out.
flag_bit_holding :: fn(mut p: Parser, ty: i64, value: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.flag_bits.count) {
        entry := arena_at(p.flag_bits, i)
        if (entry.ty == ty && entry.value == value) {
            return i
        }
        i = i + 1
    }
    -1
}

record_flag_bit :: fn(mut p: Parser, ty: i64, off: i64, len: i64, value: i64) {
    arena_push(
        p.flag_bits,
        FlagBit { ty = ty, name_off = off, name_len = len, value = value }
    )
}

// Where in the table the value `ty` names by (off, len) sits, or -1 when the
// type names no such value. The index rather than the entry, since the pass
// that reads the values writes the node back into it.
type_value_index :: fn(mut p: Parser, ty: i64, off: i64, len: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.type_values.count) {
        entry := arena_at(p.type_values, i)
        if (entry.ty == ty && entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return i
        }
        i = i + 1
    }
    -1
}

// Whether a type names any values under itself, which is what says a name it
// does not name is a value that is missing rather than a variant.
names_values :: fn(mut p: Parser, ty: i64) -> bool {
    mut i: i64 = 0
    while (i < p.type_values.count) {
        entry := arena_at(p.type_values, i)
        if (entry.ty == ty) {
            return true
        }
        i = i + 1
    }
    false
}

record_type_value :: fn(
    mut p: Parser,
    ty: i64,
    off: i64,
    len: i64,
    token: i64
) {
    arena_push(
        p.type_values,
        TypeValue {
            ty = ty,
            name_off = off,
            name_len = len,
            token = token,
            node = -1
        }
    )
}

// The identity half: which declaration this is. Two distinct types over the
// same representation differ only here.
distinct_id :: fn(ty: i64) -> i64 {
    (ty - DISTINCT_BASE) % DISTINCT_STRIDE
}

// The code for the `index`th distinct type declared in this program, over
// `repr`. A distinct type over a distinct type is represented by what the inner
// one is represented by, so the representation stored is never itself distinct
// and no lookup ever has to walk a chain.
distinct_type :: fn(repr: i64, index: i64) -> i64 {
    DISTINCT_BASE + distinct_repr(repr) * DISTINCT_STRIDE + index
}

// Say a type the way the source writes it, for a diagnostic. One walk decides
// what a type is called and `write_type_name` is it; this says what that walk
// wrote. A second walk that reported as it went is what let the two drift about
// whether an array carries its length.
report_type_name :: fn(mut p: Parser, ty: i64) {
    start := p.synth_next
    off, len := synth_type_name(p, ty)
    report_src(p.src, off, len)
    // The name was wanted only to say it. Winding back keeps a run of reports
    // from eating the room the compiler makes up names in.
    p.synth_next = start
}

// A type's name as text in the room past the source, which is what `typename`
// answers with, and what a report says. One walk writes it, so nothing can
// drift about what a type is called.
synth_type_name :: fn(mut p: Parser, ty: i64) -> (off: i64, len: i64) {
    start := p.synth_next
    write_type_name(p, ty)
    length := p.synth_next - start
    p.src[p.synth_next] = 0
    p.synth_next = p.synth_next + 1
    return start, length
}

// The name of the enum a `-> T ! E` signature makes: one per `(T, E)`, named
// the way any generic's instance is. Distinct pairs get distinct names, which
// is what keeps two failure sets in one program two types.
synth_result_name :: fn(
    mut p: Parser,
    ok: i64,
    bad: i64
) -> (off: i64, len: i64) {
    start := p.synth_next
    synth_bytes(p, "Result<")
    write_type_name(p, ok)
    synth_bytes(p, ", ")
    write_type_name(p, bad)
    synth_bytes(p, ">")
    length := p.synth_next - start
    p.src[p.synth_next] = 0
    p.synth_next = p.synth_next + 1
    return start, length
}

// The name a reader writes to reach a value under a type. A generic enum is
// reached by its base name, with the arguments coming from what the context
// expects, the way `Option::Some` reaches an `Option<i64>`. Naming the instance
// would spell out an edit that does not parse.
report_base_type_name :: fn(mut p: Parser, ty: i64) {
    start := p.synth_next
    off, len := synth_type_name(p, ty)
    mut cut: i64 = 0
    while (cut < len && cast($i64, p.src[off + cut]) != CH_LT) {
        cut = cut + 1
    }
    report_src(p.src, off, cut)
    // Wound back for the reason `report_type_name` winds back: the name was
    // wanted only to say it.
    p.synth_next = start
}

// The same name as text, so a message naming a type puts it in a hole like any
// other value. It is written into the room past the source and read back from
// there, which is where `typename` leaves one too.
type_text :: fn(mut p: Parser, ty: i64) -> str {
    off, len := synth_type_name(p, ty)
    source_text(p.src, off, len)
}

// A generic struct's instance as the reader wrote it: the template's name and
// the arguments it was made for. A concrete struct was made for none and is its
// own name. A rule about `Slab<Node, 2>` is about that one, and naming the
// template says it of every instance including the ones that are fine.
instance_text :: fn(mut p: Parser, struct_ty: i64) -> str {
    start := p.synth_next
    write_instance_name(p, struct_ty)
    length := p.synth_next - start
    p.src[p.synth_next] = 0
    p.synth_next = p.synth_next + 1
    source_text(p.src, start, length)
}

// The same name written into the room past the source without a terminator
// after it, so a walk that is part way through a larger name can use it.
write_instance_name :: fn(mut p: Parser, struct_ty: i64) {
    index := struct_index_of(struct_ty)
    mut found: i64 = -1
    mut i: i64 = 0
    while (i < p.instances.count) {
        held := arena_at(p.instances, i)
        if (held.struct_index == index) {
            found = i
            i = p.instances.count
            continue
        }
        i = i + 1
    }
    // The template's name, which is what the reader wrote before the `<`. An
    // instance carries a name this compiler chose, and a container built out
    // of the element's own fields is named after the element: a
    // `columns<Session, 4>` read that way came out as `Session<Session>`.
    mut named := index
    mut of_columns: bool = false
    if (found >= 0) {
        held := arena_at(p.instances, found).generic_index
        if (held == COLUMNS_OF) {
            of_columns = true
        }
        if (held >= 0) {
            named = held
        }
    }
    // A columns container is asked for by a word rather than declared as a
    // template, so there is no entry holding its name.
    if (of_columns) {
        synth_bytes(p, "columns")
        made := arena_at(p.instances, found)
        synth_bytes(p, "<")
        write_argument_name(p, made.arg)
        synth_bytes(p, ", ")
        synth_digits(
            p,
            array_length(p, slab_field_type(p, struct_ty, "generations"))
        )
        synth_bytes(p, ">")
        return
    }
    def := arena_at(p.structs, named)
    synth_range(p, def.name_off, def.name_len)
    if (found >= 0) {
        made := arena_at(p.instances, found)
        synth_bytes(p, "<")
        write_argument_name(p, made.arg)
        mut k: i64 = 0
        while (k < made.xarg_count) {
            garg := arena_at(p.gargs, made.xarg_start + k)
            synth_bytes(p, ", ")
            write_argument_name(p, garg.value)
            k = k + 1
        }
        synth_bytes(p, ">")
    }
}

// One argument of an instance. A number stands for itself, a name that is a
// constant or a function for that name, and a type for its own name, which is
// what tells `Slab<Node, 2>` from `Slab<Node, Two>` and
// `Map<Mask, i64, mask_keys>` from the same table hashed another way.
write_argument_name :: fn(mut p: Parser, value: i64) {
    if (value >= FN_BASE) {
        entry := arena_at(p.fns, value - FN_BASE)
        synth_range(p, entry.off, entry.len)
        return
    }
    if (value >= CONST_BASE && value < PROC_BASE) {
        synth_digits(p, value - CONST_BASE)
        return
    }
    write_type_name(p, value)
}

// A place as the reader wrote it: `h`, `h.file`, `run[0]`, `h^.file`. A rule
// about a place is about that place and not about the name it starts from, so a
// message that named the root said the wrong thing was moved.
place_text :: fn(mut p: Parser, id: i64) -> str {
    start := p.synth_next
    write_place_name(p, id)
    length := p.synth_next - start
    p.src[p.synth_next] = 0
    p.synth_next = p.synth_next + 1
    source_text(p.src, start, length)
}

write_place_name :: fn(mut p: Parser, id: i64) {
    if (id < 0) {
        return
    }
    node := arena_at(p.arena, id)
    if (node.kind == NodeKind::Var) {
        synth_range(p, node.val, node.c)
        return
    }
    if (node.kind == NodeKind::Field) {
        write_place_name(p, node.a)
        synth_bytes(p, ".")
        synth_range(p, node.val, node.c)
        return
    }
    if (node.kind == NodeKind::Deref) {
        write_place_name(p, node.a)
        synth_bytes(p, "^")
        return
    }
    if (node.kind == NodeKind::Index) {
        write_place_name(p, node.a)
        synth_bytes(p, "[")
        write_place_name(p, node.b)
        synth_bytes(p, "]")
        return
    }
    // An index worked out from something other than a literal is written as it
    // was read, since the digits are what a reader is looking at.
    if (node.kind == NodeKind::Num) {
        synth_digits(p, node.val)
        return
    }
    synth_range(p, node.val, node.c)
}

// The digits of a number, in the room past the source.
synth_digits :: fn(mut p: Parser, value: i64) {
    if (value < 0) {
        synth_bytes(p, "-")
        synth_digits(p, 0 - value)
        return
    }
    count := digits_in(value)
    synth_room_for(p, count + 1)
    mut scale: i64 = 1
    mut left: i64 = 1
    while (left < count) {
        scale = scale * 10
        left = left + 1
    }
    mut held := value
    mut written: i64 = 0
    while (written < count) {
        digit := held / scale
        p.src[p.synth_next + written] = cast($u8, CH_0 + digit)
        held = held - digit * scale
        scale = scale / 10
        written = written + 1
    }
    p.synth_next = p.synth_next + count
}

synth_bytes :: fn(mut p: Parser, word: ^i8) {
    length := cstr_len(word)
    synth_room_for(p, length + 1)
    mut k: i64 = 0
    while (k < length) {
        p.src[p.synth_next + k] = cast($u8, byte_at(word, k))
        k = k + 1
    }
    p.synth_next = p.synth_next + length
}

synth_range :: fn(mut p: Parser, off: i64, len: i64) {
    synth_room_for(p, len + 1)
    mut k: i64 = 0
    while (k < len) {
        p.src[p.synth_next + k] = p.src[off + k]
        k = k + 1
    }
    p.synth_next = p.synth_next + len
}

write_type_name :: fn(mut p: Parser, ty: i64) {
    if (is_distinct(ty)) {
        mut a: i64 = 0
        while (a < p.type_aliases.count) {
            entry := arena_at(p.type_aliases, a)
            if (entry.value == ty) {
                synth_range(p, entry.name_off, entry.name_len)
                return
            }
            a = a + 1
        }
    }
    held := distinct_repr(ty)
    if (held == TY_I64) { synth_bytes(p, "i64") return }
    if (held == TY_I32) { synth_bytes(p, "i32") return }
    if (held == TY_I16) { synth_bytes(p, "i16") return }
    if (held == TY_I8) { synth_bytes(p, "i8") return }
    if (held == TY_ISIZE) { synth_bytes(p, "isize") return }
    if (held == TY_U64) { synth_bytes(p, "u64") return }
    if (held == TY_U32) { synth_bytes(p, "u32") return }
    if (held == TY_U16) { synth_bytes(p, "u16") return }
    if (held == TY_U8) { synth_bytes(p, "u8") return }
    if (held == TY_USIZE) { synth_bytes(p, "usize") return }
    if (held == TY_F64) { synth_bytes(p, "f64") return }
    if (held == TY_F32) { synth_bytes(p, "f32") return }
    if (held == TY_BOOL) { synth_bytes(p, "bool") return }
    // The word the bootstrap says, which is the one a reader has seen: it
    // reports `the value is a 'void'` where a call answering nothing is bound.
    // One walk says this now, so the two compilers cannot answer differently.
    if (held == TY_VOID) { synth_bytes(p, "void") return }
    if (held == TY_HANDLE) { synth_bytes(p, "Handle") return }
    if (is_borrow(held)) {
        synth_bytes(p, "ref ")
        write_type_name(p, pointee(p, held))
        return
    }
    if (is_pointer(held)) {
        synth_bytes(p, "^")
        write_type_name(p, pointee(p, held))
        return
    }
    // A run of bytes is what the language calls text, and str is the name it
    // is written under wherever a program says it.
    if (is_array_ty(held) && array_element(p, held) == TY_U8
        && array_length(p, held) < 0) {
        synth_bytes(p, "str")
        return
    }
    if (is_array_ty(held)) {
        // A fixed array says how many it holds, which is half of what its type
        // is: `[4]i64` and `[]i64` are two types and were spelled alike here.
        length := array_length(p, held)
        synth_bytes(p, "[")
        if (length >= 0) {
            synth_digits(p, length)
        }
        synth_bytes(p, "]")
        write_type_name(p, array_element(p, held))
        return
    }
    // The same shape `report_type_name` writes, in bytes.
    if (is_proc(held)) {
        synth_bytes(p, "fn(")
        count := proc_param_count(p, held)
        mut k: i64 = 0
        while (k < count) {
            if (k > 0) {
                synth_bytes(p, ", ")
            }
            param := proc_param_at(p, held, k)
            if (is_borrow(param)) {
                synth_bytes(p, "mut ")
                write_type_name(p, pointee(p, param))
            } else {
                write_type_name(p, param)
            }
            k = k + 1
        }
        synth_bytes(p, ")")
        answer := proc_ret(p, held)
        if (answer != TY_VOID) {
            synth_bytes(p, " -> ")
            write_type_name(p, answer)
        }
        return
    }
    if (is_struct_ty(held)) {
        write_instance_name(p, held)
        return
    }
    synth_bytes(p, "a value")
}

// The sentence that says which rule was broken, when the rule is the one about
// nominal types. Nothing is written when some other mismatch is at fault.
// `value` is the node that was written, since a number where a set of bits
// belongs is a different mistake from a value of the wrong type.
report_distinct_note :: fn(mut p: Parser, value: i64, from: i64, to: i64) {
    if (is_flags_type(p, to)) {
        if (written_number(p, value)) {
            report("; a set of bits is built from the names declared under it, and a number is not one of them")
            return
        }
        report("; a set of bits is built only from the names declared under it")
        return
    }
    if (is_distinct(to) && from != to) {
        report("; a distinct type is not its representation")
    }
}

// Whether what was written is a number rather than a name. A bit of a flags
// type is also a Num node, and carries its type, which is what tells them
// apart.
written_number :: fn(mut p: Parser, value: i64) -> bool {
    if (value < 0) {
        return false
    }
    node := arena_at(p.arena, value)
    node.kind == NodeKind::Num && node.b == 0
}

// Indirect: a raw pointer or a borrow, both a C pointer and both auto-derefed.
// A pointer (raw or borrow) is 8 bytes and emits a trailing `*`. The value
// generic codes and the function-pointer codes ride above CONST_BASE and are
// not pointers, even though they are numerically larger. A value is resolved
// away before it is a type, and a function pointer emits its own declarator.
is_pointer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return true
    }
    held >= POINTER_BASE && held < CONST_BASE
}

// A borrow carries the flag. A raw pointer is indirect without it. An
// indirection over a distinct type carries the same difference in the low bit
// of its code, so this answers for one without reading the table.
// The vector a type is, looking through the borrow an aggregate parameter
// arrives as, or -1 for anything that is not one. A slice is not one: its
// length is decided where the program runs, and a vector's is in its type.
vector_of :: fn(mut p: Parser, ty: i64) -> i64 {
    mut held := ty
    if (is_borrow(held) || is_pointer(held)) {
        held = pointee(p, held)
    }
    if (is_array_ty(held) == false || is_slice_ty(p, held)) {
        return -1
    }
    held
}

is_borrow :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return (held - INDIRECT_BASE) % 2 == 1
    }
    held >= BORROW_FLAG && held < CONST_BASE
}

is_raw_pointer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return (held - INDIRECT_BASE) % 2 == 0
    }
    held >= POINTER_BASE && held < BORROW_FLAG
}

// Whether the code names an indirection over a distinct type, which is the one
// shape that is looked up rather than added. See `Indirect` in core.frost.
is_indirect :: fn(ty: i64) -> bool {
    ty >= INDIRECT_BASE && ty < POINTER_BASE
}

// `^T` and a borrow of `T`. Every type but a distinct one composes by adding a
// base to what is pointed at; a distinct type's code already sits above every
// base, so those are interned here instead and the code is an index.
pointer_to :: fn(mut p: Parser, target: i64) -> i64 {
    if (is_distinct(target) == false) {
        return POINTER_BASE + target
    }
    indirect_of(p, target, 0)
}

borrow_of :: fn(mut p: Parser, target: i64) -> i64 {
    if (is_distinct(target) == false) {
        return BORROW_FLAG + target
    }
    indirect_of(p, target, 1)
}

// Deduplicated, so two spellings of `^Meters` share a code and comparing two
// types stays a comparison of two numbers.
indirect_of :: fn(mut p: Parser, target: i64, borrow: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.indirects.count) {
        entry := arena_at(p.indirects, i)
        if (entry.target == target && entry.borrow == borrow) {
            return INDIRECT_BASE + i * 2 + borrow
        }
        i = i + 1
    }
    made := arena_push(
        p.indirects,
        Indirect { target = target, borrow = borrow }
    )
    INDIRECT_BASE + made * 2 + borrow
}

// A function pointer: the address of a function of a given signature, a
// callable value. It is not a data pointer, so it is never dereferenced,
// indexed, or gated. It is called, directly through a name or through a cast on
// a value of this type.
is_proc :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= PROC_BASE && held < FN_BASE
}

// Intern a function-pointer signature and answer its type code. Signatures are
// deduplicated so two spellings of the same one share a code.
proc_of :: fn(mut p: Parser, ret: i64, param_start: i64, param_count: i64)
    -> i64 {
    mut i: i64 = 0
    while (i < p.procs.count) {
        entry := arena_at(p.procs, i)
        if (entry.ret == ret && entry.param_count == param_count
            && gargs_run_equal(
                p,
                entry.param_start,
                param_start,
                param_count
            )) {
            return PROC_BASE + i
        }
        i = i + 1
    }
    PROC_BASE + arena_push(
        p.procs,
        ProcSig {
            ret = ret,
            param_start = param_start,
            param_count = param_count
        }
    )
}

proc_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - PROC_BASE
}

proc_ret :: fn(mut p: Parser, ty: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    entry.ret
}

proc_param_count :: fn(mut p: Parser, ty: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    entry.param_count
}

proc_param_at :: fn(mut p: Parser, ty: i64, n: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    param := arena_at(p.proc_params, entry.param_start + n)
    param.value
}

// Compare two runs in the `proc_params` arena, the same shape as gargs_equal is
// for gargs, so a signature's parameter run can be deduplicated.
gargs_run_equal :: fn(mut p: Parser, a_start: i64, b_start: i64, count: i64)
    -> bool {
    mut i: i64 = 0
    while (i < count) {
        left := arena_at(p.proc_params, a_start + i)
        right := arena_at(p.proc_params, b_start + i)
        if (left.value != right.value) {
            return false
        }
        i = i + 1
    }
    true
}

// Whether a name written at `off` belongs to the unit being emitted. Everything
// belongs to a whole-program unit. A per-module unit takes what the module it is
// for wrote, which is a run of the one source buffer, so this is a comparison
// rather than a search. Both backends split a program the same way and ask this
// the same way.
// Whether an offset is inside any module's text at all. A name the compiler
// made up, such as the one a `test` block's body is given, sits past every
// module in the room after the source, so it belongs to no module by this
// question and its body's position is what answers instead.
in_any_module :: fn(mut p: Parser, off: i64) -> bool {
    mut i: i64 = 0
    while (i < p.modules.count) {
        entry := arena_at(p.modules, i)
        if (off >= entry.start && off < entry.finish) {
            return true
        }
        i = i + 1
    }
    false
}

unit_holds :: fn(mut p: Parser, off: i64) -> bool {
    if (p.emit_module < 0) {
        return true
    }
    entry := arena_at(p.modules, p.emit_module)
    off >= entry.start && off < entry.finish
}

pointee :: fn(mut p: Parser, ty: i64) -> i64 {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        entry := arena_at(p.indirects, (held - INDIRECT_BASE) / 2)
        return entry.target
    }
    if (is_borrow(held)) {
        return held - BORROW_FLAG
    }
    held - POINTER_BASE
}

is_struct_ty :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= STRUCT_BASE && held < ARRAY_BASE
}
// Whether a type is an integer, which is one of the questions a `where` bound
// may ask. `bool` is not one: it is one byte holding a truth value, and
// arithmetic on it means nothing.
is_integer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    (held == TY_I8 || held == TY_I16 || held == TY_I32 || held == TY_I64
        || held == TY_ISIZE || held == TY_U8 || held == TY_U16
        || held == TY_U32 || held == TY_U64 || held == TY_USIZE)
}

// How many bits an integer type holds, which is how many bits a set written
// over it has to name.
integer_bits :: fn(ty: i64) -> i64 {
    held := distinct_repr(ty)
    if (held == TY_I8 || held == TY_U8) { return 8 }
    if (held == TY_I16 || held == TY_U16) { return 16 }
    if (held == TY_I32 || held == TY_U32) { return 32 }
    64
}

// Whether a number is one bit, which is what makes a bit of a set move the
// counter the next bare name reads.
one_bit :: fn(value: i64) -> bool {
    value > 0 && (value & (value - 1)) == 0
}

// Which bit of a set a number reaches, counting the lowest as the first. A set
// over `u32` holds thirty-two, so anything reaching past that is refused, and
// the answer is what the refusal names. Zero reaches no bit and fits anywhere,
// which is what lets `None :: 0` open a set of any width.
bit_ordinal :: fn(value: i64) -> i64 {
    if (value <= 0) {
        return 0
    }
    mut held := value
    mut count: i64 = 0
    while (held != 0) {
        count = count + 1
        held = cast($i64, cast($u64, held) >> 1)
    }
    count
}

// A count written the way it is spoken. Only the widths of the integer types
// reach this, so the numbers are small, but the rule is the English one so the
// two compilers have the same one to write.
report_ordinal :: fn(count: i64) {
    report_int(count)
    if (count % 100 / 10 == 1) {
        report("th")
        return
    }
    ones := count % 10
    if (ones == 1) {
        report("st")
    } else if (ones == 2) {
        report("nd")
    } else if (ones == 3) {
        report("rd")
    } else {
        report("th")
    }
}

is_float :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held == TY_F32 || held == TY_F64
}
is_array_ty :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= ARRAY_BASE && held < INDIRECT_BASE
}

// Everything wider than a register, which is everything this compiler holds by
// address rather than in one: a struct, a fixed array, and a slice, which is a
// pointer beside a length.
is_aggregate :: fn(ty: i64) -> bool {
    is_struct_ty(ty) || is_array_ty(ty)
}

// The one table holds both, so a slice is told from an array by having no
// length of its own rather than by a separate code.
array_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - ARRAY_BASE
}

array_element :: fn(mut p: Parser, ty: i64) -> i64 {
    def := arena_at(p.arrays, array_index_of(ty))
    def.element
}

array_length :: fn(mut p: Parser, ty: i64) -> i64 {
    def := arena_at(p.arrays, array_index_of(ty))
    def.length
}

is_slice_ty :: fn(mut p: Parser, ty: i64) -> bool {
    is_array_ty(ty) && array_length(p, ty) < 0
}

// One code per (element, length) pair, so two spellings of the same array are
// the same type and the backends can key their declarations on the code.
array_of :: fn(mut p: Parser, element: i64, length: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.arrays.count) {
        entry := arena_at(p.arrays, i)
        if (entry.element == element && entry.length == length) {
            return ARRAY_BASE + i
        }
        i = i + 1
    }
    ARRAY_BASE + arena_push(
        p.arrays,
        ArrayDef { element = element, length = length, emitted = 0 }
    )
}

struct_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - STRUCT_BASE
}

// The field-table index of a struct field named by a literal, or -1 if there
// is none. A pointer to the struct is looked through, so `mut s: Slab` (a
// borrow) answers the same as a value.
slab_field_id :: fn(mut p: Parser, struct_ty: i64, name: ^i8) -> i64 {
    mut base := struct_ty
    if (is_pointer(base)) {
        base = pointee(p, base)
    }
    if (is_struct_ty(base) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(base))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (str_range_eq(p.src, field.name_off, field.name_len, name)) {
            return fid
        }
        fid = field.next
    }
    -1
}

// The type of a struct field named by a literal, or -1 if there is none.
slab_field_type :: fn(mut p: Parser, struct_ty: i64, name: ^i8) -> i64 {
    fid := slab_field_id(p, struct_ty, name)
    if (fid == (-1)) {
        return -1
    }
    field := arena_at(p.fields, fid)
    field.ty
}

// A slab is a struct the compiler indexes by a handle. It is recognized
// structurally: a `storage` array holding the elements and a parallel
// `generations` array, one i64 per slot. That shape, not a declared type, is
// what lets `slab[handle]` lower to a bounds- and generation-checked place.
is_slab_ty :: fn(mut p: Parser, struct_ty: i64) -> bool {
    storage := slab_field_type(p, struct_ty, "storage")
    generations := slab_field_type(p, struct_ty, "generations")
    is_array_ty(storage) && is_array_ty(generations)
}

// The type of the field of `struct_ty` whose name is the byte range
// (off, len), or -1. The byte-range twin of `slab_field_type`, so one
// synthesized field can be matched against another struct's field by name
// without a C string.
field_type_by_range :: fn(mut p: Parser, struct_ty: i64, off: i64, len: i64)
    -> i64 {
    mut base := struct_ty
    if (is_pointer(base)) {
        base = pointee(p, base)
    }
    if (is_struct_ty(base) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(base))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return field.ty
        }
        fid = field.next
    }
    -1
}

// A columns container: the SoA sibling of a slab. It keeps the same
// generational bookkeeping (`generations` + `free_list`) but stores its
// elements as one array per field of the element type rather than one
// `storage` array of whole elements. Recognized structurally by that shape:
// parallel `generations` and `free_list` arrays and no `storage` array, which
// is what tells it apart from a slab.
is_columns_ty :: fn(mut p: Parser, struct_ty: i64) -> bool {
    generations := slab_field_type(p, struct_ty, "generations")
    free_list := slab_field_type(p, struct_ty, "free_list")
    storage := slab_field_type(p, struct_ty, "storage")
    is_array_ty(generations) && is_array_ty(free_list) && storage == (-1)
}

// `columns_new()` is a compiler builtin, not a real function. It stands for a
// zeroed container of the type the context wants, recognized by name at the
// call node so neither backend emits a real call to it.
is_columns_new_call :: fn(mut p: Parser, value: i64) -> bool {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call) {
        return false
    }
    sym := arena_at(p.fns, node.val)
    (str_range_eq(p.src, sym.off, sym.len, "columns_new")
        || str_range_eq(p.src, sym.off, sym.len, "slab_new"))
}

// Whether a columns field is the container's own bookkeeping rather than a
// column of the element. A scatter or gather touches only the element columns,
// skipping these.
is_columns_bookkeeping :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    (str_range_eq(p.src, off, len, "generations")
        || str_range_eq(p.src, off, len, "free_list")
        || str_range_eq(p.src, off, len, "free_count")
        || str_range_eq(p.src, off, len, "live_words")
        || str_range_eq(p.src, off, len, "live_count"))
}

// An already-synthesized columns container for element `element` at capacity
// `count`, or -1. Structural dedup so the same `columns<T,N>` written in two
// places is one type, which is what lets a value pass between functions.
columns_lookup :: fn(mut p: Parser, element: i64, count: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.instances.count) {
        entry := arena_at(p.instances, i)
        if (entry.generic_index == COLUMNS_OF && entry.arg == element) {
            candidate := STRUCT_BASE + entry.struct_index
            gens := slab_field_type(p, candidate, "generations")
            if (is_array_ty(gens) && array_length(p, gens) == count) {
                return candidate
            }
        }
        i = i + 1
    }
    -1
}

// The element type a columns container stores, and how many slots it has, read
// off the record made where it was synthesized. A container carries one array
// per field of its element and nothing naming the element itself, and two
// structs with the same field names and types would answer alike to a walk over
// the shape, so what it was made for is written down instead.
columns_made_for :: fn(mut p: Parser, container: i64) -> i64 {
    if (is_struct_ty(container) == false) {
        return -1
    }
    index := struct_index_of(container)
    mut i: i64 = 0
    while (i < p.instances.count) {
        entry := arena_at(p.instances, i)
        if (entry.generic_index == COLUMNS_OF
            && entry.struct_index == index) {
            return entry.arg
        }
        i = i + 1
    }
    -1
}

// Note that this container was made for this element at this capacity, so the
// next one written the same way is this one and a call over it can read what it
// holds.
record_columns :: fn(mut p: Parser, element: i64, container: i64) {
    arena_push(
        p.instances,
        Instance {
            generic_index = COLUMNS_OF,
            arg = element,
            xarg_start = 0,
            xarg_count = 0,
            struct_index = struct_index_of(container),
            asked_at = p.stmt_at
        }
    )
}

// Resolve a type name (byte range) to a type code: the current generic type
// parameter (bound to its concrete type while monomorphizing, otherwise the
// TY_PARAM placeholder), a primitive keyword, or the named struct. A generic
// template struct is not returned here. `Name<Arg>` instantiation is handled in
// parse_type. An unknown name falls back to i64.
type_code_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    // The predeclared names come first, so a primitive means its type
    // wherever a type is read and no binding or alias can redeclare it,
    // which is the order the bootstrap resolves the same names in.
    if (str_range_eq(p.src, offset, length, "i64")) { return TY_I64 }
    if (str_range_eq(p.src, offset, length, "i32")) { return TY_I32 }
    if (str_range_eq(p.src, offset, length, "i16")) { return TY_I16 }
    if (str_range_eq(p.src, offset, length, "i8")) { return TY_I8 }
    if (str_range_eq(p.src, offset, length, "isize")) { return TY_ISIZE }
    if (str_range_eq(p.src, offset, length, "u64")) { return TY_U64 }
    if (str_range_eq(p.src, offset, length, "u32")) { return TY_U32 }
    if (str_range_eq(p.src, offset, length, "u16")) { return TY_U16 }
    if (str_range_eq(p.src, offset, length, "u8")) { return TY_U8 }
    if (str_range_eq(p.src, offset, length, "usize")) { return TY_USIZE }
    if (str_range_eq(p.src, offset, length, "f64")) { return TY_F64 }
    if (str_range_eq(p.src, offset, length, "f32")) { return TY_F32 }
    if (str_range_eq(p.src, offset, length, "str")) {
        return array_of(p, TY_U8, -1)
    }
    if (str_range_eq(p.src, offset, length, "bool")) { return TY_BOOL }
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        if (p.binding_active == 1) {
            return p.type_binding
        }
        return TY_PARAM
    }
    // A parameter beyond the first is bound on the `gbindings` stack while its
    // generic's body is re-parsed. The most recent binding wins, so a nested
    // instantiation shadows an outer one. What comes back is the bound type, or
    // for a value parameter the CONST_BASE-encoded number, which is what lets a
    // nested `Slab<T, N>` pass the value on.
    mut b: i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return binding.bound
        }
    }
    mut a: i64 = 0
    while (a < p.type_aliases.count) {
        entry := arena_at(p.type_aliases, a)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return entry.value
        }
        a = a + 1
    }
    mut i: i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.is_generic == 0 && entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return STRUCT_BASE + i
        }
        i = i + 1
    }
    // A name nothing declares is not a type. Answering `i64` for one let a
    // signature name a type that is not there and go through every pass
    // without a word.
    // A type parameter in scope means this is a template's own parse, where a
    // name stands for whatever the instance binds it to.
    // A name a generic binds stands for whatever an instance gives it. Every
    // other name inside one is as much a name nothing declares as it is
    // anywhere else: asking only whether *some* parameter is in scope let
    // `fn($T: Type) -> U` name a `U` nothing has and go through every pass
    // without a word.
    // `Type` is what a compile-time parameter is declared as, not a type a
    // program can hold, so it is read here and named nowhere.
    if (p.type_check_names == 1 && p.gbindings.count == 0
        && names_gparam(p, offset, length) == false
        && str_range_eq(p.src, offset, length, "Type") == false
        && said_unknown_before(p, offset) == false) {
        arena_push(p.said_unknown, Cap { ty = 0, off = offset, len = length })
        report_where(p.modules, p.src, offset)
        report("'")
        report_src(p.src, offset, length)
        report("' is not a type this program declares")
        report_declared_elsewhere(p, offset, length)
        report_nearest_name(p, offset, length)
        frost_rt_recover_note()
    }
    TY_I64
}

// Whether the name written at this offset has already been reported as naming
// no type. The offset is what tells one written name from another: the same
// name written twice is two mistakes, and one name read twice is one.
said_unknown_before :: fn(p: Parser, offset: i64) -> bool {
    mut i: i64 = 0
    while (i < p.said_unknown.count) {
        if (arena_at(p.said_unknown, i).off == offset) {
            return true
        }
        i = i + 1
    }
    false
}

// True when two argument runs in the `gargs` arena hold the same values.
// Whether two elements name the same record constant, or neither names one. A
// constant is written into the body rather than handed over, so two constants of
// one type are two bodies and the run is what tells them apart.
same_const_element :: fn(mut p: Parser, left: GArg, right: GArg) -> bool {
    if (left.const_len != right.const_len) {
        return false
    }
    if (left.const_len == 0) {
        return true
    }
    bytes_equal(p.src, left.const_off, right.const_off, left.const_len)
}

gargs_equal :: fn(
    mut p: Parser,
    a_start: i64,
    b_start: i64,
    count: i64
) -> bool {
    mut i: i64 = 0
    while (i < count) {
        left := arena_at(p.gargs, a_start + i)
        right := arena_at(p.gargs, b_start + i)
        if (left.value != right.value
            || same_const_element(p, left, right) == false) {
            return false
        }
        i = i + 1
    }
    true
}

// The same, and waiting on the same answers. An element whose type is what a
// call to a generic returns holds the default until that answer is worked out,
// so two runs can read alike while standing for different types. Which call
// each waits on tells them apart, and a run that waits on nothing is never the
// same as one that does. Once both are settled the wait is gone from each and
// this is `gargs_equal` again, which is what lets two that settled alike
// collapse into one instance.
gargs_alike :: fn(
    mut p: Parser,
    a_start: i64,
    b_start: i64,
    count: i64
) -> bool {
    mut i: i64 = 0
    while (i < count) {
        left := arena_at(p.gargs, a_start + i)
        right := arena_at(p.gargs, b_start + i)
        if (left.value != right.value || left.pending != right.pending
            || same_const_element(p, left, right) == false) {
            return false
        }
        i = i + 1
    }
    true
}

// The number a value generic parameter is bound to, or -1 when the name is not
// a bound value parameter. A value binding, whether the primary one or one on
// the stack, holds CONST_BASE plus the number. This hands back the number, for
// an array length `[N]T` or an occurrence of `N` in an expression.
value_binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)
        && p.type_binding >= CONST_BASE && p.type_binding < PROC_BASE) {
        return p.type_binding - CONST_BASE
    }
    mut b: i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)
            && binding.bound >= CONST_BASE && binding.bound < PROC_BASE) {
            return binding.bound - CONST_BASE
        }
    }
    -1
}

// What a compile-time parameter is bound to right now, whatever kind it is, or
// -1 when the name is bound to nothing. This is how a name that will be a
// number is told from one that already is something else.
binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        return p.type_binding
    }
    mut b: i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return binding.bound
        }
    }
    -1
}

// The function a compile-time function parameter is bound to, or -1 when the
// name is not one. A binding holds FN_BASE plus an index into the `fns` table,
// so what comes back is the index of whichever function the call site passed.
fn_binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)
        && p.type_binding >= FN_BASE) {
        return p.type_binding - FN_BASE
    }
    mut b: i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)
            && binding.bound >= FN_BASE) {
            return binding.bound - FN_BASE
        }
    }
    -1
}

// Whether a name is a type: a bound generic parameter, an alias, a primitive,
// or a declared struct. `$Entity` and `$sort_less` are both written the same
// way at a call, and this is what tells the type argument from the function
// argument.
is_type_name :: fn(mut p: Parser, offset: i64, length: i64) -> bool {
    // The predeclared names come first, matching `type_code_for`, so what
    // counts as a type name and what a type name means agree.
    if (str_range_eq(p.src, offset, length, "i64")) { return true }
    if (str_range_eq(p.src, offset, length, "i32")) { return true }
    if (str_range_eq(p.src, offset, length, "i16")) { return true }
    if (str_range_eq(p.src, offset, length, "i8")) { return true }
    if (str_range_eq(p.src, offset, length, "isize")) { return true }
    if (str_range_eq(p.src, offset, length, "u64")) { return true }
    if (str_range_eq(p.src, offset, length, "u32")) { return true }
    if (str_range_eq(p.src, offset, length, "u16")) { return true }
    if (str_range_eq(p.src, offset, length, "u8")) { return true }
    if (str_range_eq(p.src, offset, length, "usize")) { return true }
    if (str_range_eq(p.src, offset, length, "f64")) { return true }
    if (str_range_eq(p.src, offset, length, "f32")) { return true }
    if (str_range_eq(p.src, offset, length, "str")) { return true }
    if (str_range_eq(p.src, offset, length, "bool")) { return true }
    if (str_range_eq(p.src, offset, length, "Handle")) { return true }
    if (str_range_eq(p.src, offset, length, "columns")) { return true }
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        return true
    }
    mut b: i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return true
        }
    }
    mut a: i64 = 0
    while (a < p.type_aliases.count) {
        entry := arena_at(p.type_aliases, a)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return true
        }
        a = a + 1
    }
    mut i: i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return true
        }
        i = i + 1
    }
    false
}

// Find the index of a generic struct template by name, or -1.
generic_index_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i: i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        // A template still holding only its name has no body to instantiate
        // from, so a generic named before it is declared is left unresolved
        // rather than re-parsed from the top of the file.
        if (entry.is_generic == 1 && entry.declared == 1
            && entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return i
        }
        i = i + 1
    }
    -1
}

// A unary node wrapping a single child expression (deref, address-of).
new_unary_at :: fn(mut p: Parser, kind: NodeKind, child: i64, at: i64) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = kind,
            a = child,
            b = 0,
            c = 0,
            val = 0,
            next = -1,
            pos = at
        },
    )
}

new_unary :: fn(mut p: Parser, kind: NodeKind, child: i64) -> i64 {
    held := cur_off(p)
    new_unary_at(p, kind, child, held)
}

// An index node `base[index]`: `a` is the base, `b` the index expression.
//
// The position is where the base is written, which is where the whole access
// is. Read off the parser after the index is parsed it named the token past the
// `]`, so a diagnostic about an index landed on the statement after the one
// holding it; the `[` is passed in for the same reason and is what this falls
// back to.
new_index :: fn(mut p: Parser, base: i64, index: i64, at: i64) -> i64 {
    mut here := at
    if (base >= 0 && base < p.arena.count) {
        here = arena_at(p.arena, base).pos
    }
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Index,
            a = base,
            b = index,
            c = 0,
            val = 0,
            next = -1,
            pos = here
        },
    )
}

// A node carrying a type code in `val` (ptr_cast target, sizeof operand) and an
// optional expression in `a`.
//
// `at` is where the word that opens it is written. The cursor by the time one of
// these is built has read the whole of it and sits on what comes after, so a
// complaint about `cast($i64, "x")` pointed past the closing parenthesis at
// whatever the next statement began with.
new_type_node_at :: fn(
    mut p: Parser,
    kind: NodeKind,
    expr: i64,
    ty: i64,
    at: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = kind,
            a = expr,
            b = 0,
            c = 0,
            val = ty,
            next = -1,
            pos = at
        },
    )
}

new_type_node :: fn(mut p: Parser, kind: NodeKind, expr: i64, ty: i64) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = kind,
            a = expr,
            b = 0,
            c = 0,
            val = ty,
            next = -1,
            pos = cur_off(p)
        },
    )
}

// One arm of a match: `a` is the body statement, `val` the integer pattern, and
// `c` a flag marking the `_` default arm. `b` is the list of patterns the arm
// names, and -1 where it names none, which is the `_` arm.
new_case :: fn(
    mut p: Parser,
    body: i64,
    value: i64,
    is_default: i64,
    alts: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Case,
            a = body,
            b = alts,
            c = is_default,
            val = value,
            next = -1,
            pos = cur_off(p)
        },
    )
}

// One of the patterns a `case` names: the span `low` to `high` under the
// spelling `form`, from the variant `entry` where a name wrote it.
new_case_alt :: fn(
    mut p: Parser,
    low: i64,
    high: i64,
    form: i64,
    entry: i64
) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::CaseAlt,
            a = entry,
            b = high,
            c = form,
            val = low,
            next = -1,
            pos = cur_off(p)
        },
    )
}

// The patterns one arm names.
case_alts :: fn(mut p: Parser, cid: i64) -> i64 {
    node := arena_at(p.arena, cid)
    node.b
}

// The lower and upper ends one alternative covers, both inside. A half-open
// span stops one short of what was written.
alt_low :: fn(mut p: Parser, alt: i64) -> i64 {
    node := arena_at(p.arena, alt)
    node.val
}

alt_high :: fn(mut p: Parser, alt: i64) -> i64 {
    node := arena_at(p.arena, alt)
    if (node.c == ALT_HALF_OPEN) {
        return node.b - 1
    }
    node.b
}

// The declared name nearest to one that is not declared, or -1 when no name is
// near enough or two are equally near. A guess a reader takes without checking
// is worse than no suggestion, so an ambiguous one is withheld.
//
// Answers the index into the table of declared names, since the name itself is
// a range in the source. That table rather than the symbol table: a misspelling
// is as likely to be of a constant or a type as of a function, and a name
// interns at its first mention, so the symbol table holds calls as well as
// declarations.
nearest_name :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    mut best: i64 = -1
    mut best_distance: i64 = 0
    mut ties: i64 = 0
    mut index: i64 = 0
    while (index < p.declared.count) {
        sym := arena_at(p.declared, index)
        if (sym.len > 0 && bytes_equal(p.src, sym.off, off, len) == false) {
            held := name_distance(p.src, sym.off, sym.len, off, len)
            // Near enough to be a misspelling rather than a different word.
            if (held * 3 <= len * 2) {
                if (best < 0 || held < best_distance) {
                    best = index
                    best_distance = held
                    ties = 1
                } else if (held == best_distance) {
                    ties = ties + 1
                }
            }
        }
        index = index + 1
    }
    if (ties != 1) {
        return -1
    }
    best
}

// How many single-character edits turn one name into the other.
name_distance :: fn(
    src: str,
    a_off: i64,
    a_len: i64,
    b_off: i64,
    b_len: i64
) -> i64 {
    if (a_len > 64 || b_len > 64) {
        return 999
    }
    mut row: [65]i64 = [0; 65]
    mut j: i64 = 0
    while (j <= b_len) {
        row[j] = j
        j = j + 1
    }
    mut i: i64 = 0
    while (i < a_len) {
        mut previous := row[0]
        row[0] = i + 1
        j = 0
        while (j < b_len) {
            mut cost: i64 = 1
            if (src[a_off + i] == src[b_off + j]) {
                cost = 0
            }
            replaced := previous + cost
            previous = row[j + 1]
            mut best := row[j] + 1
            if (row[j + 1] + 1 < best) {
                best = row[j + 1] + 1
            }
            if (replaced < best) {
                best = replaced
            }
            row[j + 1] = best
            j = j + 1
        }
        i = i + 1
    }
    row[b_len]
}

report_nearest_name :: fn(mut p: Parser, off: i64, len: i64) {
    near := nearest_name(p, off, len)
    if (near >= 0) {
        sym := arena_at(p.declared, near)
        report(" (did you mean '")
        report_src(p.src, sym.off, sym.len)
        report("'?)")
    }
}

// Whether a name is a compile-time parameter of the declaration being parsed
// that nothing is bound to yet. That is the generic's own parse, before any
// argument exists. Once an instance binds the name, it is whatever it was bound
// to, and a name used as something it is not is an error rather than a
// placeholder.
names_gparam :: fn(mut p: Parser, offset: i64, length: i64) -> bool {
    if (binding_of(p, offset, length) >= 0) {
        return false
    }
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        return true
    }
    mut i: i64 = 0
    while (i < p.xparam_count) {
        param := arena_at(p.gparams, p.xparam_start + i)
        if (param.name_len == length
            && bytes_equal(p.src, param.name_off, offset, length)) {
            return true
        }
        i = i + 1
    }
    false
}
