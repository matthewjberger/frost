    value_binding_of, fn_binding_of, binding_of, is_type_name,
    is_distinct, distinct_repr, distinct_id, distinct_type,
    is_flags_type, flag_bit_value, flag_bit_holding, record_flag_bit,
    type_value_index, names_values, record_type_value,
    report_type_name, report_distinct_note, written_number,
    fn_names_matching,
    report_declared_elsewhere,
    intern_global, is_aggregate, is_array_ty, is_const, is_float, is_main_name,
    name_visible,
    is_borrow, is_pointer, is_proc, vector_of, is_raw_pointer, is_slab_ty, is_slice_ty,
    is_indirect, pointer_to, borrow_of,
    is_integer, integer_bits, one_bit, bit_ordinal, report_ordinal,
    is_columns_ty, columns_lookup, columns_made_for, record_columns,
    is_columns_new_call, field_type_by_range,
    is_columns_bookkeeping,
    is_struct_ty, proc_of, proc_ret, proc_param_count, proc_param_at,
    slab_field_id, slab_field_type,
    clear_extern, mark_defined, mark_extern, mark_inline, mark_keeps_name,
    new_case,
    new_case_alt,
    case_alts, alt_low, alt_high, new_field_init,
    new_field_node,
    new_func_node, new_index, new_let_node, new_named_node,
    new_named_node_at, new_node, new_node_at,
    new_struct_lit, new_type_node, new_type_node_at, new_unary, new_unary_at,
    node_next,
    pointee,
    record_generic_fn, register_const, set_field_next, set_next, set_params,
    cap_at, cap_count_of, pack_element_name, alias_for, push_alias,
    unit_holds, in_any_module,
    set_ret_type, set_uses, struct_index_of, synth_capability_name,
    synth_join, synth_literal, synth_numbered, synth_room_for, synth_type_name, synth_bytes, type_text, place_text, instance_text,
    synth_result_name, report_base_type_name,
