// Names and nodes: interning, visibility, synthesized names, constants, type
// codes, and the AST constructors.

import "core.frost"
import "lexer.frost"
import "cursor.frost"
import "imports.frost"

export append_node, array_element, array_index_of, array_length, array_of,
    check_name_is_free,
    mark_safe, place_renames,
    bytes_equal, const_value, value_const_node, digits_in, gargs_equal,
    generic_index_for,
    value_binding_of, fn_binding_of, binding_of, is_type_name,
    is_distinct, distinct_repr, distinct_id, distinct_type,
    is_flags_type, flag_bit_value, record_flag_bit,
    report_type_name, report_distinct_note, written_number,
    intern_global, is_aggregate, is_array_ty, is_const, is_float, is_main_name,
    is_borrow, is_pointer, is_proc, is_raw_pointer, is_slab_ty, is_slice_ty,
    is_indirect, pointer_to, borrow_of,
    is_integer,
    is_columns_ty, columns_lookup, is_columns_new_call, field_type_by_range,
    is_columns_bookkeeping,
    is_struct_ty, proc_of, proc_ret, proc_param_count, proc_param_at,
    slab_field_id, slab_field_type,
    mark_defined, mark_extern, mark_inline, new_case, new_field_init,
    new_field_node,
    new_func_node, new_index, new_let_node, new_named_node,
    new_named_node_at, new_node, new_node_at,
    new_struct_lit, new_type_node, new_unary, new_unary_at, node_next,
    pointee,
    record_generic_fn, register_const, set_field_next, set_next, set_params,
    cap_at, cap_count_of, pack_element_name, alias_for, push_alias,
    unit_holds, in_any_module,
    set_ret_type, set_uses, struct_index_of, synth_capability_name,
    synth_join, synth_literal, synth_numbered, synth_room_for, synth_type_name,
    type_code_for

// Whether there is room for `wanted` more bytes past the source, said here
// rather than found out by writing over whatever follows the buffer. The room
// is fixed and every synthesized name spends it for good, so a program that
// asks for more than there is has to be told, not left to corrupt itself.
synth_room_for :: fn(mut p: Parser, wanted: i64) {
    if (p.synth_next + wanted < str_len(p.src)) {
        return
    }
    report("frost: the compiler ran out of room for the names it makes up")
    frost_rt_die()
}

// Copy a literal name into the room past the source and answer its offset, for
// a name the compiler needs that no source spells.
synth_literal :: fn(mut p: Parser, word: ^i8) -> i64 {
    synth_room_for(p, cstr_len(word) + 1)
    start := p.synth_next
    length := cstr_len(word)
    mut k : i64 = 0
    while (k < length) {
        p.src[start + k] = cast($u8, byte_at(word, k))
        k = k + 1
    }
    p.src[start + length] = 0
    p.synth_next = start + length + 1
    start
}

digits_in :: fn(number: i64) -> i64 {
    mut value := number
    mut digits : i64 = 1
    while (value >= 10) {
        value = value / 10
        digits = digits + 1
    }
    digits
}

// A name with a number after it, so each `?` and each failure set gets one of
// its own. Its length is the word's plus the number's digits.
synth_numbered :: fn(mut p: Parser, word: ^i8, number: i64) -> i64 {
    start := synth_literal(p, word)
    digits := digits_in(number)
    mut scale : i64 = 1
    mut left : i64 = 1
    while (left < digits) {
        scale = scale * 10
        left = left + 1
    }
    mut value := number
    mut written : i64 = 0
    while (written < digits) {
        digit := value / scale
        p.src[p.synth_next - 1 + written] = cast($u8, CH_0 + digit)
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    p.src[p.synth_next - 1 + digits] = 0
    p.synth_next = p.synth_next + digits
    start
}

// Two source names joined by an underscore, for a field that belongs to one
// variant of an enum: `Enemy` and `damage` become `Enemy_damage`. Two variants
// may each carry a `damage` and they stay apart.
synth_join :: fn(mut p: Parser, first_off: i64, first_len: i64, second_off: i64,
    second_len: i64) -> i64 {
    synth_room_for(p, first_len + second_len + 2)
    start := p.synth_next
    mut k : i64 = 0
    while (k < first_len) {
        p.src[start + k] = p.src[first_off + k]
        k = k + 1
    }
    p.src[start + first_len] = CH_UNDERSCORE
    k = 0
    while (k < second_len) {
                    p.src[start + first_len + 1 + k] = p.src[second_off + k]
        k = k + 1
    }
    p.src[start + first_len + 1 + second_len] = 0
    p.synth_next = start + first_len + second_len + 2
    start
}

// The binding a `uses Arena` function draws: the capability type's name with
// its first letter lowercased, so `uses Arena<256>` binds `arena` and the body
// names it the way the caller's `with arena` block does.
synth_capability_name :: fn(mut p: Parser, off: i64, len: i64) -> i64 {
    start := p.synth_next
    mut k : i64 = 0
    while (k < len) {
        mut byte := p.src[off + k]
        if (k == 0 && byte >= CH_UPPER_A && byte <= CH_UPPER_Z) {
            byte = byte + 32
        }
        p.src[start + k] = byte
        k = k + 1
    }
    p.src[start + len] = 0
    p.synth_next = start + len + 1
    start
}

// The same comparison across two buffers, for a name kept somewhere other than
// the source it was read from.
bytes_equal_across :: fn(first: str, first_off: i64, second: str,
    second_off: i64, length: i64) -> bool {
    mut k : i64 = 0
    while (k < length) {
        if (first[first_off + k]
            != second[second_off + k]) {
            return false
        }
        k = k + 1
    }
    true
}

bytes_equal :: fn(src: str, first: i64, second: i64, length: i64) -> bool {
    mut k : i64 = 0
    while (k < length) {
        if (src[first + k] != src[second + k]) {
            return false
        }
        k = k + 1
    }
    true
}

intern_global :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    // A `$f` parameter stands for the function the call site passed, so inside
    // an instance the name resolves to that function and nothing is looked up.
    supplied := fn_binding_of(p, offset, length)
    if (supplied >= 0) {
        return supplied
    }
    // A renamed import is looked up under the name the module declares, and
    // only in that module.
    mut sought_off := offset
    mut sought_len := length
    mut wanted : i64 = -1
    held := rename_for(p, offset, length)
    if (held >= 0) {
        entry := arena_at(p.renames, held)
        sought_off = entry.exported_off
        sought_len = entry.exported_len
        wanted = entry.imported
    }
    mut i : i64 = 0
    mut found : i64 = -1
    while (i < p.fns.count) {
        entry := arena_at(p.fns, i)
        if (entry.len == sought_len
            && bytes_equal(p.src, entry.off, sought_off, sought_len)
            && name_visible(p, entry.off, entry.len, offset)
            && (wanted < 0 || module_at(p.modules, entry.off) == wanted)) {
            if (found < 0) {
                found = i
                // Nothing else can match unless two modules in this program
                // export the same name, so the rest of the scan is skipped in
                // every program that does not.
                if (p.shared_exports == 0) {
                    return found
                }
            } else {
                // Two modules this file imports both offer the name, and it
                // wrote the name, so there is no answer to give.
                held := arena_at(p.fns, found)
                report_where(p.modules, p.src, offset)
                report("'")
                report_src(p.src, offset, length)
                report("' is exported by two modules this file imports, ")
                first := arena_at(p.modules, module_at(p.modules, held.off))
                report_cstr(first.path)
                report(" and ")
                second := arena_at(p.modules, module_at(p.modules, entry.off))
                report_cstr(second.path)
                report("; read one of them under another name with `import \"...\" (")
                report_src(p.src, offset, length)
                report(" as ...)`")
                frost_rt_die()
            }
        }
        i = i + 1
    }
    if (found >= 0) {
        return found
    }
    arena_push(
        p.fns,
        Sym { off = offset, len = length, is_extern = 0, is_safe = 0,
            is_inline = 0, ret_type = TY_I64,
            params = -1, defined = 0, cap_start = 0, cap_count = 0 },
    )
}

// A name becomes defined when its `fn` or `extern fn` is parsed. A name that is
// only ever called is interned but never defined, which is a call to a function
// that does not exist.
mark_defined :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.defined = 1
}

mark_extern :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_extern = 1
}

// `safe extern fn`: the author vouched for this one, so its calls are not gated.
mark_safe :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_safe = 1
}

// `inline fn`: the C backend qualifies the definition so it is always folded in.
mark_inline :: fn(mut p: Parser, fn_index: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.is_inline = 1
}

set_ret_type :: fn(mut p: Parser, fn_index: i64, ret: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.ret_type = ret
}

set_params :: fn(mut p: Parser, fn_index: i64, params: i64) {
    entry := arena_at(p.fns, fn_index)
    entry.params = params
}

// Record one more capability for a function. They are pushed in the order they
// were declared, so a function's run is contiguous and its first push is what
// fixes where the run starts.
set_uses :: fn(mut p: Parser, fn_index: i64, ty: i64, off: i64, len: i64) {
    start := arena_push(p.caps, Cap { ty = ty, off = off, len = len })
    entry := arena_at(p.fns, fn_index)
    if (entry.cap_count == 0) {
        entry.cap_start = start
    }
    entry.cap_count = entry.cap_count + 1
}

// The nth capability a function draws.
cap_at :: fn(mut p: Parser, fn_index: i64, index: i64) -> Cap {
    sym := arena_at(p.fns, fn_index)
    held := arena_at(p.caps, sym.cap_start + index)
    Cap { ty = held.ty, off = held.off, len = held.len }
}

cap_count_of :: fn(mut p: Parser, fn_index: i64) -> i64 {
    sym := arena_at(p.fns, fn_index)
    sym.cap_count
}

node_next :: fn(mut p: Parser, id: i64) -> i64 {
    node := arena_at(p.arena, id)
    node.next
}

append_node :: fn(mut p: Parser, head: i64, extra: i64) -> i64 {
    if (head == (-1)) {
        return extra
    }
    mut tail := head
    mut following := node_next(p, tail)
    while (following != (-1)) {
        tail = following
        following = node_next(p, tail)
    }
    set_next(p, tail, extra)
    head
}

record_generic_fn :: fn(mut p: Parser, fn_index: i64, tparam_off: i64,
    tparam_len: i64, tparam_is_value: i64, tparam_is_fn: i64,
    xparam_start: i64, xparam_count: i64, token_start: i64,
    bound_token: i64, pack_off: i64, pack_len: i64, pack_fixed: i64) {
    arena_push(
        p.generic_fns,
        GenericFn { fn_index = fn_index, tparam_off = tparam_off,
            tparam_len = tparam_len, tparam_is_value = tparam_is_value,
            tparam_is_fn = tparam_is_fn,
            xparam_start = xparam_start,
            xparam_count = xparam_count, token_start = token_start,
            bound_token = bound_token, pack_off = pack_off,
            pack_len = pack_len, pack_fixed = pack_fixed },
    )
}

// The name a compile-time list's nth element takes: the list's own name, two
// underscores and the position. It is a name the body can be read against and a
// parameter the call fills once.
pack_element_name :: fn(mut p: Parser, off: i64, len: i64,
    index: i64) -> (start: i64, length: i64) {
    start := p.synth_next
    mut k : i64 = 0
    while (k < len) {
        p.src[start + k] = p.src[off + k]
        k = k + 1
    }
    p.src[start + len] = CH_UNDERSCORE
    p.src[start + len + 1] = CH_UNDERSCORE
    digits := digits_in(index)
    mut scale : i64 = 1
    mut left : i64 = 1
    while (left < digits) {
        scale = scale * 10
        left = left + 1
    }
    mut value := index
    mut written : i64 = 0
    while (written < digits) {
        digit := value / scale
        p.src[start + len + 2 + written] = cast($u8, CH_0 + digit)
        value = value - digit * scale
        scale = scale / 10
        written = written + 1
    }
    total := len + 2 + digits
    p.src[start + total] = 0
    p.synth_next = start + total + 1
    return start, total
}

// Bind one name to another while a body is read again, and answer the height to
// restore afterwards.
push_alias :: fn(mut p: Parser, from_off: i64, from_len: i64, to_off: i64,
    to_len: i64) -> i64 {
    mark := p.aliases.count
    arena_push(p.aliases, Alias { from_off = from_off, from_len = from_len,
        to_off = to_off, to_len = to_len })
    mark
}

// The name in force for a name being read, following the aliases a compile-time
// `for` put there. The most recent wins, so a nested loop shadows an outer one.
alias_for :: fn(mut p: Parser, off: i64, len: i64) -> (start: i64,
    length: i64) {
    mut i : i64 = p.aliases.count
    while (i > 0) {
        i = i - 1
        held := arena_at(p.aliases, i)
        if (held.from_len == len
            && bytes_equal(p.src, held.from_off, off, len)) {
            return held.to_off, held.to_len
        }
    }
    return off, len
}

// Register `name :: value` in the constant table. Duplicate names are harmless
// since lookup takes the first.
register_const :: fn(mut p: Parser, offset: i64, length: i64, value: i64) {
    arena_push(
        p.consts,
        ConstDef { name_off = offset, name_len = length, value = value },
    )
}

// Refuse a declaration whose name one of this module's imports already offers.
//
// The namespace is flat, so two declarations of one name are two things called
// the same thing and there is no qualifying one of them. The name interns to one
// symbol, so both bodies were emitted under it and what caught that was whichever
// assembler or C compiler read the output. The way out is to rename one of them,
// or to read the import under another name.
//
// Asked where the declaration is made, since by the time the program is parsed
// the two have become one symbol and there is nothing left to compare.
check_name_is_free :: fn(mut p: Parser, off: i64, len: i64) {
    owner := module_at(p.modules, off)
    if (owner < 0) {
        return
    }
    mut i : i64 = 0
    while (i < p.exports.count) {
        entry := arena_at(p.exports, i)
        module := entry.module
        entry_off := entry.off
        entry_len := entry.len
        if (module != owner && entry_len == len
            && bytes_equal_across(p.export_names, entry_off, p.src, off, len)
            && imports_module(p, owner, module)
            && renamed_away(p, owner, off, len) == false) {
            report_where(p.modules, p.src, off)
            report("'")
            report_src(p.src, off, len)
            report("' is declared here and also arrives from an import; rename one of them, or read the import under another name")
            frost_rt_die()
        }
        i = i + 1
    }
}

// Whether this module read that name under another one, which is what keeps both
// and is the way out the diagnostic names. A rename's two names live in the
// source buffer by the time the parser runs.
renamed_away :: fn(mut p: Parser, importer: i64, off: i64, len: i64) -> bool {
    mut i : i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        if (entry.importer == importer && entry.exported_len == len
            && bytes_equal(p.src, entry.exported_off, off, len)) {
            return true
        }
        i = i + 1
    }
    false
}

// Whether a declaration whose name sits at `decl_off` may be named from
// `use_off`. A file's own names are its own to use. Another file's are only
// what it exported. The declaration's offset is what says which file wrote it,
// so no table has to carry an owner.
//
// A program compiled from one file has one module and every name is in it, so
// this answers true on the first comparison and costs nothing.
name_visible :: fn(mut p: Parser, decl_off: i64, decl_len: i64, use_off: i64)
    -> bool {
    owner := module_at(p.modules, decl_off)
    user := module_at(p.modules, use_off)
    if (owner == user) {
        return true
    }
    // An import says what a file may name. A module the file did not import
    // has nothing to offer it, however the name got into the program.
    if (imports_module(p, user, owner) == false) {
        return false
    }
    mut i : i64 = 0
    while (i < p.exports.count) {
        entry := arena_at(p.exports, i)
        if (entry.module == owner && entry.len == decl_len
            && bytes_equal_across(p.export_names, entry.off, p.src, decl_off,
                decl_len)) {
            return true
        }
        i = i + 1
    }
    false
}

// Move each rename's two names into the source buffer, where every name lives
// once the parser is running. They were copied out of the import line before it
// was blanked.
place_renames :: fn(mut p: Parser, held: str) {
    mut i : i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        local_len := entry.local_len
        exported_len := entry.exported_len
        local_from := entry.local_off
        exported_from := entry.exported_off
        local_at := p.synth_next
        copy_name(p.src, local_at, held, local_from, local_len)
        p.src[local_at + local_len] = 0
        exported_at := local_at + local_len + 1
        copy_name(p.src, exported_at, held, exported_from, exported_len)
        p.src[exported_at + exported_len] = 0
        p.synth_next = exported_at + exported_len + 1
        moved := arena_at(p.renames, i)
        moved.local_off = local_at
        moved.exported_off = exported_at
        i = i + 1
    }
}

// The rename a file wrote for a name it is using, or -1. A file reads a name
// under whatever it called it, and the module it came from is pinned, so two
// imports offering the same name stay apart.
rename_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.renames.count == 0) {
        return -1
    }
    user := module_at(p.modules, offset)
    mut i : i64 = 0
    while (i < p.renames.count) {
        entry := arena_at(p.renames, i)
        if (entry.importer == user && entry.local_len == length
            && bytes_equal(p.src, entry.local_off, offset, length)) {
            return i
        }
        i = i + 1
    }
    -1
}

// Whether one module imports another directly. A file compiled on its own has
// no modules recorded and no edges, and everything in it belongs to the root,
// which the caller has already answered for.
imports_module :: fn(mut p: Parser, importer: i64, imported: i64) -> bool {
    mut i : i64 = 0
    while (i < p.import_edges.count) {
        edge := arena_at(p.import_edges, i)
        if (edge.importer == importer && edge.imported == imported) {
            return true
        }
        i = i + 1
    }
    false
}

// If a name is a declared constant, return its value through `out` (as the
// return) and true, otherwise false. Consts are looked up by byte comparison.
const_value :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.consts.count) {
        entry := arena_at(p.consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

// The node a struct constant's literal parsed to, or -1 for a name that is not
// one. A struct constant is its value wherever it is named, so every use writes
// that node out again rather than referring to storage somewhere.
value_const_node :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.value_consts.count) {
        entry := arena_at(p.value_consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

is_const :: fn(mut p: Parser, offset: i64, length: i64) -> bool {
    mut i : i64 = 0
    while (i < p.consts.count) {
        entry := arena_at(p.consts, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return true
        }
        i = i + 1
    }
    false
}

is_main_name :: fn(src: str, offset: i64, length: i64) -> bool {
    if (length != 4) {
        return false
    }
    src[offset] == 109 && src[offset + 1] == 97
        && src[offset + 2] == 105
        && src[offset + 3] == 110
}

// ---------------------------------------------------------------------------
// Parsing.
// ---------------------------------------------------------------------------

// Where a node is, for a diagnostic to point at.
//
// The plain forms stamp where the cursor is now, which is after the node's
// children have been read, so a node built out of anything carries the offset
// of the token past it. That is why every diagnostic this compiler wrote landed
// one construct late: an error about a binding on line five was reported at the
// statement on line eight.
//
// The `_at` forms take the offset instead, and a parser that builds a node out
// of children captures it before reading them. The plain forms stay for the
// nodes with no children, where now and the start are the same place.
new_node_at :: fn(mut p: Parser, kind: NodeKind, a: i64, b: i64, val: i64,
    at: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = kind, a = a, b = b, c = 0, val = val, next = -1, pos = at },
    )
}

new_node :: fn(mut p: Parser, kind: NodeKind, a: i64, b: i64, val: i64) -> i64 {
    held := cur_off(p)
    new_node_at(p, kind, a, b, val, held)
}

// A node that names a local by its source byte range: `val` is the offset and
// `c` is the length, so code generation re-emits the identifier text directly.
// This is what lets locals become named C variables instead of `v[]` slots.
new_named_node_at :: fn(mut p: Parser, kind: NodeKind, child: i64,
    offset: i64, length: i64, at: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = kind, a = child, b = 0, c = length, val = offset,
            next = -1, pos = at },
    )
}

new_named_node :: fn(mut p: Parser, kind: NodeKind, child: i64, offset: i64,
    length: i64) -> i64 {
    held := cur_off(p)
    new_named_node_at(p, kind, child, offset, length, held)
}

// A local binding. `b` carries the annotated type, or -1 to infer the type from
// the initializer. An annotation wins where the initializer alone does not pin
// the type down, as a value read back at a narrower type than it was stored.
new_let_node :: fn(mut p: Parser, value: i64, offset: i64, length: i64,
    annotation: i64) -> i64 {
    arena_push(
        p.arena,
        // The name it binds, which is where the binding is. The cursor is past
        // the whole statement by now, since the value has been read.
        Node { kind = NodeKind::Let, a = value, b = annotation, c = length,
            val = offset, next = -1, pos = offset },
    )
}

new_func_node :: fn(mut p: Parser, body: i64, params: i64, fn_index: i64,
    is_main: i64) -> i64 {
    arena_push(
        p.arena,
        Node {
            kind = NodeKind::Func,
            a = body,
            b = params,
            c = is_main,
            val = fn_index,
            next = -1,
            pos = cur_off(p),
        },
    )
}

set_next :: fn(mut p: Parser, id: i64, next_id: i64) {
    node := arena_at(p.arena, id)
    node.next = next_id
}

// A field access `base.name`: `a` is the base expression, `val`/`c` the field
// name's byte range.
new_field_node :: fn(mut p: Parser, base: i64, offset: i64, length: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = NodeKind::Field, a = base, b = 0, c = length, val = offset,
            next = -1, pos = cur_off(p) },
    )
}

// A struct literal `Name { ... }`: `val` is the struct's table index and `a` is
// the head of a linked list of NodeKind::FieldInit nodes.
new_struct_lit :: fn(mut p: Parser, struct_index: i64, inits: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = NodeKind::StructLit, a = inits, b = 0, c = 0,
            val = struct_index, next = -1, pos = cur_off(p) },
    )
}

// One `name = value` inside a struct literal: `a` is the value, `val`/`c` the
// field name's byte range, `next` the following initializer.
new_field_init :: fn(mut p: Parser, value: i64, offset: i64, length: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = NodeKind::FieldInit, a = value, b = 0, c = length,
            val = offset, next = -1, pos = cur_off(p) },
    )
}

set_field_next :: fn(mut p: Parser, id: i64, next_id: i64) {
    field := arena_at(p.fields, id)
    field.next = next_id
}

// A `distinct` type, a name of its own for another type's representation.
is_distinct :: fn(ty: i64) -> bool {
    ty >= DISTINCT_BASE
}

// What a distinct type is represented by, which is what everything but the
// identity check wants: its size, its alignment, how it travels to C, and which
// register it goes in. Anything else answers with itself, so this can sit at the
// front of every type predicate.
distinct_repr :: fn(ty: i64) -> i64 {
    if (ty < DISTINCT_BASE) {
        return ty
    }
    (ty - DISTINCT_BASE) / DISTINCT_STRIDE
}

// Whether a type code is a set of bits rather than an ordinary distinct type.
// The bit table is the only record of the difference, so this asks it. A
// program has a handful of these, and the answer is wanted only where a flags
// type could be one of the operands.
is_flags_type :: fn(mut p: Parser, ty: i64) -> bool {
    if (is_distinct(ty) == false) {
        return false
    }
    mut i : i64 = 0
    while (i < p.flag_bits.count) {
        entry := arena_at(p.flag_bits, i)
        if (entry.ty == ty) {
            return true
        }
        i = i + 1
    }
    false
}

// The number a bit of `ty` stands for, or -1 when the type names no such bit.
flag_bit_value :: fn(mut p: Parser, ty: i64, off: i64, len: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.flag_bits.count) {
        entry := arena_at(p.flag_bits, i)
        if (entry.ty == ty && entry.name_len == len
            && bytes_equal(p.src, entry.name_off, off, len)) {
            return entry.value
        }
        i = i + 1
    }
    -1
}

record_flag_bit :: fn(mut p: Parser, ty: i64, off: i64, len: i64, value: i64) {
    arena_push(p.flag_bits,
        FlagBit { ty = ty, name_off = off, name_len = len, value = value })
}

// The identity half: which declaration this is. Two distinct types over the
// same representation differ only here.
distinct_id :: fn(ty: i64) -> i64 {
    (ty - DISTINCT_BASE) % DISTINCT_STRIDE
}

// The code for the `index`th distinct type declared in this program, over
// `repr`. A distinct type over a distinct type is represented by what the inner
// one is represented by, so the representation stored is never itself distinct
// and no lookup ever has to walk a chain.
distinct_type :: fn(repr: i64, index: i64) -> i64 {
    DISTINCT_BASE + distinct_repr(repr) * DISTINCT_STRIDE + index
}

// Write a type the way the source writes it, for a diagnostic. A distinct type
// is named, since the name is the whole of what is being complained about.
report_type_name :: fn(mut p: Parser, ty: i64) {
    if (is_distinct(ty)) {
        mut a : i64 = 0
        while (a < p.type_aliases.count) {
            entry := arena_at(p.type_aliases, a)
            if (entry.value == ty) {
                report_src(p.src, entry.name_off, entry.name_len)
                return
            }
            a = a + 1
        }
    }
    held := distinct_repr(ty)
    if (held == TY_I64) { report("i64")   return }
    if (held == TY_I32) { report("i32")   return }
    if (held == TY_I16) { report("i16")   return }
    if (held == TY_I8) { report("i8")     return }
    if (held == TY_ISIZE) { report("isize") return }
    if (held == TY_U64) { report("u64")   return }
    if (held == TY_U32) { report("u32")   return }
    if (held == TY_U16) { report("u16")   return }
    if (held == TY_U8) { report("u8")     return }
    if (held == TY_USIZE) { report("usize") return }
    if (held == TY_F64) { report("f64")   return }
    if (held == TY_F32) { report("f32")   return }
    if (held == TY_BOOL) { report("bool") return }
    if (held == TY_VOID) { report("nothing") return }
    if (held == TY_HANDLE) { report("Handle") return }
    if (is_pointer(held)) {
        report("^")
        report_type_name(p, pointee(p, held))
        return
    }
    if (is_array_ty(held)) {
        report("[]")
        report_type_name(p, array_element(p, held))
        return
    }
    if (is_struct_ty(held)) {
        def := arena_at(p.structs, struct_index_of(held))
        report_src(p.src, def.name_off, def.name_len)
        return
    }
    report("a value")
}

// A type's name as text in the room past the source, which is what `typename`
// answers with. The same walk `report_type_name` does, writing bytes instead of
// reporting them, so the two cannot drift about what a type is called.
synth_type_name :: fn(mut p: Parser, ty: i64) -> (off: i64, len: i64) {
    start := p.synth_next
    write_type_name(p, ty)
    length := p.synth_next - start
    p.src[p.synth_next] = 0
    p.synth_next = p.synth_next + 1
    return start, length
}

synth_bytes :: fn(mut p: Parser, word: ^i8) {
    length := cstr_len(word)
    synth_room_for(p, length + 1)
    mut k : i64 = 0
    while (k < length) {
        p.src[p.synth_next + k] = cast($u8, byte_at(word, k))
        k = k + 1
    }
    p.synth_next = p.synth_next + length
}

synth_range :: fn(mut p: Parser, off: i64, len: i64) {
    synth_room_for(p, len + 1)
    mut k : i64 = 0
    while (k < len) {
        p.src[p.synth_next + k] = p.src[off + k]
        k = k + 1
    }
    p.synth_next = p.synth_next + len
}

write_type_name :: fn(mut p: Parser, ty: i64) {
    if (is_distinct(ty)) {
        mut a : i64 = 0
        while (a < p.type_aliases.count) {
            entry := arena_at(p.type_aliases, a)
            if (entry.value == ty) {
                synth_range(p, entry.name_off, entry.name_len)
                return
            }
            a = a + 1
        }
    }
    held := distinct_repr(ty)
    if (held == TY_I64) { synth_bytes(p, "i64")     return }
    if (held == TY_I32) { synth_bytes(p, "i32")     return }
    if (held == TY_I16) { synth_bytes(p, "i16")     return }
    if (held == TY_I8) { synth_bytes(p, "i8")       return }
    if (held == TY_ISIZE) { synth_bytes(p, "isize") return }
    if (held == TY_U64) { synth_bytes(p, "u64")     return }
    if (held == TY_U32) { synth_bytes(p, "u32")     return }
    if (held == TY_U16) { synth_bytes(p, "u16")     return }
    if (held == TY_U8) { synth_bytes(p, "u8")       return }
    if (held == TY_USIZE) { synth_bytes(p, "usize") return }
    if (held == TY_F64) { synth_bytes(p, "f64")     return }
    if (held == TY_F32) { synth_bytes(p, "f32")     return }
    if (held == TY_BOOL) { synth_bytes(p, "bool")   return }
    if (held == TY_VOID) { synth_bytes(p, "void")   return }
    if (held == TY_HANDLE) { synth_bytes(p, "Handle") return }
    if (is_pointer(held)) {
        synth_bytes(p, "^")
        write_type_name(p, pointee(p, held))
        return
    }
    if (is_array_ty(held)) {
        synth_bytes(p, "[]")
        write_type_name(p, array_element(p, held))
        return
    }
    if (is_struct_ty(held)) {
        def := arena_at(p.structs, struct_index_of(held))
        synth_range(p, def.name_off, def.name_len)
        return
    }
    synth_bytes(p, "a value")
}

// The sentence that says which rule was broken, when the rule is the one about
// nominal types. Nothing is written when some other mismatch is at fault.
// `value` is the node that was written, since a number where a set of bits
// belongs is a different mistake from a value of the wrong type.
report_distinct_note :: fn(mut p: Parser, value: i64, from: i64, to: i64) {
    if (is_flags_type(p, to)) {
        if (written_number(p, value)) {
            report("; a set of bits is built from the names declared under it, and a number is not one of them")
            return
        }
        report("; a set of bits is built only from the names declared under it")
        return
    }
    if (is_distinct(to) && from != to) {
        report("; a distinct type is not its representation")
    }
}

// Whether what was written is a number rather than a name. A bit of a flags
// type is also a Num node, and carries its type, which is what tells them
// apart.
written_number :: fn(mut p: Parser, value: i64) -> bool {
    if (value < 0) {
        return false
    }
    node := arena_at(p.arena, value)
    node.kind == NodeKind::Num && node.b == 0
}

// Indirect: a raw pointer or a borrow, both a C pointer and both auto-derefed.
// A pointer (raw or borrow) is 8 bytes and emits a trailing `*`. The value
// generic codes and the function-pointer codes ride above CONST_BASE and are
// not pointers, even though they are numerically larger. A value is resolved
// away before it is a type, and a function pointer emits its own declarator.
is_pointer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return true
    }
    held >= POINTER_BASE && held < CONST_BASE
}

// A borrow carries the flag. A raw pointer is indirect without it. An
// indirection over a distinct type carries the same difference in the low bit
// of its code, so this answers for one without reading the table.
is_borrow :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return (held - INDIRECT_BASE) % 2 == 1
    }
    held >= BORROW_FLAG && held < CONST_BASE
}

is_raw_pointer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        return (held - INDIRECT_BASE) % 2 == 0
    }
    held >= POINTER_BASE && held < BORROW_FLAG
}

// Whether the code names an indirection over a distinct type, which is the one
// shape that is looked up rather than added. See `Indirect` in core.frost.
is_indirect :: fn(ty: i64) -> bool {
    ty >= INDIRECT_BASE && ty < POINTER_BASE
}

// `^T` and a borrow of `T`. Every type but a distinct one composes by adding a
// base to what is pointed at; a distinct type's code already sits above every
// base, so those are interned here instead and the code is an index.
pointer_to :: fn(mut p: Parser, target: i64) -> i64 {
    if (is_distinct(target) == false) {
        return POINTER_BASE + target
    }
    indirect_of(p, target, 0)
}

borrow_of :: fn(mut p: Parser, target: i64) -> i64 {
    if (is_distinct(target) == false) {
        return BORROW_FLAG + target
    }
    indirect_of(p, target, 1)
}

// Deduplicated, so two spellings of `^Meters` share a code and comparing two
// types stays a comparison of two numbers.
indirect_of :: fn(mut p: Parser, target: i64, borrow: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.indirects.count) {
        entry := arena_at(p.indirects, i)
        if (entry.target == target && entry.borrow == borrow) {
            return INDIRECT_BASE + i * 2 + borrow
        }
        i = i + 1
    }
    made := arena_push(p.indirects,
        Indirect { target = target, borrow = borrow })
    INDIRECT_BASE + made * 2 + borrow
}

// A function pointer: the address of a function of a given signature, a
// callable value. It is not a data pointer, so it is never dereferenced,
// indexed, or gated. It is called, directly through a name or through a cast on
// a value of this type.
is_proc :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= PROC_BASE && held < FN_BASE
}

// Intern a function-pointer signature and answer its type code. Signatures are
// deduplicated so two spellings of the same one share a code.
proc_of :: fn(mut p: Parser, ret: i64, param_start: i64, param_count: i64)
    -> i64 {
    mut i : i64 = 0
    while (i < p.procs.count) {
        entry := arena_at(p.procs, i)
        if (entry.ret == ret && entry.param_count == param_count
            && gargs_run_equal(p, entry.param_start, param_start, param_count)) {
            return PROC_BASE + i
        }
        i = i + 1
    }
    PROC_BASE + arena_push(p.procs,
        ProcSig { ret = ret, param_start = param_start,
            param_count = param_count })
}

proc_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - PROC_BASE
}

proc_ret :: fn(mut p: Parser, ty: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    entry.ret
}

proc_param_count :: fn(mut p: Parser, ty: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    entry.param_count
}

proc_param_at :: fn(mut p: Parser, ty: i64, n: i64) -> i64 {
    entry := arena_at(p.procs, proc_index_of(ty))
    param := arena_at(p.proc_params, entry.param_start + n)
    param.value
}

// Compare two runs in the `proc_params` arena, the same shape as gargs_equal is
// for gargs, so a signature's parameter run can be deduplicated.
gargs_run_equal :: fn(mut p: Parser, a_start: i64, b_start: i64, count: i64)
    -> bool {
    mut i : i64 = 0
    while (i < count) {
        left := arena_at(p.proc_params, a_start + i)
        right := arena_at(p.proc_params, b_start + i)
        if (left.value != right.value) {
            return false
        }
        i = i + 1
    }
    true
}

// Whether a name written at `off` belongs to the unit being emitted. Everything
// belongs to a whole-program unit. A per-module unit takes what the module it is
// for wrote, which is a run of the one source buffer, so this is a comparison
// rather than a search. Both backends split a program the same way and ask this
// the same way.
// Whether an offset is inside any module's text at all. A name the compiler
// made up, such as the one a `test` block's body is given, sits past every
// module in the room after the source, so it belongs to no module by this
// question and its body's position is what answers instead.
in_any_module :: fn(mut p: Parser, off: i64) -> bool {
    mut i : i64 = 0
    while (i < p.modules.count) {
        entry := arena_at(p.modules, i)
        if (off >= entry.start && off < entry.finish) {
            return true
        }
        i = i + 1
    }
    false
}

unit_holds :: fn(mut p: Parser, off: i64) -> bool {
    if (p.emit_module < 0) {
        return true
    }
    entry := arena_at(p.modules, p.emit_module)
    off >= entry.start && off < entry.finish
}

pointee :: fn(mut p: Parser, ty: i64) -> i64 {
    held := distinct_repr(ty)
    if (is_indirect(held)) {
        entry := arena_at(p.indirects, (held - INDIRECT_BASE) / 2)
        return entry.target
    }
    if (is_borrow(held)) {
        return held - BORROW_FLAG
    }
    held - POINTER_BASE
}

is_struct_ty :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= STRUCT_BASE && held < ARRAY_BASE
}
// Whether a type is an integer, which is one of the questions a `where` bound
// may ask. `bool` is not one: it is one byte holding a truth value, and
// arithmetic on it means nothing.
is_integer :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held == TY_I8 || held == TY_I16 || held == TY_I32 || held == TY_I64
        || held == TY_ISIZE || held == TY_U8 || held == TY_U16
        || held == TY_U32 || held == TY_U64 || held == TY_USIZE
}

is_float :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held == TY_F32 || held == TY_F64
}
is_array_ty :: fn(ty: i64) -> bool {
    held := distinct_repr(ty)
    held >= ARRAY_BASE && held < INDIRECT_BASE
}

// Everything wider than a register, which is everything this compiler holds by
// address rather than in one: a struct, a fixed array, and a slice, which is a
// pointer beside a length.
is_aggregate :: fn(ty: i64) -> bool {
    is_struct_ty(ty) || is_array_ty(ty)
}

// The one table holds both, so a slice is told from an array by having no
// length of its own rather than by a separate code.
array_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - ARRAY_BASE
}

array_element :: fn(mut p: Parser, ty: i64) -> i64 {
    def := arena_at(p.arrays, array_index_of(ty))
    def.element
}

array_length :: fn(mut p: Parser, ty: i64) -> i64 {
    def := arena_at(p.arrays, array_index_of(ty))
    def.length
}

is_slice_ty :: fn(mut p: Parser, ty: i64) -> bool {
    is_array_ty(ty) && array_length(p, ty) < 0
}

// One code per (element, length) pair, so two spellings of the same array are
// the same type and the backends can key their declarations on the code.
array_of :: fn(mut p: Parser, element: i64, length: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.arrays.count) {
        entry := arena_at(p.arrays, i)
        if (entry.element == element && entry.length == length) {
            return ARRAY_BASE + i
        }
        i = i + 1
    }
    ARRAY_BASE + arena_push(p.arrays,
        ArrayDef { element = element, length = length, emitted = 0 })
}

struct_index_of :: fn(ty: i64) -> i64 {
    distinct_repr(ty) - STRUCT_BASE
}

// The field-table index of a struct field named by a literal, or -1 if there
// is none. A pointer to the struct is looked through, so `mut s: Slab` (a
// borrow) answers the same as a value.
slab_field_id :: fn(mut p: Parser, struct_ty: i64, name: ^i8) -> i64 {
    mut base := struct_ty
    if (is_pointer(base)) {
        base = pointee(p, base)
    }
    if (is_struct_ty(base) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(base))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (str_range_eq(p.src, field.name_off, field.name_len, name)) {
            return fid
        }
        fid = field.next
    }
    -1
}

// The type of a struct field named by a literal, or -1 if there is none.
slab_field_type :: fn(mut p: Parser, struct_ty: i64, name: ^i8) -> i64 {
    fid := slab_field_id(p, struct_ty, name)
    if (fid == (-1)) {
        return -1
    }
    field := arena_at(p.fields, fid)
    field.ty
}

// A slab is a struct the compiler indexes by a handle. It is recognized
// structurally: a `storage` array holding the elements and a parallel
// `generations` array, one i64 per slot. That shape, not a declared type, is
// what lets `slab[handle]` lower to a bounds- and generation-checked place.
is_slab_ty :: fn(mut p: Parser, struct_ty: i64) -> bool {
    storage := slab_field_type(p, struct_ty, "storage")
    generations := slab_field_type(p, struct_ty, "generations")
    is_array_ty(storage) && is_array_ty(generations)
}

// The type of the field of `struct_ty` whose name is the byte range
// (off, len), or -1. The byte-range twin of `slab_field_type`, so one
// synthesized field can be matched against another struct's field by name
// without a C string.
field_type_by_range :: fn(mut p: Parser, struct_ty: i64, off: i64, len: i64)
    -> i64 {
    mut base := struct_ty
    if (is_pointer(base)) {
        base = pointee(p, base)
    }
    if (is_struct_ty(base) == false) {
        return -1
    }
    def := arena_at(p.structs, struct_index_of(base))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        if (field.name_len == len
            && bytes_equal(p.src, field.name_off, off, len)) {
            return field.ty
        }
        fid = field.next
    }
    -1
}

// A columns container: the SoA sibling of a slab. It keeps the same
// generational bookkeeping (`generations` + `free_list`) but stores its
// elements as one array per field of the element type rather than one
// `storage` array of whole elements. Recognized structurally by that shape:
// parallel `generations` and `free_list` arrays and no `storage` array, which
// is what tells it apart from a slab.
is_columns_ty :: fn(mut p: Parser, struct_ty: i64) -> bool {
    generations := slab_field_type(p, struct_ty, "generations")
    free_list := slab_field_type(p, struct_ty, "free_list")
    storage := slab_field_type(p, struct_ty, "storage")
    is_array_ty(generations) && is_array_ty(free_list) && storage == (-1)
}

// Every field of the element struct `element` has a matching `[N]field` column
// array in `candidate`, so `candidate` is the columns container for `element`.
columns_fields_match :: fn(mut p: Parser, candidate: i64, element: i64) -> bool {
    if (is_struct_ty(element) == false) {
        return false
    }
    def := arena_at(p.structs, struct_index_of(element))
    mut fid := def.field_head
    while (fid != (-1)) {
        field := arena_at(p.fields, fid)
        col := field_type_by_range(p, candidate, field.name_off, field.name_len)
        if (is_array_ty(col) == false) {
            return false
        }
        if (array_element(p, col) != field.ty) {
            return false
        }
        fid = field.next
    }
    true
}

// `columns_new()` is a compiler builtin, not a real function. It stands for a
// zeroed container of the type the context wants, recognized by name at the
// call node so neither backend emits a real call to it.
is_columns_new_call :: fn(mut p: Parser, value: i64) -> bool {
    node := arena_at(p.arena, value)
    if (node.kind != NodeKind::Call) {
        return false
    }
    sym := arena_at(p.fns, node.val)
    str_range_eq(p.src, sym.off, sym.len, "columns_new")
}

// Whether a columns field is the container's own generational bookkeeping
// rather than a column of the element. A scatter or gather touches only the
// element columns, skipping these three.
is_columns_bookkeeping :: fn(mut p: Parser, off: i64, len: i64) -> bool {
    str_range_eq(p.src, off, len, "generations")
        || str_range_eq(p.src, off, len, "free_list")
        || str_range_eq(p.src, off, len, "free_count")
}

// An already-synthesized columns container for element `element` at capacity
// `count`, or -1. Structural dedup so the same `columns<T,N>` written in two
// places is one type, which is what lets a value pass between functions.
columns_lookup :: fn(mut p: Parser, element: i64, count: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.structs.count) {
        candidate := STRUCT_BASE + i
        if (is_columns_ty(p, candidate)) {
            gens := slab_field_type(p, candidate, "generations")
            if (array_length(p, gens) == count
                && columns_fields_match(p, candidate, element)) {
                return candidate
            }
        }
        i = i + 1
    }
    -1
}

// Resolve a type name (byte range) to a type code: the current generic type
// parameter (bound to its concrete type while monomorphizing, otherwise the
// TY_PARAM placeholder), a primitive keyword, or the named struct. A generic
// template struct is not returned here. `Name<Arg>` instantiation is handled in
// parse_type. An unknown name falls back to i64.
type_code_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        if (p.binding_active == 1) {
            return p.type_binding
        }
        return TY_PARAM
    }
    // A parameter beyond the first is bound on the `gbindings` stack while its
    // generic's body is re-parsed. The most recent binding wins, so a nested
    // instantiation shadows an outer one. What comes back is the bound type, or
    // for a value parameter the CONST_BASE-encoded number, which is what lets a
    // nested `Slab<T, N>` pass the value on.
    mut b : i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return binding.bound
        }
    }
    mut a : i64 = 0
    while (a < p.type_aliases.count) {
        entry := arena_at(p.type_aliases, a)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return entry.value
        }
        a = a + 1
    }
    if (str_range_eq(p.src, offset, length, "i64")) { return TY_I64 }
    if (str_range_eq(p.src, offset, length, "i32")) { return TY_I32 }
    if (str_range_eq(p.src, offset, length, "i16")) { return TY_I16 }
    if (str_range_eq(p.src, offset, length, "i8")) { return TY_I8 }
    if (str_range_eq(p.src, offset, length, "isize")) { return TY_ISIZE }
    if (str_range_eq(p.src, offset, length, "u64")) { return TY_U64 }
    if (str_range_eq(p.src, offset, length, "u32")) { return TY_U32 }
    if (str_range_eq(p.src, offset, length, "u16")) { return TY_U16 }
    if (str_range_eq(p.src, offset, length, "u8")) { return TY_U8 }
    if (str_range_eq(p.src, offset, length, "usize")) { return TY_USIZE }
    if (str_range_eq(p.src, offset, length, "f64")) { return TY_F64 }
    if (str_range_eq(p.src, offset, length, "f32")) { return TY_F32 }
    if (str_range_eq(p.src, offset, length, "str")) {
        return array_of(p, TY_U8, -1)
    }
    if (str_range_eq(p.src, offset, length, "bool")) { return TY_BOOL }
    mut i : i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.is_generic == 0 && entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return STRUCT_BASE + i
        }
        i = i + 1
    }
    TY_I64
}

// True when two argument runs in the `gargs` arena hold the same values.
gargs_equal :: fn(mut p: Parser, a_start: i64, b_start: i64, count: i64) -> bool {
    mut i : i64 = 0
    while (i < count) {
        left := arena_at(p.gargs, a_start + i)
        right := arena_at(p.gargs, b_start + i)
        if (left.value != right.value) {
            return false
        }
        i = i + 1
    }
    true
}

// The number a value generic parameter is bound to, or -1 when the name is not
// a bound value parameter. A value binding, whether the primary one or one on
// the stack, holds CONST_BASE plus the number. This hands back the number, for
// an array length `[N]T` or an occurrence of `N` in an expression.
value_binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)
        && p.type_binding >= CONST_BASE && p.type_binding < PROC_BASE) {
        return p.type_binding - CONST_BASE
    }
    mut b : i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)
            && binding.bound >= CONST_BASE && binding.bound < PROC_BASE) {
            return binding.bound - CONST_BASE
        }
    }
    -1
}

// What a compile-time parameter is bound to right now, whatever kind it is, or
// -1 when the name is bound to nothing. This is how a name that will be a
// number is told from one that already is something else.
binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        return p.type_binding
    }
    mut b : i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return binding.bound
        }
    }
    -1
}

// The function a compile-time function parameter is bound to, or -1 when the
// name is not one. A binding holds FN_BASE plus an index into the `fns` table,
// so what comes back is the index of whichever function the call site passed.
fn_binding_of :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    if (p.binding_active == 1 && p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)
        && p.type_binding >= FN_BASE) {
        return p.type_binding - FN_BASE
    }
    mut b : i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)
            && binding.bound >= FN_BASE) {
            return binding.bound - FN_BASE
        }
    }
    -1
}

// Whether a name is a type: a bound generic parameter, an alias, a primitive,
// or a declared struct. `$Entity` and `$sort_less` are both written the same
// way at a call, and this is what tells the type argument from the function
// argument.
is_type_name :: fn(mut p: Parser, offset: i64, length: i64) -> bool {
    if (p.type_param_len == length
        && bytes_equal(p.src, p.type_param_off, offset, length)) {
        return true
    }
    mut b : i64 = p.gbindings.count
    while (b > 0) {
        b = b - 1
        binding := arena_at(p.gbindings, b)
        if (binding.name_len == length
            && bytes_equal(p.src, binding.name_off, offset, length)) {
            return true
        }
    }
    mut a : i64 = 0
    while (a < p.type_aliases.count) {
        entry := arena_at(p.type_aliases, a)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return true
        }
        a = a + 1
    }
    if (str_range_eq(p.src, offset, length, "i64")) { return true }
    if (str_range_eq(p.src, offset, length, "i32")) { return true }
    if (str_range_eq(p.src, offset, length, "i16")) { return true }
    if (str_range_eq(p.src, offset, length, "i8")) { return true }
    if (str_range_eq(p.src, offset, length, "isize")) { return true }
    if (str_range_eq(p.src, offset, length, "u64")) { return true }
    if (str_range_eq(p.src, offset, length, "u32")) { return true }
    if (str_range_eq(p.src, offset, length, "u16")) { return true }
    if (str_range_eq(p.src, offset, length, "u8")) { return true }
    if (str_range_eq(p.src, offset, length, "usize")) { return true }
    if (str_range_eq(p.src, offset, length, "f64")) { return true }
    if (str_range_eq(p.src, offset, length, "f32")) { return true }
    if (str_range_eq(p.src, offset, length, "str")) { return true }
    if (str_range_eq(p.src, offset, length, "bool")) { return true }
    if (str_range_eq(p.src, offset, length, "Handle")) { return true }
    if (str_range_eq(p.src, offset, length, "columns")) { return true }
    mut i : i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        if (entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)) {
            return true
        }
        i = i + 1
    }
    false
}

// Find the index of a generic struct template by name, or -1.
generic_index_for :: fn(mut p: Parser, offset: i64, length: i64) -> i64 {
    mut i : i64 = 0
    while (i < p.structs.count) {
        entry := arena_at(p.structs, i)
        // A template still holding only its name has no body to instantiate
        // from, so a generic named before it is declared is left unresolved
        // rather than re-parsed from the top of the file.
        if (entry.is_generic == 1 && entry.declared == 1
            && entry.name_len == length
            && bytes_equal(p.src, entry.name_off, offset, length)
            && name_visible(p, entry.name_off, entry.name_len, offset)) {
            return i
        }
        i = i + 1
    }
    -1
}

// A unary node wrapping a single child expression (deref, address-of).
new_unary_at :: fn(mut p: Parser, kind: NodeKind, child: i64,
    at: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = kind, a = child, b = 0, c = 0, val = 0, next = -1, pos = at },
    )
}

new_unary :: fn(mut p: Parser, kind: NodeKind, child: i64) -> i64 {
    held := cur_off(p)
    new_unary_at(p, kind, child, held)
}

// An index node `base[index]`: `a` is the base, `b` the index expression. The
// position is the `[`, taken before the index is parsed. Reading it off the
// parser afterwards named the token past the `]`, so a diagnostic about an
// index landed on the statement after the one holding it.
new_index :: fn(mut p: Parser, base: i64, index: i64, at: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = NodeKind::Index, a = base, b = index, c = 0, val = 0,
            next = -1, pos = at },
    )
}

// A node carrying a type code in `val` (ptr_cast target, sizeof operand) and an
// optional expression in `a`.
new_type_node :: fn(mut p: Parser, kind: NodeKind, expr: i64, ty: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = kind, a = expr, b = 0, c = 0, val = ty, next = -1, pos = cur_off(p) },
    )
}

// One arm of a match: `a` is the body statement, `val` the integer pattern, and
// `c` a flag marking the `_` default arm.
new_case :: fn(mut p: Parser, body: i64, value: i64, is_default: i64) -> i64 {
    arena_push(
        p.arena,
        Node { kind = NodeKind::Case, a = body, b = 0, c = is_default, val = value,
            next = -1, pos = cur_off(p) },
    )
}

