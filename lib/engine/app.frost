// The window, the device, the world and the tables a drawing program keeps, as
// one thing opened once and given back once.
//
//     main :: fn() -> i64 {
//         match app_open(app_config("Frost", WIDTH, HEIGHT)) {
//             case Result::Ok { value }: run(value)
//             case Result::Err { error }: app_failed(error)
//         }
//     }
//
//     run :: fn(move app: App) -> i64 {
//         app_insert_resource(app, scene)
//         app_run(
//             $declare_passes,
//             $before_frame,
//             $record_pass,
//             app,
//             camera_system,
//             escape_system,
//             spin_system
//         )
//         app_close(app)
//     }
//
// What a program still writes for itself is what it draws: the shader, the
// pipeline, the passes and how they are wired. Everything above that is the
// same in every one of them, which is what this is.
//
// The graph is the renderer's, and what a program says into it is named at the
// call. Which passes exist, what each reads and writes and what each records is
// the whole of what one program has to say, and it says it once on the way into
// the first frame, after every plugin has had its turn. Scheduling and the first
// size are the App's, so a program declares passes and never orders them.
//
// A call names the function it goes to, so each of those is a `$` argument
// rather than a pointer the App holds: `app_run` is a generic, and the
// specialization it stamps out calls `declare_passes`, `before_frame` and
// `record_pass` by name. What a program does not write takes the default that
// does nothing. A pass says which of the program's passes it is with a number
// it declared, and the program answers that number with a `match` or an `if`
// chain, ending in `app_engine_record` for the one the engine declared.
//
// State a pass reads lives in the world as a resource rather than behind a
// pointer the App kept, which is what `app_insert_resource` above is for.
//
// `main` is two calls because a window that did not open is a value rather than
// a flag: `app_open` gives back whatever it took before answering with a
// failure, so there is no half-open App and nothing to check for.

import "../platform/platform.frost"
import "../renderer/wgpu.frost"
import "../renderer/renderer.frost"
import "../renderer/frame.frost"
import "../renderer/graph.frost"
import "../renderer/geometry.frost"
import "../renderer/mesh.frost"
import "../renderer/material.frost"
import "../renderer/render_world.frost"
import "light.frost"
import "log.frost"
import "../renderer/lit.frost"
import "../renderer/cluster.frost"
import "world.frost"
import "scene_sync.frost"
import "camera.frost"
import "ecs.frost"
import "vec.frost"
import "mem.frost"
import "math.frost"
import "io.frost"
import "strings.frost"

// Stopping, which a module that needs it declares for itself: neither
// `ecs.frost` nor the wgpu binding hands these out.
frost_rt_error :: extern fn(text: ^i8)
frost_rt_die :: safe extern fn()

export AppConfig, App, AppError, AppFault, app_config, app_open, app_close,
    app_failed, app_install, app_install_if_absent,
    Plugin,
    engine_plugin,
    app_run, ENGINE_LIT_PASS, app_engine_record,
    declares_nothing, rebuilds_nothing, draws_nothing, records_nothing,
    dispatches_nothing, each_frame_nothing,
    log_plugin, app_log, render_plugin,
    app_run_with,
    app_insert_resource, app_insert_state,
    camera_system, escape_system,
    app_next, app_extract, app_draw,
    app_device, app_queue, app_format, app_ids, app_input,
    app_width, app_height, app_camera, app_camera_set, app_view

// How big a program says it is before it opens. The three rooms are the ones
// that cannot grow: the geometry buffers and every table measured against a
// draw are sized once, since a buffer that grew would move and every span
// handed out is a place in the one that was there.
AppConfig :: struct {
    title: str,
    width: i64,
    height: i64,
    // How many things may be drawn at once, which is what the run holds.
    drawn: i64,
    // How many distinct meshes and how many distinct materials. Three numbers
    // rather than one, because they count different things: a scene of a
    // thousand crates is one mesh and one material, and a table sized by the
    // largest of the three is either wasteful or too small. `materials_add`
    // past the end answers with the last slot rather than growing, so a
    // registry sized by the wrong number draws the wrong material and says
    // nothing.
    meshes: i64,
    materials: i64,
    vertices: i64,
    indices: i64,
}

// A window of the given size, with room for a scene of a few hundred things. A
// program that needs more than that says so by writing the fields.
app_config :: fn(title: str, width: i64, height: i64) -> AppConfig {
    AppConfig {
        title = title,
        width = width,
        height = height,
        drawn = 256,
        meshes = 64,
        materials = 64,
        vertices = 65536,
        indices = 131072
    }
}

// Why opening did not work, and what the platform said about it. There is no
// half-open App: `app_open` gives back whatever it took before it answers with
// one of these, so a program that gets a failure has nothing left to close.
//
// The reason travels in here rather than being asked for afterwards. Giving the
// window back shuts SDL down, and what SDL says about a failure does not
// outlive SDL, so the one moment the reason can be read is before the cleanup
// that a caller has already had done for it.
AppError :: struct { why: AppFault, said: str }

AppFault :: enum { NoWindow, NoDevice }

// `linear` because of what it holds. A window, a device and four tables are
// taken once and given back once, and a path that opens one and returns without
// closing it stops compiling.
App :: linear struct {
    platform: Platform,
    renderer: Renderer,
    world: World,
    store: Geometry,
    meshes: MeshCache,
    materials: Materials,
    render: RenderWorld,
    // Which plugins are in, so one composed by two others goes in once.
    installed: Vec<Installed>,
    // Where lines go, once something composes the plugin that opens it. A
    // program without it holds one that was never opened and writes nothing.
    log: Log,
    logging: bool,
    // The standard pass and the run of lights it reads, once something composes
    // the plugin that makes them. A program writing its own passes leaves both
    // alone and nothing here is bound.
    lit: Lit,
    drawing: bool,
    lights: []GpuLight,
    // Whether the graph can run at all, answered when it was scheduled.
    drawable: bool,
    // Whether the startup stage has run. A frame runs the stages after it, so
    // without this a program that never asks would have its startup systems
    // registered and never run.
    started: bool,
    // Whether the screen the program starts on has been entered yet.
    state_started: bool,
}

app_open :: fn(config: AppConfig) -> App ! AppError {
    mut p := platform_open(config.title, config.width, config.height)
    if (platform_ok(p) == false) {
        // Read before the close, because the close is what makes it
        // unreadable.
        said := platform_error()
        platform_close(p)
        return AppError { why = AppFault::NoWindow, said = said }
    }
    mut r := renderer_open(platform_window(p), config.width, config.height)
    if (renderer_ok(r) == false) {
        renderer_close(r)
        platform_close(p)
        return AppError {
            why = AppFault::NoDevice,
            said = "no adapter or no device that answers to this surface"
        }
    }
    device := renderer_device(r)
    mut app := App {
        platform = p,
        renderer = r,
        world = ecs_new(),
        store = geometry_new(device, config.vertices, config.indices),
        meshes = mesh_cache_new(config.meshes),
        materials = materials_new(config.materials),
        render = render_world_new(
            device,
            config.drawn,
            config.meshes,
            config.materials
        ),
        installed = vec_new($Installed, 8),
        log = log_open("", log_config()),
        logging = false,
        lit = lit_none(),
        drawing = false,
        lights = heap_slice($GpuLight, MAX_LIGHTS),
        drawable = true,
        started = false,
        state_started = false,
    }
    // The one plugin an App is not an App without. Everything else a program
    // installs for itself.
    app_install($engine_plugin, app)
    app
}

// What a plugin is: the name it is known by, and what it builds into an App.
//
// A plugin is a constant of this, named at the call that installs it. The name
// is its identity, which is what says a plugin is in twice; the function is
// reached through the constant, so installing folds to a call to that function
// and nothing is dispatched.
Plugin :: struct {
    name: str,
    build: fn(mut App),
}

// The engine's own registration. What every drawing program needs and nothing
// a particular one does.
engine_build :: fn(mut app: App) {
    world_prepare(app.world)
}

engine_plugin :: Plugin { name = "engine", build = engine_build }

// The camera moved by what was held. A program driving the camera itself names
// its own system and leaves this one out of the run it writes.
camera_system :: System {
    stage = Stage::FrameUpdate,
    state = ANY_STATE,
    run = move_camera
}

// Escape closes the window. Named by a demo rather than built into the poll, so
// a program that wants that key for a menu simply does not name it.
escape_system :: System {
    stage = Stage::FrameUpdate,
    state = ANY_STATE,
    run = exit_on_escape
}

// One plugin, built into this App.
//
// A plugin registers the components it reads, the resources it needs at their
// defaults, and its systems. There is no configuration on it, because what a
// program wants different it writes after installing, the way `app_camera_set`
// follows `app_open`. One shape for all of them is what makes a set of plugins
// a list of names rather than a shape each caller has to know.
//
// The plugin is named at the call rather than handed over as a value, so
// `plugin.build(app)` is a call to the function that constant names. What is
// remembered is the name, which is what says a plugin is in twice: two
// constants naming one function are two plugins, and the same constant named
// at two calls is one.
app_install :: fn($plugin: Plugin, mut app: App) {
    if (already_installed(app, plugin.name)) {
        unsafe { frost_rt_error("frost: a plugin is installed twice\n") }
        frost_rt_die()
    }
    vec_push(app.installed, Installed { name = plugin.name })
    plugin.build(app)
}

// The same, where a plugin that is already in is what was wanted. A plugin
// composing what it depends on uses this, since more than one may depend on
// the same thing and none of them can see whether another got there first.
app_install_if_absent :: fn($plugin: Plugin, mut app: App) {
    if (already_installed(app, plugin.name)) {
        return
    }
    vec_push(app.installed, Installed { name = plugin.name })
    plugin.build(app)
}

already_installed :: fn(app: App, name: str) -> bool {
    holds_plugin(app.installed, name)
}

// Whether a name is on a list of plugins. Apart from the App, because what says
// a plugin is in twice is a question about the list and a device has nothing to
// do with it.
holds_plugin :: fn(installed: Vec<Installed>, name: str) -> bool {
    held := vec_slice(installed)
    mut i: i64 = 0
    while (i < vec_len(installed)) {
        if (str_eq(held[i].name, name)) {
            return true
        }
        i = i + 1
    }
    false
}

// A plugin that is in, so two that pull in the same one pull it in once.
Installed :: struct { name: str }

test "a plugin that was installed is on the list" {
    mut installed := vec_new($Installed, 4)
    vec_push(installed, Installed { name = "engine" })
    vec_push(installed, Installed { name = "render" })
    assert(holds_plugin(installed, "engine"))
    assert(holds_plugin(installed, "render"))
    vec_free(installed)
}

test "a plugin that was never installed is not on the list" {
    mut installed := vec_new($Installed, 4)
    vec_push(installed, Installed { name = "engine" })
    assert(holds_plugin(installed, "log") == false)
    vec_free(installed)
}

test "nothing is on an empty list" {
    mut installed := vec_new($Installed, 4)
    assert(holds_plugin(installed, "engine") == false)
    vec_free(installed)
}

// The names are compared, not the constants, so two plugins that name one
// function are two plugins and the same constant named twice is one.
test "one name is on the list once however often it is asked for" {
    mut installed := vec_new($Installed, 4)
    vec_push(installed, Installed { name = "engine" })
    assert(holds_plugin(installed, "engine"))
    assert(holds_plugin(installed, "engine"))
    assert(vec_len(installed) == 1)
    vec_free(installed)
}

// A name that another name starts with is a different plugin.
test "a name is not on the list because a longer one is" {
    mut installed := vec_new($Installed, 4)
    vec_push(installed, Installed { name = "engine" })
    assert(holds_plugin(installed, "eng") == false)
    vec_free(installed)
}

// Lines to a file beside the program, named for the window. Composing this is
// what opens the file; a program without it writes nothing at all.
log_build :: fn(mut app: App) {
    app.logging = true
    app_log(app, "opened")
}

log_plugin :: Plugin { name = "log", build = log_build }

// One line, where a log was opened. A program that composed no log plugin calls
// this and nothing happens, so nothing has to ask first.
app_log :: fn(mut app: App, said: str) {
    if (app.logging == false) {
        return
    }
    log_line(app.log, said)
}

// What a program's passes are, named where the App runs rather than registered
// with it. Each is a `match` over the numbers that program declared, so every
// arm is a call to a function this build knows and none of them goes through a
// field.
//
// The engine's own pass carries the number below and a program numbers its own
// from one, so the default recorder answers for the engine and a program with
// node passes of its own hands the numbers it does not know back to it.
ENGINE_LIT_PASS :: 0

app_engine_record :: fn(mut app: App, which: i64, context: NodeContext) {
    if (which == ENGINE_LIT_PASS) {
        record_view(app, context)
    }
}

declares_nothing :: fn(mut app: App) {}

rebuilds_nothing :: fn(mut app: App, which: i64) {}

draws_nothing :: fn(mut app: App, which: i64, pass: RenderPassEncoder) {}

records_nothing :: fn(mut app: App, which: i64, context: NodeContext) {
    app_engine_record(app, which, context)
}

dispatches_nothing :: fn(mut app: App, which: i64, pass: ComputePassEncoder) {}

each_frame_nothing :: fn(mut app: App) {}

// The passes, then the order they imply, then the first size. False when the
// graph refuses, which is a program that cannot draw rather than one that draws
// nothing, so it says so once here instead of every frame.
//
// Declared on the way into the first frame rather than while the App is opening,
// so a plugin installed after `app_open` still declares its passes and so
// everything a program spawns before then is already in.
//
// What a declaration may not do is ask the graph for a view or a sampler:
// nothing is made until the graph has a size, and the size comes after every
// declaration. A pass that binds what the graph holds says so with
// `graph_rebuilds`, and is told with the first size as well as with every one
// after it.
configure_graph :: fn(
    $declare: fn(mut App),
    $rebuild: fn(mut App, i64),
    mut app: App
) -> bool {
    if (app.drawing) {
        declare_lit(app)
    }
    declare(app)
    if (graph_schedule(app.renderer.graph) == false) {
        print("the render graph cannot run
")
        return false
    }
    graph_resize(
        app.renderer.graph,
        width(app.platform),
        height(app.platform)
    )
    tell_passes($rebuild, app)
    true
}

// Every pass whose targets moved, told once, and the marks cleared behind them.
// The walk is here rather than inside the graph because what a pass rebuilds is
// the program's, and the graph and the App are never held at once: the number is
// read out of the graph and the call takes the App alone.
tell_passes :: fn($rebuild: fn(mut App, i64), mut app: App) {
    mut sub: i64 = -1
    while (sub < graph_sub_count(app.renderer.graph)) {
        mut index: i64 = 0
        while (index < graph_touched_count(app.renderer.graph, sub)) {
            which := graph_touched_at(app.renderer.graph, sub, index)
            if (which >= 0) {
                rebuild(app, which)
            }
            index = index + 1
        }
        sub = sub + 1
    }
    graph_touched_clear(app.renderer.graph)
}

// The renderer, composed: a pass that draws what the world says is drawn, lit by
// what the world says is a light. This is what a program gets instead of writing
// a shader.
//
// It declares one culling pass and one drawing pass, and registers the hook that
// fills the run and the lights every frame. Which targets they write is the
// window and a depth buffer the graph makes, so a program that wants its own
// chain writes its own passes instead and does not compose this.
render_build :: fn(mut app: App) {
    app.drawing = true
    // The two layouts the pass binds against, and nothing else. What it records
    // with beyond that is its own: the grid over the lights and the steps that
    // decide what is drawn are made inside it, so an App holds one pass rather
    // than a pass and the three things it happens to record.
    app.lit = lit_new(
        app_device(app),
        app_format(app),
        render_world_layout(app.render),
        render_world_batch_layout(app.render)
    )
}

render_plugin :: Plugin { name = "render", build = render_build }

// The world into the run, and the world's lights into the buffer beside it.
fill_lit :: fn(mut app: App) {
    queue := app_queue(app)
    ids := app_ids(app)
    app_extract(
        app,
        all_drawn(ids.global_transform, ids.transform, ids.drawn),
        app_view(app)
    )
    counts := lights_of(app.world, light_ids(app.world), app.lights)
    eye := app_camera(app)
    width := app_width(app)
    height := app_height(app)
    lit_write_lights(
        app.lit,
        queue,
        app.lights,
        counts.total,
        counts.directional,
        camera_projection(eye, width, height),
        camera_view(eye),
        width,
        height,
        eye.z_near,
        eye.z_far
    )
    lit_write_frame(
        app.lit,
        queue,
        app_view(app),
        camera_view(eye),
        camera_position(eye),
        vec3(0.05, 0.05, 0.07),
        counts.total,
        counts.directional
    )
}

// What the standard pass draws into: the window, cleared to the ambient colour,
// and a depth buffer that follows it.
//
// The steps that decide what is drawn go in first and the pass that draws reads
// what they wrote, which is the whole of what puts the two in order.
declare_lit :: fn(mut app: App) {
    screen := graph_backbuffer(app.renderer.graph)
    depth := graph_depth(
        app.renderer.graph,
        "depth",
        WINDOW_SIZED,
        WINDOW_SIZED,
        DEPTH_FORMAT
    )
    lit_declare(
        app.renderer.graph,
        ENGINE_LIT_PASS,
        screen,
        depth,
        Color { r = 0.02, g = 0.02, b = 0.03, a = 1.0 }
    )
}

// Everything a frame does to draw the world, in the order it has to happen:
//
//   the light grid, so shading knows which lights reach where
//   the batch tables, so the draws exist at all
//   depth, for what certainly covers what is behind it
//   the classes, shaded against the depth already written
//
// One node to the graph. Declaring these as separate passes would put this
// order in every program that draws a view, and a program with two views would
// write it twice; nightshade's mesh node records the same sequence for the same
// reason.
record_view :: fn(mut app: App, context: NodeContext) {
    lit_record(app.lit, app.render, app.store, context)
}

// Where the program starts. A state is a number a program names its own
// constants for, and every screen after this one is asked for from a system
// with `world_state_request`.
app_insert_state :: fn(mut app: App, initial: i64) {
    ecs_resource_set(
        app.world,
        resource_of($States, app.world),
        states_new(initial)
    )
    app.state_started = false
}

// One system each time the program arrives at a screen, and each time it
// leaves one. Both run between the transition and the frame that follows it, so
// what an enter hook spawns is there for the first frame of its own screen.
// What runs when the program arrives at a screen or leaves one.
// The requested screen taken. The first frame is a change too: a program that
// never asks for another state still enters the one it started in.
//
// What runs at a change is a system written for that state, which the schedule
// already carries: `app_add_system_in_state` names one, and a system runs on
// the frames its state is on. A hook either side of the change was a second
// way to say that, and it said it by keeping a function to call later.
settle_state :: fn(mut app: App) {
    world_state_apply(app.world)
    app.state_started = true
}

// A resource, readable from any system. Registered here if it was not already,
// so a program inserts one without first asking the world for a slot; what
// reads it names the type the same way.
app_insert_resource :: fn($T: Type, mut app: App, move value: $T) {
    slot := ecs_resource_register($T, app.world)
    ecs_resource_set(app.world, slot, value)
}

// What a program says and answers when it could not open. Written here because
// every program says the same thing, and because which half failed is this
// file's own enum rather than something a caller should have to read. What is
// printed came out of the failure, so it says the same thing however long ago
// the platform was shut down.
app_failed :: fn(held: AppError) -> i64 {
    print("{}\n", held.said)
    match held.why {
        case AppFault::NoWindow: {
            print("no window\n")
            1
        }
        case AppFault::NoDevice: {
            print("no device\n")
            2
        }
    }
}

// Everything opening took, given back, and what `main` should answer. Children
// before what made them: the tables are the device's, the world holds the tree,
// and the window outlives the device it was drawn into.
app_close :: fn(move app: App) -> i64 {
    vec_free(app.installed)
    lit_free(app.lit)
    heap_release_slice(app.lights)
    log_close(app.log)
    render_world_free(app.render)
    geometry_free(app.store)
    materials_free(app.materials)
    mesh_cache_free(app.meshes)
    giving := world_tree_take(app.world)
    hierarchy_free(giving)
    ecs_free(app.world)
    renderer_close(app.renderer)
    platform_close(app.platform)
    0
}

// The far half of a frame: what the machine did, and what the world made of it.
// False when the window asked to close or a system asked the program to stop,
// which is what a main loop runs until. Which keys mean stop is a system's
// business, so `exit_on_escape_plugin` is what a demo installs and this reads
// only the answer.
//
// Every stage of a frame, in order, over the engine's own systems and then the
// ones the program named. The engine's run first within a stage, which is what
// puts `place_things` after whatever wrote the transforms it reads.
//
// Two calls rather than one list, because a compile-time list is what a call
// wrote and there is no splicing one into another.
run_frame_systems :: fn(mut app: App, systems: $...) {
    state := world_state(app.world)
    mut order := FIRST_FRAME_STAGE
    while (order <= stage_order(Stage::Last)) {
        run_stage_of(app.world, state, stage_at(order), place_things_system)
        run_stage_of(app.world, state, stage_at(order), systems)
        order = order + 1
    }
}

// The one system the engine runs whatever a program names: what a thing wears
// becomes where it is drawn.
place_things_system :: System {
    stage = Stage::FramePostUpdate,
    state = ANY_STATE,
    run = place_things
}

// The renderer and the graph are resized together, because a surface and every
// target tested against it are the same size or nothing draws.
app_next :: fn(
    $declare: fn(mut App) = declares_nothing,
    $rebuild: fn(mut App, i64) = rebuilds_nothing,
    mut app: App,
    systems: $...
) -> bool {
    // The graph and the startup stage, on the way into the first frame rather
    // than at the end of opening, so a plugin installed after `app_open` still
    // declares its passes and still gets a startup run.
    if (app.started == false) {
        app.started = true
        app.drawable = configure_graph($declare, $rebuild, app)
        // Nothing runs for a program that cannot draw, so a graph that refuses
        // stops here rather than after a startup pass whose work is thrown away.
        if (app.drawable == false) {
            return false
        }
        settle_state(app)
        run_stage_of(
            app.world,
            world_state(app.world),
            Stage::Startup,
            systems
        )
    }
    if (app.drawable == false) {
        return false
    }
    if (platform_poll(app.platform) == false) {
        return false
    }
    // One call: the surface and every target measured against it are the same
    // size or nothing draws, so the renderer resizes its own graph.
    if (resized(app.platform)) {
        renderer_resize(
            app.renderer,
            width(app.platform),
            height(app.platform)
        )
        tell_passes($rebuild, app)
    }
    world_input(app.world, platform_input(app.platform))
    // The screen settles before anything runs, so no frame has some of its
    // systems under one screen and the rest under another.
    settle_state(app)
    run_frame_systems(app, systems)
    // A system deciding the program is finished is the last thing a frame does,
    // so the frame it decided in is finished rather than half drawn.
    world_exit_wanted(app.world) == false
}

// Every frame until the window closes or a system says to stop.
//
// The App is borrowed rather than taken, because a pass reaches the run and the
// geometry through a pointer the program took before the first frame, and a
// pointer into a value that has been moved names where it used to be. What
// closes the App is the caller, after this answers.
app_run :: fn(
    $declare: fn(mut App) = declares_nothing,
    $each_frame: fn(mut App) = each_frame_nothing,
    $record: fn(mut App, i64, NodeContext) = records_nothing,
    $draw: fn(mut App, i64, RenderPassEncoder) = draws_nothing,
    $dispatch: fn(mut App, i64, ComputePassEncoder) = dispatches_nothing,
    $rebuild: fn(mut App, i64) = rebuilds_nothing,
    mut app: App,
    systems: $...
) {
    while (app_next($declare, $rebuild, app, systems)) {
        each_frame(app)
        app_draw($draw, $record, $dispatch, app)
    }
}

// The App's own loop, replaced. A runner is handed the App and drives it
// however its host wants: an offscreen worker, an editor, a test harness that
// runs three frames and stops. What it drives with is `app_next` and
// `app_draw`, which are the two halves of a frame and are exported for exactly
// this.
//
// The runner is named here rather than set on the App beforehand, so the loop
// a program runs is the one written at the call. A program with its own writes
// this instead of `app_run`, which is what replaces asking the App which of
// them it holds.
//
// It borrows rather than takes, for the same reason `app_run` does: a pass
// reaches its state through a pointer the program took before the first frame,
// and a pointer into a value that has been moved names where it used to be.
app_run_with :: fn($runner: fn(mut App), mut app: App) {
    runner(app)
}

// What the world says is drawn, put in the run the passes read. A program
// drawing one view calls this once; a program whose passes divide the world
// calls `render_world_begin`, `scene_sync` and `render_world_upload` itself,
// once per view, since which things a view draws and what it is culled against
// are exactly what differs between the runs.
app_extract :: fn(mut app: App, ids: ObjectIds, view_projection: Mat4) {
    render_world_begin(app.render)
    scene_sync(app.world, app.render, app.materials, app.meshes, ids)
    render_world_upload(
        app.render,
        renderer_queue(app.renderer),
        view_projection,
        app.materials,
        app.meshes
    )
}

// The near half of a frame: the graph, recorded into whatever the surface
// handed over. A frame that could not be acquired records nothing and is still
// ended, because the handles it took are counted whether it drew or not.
app_draw :: fn(
    $draw: fn(mut App, i64, RenderPassEncoder) = draws_nothing,
    $record: fn(mut App, i64, NodeContext) = records_nothing,
    $dispatch: fn(mut App, i64, ComputePassEncoder) = dispatches_nothing,
    mut app: App
) {
    // What the engine's own pass reads, filled before anything records. A
    // program that composed no renderer plugin has nothing bound here and this
    // does nothing.
    if (app.drawing) {
        fill_lit(app)
    }
    mut f := renderer_begin(app.renderer)
    if (frame_ok(f)) {
        run_graph($draw, $record, $dispatch, app, f, -1)
    }
    renderer_end(app.renderer, f)
}

// The graph's order, walked here rather than inside the graph. What each step
// records is the program's, and a step is read out of the graph before anything
// records into it, so the graph and the App are never held at once.
//
// `sub` is which graph: -1 is the App's own and anything else is a child of it.
run_graph :: fn(
    $draw: fn(mut App, i64, RenderPassEncoder),
    $record: fn(mut App, i64, NodeContext),
    $dispatch: fn(mut App, i64, ComputePassEncoder),
    mut app: App,
    mut f: Frame,
    sub: i64
) {
    if (graph_begin_run(app.renderer.graph, sub) == false) {
        return
    }
    mut step: i64 = 0
    while (step < graph_step_count(app.renderer.graph, sub)) {
        one := graph_step_at(app.renderer.graph, sub, step)
        if (graph_step_runs(one, ANY_PHASE)) {
            match one.kind {
                case PassKind::SubGraph: {
                    graph_bind_sub(app.renderer.graph, one.sub)
                    run_sub_graph($draw, $record, $dispatch, app, f, one.sub)
                }
                case PassKind::Compute: {
                    encoder := graph_open_compute(f)
                    dispatch(app, one.which, encoder)
                    graph_close_compute(encoder)
                }
                case PassKind::Node: {
                    context := graph_open_node(app.renderer.graph, sub, f, one)
                    record(app, one.which, context)
                }
                case PassKind::Render: {
                    encoder := graph_open_render(
                        app.renderer.graph,
                        sub,
                        f,
                        one
                    )
                    draw(app, one.which, encoder)
                    graph_close_render(encoder)
                }
            }
        }
        step = step + 1
    }
}

// A child graph, walked whole. It is its own function rather than the walk above
// calling itself, because a graph nests one deep: a child is reached through the
// graph that holds it, and a child of a child is not reachable that way.
run_sub_graph :: fn(
    $draw: fn(mut App, i64, RenderPassEncoder),
    $record: fn(mut App, i64, NodeContext),
    $dispatch: fn(mut App, i64, ComputePassEncoder),
    mut app: App,
    mut f: Frame,
    sub: i64
) {
    if (graph_begin_run(app.renderer.graph, sub) == false) {
        return
    }
    mut step: i64 = 0
    while (step < graph_step_count(app.renderer.graph, sub)) {
        one := graph_step_at(app.renderer.graph, sub, step)
        if (graph_step_runs(one, ANY_PHASE)) {
            match one.kind {
                case PassKind::SubGraph: {}
                case PassKind::Compute: {
                    encoder := graph_open_compute(f)
                    dispatch(app, one.which, encoder)
                    graph_close_compute(encoder)
                }
                case PassKind::Node: {
                    context := graph_open_node(app.renderer.graph, sub, f, one)
                    record(app, one.which, context)
                }
                case PassKind::Render: {
                    encoder := graph_open_render(
                        app.renderer.graph,
                        sub,
                        f,
                        one
                    )
                    draw(app, one.which, encoder)
                    graph_close_render(encoder)
                }
            }
        }
        step = step + 1
    }
}

app_device :: fn(app: App) -> Device { renderer_device(app.renderer) }
app_queue :: fn(app: App) -> Queue { renderer_queue(app.renderer) }
app_format :: fn(app: App) -> u32 { renderer_format(app.renderer) }

app_width :: fn(app: App) -> i64 { width(app.platform) }
app_height :: fn(app: App) -> i64 { height(app.platform) }

// What the last poll left, for a program that wants the clock or a key the
// schedule does not read. A system reads the same thing out of the world.
app_input :: fn(app: App) -> Input { platform_input(app.platform) }

// Which component is which, asked of the world each time rather than kept here,
// so this and the world cannot disagree.
app_ids :: fn(app: App) -> WorldIds { world_ids(app.world) }

app_camera :: fn(app: App) -> Camera { world_camera(app.world) }

app_camera_set :: fn(mut app: App, move eye: Camera) {
    world_camera_set(app.world, eye)
}

// The camera the world holds, against the window as it is now. This is what
// both the frame uniform and the culling pass are given, and they have to be
// the same matrix or a thing is culled against a view it was not drawn in.
app_view :: fn(app: App) -> Mat4 {
    camera_view_projection(
        world_camera(app.world),
        width(app.platform),
        height(app.platform)
    )
}
