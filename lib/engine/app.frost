// The window, the device, the world and the tables a drawing program keeps, as
// one thing opened once and given back once.
//
//     main :: fn() -> i64 {
//         match app_open(app_config("Frost", WIDTH, HEIGHT)) {
//             case .Ok { value }: run(value)
//             case .Err { error }: app_failed(error)
//         }
//     }
//
//     run :: fn(move app: App) -> i64 {
//         app_install(app, exit_on_escape_plugin)
//         ...
//         app_configure_graph(app, declare_passes, ptr_to(scene))
//         app_before_render(app, before_frame, ptr_to(scene))
//         app_run(app)
//         app_close(app)
//     }
//
// What a program still writes for itself is what it draws: the shader, the
// pipeline, the passes and how they are wired. Everything above that is the
// same in every one of them, which is what this is.
//
// The graph is the renderer's, and what a program says into it is a hook the
// App keeps. Which passes exist, what each reads and writes and what each
// records is the whole of what one program has to say, and it says it once on
// the way into the first frame, after every plugin has had its turn. Scheduling
// and the first size are the App's, so a program declares passes and never
// orders them.
//
// `main` is two calls because a window that did not open is a value rather than
// a flag: `app_open` gives back whatever it took before answering with a
// failure, so there is no half-open App and nothing to check for.

import "../platform/platform.frost"
import "../renderer/wgpu.frost"
import "../renderer/renderer.frost"
import "../renderer/frame.frost"
import "../renderer/graph.frost"
import "../renderer/geometry.frost"
import "../renderer/mesh.frost"
import "../renderer/material.frost"
import "../renderer/render_world.frost"
import "light.frost"
import "log.frost"
import "../renderer/lit.frost"
import "../renderer/cluster.frost"
import "world.frost"
import "scene_sync.frost"
import "camera.frost"
import "ecs.frost"
import "vec.frost"
import "mem.frost"
import "math.frost"
import "io.frost"

// Stopping, which a module that needs it declares for itself: neither
// `ecs.frost` nor the wgpu binding hands these out.
frost_rt_error :: extern fn(text: ^i8)
frost_rt_die :: safe extern fn()

export AppConfig, App, AppError, AppFault, app_config, app_open, app_close,
    app_failed, app_install, app_install_if_absent, app_install_group,
    PluginGroup, plugin_group_new, plugin_group_free, plugin_group_add,
    plugin_group_set, plugin_group_disable, default_plugins,
    engine_plugin, exit_on_escape_plugin, camera_controller_plugin,
    app_configure_graph, app_before_render, app_update_graph, app_run,
    log_plugin, app_log, render_plugin,
    app_set_runner, app_set_runner_if_unset,
    app_add_system, app_add_systems, app_remove_system, app_insert_resource,
    app_add_system_in_state, app_insert_state, app_on_enter, app_on_exit,
    app_next, app_extract, app_draw,
    app_device, app_queue, app_format, app_ids, app_input,
    app_width, app_height, app_camera, app_camera_set, app_view

// How big a program says it is before it opens. The three rooms are the ones
// that cannot grow: the geometry buffers and every table measured against a
// draw are sized once, since a buffer that grew would move and every span
// handed out is a place in the one that was there.
AppConfig :: struct {
    title: str,
    width: i64,
    height: i64,
    // How many things may be drawn at once, which is what the run holds.
    drawn: i64,
    // How many distinct meshes and how many distinct materials. Three numbers
    // rather than one, because they count different things: a scene of a
    // thousand crates is one mesh and one material, and a table sized by the
    // largest of the three is either wasteful or too small. `materials_add`
    // past the end answers with the last slot rather than growing, so a
    // registry sized by the wrong number draws the wrong material and says
    // nothing.
    meshes: i64,
    materials: i64,
    vertices: i64,
    indices: i64,
}

// A window of the given size, with room for a scene of a few hundred things. A
// program that needs more than that says so by writing the fields.
app_config :: fn(title: str, width: i64, height: i64) -> AppConfig {
    AppConfig { title = title, width = width, height = height,
        drawn = 256, meshes = 64, materials = 64,
        vertices = 65536, indices = 131072 }
}

// Why opening did not work, and what the platform said about it. There is no
// half-open App: `app_open` gives back whatever it took before it answers with
// one of these, so a program that gets a failure has nothing left to close.
//
// The reason travels in here rather than being asked for afterwards. Giving the
// window back shuts SDL down, and what SDL says about a failure does not
// outlive SDL, so the one moment the reason can be read is before the cleanup
// that a caller has already had done for it.
AppError :: struct { why: AppFault, said: str }

AppFault :: enum { NoWindow, NoDevice }

// `linear` because of what it holds. A window, a device and four tables are
// taken once and given back once, and a path that opens one and returns without
// closing it stops compiling.
App :: linear struct {
    platform: Platform,
    renderer: Renderer,
    world: World,
    schedule: Schedule,
    store: Geometry,
    meshes: MeshCache,
    materials: Materials,
    render: RenderWorld,
    // Which plugins are in, so one composed by two others goes in once.
    installed: Vec<Installed>,
    // What says which passes exist, run once before the first frame.
    graph_configs: Vec<GraphConfig>,
    // What changes the graph each frame: which passes run this time.
    update_graph: Vec<UpdateGraph>,
    // What runs each frame between the schedule and the graph, where a
    // system cannot reach: writing a uniform, filling the run.
    before_render: Vec<BeforeRender>,
    // The loop, where a program brings its own. Nothing runs the App's when
    // one is set.
    runner: fn(mut App),
    has_runner: bool,
    // Where lines go, once something composes the plugin that opens it. A
    // program without it holds one that was never opened and writes nothing.
    log: Log,
    logging: bool,
    // The standard pass and the run of lights it reads, once something composes
    // the plugin that makes them. A program writing its own passes leaves both
    // alone and nothing here is bound.
    lit: Lit,
    drawing: bool,
    lights: []GpuLight,
    // Whether the graph can run at all, answered when it was scheduled.
    drawable: bool,
    // Whether the startup stage has run. A frame runs the stages after it, so
    // without this a program that never asks would have its startup systems
    // registered and never run.
    started: bool,
    // What runs when the program arrives at a screen and when it leaves one,
    // and whether the screen it starts on has been entered yet.
    on_enter: Vec<StateHook>,
    on_exit: Vec<StateHook>,
    state_started: bool,
}

app_open :: fn(config: AppConfig) -> App ! AppError {
    var p := platform_open(config.title, config.width, config.height)
    if (platform_ok(p) == false) {
        // Read before the close, because the close is what makes it
        // unreadable.
        said := platform_error()
        platform_close(p)
        return AppError { why = AppFault::NoWindow, said = said }
    }
    var r := renderer_open(platform_window(p), config.width, config.height)
    if (renderer_ok(r) == false) {
        renderer_close(r)
        platform_close(p)
        return AppError { why = AppFault::NoDevice,
            said = "no adapter or no device that answers to this surface" }
    }
    device := renderer_device(r)
    var app := App {
        platform = p,
        renderer = r,
        world = ecs_new(),
        schedule = schedule_new(),
        store = geometry_new(device, config.vertices, config.indices),
        meshes = mesh_cache_new(config.meshes),
        materials = materials_new(config.materials),
        render = render_world_new(device, config.drawn, config.meshes,
            config.materials),
        installed = vec_new($Installed, 8),
        graph_configs = vec_new($GraphConfig, 4),
        update_graph = vec_new($UpdateGraph, 4),
        before_render = vec_new($BeforeRender, 4),
        runner = runs_nothing,
        has_runner = false,
        log = log_open("", log_config()),
        logging = false,
        lit = lit_none(),
        drawing = false,
        lights = heap_slice($GpuLight, MAX_LIGHTS),
        drawable = true,
        started = false,
        on_enter = vec_new($StateHook, 4),
        on_exit = vec_new($StateHook, 4),
        state_started = false,
    }
    // The one plugin an App is not an App without. Everything else a program
    // installs for itself.
    app_install(app, engine_plugin)
    app
}

// The engine's own registration. What every drawing program needs and nothing
// a particular one does.
engine_plugin :: fn(mut app: App) {
    world_prepare(app.world)
    app_add_system(app, Stage::FramePostUpdate, place_things)
}

// The camera moved by what was held. A program driving the camera itself
// installs everything else and leaves this out.
camera_controller_plugin :: fn(mut app: App) {
    app_add_system(app, Stage::FrameUpdate, move_camera)
}

// Escape closes the window. Installed by a demo rather than built into the
// poll, so a program that wants that key for a menu simply does not install it.
exit_on_escape_plugin :: fn(mut app: App) {
    app_add_system(app, Stage::FrameUpdate, exit_on_escape)
}

// One plugin, built into this App.
//
// A plugin is a `fn(mut App)` and nothing else: it registers the components it
// reads, the resources it needs at their defaults, and its systems. There is no
// configuration on it, because what a program wants different it writes after
// installing, the way `app_camera_set` follows `app_open`. One signature for
// all of them is what makes a set of plugins a list of names rather than a
// shape each caller has to know.
//
// The signature is spelled where it is used rather than named, because a
// function type in Frost has no alias: `schedule_add` spells `fn(mut World)`
// the same way.
app_install :: fn(mut app: App, build: fn(mut App)) {
    if (already_installed(app, build)) {
        unsafe { frost_rt_error("frost: a plugin is installed twice\n") }
        frost_rt_die()
    }
    vec_push($Installed, app.installed, Installed { build = build })
    build(app)
}

// The same, where a plugin that is already in is what was wanted. A plugin
// composing what it depends on uses this, since more than one may depend on
// the same thing and none of them can see whether another got there first.
app_install_if_absent :: fn(mut app: App, build: fn(mut App)) {
    if (already_installed(app, build)) {
        return
    }
    vec_push($Installed, app.installed, Installed { build = build })
    build(app)
}

already_installed :: fn(app: App, build: fn(mut App)) -> bool {
    held := vec_slice($Installed, app.installed)
    var i: i64 = 0
    while (i < vec_len($Installed, app.installed)) {
        if (held[i].build == build) {
            return true
        }
        i = i + 1
    }
    false
}

// A plugin that is in, so two that pull in the same one pull it in once.
Installed :: struct { build: fn(mut App) }

// One plugin of a group, and whether it is still on. `named` is what the group
// was built with and never changes, so a member replaced by
// `plugin_group_set` is still found under the name the group knows it by; it
// keeps its place in the order too, since what a program composes above the
// engine is often written against that order.
GroupMember :: struct {
    named: fn(mut App),
    build: fn(mut App),
    enabled: bool,
}

// An ordered set of plugins a program composes as one, each replaceable and
// each removable before the App takes any of them.
//
//     mut standard := default_plugins()
//     plugin_group_disable(standard, log_plugin)
//     app_install_group(app, standard)
//
// `linear` because it owns its list: a group built and never installed still
// has to give its storage back.
PluginGroup :: linear struct { members: Vec<GroupMember> }

plugin_group_new :: fn() -> PluginGroup {
    PluginGroup { members = vec_new($GroupMember, 8) }
}

plugin_group_free :: fn(move group: PluginGroup) {
    vec_free($GroupMember, group.members)
}

plugin_group_add :: fn(mut group: PluginGroup, build: fn(mut App)) {
    vec_push($GroupMember, group.members,
        GroupMember { named = build, build = build, enabled = true })
}

// Which member of the group this name is, or -1 where the group has none.
group_index :: fn(group: PluginGroup, named: fn(mut App)) -> i64 {
    held := vec_slice($GroupMember, group.members)
    var i: i64 = 0
    while (i < vec_len($GroupMember, group.members)) {
        if (held[i].named == named) {
            return i
        }
        i = i + 1
    }
    -1
}

// The group's own `named` built another way, keeping its place. A group that
// does not hold it is a program naming a member that is not there, which is
// worth stopping rather than silently composing something else.
plugin_group_set :: fn(mut group: PluginGroup, named: fn(mut App),
    build: fn(mut App)) {
    at := group_index(group, named)
    if (at < 0) {
        unsafe { frost_rt_error("frost: this plugin group has no such member\n") }
        frost_rt_die()
    }
    var held := vec_slice($GroupMember, group.members)
    held[at].build = build
}

// The group without it. Refused the same way as `set` when the group has no
// such member, since disabling what was never there is a program that thinks
// it turned something off.
plugin_group_disable :: fn(mut group: PluginGroup, named: fn(mut App)) {
    at := group_index(group, named)
    if (at < 0) {
        unsafe { frost_rt_error("frost: this plugin group has no such member\n") }
        frost_rt_die()
    }
    var held := vec_slice($GroupMember, group.members)
    held[at].enabled = false
}

// The group's members in group order, skipping the ones turned off. They count
// toward the same once-per-plugin rule everything else does, so a group holding
// what a program already installed stops rather than installing it twice.
app_install_group :: fn(mut app: App, move group: PluginGroup) {
    var i: i64 = 0
    while (i < vec_len($GroupMember, group.members)) {
        held := vec_get($GroupMember, group.members, i)
        if (held.enabled) {
            app_install(app, held.build)
        }
        i = i + 1
    }
    plugin_group_free(group)
}

// The standard composition. What a program writes when it wants the engine's
// own and nothing else, and what it starts from when it wants most of them.
//
// The window and the device are not in here: `app_open` brings both up before a
// plugin can run, because the rest of the App is built against a device. The
// camera controller and escape-to-close stay out for the same reason they do
// above: a program that drives its own camera or wants that key for a menu
// installs neither.
default_plugins :: fn() -> PluginGroup {
    var group := plugin_group_new()
    plugin_group_add(group, log_plugin)
    group
}

// Lines to a file beside the program, named for the window. Composing this is
// what opens the file; a program without it writes nothing at all.
log_plugin :: fn(mut app: App) {
    app.logging = true
    app_log(app, "opened")
}

// One line, where a log was opened. A program that composed no log plugin calls
// this and nothing happens, so nothing has to ask first.
app_log :: fn(mut app: App, said: str) {
    if (app.logging == false) {
        return
    }
    log_line(app.log, said)
}

// What says which passes exist. The graph, and the two things every pipeline
// in it is built against, so a plugin declaring a pass needs nothing else.
GraphConfig :: struct {
    hook: fn(^u8, mut Graph, Device, u32),
    state: ^u8,
}

// Passes, declared into the App's graph. Run once on the way into the first
// frame rather than here, so a plugin installed after this call still declares
// its own, and so everything a program spawns before then is already in.
//
// What a hook may not do is ask the graph for a view or a sampler: nothing is
// made until the graph has a size, and the size comes after every hook has run.
// A pass that binds what the graph holds says so with `graph_rebuilds`, which is
// called with the first size as well as with every one after it.
app_configure_graph :: fn($Ctx: Type, mut app: App,
    hook: fn(mut Ctx, mut Graph, Device, u32), state: ^Ctx) {
    vec_push($GraphConfig, app.graph_configs, GraphConfig {
            hook = unsafe { ptr_cast($fn(^u8, mut Graph, Device, u32), hook) },
            state = unsafe { ptr_cast($u8, state) } })
}

// The hooks, then the order they imply, then the first size. False when the
// graph refuses, which is a program that cannot draw rather than one that draws
// nothing, so it says so once here instead of every frame.
configure_graph :: fn(mut app: App) -> bool {
    device := renderer_device(app.renderer)
    format := renderer_format(app.renderer)
    var i: i64 = 0
    while (i < vec_len($GraphConfig, app.graph_configs)) {
        held := vec_get($GraphConfig, app.graph_configs, i)
        held.hook(held.state, app.renderer.graph, device, format)
        i = i + 1
    }
    if (graph_schedule(app.renderer.graph) == false) {
        print("the render graph cannot run\n")
        return false
    }
    graph_resize(app.renderer.graph, width(app.platform),
        height(app.platform))
    true
}

// What changes the graph each frame. A pass can be turned off and on with
// `graph_set_enabled`, and what decides that is the world: a settings resource
// saying the bloom is off is read here and the pass stops running, without the
// graph being scheduled again.
UpdateGraph :: struct {
    hook: fn(^u8, mut Graph, World),
    state: ^u8,
}

app_update_graph :: fn($Ctx: Type, mut app: App,
    hook: fn(mut Ctx, mut Graph, World), state: ^Ctx) {
    vec_push($UpdateGraph, app.update_graph, UpdateGraph {
            hook = unsafe { ptr_cast($fn(^u8, mut Graph, World), hook) },
            state = unsafe { ptr_cast($u8, state) } })
}

// The hooks, in the order they were added, before the frame is filled. What
// runs this frame is settled first and what goes in it second.
update_graph :: fn(mut app: App) {
    var i: i64 = 0
    while (i < vec_len($UpdateGraph, app.update_graph)) {
        held := vec_get($UpdateGraph, app.update_graph, i)
        held.hook(held.state, app.renderer.graph, app.world)
        i = i + 1
    }
}

// What a frame does between the world and the graph. A system is a
// `fn(mut World)` and cannot reach a device, so what writes a uniform or
// fills the run is this instead: the App, and whatever the caller kept its
// own state in, which is how a pass is given its state too.
BeforeRender :: struct {
    hook: fn(^u8, mut App),
    state: ^u8,
}

app_before_render :: fn($Ctx: Type, mut app: App,
    hook: fn(mut Ctx, mut App), state: ^Ctx) {
    vec_push($BeforeRender, app.before_render, BeforeRender {
            hook = unsafe { ptr_cast($fn(^u8, mut App), hook) },
            state = unsafe { ptr_cast($u8, state) } })
}

// The renderer, composed: a pass that draws what the world says is drawn, lit by
// what the world says is a light. This is what a program gets instead of writing
// a shader.
//
// It declares one culling pass and one drawing pass, and registers the hook that
// fills the run and the lights every frame. Which targets they write is the
// window and a depth buffer the graph makes, so a program that wants its own
// chain writes its own passes instead and does not compose this.
render_plugin :: fn(mut app: App) {
    app.drawing = true
    // The two layouts the pass binds against, and nothing else. What it records
    // with beyond that is its own: the grid over the lights and the steps that
    // decide what is drawn are made inside it, so an App holds one pass rather
    // than a pass and the three things it happens to record.
    app.lit = lit_new(app_device(app), app_format(app),
        render_world_layout(app.render),
        render_world_batch_layout(app.render))
    app_configure_graph($App, app, declare_lit, ptr_to(app))
    app_before_render($App, app, fill_lit, ptr_to(app))
}

// The world into the run, and the world's lights into the buffer beside it.
fill_lit :: fn(mut app: App, mut held: App) {
    queue := app_queue(app)
    ids := app_ids(app)
    app_extract(app, all_drawn(ids.global_transform, ids.transform, ids.drawn),
        app_view(app))
    counts := lights_of(app.world, light_ids(app.world), app.lights)
    eye := app_camera(app)
    width := app_width(app)
    height := app_height(app)
    lit_write_lights(app.lit, queue, app.lights, counts.total,
        counts.directional, camera_projection(eye, width, height),
        camera_view(eye), width, height, eye.z_near, eye.z_far)
    lit_write_frame(app.lit, queue, app_view(app), camera_view(eye),
        camera_position(eye), vec3(0.05, 0.05, 0.07),
        counts.total, counts.directional)
}

// What the standard pass draws into: the window, cleared to the ambient colour,
// and a depth buffer that follows it.
//
// The steps that decide what is drawn go in first and the pass that draws reads
// what they wrote, which is the whole of what puts the two in order.
declare_lit :: fn(mut app: App, mut g: Graph, device: Device, format: u32) {
    screen := graph_backbuffer(g)
    depth := graph_depth(g, "depth", WINDOW_SIZED, WINDOW_SIZED, DEPTH_FORMAT)
    lit_declare($App, g, record_view, ptr_to(app), screen, depth,
        Color { r = 0.02, g = 0.02, b = 0.03, a = 1.0 })
}

// Everything a frame does to draw the world, in the order it has to happen:
//
//   the light grid, so shading knows which lights reach where
//   the batch tables, so the draws exist at all
//   depth, for what certainly covers what is behind it
//   the classes, shaded against the depth already written
//
// One node to the graph. Declaring these as separate passes would put this
// order in every program that draws a view, and a program with two views would
// write it twice; nightshade's mesh node records the same sequence for the same
// reason.
record_view :: fn(mut app: App, context: NodeContext) {
    lit_record(app.lit, app.render, app.store, context)
}

// A system, onto a stage. The one registration door: `Stage::Startup` runs once
// on the way into the first frame and the rest run every frame, which is what
// the stage already decides, so this is the App saying it rather than a program
// reaching past it into the schedule.
app_add_system :: fn(mut app: App, stage: Stage, run: fn(mut World)) {
    schedule_add(app.schedule, stage, run)
}

// A system that runs only while the program is on one screen. Which screen a
// system belongs to travels with it in the schedule, so this is what a language
// with closures would write as a wrapper around the system: there is nothing to
// capture and nothing to wrap.
app_add_system_in_state :: fn(mut app: App, stage: Stage, state: i64,
    run: fn(mut World)) {
    schedule_add_in_state(app.schedule, stage, state, run)
}

// Where the program starts. A state is a number a program names its own
// constants for, and every screen after this one is asked for from a system
// with `world_state_request`.
app_insert_state :: fn(mut app: App, initial: i64) {
    ecs_resource_set($States, app.world, resource_of($States, app.world),
        states_new(initial))
    app.state_started = false
}

// One system each time the program arrives at a screen, and each time it
// leaves one. Both run between the transition and the frame that follows it, so
// what an enter hook spawns is there for the first frame of its own screen.
app_on_enter :: fn(mut app: App, state: i64, run: fn(mut World)) {
    vec_push($StateHook, app.on_enter, StateHook { state = state, run = run })
}

app_on_exit :: fn(mut app: App, state: i64, run: fn(mut World)) {
    vec_push($StateHook, app.on_exit, StateHook { state = state, run = run })
}

// What runs when the program arrives at a screen or leaves one.
StateHook :: struct { state: i64, run: fn(mut World) }

// The requested screen taken, and the hooks either side of the change run. The
// first frame is a change too: a program that never asks for another state
// still enters the one it started in, so what its enter hooks spawn is there
// before anything reads the world.
settle_state :: fn(mut app: App) {
    was := world_state(app.world)
    changed := world_state_apply(app.world)
    if (app.state_started && changed == false) {
        return
    }
    if (app.state_started) {
        run_hooks(app.on_exit, app.world, was)
    }
    app.state_started = true
    run_hooks(app.on_enter, app.world, world_state(app.world))
}

run_hooks :: fn(held: Vec<StateHook>, mut world: World, state: i64) {
    var index: i64 = 0
    while (index < vec_len($StateHook, held)) {
        one := vec_get($StateHook, held, index)
        if (one.state == state) {
            run := one.run
            run(world)
        }
        index = index + 1
    }
}

// Several onto one stage, in the order they are written. The list is a
// compile-time one, so this is one call per system after the unroll and there
// is nothing here at run time.
app_add_systems :: fn(mut app: App, stage: Stage, args: $...) {
    for run in args {
        schedule_add(app.schedule, stage, run)
    }
}

// One out again, by the same function it went in as. Answers whether anything
// went, which is what a program dropping one of the engine's own frame systems
// checks rather than assuming.
app_remove_system :: fn(mut app: App, run: fn(mut World)) -> bool {
    schedule_remove(app.schedule, run)
}

// A resource, readable from any system. Registered here if it was not already,
// so a program inserts one without first asking the world for a slot; what
// reads it names the type the same way.
app_insert_resource :: fn($T: Type, mut app: App, move value: $T) {
    slot := ecs_resource_register($T, app.world)
    ecs_resource_set($T, app.world, slot, value)
}

// What a program says and answers when it could not open. Written here because
// every program says the same thing, and because which half failed is this
// file's own enum rather than something a caller should have to read. What is
// printed came out of the failure, so it says the same thing however long ago
// the platform was shut down.
app_failed :: fn(held: AppError) -> i64 {
    print("{}\n", held.said)
    match held.why {
        case.NoWindow: {
            print("no window\n")
            1
        }
        case.NoDevice: {
            print("no device\n")
            2
        }
    }
}

// Everything opening took, given back, and what `main` should answer. Children
// before what made them: the tables are the device's, the world holds the tree,
// and the window outlives the device it was drawn into.
app_close :: fn(move app: App) -> i64 {
    vec_free($Installed, app.installed)
    vec_free($GraphConfig, app.graph_configs)
    vec_free($UpdateGraph, app.update_graph)
    vec_free($BeforeRender, app.before_render)
    vec_free($StateHook, app.on_enter)
    vec_free($StateHook, app.on_exit)
    lit_free(app.lit)
    heap_release_slice($GpuLight, app.lights)
    log_close(app.log)
    render_world_free(app.render)
    geometry_free(app.store)
    materials_free(app.materials)
    mesh_cache_free(app.meshes)
    schedule_free(app.schedule)
    giving := world_tree_take(app.world)
    hierarchy_free(giving)
    ecs_free(app.world)
    renderer_close(app.renderer)
    platform_close(app.platform)
    0
}

// The far half of a frame: what the machine did, and what the world made of it.
// False when the window asked to close or a system asked the program to stop,
// which is what a main loop runs until. Which keys mean stop is a system's
// business, so `exit_on_escape_plugin` is what a demo installs and this reads
// only the answer.
//
// The renderer and the graph are resized together, because a surface and every
// target tested against it are the same size or nothing draws.
app_next :: fn(mut app: App) -> bool {
    // The graph and the startup stage, on the way into the first frame rather
    // than at the end of opening, so a plugin installed after `app_open` still
    // declares its passes and still gets a startup run.
    if (app.started == false) {
        app.started = true
        app.drawable = configure_graph(app)
        // Nothing runs for a program that cannot draw, so a graph that refuses
        // stops here rather than after a startup pass whose work is thrown away.
        if (app.drawable == false) {
            return false
        }
        settle_state(app)
        schedule_start(app.schedule, app.world, world_state(app.world))
    }
    if (app.drawable == false) {
        return false
    }
    if (platform_poll(app.platform) == false) {
        return false
    }
    // One call: the surface and every target measured against it are the same
    // size or nothing draws, so the renderer resizes its own graph.
    if (resized(app.platform)) {
        renderer_resize(app.renderer, width(app.platform),
            height(app.platform))
    }
    world_input(app.world, platform_input(app.platform))
    // The screen settles before anything runs, so no frame has some of its
    // systems under one screen and the rest under another.
    settle_state(app)
    schedule_run(app.schedule, app.world, world_state(app.world))
    // A system deciding the program is finished is the last thing a frame does,
    // so the frame it decided in is finished rather than half drawn.
    world_exit_wanted(app.world) == false
}

// Every frame until the window closes or a system says to stop.
//
// The App is borrowed rather than taken, because a pass reaches the run and the
// geometry through a pointer the program took before the first frame, and a
// pointer into a value that has been moved names where it used to be. What
// closes the App is the caller, after this answers.
app_run :: fn(mut app: App) {
    if (app.has_runner) {
        run := app.runner
        return run(app)
    }
    while (app_next(app)) {
        update_graph(app)
        before_render(app)
        app_draw(app)
    }
}

// The App's own loop, replaced. A runner is handed the App and drives it
// however its host wants: an offscreen worker, an editor, a test harness that
// runs three frames and stops. What it drives with is `app_next` and
// `app_draw`, which are the two halves of a frame and are exported for exactly
// this.
//
// It borrows rather than takes, for the same reason `app_run` does: a pass
// reaches its state through a pointer the program took before the first frame,
// and a pointer into a value that has been moved names where it used to be.
app_set_runner :: fn(mut app: App, runner: fn(mut App)) {
    app.runner = runner
    app.has_runner = true
}

// The same, where the first one composed wins. A plugin that owns the loop uses
// this, so a program that sets its own with `app_set_runner` still overrides it
// whichever order the two were written in.
app_set_runner_if_unset :: fn(mut app: App, runner: fn(mut App)) {
    if (app.has_runner) {
        return
    }
    app.runner = runner
    app.has_runner = true
}

runs_nothing :: fn(mut app: App) {}

// The hooks, in the order they were added. Each is handed the App and the state
// it was registered with.
before_render :: fn(mut app: App) {
    var i: i64 = 0
    while (i < vec_len($BeforeRender, app.before_render)) {
        held := vec_get($BeforeRender, app.before_render, i)
        held.hook(held.state, app)
        i = i + 1
    }
}

// What the world says is drawn, put in the run the passes read. A program
// drawing one view calls this once; a program whose passes divide the world
// calls `render_world_begin`, `scene_sync` and `render_world_upload` itself,
// once per view, since which things a view draws and what it is culled against
// are exactly what differs between the runs.
app_extract :: fn(mut app: App, ids: ObjectIds, view_projection: Mat4) {
    render_world_begin(app.render)
    scene_sync(app.world, app.render, app.materials, app.meshes, ids)
    render_world_upload(app.render, renderer_queue(app.renderer),
        view_projection, app.materials, app.meshes)
}

// The near half of a frame: the graph, recorded into whatever the surface
// handed over. A frame that could not be acquired records nothing and is still
// ended, because the handles it took are counted whether it drew or not.
app_draw :: fn(mut app: App) {
    var f := renderer_begin(app.renderer)
    if (frame_ok(f)) {
        graph_run(app.renderer.graph, f)
    }
    renderer_end(app.renderer, f)
}

app_device :: fn(app: App) -> Device { renderer_device(app.renderer) }
app_queue :: fn(app: App) -> Queue { renderer_queue(app.renderer) }
app_format :: fn(app: App) -> u32 { renderer_format(app.renderer) }

app_width :: fn(app: App) -> i64 { width(app.platform) }
app_height :: fn(app: App) -> i64 { height(app.platform) }

// What the last poll left, for a program that wants the clock or a key the
// schedule does not read. A system reads the same thing out of the world.
app_input :: fn(app: App) -> Input { platform_input(app.platform) }

// Which component is which, asked of the world each time rather than kept here,
// so this and the world cannot disagree.
app_ids :: fn(app: App) -> WorldIds { world_ids(app.world) }

app_camera :: fn(app: App) -> Camera { world_camera(app.world) }

app_camera_set :: fn(mut app: App, move eye: Camera) {
    world_camera_set(app.world, eye)
}

// The camera the world holds, against the window as it is now. This is what
// both the frame uniform and the culling pass are given, and they have to be
// the same matrix or a thing is culled against a view it was not drawn in.
app_view :: fn(app: App) -> Mat4 {
    camera_view_projection(world_camera(app.world), width(app.platform),
        height(app.platform))
}

// Three plugins that register nothing, for the tests below. What a group holds
// is functions, so which one is which is the only thing these have to be.
adds_nothing :: fn(mut app: App) {}
adds_nothing_either :: fn(mut app: App) {}
stands_in :: fn(mut app: App) {}

test "a group keeps its members in the order they were added" {
    var group := plugin_group_new()
    plugin_group_add(group, adds_nothing)
    plugin_group_add(group, adds_nothing_either)
    held := vec_slice($GroupMember, group.members)
    assert(held[0].build == adds_nothing)
    assert(held[1].build == adds_nothing_either)
    plugin_group_free(group)
}

test "a member set another way keeps its place and its name" {
    var group := plugin_group_new()
    plugin_group_add(group, adds_nothing)
    plugin_group_add(group, adds_nothing_either)
    plugin_group_set(group, adds_nothing, stands_in)
    held := vec_slice($GroupMember, group.members)
    // First still, and still found under the name the group knows it by.
    assert(held[0].build == stands_in)
    assert(held[0].named == adds_nothing)
    assert(group_index(group, adds_nothing) == 0)
    assert(held[1].build == adds_nothing_either)
    plugin_group_free(group)
}

test "a disabled member stays in the group and is not installed" {
    var group := plugin_group_new()
    plugin_group_add(group, adds_nothing)
    plugin_group_add(group, adds_nothing_either)
    plugin_group_disable(group, adds_nothing)
    held := vec_slice($GroupMember, group.members)
    // Its place is kept, so disabling one does not renumber the rest.
    assert(vec_len($GroupMember, group.members) == 2)
    assert(held[0].enabled == false)
    assert(held[1].enabled)
    plugin_group_free(group)
}

test "a group answers with nothing for a member it does not hold" {
    var group := plugin_group_new()
    plugin_group_add(group, adds_nothing)
    assert(group_index(group, adds_nothing_either) == (-1))
    plugin_group_free(group)
}

test "the standard group holds the log plugin" {
    var group := default_plugins()
    assert(group_index(group, log_plugin) == 0)
    plugin_group_free(group)
}
