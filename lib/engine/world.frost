// What a frame does to a world, which is everything before the renderer sees it.
//
//     ids := world_prepare(world)
//     mut frame := world_schedule()
//     ...
//     world_input(world, platform_input(p))
//     schedule_run(frame, world, ANY_STATE)
//
// A drawing program has two halves and this is the far one. Here a thing has a
// local transform, a turn and somewhere it hangs from, and a frame works out
// where it ended up; what comes of that is a `GlobalTransform`, which
// `scene_sync` reads to fill the renderer's side. Nothing here holds a device
// and nothing here records a command.
//
// Every system is a `fn(mut World)` and captures nothing, so what one needs is
// either a component or a resource. A component is found by the type it is and
// a resource likewise, so nothing here writes a number down; `WorldIds` gathers
// the answers for a walk that would otherwise ask once a row.

import "../renderer/render_world.frost"
import "../platform/platform.frost"
import "camera.frost"
import "ecs.frost"
import "math.frost"

export LocalTransform, GlobalTransform, WorldIds, Exit, local_at,
    world_prepare, world_tree, world_tree_take,
    world_schedule, place_things, move_camera,
    exit_on_escape,
    world_exit, world_exit_wanted,
    world_input, world_ids, world_camera, world_camera_set,
    world_state, world_state_request, world_state_apply

// Where a thing sits relative to whatever it hangs off: an offset from its
// parent's origin, an orientation, and a scale on each axis.
//
// Three parts rather than a matrix, because that is what a thing is authored
// with and what every file format hands over.
LocalTransform :: struct { translation: Vec3, rotation: Quat, scale: Vec3 }

// Where a thing ended up in the world, as one matrix, after everything it hangs
// off has been applied. Written by the walk below from the chain of
// `LocalTransform`s above it.
//
// This is what anything asking where something is reads. `scene_sync` is one
// such reader and the renderer's `Transform` is what it writes; a thing that
// wants a position without wanting to draw reads this and touches nothing of
// the renderer's.
GlobalTransform :: struct { matrix: Mat4 }

// A local transform that only says where, for a thing that faces the way it was
// modelled and is the size it was modelled at.
local_at :: fn(translation: Vec3) -> LocalTransform {
    LocalTransform { translation = translation, rotation = quat_identity(),
        scale = vec3(1.0, 1.0, 1.0) }
}

// Which component is which, gathered so a walk that reads several of them asks
// once rather than once a row. It is worked out from the world every time it is
// asked for, so it cannot say something the world does not.
WorldIds :: struct {
    local_transform: i64,
    global_transform: i64,
    transform: i64,
    drawn: i64,
}

// The components and resources every drawing program needs, declared in one
// call. Declared rather than registered: a program that installs two things
// each wanting a `LocalTransform` or an `Input` gets one of each, and neither
// has to know whether the other asked first.
//
// The tree starts empty: a program hangs whatever it wants off whatever it
// wants, and a thing attached to nothing is a root.
world_prepare :: fn(mut world: World) -> WorldIds {
    component_for($LocalTransform, world)
    component_for($GlobalTransform, world)
    component_for($Transform, world)
    component_for($Drawn, world)
    ecs_resource_register($Hierarchy, world)
    ecs_resource_register($Input, world)
    ecs_resource_register($Camera, world)
    ecs_resource_register($Exit, world)
    ecs_resource_register($States, world)
    ecs_resource_set($Hierarchy, world, resource_of($Hierarchy, world),
        hierarchy_new())
    // A resource starts zeroed, and a zeroed `Input` is a frame in which
    // nothing was held and no time passed, so the first schedule before the
    // first poll moves nothing.
    ecs_resource_set($Camera, world, resource_of($Camera, world),
        camera_default())
    world_ids(world)
}

// What the platform saw, put where a system can read it. Called once a frame
// before the schedule runs, since everything in the schedule that reacts to a
// key or advances by the clock reads it from here.
world_input :: fn(mut world: World, held: Input) {
    ecs_resource_set($Input, world, resource_of($Input, world), held)
}

// Which component is which, worked out from the types rather than remembered.
// A system captures nothing but it can still spell a type, so this is what it
// asks instead of being told a number.
world_ids :: fn(world: World) -> WorldIds {
    WorldIds {
        local_transform = component_of($LocalTransform, world),
        global_transform = component_of($GlobalTransform, world),
        transform = component_of($Transform, world),
        drawn = component_of($Drawn, world),
    }
}

// The camera the world holds, which is what a frame uniform is written from.
world_camera :: fn(world: World) -> Camera {
    ecs_resource($Camera, world, resource_of($Camera, world))
}

// Where the camera starts, for a program that wants it somewhere other than
// `camera_default` puts it.
world_camera_set :: fn(mut world: World, move eye: Camera) {
    ecs_resource_set($Camera, world, resource_of($Camera, world), eye)
}

// The tree the world holds, for a program hanging one thing off another.
world_tree :: fn(mut world: World) -> ref Hierarchy {
    ecs_resource_ref($Hierarchy, world, resource_of($Hierarchy, world))
}

// The tree, handed over rather than borrowed, which is what releasing it takes.
world_tree_take :: fn(mut world: World) -> Hierarchy {
    ecs_resource($Hierarchy, world, resource_of($Hierarchy, world))
}

// Whether something has asked the program to stop. A system cannot reach the
// window, so a system that decides the program is finished says so here and the
// loop that owns the window reads it.
Exit :: struct { wanted: bool }

// The three the engine registers, as a schedule of their own, for a program
// running the world with no device anywhere near it. What the App composes is
// the same three, through its own plugins, since a plugin is handed an App and
// this file cannot name one.
world_schedule :: fn() -> Schedule {
    var held := schedule_new()
    schedule_add(held, Stage :: FramePostUpdate, place_things)
    schedule_add(held, Stage :: FrameUpdate, move_camera)
    held
}

// Which screen the program is on. A number rather than a type of the program's
// own, because a system is a `fn(mut World)` and the schedule holds the state a
// system runs in beside it; what a program does is name its own constants.
//
//     TITLE :: 0
//     PLAYING :: 1
//     app_add_system_in_state(app, Stage::FrameUpdate, PLAYING, step)
world_state :: fn(world: World) -> i64 {
    states_current(ecs_resource($States, world, resource_of($States, world)))
}

// Asked for, and taken at the start of the next frame rather than here. A frame
// that changed state halfway through would run some of its systems under one
// screen and the rest under another, which is the one thing a state machine is
// for stopping.
world_state_request :: fn(mut world: World, value: i64) {
    var held := ecs_resource($States, world, resource_of($States, world))
    states_request(held, value)
    ecs_resource_set($States, world, resource_of($States, world), held)
}

// The requested state taken, answering whether it was a change. Called by
// whatever owns the frame, before the schedule runs.
world_state_apply :: fn(mut world: World) -> bool {
    var held := ecs_resource($States, world, resource_of($States, world))
    changed := states_apply(held)
    ecs_resource_set($States, world, resource_of($States, world), held)
    changed
}

// Asked to stop, which is what a loop over the world runs until.
world_exit :: fn(mut world: World) {
    ecs_resource_set($Exit, world, resource_of($Exit, world),
        Exit { wanted = true })
}

world_exit_wanted :: fn(world: World) -> bool {
    ecs_resource($Exit, world, resource_of($Exit, world)).wanted
}

// Escape closes it, which is what a demo wants and what a game with a menu on
// that key does not. A system rather than a line in the poll, so a program that
// wants the key for something else leaves this one out.
exit_on_escape :: fn(mut world: World) {
    held := ecs_resource($Input, world, resource_of($Input, world))
    if (input_key_pressed(held, KEY_ESCAPE)) {
        world_exit(world)
    }
}

// The camera moved by whatever was held this frame. Both the camera and the
// input come out of the world, because a system is handed a world and nothing
// else.
move_camera :: fn(mut world: World) {
    held := ecs_resource($Input, world, resource_of($Input, world))
    var eye := ecs_resource($Camera, world, resource_of($Camera, world))
    camera_advance(eye, held, input_delta_seconds(held))
    ecs_resource_set($Camera, world, resource_of($Camera, world), eye)
}

// Where everything ended up, walked down the tree from every root, so a thing
// is placed after whatever it hangs off however deep it hangs. A thing attached
// to nothing is a root and is placed against nothing.
place_things :: fn(mut world: World) {
    ids := world_ids(world)
    var q := query_begin(world)
    query_with(q, ids.global_transform)
    query_with(q, ids.local_transform)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        var row: i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            tree := world_tree(world)
            if (is_no_entity(hierarchy_parent(tree, entity))) {
                place_subtree(world, ids.local_transform,
                    ids.global_transform, entity, mat4_identity())
            }
            row = row + 1
        }
    }
}

// One thing and everything under it, each placed against what it hangs off.
place_subtree :: fn(mut world: World, local: i64, global: i64,
    entity: Entity, above: Mat4) {
    ecs_set($GlobalTransform, world, entity, global, GlobalTransform {
            matrix = mat4_mul(above, local_of(world, local, entity)) })
    tree := world_tree(world)
    var child := hierarchy_first_child(tree, entity)
    while (is_no_entity(child) == false) {
        // Read before the walk goes down, since the tree is read again in
        // there and this is the last thing wanted from it here.
        following := hierarchy_next_sibling(tree, child)
        // Read back rather than carried, because a matrix written into a
        // component has been handed over and the name that held it does not
        // hold it for the next child.
        here := ecs_get($GlobalTransform, world, entity, global)
        place_subtree(world, local, global, child, here.matrix)
        child = following
    }
}

// A thing's own transform, before anything above it is applied.
local_of :: fn(mut world: World, local: i64, entity: Entity) -> Mat4 {
    place := ecs_get($LocalTransform, world, entity, local)
    mat4_mul(mat4_translation(place.translation),
        mat4_mul(quat_to_mat4(place.rotation), mat4_scale(place.scale)))
}

// What a frame does to a world is arithmetic over components and resources, so
// these run with no device anywhere near them: what the camera does with what
// was held, and where a thing three deep in a tree ends up.

// A resource of the test's own, so the engine's land somewhere other than where
// they would if nothing else were in the world.
Bystander :: struct { count: i64 }

// Two screens and a counter, for the tests below.
TITLE :: 0
PLAYING :: 1

Score :: struct { points: i64 }

count_a_point :: fn(mut world: World) {
    var held := ecs_resource($Score, world, resource_of($Score, world))
    held.points = held.points + 1
    ecs_resource_set($Score, world, resource_of($Score, world), held)
}

test "a system bound to a screen runs on that screen and no other" {
    var world := ecs_new()
    world_prepare(world)
    ecs_resource_register($Score, world)
    var frame := schedule_new()
    schedule_add_in_state(frame, Stage :: FrameUpdate, PLAYING, count_a_point)

    // The world starts on the title screen, where this system is not.
    schedule_run(frame, world, world_state(world))
    assert(ecs_resource($Score, world, resource_of($Score, world)).points == 0)

    world_state_request(world, PLAYING)
    // Asking is not arriving. Nothing changes until the state is taken, which
    // is what stops a frame running half its systems under each screen.
    schedule_run(frame, world, world_state(world))
    assert(ecs_resource($Score, world, resource_of($Score, world)).points == 0)

    assert(world_state_apply(world))
    assert(world_state(world) == PLAYING)
    schedule_run(frame, world, world_state(world))
    assert(ecs_resource($Score, world, resource_of($Score, world)).points == 1)

    // And back, which stops it again.
    world_state_request(world, TITLE)
    assert(world_state_apply(world))
    schedule_run(frame, world, world_state(world))
    assert(ecs_resource($Score, world, resource_of($Score, world)).points == 1)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

test "taking a state that was not asked for is not a change" {
    var world := ecs_new()
    world_prepare(world)
    // Nothing requested, so there is nothing to take and the hooks either side
    // of a change have no reason to run.
    assert(world_state_apply(world) == false)
    world_state_request(world, PLAYING)
    assert(world_state_apply(world))
    assert(world_state_apply(world) == false)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

// Nothing here reads a resource by its position, so nothing here breaks when
// the positions move. This registers a resource before the engine does, which
// shifts every slot the engine takes by one; while the engine read its
// resources at fixed numbers, this world would have had the camera moved by
// whatever happened to sit where the camera used to.
test "the engine finds its resources wherever they landed" {
    var world := ecs_new()
    ecs_resource_register($Bystander, world)
    world_prepare(world)
    var held := ecs_resource($Input, world, resource_of($Input, world))
    held.keys[KEY_W] = true
    held.step = 0.5
    world_input(world, held)

    before := world_camera(world)
    var frame := world_schedule()
    schedule_run(frame, world, ANY_STATE)
    after := world_camera(world)
    assert(after.position.z < before.position.z)

    // And the thing that was there first is untouched by any of it.
    assert(ecs_resource($Bystander, world,
            resource_of($Bystander, world)).count == 0)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

test "the camera moves by what the world was told was held" {
    var world := ecs_new()
    world_prepare(world)
    // A resource starts zeroed, so this is a frame in which nothing was held,
    // with one key and the clock written into it.
    var held := ecs_resource($Input, world, resource_of($Input, world))
    held.keys[KEY_W] = true
    held.step = 0.5
    world_input(world, held)

    before := world_camera(world)
    var frame := world_schedule()
    schedule_run(frame, world, ANY_STATE)
    after := world_camera(world)
    // Zero yaw looks down -Z, so forward is a smaller z.
    assert(after.position.z < before.position.z)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

test "the camera turns by what the world was told was held" {
    var world := ecs_new()
    world_prepare(world)
    var held := ecs_resource($Input, world, resource_of($Input, world))
    held.keys[KEY_LEFT] = true
    held.step = 0.5
    world_input(world, held)

    before := world_camera(world)
    var frame := world_schedule()
    schedule_run(frame, world, ANY_STATE)
    after := world_camera(world)
    assert(after.yaw > before.yaw)
    assert(after.position.x == before.position.x)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

test "a frame in which nothing was held moves nothing" {
    var world := ecs_new()
    world_prepare(world)
    // A frame that lasted a while with nothing held, since a frame of no time
    // at all would hold the camera still whatever it was told.
    var held := ecs_resource($Input, world, resource_of($Input, world))
    held.step = 0.5
    world_input(world, held)

    before := world_camera(world)
    var frame := world_schedule()
    schedule_run(frame, world, ANY_STATE)
    after := world_camera(world)
    assert(after.position.z == before.position.z)
    assert(after.yaw == before.yaw)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}

test "a thing is placed against whatever it hangs off, however deep" {
    var world := ecs_new()
    ids := world_prepare(world)
    wanted := mask_with(mask_with(mask_empty(),
            ids.local_transform), ids.global_transform)
    // Held in one place, since spawning three and naming each would hand every
    // one of them over to the array anyway.
    var chain: [3]Entity = [ecs_spawn_with(world, wanted),
        ecs_spawn_with(world, wanted), ecs_spawn_with(world, wanted)]
    var made: i64 = 0
    while (made < 3) {
        ecs_set($LocalTransform, world, chain[made], ids.local_transform,
            LocalTransform { translation = vec3(1.0, 0.0, 0.0),
                rotation = quat_identity(), scale = vec3(1.0, 1.0, 1.0) })
        made = made + 1
    }
    tree := world_tree(world)
    hierarchy_attach(tree, chain[1], chain[0])
    hierarchy_attach(tree, chain[2], chain[1])

    var frame := world_schedule()
    schedule_run(frame, world, ANY_STATE)

    // One step along x each, applied down the chain, so the leaf lands at
    // three. Two passes over roots and their children would leave it at two.
    placed := ecs_get($GlobalTransform, world, chain[2], ids.global_transform)
    assert(placed.matrix.m[12] > 2.999 && placed.matrix.m[12] < 3.001)
    between := ecs_get($GlobalTransform, world, chain[1],
        ids.global_transform)
    assert(between.matrix.m[12] > 1.999 && between.matrix.m[12] < 2.001)

    schedule_free(frame)
    giving := world_tree_take(world)
    hierarchy_free(giving)
    ecs_free(world)
}
