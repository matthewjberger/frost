// The walk from a world to what the GPU draws.
//
//     render_world_begin(render)
//     scene_sync(world, render, registry, cache, ids)
//     render_world_upload(render, queue)
//
// A pass records commands and a world holds game state, and nothing should be
// both. This is the one place they meet: it queries the world for everything
// that has ended up somewhere and is drawn, and fills the run the renderer
// hands to the GPU. The pass knows nothing about entities, components or
// tables.
//
// What it fills is one flat array, one entry per thing, and nothing per-entity
// is made or kept. A thing spawned while the program runs is drawn on the next
// frame because the walk finds it, and a thing despawned stops being drawn
// because the walk does not: the run is built from nothing every frame rather
// than kept in step with the world. The renderer stops knowing how many things
// there are, and nothing has to be renumbered when that changes.
//
// This sits on the world's side of the line and is the only thing that stands
// on both. It reads where a thing ended up, which is the world's
// `GlobalTransform`, and writes the renderer's `Transform` and the run; nothing
// here is reached from the renderer's side.

import "../renderer/render_world.frost"
import "../renderer/mesh.frost"
import "../renderer/material.frost"
import "world.frost"
import "ecs.frost"

export ObjectIds, all_drawn, drawn_in_layer, scene_sync

// Which component is which, and which layer this run is for, since a system
// reaches a component by number and the numbers belong to the world that
// registered them.
//
// A layer of -1 takes everything. Two passes over different halves of a world
// are two runs built from two layers, so each pass is handed a run holding only
// what it draws: which things those are is decided here, once a frame, rather
// than in a pass on every item it records.
ObjectIds :: struct {
    global_transform: i64,
    transform: i64,
    drawn: i64,
    layer: i64,
}

// Everything that is drawn, whatever layer it is in.
all_drawn :: fn(global_transform: i64, transform: i64,
    drawn: i64) -> ObjectIds {
    ObjectIds { global_transform = global_transform, transform = transform,
        drawn = drawn, layer = -1 }
}

// One layer of what is drawn, for a program whose passes divide the world.
drawn_in_layer :: fn(global_transform: i64, transform: i64, drawn: i64,
    layer: i64) -> ObjectIds {
    ObjectIds { global_transform = global_transform, transform = transform,
        drawn = drawn, layer = layer }
}

// Everything the world says is drawn, pushed into the run. The caller empties
// it first and uploads after, so a program drawing two layers walks twice into
// two runs and a program drawing one walks once.
//
// Where a thing ended up is the world's answer and it is copied onto the
// renderer's own `Transform` here. That copy is what the boundary is: a pass
// reads a component of the renderer's, and anything else that wants a position
// reads `GlobalTransform` without ever naming a renderer type.
scene_sync :: fn(mut world: World, mut render: RenderWorld,
    registry: Materials, cache: MeshCache, ids: ObjectIds) {
    mut q := query_begin(world)
    query_with(q, ids.global_transform)
    query_with(q, ids.transform)
    query_with(q, ids.drawn)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            shown := ecs_get($Drawn, world, entity, ids.drawn)
            if (ids.layer < 0 || shown.layer == ids.layer) {
                placed := ecs_get($GlobalTransform, world, entity,
                    ids.global_transform).matrix
                ecs_set($Transform, world, entity, ids.transform,
                    Transform { matrix = placed })
                // What it is made of and what shape it is are two numbers, not
                // two things. Which draw they land in is worked out on the
                // device from the material, so nothing here reads one.
                render_world_push(render, placed, shown.mesh, shown.material,
                    shown.layer)
            }
            row = row + 1
        }
    }
}
