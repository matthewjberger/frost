// The device, the surface, and the frame, under one handle a program opens
// once and a pass draws into.
//
//   mut r := renderer_open(platform_window(p), width(p), height(p))
//   while (platform_poll(p)) {
//       if (resized(p)) {
//           renderer_resize(r, width(p), height(p))
//           graph_resize(g, width(p), height(p))
//       }
//       mut f := renderer_begin(r)
//       if (frame_ok(f)) { graph_run(g, f) }
//       renderer_end(r, f)
//   }
//
// `renderer_end` on every path, including the one where no frame was acquired,
// because a `Frame` is linear and ending it is what gives its handles back.
//
// Bringing wgpu up is the same twelve steps every time and none of them are a
// program's business: an instance, a surface off the platform window, an
// adapter chosen knowing that surface, a device, a queue, and a configuration
// whose format the surface names rather than a guess. That is what this owns,
// and it is where the window ends.
//
// What to draw, in what order, and into what belongs to `graph.frost`. A pass
// declares the targets it reads and writes, the graph works out the order from
// those declarations, makes every target that is not the window's, and hands
// each pass an encoder over a `Target`. This module supplies the two halves the
// graph builds on: the frame's own surface texture, and `frame_pass_into`,
// which opens a render pass over whatever target it is given.

import "../platform/sdl.frost"
import "wgpu.frost"

export Renderer, Frame, Target,
    renderer_open, renderer_close, renderer_ok, renderer_resize,
    renderer_begin, renderer_end,
    renderer_device, renderer_queue, renderer_format,
    frame_ok, frame_view, frame_encoder, frame_pass_into,
    target_of, no_view,
    DEPTH_FORMAT, no_pointer

no_pointer :: fn() -> ^u8 {
    zero := 0
    unsafe { ptr_cast($u8, zero) }
}

// What depth is kept in. Twenty-four bits with no stencil is what a scene that
// only sorts needs, and every backend has it. One name, so the texture and
// every pipeline tested against it agree without either writing the number.
DEPTH_FORMAT :: TEXTURE_FORMAT_DEPTH24_PLUS

// The pieces a draw needs, kept together because none of them is useful alone
// and every one of them is made once.
Renderer :: struct {
    instance: Instance,
    surface: Surface,
    adapter: Adapter,
    device: Device,
    queue: Queue,
    format: u32,
    configuration: SurfaceConfiguration,
    opened: bool,
}

// One frame in flight, and `linear` because of what it holds. Every handle in
// here is counted by wgpu and has to be given back exactly once: a surface
// texture still held is a surface that cannot be configured, which is a resize
// that fails. Rust reaches for `Drop` here. Frost has no destructors, and this
// is the thing it has instead: the obligation is on the type, `renderer_end`
// takes the frame by `move`, and a path that acquires one and returns without
// ending it stops compiling.
//
// It is the frame rather than the handles that carries the obligation. A
// `Device` or a `BindGroup` is refcounted and read out of a struct all over a
// program, which is shared ownership and a different thing; these four are
// taken and given back inside one frame, which is what linear describes.
Frame :: linear struct {
    texture: SurfaceTexture,
    view: TextureView,
    encoder: CommandEncoder,
    ready: bool,
}

// Waits for a callback that answers on the instance's own event pump. wgpu
// answers a request when it is ready and not before, and there is no thread to
// wait on, so the pump is the wait.
spin_until :: fn(instance: Instance, mut ready: i64, limit: i64) -> bool {
    mut spins : i64 = 0
    while (ready == 0 && spins < limit) {
        instance_process_events(instance)
        spins = spins + 1
    }
    ready != 0
}

AdapterSlot :: struct { handle: Adapter, ready: i64 }
DeviceSlot :: struct { handle: Device, ready: i64 }

take_adapter :: fn(status: u32, handle: Adapter, value message: StringView,
    userdata1: ^u8, userdata2: ^u8) {
    mut slot := unsafe { ptr_cast($AdapterSlot, userdata1) }
    unsafe { slot^.handle = handle }
    unsafe { slot^.ready = 1 }
}

take_device :: fn(status: u32, handle: Device, value message: StringView,
    userdata1: ^u8, userdata2: ^u8) {
    mut slot := unsafe { ptr_cast($DeviceSlot, userdata1) }
    unsafe { slot^.handle = handle }
    unsafe { slot^.ready = 1 }
}

// Opens the device against a platform window. A renderer that could not be
// brought up answers false to `renderer_ok`, and a caller checks that before
// beginning a frame rather than drawing into nothing.
renderer_open :: fn(window: Window, w: i64, h: i64) -> Renderer {
    mut r := Renderer {
        instance = no_instance(), surface = no_surface(),
        adapter = no_adapter(), device = no_device(), queue = no_queue(),
        format = 0, configuration = surface_configuration_init(),
        opened = false,
    }
    r.instance = create_instance(no_pointer())

    // The surface, chained off whatever handle this platform names a window
    // with.
    properties := window_properties(window)
    hwnd := window_pointer_property(properties, PROP_WIN32_HWND)
    if (hwnd == no_pointer()) {
        return r
    }
    mut source := surface_source_windows_HWND_init()
    source.chain.stype = S_TYPE_SURFACE_SOURCE_WINDOWS_HWND
    source.hwnd = hwnd
    mut descriptor := surface_descriptor_init()
    descriptor.next_in_chain = ptr_to(source)
    r.surface = instance_create_surface(r.instance, ptr_to(descriptor))

    // The adapter is chosen knowing the surface it will draw to. Choosing it
    // first can hand back one this surface cannot use, and the surface only
    // says so later, when it is asked what formats it takes.
    mut adapter_slot := AdapterSlot { handle = no_adapter(), ready = 0 }
    mut adapter_info := RequestAdapterCallbackInfo {
        next_in_chain = no_pointer(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = take_adapter,
        userdata1 = ptr_to(adapter_slot),
        userdata2 = no_pointer(),
    }
    mut options := request_adapter_options_init()
    options.feature_level = FEATURE_LEVEL_CORE
    options.compatible_surface = r.surface
    instance_request_adapter(r.instance, ptr_to(options), ptr_to(adapter_info))
    if (spin_until(r.instance, adapter_slot.ready, 2000000) == false) {
        return r
    }
    r.adapter = adapter_slot.handle

    mut device_slot := DeviceSlot { handle = no_device(), ready = 0 }
    mut device_info := RequestDeviceCallbackInfo {
        next_in_chain = no_pointer(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = take_device,
        userdata1 = ptr_to(device_slot),
        userdata2 = no_pointer(),
    }
    // What a draw whose arguments come off the GPU needs. An indirect draw may
    // only name a non-zero first instance where the device says it can, and
    // that number is how a batch finds its own slice of the list a compute pass
    // wrote. Asked for rather than assumed: a device without it fails here,
    // where the reason is one line, rather than inside a draw call.
    mut wanted : [1]u32 = [FEATURE_NAME_INDIRECT_FIRST_INSTANCE]
    mut descriptor := device_descriptor_init()
    descriptor.required_features_count = 1
    descriptor.required_features = ptr_to(wanted[0])
    adapter_request_device(r.adapter, ptr_to(descriptor), ptr_to(device_info))
    if (spin_until(r.instance, device_slot.ready, 2000000) == false) {
        return r
    }
    r.device = device_slot.handle
    r.queue = device_get_queue(r.device)

    // The format the surface accepts, asked rather than assumed: which ones it
    // takes belongs to the driver and the window, not to the API.
    mut capabilities := surface_capabilities_init()
    if (surface_get_capabilities(r.surface, r.adapter, ptr_to(capabilities)) != 1) {
        return r
    }
    if (capabilities.formats_count == 0) {
        return r
    }
    r.format = unsafe { ptr_cast($u32, capabilities.formats)^ }

    r.configuration = surface_configuration_init()
    r.configuration.device = r.device
    r.configuration.format = r.format
    r.configuration.usage = TextureUsage::RenderAttachment
    r.configuration.width = cast($u32, w)
    r.configuration.height = cast($u32, h)
    r.configuration.present_mode = PRESENT_MODE_FIFO
    surface_configure(r.surface, ptr_to(r.configuration))
    r.opened = true
    r
}

renderer_ok :: fn(r: Renderer) -> bool { r.opened }
renderer_device :: fn(r: Renderer) -> Device { r.device }
renderer_queue :: fn(r: Renderer) -> Queue { r.queue }
renderer_format :: fn(r: Renderer) -> u32 { r.format }

// Everything opening took, given back, children before what made them. These
// live as long as the program does, so what this buys is a clean exit rather
// than a working resize: the frame-scoped handles are the ones whose counting
// decides whether the next frame draws, and those are `Frame`'s.
renderer_close :: fn(mut r: Renderer) {
    queue_release(r.queue)
    device_release(r.device)
    adapter_release(r.adapter)
    surface_release(r.surface)
    instance_release(r.instance)
    r.opened = false
}

// A surface has to be told the window changed. Every target tested against it
// has to change with it, and those belong to the graph, which is told the same
// thing by the same caller.
renderer_resize :: fn(mut r: Renderer, w: i64, h: i64) {
    if (w <= 0 || h <= 0) {
        return
    }
    r.configuration.width = cast($u32, w)
    r.configuration.height = cast($u32, h)
    surface_configure(r.surface, ptr_to(r.configuration))
}

// Whether what the surface answered with is something to draw into.
acquired :: fn(f: Frame) -> bool {
    f.texture.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_OPTIMAL
        || f.texture.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_SUBOPTIMAL
}

// Letting go of the texture the surface handed over. A failed acquire answers
// with nothing to release, so the handle is checked before it is given back.
release_acquired :: fn(mut f: Frame) {
    if (f.texture.texture == no_texture()) {
        return
    }
    texture_release(f.texture.texture)
    f.texture.texture = no_texture()
}

// Acquires the frame's texture and opens an encoder for it.
//
// A surface goes stale when the window moves under it, and skipping the frame
// is not enough: nothing would make it fresh again and the window would stay
// black. So a stale surface is configured again and asked a second time, and
// the frame after a resize is drawn rather than dropped.
//
// The texture from the stale attempt is given back before the surface is
// configured. A surface cannot be configured while a texture of its swapchain
// is still held, and every acquire that is never released holds one: that is
// what made a resize answer `Invalid surface` and take the program with it.
renderer_begin :: fn(mut r: Renderer) -> Frame {
    mut f := Frame {
        texture = surface_texture_init(),
        view = no_texture_view(),
        encoder = no_command_encoder(),
        ready = false,
    }
    surface_get_current_texture(r.surface, ptr_to(f.texture))
    if (acquired(f) == false) {
        release_acquired(f)
        surface_configure(r.surface, ptr_to(r.configuration))
        surface_get_current_texture(r.surface, ptr_to(f.texture))
        if (acquired(f) == false) {
            release_acquired(f)
            return f
        }
    }
    f.view = texture_create_view(f.texture.texture, no_pointer())
    f.encoder = device_create_command_encoder(r.device, no_pointer())
    f.ready = true
    f
}

frame_ok :: fn(f: Frame) -> bool { f.ready }
// The frame's own command encoder, which is what a pass recording something
// other than a render pass opens its own encoder over.
frame_encoder :: fn(f: Frame) -> CommandEncoder { f.encoder }
frame_view :: fn(f: Frame) -> TextureView { f.view }

// Where a pass draws. A colour attachment, a depth attachment, or both: a
// shadow map is depth with no colour, a post-process step is colour with no
// depth, and an ordinary scene pass is both.
Target :: struct {
    color: TextureView,
    depth: TextureView,
    has_color: bool,
    has_depth: bool,
}

// A target naming views a caller made, for a pass drawing somewhere other than
// the window. `no_view()` fills the slot a pass does not use, which is the
// colour slot for a depth-only pass and the depth slot for one that needs none.
target_of :: fn(color: TextureView, depth: TextureView, has_color: bool,
    has_depth: bool) -> Target {
    Target { color = color, depth = depth, has_color = has_color,
        has_depth = has_depth }
}

no_view :: fn() -> TextureView { no_texture_view() }

// A pass into whatever it was given. The attachments a pass has are the ones
// its target says it has, so a depth-only pass writes no colour and a
// post-process step is not asked for a depth buffer it does not have.
//
// `load` says whether what is already in an attachment survives, which is what
// lets a second pass draw over a first instead of erasing it. Depth follows the
// same rule and it is the more important one: every pass after the first has to
// load the depth the passes before it wrote, or each sorts only against itself
// and the last to draw wins wherever they overlap. The graph decides both, from
// what each pass declared it writes.
frame_pass_into :: fn(mut f: Frame, into: Target, load: u32, clear: Color,
    depth_load: u32) -> RenderPassEncoder {
    mut attachment := render_pass_color_attachment_init()
    attachment.view = into.color
    attachment.load_op = load
    attachment.store_op = STORE_OP_STORE
    attachment.clear_value = clear

    // Nearer is smaller, so the buffer starts at the far plane and every
    // fragment that passes is closer than what was already there.
    mut depth := render_pass_depth_stencil_attachment_init()
    depth.view = into.depth
    depth.depth_load_op = depth_load
    depth.depth_store_op = STORE_OP_STORE
    depth.depth_clear_value = 1.0

    mut descriptor := render_pass_descriptor_init()
    descriptor.color_attachments_count = 0
    if (into.has_color) {
        descriptor.color_attachments_count = 1
        descriptor.color_attachments =
            ptr_to(attachment)
    }
    if (into.has_depth) {
        descriptor.depth_stencil_attachment = ptr_to(depth)
    }
    command_encoder_begin_render_pass(f.encoder, ptr_to(descriptor))
}

// Closes the encoder, submits it, shows the result, and gives back everything
// the frame took.
//
// The order is the one the counting requires: the command buffer after the
// submit that reads it, the encoder after the buffer it produced, the view
// after the submit that draws through it, and the surface texture after the
// present that shows it.
renderer_end :: fn(mut r: Renderer, move f: Frame) {
    if (f.ready == false) {
        return
    }
    mut command := command_encoder_finish(f.encoder, no_pointer())
    queue_submit(r.queue, 1, ptr_to(command))
    surface_present(r.surface)
    command_buffer_release(command)
    command_encoder_release(f.encoder)
    f.encoder = no_command_encoder()
    texture_view_release(f.view)
    f.view = no_texture_view()
    release_acquired(f)
    f.ready = false
}

// A renderer that never opened, closed. Opening is a run of acquisitions and
// any of them can fail, so a renderer that got partway holds real handles for
// the steps that worked and `no_x()` for the rest, and closing it walks all of
// them either way.
//
// This runs on a machine with no GPU, because nothing here asks for one: the
// handles it gives back are the ones that name nothing, which is exactly what
// the failed half of an open leaves behind.
test "a renderer that never opened is closed without touching a handle" {
    mut r := Renderer {
        instance = no_instance(), surface = no_surface(),
        adapter = no_adapter(), device = no_device(), queue = no_queue(),
        format = 0, configuration = surface_configuration_init(),
        opened = false,
    }
    assert(renderer_ok(r) == false)
    // Every release in here is handed a handle that names nothing. Reaching the
    // line below is the whole assertion: wgpu is not asked to give back
    // something it never handed out.
    renderer_close(r)
    assert(renderer_ok(r) == false)
}
