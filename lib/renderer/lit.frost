// The pass that draws a run of things, lit. The one a program gets by composing
// the renderer rather than by writing a shader.
//
// Every demo before this wrote its own WGSL, its own pipeline and its own pass
// body, which is the right thing when the demo is about what a pass can be. It
// is the wrong thing when the program just wants its world on the screen, and
// that is what this is for: declare it into a graph, hand it the run and the
// lights, and there is nothing else to write.
//
// What it draws with is what `render_world.frost` filled: tables of transforms,
// materials and objects, and a set of draws the compute passes built. Nothing
// here counts anything and nothing here decides what is drawn.
//
// The frame is two passes. The first writes depth and nothing else, for the
// things that certainly cover what is behind them; the second shades, comparing
// depth for equality rather than for nearness, so a fragment that something else
// ends up in front of is shaded once instead of once per thing that covers it.
// What may go in the first is what the batch tables call the solid lane: a
// surface that drops fragments of its own has no fragment stage there to drop
// them in, so it would write depth over its own holes.
//
// Three pipelines for the second pass, because a batch is a run of instances
// sharing a pipeline and the classes exist to keep them apart:
//
//   opaque        back faces dropped, depth written
//   double sided  neither face dropped, depth written
//   transparent   blended over what is behind it, depth tested and not written
//
// Which one draws a thing is its material's business, decided in the classify
// pass, and this reads the answer as the order it issues the classes in: what
// is opaque before what is blended, and the overlay classes after the world.
//
// The overlay classes share the world's depth buffer, so an overlay behind
// something is still hidden by it. Nightshade gives them a depth target of
// their own, which is what makes an overlay sit on top whatever depth it is at;
// that target is not here yet, so what the layer buys today is draw order and
// nothing more.
//
// Lights arrive as a run of records rather than as a component, because this is
// the renderer and a component belongs to the world. `lib/engine/light.frost` is
// what turns one into the other.

import "wgpu.frost"
import "frame.frost"
import "graph.frost"
import "geometry.frost"
import "render_world.frost"
import "cluster.frost"
import "uniform.frost"
import "mem.frost"
import "math.frost"

export Lit, lit_none, LIT_FRAME_BYTES,
    lit_new, lit_free, lit_declare, lit_write_frame,
    lit_record, lit_write_lights

// The two camera matrices, where the camera is, the ambient term, and how many
// lights are in the run.
//
// The view matrix is here as well as the product because a fragment has to know
// how far away it is to find its own box in the light grid, and that is a view
// space distance. Deriving it from the product would mean inverting a matrix per
// fragment.
LIT_FRAME_BYTES :: 176

SHADER :: include_str("shaders/lit.wgsl")

// What the pass records with. A plain struct rather than a linear one, because
// the App holds one before anything has composed the plugin that fills it: a
// program writing its own passes never makes the buffers at all, and one that
// does composes over what `lit_none` left.
Lit :: struct {
    cluster: Cluster,
    steps: BatchPipelines,
    // Depth and nothing else, for the solid half of the two opaque classes.
    depth_pipeline: RenderPipeline,
    // One per way of drawing, indexed by the class of the batch being drawn.
    // The overlay classes reuse the three, because what differs between a thing
    // in the world and the same thing on top of it is when it is drawn and not
    // how.
    opaque_pipeline: RenderPipeline,
    double_sided_pipeline: RenderPipeline,
    transparent_pipeline: RenderPipeline,
    frame_uniform: Buffer,
    frame_group: BindGroup,
    light_group: BindGroup,
}

lit_new :: fn(
    device: Device,
    format: u32,
    scene_layout: BindGroupLayout,
    batch_layout: BindGroupLayout
) -> Lit {
    frame_layout := uniform_layout(
        device,
        LIT_FRAME_BYTES,
        ShaderStage::Vertex | ShaderStage::Fragment
    )
    frame_uniform := uniform_buffer(device, LIT_FRAME_BYTES)

    light_layout := lights_layout(device)

    var layouts: [3]BindGroupLayout = [frame_layout, scene_layout, light_layout]
    var descriptor := pipeline_layout_descriptor_init()
    descriptor.bind_group_layouts_count = 3
    descriptor.bind_group_layouts = ptr_to(layouts[0])
    layout := device_create_pipeline_layout(device, ptr_to(descriptor))

    shader := lit_module(device)
    // Made here rather than handed in. What this pass records is the grid, the
    // steps and the draws, in that order, and a caller that had to build two of
    // the three would be holding pieces of a pass it does not otherwise touch.
    grid := cluster_new(device)
    steps := render_world_batch_pipelines(device, batch_layout)
    // The group naming the grid's buffers, built before the grid is handed to
    // the struct that owns it.
    lights := lights_group(device, light_layout, grid)
    Lit {
        // What this pass records with, owned by it: the grid over the lights
        // and the steps that decide what is drawn are what it is made of.
        cluster = grid,
        steps = steps,
        depth_pipeline = make_depth_pipeline(device, shader, layout),
        // The two that the prepass wrote depth for compare for equality, since
        // what they are drawing is exactly what it recorded. The blended one
        // compares for nearness and writes nothing, because the prepass never
        // saw it.
        opaque_pipeline = make_pipeline(device, shader, format, layout,
            CULL_MODE_BACK, false, COMPARE_FUNCTION_GREATER_EQUAL),
        double_sided_pipeline = make_pipeline(device, shader, format, layout,
            CULL_MODE_NONE, false, COMPARE_FUNCTION_GREATER_EQUAL),
        transparent_pipeline = make_pipeline(device, shader, format, layout,
            CULL_MODE_NONE, true, COMPARE_FUNCTION_GREATER),
        frame_uniform = frame_uniform,
        frame_group = uniform_group(device, frame_layout, frame_uniform,
            LIT_FRAME_BYTES),
        light_group = lights,
    }
}

// A pass that was never made, which is what the App holds until something
// composes the plugin. Nothing in it is bound and `lit_free` on one gives back
// nothing, since a handle of nothing is what every one of these is.
lit_none :: fn() -> Lit {
    Lit {
        cluster = cluster_none(),
        steps = no_batch_pipelines(),
        depth_pipeline = no_render_pipeline(),
        opaque_pipeline = no_render_pipeline(),
        double_sided_pipeline = no_render_pipeline(),
        transparent_pipeline = no_render_pipeline(),
        frame_uniform = no_buffer(),
        frame_group = no_bind_group(),
        light_group = no_bind_group(),
    }
}

lit_free :: fn(mut held: Lit) {
    if (held.depth_pipeline == no_render_pipeline()) {
        return
    }
    buffer_destroy(held.frame_uniform)
    buffer_release(held.frame_uniform)
    bind_group_release(held.light_group)
    bind_group_release(held.frame_group)
    cluster_free(held.cluster)
    batch_pipelines_free(held.steps)
    render_pipeline_release(held.depth_pipeline)
    render_pipeline_release(held.opaque_pipeline)
    render_pipeline_release(held.double_sided_pipeline)
    render_pipeline_release(held.transparent_pipeline)
}

// The pass, into a graph. One node: what it writes is the colour and depth it
// was given, and what it reads is nothing the graph has to know about, because
// everything it needs it builds itself.
//
// That is the shape nightshade has. Clustering the lights, laying the batches
// out, writing the depth and drawing the classes are one thing that happens in
// an order of its own; declaring them as separate graph passes would put that
// order in every program that draws a view, and a program with two views would
// assemble it twice.
lit_declare :: fn(
    $Ctx: Type,
    mut g: Graph,
    record: fn(mut Ctx, NodeContext),
    state: ^Ctx,
    screen: ResourceId,
    depth: ResourceId,
    clear: Color
) -> PassId {
    made := graph_node_pass(g, "lit", record, state)
    graph_writes_color(g, made, screen, clear)
    graph_writes_depth(g, made, depth)
    made
}

// Everything a frame does to draw a view, in the order it has to happen:
//
//   the light grid, so shading knows which lights reach where
//   the batch tables, so the draws exist at all
//   depth, for what certainly covers what is behind it
//   the classes, shaded against the depth already written
//
// Each is its own pass on the encoder, which is what lets one wait on the last.
lit_record :: fn(
    mut s: Lit,
    mut held: RenderWorld,
    store: Geometry,
    context: NodeContext
) {
    cluster_record(s.cluster, context.encoder)
    batching_record(s.steps, held, context.encoder)
    record_depth(s, held, store, context)
    record_classes(s, held, store, context)
}

// Depth and nothing else, for the two opaque classes and only their solid
// halves. What blends does not cover what is behind it, and what drops its own
// fragments has no stage here to drop them in.
record_depth :: fn(
    mut s: Lit,
    mut held: RenderWorld,
    store: Geometry,
    context: NodeContext
) {
    pass := encoder_pass_into(
        context.encoder,
        depth_only(context.into),
        LOAD_OP_LOAD,
        context.clear,
        context.depth_load
    )
    render_pass_encoder_set_pipeline(pass, s.depth_pipeline)
    bind_scene(s, held, pass)
    geometry_bind(pass, store)
    render_world_draw_prepass(pass, held, CLASS_OPAQUE)
    render_world_draw_prepass(pass, held, CLASS_DOUBLE_SIDED)
    render_pass_encoder_end(pass)
    render_pass_encoder_release(pass)
}

// The classes, in the order they have to be drawn: what is opaque first so what
// is blended has something behind it, and the overlay after the world.
//
// Depth loads rather than clears, since the prepass just wrote it.
record_classes :: fn(
    mut s: Lit,
    mut held: RenderWorld,
    store: Geometry,
    context: NodeContext
) {
    pass := encoder_pass_into(
        context.encoder,
        context.into,
        context.color_load,
        context.clear,
        LOAD_OP_LOAD
    )
    bind_scene(s, held, pass)
    geometry_bind(pass, store)
    draw_class(held, pass, CLASS_OPAQUE, s.opaque_pipeline)
    draw_class(held, pass, CLASS_DOUBLE_SIDED, s.double_sided_pipeline)
    draw_class(held, pass, CLASS_TRANSPARENT, s.transparent_pipeline)
    draw_class(held, pass, CLASS_OVERLAY_OPAQUE, s.opaque_pipeline)
    draw_class(held, pass, CLASS_OVERLAY_DOUBLE_SIDED, s.double_sided_pipeline)
    draw_class(held, pass, CLASS_OVERLAY_TRANSPARENT, s.transparent_pipeline)
    render_pass_encoder_end(pass)
    render_pass_encoder_release(pass)
}

// The three groups every pipeline here reads: the frame, the run, and the
// lights with the grid over them.
bind_scene :: fn(mut s: Lit, held: RenderWorld, pass: RenderPassEncoder) {
    render_pass_encoder_set_bind_group(pass, 0, s.frame_group, 0, no_pointer())
    render_pass_encoder_set_bind_group(
        pass,
        1,
        render_world_group(held),
        0,
        no_pointer()
    )
    render_pass_encoder_set_bind_group(pass, 2, s.light_group, 0, no_pointer())
}

draw_class :: fn(
    held: RenderWorld,
    pass: RenderPassEncoder,
    class: i64,
    pipeline: RenderPipeline
) {
    render_pass_encoder_set_pipeline(pass, pipeline)
    render_world_draw_class(pass, held, class)
}

// The lights of the frame and the numbers the grid is built from. The pass owns
// the grid, so a program hands it the world's lights and the camera and says
// nothing about froxels.
lit_write_lights :: fn(
    mut s: Lit,
    queue: Queue,
    held: []GpuLight,
    total: i64,
    directional: i64,
    projection: Mat4,
    view: Mat4,
    width: i64,
    height: i64,
    z_near: f32,
    z_far: f32
) {
    cluster_write(
        s.cluster,
        queue,
        held,
        total,
        directional,
        projection,
        view,
        width,
        height,
        z_near,
        z_far
    )
}

// The camera and the ambient term, as the bytes the shader reads them as.
lit_write_frame :: fn(
    mut s: Lit,
    queue: Queue,
    view_projection: Mat4,
    view: Mat4,
    eye: Vec3,
    ambient: Vec3,
    total: i64,
    directional: i64
) {
    var values: [44]f32 = [0.0; 44]
    var element: i64 = 0
    while (element < 16) {
        values[element] = view_projection.m[element]
        values[element + 16] = view.m[element]
        element = element + 1
    }
    values[32] = eye.x
    values[33] = eye.y
    values[34] = eye.z
    values[35] = 1.0
    values[36] = ambient.x
    values[37] = ambient.y
    values[38] = ambient.z
    values[39] = 1.0
    // How many lights there are and how many of those come first because they
    // are directional. Four unsigned numbers to the shader and four floats
    // here, written through the same bytes since what the buffer holds is
    // bytes.
    var counts: [4]u32 = [cast($u32, total), cast($u32, directional), 0, 0]
    queue_write_buffer(queue, s.frame_uniform, 0, ptr_to(values[0]), 160)
    queue_write_buffer(queue, s.frame_uniform, 160, ptr_to(counts[0]), 16)
}

// What the fragment stage reads about lights: the run of them, the grid saying
// which reach where, the indices the grid points into, and the numbers the grid
// was built with. The three runs are storage bindings because how many there
// are is a number rather than a shape.
lights_layout :: fn(device: Device) -> BindGroupLayout {
    var entries: [4]BindGroupLayoutEntry = [bind_group_layout_entry_init(); 4]
    var slot: i64 = 0
    while (slot < 4) {
        entries[slot].binding = cast($u32, slot)
        entries[slot].visibility = ShaderStage::Fragment
        entries[slot].buffer.type = BUFFER_BINDING_TYPE_READ_ONLY_STORAGE
        slot = slot + 1
    }
    entries[3].buffer.type = BUFFER_BINDING_TYPE_UNIFORM
    entries[3].buffer.min_binding_size = CLUSTER_UNIFORM_BYTES
    var descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 4
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

lights_group :: fn(
    device: Device,
    layout: BindGroupLayout,
    grid: Cluster
) -> BindGroup {
    var entries: [4]BindGroupEntry = [bind_group_entry_init(); 4]
    var held: [4]Buffer = [
        cluster_lights_buffer(grid),
        cluster_grid_buffer(grid),
        cluster_indices_buffer(grid),
        cluster_uniform_buffer(grid)
    ]
    var sizes: [4]i64 = [
        LIGHT_BYTES * MAX_LIGHTS,
        TOTAL_CLUSTERS * 8,
        TOTAL_CLUSTERS * MAX_LIGHTS_PER_CLUSTER * 4,
        CLUSTER_UNIFORM_BYTES
    ]
    var slot: i64 = 0
    while (slot < 4) {
        entries[slot].binding = cast($u32, slot)
        entries[slot].buffer = held[slot]
        entries[slot].size = sizes[slot]
        slot = slot + 1
    }
    var descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 4
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group(device, ptr_to(descriptor))
}

lit_module :: fn(device: Device) -> ShaderModule {
    var wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    var module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    device_create_shader_module(device, ptr_to(module_descriptor))
}

// Position and normal, which is what the mesh carries and what this reads. What
// it does not read is where the surface samples an image, because this pass
// takes its colour from the material rather than from a texture.
//
// The three pipelines differ in two things and share the rest. Which faces are
// dropped is one; whether the fragment is blended over what is behind it and
// whether it writes depth is the other, and those two go together: a blended
// thing that wrote depth would hide whatever is behind it from every blended
// thing drawn after.
make_pipeline :: fn(
    device: Device,
    shader: ShaderModule,
    format: u32,
    layout: PipelineLayout,
    cull_mode: u32,
    blended: bool,
    compare: u32
) -> RenderPipeline {
    var attributes: [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    var buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])

    // Source alpha over what is there, which is what a colour with an alpha
    // means. The alpha channel takes the newer of the two so a target that is
    // read afterwards says something sensible about coverage.
    var blend := blend_state_init()
    blend.color.operation = BLEND_OPERATION_ADD
    blend.color.src_factor = BLEND_FACTOR_SRC_ALPHA
    blend.color.dst_factor = BLEND_FACTOR_ONE_MINUS_SRC_ALPHA
    blend.alpha.operation = BLEND_OPERATION_ADD
    blend.alpha.src_factor = BLEND_FACTOR_ONE
    blend.alpha.dst_factor = BLEND_FACTOR_ONE_MINUS_SRC_ALPHA

    var target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All
    if (blended) {
        target.blend = ptr_to(blend)
    }

    var fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    var depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    if (blended) {
        depth.depth_write_enabled = OPTIONAL_BOOL_FALSE
    }
    depth.depth_compare = compare

    var descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = cull_mode
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

// Depth and nothing else. No fragment stage at all: a pass with no colour
// target has nothing for one to write, and the vertex stage settling where the
// surface is is the whole of what this produces.
//
// Reverse-Z, so the nearer fragment is the greater one and this keeps it.
make_depth_pipeline :: fn(
    device: Device,
    shader: ShaderModule,
    layout: PipelineLayout
) -> RenderPipeline {
    var attributes: [1]VertexAttribute = [vertex_attribute_init(); 1]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0

    var buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 1
    buffer_layout.attributes = ptr_to(attributes[0])

    var depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_GREATER

    var descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_depth", length = 8 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    device_create_render_pipeline(device, ptr_to(descriptor))
}
