// The shapes a program builds, the data they are made of, and where each of
// them sits on the device.
//
//   mut cache := mesh_cache_new(8)
//   cube := mesh_cache_insert(cache, store, device, queue, "cube", cube_mesh())
//   ...
//   mesh_cache_remove(cache, store, device, queue, "cube")
//
// A mesh is where it sits in the shared buffers, which is `geometry.frost`.
// Indexed, because a cube drawn as bare triangles is thirty-six vertices with
// eight distinct positions among them, and the normal is what makes the
// duplication real: a corner belongs to three faces pointing three ways, so
// twenty-four vertices is the honest count and the indices are what stop it
// being thirty-six.
//
// The cache keeps the vertices and indices as well as the span. That is the
// difference between a program that can load a level and one that can load two:
// the buffers are one run of memory that meshes are appended to, so taking one
// out leaves a hole, and the only way to close the holes is to put everything
// that is left back in from the start. Something has to still have the meshes
// for that, and this is what has them.
//
// A slot is a name, a generation and whether anything is in it. Removing one
// frees its data, empties its span and puts the slot on a list to be used again;
// the generation goes up so a number kept from before does not name whatever
// landed there next. What is drawn carries the slot number, and an empty slot
// has no indices, so a thing still pointing at a removed mesh draws nothing
// rather than drawing whatever replaced it.

import "wgpu.frost"
import "geometry.frost"
import "gpu.frost"
import "math.frost"
import "mem.frost"
import "strings.frost"
import "io.frost"

export Mesh, MeshCache, MeshSlot,
    mesh_cache_new, mesh_cache_insert, mesh_cache_find, mesh_cache_at,
    mesh_cache_free, mesh_cache_count, mesh_cache_remove, mesh_cache_clear,
    mesh_cache_add, worth_rebuilding_counts,
    mesh_cache_live, mesh_cache_generation, mesh_slot, mesh_slot_alive,
    mesh_new, mesh_free,
    cube_mesh, sphere_mesh

// What a mesh is made of, on this side of the device. Held rather than uploaded
// and dropped, because a rebuild has to be able to put it back.
Mesh :: struct { vertices: []Vertex, indices: []u32 }

// A slot and the generation it was in when it was handed out. What a program
// keeps to name a mesh: the slot alone would still name a slot after the mesh in
// it was removed and another put in its place.
MeshSlot :: struct { index: i64, generation: u32 }

MeshCache :: struct {
    names: []str,
    meshes: []Mesh,
    spans: []MeshSpan,
    generations: []u32,
    live: []bool,
    // Slots that held something and do not now, newest first. A name arriving
    // takes one of these before it takes a slot past the end.
    free: []i64,
    free_count: i64,
    // How far the slots have ever been used, which is what a walk over them
    // ends at. A hole inside it is a slot on the list above.
    count: i64,
}

mesh_cache_new :: fn(capacity: i64) -> MeshCache {
    MeshCache {
        names = heap_slice($str, capacity),
        meshes = heap_slice($Mesh, capacity),
        spans = heap_slice($MeshSpan, capacity),
        generations = heap_slice($u32, capacity),
        live = heap_slice($bool, capacity),
        free = heap_slice($i64, capacity),
        free_count = 0,
        count = 0,
    }
}

mesh_cache_free :: fn(mut cache: MeshCache) {
    var index : i64 = 0
    while (index < cache.count) {
        if (cache.live[index]) {
            mesh_free(cache.meshes[index])
        }
        index = index + 1
    }
    heap_release_slice($str, cache.names)
    heap_release_slice($Mesh, cache.meshes)
    heap_release_slice($MeshSpan, cache.spans)
    heap_release_slice($u32, cache.generations)
    heap_release_slice($bool, cache.live)
    heap_release_slice($i64, cache.free)
    cache.count = 0
    cache.free_count = 0
}

// Room for a mesh of this shape, for something filling one in.
mesh_new :: fn(vertex_count: i64, index_count: i64) -> Mesh {
    Mesh { vertices = heap_slice($Vertex, vertex_count),
        indices = heap_slice($u32, index_count) }
}

mesh_free :: fn(mut held: Mesh) {
    heap_release_slice($Vertex, held.vertices)
    heap_release_slice($u32, held.indices)
}

// A mesh under a name, uploaded, answering with the slot it went in.
//
// A name that is already there is replaced in place and keeps its slot and its
// generation, so everything drawn as it is drawn as the new one. What it had is
// freed and what it sat on in the buffers is left behind, which the rebuild
// below is what reclaims.
mesh_cache_insert :: fn(mut cache: MeshCache, mut store: Geometry,
    device: Device, queue: Queue, name: str, move held: Mesh) -> i64 {
    span := geometry_add(store, device, queue, held.vertices, held.indices)
    existing := mesh_cache_find(cache, name)
    if (existing >= 0) {
        var gone := cache.meshes[existing]
        mesh_free(gone)
        cache.meshes[existing] = held
        cache.spans[existing] = span
        return existing
    }
    at := take_slot(cache)
    if (at < 0) {
        print_str_line("mesh: more meshes at once than the cache was made room for")
        var unused := held
        mesh_free(unused)
        return -1
    }
    cache.names[at] = name
    cache.meshes[at] = held
    cache.spans[at] = span
    cache.live[at] = true
    at
}

// A mesh with no name, answering with the slot it went in. What a file loads is
// this: a model's primitives are found by the number the load handed back and
// never by name, and naming them would mean inventing names that collide the
// moment the same file is loaded twice.
//
// It is held and freed exactly like a named one, so a rebuild puts it back.
mesh_cache_add :: fn(mut cache: MeshCache, mut store: Geometry, device: Device,
    queue: Queue, move held: Mesh) -> i64 {
    span := geometry_add(store, device, queue, held.vertices, held.indices)
    at := take_slot(cache)
    if (at < 0) {
        print_str_line("mesh: more meshes at once than the cache was made room for")
        var unused := held
        mesh_free(unused)
        return -1
    }
    cache.names[at] = ""
    cache.meshes[at] = held
    cache.spans[at] = span
    cache.live[at] = true
    at
}

// A slot to put something in: one that was given back if there is one, and the
// next one past the end otherwise.
take_slot :: fn(mut cache: MeshCache) -> i64 {
    if (cache.free_count > 0) {
        cache.free_count = cache.free_count - 1
        return cache.free[cache.free_count]
    }
    if (cache.count >= slice_len(cache.spans)) {
        return -1
    }
    at := cache.count
    cache.generations[at] = 0
    cache.count = at + 1
    at
}

// One mesh out again. Its data is freed, its span is emptied so anything still
// drawn as it draws nothing, its generation goes up, and the slot goes on the
// list.
//
// What it held in the buffers is not given back here. Reclaiming it means
// putting everything else back from the start, which is what `mesh_cache_clear`
// does and what this asks for when enough has gone to be worth it.
mesh_cache_remove :: fn(mut cache: MeshCache, mut store: Geometry,
    device: Device, queue: Queue, name: str) -> bool {
    at := mesh_cache_find(cache, name)
    if (at < 0) {
        return false
    }
    var gone := cache.meshes[at]
    mesh_free(gone)
    cache.live[at] = false
    cache.spans[at] = MeshSpan { first_index = 0, index_count = 0,
        base_vertex = 0, radius = 0.0 }
    cache.generations[at] = cache.generations[at] + 1
    cache.free[cache.free_count] = at
    cache.free_count = cache.free_count + 1
    if (worth_rebuilding(cache, store)) {
        rebuild(cache, store, device, queue)
    }
    true
}

// Whether what has been left behind is worth the work of reclaiming.
//
// The counting is separate from the deciding so the decision can be checked
// without a device: what it turns on is four numbers, and a rebuild that fires
// on the wrong ones either thrashes or never reclaims anything.
worth_rebuilding :: fn(cache: MeshCache, store: Geometry) -> bool {
    var live_vertices : i64 = 0
    var live_indices : i64 = 0
    var index : i64 = 0
    while (index < cache.count) {
        if (cache.live[index]) {
            live_vertices = live_vertices + slice_len(cache.meshes[index].vertices)
            live_indices = live_indices + slice_len(cache.meshes[index].indices)
        }
        index = index + 1
    }
    worth_rebuilding_counts(live_vertices, live_indices,
        geometry_vertex_room(store), geometry_index_room(store))
}

// The buffers have to be mostly empty and there has to be a real amount to get
// back. Either test alone is wrong: a buffer one tenth used is not worth
// touching if it is small, and one with a lot of slack is not worth touching if
// most of it is live.
worth_rebuilding_counts :: fn(live_vertices: i64, live_indices: i64,
    vertex_room: i64, index_room: i64) -> bool {
    if (live_vertices == 0 || live_indices == 0) {
        return false
    }
    used_bytes := live_vertices * VERTEX_STRIDE + live_indices * INDEX_BYTES
    room_bytes := vertex_room * VERTEX_STRIDE + index_room * INDEX_BYTES
    if (room_bytes - used_bytes < MIN_RECLAIM_BYTES) {
        return false
    }
    used : f32 = used_bytes
    room : f32 = room_bytes
    used / room < SHRINK_THRESHOLD
}

// Everything still here, put back from the start. Every live mesh gets a new
// span wherever it now falls, which is why the cache had to keep the meshes:
// there is nowhere else the vertices could come from.
rebuild :: fn(mut cache: MeshCache, mut store: Geometry, device: Device,
    queue: Queue) {
    geometry_reset(store)
    var index : i64 = 0
    while (index < cache.count) {
        if (cache.live[index]) {
            cache.spans[index] = geometry_add(store, device, queue,
                cache.meshes[index].vertices, cache.meshes[index].indices)
        }
        index = index + 1
    }
    geometry_shrink(store, device, queue)
}

// Everything out at once, which is what changing level is. The buffers keep
// their size, since what follows is a scene that will want them.
mesh_cache_clear :: fn(mut cache: MeshCache, mut store: Geometry) {
    var index : i64 = 0
    while (index < cache.count) {
        if (cache.live[index]) {
            var gone := cache.meshes[index]
            mesh_free(gone)
            cache.live[index] = false
            cache.generations[index] = cache.generations[index] + 1
        }
        index = index + 1
    }
    geometry_reset(store)
    cache.count = 0
    cache.free_count = 0
}

// Which slot a name is in, or -1. A caller resolves once and keeps the number,
// so nothing compares strings while drawing.
mesh_cache_find :: fn(cache: MeshCache, name: str) -> i64 {
    var index : i64 = 0
    while (index < cache.count) {
        if (cache.live[index] && str_is_empty(cache.names[index]) == false
            && str_eq(cache.names[index], name)) {
            return index
        }
        index = index + 1
    }
    -1
}

mesh_cache_at :: fn(cache: MeshCache, index: i64) -> MeshSpan {
    cache.spans[index]
}

// How far the slots go, which is how much of the mesh table goes to the device.
// A slot nothing is in has no indices, and a draw of no indices draws nothing.
mesh_cache_count :: fn(cache: MeshCache) -> i64 { cache.count }

mesh_cache_live :: fn(cache: MeshCache, index: i64) -> bool {
    index >= 0 && index < cache.count && cache.live[index]
}

mesh_cache_generation :: fn(cache: MeshCache, index: i64) -> u32 {
    cache.generations[index]
}

// The slot as something that stays right. A program keeping one of these can
// ask whether what it names is still there; a program keeping the number alone
// cannot tell a removed mesh from whatever took its place.
mesh_slot :: fn(cache: MeshCache, index: i64) -> MeshSlot {
    MeshSlot { index = index, generation = cache.generations[index] }
}

mesh_slot_alive :: fn(cache: MeshCache, held: MeshSlot) -> bool {
    mesh_cache_live(cache, held.index)
        && cache.generations[held.index] == held.generation
}

// Two triangles over four corners, wound counter-clockwise seen from outside,
// which is the winding the pipeline calls front. The four corners take the four
// corners of the image in the same order, so every face reads the whole of it
// and every face reads it the same way up.
quad :: fn(mut vertices: []Vertex, mut indices: []u32, at: i64,
    normal: Vec3, a: Vec3, b: Vec3, c: Vec3, d: Vec3) {
    base := at * 4
    vertices[base] = Vertex { position = a, normal = normal,
        texcoord = vec2(0.0, 1.0) }
    vertices[base + 1] = Vertex { position = b, normal = normal,
        texcoord = vec2(1.0, 1.0) }
    vertices[base + 2] = Vertex { position = c, normal = normal,
        texcoord = vec2(1.0, 0.0) }
    vertices[base + 3] = Vertex { position = d, normal = normal,
        texcoord = vec2(0.0, 0.0) }
    corner := at * 6
    indices[corner] = cast($u32, base)
    indices[corner + 1] = cast($u32, base + 1)
    indices[corner + 2] = cast($u32, base + 2)
    indices[corner + 3] = cast($u32, base)
    indices[corner + 4] = cast($u32, base + 2)
    indices[corner + 5] = cast($u32, base + 3)
}

// A unit cube about the origin. Four vertices per face rather than eight in
// total, because a corner has three normals and a vertex has one.
//
// What comes back is the mesh rather than a place in a buffer: what makes it is
// arithmetic and needs no device, and what puts it somewhere is the cache.
cube_mesh :: fn() -> Mesh {
    var held := mesh_new(24, 36)
    var vertices := held.vertices
    var indices := held.indices
    half : f32 = 0.5
    low := -half

    quad(vertices, indices, 0, vec3(1.0, 0.0, 0.0),
        vec3(half, low, half), vec3(half, low, low),
        vec3(half, half, low), vec3(half, half, half))
    quad(vertices, indices, 1, vec3(-1.0, 0.0, 0.0),
        vec3(low, low, low), vec3(low, low, half),
        vec3(low, half, half), vec3(low, half, low))
    quad(vertices, indices, 2, vec3(0.0, 1.0, 0.0),
        vec3(low, half, half), vec3(half, half, half),
        vec3(half, half, low), vec3(low, half, low))
    quad(vertices, indices, 3, vec3(0.0, -1.0, 0.0),
        vec3(low, low, low), vec3(half, low, low),
        vec3(half, low, half), vec3(low, low, half))
    quad(vertices, indices, 4, vec3(0.0, 0.0, 1.0),
        vec3(low, low, half), vec3(half, low, half),
        vec3(half, half, half), vec3(low, half, half))
    quad(vertices, indices, 5, vec3(0.0, 0.0, -1.0),
        vec3(half, low, low), vec3(low, low, low),
        vec3(low, half, low), vec3(half, half, low))
    held
}

// A sphere of latitude rings and longitude segments. The normal is the position
// made unit, which is exactly true for a sphere about the origin and is why
// this one carries no normal computation of its own.
//
// Both ends of a ring are separate vertices at the same place, which looks
// wasteful and is not: the seam is where the texture coordinate would wrap, and
// a shared vertex there cannot hold two of them.
sphere_mesh :: fn(radius: f32, rings: i64, segments: i64) -> Mesh {
    vertex_count := (rings + 1) * (segments + 1)
    index_count := rings * segments * 6
    var held := mesh_new(vertex_count, index_count)
    var vertices := held.vertices
    var indices := held.indices

    var ring : i64 = 0
    while (ring <= rings) {
        tall : f32 = ring
        total : f32 = rings
        theta : f32 = 3.141592653589793 * (tall / total)
        var segment : i64 = 0
        while (segment <= segments) {
            around : f32 = segment
            span : f32 = segments
            phi : f32 = 6.283185307179586 * (around / span)
            unit := vec3(cosf(phi) * sinf(theta), cosf(theta),
                sinf(phi) * sinf(theta))
            // Longitude across and latitude down, which is the mapping that
            // makes the seam land where the duplicated column already is.
            vertices[ring * (segments + 1) + segment] =
                Vertex { position = vec3_scale(unit, radius), normal = unit,
                    texcoord = vec2(around / span, tall / total) }
            segment = segment + 1
        }
        ring = ring + 1
    }

    var written : i64 = 0
    var row : i64 = 0
    while (row < rings) {
        var column : i64 = 0
        while (column < segments) {
            first := cast($u32, row * (segments + 1) + column)
            next := first + cast($u32, segments + 1)
            indices[written] = first
            indices[written + 1] = next
            indices[written + 2] = first + 1
            indices[written + 3] = first + 1
            indices[written + 4] = next
            indices[written + 5] = next + 1
            written = written + 6
            column = column + 1
        }
        row = row + 1
    }
    held
}

// Sixteen megabytes of vertices, as a count, which is the amount the rebuild
// threshold is written in.
BIG_VERTICES :: 524288

test "a rebuild waits for the buffers to be mostly empty" {
    // A fortieth used, with thirty megabytes to get back: worth it.
    assert(worth_rebuilding_counts(BIG_VERTICES / 20, 16, BIG_VERTICES * 2, 64))
    // Thirty megabytes to get back again, but two thirds of the buffer is
    // live, so a rebuild would copy nearly everything to reclaim the rest.
    // Only the utilisation differs between this and the one above.
    assert(worth_rebuilding_counts(BIG_VERTICES * 4, 16, BIG_VERTICES * 6, 64)
        == false)
}

test "a rebuild waits for there to be something worth reclaiming" {
    // Almost entirely empty, but the whole buffer is smaller than the floor,
    // so the copy would cost more than the memory it hands back.
    assert(worth_rebuilding_counts(1, 1, 1024, 1024) == false)
}

test "a cache holding nothing is not worth rebuilding" {
    // No live mesh means nothing to put back, and a rebuild would leave the
    // buffers exactly as empty as they already are.
    assert(worth_rebuilding_counts(0, 0, BIG_VERTICES, BIG_VERTICES) == false)
    assert(worth_rebuilding_counts(BIG_VERTICES / 20, 0, BIG_VERTICES, 64)
        == false)
}

// A mesh of a given size holding nothing in particular. What the two tests
// below are about is how much room it takes and where it lands, so the values
// are left at zero rather than made to describe a shape.
filler_mesh :: fn(vertices: i64, indices: i64, mark: f32) -> Mesh {
    var held := mesh_new(vertices, indices)
    var at : i64 = 0
    while (at < indices) {
        held.indices[at] = cast($u32, at % vertices)
        at = at + 1
    }
    var vertex : i64 = 0
    while (vertex < vertices) {
        step : f32 = vertex
        // The mark and the position tell one mesh's vertices from another's
        // after a copy has moved both, which is what a readback checks.
        held.vertices[vertex] = Vertex { position = vec3(mark, step, 0.0),
            normal = vec3(0.0, 1.0, 0.0), texcoord = vec2(0.0, 0.0) }
        vertex = vertex + 1
    }
    held
}

// The two tests below want a device and no window. Where there is no adapter at
// all, which is what a machine with no GPU and no software driver is, they say
// so and pass: a suite that fails there would be reporting the machine rather
// than the code.
test "a buffer that runs out grows, and what is in it comes with it" {
    var g := gpu_open()
    if (gpu_ok(g) == false) {
        print_str_line("mesh: no device, so growth was not exercised")
        gpu_close(g)
        return
    }
    device := gpu_device(g)
    queue := gpu_queue(g)
    // Room for one of the two meshes below and not both, so the second grows
    // the buffers rather than being refused.
    var store := geometry_new(device, 32, 32)
    var cache := mesh_cache_new(4)
    first := mesh_cache_insert(cache, store, device, queue, "first",
        filler_mesh(24, 30, 7.0))
    second := mesh_cache_insert(cache, store, device, queue, "second",
        filler_mesh(40, 60, 9.0))
    assert(geometry_vertex_room(store) >= 64)
    assert(geometry_index_room(store) >= 90)
    // The first mesh was copied into the new buffer at the offset it already
    // had, so its span still says where it is. The second begins where the
    // first ended, which is what a base vertex is for.
    assert(mesh_cache_at(cache, first).base_vertex == 0)
    assert(mesh_cache_at(cache, first).index_count == 30)
    assert(mesh_cache_at(cache, second).base_vertex == 24)
    assert(mesh_cache_at(cache, second).first_index == 30)
    assert(geometry_vertices(store) == 64)

    // What the buffer holds now, read back. The spans agreeing is not the same
    // as the vertices having made the trip: growing allocates a second buffer
    // and copies on the device, and a copy that ran with the wrong offset or
    // the wrong length would leave exactly these spans over the wrong bytes.
    var seen := heap_slice($Vertex, 64)
    assert(gpu_read_buffer(g, geometry_vertex_buffer(store), 0,
        64 * VERTEX_STRIDE, ptr_to(seen[0])))
    var at : i64 = 0
    while (at < 24) {
        step : f32 = at
        assert(seen[at].position.x == 7.0 && seen[at].position.y == step)
        at = at + 1
    }
    while (at < 64) {
        step : f32 = at - 24
        assert(seen[at].position.x == 9.0 && seen[at].position.y == step)
        at = at + 1
    }
    heap_release_slice($Vertex, seen)
    mesh_cache_free(cache)
    geometry_free(store)
    gpu_close(g)
}

test "a cache that loses most of what it held puts the rest back at the start" {
    var g := gpu_open()
    if (gpu_ok(g) == false) {
        print_str_line("mesh: no device, so compaction was not exercised")
        gpu_close(g)
        return
    }
    device := gpu_device(g)
    queue := gpu_queue(g)
    var store := geometry_new(device, 64, 64)
    var cache := mesh_cache_new(4)
    // Big enough that dropping it leaves more than the floor worth reclaiming,
    // which is what a rebuild waits for.
    var small := mesh_cache_insert(cache, store, device, queue, "small",
        filler_mesh(24, 30, 1.0))
    mesh_cache_insert(cache, store, device, queue, "big",
        filler_mesh(BIG_VERTICES, 64, 2.0))
    assert(geometry_vertex_room(store) >= BIG_VERTICES)
    // The small one is behind the big one in the buffer, so a rebuild is the
    // only thing that can move it back to the start.
    assert(mesh_cache_at(cache, small).base_vertex == 0)
    grown_room := geometry_vertex_room(store)

    assert(mesh_cache_remove(cache, store, device, queue, "big"))
    // Everything still here, put back from the start, and the buffers cut down
    // to what is in them.
    assert(geometry_vertices(store) == 24)
    assert(geometry_vertex_room(store) < grown_room)
    assert(geometry_vertex_room(store) < 100)
    small = mesh_cache_find(cache, "small")
    assert(mesh_cache_at(cache, small).base_vertex == 0)
    assert(mesh_cache_at(cache, small).index_count == 30)
    // Put back rather than left where it was: the vertices at the start of the
    // smaller buffer are the small mesh's, marked as its own.
    var seen := heap_slice($Vertex, 24)
    assert(gpu_read_buffer(g, geometry_vertex_buffer(store), 0,
        24 * VERTEX_STRIDE, ptr_to(seen[0])))
    var at : i64 = 0
    while (at < 24) {
        step : f32 = at
        assert(seen[at].position.x == 1.0 && seen[at].position.y == step)
        at = at + 1
    }
    heap_release_slice($Vertex, seen)
    mesh_cache_free(cache)
    geometry_free(store)
    gpu_close(g)
}

test "a cube is twenty-four vertices and thirty-six indices" {
    var held := cube_mesh()
    assert(slice_len(held.vertices) == 24)
    assert(slice_len(held.indices) == 36)
    mesh_free(held)
}

test "a sphere's normals are unit and its seam is doubled" {
    var held := sphere_mesh(2.0, 4, 6)
    // Both ends of every ring, so a ring of six segments is seven vertices.
    assert(slice_len(held.vertices) == 5 * 7)
    var index : i64 = 0
    while (index < slice_len(held.vertices)) {
        length := vec3_length(held.vertices[index].normal)
        assert(length > 0.999 && length < 1.001)
        index = index + 1
    }
    mesh_free(held)
}
