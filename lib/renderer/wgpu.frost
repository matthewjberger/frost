wgpuTextureCreateView :: extern fn(
    handle: Texture,
    descriptor: ^TextureViewDescriptor
) -> TextureView
texture_create_view :: fn(
    handle: Texture,
    descriptor: ^TextureViewDescriptor
) -> TextureView {
    held := unsafe { wgpuTextureCreateView(handle, descriptor) }
    if (held == no_texture_view()) {
        unsafe { frost_rt_error("wgpu: texture_create_view answered with nothing\n") }
        frost_rt_die()
    }
    held
}
