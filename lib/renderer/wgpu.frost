BufferMapCallbackInfo :: struct {
    next_in_chain: ^u8,
    mode: u32,
    callback: fn(u32, value StringView, ^u8, ^u8),
    userdata1: ^u8,
    userdata2: ^u8,
}

buffer_map_callback_info_of :: fn(
    $Ctx: Type,
    mode: u32,
    callback: fn(u32, value StringView, mut Ctx, ^u8),
    state: ^Ctx
) -> BufferMapCallbackInfo {
    BufferMapCallbackInfo {
        next_in_chain = null_handle(),
        mode = mode,
        callback = unsafe { ptr_cast($fn(u32, value StringView, ^u8, ^u8), callback) },
        userdata1 = unsafe { ptr_cast($u8, state) },
        userdata2 = null_handle(),
    }
}

CompilationInfoCallbackInfo :: struct {
    next_in_chain: ^u8,
    mode: u32,
    callback: fn(u32, ^CompilationInfo, ^u8, ^u8),
    userdata1: ^u8,
    userdata2: ^u8,
}

compilation_info_callback_info_of :: fn(
    $Ctx: Type,
    mode: u32,
    callback: fn(u32, ^CompilationInfo, mut Ctx, ^u8),
    state: ^Ctx
) -> CompilationInfoCallbackInfo {
    CompilationInfoCallbackInfo {
        next_in_chain = null_handle(),
        mode = mode,
        callback = unsafe { ptr_cast($fn(u32, ^CompilationInfo, ^u8, ^u8), callback) },
        userdata1 = unsafe { ptr_cast($u8, state) },
        userdata2 = null_handle(),
