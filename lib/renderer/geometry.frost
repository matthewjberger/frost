// Every mesh in one pair of buffers, and a mesh as a span of them.
//
//   mut store := geometry_new(device, MAX_VERTICES, MAX_INDICES)
//   cube := geometry_add(store, device, queue, vertices, indices)
//   geometry_bind(pass, store)
//   ... draw with span.first_index, span.base_vertex
//   geometry_free(store)
//
// One vertex buffer and one index buffer for the whole scene, and a mesh is
// where it sits in them. What that buys is a draw that does not have to be one
// mesh: an indirect draw names a range of indices and a base vertex, and those
// are numbers a compute pass can write. A vertex buffer per mesh makes the CPU
// the only thing that can decide what is drawn, because only the CPU can bind
// the next one.
//
// The arithmetic is the reason a base vertex exists. Indices are written from
// zero for each mesh as it is built, and the copy into the shared buffer does
// not renumber them; the draw adds `base_vertex` to every index instead. So a
// mesh is copied in as it was made and nothing walks its indices.

import "wgpu.frost"
import "frame.frost"
import "math.frost"

export Vertex, MeshSpan, Geometry,
    geometry_new, geometry_at, geometry_add, geometry_bind, geometry_free,
    geometry_vertices, geometry_indices, geometry_reset, geometry_vertex_buffer,
    geometry_vertex_room, geometry_index_room, geometry_shrink,
    GROWTH_FACTOR, SHRINK_THRESHOLD, MIN_RECLAIM_BYTES,
    VERTEX_STRIDE, POSITION_OFFSET, NORMAL_OFFSET, TEXCOORD_OFFSET, INDEX_BYTES

// How much bigger a buffer gets when what is being put in it does not fit:
// twice what is needed rather than exactly it, so a scene adding meshes one at a
// time reallocates a handful of times rather than once per mesh.
GROWTH_FACTOR :: 2.0

// How empty a buffer has to get before it is worth rebuilding, and how much has
// to come back for the rebuild to pay for itself. Both are needed: a buffer that
// is one tenth used is not worth touching if it is small, and a buffer with a
// lot of slack in it is not worth touching if most of it is live.
//
// The numbers are nightshade's. A rebuild copies every live mesh, so doing it
// often would cost more than the memory it gives back.
SHRINK_THRESHOLD :: 0.1
MIN_RECLAIM_BYTES :: 16777216

// Where the surface is, which way it faces, and where on an image it reads
// from. A program that samples nothing pays the eight bytes and ignores the
// attribute, which costs less than two vertex types and two of everything that
// takes one.
Vertex :: struct { position: Vec3, normal: Vec3, texcoord: Vec2 }

VERTEX_STRIDE :: 32
POSITION_OFFSET :: 0
NORMAL_OFFSET :: 12
TEXCOORD_OFFSET :: 24
INDEX_BYTES :: 4

// Where one mesh sits in the shared buffers. These three are exactly the three
// an indexed draw takes, indirect or not, which is why they are kept in this
// shape rather than as byte offsets.
MeshSpan :: struct {
    first_index: u32,
    index_count: u32,
    base_vertex: i32,
    // How far the furthest vertex sits from the mesh's own origin. What a
    // culling pass tests is a sphere, and this is its radius before anything
    // has been scaled: the pass works out where it ended up from the matrix.
    radius: f32,
}

// The two buffers, how much of each is used, and how much there is. What a
// program says at the start is where the buffers begin: they grow when what is
// being put in them does not fit, and shrink when enough of what was in them has
// gone.
//
// Both of those move things, and a span is where a mesh sits in the buffers as
// they are now. Nothing keeps one across a call that could move it; the mesh
// cache holds the spans and is what rewrites them.
Geometry :: struct {
    vertices: Buffer,
    indices: Buffer,
    vertex_room: i64,
    index_room: i64,
    vertex_count: i64,
    index_count: i64,
}

// The buffers a pass was pointed at, read the way a run is.
geometry_at :: fn(held: ^Geometry) -> ref Geometry {
    span: []Geometry = unsafe { slice_from($Geometry, held, 1) }
    ref result := span[0]
    result
}

geometry_new :: fn(device: Device, vertex_room: i64,
    index_room: i64) -> Geometry {
    var vertex_descriptor := buffer_descriptor_init()
    // Copied from as well as into: growing one is a copy on the device from the
    // old buffer to the new, and a buffer that cannot be read from would have to
    // make the trip through the CPU instead.
    vertex_descriptor.usage = (BufferUsage::Vertex | BufferUsage::CopyDst
        | BufferUsage::CopySrc)
    vertex_descriptor.size = vertex_room * VERTEX_STRIDE

    var index_descriptor := buffer_descriptor_init()
    index_descriptor.usage = (BufferUsage::Index | BufferUsage::CopyDst
        | BufferUsage::CopySrc)
    index_descriptor.size = index_room * INDEX_BYTES

    Geometry {
        vertices = device_create_buffer(device, ptr_to(vertex_descriptor)),
        indices = device_create_buffer(device, ptr_to(index_descriptor)),
        vertex_room = vertex_room, index_room = index_room,
        vertex_count = 0, index_count = 0,
    }
}

geometry_free :: fn(mut store: Geometry) {
    buffer_destroy(store.vertices)
    buffer_release(store.vertices)
    buffer_destroy(store.indices)
    buffer_release(store.indices)
    store.vertex_count = 0
    store.index_count = 0
}

// One mesh copied in, answering with where it landed.
//
// A mesh that does not fit grows the buffer rather than being refused: a new one
// twice the size it needs, the used prefix copied across, and the old one given
// back. What a program declares up front is where it starts, not what it is
// allowed; a game that loads a second level asks for room the first one did not
// need and gets it.
//
// A span is where a mesh sits in the buffers as they are now, and a rebuild
// moves things, so nothing holds one across a call that could move it. The mesh
// cache is what remembers where a mesh is, and it is what rewrites the spans.
geometry_add :: fn(mut store: Geometry, device: Device, queue: Queue,
    vertices: []Vertex, indices: []u32) -> MeshSpan {
    added := slice_len(vertices)
    ordered := slice_len(indices)
    if (added == 0 || ordered == 0) {
        return MeshSpan { first_index = 0, index_count = 0, base_vertex = 0,
            radius = 0.0 }
    }
    if (store.vertex_count + added > store.vertex_room) {
        grow_vertices(store, device, queue, store.vertex_count + added)
    }
    if (store.index_count + ordered > store.index_room) {
        grow_indices(store, device, queue, store.index_count + ordered)
    }
    // Measured here rather than asked of the caller, since the vertices are in
    // hand and nothing else knows the shape.
    var radius: f32 = 0.0
    var at: i64 = 0
    while (at < added) {
        reach := vec3_length(vertices[at].position)
        if (reach > radius) {
            radius = reach
        }
        at = at + 1
    }
    queue_write_buffer(queue, store.vertices,
        store.vertex_count * VERTEX_STRIDE, ptr_to(vertices[0]),
        added * VERTEX_STRIDE)
    queue_write_buffer(queue, store.indices,
        store.index_count * INDEX_BYTES, ptr_to(indices[0]),
        ordered * INDEX_BYTES)
    span := MeshSpan {
        first_index = cast($u32, store.index_count),
        index_count = cast($u32, ordered),
        base_vertex = cast($i32, store.vertex_count),
        radius = radius,
    }
    store.vertex_count = store.vertex_count + added
    store.index_count = store.index_count + ordered
    span
}

// Both buffers onto the pass, once for the whole scene. What a draw says after
// this is which part of them it wants.
geometry_bind :: fn(pass: RenderPassEncoder, store: Geometry) {
    render_pass_encoder_set_vertex_buffer(pass, 0, store.vertices, 0,
        store.vertex_count * VERTEX_STRIDE)
    render_pass_encoder_set_index_buffer(pass, store.indices,
        INDEX_FORMAT_UINT32, 0, store.index_count * INDEX_BYTES)
}

geometry_vertices :: fn(store: Geometry) -> i64 { store.vertex_count }
// The buffer itself, for something reading back what is in it. Nothing that
// draws needs this: `geometry_bind` is what a pass binds with, and a rebuild
// replaces the handle, so nothing keeps what this answers with.
geometry_vertex_buffer :: fn(store: Geometry) -> Buffer { store.vertices }
geometry_indices :: fn(store: Geometry) -> i64 { store.index_count }
geometry_vertex_room :: fn(store: Geometry) -> i64 { store.vertex_room }
geometry_index_room :: fn(store: Geometry) -> i64 { store.index_room }

// Emptied without giving the buffers back, which is the first half of a
// rebuild: the caller puts every mesh it still has back in, each landing where
// it now falls rather than where it was.
geometry_reset :: fn(mut store: Geometry) {
    store.vertex_count = 0
    store.index_count = 0
}

// The buffers cut down to what is in them, which is the second half of a
// rebuild. Called after everything live has been put back, so what it measures
// is the live total and not the total before the rebuild.
//
// Nothing shrinks unless the smaller buffer really is smaller: a rebuild that
// reclaimed little would otherwise pay for two allocations and a copy to end up
// where it started.
geometry_shrink :: fn(mut store: Geometry, device: Device, queue: Queue) {
    wanted_vertices := grown(store.vertex_count)
    if (wanted_vertices < store.vertex_room && store.vertex_count > 0) {
        replace_vertices(store, device, queue, wanted_vertices)
    }
    wanted_indices := grown(store.index_count)
    if (wanted_indices < store.index_room && store.index_count > 0) {
        replace_indices(store, device, queue, wanted_indices)
    }
}

// Room for this many, with the growth factor applied.
grown :: fn(needed: i64) -> i64 {
    held: f32 = needed
    scaled := cast($i64, held * GROWTH_FACTOR)
    if (scaled < needed) {
        return needed
    }
    scaled
}

grow_vertices :: fn(mut store: Geometry, device: Device, queue: Queue,
    needed: i64) {
    replace_vertices(store, device, queue, grown(needed))
}

grow_indices :: fn(mut store: Geometry, device: Device, queue: Queue,
    needed: i64) {
    replace_indices(store, device, queue, grown(needed))
}

// A buffer of the given size holding what the old one held, and the old one
// given back. The copy is on the device: what is in the buffer came from the
// CPU once and there is no reason for it to make the trip again.
replace_vertices :: fn(mut store: Geometry, device: Device, queue: Queue,
    room: i64) {
    var descriptor := buffer_descriptor_init()
    descriptor.usage = (BufferUsage::Vertex | BufferUsage::CopyDst
        | BufferUsage::CopySrc)
    descriptor.size = room * VERTEX_STRIDE
    made := device_create_buffer(device, ptr_to(descriptor))
    carry_over(store.vertices, made, device, queue,
        store.vertex_count * VERTEX_STRIDE)
    retire(store.vertices)
    store.vertices = made
    store.vertex_room = room
}

replace_indices :: fn(mut store: Geometry, device: Device, queue: Queue,
    room: i64) {
    var descriptor := buffer_descriptor_init()
    descriptor.usage = (BufferUsage::Index | BufferUsage::CopyDst
        | BufferUsage::CopySrc)
    descriptor.size = room * INDEX_BYTES
    made := device_create_buffer(device, ptr_to(descriptor))
    carry_over(store.indices, made, device, queue,
        store.index_count * INDEX_BYTES)
    retire(store.indices)
    store.indices = made
    store.index_room = room
}

// The buffer this one replaced, let go of.
//
// Let go of rather than destroyed. Handing the last reference back is the whole
// of what is wanted here, and the device frees the storage once the copy above
// has retired. Destroying it as well would be an early free of something
// nothing else names, which is work to say what dropping the handle already
// says; nightshade drops its handle and nothing more.
retire :: fn(held: Buffer) {
    buffer_release(held)
}

// What the old buffer held, into the new one, as one recorded copy submitted on
// its own. Nothing else is in flight against these: a mesh is added between
// frames, so nothing is drawing from either while this runs.
carry_over :: fn(from: Buffer, into: Buffer, device: Device, queue: Queue,
    bytes: i64) {
    if (bytes <= 0) {
        return
    }
    encoder := device_create_command_encoder(device, no_pointer())
    command_encoder_copy_buffer_to_buffer(encoder, from, 0, into, 0,
        cast($u64, bytes))
    var command := command_encoder_finish(encoder, no_pointer())
    queue_submit(queue, 1, ptr_to(command))
    command_buffer_release(command)
    command_encoder_release(encoder)
}
