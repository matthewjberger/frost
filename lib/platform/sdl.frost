// SDL3: a window, its events, and the clock that paces them.
//
// Hand-written rather than generated, because SDL ships a C header rather than
// a schema. It follows the shape the wgpu binding is generated in: the externs
// are private to this file, a window is a type of its own rather than a bare
// pointer, and a title is a `str` rather than a promise that the bytes end in a
// NUL. A program that opens a window writes no `unsafe` of its own.
//
// What is not covered is most of SDL. This is what the graphics examples need,
// and a call added here is one line beside its extern.

import "mem.frost"

export Window, is_no_window, Event, event_new, event_kind, event_number,
    event_u32_at, event_f32_at, event_scancode, event_key_repeat,
    event_mouse_x, event_mouse_y, event_mouse_dx, event_mouse_dy,
    event_button, event_wheel_x, event_wheel_y,
    event_window_width, event_window_height,
    EventKind, InitFlags, WindowFlags,
    PROP_WIN32_HWND, PROP_X11_DISPLAY, PROP_X11_WINDOW, PROP_COCOA_WINDOW,
    sdl_init, sdl_quit, sdl_ticks, sdl_delay, sdl_error,
    window_create, window_destroy, window_properties, window_pointer_property,
    metal_view_create, metal_view_layer, metal_view_destroy,
    poll_event

// The C entry points, declared with the types this binding hands out rather
// than with the pointers C spells them in: a window arrives from
// `SDL_CreateWindow` already a `Window`, so nothing below has to make one out
// of an address. A call taking no pointer cannot corrupt memory whatever it is
// given, and says so with `safe`.
SDL_Init :: safe extern fn(flags: u32) -> bool
SDL_Quit :: safe extern fn()
SDL_CreateWindow :: extern fn(
    title: ^i8,
    width: i32,
    height: i32,
    flags: u64
) -> Window
SDL_DestroyWindow :: extern fn(window: Window)
SDL_PollEvent :: extern fn(event: ^u8) -> bool
SDL_GetWindowProperties :: extern fn(window: Window) -> u32
SDL_GetPointerProperty :: extern fn(
    properties: u32,
    name: ^i8,
    fallback: ^u8
) -> ^u8
SDL_GetTicks :: safe extern fn() -> u64
SDL_Delay :: safe extern fn(milliseconds: u32)
SDL_GetError :: extern fn() -> ^i8
SDL_Metal_CreateView :: extern fn(window: Window) -> ^u8
SDL_Metal_GetLayer :: extern fn(view: ^u8) -> ^u8
SDL_Metal_DestroyView :: extern fn(view: ^u8)

// A window is a pointer SDL owns, under a name of its own, so it cannot be
// handed to a call that wants some other pointer and no pointer from elsewhere
// can be handed to one that wants a window.
Window :: distinct ^u8

// What a subsystem and a window flag are. Not enums, because they are not a
// closed set of alternatives: SDL's flags are bits and a call takes several at
// once. The numbers are SDL's, so they are written rather than chosen.
//
//     window_create("Frost", 960, 540,
//         WindowFlags::Resizable | WindowFlags::HighPixelDensity)
//
// is how two are asked for. The combination is a WindowFlags because both
// operands are, so nothing has to say so.
InitFlags :: flags u32 {
    Audio = 16,
    Video = 32,
    Gamepad = 8192,
    Events = 16384,
}

WindowFlags :: flags u64 {
    Fullscreen = 1,
    Hidden = 8,
    Borderless = 16,
    Resizable = 32,
    HighPixelDensity = 8192,
}

// SDL_Event is a union of every event kind. Frost has no unions and does not
// need one to carry this: the union is 128 bytes with the kind in the first
// four, so the bytes are the value and the kind is read out of them.
EVENT_SIZE :: 128

// What an event is, as an alternative rather than a number. SDL numbers these
// with gaps and a program handles a few of them, so the rest arrive as `Other`
// and the kind a program did not ask about is still a kind it can see.
EventKind :: enum {
    Quit, WindowResized, WindowClosed, KeyDown, KeyUp,
    MouseMotion, MouseButtonDown, MouseButtonUp, MouseWheel, Other,
}

// The properties a window carries the platform's own handle under. Which one a
// program wants is decided by the platform it is drawing on.
PROP_WIN32_HWND :: "SDL.window.win32.hwnd"
PROP_X11_DISPLAY :: "SDL.window.x11.display"
PROP_X11_WINDOW :: "SDL.window.x11.window"
PROP_COCOA_WINDOW :: "SDL.window.cocoa.window"

Event :: struct {
    bytes: [EVENT_SIZE]u8,
}

event_new :: fn() -> Event {
    Event { bytes = [0; EVENT_SIZE] }
}

// SDL's own number for an event, read out of the first four bytes.
event_number :: fn(e: Event) -> u32 {
    unsafe { ptr_cast($u32, ptr_to(e.bytes[0]))^ }
}

event_kind :: fn(e: Event) -> EventKind {
    held := event_number(e)
    if (held == 256) { return EventKind::Quit }
    // 518 is a resize. 519 is `SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED`, a
    // different event, and it was what this asked for until the header was read
    // rather than remembered.
    if (held == 518) { return EventKind::WindowResized }
    if (held == 528) { return EventKind::WindowClosed }
    if (held == 768) { return EventKind::KeyDown }
    if (held == 769) { return EventKind::KeyUp }
    if (held == 1024) { return EventKind::MouseMotion }
    if (held == 1025) { return EventKind::MouseButtonDown }
    if (held == 1026) { return EventKind::MouseButtonUp }
    if (held == 1027) { return EventKind::MouseWheel }
    EventKind::Other
}

// ---------------------------------------------------------------------------
// What an event carries
//
// Every SDL event opens with the same twenty bytes, a type, a padding word, a
// timestamp and a window id, and each kind lays its own fields after them. The
// offsets below are what the compiler reports for this SDL, taken with
// `offsetof` against `SDL_events.h` rather than counted by hand: a field read
// from the wrong place is a number that looks plausible.
// ---------------------------------------------------------------------------

event_u32_at :: fn(e: Event, offset: i64) -> u32 {
    unsafe { ptr_cast($u32, ptr_to(e.bytes[offset]))^ }
}

event_f32_at :: fn(e: Event, offset: i64) -> f32 {
    unsafe { ptr_cast($f32, ptr_to(e.bytes[offset]))^ }
}

// Where a key sits on the board rather than what it prints, so a layout does
// not move it.
event_scancode :: fn(e: Event) -> i64 { event_u32_at(e, 24) }

// Whether the key was already down and the system repeated it.
event_key_repeat :: fn(e: Event) -> bool { e.bytes[37] != 0 }

// Motion says where the pointer is and how far it came, both in window
// coordinates. The movement is since the last event rather than the last frame.
event_mouse_x :: fn(e: Event) -> f32 { event_f32_at(e, 28) }
event_mouse_y :: fn(e: Event) -> f32 { event_f32_at(e, 32) }
event_mouse_dx :: fn(e: Event) -> f32 { event_f32_at(e, 36) }
event_mouse_dy :: fn(e: Event) -> f32 { event_f32_at(e, 40) }

// A button event puts the button where motion puts its state, so the position
// offsets are shared and this one is not.
event_button :: fn(e: Event) -> i64 { e.bytes[24] }

// The wheel, in notches rather than pixels.
event_wheel_x :: fn(e: Event) -> f32 { event_f32_at(e, 24) }
event_wheel_y :: fn(e: Event) -> f32 { event_f32_at(e, 28) }

// A window event's two numbers, which for a resize are the new width and
// height.
event_window_width :: fn(e: Event) -> i64 { event_u32_at(e, 20) }
event_window_height :: fn(e: Event) -> i64 { event_u32_at(e, 24) }

// Whether a window is the one that names nothing, which is what a failed
// creation answers with. SDL says why in `sdl_error`. This asks the question
// rather than handing out such a window, so nothing here builds a `Window` out
// of an address: the only ones a program holds are the ones SDL made.
is_no_window :: fn(w: Window) -> bool {
    zero := 0
    w == unsafe { ptr_cast($u8, zero) }
}

// A NUL-terminated copy of a string, for the calls below. C reads one until a
// NUL and a `str` has none, so the terminator is added here rather than
// promised by every caller. The caller of this frees it.
c_string :: fn(text: str) -> ^u8 {
    length := str_len(text)
    block := heap_bytes(length + 1)
    mut view := bytes_as($u8, block, length + 1)
    mut i: i64 = 0
    while (i < length) {
        view[i] = text[i]
        i = i + 1
    }
    view[length] = 0
    block
}

sdl_init :: fn(flags: InitFlags) -> bool {
    SDL_Init(flags)
}

sdl_quit :: fn() {
    SDL_Quit()
}

// Milliseconds since SDL started, which is what paces an animation without
// following the frame rate.
sdl_ticks :: fn() -> u64 {
    SDL_GetTicks()
}

sdl_delay :: fn(milliseconds: u32) {
    SDL_Delay(milliseconds)
}

// What SDL says went wrong, as text. SDL owns the bytes and they last until the
// next call into it, so this is a view rather than a copy.
sdl_error :: fn() -> str {
    raw: ^i8 = unsafe { SDL_GetError() }
    mut length: i64 = 0
    while (unsafe { raw[length] } != 0) {
        length = length + 1
    }
    unsafe { slice_from($u8, ptr_cast($u8, raw), length) }
}

// Answers `no_window()` when SDL could not make one, which a program is
// expected to check: a display that is not there is an ordinary thing to find
// out about rather than a reason to stop.
window_create :: fn(
    title: str,
    width: i32,
    height: i32,
    flags: WindowFlags
) -> Window {
    held := c_string(title)
    made := unsafe {
        SDL_CreateWindow(ptr_cast($i8, held), width, height, flags)
    }
    heap_release(held)
    made
}

window_destroy :: fn(w: Window) {
    unsafe { SDL_DestroyWindow(w) }
}

window_properties :: fn(w: Window) -> u32 {
    unsafe { SDL_GetWindowProperties(w) }
}

// The platform's own handle for a window: an HWND on Windows, an X11 window id,
// an NSWindow. It is a bare pointer because the API it is handed to next is
// another C one, which is where it means something.
window_pointer_property :: fn(properties: u32, name: str) -> ^u8 {
    held := c_string(name)
    zero := 0
    found := unsafe {
        SDL_GetPointerProperty(
            properties,
            ptr_cast($i8, held),
            ptr_cast($u8, zero)
        )
    }
    heap_release(held)
    found
}

// A CAMetalLayer-backed view, made and attached to the window, which is the
// handle a Metal surface is chained off on Apple platforms the way an HWND is
// on Windows. SDL answers null everywhere Metal is not, so asking is also how
// a program finds out it is somewhere else. Destroyed before the window is,
// by whoever made it.
metal_view_create :: fn(w: Window) -> ^u8 {
    unsafe { SDL_Metal_CreateView(w) }
}

metal_view_layer :: fn(view: ^u8) -> ^u8 {
    unsafe { SDL_Metal_GetLayer(view) }
}

metal_view_destroy :: fn(view: ^u8) {
    unsafe { SDL_Metal_DestroyView(view) }
}

// The next event, written into the caller's own buffer, which is the right size
// by construction rather than by promise. False when there are none left.
poll_event :: fn(mut e: Event) -> bool {
    unsafe { SDL_PollEvent(ptr_to(e.bytes[0])) }
}
