/target
history.txt
*.exe
*.o
# `--emit-c` and `--emit-asm` write beside the source they were given, which for
# a file in the tree means into the tree.
/*.c
/*.s
selfhosted/.run_target*.s
*.py
!bench/generate.py
bench/generated
.frost-build
# The import library and headers `just fetch` writes beside the two runtime
# libraries. Nothing here links against either: a Windows build names the DLL
# and a Linux build names what the system already has.
lib/platform/SDL3.lib
examples/graphics/window
# Everything `just fetch` writes here except the two the tree carries: the
# Windows runtime library and the schema the binding is generated from.
# What a Unix host fetches is its own `libwgpu_native.so` or `.dylib`,
# which nothing else on that host would want committed.
lib/renderer/wgpu/*
!lib/renderer/wgpu/wgpu_native.dll
!lib/renderer/wgpu/webgpu.json
# The libraries the justfile copies beside a built demo, so the loader
# finds them. The originals live beside the bindings that name them.
examples/graphics/wgpu_native.dll
examples/graphics/SDL3.dll
examples/wgpu_native.dll
examples/SDL3.dll
examples/graphics/triangle
examples/graphics/*.png
examples/graphics/*.exe
tools/*.exe

# The rendered book. The source is docs/book/src.
/docs/book/book
lib/platform/SDL3/

# Scratch output from compiling a file to check it, which every sweep over the
# tree leaves behind.
*.tmp
audit.tmp

# What the log plugin writes beside a program it ran, named for the window.
*.log
