// Reading and writing whole files. A read answers with the bytes as a `str`
// over a fresh heap block, along with whether it succeeded. A write takes a
// `str` and reports the same. The buffer a read returns is the caller's to
// free with fs_free.
//
// A path is a `str` like any other text. C reads one until a NUL and a `str`
// has none, so the terminator is added here, once, rather than promised by
// every caller through a `^i8` the compiler cannot check.
//
// The extern calls are the unsafe floor, wrapped here so a program that reads
// and writes files names none of them.

import "mem.frost"
import "strings.frost"

export ReadResult, fs_read, fs_write, fs_free, fs_exists, fs_remove

frost_rt_file_read :: extern fn(path: ^i8) -> ^u8
frost_rt_file_size :: extern fn() -> i64
frost_rt_file_write :: extern fn(path: ^i8, bytes: ^u8, length: i64) -> i64
frost_rt_file_exists :: extern fn(path: ^i8) -> i64
frost_rt_remove_file :: extern fn(path: ^i8) -> i64
frost_rt_heap_free :: extern fn(block: ^u8)

// `ok` is false when the file could not be opened, in which case `text` is
// empty. `buffer` is the heap block the text views, kept so fs_free can release
// it without reaching back through the slice.
// A read owns the buffer its text borrows, so it is a resource: the compiler
// refuses a read whose buffer nothing frees.
ReadResult :: linear struct {
    text: str,
    buffer: ^u8,
    ok: bool,
}

// A NUL-terminated copy of a path, for the calls below. The caller frees it.
path_bytes :: fn(path: str) -> ^u8 {
    length := str_len(path)
    block := heap_bytes(length + 1)
    var view := bytes_as($u8, block, length + 1)
    var i: i64 = 0
    while (i < length) {
        view[i] = path[i]
        i = i + 1
    }
    view[length] = 0
    block
}

fs_read :: fn(path: str) -> ReadResult {
    held := path_bytes(path)
    raw := unsafe { frost_rt_file_read(ptr_cast($i8, held)) }
    length := unsafe { frost_rt_file_size() }
    heap_release(held)
    if (length < 0) {
        return ReadResult {
            text = unsafe { slice_from($u8, raw, 0) },
            buffer = raw,
            ok = false
        }
    }
    ReadResult {
        text = unsafe { slice_from($u8, raw, length) },
        buffer = raw,
        ok = true
    }
}

// Free the buffer a read returned. The `str` borrows it, so nothing may use the
// text after this.
fs_free :: fn(move result: ReadResult) {
    unsafe { frost_rt_heap_free(result.buffer) }
}

fs_write :: fn(path: str, text: str) -> bool {
    held := path_bytes(path)
    length := str_len(text)
    var wrote: i64 = 0
    if (length == 0) {
        wrote = unsafe { frost_rt_file_write(ptr_cast($i8, held), held, 0) }
    } else {
        wrote = unsafe {
            frost_rt_file_write(ptr_cast($i8, held), ptr_to(text[0]), length)
        }
    }
    heap_release(held)
    wrote == 1
}

fs_exists :: fn(path: str) -> bool {
    held := path_bytes(path)
    found := unsafe { frost_rt_file_exists(ptr_cast($i8, held)) }
    heap_release(held)
    found == 1
}

// Take a file away, answering whether it went. What a program that wrote one
// reaches for, and what lets these tests leave the directory as they found it.
fs_remove :: fn(path: str) -> bool {
    held := path_bytes(path)
    gone := unsafe { frost_rt_remove_file(ptr_cast($i8, held)) }
    heap_release(held)
    gone == 1
}

SCRATCH :: "frost_fs_round_trip.txt"

test "a file written is a file read back" {
    before := heap_live()
    assert(fs_write(SCRATCH, "one line and then some"))
    assert(fs_exists(SCRATCH))
    var held := fs_read(SCRATCH)
    assert(held.ok)
    assert(str_eq(held.text, "one line and then some"))
    fs_free(held)
    assert(fs_remove(SCRATCH))
    assert(fs_exists(SCRATCH) == false)
    // What a read takes it gives back. The block comes from the runtime and
    // goes back through the counted free, so a read that took it any other way
    // would show up here as a count that moved.
    assert(heap_live() == before)
}

test "a read that failed still gives back what it was handed" {
    before := heap_live()
    var missing := fs_read("frost_no_such_file_is_here.txt")
    assert(missing.ok == false)
    assert(str_len(missing.text) == 0)
    // The failing read is handed a block like any other, so freeing it is a
    // program giving back storage it took rather than storage it never had.
    fs_free(missing)
    assert(heap_live() == before)
}
