// A generational columns container: the structure-of-arrays sibling of a slab.
// It stores each field of the element type in its own contiguous array, so a
// system that reads one field across many elements strides one column rather
// than gathering whole structs. The handle scheme is the slab's, unchanged. A
// slot goes stale when it is released and reused, and a handle to it stops
// reading.
//
// `columns<T, N>` is declared below, out of a `for` over `fields(T)`: one
// `[N]field` array per field of `T`, each keeping the name its own declaration
// gave it, plus the bookkeeping a slab carries. `columns_zeroed()` builds a
// zeroed one. The deref `c[handle].field` and the element scatter
// `c[handle] = value` are compiler-supplied because they select a column before
// indexing, which is not writable where a struct is one value. Everything else
// here is ordinary Frost over those, mirroring std/slab.frost, so switching a
// system from `Slab<T, N>` to `columns<T, N>` changes the container token and
// the `slab_` prefix, nothing else.

import "slab.frost"

export columns, columns_reset, columns_full, columns_insert, columns_alive,
    columns_release

// One array per field of the element, named after that field, and the
// generational bookkeeping beside them. `live_words` says which slots hold an
// element, one bit each, so `for slot in live_slots(c)` walks them in slot
// order and skips sixty-four dead slots at a time. It comes after the columns,
// so every column keeps the offset it would have had without it.
columns :: struct($T: Type, $N: usize) {
    for column in fields(T) { [N]column }
    generations: [N]i64,
    free_list: [N]i64,
    free_count: i64,
    live_words: [(N + 63) / 64]i64,
    live_count: i64,
}

// Every slot free, every generation back to zero. Built with `columns_zeroed()`
// and then reset, since construction cannot run code.
//
// `live_words` and `live_count` are the container's record of which slots hold
// an element, one bit per slot, and they are what `for slot in live_slots(c)`
// walks. The free list says the same thing inside out, but a walk of it is in
// release order rather than slot order, which is the order a column is stored
// in.
columns_reset :: fn($T: Type, $N: usize, mut c: columns<T, N>) {
    stamp := frost_rt_container_id() << CONTAINER_SHIFT
    mut i: i64 = 0
    while (i < N) {
        c.generations[i] = stamp
        c.free_list[i] = N - 1 - i
        i = i + 1
    }
    mut w: i64 = 0
    while (w < (N + 63) / 64) {
        c.live_words[w] = 0
        w = w + 1
    }
    c.live_count = 0
    c.free_count = N
}

columns_full :: fn($T: Type, $N: usize, c: columns<T, N>) -> bool {
    c.free_count == 0
}

// The caller checks `columns_full` first. The element is scattered into the
// columns at the free slot. The handle carries that slot's current generation.
columns_insert :: fn($T: Type, $N: usize, mut c: columns<T, N>, move value: $T)
    -> Handle<T> {
    c.free_count = c.free_count - 1
    index := c.free_list[c.free_count]
    handle: Handle<T> = (c.generations[index] << 32) | index
    c[handle] = value
    c.live_words[index >> 6] = c.live_words[index >> 6] | (1 << (index & 63))
    c.live_count = c.live_count + 1
    handle
}

columns_alive :: fn($T: Type, $N: usize, c: columns<T, N>, handle: Handle<T>)
    -> bool {
    raw: i64 = handle
    c.generations[raw & 4294967295] == (raw >> 32)
}

// Bumping the generation makes every outstanding handle to this slot stale, so
// a later `c[handle].field` through one aborts rather than reading the next
// tenant.
columns_release :: fn(
    $T: Type,
    $N: usize,
    mut c: columns<T,
    N>,
    handle: Handle<T>
) -> bool {
    raw: i64 = handle
    index := raw & 4294967295
    if (c.generations[index] != (raw >> 32)) {
        return false
    }
    c.generations[index] = c.generations[index] + 1
    // Cleared before the retirement check, since a retired slot holds no
    // element either and a walk that still visited it would read the one that
    // was released.
    bit := 1 << (index & 63)
    c.live_words[index >> 6] = c.live_words[index >> 6] & (-1 - bit)
    c.live_count = c.live_count - 1
    // The handle scheme is the slab's, so its generation bound is too: a spent
    // slot is retired rather than handed out again. See GENERATION_LIMIT.
    if ((c.generations[index] & 16777215) > GENERATION_LIMIT) {
        return true
    }
    c.free_list[c.free_count] = index
    c.free_count = c.free_count + 1
    true
}
