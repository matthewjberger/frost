// Typed heap allocation. One block of `count` elements of `T`, given back as a
// pointer or as a slice.
//
// Everything a container does with the heap needs two unsafe operations at
// once: calling C to get the bytes, and reinterpreting them as a typed pointer.
// Written at each site that is three `unsafe` blocks per container and the
// element-count-times-size arithmetic repeated everywhere it is easy to get
// wrong. Written here it is one block per function, and a caller reads
// `keys := heap_array($i64, cap)` with no `unsafe` of its own, because an
// unsafe block is a perimeter: calling a function that contains one does not
// require one.
//
// `heap_slice` is the stronger form and the one to reach for. A slice carries
// its length, so every later access through it is bounds-checked and the
// container's body is ordinary safe code. Only the allocation and the release
// are unchecked, and both are here.

export heap_array, heap_slice, heap_grow, heap_grow_slice, heap_release,
    heap_release_slice, heap_bytes, heap_grow_bytes, heap_zero, heap_copy,
    bytes_at, bytes_as, as_bytes, slice_prefix, slice_range, slice_span,
    slice_chunk, heap_live

// How many blocks are out. A container that frees what it took leaves this
// where it found it, so a test can say a leak happened rather than waiting for
// a long-running program to notice.
frost_rt_heap_live :: safe extern fn() -> i64
// How many bytes a count of elements takes, refused where the multiplication
// would wrap. Safe because it is arithmetic and an abort: a wrapped size asks
// for fewer bytes than the caller believes, and the slice built over the block
// then reads past its end with every access reporting as bounds-checked.
frost_rt_check_size :: safe extern fn(count: i64, width: i64) -> i64
// A view of `count` elements starting `from` into a run of `room`, refused where
// it reaches past the end. Safe for the same reason: arithmetic and an abort.
frost_rt_check_span :: safe extern fn(from: i64, count: i64, room: i64) -> i64
frost_rt_heap_alloc :: extern fn(size: i64) -> ^u8
frost_rt_heap_realloc :: extern fn(block: ^u8, size: i64) -> ^u8
frost_rt_heap_free :: extern fn(block: ^u8)
frost_rt_mem_set :: extern fn(destination: ^u8, value: i64, size: i64)
frost_rt_mem_copy :: extern fn(destination: ^u8, source: ^u8, size: i64)

// Room for `count` elements of `T`. A count of zero still allocates one, so a
// container never holds a pointer to nothing.
heap_array :: fn($T: Type, count: i64) -> ^T {
    mut room := count
    if (room < 1) {
        room = 1
    }
    unsafe {
        ptr_cast($T, frost_rt_heap_alloc(frost_rt_check_size(room, sizeof(T))))
    }
}

// The same block as a slice of that length, which is what makes the code above
// it bounds-checked.
heap_slice :: fn($T: Type, count: i64) -> []T {
    mut room := count
    if (room < 1) {
        room = 1
    }
    unsafe { slice_from($T, heap_array($T, room), room) }
}

// Resize a block, answering where it now is. The old pointer is not valid after
// this, which is why it is taken by `move`.
heap_grow :: fn($T: Type, move block: ^T, count: i64) -> ^T {
    mut room := count
    if (room < 1) {
        room = 1
    }
    unsafe {
        ptr_cast(
            $T,
            frost_rt_heap_realloc(
                ptr_cast($u8, block),
                frost_rt_check_size(room, sizeof(T))
            )
        )
    }
}

// The same for a slice, answering one of the new length.
heap_grow_slice :: fn($T: Type, move held: []T, count: i64) -> []T {
    mut room := count
    if (room < 1) {
        room = 1
    }
    grown := unsafe {
        ptr_cast(
            $T,
            frost_rt_heap_realloc(
                ptr_cast($u8, ptr_to(held[0])),
                frost_rt_check_size(room, sizeof(T))
            )
        )
    }
    unsafe { slice_from($T, grown, room) }
}

// The first `count` elements of a slice. A container whose storage is the whole
// block hands out its live prefix with this, so the length a caller sees is the
// number of elements there are rather than the room there is.
//
// A count past the end is refused. Where the pointer comes from a slice the run
// is known, so a longer view is a false claim rather than an unverifiable one,
// and the empty case answers with the slice itself since there is no element to
// point at.
slice_prefix :: fn($T: Type, held: []T, count: i64) -> []T {
    room := slice_len(held)
    frost_rt_check_span(0, count, room)
    if (count == 0) {
        return slice_empty(held)
    }
    unsafe { slice_from($T, ptr_to(held[0]), count) }
}

// `count` elements starting at `from`. The pointer is taken from the slice's
// own storage rather than from this frame, which is what lets the view outlive
// the call the way `slice_prefix` does.
//
// Both ends are answered for against the run: `from` because reaching it is an
// index, and `count` because a view longer than what is left carries a length
// its storage does not have, and every access through it is then bounds-checked
// against that length and passes. Where the count is derived rather than known,
// `slice_span` clamps it first.
slice_range :: fn($T: Type, held: []T, from: i64, count: i64) -> []T {
    room := slice_len(held)
    frost_rt_check_span(from, count, room)
    if (count == 0) {
        return slice_empty(held)
    }
    unsafe { slice_from($T, ptr_to(held[from]), count) }
}

// A view of nothing over the same storage. `ptr_to(held[0])` is an index like
// any other, so an empty slice has no element to take the address of, and every
// answer of no elements comes through here instead.
slice_empty :: fn($T: Type, held: []T) -> []T {
    if (slice_len(held) == 0) {
        return held
    }
    unsafe { slice_from($T, ptr_to(held[0]), 0) }
}

// The same run, but ending at the slice's end rather than past it. An empty
// answer where `from` has reached the length, so a walk to the end needs no
// special case at its last step.
//
// An empty slice answers with itself rather than a run built from one, since
// there is no element to point at and reaching for one is an index like any
// other.
slice_span :: fn($T: Type, held: []T, from: i64, count: i64) -> []T {
    length := slice_len(held)
    if (length == 0) {
        return held
    }
    if (from >= length) {
        return slice_range(held, length - 1, 0)
    }
    mut room := length - from
    if (count < room) {
        room = count
    }
    slice_range(held, from, room)
}

// The `index`th of `count` spans that together cover a slice and never overlap.
// Sizes differ by at most one, the first `extra` spans taking the remainder.
//
// This is what makes handing a slice to several threads safe rather than
// hopeful: no two spans hold the same element, so no two workers can reach it,
// and a borrow cannot escape the call that was given one. An index outside the
// count answers empty rather than aborting, so a worker pool larger than the
// work has nothing to special-case.
slice_chunk :: fn($T: Type, held: []T, count: i64, index: i64) -> []T {
    total := slice_len(held)
    if (count < 1 || index < 0 || index >= count) {
        return slice_span(held, total, 0)
    }
    per := total / count
    extra := total % count
    mut from := index * per
    mut room := per
    if (index < extra) {
        from = from + index
        room = room + 1
    } else {
        from = from + extra
    }
    slice_span(held, from, room)
}

heap_release :: fn($T: Type, move block: ^T) {
    unsafe { frost_rt_heap_free(ptr_cast($u8, block)) }
}

heap_release_slice :: fn($T: Type, move held: []T) {
    unsafe { frost_rt_heap_free(ptr_cast($u8, ptr_to(held[0]))) }
}

// A run of bytes with a width decided while the program runs, for a container
// whose element type is not in the type system: the ECS's columns are this.
heap_bytes :: fn(size: i64) -> ^u8 {
    mut room := size
    if (room < 1) {
        room = 1
    }
    unsafe { frost_rt_heap_alloc(room) }
}

heap_grow_bytes :: fn(move block: ^u8, size: i64) -> ^u8 {
    mut room := size
    if (room < 1) {
        room = 1
    }
    unsafe { frost_rt_heap_realloc(block, room) }
}

// One position in a run of bytes, for a container whose element width is
// decided while the program runs. The arithmetic is written here rather than at
// each site, so a byte offset and an element index cannot be confused.
bytes_at :: fn(block: ^u8, offset: i64) -> ^u8 {
    unsafe { ptr_to(block[offset]) }
}

// A run of bytes read as a run of `T`, which is the end of an erasure: what
// comes back is bounds-checked, and how many elements there are is the caller's
// to say because the bytes do not know.
bytes_as :: fn($T: Type, block: ^u8, count: i64) -> []T {
    unsafe { slice_from($T, ptr_cast($T, block), count) }
}

// The other direction: a run of `T` read as the bytes it occupies. An
// allocation source deals in bytes, so a container handing its storage back for
// resizing or release goes through here. The length is worked out rather than
// asked for, since a run of `T` does know how many there are.
as_bytes :: fn($T: Type, held: []T) -> []u8 {
    unsafe {
        slice_from(
            $u8,
            ptr_cast($u8, ptr_to(held[0])),
            frost_rt_check_size(slice_len(held), sizeof(T))
        )
    }
}

heap_live :: fn() -> i64 {
    frost_rt_heap_live()
}

heap_zero :: fn(destination: ^u8, size: i64) {
    unsafe { frost_rt_mem_set(destination, 0, size) }
}

heap_copy :: fn(destination: ^u8, source: ^u8, size: i64) {
    unsafe { frost_rt_mem_copy(destination, source, size) }
}

test "a range views the middle of a slice" {
    mut held := heap_slice($i64, 8)
    mut fill: i64 = 0
    while (fill < 8) {
        held[fill] = fill * 10
        fill = fill + 1
    }
    middle := slice_range(held, 2, 3)
    assert(slice_len(middle) == 3)
    assert(middle[0] == 20)
    assert(middle[2] == 40)
    heap_release_slice(held)
}

test "a span stops at the end of what it views" {
    mut held := heap_slice($i64, 4)
    held[3] = 7
    assert(slice_len(slice_span(held, 2, 99)) == 2)
    assert(slice_span(held, 2, 99)[1] == 7)
    assert(slice_len(slice_span(held, 4, 2)) == 0)
    assert(slice_len(slice_span(held, 99, 2)) == 0)
    heap_release_slice(held)
}

// Every element in exactly one span, whatever the count divides into. Writing
// each element's own index through its span and reading the whole slice back is
// what says the spans covered it and did not overlap: an element two spans held
// would be written twice and one no span held would keep its zero.
test "chunks cover a slice exactly once" {
    mut counts: [5]i64 = [1, 2, 3, 4, 7]
    mut which: i64 = 0
    while (which < 5) {
        count := counts[which]
        mut held := heap_slice($i64, 10)
        mut clear: i64 = 0
        while (clear < 10) {
            held[clear] = 0
            clear = clear + 1
        }
        mut index: i64 = 0
        mut seen: i64 = 0
        while (index < count) {
            mut span := slice_chunk(held, count, index)
            seen = seen + slice_len(span)
            mut at: i64 = 0
            while (at < slice_len(span)) {
                span[at] = span[at] + 1
                at = at + 1
            }
            index = index + 1
        }
        assert(seen == 10)
        mut every: i64 = 0
        while (every < 10) {
            assert(held[every] == 1)
            every = every + 1
        }
        heap_release_slice(held)
        which = which + 1
    }
}

test "chunks answer empty where there is no work for them" {
    mut held := heap_slice($i64, 2)
    assert(slice_len(slice_chunk(held, 5, 0)) == 1)
    assert(slice_len(slice_chunk(held, 5, 1)) == 1)
    assert(slice_len(slice_chunk(held, 5, 2)) == 0)
    assert(slice_len(slice_chunk(held, 5, 9)) == 0)
    assert(slice_len(slice_chunk(held, 0, 0)) == 0)
    heap_release_slice(held)
}

test "a prefix is as long as it was asked for" {
    mut held := heap_slice($i64, 8)
    held[0] = 1
    held[1] = 2
    front := slice_prefix(held, 2)
    assert(slice_len(front) == 2)
    assert(front[1] == 2)
    heap_release_slice(held)
}

test "a typed block holds what is written into it" {
    mut held := heap_slice($i64, 4)
    held[0] = 10
    held[3] = 40
    assert(slice_len(held) == 4)
    assert(held[0] == 10)
    assert(held[3] == 40)
    heap_release_slice(held)
}

test "a block keeps its contents across a grow" {
    mut held := heap_slice($i64, 2)
    held[0] = 1
    held[1] = 2
    mut bigger := heap_grow_slice(held, 8)
    assert(slice_len(bigger) == 8)
    assert(bigger[0] == 1)
    assert(bigger[1] == 2)
    bigger[7] = 7
    assert(bigger[7] == 7)
    heap_release_slice(bigger)
}

test "a zero count still gives a block to write into" {
    mut held := heap_slice($i64, 0)
    held[0] = 5
    assert(held[0] == 5)
    heap_release_slice(held)
}

MemPoint :: struct { x: i64, y: i64 }

test "a struct element is one element rather than one byte" {
    mut held := heap_slice($MemPoint, 3)
    held[2] = MemPoint { x = 7, y = 8 }
    held[0] = MemPoint { x = 1, y = 2 }
    assert(held[2].x == 7)
    assert(held[2].y == 8)
    assert(held[0].x == 1)
    heap_release_slice(held)
}

test "bytes with a width are zeroed and copied" {
    source := heap_bytes(16)
    destination := heap_bytes(16)
    heap_zero(source, 16)
    mut written := bytes_as($i64, source, 2)
    written[1] = 42
    heap_copy(destination, source, 16)
    view := bytes_as($i64, destination, 2)
    assert(view[0] == 0)
    assert(view[1] == 42)
    // And one element in, which is where a column's second row starts.
    second := bytes_as($i64, bytes_at(destination, 8), 1)
    assert(second[0] == 42)
    heap_release(source)
    heap_release(destination)
}

test "a byte run keeps what it held when it grows" {
    mut block := heap_bytes(8)
    mut written := bytes_as($i64, block, 1)
    written[0] = 9
    block = heap_grow_bytes(block, 64)
    view := bytes_as($i64, block, 1)
    assert(view[0] == 9)
    heap_release(block)
}

test "what a block took is what releasing it gives back" {
    before := heap_live()
    mut held := heap_slice($i64, 16)
    assert(heap_live() == before + 1)
    held[0] = 1
    mut bigger := heap_grow_slice(held, 64)
    assert(heap_live() == before + 1)
    heap_release_slice(bigger)
    assert(heap_live() == before)
}

test "bytes with a width are counted the same way" {
    before := heap_live()
    block := heap_bytes(32)
    assert(heap_live() == before + 1)
    grown := heap_grow_bytes(block, 128)
    assert(heap_live() == before + 1)
    heap_release(grown)
    assert(heap_live() == before)
}
