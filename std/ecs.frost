// An archetype entity-component system.
//
// Entities that hold the same set of components live in one table, and a table
// keeps one contiguous column per component, so a system walks columns rather
// than chasing entities. That is the same shape `columns<T, N>` gives a fixed
// component set. This is the version where the set is decided while the
// program runs, which is what an editor and a save file need.
//
// What a component is: plain data. No destructor, no copy constructor, nothing
// a type knows that the compiler does not. That one fact removes the table of
// per-type function pointers an ECS in another language needs, because every
// operation a column performs is a move of `item_size` bytes: growing it,
// removing a row, carrying a row to another table. The registry holds a size
// per component and nothing else.
//
// A component is named by its index. A table's mask is the set of indices it
// holds, its columns are in ascending index order, and the column for a
// component is found by counting the bits below it, so nothing maps a component
// to a column at run time.
//
// The unsafe floor is the column: raw bytes with a width. Everything above it
// reaches an element through `column_of`, which hands out a bounds-checked
// `[]T`, and through generational handles that refuse a stale entity.

import "vec.frost"
import "map.frost"
import "mem.frost"
import "strings.frost"

// Saying which mistake was made needs the runtime, since a component named by a
// type nothing registered cannot be answered with a value.
frost_rt_error :: extern fn(text: ^i8)
frost_rt_die   :: safe extern fn()

export Entity, EntitySlot, Column, Registry, Table, World, Query, Tag,
    Commands, Change, Events, EventReader,
    ecs_new, ecs_free, ecs_register, ecs_component_size,
    ecs_component_by_name, ecs_component_name,
    ecs_spawn, ecs_spawn_with, ecs_despawn, ecs_alive, ecs_count,
    ecs_add, ecs_remove, ecs_has, ecs_get, ecs_set, ecs_slice,
    query_begin, query_next, query_column, query_entities,
    query_with,
    query_filter, query_row_passes, for_each, for_each_row, component_of,
    component_for,
    ecs_single, ecs_count_matching, ecs_gather, ecs_pairs, EntityPair,
    ecs_compact,
    Filters, no_filters, filter_without, filter_changed, filter_added,
    filter_tagged, filter_untagged, no_marks, marked,
    tag_new, tag_free, tag_release, tag_add, tag_remove, tag_has,
    Group, GroupSlot, Route, TagType, GROUP_MEMBERS,
    group_new, group_free, group_add_world, group_world_count,
    group_members,
    group_register, group_route, route_found, no_route,
    group_spawn, group_alive, group_count, group_despawn,
    group_despawn_entities,
    group_get, group_set, group_has, group_remove,
    group_tag_type, group_add_tag, group_remove_tag, group_has_tag,
    group_log_enable, group_log, group_log_clear,
    world_release, member_adopt, member_retire,
    commands_new, commands_free, commands_spawn, commands_despawn,
    commands_apply,
    ecs_tick, ecs_now, ecs_changed_since, ecs_added_since,
    ecs_mark_changed, ecs_mark_column,
    mask_of, ecs_spawn_bundle, ecs_remove_bundle, ecs_has_bundle,
    mask_without_mask,
    world_clear,
    query_changed, query_added,
    ecs_resource_register, ecs_resource, ecs_resource_ref, ecs_resource_set,
    ecs_resource_slice, resource_of,
    ecs_log_enable, ecs_log, ecs_log_clear,
    ChangeKind,
    events_new, events_free, events_send, events_sent, events_slice,
    events_clear, reader_new, events_read, events_since, events_pending,
    events_trim, readers_oldest,
    Hierarchy, hierarchy_new, hierarchy_free, hierarchy_attach,
    hierarchy_detach, hierarchy_parent, hierarchy_first_child,
    hierarchy_next_sibling, hierarchy_child_count, hierarchy_despawn_tree,
    no_entity, is_no_entity,
    System, Schedule, schedule_new, schedule_free, schedule_add,
    schedule_add_in_state, schedule_run, schedule_count,
    Stage, stage_order, ANY_STATE,
    States, states_new, states_request, states_apply, states_current,
    Time, time_new, time_advance,
    column_of, column_position, bits_below, bits_in,
    // What writing a world down needs to reach: a column's width, how a fresh
    // one is made and filled, and the archetype lookup a read rebuilds. The
    // format is std/snapshot.frost's, and the layout is this file's, so these
    // are the seam between them.
    TICK_SIZE, column_new, column_push_zero,
    mask_hash, mask_keys,
    Mask, MASK_WORDS, MAX_COMPONENTS,
    mask_empty, mask_with, mask_without, mask_has, mask_covers, mask_disjoint,
    mask_or, mask_equal, mask_is_empty


// A mask is a fixed run of 64-bit words, so a world holds this many component
// types. Four words rather than one integer, because 64 components is a number
// a real program passes and 256 is not.
MASK_WORDS :: 4
MAX_COMPONENTS :: 256

// ---------------------------------------------------------------------------
// Entities
//
// A handle is an id and a generation. The id indexes the slot table. The
// generation is bumped when the id is freed, so a handle kept past a despawn
// names a generation the slot no longer has and every lookup refuses it. This
// is the same rule `Handle<T>` follows for a pool, written out here because an
// entity is not stored in one place.
// ---------------------------------------------------------------------------

Entity :: struct {
    id: i64,
    generation: i64,
}

// Where an entity is and whether it is anywhere. `table` and `row` are its
// storage. A live entity with no components at all sits in the empty table, so
// there is always a row to name.
EntitySlot :: struct {
    generation: i64,
    alive: bool,
    table: i64,
    row: i64,
}

// ---------------------------------------------------------------------------
// Columns
//
// One component's storage for one table: `count` elements of `item_size` bytes,
// end to end. The type is not held anywhere, because nothing here needs it: a
// row moves as bytes and only `column_of` ever says what those bytes are.
// ---------------------------------------------------------------------------

Column :: struct {
    data: ^u8,
    // One tick per row, in step with the data: when the row was last written to,
    // and when the entity holding it was first given the component. These are
    // what a system asking "what moved since I last ran" reads, and they are
    // kept here rather than beside the table because they move exactly when the
    // rows do, which is the one thing a column already knows how to do.
    changed: ^u8,
    added: ^u8,
    count: i64,
    capacity: i64,
    item_size: i64,
}

// A tick is an i64. The columns holding them are the same bytes-with-a-width
// the data is, so growing and moving rows is the same code.
TICK_SIZE :: 8

column_new :: fn(item_size: i64) -> Column {
    Column {
        data = heap_bytes(item_size),
        changed = heap_bytes(TICK_SIZE),
        added = heap_bytes(TICK_SIZE),
        count = 0,
        capacity = 1,
        item_size = item_size,
    }
}

// A freed column keeps its pointers, which are no longer anyone's to read, and
// says so with a capacity of nothing: `column_of` hands out an empty slice, and
// `column_reserve` allocates fresh rather than growing a block that is gone.
// It used to allocate three replacement blocks here so a freed column could be
// reused, and every caller throws the column away, so those were leaked.
column_free :: fn(mut c: Column) {
    heap_release($u8, c.data)
    heap_release($u8, c.changed)
    heap_release($u8, c.added)
    c.count = 0
    c.capacity = 0
}

// Room for one more element, doubling when full. The pointer is written back
// here rather than in a helper, since a `mut` parameter carries the header and
// a helper would grow a copy of it.
column_reserve :: fn(mut c: Column) {
    if (c.count < c.capacity) {
        return
    }
    mut room := c.capacity * 2
    if (room < 1) {
        room = 1
    }
    // The three blocks are bytes with a width decided while the program runs,
    // so they are counted in bytes rather than in elements of a type. A column
    // with no capacity has no block to grow: either it was never given one or
    // it was freed, and growing what was freed is not a thing to attempt.
    if (c.capacity == 0) {
        c.data = heap_bytes(room * c.item_size)
        c.changed = heap_bytes(room * TICK_SIZE)
        c.added = heap_bytes(room * TICK_SIZE)
    } else {
        c.data = heap_grow_bytes(c.data, room * c.item_size)
        c.changed = heap_grow_bytes(c.changed, room * TICK_SIZE)
        c.added = heap_grow_bytes(c.added, room * TICK_SIZE)
    }
    c.capacity = room
}

// The two tick arrays as slices, which is how everything above reads them.
column_changed :: fn(c: Column) -> []i64 {
    bytes_as($i64, c.changed, c.count)
}

column_added :: fn(c: Column) -> []i64 {
    bytes_as($i64, c.added, c.count)
}

// The address of one element. The one place that turns an index into a pointer,
// so the arithmetic is written once.
column_at :: fn(c: Column, index: i64) -> ^u8 {
    bytes_at(c.data, index * c.item_size)
}

// A row of zeroes, which is what a component the caller has not written yet
// holds. Plain data has no other sensible default and no constructor to run.
column_push_zero :: fn(mut c: Column, tick: i64) {
    column_reserve(c)
    heap_zero(column_at(c, c.count), c.item_size)
    c.count = c.count + 1
    mut changed := column_changed(c)
    mut added := column_added(c)
    changed[c.count - 1] = tick
    added[c.count - 1] = tick
}

// Remove a row by moving the last one into its place, which is what keeps a
// column contiguous without moving everything after it. The caller is what
// knows which entity moved, so patching its slot is the caller's.
column_swap_remove :: fn(mut c: Column, index: i64) {
    last := c.count - 1
    if (index != last) {
        heap_copy(column_at(c, index), column_at(c, last), c.item_size)
        mut changed := column_changed(c)
        mut added := column_added(c)
        changed[index] = changed[last]
        added[index] = added[last]
    }
    c.count = last
}

// Carry one row to another column, which is a table migration's whole job.
column_move_row :: fn(mut to: Column, from: Column, index: i64) {
    column_reserve(to)
    heap_copy(column_at(to, to.count), column_at(from, index), from.item_size)
    to.count = to.count + 1
    // A row carries its history to the table it moves to. A migration is not a
    // write to the component, so a system watching for changes does not see one
    // where an entity merely gained a different component.
    mut to_changed := column_changed(to)
    mut to_added := column_added(to)
    from_changed := column_changed(from)
    from_added := column_added(from)
    to_changed[to.count - 1] = from_changed[index]
    to_added[to.count - 1] = from_added[index]
}

// The typed view of a column, and the end of the erasure. Everything above this
// reads and writes through a bounds-checked slice.
column_of :: fn($T: Type, c: Column) -> []T {
    bytes_as($T, c.data, c.count)
}

// ---------------------------------------------------------------------------
// The registry
//
// A component is a bit and a width. Bits are handed out in registration order,
// so a program that registers in one place, once, has a stable schema, which is
// what a save file needs.
// ---------------------------------------------------------------------------

// A width per registered component, grown as they register, and the type each
// one was registered for. A fixed array of MAX_COMPONENTS would put two
// kilobytes inside every World, almost all of it unused, and a World is an
// ordinary local.
//
// `types` is what lets a query name a component by writing its type. A
// component's index is decided while the program runs, by the order things
// register, so nothing about the type says what it is. `type_id` is the number
// the compiler already has for a type, and this is the table that turns one
// into the other.
Registry :: struct {
    count: i64,
    sizes: Vec<i64>,
    types: Vec<i64>,
    // What each component is called, so a thing that reads a name off a file or
    // shows one to a person has something to turn into an index. The compiler
    // knows the name and hands it over at the registration, which is the one
    // place the type is still written down.
    names: Vec<str>,
}

// A set of components, as one bit per registered index. Four words wide, which
// is a fixed size, so a mask is copied and compared without allocating and a
// table's test against a query is a loop of four.
Mask :: struct {
    words: [MASK_WORDS]u64,
}

mask_empty :: fn() -> Mask {
    Mask { words = [0; MASK_WORDS] }
}

// The word a component's bit lives in, and the bit within it. Both are
// divisions by a power of two, so both are a shift.
mask_word :: fn(index: i64) -> i64 {
    index / 64
}

mask_bit :: fn(index: i64) -> u64 {
    one : u64 = 1
    one << (index % 64)
}

mask_with :: fn(m: Mask, index: i64) -> Mask {
    mut out := m
    word := mask_word(index)
    out.words[word] = out.words[word] | mask_bit(index)
    out
}

mask_without :: fn(m: Mask, index: i64) -> Mask {
    mut out := m
    word := mask_word(index)
    // No bitwise complement in the language, so the bit is cleared by taking
    // the word apart around it: what is above it, plus what is below it.
    held := out.words[word]
    bit := mask_bit(index)
    if ((held & bit) != 0) {
        out.words[word] = held - bit
    }
    out
}

mask_has :: fn(m: Mask, index: i64) -> bool {
    (m.words[mask_word(index)] & mask_bit(index)) != 0
}

mask_or :: fn(a: Mask, b: Mask) -> Mask {
    mut out := a
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        out.words[i] = out.words[i] | b.words[i]
        i = i + 1
    }
    out
}

// Every bit of `wanted` is on in `held`. This runs once per table per query, so
// it is a straight loop over the words with nothing allocated and no call per
// word.
mask_covers :: fn(held: Mask, wanted: Mask) -> bool {
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        if ((held.words[i] & wanted.words[i]) != wanted.words[i]) {
            return false
        }
        i = i + 1
    }
    true
}

// No bit of `excluded` is on in `held`, which is what a `without` filter asks
// of a whole table before any row is touched.
mask_disjoint :: fn(held: Mask, excluded: Mask) -> bool {
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        if ((held.words[i] & excluded.words[i]) != 0) {
            return false
        }
        i = i + 1
    }
    true
}

// Every bit of `b` cleared from `a`, which is what a whole bundle leaving an
// entity takes off at once.
mask_without_mask :: fn(held: Mask, unwanted: Mask) -> Mask {
    mut out := held
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        // No bitwise complement in the language, and none is needed: the bits
        // in common are all present in the word they are taken from, so the
        // subtraction never borrows and clears exactly them.
        out.words[i] = out.words[i] - (out.words[i] & unwanted.words[i])
        i = i + 1
    }
    out
}

mask_equal :: fn(a: Mask, b: Mask) -> bool {
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        if (a.words[i] != b.words[i]) {
            return false
        }
        i = i + 1
    }
    true
}

mask_is_empty :: fn(m: Mask) -> bool {
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        if (m.words[i] != 0) {
            return false
        }
        i = i + 1
    }
    true
}

// How many bits are set below this index, which is a column's position in a
// table whose columns are in ascending index order.
bits_below :: fn(m: Mask, index: i64) -> i64 {
    word := mask_word(index)
    mut counted : i64 = 0
    mut i : i64 = 0
    while (i < word) {
        counted = counted + bits_in(m.words[i])
        i = i + 1
    }
    counted + bits_in(m.words[word] & (mask_bit(index) - 1))
}

// The population count of one word, by clearing the lowest set bit until there
// is none left, so the loop runs once per bit that is set rather than 64 times.
bits_in :: fn(held: u64) -> i64 {
    mut rest := held
    mut counted : i64 = 0
    while (rest != 0) {
        rest = rest & (rest - 1)
        counted = counted + 1
    }
    counted
}

column_position :: fn(table_mask: Mask, component: i64) -> i64 {
    bits_below(table_mask, component)
}

// ---------------------------------------------------------------------------
// Tables
//
// One archetype: the entities holding exactly this set of components, and one
// column per bit of the mask in ascending order.
// ---------------------------------------------------------------------------

Table :: struct {
    mask: Mask,
    entities: Vec<Entity>,
    columns: Vec<Column>,
}

// ---------------------------------------------------------------------------
// The mask table
//
// Mask to table index, which is the standard library's map under a `Hashing`
// bundle over the mask. The world kept its own open-addressed pair of runs while
// a generic taking a bundle could not be compiled beside one taking two type
// parameters; it can, so this is one table rather than two.
// ---------------------------------------------------------------------------

// A whole mask mixed into one number, so a key that differs only in its fourth
// word still lands somewhere else.
mask_hash :: fn(m: Mask) -> i64 {
    mut h : i64 = 0
    mut i : i64 = 0
    while (i < MASK_WORDS) {
        h = wrap_add(wrap_mul(h, 1099511628211), m.words[i])
        i = i + 1
    }
    h
}

mask_keys :: Hashing<Mask> { hash = mask_hash, equal = mask_equal }

// ---------------------------------------------------------------------------
// The world
// ---------------------------------------------------------------------------

// The four structural changes a world records. A component write is not one:
// that is what the per-row ticks are for.
ChangeKind :: enum { Spawn, Despawn, Add, Remove }

Change :: struct {
    kind: ChangeKind,
    entity: Entity,
    // The component the change was about, or -1 for a spawn or a despawn.
    component: i64,
    tick: i64,
}

World :: struct {
    registry: Registry,
    slots: Vec<EntitySlot>,
    free_ids: Vec<i64>,
    next_id: i64,
    tables: Vec<Table>,
    // Mask to table index, so a migration finds its destination without a scan.
    lookup: Map<Mask, i64>,
    live: i64,
    // The clock every write is stamped with. It starts at one so that zero,
    // which is what a freshly allocated row holds, is a time before anything.
    tick: i64,
    // A resource is a component with one row and no entity: a column of one.
    resources: Vec<Column>,
    // What type each of those columns holds, so a resource is reached by the
    // type it is rather than by where it happens to sit. Kept beside the
    // columns rather than inside them, because a column is bytes and a width
    // and knows nothing about what it holds.
    resource_types: Vec<i64>,
    // What changed structurally, for a program that has to hear about it: a
    // save file writing a delta, an editor keeping a list in step. Off by
    // default, since a world nobody asks pays nothing for it.
    log: Vec<Change>,
    logging: bool,
}

ecs_new :: fn() -> World {
    mut world := World {
        registry = Registry { count = 0, sizes = vec_new($i64, 16),
            types = vec_new($i64, 16), names = vec_new($str, 16) },
        slots = vec_new($EntitySlot, 64),
        free_ids = vec_new($i64, 64),
        next_id = 0,
        tables = vec_new($Table, 16),
        lookup = map_new($Mask, $i64, 32),
        live = 0,
        tick = 1,
        resources = vec_new($Column, 4),
        resource_types = vec_new($i64, 4),
        log = vec_new($Change, 16),
        logging = false,
    }
    // Table zero is the empty archetype, where an entity with no components
    // lives. Having it always exist means a spawn never has to make a table.
    vec_push(
        $Table,
        world.tables,
        Table { mask = mask_empty(), entities = vec_new($Entity, 16),
            columns = vec_new($Column, 1) },
    )
    map_put($Mask, $i64, $mask_keys, world.lookup, mask_empty(), 0)
    world
}

// Everything a world allocated, released in place. The consuming form below is
// what a program calls; this one is what a group calls, because a member is
// reached through the group's storage and cannot be moved out of it.
world_release :: fn(mut world: World) {
    mut t : i64 = 0
    while (t < vec_len($Table, world.tables)) {
        ref table := vec_slice($Table, world.tables)[t]
        table_release(table)
        t = t + 1
    }
    mut r : i64 = 0
    while (r < vec_len($Column, world.resources)) {
        ref resource := vec_slice($Column, world.resources)[r]
        column_free(resource)
        r = r + 1
    }
    vec_free($Column, world.resources)
    vec_free($i64, world.resource_types)
    vec_free($Change, world.log)
    vec_free($Table, world.tables)
    vec_free($EntitySlot, world.slots)
    vec_free($i64, world.free_ids)
    vec_free($i64, world.registry.sizes)
    vec_free($i64, world.registry.types)
    vec_free($str, world.registry.names)
    map_free($Mask, $i64, world.lookup)
}

ecs_free :: fn(move world: World) {
    world_release(world)
}

// ---------------------------------------------------------------------------
// The clock
//
// Every component write is stamped with the world's tick, and a system that
// wants to see only what moved compares against the tick it last ran at. The
// world does not advance the clock on its own: a frame does, once, so that
// everything written during it shares one time.
// ---------------------------------------------------------------------------

ecs_tick :: fn(mut world: World) -> i64 {
    world.tick = world.tick + 1
    world.tick
}

ecs_now :: fn(world: World) -> i64 {
    world.tick
}

// Record a structural change, when the world was asked to keep them.
note_change :: fn(mut world: World, kind: ChangeKind, entity: Entity,
    component: i64) {
    if (world.logging == false) {
        return
    }
    vec_push($Change, world.log,
        Change { kind = kind, entity = Entity { id = entity.id,
            generation = entity.generation }, component = component,
            tick = world.tick })
}

ecs_log_enable :: fn(mut world: World, on: bool) {
    world.logging = on
}

ecs_log :: fn(world: World) -> []Change {
    vec_slice($Change, world.log)
}

ecs_log_clear :: fn(mut world: World) {
    vec_clear($Change, world.log)
}

// Register a component and answer its index, which is what every call naming
// that component is given. The width comes from the type, which is the only
// thing about it this has to know.
//
// Each call hands out a fresh index, so registering a type twice gives two of
// them and `component_of` answers with the first. An index is a slot the
// registry hands out and a type is what the slot was cut for; the ceiling is
// counted in slots, which is why `MAX_COMPONENTS` is a count of these rather
// than a count of types. A resource is keyed the other way round, by the type
// it holds, because two pieces of a program each needing the same resource have
// to reach the same one and a resource has no index a program passes around.
ecs_register :: fn($T: Type, mut world: World) -> i64 {
    index := world.registry.count
    // Past the ceiling there is no index to give, so a program that registers
    // too many finds out at its next call rather than writing over a component
    // that already exists.
    if (index >= MAX_COMPONENTS) {
        return -1
    }
    vec_push($i64, world.registry.sizes, sizeof(T))
    vec_push($i64, world.registry.types, type_id(T))
    vec_push($str, world.registry.names, typename(T))
    world.registry.count = index + 1
    index
}

// Where a type id sits in the registry, or -1. The scan `component_of` and
// `ecs_register` both do, written once so the two cannot come to disagree about
// which index a type has.
registered_index :: fn(wanted: i64, world: World) -> i64 {
    known := vec_slice($i64, world.registry.types)
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (known[index] == wanted) {
            return index
        }
        index = index + 1
    }
    -1
}

// The index a name stands for, or -1. What an editor listing components and a
// save file naming them both need, and the reverse of `ecs_component_name`.
ecs_component_by_name :: fn(world: World, wanted: str) -> i64 {
    known := vec_slice($str, world.registry.names)
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (str_eq(known[index], wanted)) {
            return index
        }
        index = index + 1
    }
    -1
}

// What a component is called, by the index it was given.
ecs_component_name :: fn(world: World, component: i64) -> str {
    if (component < 0 || component >= world.registry.count) {
        return ""
    }
    vec_slice($str, world.registry.names)[component]
}

// The component a type was registered as, which is what lets a query be written
// with the types it reads rather than with the indices they were given. A
// program registers a handful of components and asks this once per table per
// query, so the walk is over a short run of integers and touches nothing else.
//
// A type nothing registered is a query for a component that does not exist,
// which would otherwise be a mask bit nothing sets and a query that silently
// matches nothing.
component_of :: fn($T: Type, world: World) -> i64 {
    held := registered_index(type_id(T), world)
    if (held >= 0) {
        return held
    }
    // A type nothing registered would otherwise be a mask bit nothing sets, so
    // the query would match nothing and say nothing about why.
    unsafe { frost_rt_error("frost: a query names an unregistered component\n") }
    frost_rt_die()
    -1
}

// The component a type has, cut if it does not have one yet. What a piece of a
// program calls when it needs a component to exist and does not know whether
// something else needed it first: two of them asking get the same index, where
// two of them registering get two.
//
// `ecs_register` is the other half and means something narrower: cut a slot.
// The ceiling is counted in slots, so filling a registry is registering, and
// declaring what you need is this.
component_for :: fn($T: Type, mut world: World) -> i64 {
    held := registered_index(type_id(T), world)
    if (held >= 0) {
        return held
    }
    ecs_register($T, world)
}

// The width a component was registered with.
ecs_component_size :: fn(world: World, component: i64) -> i64 {
    if (component < 0 || component >= world.registry.count) {
        return 0
    }
    vec_slice($i64, world.registry.sizes)[component]
}

// The table for a mask, made if this is the first entity to want it. Its
// columns are created in ascending bit order, which is the order every lookup
// assumes.
table_for :: fn(mut world: World, mask: Mask) -> i64 {
    held := map_get($Mask, $i64, $mask_keys, world.lookup, mask, -1)
    if (held >= 0) {
        return held
    }
    mut table := Table { mask = mask, entities = vec_new($Entity, 8),
        columns = vec_new($Column, 4) }
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (mask_has(mask, index)) {
            vec_push($Column, table.columns,
                column_new(vec_slice($i64, world.registry.sizes)[index]))
        }
        index = index + 1
    }
    made := vec_len($Table, world.tables)
    vec_push($Table, world.tables, table)
    map_put($Mask, $i64, $mask_keys, world.lookup, mask, made)
    made
}

// ---------------------------------------------------------------------------
// Spawning and despawning
// ---------------------------------------------------------------------------

ecs_spawn :: fn(mut world: World) -> Entity {
    mut id : i64 = 0
    mut generation : i64 = 0
    free_count := vec_len($i64, world.free_ids)
    if (free_count > 0) {
        id = vec_get($i64, world.free_ids, free_count - 1)
        world.free_ids.len = free_count - 1
        generation = vec_slice($EntitySlot, world.slots)[id].generation
    } else {
        id = world.next_id
        world.next_id = id + 1
        vec_push($EntitySlot, world.slots,
            EntitySlot { generation = 0, alive = false, table = 0, row = 0 })
    }
    // Every live entity has a row, so an entity with no components sits in the
    // empty table and a component added later is a migration like any other.
    ref empty := vec_slice($Table, world.tables)[0]
    row := vec_len($Entity, empty.entities)
    vec_push($Entity, empty.entities,
        Entity { id = id, generation = generation })
    ref slot := vec_slice($EntitySlot, world.slots)[id]
    slot.generation = generation
    slot.alive = true
    slot.table = 0
    slot.row = row
    world.live = world.live + 1
    made := Entity { id = id, generation = generation }
    note_change(world, ChangeKind::Spawn, made, -1)
    made
}

// An entity that starts out holding a set of components, placed in that
// archetype rather than walked into it.
//
// Reaching the same place through `ecs_add` costs one migration per component,
// and a migration copies every column the entity already has, so building a row
// of n components moves on the order of n squared bytes to land somewhere the
// table lookup could have named outright. This asks for the destination.
//
// The components are zeroed and marked added at the current tick, exactly as a
// migration leaves one it had no value for, so `ecs_set` afterwards writes into
// a column that is already there and nothing migrates.
ecs_spawn_with :: fn(mut world: World, mask: Mask) -> Entity {
    made := ecs_spawn(world)
    if (mask_is_empty(mask)) {
        return made
    }
    migrate(world, made, mask)
    // Every component of a fresh row was added now. `migrate` already says so
    // for the ones it zeroed, and it zeroes all of them here, since the entity
    // came from the empty table holding nothing.
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (mask_has(mask, index)) {
            note_change(world, ChangeKind::Add, made, index)
        }
        index = index + 1
    }
    made
}

// Whether a handle names the entity that holds its id now, rather than one that
// held it before.
ecs_alive :: fn(world: World, entity: Entity) -> bool {
    if (entity.id < 0 || entity.id >= vec_len($EntitySlot, world.slots)) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    slot.alive && slot.generation == entity.generation
}

ecs_count :: fn(world: World) -> i64 {
    world.live
}

// Take a row out of a table, moving the last row into its place and telling
// whichever entity was moved where it went.
table_swap_remove :: fn(mut world: World, table_index: i64, row: i64) {
    ref table := vec_slice($Table, world.tables)[table_index]
    last := vec_len($Entity, table.entities) - 1
    // Which entity moves is read before the move, since handing the value to
    // the write is what gives it away.
    moved_id := vec_slice($Entity, table.entities)[last].id
    if (row != last) {
        vec_slice($Entity, table.entities)[row] =
            vec_slice($Entity, table.entities)[last]
    }
    table.entities.len = last
    mut c : i64 = 0
    while (c < vec_len($Column, table.columns)) {
        ref column := vec_slice($Column, table.columns)[c]
        column_swap_remove(column, row)
        c = c + 1
    }
    if (row != last) {
        ref slot := vec_slice($EntitySlot, world.slots)[moved_id]
        slot.row = row
    }
}

ecs_despawn :: fn(mut world: World, entity: Entity) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    table_index := slot.table
    row := slot.row
    table_swap_remove(world, table_index, row)
    ref held := vec_slice($EntitySlot, world.slots)[entity.id]
    held.alive = false
    // The next handle for this id is a different one, which is what makes the
    // one just freed refuse every lookup from here on.
    held.generation = held.generation + 1
    vec_push($i64, world.free_ids, entity.id)
    world.live = world.live - 1
    note_change(world, ChangeKind::Despawn, entity, -1)
}

// ---------------------------------------------------------------------------
// Components
//
// Adding or removing one moves the entity to the table for its new set, which
// is one row of bytes per shared column and nothing else.
// ---------------------------------------------------------------------------

// Move an entity to the table for `target_mask`, carrying every column the two
// tables share. Answers the row it landed on.
migrate :: fn(mut world: World, entity: Entity, target_mask: Mask) -> i64 {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    from_index := slot.table
    row := slot.row
    to_index := table_for(world, target_mask)
    if (from_index == to_index) {
        return row
    }
    from_mask := vec_slice($Table, world.tables)[from_index].mask
    // The destination row is the same for every column, since a table's columns
    // are the same length.
    landed := vec_len($Entity, vec_slice($Table, world.tables)[to_index].entities)
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (mask_has(target_mask, index)) {
            to_position := column_position(target_mask, index)
            if (mask_has(from_mask, index)) {
                from_position := column_position(from_mask, index)
                held := vec_slice($Column,
                    vec_slice($Table, world.tables)[from_index].columns)[from_position]
                ref to_column := vec_slice($Column,
                    vec_slice($Table, world.tables)[to_index].columns)[to_position]
                column_move_row(to_column, held, row)
            } else {
                ref to_column := vec_slice($Column,
                    vec_slice($Table, world.tables)[to_index].columns)[to_position]
                column_push_zero(to_column, world.tick)
            }
        }
        index = index + 1
    }
    ref to_table := vec_slice($Table, world.tables)[to_index]
    // A fresh handle rather than the parameter: the push takes what it is given,
    // and the slot still has to be told where the entity landed.
    vec_push($Entity, to_table.entities,
        Entity { id = entity.id, generation = entity.generation })
    table_swap_remove(world, from_index, row)
    ref slot_again := vec_slice($EntitySlot, world.slots)[entity.id]
    slot_again.table = to_index
    slot_again.row = landed
    landed
}

ecs_has :: fn(world: World, entity: Entity, component: i64) -> bool {
    if (ecs_alive(world, entity) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    mask_has(table.mask, component)
}

// Give an entity a component, or overwrite the one it has.
ecs_add :: fn($T: Type, mut world: World, entity: Entity, component: i64,
    value: $T) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    current := vec_slice($Table, world.tables)[slot.table].mask
    if (mask_has(current, component) == false) {
        migrate(world, entity, mask_with(current, component))
        note_change(world, ChangeKind::Add, entity, component)
    }
    ecs_set($T, world, entity, component, value)
    // A component the entity has just been given was added now, whatever the
    // row it landed on held before.
    ref placed := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[placed.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    mut added := column_added(column)
    added[placed.row] = world.tick
}

ecs_remove :: fn(mut world: World, entity: Entity, component: i64) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    current := vec_slice($Table, world.tables)[slot.table].mask
    if (mask_has(current, component) == false) {
        return
    }
    migrate(world, entity, mask_without(current, component))
    note_change(world, ChangeKind::Remove, entity, component)
}

// The component an entity holds, by value. A component is plain data, so a copy
// is the whole of it. `ecs_slice` is how a system reaches one to write.
ecs_get :: fn($T: Type, world: World, entity: Entity, component: i64) -> $T {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_of($T, column)[slot.row]
}

ecs_set :: fn($T: Type, mut world: World, entity: Entity, component: i64,
    value: $T) {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    mut items := column_of($T, column)
    items[slot.row] = value
    mut changed := column_changed(column)
    changed[slot.row] = world.tick
}

// One table's column as a slice, which is what a system writes through.
ecs_slice :: fn($T: Type, world: World, table_index: i64,
    component: i64) -> []T {
    ref table := vec_slice($Table, world.tables)[table_index]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_of($T, column)
}

// ---------------------------------------------------------------------------
// Queries
//
// A query is a cursor over the tables holding a set of components. The body
// runs per table with the columns as slices, so the inner loop is over
// contiguous memory and the language checks every index.
//
//     mut q := query_begin(world)
//     query_with(q, POSITION)
//     query_with(q, VELOCITY)
//     while (query_next(world, q)) {
//         mut p := query_column($Position, world, q, POSITION)
//         v := query_column($Velocity, world, q, VELOCITY)
//         mut i : i64 = 0
//         while (i < q.count) {
//             p[i].x = p[i].x + v[i].x
//             i = i + 1
//         }
//     }
//
// Written this way a query has no arity limit and needs nothing captured: the
// body is where it is written, so the resources it reads are the enclosing
// function's locals. `for_each` is the same walk with the
// body handed in, for a system short enough that the cursor is the longer half.
// ---------------------------------------------------------------------------

Query :: struct {
    // The components a table must hold to be visited, and the ones it must not.
    // Both are answered once per table, before a row is touched.
    wanted: Mask,
    excluded: Mask,
    // The components whose row-level ticks decide whether a row is visited, and
    // the tick they are compared against.
    changed: Mask,
    added: Mask,
    since: i64,
    // The marks a row is tested against, one set it must be in and one it must
    // not. A tag costs no mask bit, so neither can be answered per table the
    // way a component can, and both are read per row.
    tagged: []i64,
    untagged: []i64,
    // Where the walk is, and where it stopped.
    next_table: i64,
    table: i64,
    count: i64,
}

query_begin :: fn(world: World) -> Query {
    Query { wanted = mask_empty(), excluded = mask_empty(),
        changed = mask_empty(), added = mask_empty(), since = 0,
        tagged = no_marks(), untagged = no_marks(),
        next_table = 0, table = -1, count = 0 }
}

// ---------------------------------------------------------------------------
// Filters
//
// What a query asks for beyond the components its body reads. Two of these are
// table-level and cost nothing per row: a table without every wanted component,
// or with an excluded one, is skipped before any of its rows is touched. The
// other two are row-level and read the tick arrays a column already carries.
// The distinction is the point of archetype storage, so it is visible in which
// function a filter goes through rather than left to a comment.
//
// A tag is row-level and cannot be otherwise. It holds no mask bit on purpose,
// so a table cannot say whether any of its rows carries one and every row is
// asked. That is what a tag trades a mask bit for.
// ---------------------------------------------------------------------------

Filters :: struct {
    // Table level: an entity holding any of these is not visited at all.
    excluded: Mask,
    // Row level: the row's tick for one of these has to be newer than `since`.
    changed: Mask,
    added: Mask,
    since: i64,
    // Row level: the marks a row must carry, and the ones it must not. A tag is
    // not a component and holds no mask bit, so a table cannot answer for it
    // and every row is asked.
    //
    // The marks rather than the tag, because a borrow cannot be stored and a
    // slice is a value. What that costs has to be said plainly: the slice is
    // the storage the tag held when the filter was built, and `tag_add` grows
    // that storage by reallocating it. A filter outliving a `tag_add` that
    // grew the marks points at freed memory, which is a read of whatever the
    // allocator did next rather than a stale answer.
    //
    // So a filter is built after the tagging it asks about and thrown away
    // before the next. Nothing else here may be mutated mid-walk either, which
    // is what the command queue is for, and this is the same rule.
    tagged: []i64,
    untagged: []i64,
}

no_filters :: fn() -> Filters {
    Filters { excluded = mask_empty(), changed = mask_empty(),
        added = mask_empty(), since = 0,
        tagged = no_marks(), untagged = no_marks() }
}

// An empty run of marks, which is what a filter asking about no tag holds and
// what every row passes.
no_marks :: fn() -> []i64 {
    unsafe { slice_from($i64, ptr_cast($i64, 0), 0) }
}

// A component an entity must not have. Matched against the table's mask, so a
// whole archetype is skipped and no row is read.
filter_without :: fn(f: Filters, component: i64) -> Filters {
    mut out := f
    out.excluded = mask_with(out.excluded, component)
    out
}

// Only rows whose tick for this component is newer than `since`, which is what
// a system passes as the tick it last ran at. This is a row-level test: the
// table still has to be walked, and what it saves is the body.
filter_changed :: fn(f: Filters, component: i64, since: i64) -> Filters {
    mut out := f
    out.changed = mask_with(out.changed, component)
    out.since = since
    out
}

// The same for a component the entity was given since `since`, which is a
// different question from having written it.
filter_added :: fn(f: Filters, component: i64, since: i64) -> Filters {
    mut out := f
    out.added = mask_with(out.added, component)
    out.since = since
    out
}

query_filter :: fn(mut q: Query, f: Filters) {
    q.excluded = f.excluded
    q.changed = f.changed
    q.added = f.added
    q.since = f.since
    q.tagged = f.tagged
    q.untagged = f.untagged
}

// Only rows carrying the tag, and only rows not carrying it. Both read the
// marks out of the tag rather than keeping the tag, which is what lets a filter
// be a value the walk carries.
filter_tagged :: fn(f: Filters, t: Tag) -> Filters {
    mut out := f
    out.tagged = vec_slice($i64, t.marks)
    out
}

filter_untagged :: fn(f: Filters, t: Tag) -> Filters {
    mut out := f
    out.untagged = vec_slice($i64, t.marks)
    out
}

// Whether an entity is marked in a run of marks. Past the end is unmarked: a
// tag that has never been given to an id has no room recorded for it.
marked :: fn(marks: []i64, entity: Entity) -> bool {
    if (entity.id >= slice_len(marks)) {
        return false
    }
    marks[entity.id] == entity.generation + 1
}

// Whether one row of the table the cursor is on passes the row-level filters.
// Nothing is read when none were asked for, which is the common case.
query_row_passes :: fn(world: World, q: Query, row: i64) -> bool {
    if (slice_len(q.tagged) > 0 || slice_len(q.untagged) > 0) {
        ref rows := vec_slice($Table, world.tables)[q.table]
        entity := vec_slice($Entity, rows.entities)[row]
        if (slice_len(q.tagged) > 0 && marked(q.tagged, entity) == false) {
            return false
        }
        if (slice_len(q.untagged) > 0 && marked(q.untagged, entity)) {
            return false
        }
    }
    if (mask_is_empty(q.changed) && mask_is_empty(q.added)) {
        return true
    }
    ref table := vec_slice($Table, world.tables)[q.table]
    mut component : i64 = 0
    while (component < world.registry.count) {
        if (mask_has(q.changed, component)) {
            position := column_position(table.mask, component)
            ref column := vec_slice($Column, table.columns)[position]
            if (column_changed(column)[row] <= q.since) {
                return false
            }
        }
        if (mask_has(q.added, component)) {
            position := column_position(table.mask, component)
            ref column := vec_slice($Column, table.columns)[position]
            if (column_added(column)[row] <= q.since) {
                return false
            }
        }
        component = component + 1
    }
    true
}

// A component the body reads. This is a table-level test: a table without it is
// skipped before any of its rows is touched.
query_with :: fn(mut q: Query, component: i64) {
    q.wanted = mask_with(q.wanted, component)
}

// Step to the next table holding every component the query asks for, answering
// false when there are none left. A table with no rows is skipped rather than
// handed over, so a body never runs on nothing.
query_next :: fn(world: World, mut q: Query) -> bool {
    mut index := q.next_table
    total := vec_len($Table, world.tables)
    while (index < total) {
        ref table := vec_slice($Table, world.tables)[index]
        rows := vec_len($Entity, table.entities)
        if (mask_covers(table.mask, q.wanted)
            && mask_disjoint(table.mask, q.excluded) && rows > 0) {
            q.table = index
            q.count = rows
            q.next_table = index + 1
            return true
        }
        index = index + 1
    }
    q.next_table = total
    q.table = -1
    q.count = 0
    false
}

query_column :: fn($T: Type, world: World, q: Query,
    component: i64) -> []T {
    ecs_slice($T, world, q.table, component)
}

// The entities of the table the cursor is on, for a body that needs the handle
// beside the components.
query_entities :: fn(world: World, q: Query) -> []Entity {
    ref table := vec_slice($Table, world.tables)[q.table]
    vec_slice($Entity, table.entities)
}

// The write times of the table's rows for one component, beside the components
// themselves, so a body can skip the rows nothing touched:
//
//     mut q := query_begin(world)
//     query_with(q, TRANSFORM)
//     while (query_next(world, q)) {
//         t := query_column($Transform, world, q, TRANSFORM)
//         stamps := query_changed(world, q, TRANSFORM)
//         mut i : i64 = 0
//         while (i < q.count) {
//             if (stamps[i] > last_run) { upload(t[i]) }
//             i = i + 1
//         }
//     }
//
// This is change detection without a filter type: the ticks are data, so the
// test is written where the decision is, and a body that wants both the changed
// and the unchanged rows has them.
query_changed :: fn(world: World, q: Query, component: i64) -> []i64 {
    ref table := vec_slice($Table, world.tables)[q.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_changed(column)
}

query_added :: fn(world: World, q: Query, component: i64) -> []i64 {
    ref table := vec_slice($Table, world.tables)[q.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_added(column)
}

// The same question about one entity, for code holding a handle rather than
// walking a table.
ecs_changed_since :: fn(world: World, entity: Entity, component: i64,
    since: i64) -> bool {
    if (ecs_has(world, entity, component) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_changed(column)[slot.row] > since
}

ecs_added_since :: fn(world: World, entity: Entity, component: i64,
    since: i64) -> bool {
    if (ecs_has(world, entity, component) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    column_added(column)[slot.row] > since
}

// ---------------------------------------------------------------------------
// Resources
//
// A resource is a value the whole world shares: the renderer's device, the
// input state, the frame's time. It is a component with one row and no entity,
// which is exactly a column of one, so it is stored the way everything else is
// and reached through the same typed slice.
// ---------------------------------------------------------------------------

// Register a resource and answer the slot it was given.
//
// Registering a type that is already registered answers the slot it already
// has, the way `ecs_register` does for a component. That is what lets two
// pieces of a program each declare they need the same resource: whichever runs
// second finds the one already there instead of laying a second column over it
// and leaving half the program writing into a value the other half never reads.
ecs_resource_register :: fn($T: Type, mut world: World) -> i64 {
    held := resource_index(type_id(T), world)
    if (held >= 0) {
        return held
    }
    slot := vec_len($Column, world.resources)
    mut column := column_new(sizeof(T))
    column_push_zero(column, world.tick)
    vec_push($Column, world.resources, column)
    vec_push($i64, world.resource_types, type_id(T))
    slot
}

// Where a type id sits among the resources, or -1.
resource_index :: fn(wanted: i64, world: World) -> i64 {
    known := vec_slice($i64, world.resource_types)
    mut slot : i64 = 0
    while (slot < vec_len($i64, world.resource_types)) {
        if (known[slot] == wanted) {
            return slot
        }
        slot = slot + 1
    }
    -1
}

// The slot a resource type was registered in, which is what lets a system reach
// a resource by the type it spells rather than by a number it was told. A world
// holds a handful of resources, so the walk is over a short run of integers.
//
// A type nothing registered stops here. Answering a number anyway would hand
// back whichever resource happens to sit at that slot, and reading a `Camera`
// as an `Input` is a wrong answer rather than a failure.
resource_of :: fn($T: Type, world: World) -> i64 {
    held := resource_index(type_id(T), world)
    if (held >= 0) {
        return held
    }
    unsafe { frost_rt_error("frost: a resource is named that nothing registered\n") }
    frost_rt_die()
    -1
}

// The one row, as a slice, which is how a resource is written in place.
ecs_resource_slice :: fn($T: Type, world: World, slot: i64) -> []T {
    ref column := vec_slice($Column, world.resources)[slot]
    column_of($T, column)
}

ecs_resource :: fn($T: Type, world: World, slot: i64) -> $T {
    ecs_resource_slice($T, world, slot)[0]
}

// The resource where it lives, rather than a copy of it. A resource holding a
// linear value cannot be read by the one above: what comes back owns what it
// holds, so a system that only wanted to look at it is left holding a second
// `Vec` to free. A borrow reads it in place and owns nothing, which is what a
// system asking about the world wants and the only way to reach a resource
// that holds a resource.
//
//     ref held := ecs_resource_ref($Tree, world, slot)
//     print hierarchy_child_count(held.tree, parent)
ecs_resource_ref :: fn($T: Type, world: World, slot: i64) -> ref T {
    held := ecs_resource_slice($T, world, slot)
    ref result := held[0]
    result
}

test "a resource that holds a resource is read where it lives" {
    mut world := ecs_new()
    slot := ecs_resource_register($Hierarchy, world)
    mut tree := hierarchy_new()
    parent := ecs_spawn(world)
    child := ecs_spawn(world)
    hierarchy_attach(tree, child, parent)
    ecs_resource_set($Hierarchy, world, slot, tree)
    // Read by borrow, so nothing here owns the vectors inside it and the
    // question is asked of the one the world holds. The owning read cannot do
    // this: what it answers with has to be consumed, and a system that only
    // means to look would be left holding vectors to free.
    kept := ecs_resource_ref($Hierarchy, world, slot)
    assert(hierarchy_child_count(kept, parent) == 1)
    assert(is_no_entity(hierarchy_parent(kept, child)) == false)
    // Taken by value at the end, which is what the owning read is for: this
    // one means to release it.
    giving := ecs_resource($Hierarchy, world, slot)
    hierarchy_free(giving)
    ecs_free(world)
}

// Handing a value to the world, which is what setting a resource is: the world
// holds it from here, so the name that held it does not. `move` is what says so
// for a resource that has to be released, and for one that does not it means
// what it always meant.
ecs_resource_set :: fn($T: Type, mut world: World, slot: i64, move value: $T) {
    mut held := ecs_resource_slice($T, world, slot)
    held[0] = value
    ref column := vec_slice($Column, world.resources)[slot]
    mut changed := column_changed(column)
    changed[0] = world.tick
}

// ---------------------------------------------------------------------------
// Events
//
// A channel of values one system writes and another reads. Events are held in
// a column, so sending one is a push of bytes and reading them is a slice. A
// reader keeps its own place in the stream by sequence number rather than by
// index, so clearing the channel does not make a reader re-read what it saw or
// skip what it did not.
// ---------------------------------------------------------------------------

Events :: linear struct {
    // A run of bytes with a width, like a column, but without the two ticks a
    // column carries per row: nothing asks when an event changed, so a channel
    // that stored that would be writing sixteen bytes per send for nobody.
    data: ^u8,
    count: i64,
    capacity: i64,
    item_size: i64,
    // The sequence number of the first item still held. Everything before it
    // has been cleared.
    first: i64,
}

// Where one reader has got to. Two systems reading the same channel keep two of
// these, which is what makes a channel one-to-many.
EventReader :: struct {
    seen: i64,
}

events_new :: fn($T: Type) -> Events {
    Events { data = heap_bytes(sizeof(T)), count = 0, capacity = 1,
        item_size = sizeof(T), first = 0 }
}

events_free :: fn(move e: Events) {
    heap_release($u8, e.data)
}

events_send :: fn($T: Type, mut e: Events, value: $T) {
    if (e.count >= e.capacity) {
        mut room := e.capacity * 2
        if (room < 1) {
            room = 1
        }
        e.data = heap_grow_bytes(e.data, room * e.item_size)
        e.capacity = room
    }
    e.count = e.count + 1
    mut held := bytes_as($T, e.data, e.count)
    held[e.count - 1] = value
}

// How many have ever been sent, which is the sequence number the next one gets.
events_sent :: fn(e: Events) -> i64 {
    e.first + e.count
}

// Everything the channel still holds.
events_slice :: fn($T: Type, e: Events) -> []T {
    bytes_as($T, e.data, e.count)
}

// Drop what has been sent. The sequence numbers carry on, so a reader that has
// not caught up finds itself past the start and reads nothing rather than
// reading the next thing sent as though it were the one it missed.
events_clear :: fn(mut e: Events) {
    e.first = e.first + e.count
    e.count = 0
}

reader_new :: fn() -> EventReader {
    EventReader { seen = 0 }
}

// What this reader has not seen, and it has seen it now. A reader behind the
// start of the channel is caught up to the start: those events are gone, and
// pretending otherwise would hand it the wrong ones.
events_read :: fn($T: Type, e: Events, mut r: EventReader) -> []T {
    if (r.seen < e.first) {
        r.seen = e.first
    }
    held := events_since($T, e, r.seen)
    r.seen = e.first + e.count
    held
}

// Everything sent at or after a sequence number, without a reader and without
// moving one. What a system that keeps its own mark uses, and what `events_read`
// is written in terms of, so the two cannot disagree about where a run starts.
// A mark older than the channel answers with what is still there rather than
// with nothing, since what was dropped is gone either way.
events_since :: fn($T: Type, e: Events, mark: i64) -> []T {
    mut from := mark
    if (from < e.first) {
        from = e.first
    }
    start := from - e.first
    count := e.count - start
    if (count <= 0) {
        return bytes_as($T, e.data, 0)
    }
    bytes_as($T, bytes_at(e.data, start * e.item_size), count)
}

// What a reader would read, without reading it. A system that wants to know
// whether anything arrived before deciding to do the work asks this.
events_pending :: fn(e: Events, r: EventReader) -> i64 {
    mut from := r.seen
    if (from < e.first) {
        from = e.first
    }
    e.first + e.count - from
}

// Drop everything up to a sequence number and keep the rest. What a channel
// read by several systems does once the slowest of them has passed a mark,
// rather than clearing the whole thing and making the others miss what they
// had not reached.
events_trim :: fn(mut e: Events, upto: i64) {
    if (upto <= e.first) {
        return
    }
    mut dropped := upto - e.first
    if (dropped > e.count) {
        dropped = e.count
    }
    kept := e.count - dropped
    // Forward, because what is kept moves down: the source is always ahead of
    // the destination, so a run copied in order never writes over itself.
    moved := dropped * e.item_size
    mut index : i64 = 0
    while (index < kept * e.item_size) {
        unsafe { e.data[index] = e.data[moved + index] }
        index = index + 1
    }
    e.first = e.first + dropped
    e.count = kept
}

// The oldest mark any of them has reached, which is what a channel is trimmed
// to when several systems read it.
readers_oldest :: fn(readers: []EventReader) -> i64 {
    if (slice_len(readers) == 0) {
        return 0
    }
    mut oldest := readers[0].seen
    mut index : i64 = 1
    while (index < slice_len(readers)) {
        if (readers[index].seen < oldest) {
            oldest = readers[index].seen
        }
        index = index + 1
    }
    oldest
}

// The same walk with the body handed in as a compile-time argument, so the call
// inside folds to a direct one and nothing is reached through a pointer.
//
// The components are a compile-time list of types, which is what removes the
// arity limit. The list drives both halves of the query, the mask a table is
// matched against and the column each element reads through, and a `for` over
// it unrolls both where the call is written, so a query over two components
// emits exactly what a hand-written one does.
//
//     for_each($integrate, world, no_filters(), $Position, $Velocity)
//
// The body's parameters line up with the list, since the list is what says how
// many arguments the call makes. A body taking a fourth component is a fourth
// element and a fourth parameter, and nothing here changes.
//
// The filters are an ordinary argument rather than more elements, because they
// carry component indices and an index is decided while the program runs. A
// type cannot name one.
// `$body` takes no signature bound, because the signature is what the list
// decides: one column per element and the row count. A body whose parameters do
// not line up is refused where the call is made below, which is the same
// mistake caught one line further in.
for_each :: fn($body: Type, mut world: World, f: Filters, types: $...) {
    mut q := query_begin(world)
    // Expansion time. What is left is one `query_with` per component, each with
    // its index already in hand.
    for T in types {
        query_with(q, component_of($T, world))
    }
    query_filter(q, f)
    while (query_next(world, q)) {
        body(query_column($T, world, q, component_of($T, world))
            for T in types, q.count)
    }
}

// The same query, one row at a time, which is what the row-level filters need:
// `changed` and `added` are questions about a row, so a body that asks them has
// to be handed rows rather than whole columns.
//
//     for_each_row($upload, world,
//         filter_changed(no_filters(), transform, last_run), $Transform)
//
// The table-level filters still skip whole tables, so what this costs against
// `for_each` is one call per row. The columns are worked out once per table:
// the row loop is a second generic taking them as a list of its own, so the
// column lookups expand where the table is chosen rather than where the row is.
for_each_row :: fn($body: Type, mut world: World, f: Filters, types: $...) {
    mut q := query_begin(world)
    for T in types {
        query_with(q, component_of($T, world))
    }
    query_filter(q, f)
    while (query_next(world, q)) {
        rows_of($body, world, q,
            query_column($T, world, q, component_of($T, world))
                for T in types)
    }
}

// One table's rows, handed to a body one at a time. The columns arrive already
// worked out, as a compile-time list whose elements line up with the body's
// parameters ahead of the row index.
rows_of :: fn($body: Type, mut world: World, q: Query, cols: $...) {
    mut row : i64 = 0
    while (row < q.count) {
        if (query_row_passes(world, q, row)) {
            body(c for c in cols, row)
        }
        row = row + 1
    }
}

// The one entity holding every named component, or no entity when there is not
// exactly one. What a system reading a singleton asks: the camera, the player,
// the clock. Answering with nothing for none and for several is deliberate, so
// a scene that grew a second one fails where it is read rather than silently
// using whichever came first.
ecs_single :: fn(world: World, f: Filters, types: $...) -> Entity {
    mut q := query_begin(world)
    for T in types {
        query_with(q, component_of($T, world))
    }
    query_filter(q, f)
    mut found := no_entity()
    mut seen : i64 = 0
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < q.count) {
            if (query_row_passes(world, q, row)) {
                seen = seen + 1
                if (seen > 1) {
                    return no_entity()
                }
                found = rows[row]
            }
            row = row + 1
        }
    }
    found
}

// How many rows a query would visit, without visiting them. What a system uses
// to size a buffer before the walk that fills it.
ecs_count_matching :: fn(world: World, f: Filters, types: $...) -> i64 {
    mut q := query_begin(world)
    for T in types {
        query_with(q, component_of($T, world))
    }
    query_filter(q, f)
    mut total : i64 = 0
    while (query_next(world, q)) {
        mut row : i64 = 0
        while (row < q.count) {
            if (query_row_passes(world, q, row)) {
                total = total + 1
            }
            row = row + 1
        }
    }
    total
}

// Every entity a query names, gathered into one run. The two-pass shape a
// structural change needs: gather here, then spawn or despawn over what came
// back, since doing either during the walk moves the rows the walk is holding.
//
// A `Vec` rather than a slice, because a run of nothing is a real answer here
// and a slice cannot be one: the heap hands out at least one element whatever
// is asked for, so an empty slice would either carry a length nobody wrote or
// lose the pointer it has to be freed through. A `Vec` keeps the two apart.
//
// The caller owns what comes back and releases it with `vec_free`.
ecs_gather :: fn(world: World, f: Filters, types: $...) -> Vec<Entity> {
    total := ecs_count_matching(world, f, $T for T in types)
    mut out := vec_new($Entity, total)
    if (total == 0) {
        return out
    }
    mut q := query_begin(world)
    for T in types {
        query_with(q, component_of($T, world))
    }
    query_filter(q, f)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < q.count) {
            if (query_row_passes(world, q, row)) {
                vec_push($Entity, out, rows[row])
            }
            row = row + 1
        }
    }
    out
}

// Every unordered pair of entities a query names, which is what a check between
// each thing and every other thing walks: collisions, attractions, anything
// answering a question about two of them at once.
//
// Written as a gather and two index loops rather than as a cursor, since a pair
// is two rows that may be in two different tables and no single walk is over
// both. The caller owns what comes back and releases it with `vec_free`.
ecs_pairs :: fn(world: World, f: Filters, types: $...) -> Vec<EntityPair> {
    mut held := ecs_gather(world, f, $T for T in types)
    names := vec_slice($Entity, held)
    total := slice_len(names)
    mut out := vec_new($EntityPair, total * (total - 1) / 2)
    mut first : i64 = 0
    while (first < total) {
        mut second := first + 1
        while (second < total) {
            vec_push($EntityPair, out,
                EntityPair { a = names[first], b = names[second] })
            second = second + 1
        }
        first = first + 1
    }
    vec_free($Entity, held)
    out
}

// Two entities a pair walk named, in the order the walk found them.
EntityPair :: struct { a: Entity, b: Entity }

// Drop the tables nothing is in. A world that spawned a wide spread of
// archetypes and then despawned most of them keeps a table per archetype it
// ever held, and every query walks all of them to skip them. This releases the
// empty ones and works out again where everything left is.
//
// Table zero is never dropped, empty or not. A fresh entity is put in the
// archetype holding nothing and `ecs_spawn` reaches that table by index rather
// than by lookup, so it is the one table whose position is part of how the
// world works rather than an accident of what was spawned. Dropping it puts the
// next spawn's row in whatever archetype landed at zero, with a row in that
// table's entities and none in its columns, and the world comes apart a read
// later.
//
// Every other table index a caller is holding is stale afterwards, which is why
// this is asked for rather than done as a matter of course: only the caller
// knows there is no walk in flight.
ecs_compact :: fn(mut world: World) -> i64 {
    total := vec_len($Table, world.tables)
    mut kept := vec_new($Table, total)
    mut dropped : i64 = 0
    mut index : i64 = 0
    while (index < total) {
        ref table := vec_slice($Table, world.tables)[index]
        if (index == 0 || vec_len($Entity, table.entities) > 0) {
            vec_push($Table, kept, table_move(table))
        } else {
            table_release(table)
            dropped = dropped + 1
        }
        index = index + 1
    }
    if (dropped == 0) {
        vec_free($Table, kept)
        return 0
    }
    vec_free($Table, world.tables)
    world.tables = kept
    rebuild_lookup(world)
    dropped
}

// A table's storage handed to another Vec, leaving the old row owning nothing.
// The columns are the same allocations; what moves is who holds them, and the
// empty Vecs left behind are what `vec_free` over the old run then releases.
table_move :: fn(mut held: Table) -> Table {
    out := Table { mask = held.mask, entities = held.entities,
        columns = held.columns }
    held.entities = vec_new($Entity, 0)
    held.columns = vec_new($Column, 0)
    out
}

// Where every entity is, and which mask reaches which table, worked out again
// over the tables that are left.
rebuild_lookup :: fn(mut world: World) {
    map_free($Mask, $i64, world.lookup)
    world.lookup = map_new($Mask, $i64, vec_len($Table, world.tables) * 2 + 16)
    mut index : i64 = 0
    while (index < vec_len($Table, world.tables)) {
        ref table := vec_slice($Table, world.tables)[index]
        map_put($Mask, $i64, $mask_keys, world.lookup, table.mask, index)
        rows := vec_slice($Entity, table.entities)
        mut row : i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            ref slot := vec_slice($EntitySlot, world.slots)[entity.id]
            slot.table = index
            slot.row = row
            row = row + 1
        }
        index = index + 1
    }
}

// Everything one table allocated. `world_release` frees them all in a loop; a
// compaction frees only the ones it drops.
table_release :: fn(mut held: Table) {
    mut c : i64 = 0
    while (c < vec_len($Column, held.columns)) {
        ref column := vec_slice($Column, held.columns)[c]
        column_free(column)
        c = c + 1
    }
    vec_free($Column, held.columns)
    vec_free($Entity, held.entities)
}

// ---------------------------------------------------------------------------
// Tags
//
// A marker that costs no mask bit and moves no rows. Adding one to an entity
// does not change which table it is in, so a tag can be flipped in a loop
// without the migration a component would cost. The generation is stored beside
// the mark, so a tag left on a despawned id is not read as a mark on the entity
// that gets the id next.
// ---------------------------------------------------------------------------

Tag :: struct {
    marks: Vec<i64>,
}

tag_new :: fn() -> Tag {
    Tag { marks = vec_new($i64, 64) }
}

tag_release :: fn(mut t: Tag) {
    vec_free($i64, t.marks)
}

tag_free :: fn(move t: Tag) {
    tag_release(t)
}

// Marks are held as the generation plus one, so zero means unmarked and no
// generation can be confused with it.
tag_add :: fn(mut t: Tag, entity: Entity) {
    while (vec_len($i64, t.marks) <= entity.id) {
        vec_push($i64, t.marks, 0)
    }
    vec_set($i64, t.marks, entity.id, entity.generation + 1)
}

tag_remove :: fn(mut t: Tag, entity: Entity) {
    if (entity.id < vec_len($i64, t.marks)) {
        vec_set($i64, t.marks, entity.id, 0)
    }
}

tag_has :: fn(t: Tag, entity: Entity) -> bool {
    if (entity.id >= vec_len($i64, t.marks)) {
        return false
    }
    vec_get($i64, t.marks, entity.id) == entity.generation + 1
}

// ---------------------------------------------------------------------------
// Commands
//
// A structural change made while a query is walking would move the rows the
// walk is holding, so it is queued instead and applied when the walk is done.
// ---------------------------------------------------------------------------

CommandKind :: enum { Spawn, Despawn }

Command :: struct {
    kind: CommandKind,
    entity: Entity,
}

Commands :: struct {
    queued: Vec<Command>,
}

commands_new :: fn() -> Commands {
    Commands { queued = vec_new($Command, 16) }
}

commands_free :: fn(move c: Commands) {
    vec_free($Command, c.queued)
}

// A queued spawn has no handle to answer with yet, since the entity does not
// exist until the queue is applied.
commands_spawn :: fn(mut c: Commands) {
    vec_push($Command, c.queued,
        Command { kind = CommandKind::Spawn,
            entity = Entity { id = 0, generation = 0 } })
}

commands_despawn :: fn(mut c: Commands, entity: Entity) {
    vec_push($Command, c.queued,
        Command { kind = CommandKind::Despawn, entity = entity })
}

// Run the queue in the order it was written and empty it.
commands_apply :: fn(mut c: Commands, mut world: World) {
    mut i : i64 = 0
    while (i < vec_len($Command, c.queued)) {
        held := vec_get($Command, c.queued, i)
        kind := held.kind
        target := held.entity
        if (kind == CommandKind::Spawn) {
            ecs_spawn(world)
        } else {
            ecs_despawn(world, target)
        }
        i = i + 1
    }
    vec_clear($Command, c.queued)
}


// ---------------------------------------------------------------------------
// Hierarchy
//
// A parent-child relation held beside the world rather than as a component,
// because it is a relation between entities and a component is a value an
// entity holds. Three arrays indexed by entity id give a tree that is walked
// without allocating per node: the parent, the first child, and the next
// sibling. A tree walk is a loop over siblings and a recursion into children.
//
// The relation stores handles, so a child whose entity was despawned is a stale
// handle and reads as no child at all, the same rule everything else follows.
// ---------------------------------------------------------------------------

Hierarchy :: struct {
    parent: Vec<Entity>,
    first_child: Vec<Entity>,
    next_sibling: Vec<Entity>,
}

// The handle that names nobody. An id of -1 is one no slot has, so nothing can
// be confused with it and no generation makes it live.
no_entity :: fn() -> Entity {
    Entity { id = -1, generation = 0 }
}

is_no_entity :: fn(entity: Entity) -> bool {
    entity.id < 0
}

hierarchy_new :: fn() -> Hierarchy {
    Hierarchy {
        parent = vec_new($Entity, 64),
        first_child = vec_new($Entity, 64),
        next_sibling = vec_new($Entity, 64),
    }
}

hierarchy_free :: fn(move h: Hierarchy) {
    vec_free($Entity, h.parent)
    vec_free($Entity, h.first_child)
    vec_free($Entity, h.next_sibling)
}

// Room for an id, since an entity is attached long after the arrays were made.
hierarchy_reserve :: fn(mut h: Hierarchy, id: i64) {
    while (vec_len($Entity, h.parent) <= id) {
        vec_push($Entity, h.parent, no_entity())
        vec_push($Entity, h.first_child, no_entity())
        vec_push($Entity, h.next_sibling, no_entity())
    }
}

hierarchy_parent :: fn(h: Hierarchy, child: Entity) -> Entity {
    if (child.id < 0 || child.id >= vec_len($Entity, h.parent)) {
        return no_entity()
    }
    vec_get($Entity, h.parent, child.id)
}

hierarchy_first_child :: fn(h: Hierarchy, parent: Entity) -> Entity {
    if (parent.id < 0 || parent.id >= vec_len($Entity, h.first_child)) {
        return no_entity()
    }
    vec_get($Entity, h.first_child, parent.id)
}

hierarchy_next_sibling :: fn(h: Hierarchy, child: Entity) -> Entity {
    if (child.id < 0 || child.id >= vec_len($Entity, h.next_sibling)) {
        return no_entity()
    }
    vec_get($Entity, h.next_sibling, child.id)
}

// Attach a child to a parent, taking it off whatever it was under first. A
// child goes at the head of its parent's list, which is what makes attaching
// one a constant-time write rather than a walk to the end.
hierarchy_attach :: fn(mut h: Hierarchy, child: Entity, parent: Entity) {
    if (child.id < 0 || parent.id < 0) {
        return
    }
    hierarchy_reserve(h, child.id)
    hierarchy_reserve(h, parent.id)
    hierarchy_detach(h, child)
    held := vec_get($Entity, h.first_child, parent.id)
    vec_set($Entity, h.next_sibling, child.id, held)
    vec_set($Entity, h.first_child, parent.id,
        Entity { id = child.id, generation = child.generation })
    vec_set($Entity, h.parent, child.id,
        Entity { id = parent.id, generation = parent.generation })
}

// Take a child out of its parent's list. Finding it is a walk of the siblings,
// which is the cost of a singly linked list and is what keeps every other
// operation a single write.
hierarchy_detach :: fn(mut h: Hierarchy, child: Entity) {
    if (child.id < 0 || child.id >= vec_len($Entity, h.parent)) {
        return
    }
    parent := vec_get($Entity, h.parent, child.id)
    if (is_no_entity(parent)) {
        return
    }
    head := vec_get($Entity, h.first_child, parent.id)
    if (head.id == child.id) {
        vec_set($Entity, h.first_child, parent.id,
            vec_get($Entity, h.next_sibling, child.id))
    } else {
        mut walk := head
        while (is_no_entity(walk) == false) {
            next := vec_get($Entity, h.next_sibling, walk.id)
            if (next.id == child.id) {
                vec_set($Entity, h.next_sibling, walk.id,
                    vec_get($Entity, h.next_sibling, child.id))
                walk = no_entity()
            } else {
                walk = next
            }
        }
    }
    vec_set($Entity, h.next_sibling, child.id, no_entity())
    vec_set($Entity, h.parent, child.id, no_entity())
}

hierarchy_child_count :: fn(h: Hierarchy, parent: Entity) -> i64 {
    mut walk := hierarchy_first_child(h, parent)
    mut counted : i64 = 0
    while (is_no_entity(walk) == false) {
        counted = counted + 1
        walk = hierarchy_next_sibling(h, walk)
    }
    counted
}

// Despawn an entity and everything under it. The children are read before the
// entity goes, since despawning it is what makes its handle stale.
hierarchy_despawn_tree :: fn(mut h: Hierarchy, mut world: World, root: Entity) {
    mut walk := hierarchy_first_child(h, root)
    while (is_no_entity(walk) == false) {
        next := hierarchy_next_sibling(h, walk)
        hierarchy_despawn_tree(h, world, walk)
        walk = next
    }
    hierarchy_detach(h, root)
    if (root.id >= 0 && root.id < vec_len($Entity, h.first_child)) {
        vec_set($Entity, h.first_child, root.id, no_entity())
    }
    ecs_despawn(world, root)
}

// ---------------------------------------------------------------------------
// Schedules
//
// A system is a function of the world. A schedule is a list of them with a
// stage each, run in ascending stage order, so ordering is a number rather than
// a graph of declared dependencies: what a frame does is read top to bottom.
//
//     mut frame := schedule_new()
//     schedule_add(frame, Stage::Update, integrate)
//     schedule_add(frame, Stage::Last, upload)
//     schedule_run(frame, world, ANY_STATE)
//
// The system is a function pointer, not a compile-time argument, because a
// schedule is built while the program runs. `for_each` and `for_each_row` are
// the other half of this pair, for the inner loop where the call has to fold
// away.
// ---------------------------------------------------------------------------

// When in a frame a system runs. A schedule walks these in order, so the order
// they are written in is the order a frame happens in.
Stage :: enum { First, Update, Last }

// Where a stage falls in a frame. A stage the match does not name aborts rather
// than sorting as one of the others: a schedule that silently ran a system in
// the wrong stage would be a bug nobody could see.
stage_order :: fn(s: Stage) -> i64 {
    // A match over an enum covers every variant or it does not compile, which
    // is what makes adding a stage a compile error here rather than a system
    // that quietly runs in the wrong one.
    match s {
        case .First: 0
        case .Update: 1
        case .Last: 2
    }
}

// A system with this state runs whatever the state is.
ANY_STATE :: -1

System :: struct {
    run: fn(mut World),
    stage: Stage,
    state: i64,
}

Schedule :: struct {
    systems: Vec<System>,
}

schedule_new :: fn() -> Schedule {
    Schedule { systems = vec_new($System, 16) }
}

schedule_free :: fn(move s: Schedule) {
    vec_free($System, s.systems)
}

schedule_add :: fn(mut s: Schedule, stage: Stage, run: fn(mut World)) {
    vec_push($System, s.systems,
        System { run = run, stage = stage, state = ANY_STATE })
}

// A system that runs only while the world is in one state: the pause menu's
// systems, the loading screen's.
schedule_add_in_state :: fn(mut s: Schedule, stage: Stage, state: i64,
    run: fn(mut World)) {
    vec_push($System, s.systems,
        System { run = run, stage = stage, state = state })
}

schedule_count :: fn(s: Schedule) -> i64 {
    vec_len($System, s.systems)
}

// Run every system whose state matches, stage by stage. The systems are walked
// once per stage rather than sorted, since a sort would move them out of the
// order they were added in, which is the order a stage runs them.
schedule_run :: fn(mut s: Schedule, mut world: World, state: i64) {
    // How many passes to make is read off the systems rather than kept as a
    // count beside the enum, which would be a third thing to remember when a
    // stage is added.
    mut highest : i64 = 0
    mut i : i64 = 0
    while (i < vec_len($System, s.systems)) {
        held := vec_get($System, s.systems, i)
        order := stage_order(held.stage)
        if (order > highest) {
            highest = order
        }
        i = i + 1
    }
    mut stage : i64 = 0
    while (stage <= highest) {
        mut k : i64 = 0
        while (k < vec_len($System, s.systems)) {
            system := vec_get($System, s.systems, k)
            if (stage_order(system.stage) == stage
                && (system.state == ANY_STATE || system.state == state)) {
                system.run(world)
            }
            k = k + 1
        }
        stage = stage + 1
    }
}

// ---------------------------------------------------------------------------
// States and time
//
// A state change takes effect between frames rather than in the middle of one,
// so a system that asks to leave a state does not have the schedule change
// under it while it is still running.
// ---------------------------------------------------------------------------

States :: struct {
    current: i64,
    next: i64,
}

states_new :: fn(initial: i64) -> States {
    States { current = initial, next = initial }
}

states_request :: fn(mut s: States, value: i64) {
    s.next = value
}

// Take the requested state, answering whether it was a change.
states_apply :: fn(mut s: States) -> bool {
    if (s.next == s.current) {
        return false
    }
    s.current = s.next
    true
}

states_current :: fn(s: States) -> i64 {
    s.current
}

Time :: struct {
    elapsed: f64,
    delta: f64,
    frame: i64,
}

time_new :: fn() -> Time {
    Time { elapsed = 0.0, delta = 0.0, frame = 0 }
}

time_advance :: fn(mut t: Time, delta: f64) {
    t.delta = delta
    t.elapsed = t.elapsed + delta
    t.frame = t.frame + 1
}

// ---------------------------------------------------------------------------
// Marking a write the raw tier made
//
// `ecs_set` stamps the row it wrote, and so does a write through a column a
// query handed over, because the tick is beside the data and the write goes
// through the same slice. What does not stamp is a pass that reaches the bytes
// another way, and that is deliberate: a walk that reads every row and writes
// none should cost nothing, and a walk that stamps everything it visits has
// told every watcher that everything moved.
//
// So the raw tier says so afterwards. A pass that wrote through `ecs_slice`
// marks the rows it touched, or the whole column when it touched all of them,
// and a system watching for changes sees exactly those.
// ---------------------------------------------------------------------------

// One row, stamped now. What a pass calls for the rows it actually wrote.
ecs_mark_changed :: fn(mut world: World, entity: Entity, component: i64) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    if (mask_has(table.mask, component) == false) {
        return
    }
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    mut changed := column_changed(column)
    changed[slot.row] = world.tick
}

// Every row of one component in one table. What a pass that wrote a whole
// column calls, which is the ordinary case: a walk over a table wrote all of
// it, and marking each row separately would look up the same column each time.
ecs_mark_column :: fn(mut world: World, table_index: i64, component: i64) {
    ref table := vec_slice($Table, world.tables)[table_index]
    if (mask_has(table.mask, component) == false) {
        return
    }
    position := column_position(table.mask, component)
    ref column := vec_slice($Column, table.columns)[position]
    mut changed := column_changed(column)
    mut row : i64 = 0
    while (row < column.count) {
        changed[row] = world.tick
        row = row + 1
    }
}

// ---------------------------------------------------------------------------
// Bundles
//
// A set of components named by type rather than by index, so an entity is made
// in the archetype it belongs in without the caller working out the mask:
//
//     entity := ecs_spawn_bundle(world, $Position, $Velocity, $Health)
//
// There is no macro here to build a bundle type out of values, and none is
// wanted. What a bundle is for is naming the archetype up front, which is the
// half that costs: reaching the same place a component at a time is a migration
// each, and a migration copies every column the entity already has. The values
// are written afterwards into columns that are already there, and nothing
// migrates.
// ---------------------------------------------------------------------------

// The mask a set of types adds up to. Compile-time, so the loop is unrolled and
// what is left is the four-word or of a handful of constants.
mask_of :: fn(world: World, types: $...) -> Mask {
    mut m := mask_empty()
    for T in types {
        m = mask_with(m, component_of($T, world))
    }
    m
}

ecs_spawn_bundle :: fn(mut world: World, types: $...) -> Entity {
    wanted := mask_of(world, $T for T in types)
    ecs_spawn_with(world, wanted)
}

// Every component of the bundle, gone in one migration rather than one each.
// The same half that costs on the way in costs on the way out: reaching the
// archetype a component at a time copies every column still there, every time.
// A component the entity does not hold is not an error; the set that comes off
// is the set that was on.
ecs_remove_bundle :: fn(mut world: World, entity: Entity, types: $...) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    unwanted := mask_of(world, $T for T in types)
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    current := vec_slice($Table, world.tables)[slot.table].mask
    wanted := mask_without_mask(current, unwanted)
    if (mask_equal(wanted, current)) {
        return
    }
    // What is leaving is noted before it leaves, since afterwards there is no
    // row to say it was ever there.
    mut component : i64 = 0
    while (component < world.registry.count) {
        if (mask_has(current, component) && mask_has(unwanted, component)) {
            note_change(world, ChangeKind::Remove, entity, component)
        }
        component = component + 1
    }
    migrate(world, entity, wanted)
}

// Whether an entity holds every component of the bundle, which is the question
// a system asks before reading them all.
ecs_has_bundle :: fn(world: World, entity: Entity, types: $...) -> bool {
    if (ecs_alive(world, entity) == false) {
        return false
    }
    wanted := mask_of(world, $T for T in types)
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    mask_covers(vec_slice($Table, world.tables)[slot.table].mask, wanted)
}

// Everything a world holds except what it registered, released. The registry
// stays, because it is the schema a snapshot is read against.
world_clear :: fn(mut world: World) {
    mut index : i64 = 0
    while (index < vec_len($Table, world.tables)) {
        ref table := vec_slice($Table, world.tables)[index]
        mut held : i64 = 0
        while (held < vec_len($Column, table.columns)) {
            ref column := vec_slice($Column, table.columns)[held]
            column_free(column)
            held = held + 1
        }
        vec_free($Column, table.columns)
        vec_free($Entity, table.entities)
        index = index + 1
    }
    world.tables.len = 0
    world.slots.len = 0
    world.free_ids.len = 0
    world.log.len = 0
    world.live = 0
    world.next_id = 0
    map_free($Mask, $i64, world.lookup)
    world.lookup = map_new($Mask, $i64, 32)
    // The empty archetype comes back, because a world without one is not a
    // world: `ecs_spawn` reaches it by index rather than through the lookup, so
    // the next spawn into a cleared world would otherwise put a row where there
    // is no table. A read fills the rest in over the top of this.
    vec_push(
        $Table,
        world.tables,
        Table { mask = mask_empty(), entities = vec_new($Entity, 16),
            columns = vec_new($Column, 1) },
    )
    map_put($Mask, $i64, $mask_keys, world.lookup, mask_empty(), 0)
}

// ---------------------------------------------------------------------------
// Member worlds
//
// A group is several worlds sharing one set of entity identities. An entity is
// allocated by the group and holds a row in whichever members have something to
// say about it: the renderer's components in one, the game's in another, and
// nothing in the ones that do not care. One despawn takes the rows out of every
// member at once, because the identity is the group's and the rows only follow
// it.
//
// This is what layering an application over an engine looks like without either
// knowing about the other. The engine registers its components in its own
// member and queries them there, a game adds a member of its own and sets its
// components on the same entities, and neither has a link component, a parallel
// id, or a pass that copies a position from one to the other.
//
// Which member owns a component is decided by where it was registered, and a
// routed write finds it by asking each member whether it knows the type. A
// handful of members and a handful of types, asked once when a system starts
// rather than once per entity.
//
// On the shape of it
//
// A borrow cannot be stored or escape a call here, so there is no cursor object
// holding a reference to the group and no iterator handing out references into
// its columns. Every walk is index-driven: ask for a table, ask for its columns
// as slices, walk the slices. That is not a workaround for having no closures,
// it is what the borrow rule leaves, and it is the shape the single-world
// queries above already have.
//
// Joining across members follows from it. One member drives, because the walk
// has to be over somebody's tables, and what the other members hold is read per
// entity through the routed accessors. A read per entity rather than a column
// walk is the honest cost of the row being somewhere else.
// ---------------------------------------------------------------------------

// How many members a group can hold. An engine's core, its interface, a game's
// own, and room for what a plugin brings.
GROUP_MEMBERS :: 8

// Whether an identity is live, and which one it is. Where its rows are is each
// member's business, so this is all the group keeps.
GroupSlot :: struct {
    generation: i64,
    alive: bool,
}

// A component no member registered cannot be answered with a value, so the
// accessors that must return one say which mistake was made and stop.
no_member_holds :: fn() {
    unsafe { frost_rt_error("frost: no member world holds this component\n") }
    frost_rt_die()
}

// Which member owns a component and what index it has there. Both, because
// neither alone names a column: two members number their components from zero.
Route :: struct {
    member: i64,
    component: i64,
}

no_route :: fn() -> Route {
    Route { member = -1, component = -1 }
}

route_found :: fn(r: Route) -> bool {
    r.member >= 0
}

// A tag on the group rather than on one member: a mark an entity carries that
// no member's mask has a bit for, which is what lets a selection or an in-hand
// flag be added without moving a row. Dropped when the entity dies, as the rows
// are.
TagType :: struct {
    key: i64,
    set: Tag,
}

Group :: struct {
    members: Vec<World>,
    count: i64,
    slots: Vec<GroupSlot>,
    free_ids: Vec<i64>,
    next_id: i64,
    live: i64,
    tags: Vec<TagType>,
    // The group's own structural log, which records identities coming and
    // going. What happened to a row inside a member is that member's log, and
    // the two are separate because they answer different questions: one says an
    // entity exists now, the other says it gained a component.
    log: Vec<Change>,
    logging: bool,
}

group_new :: fn() -> Group {
    Group {
        members = vec_new($World, GROUP_MEMBERS),
        count = 0,
        slots = vec_new($GroupSlot, 64),
        free_ids = vec_new($i64, 64),
        next_id = 0,
        live = 0,
        tags = vec_new($TagType, 4),
        log = vec_new($Change, 16),
        logging = false,
    }
}

group_free :: fn(move g: Group) {
    mut index : i64 = 0
    while (index < g.count) {
        ref member := vec_slice($World, g.members)[index]
        world_release(member)
        index = index + 1
    }
    mut held : i64 = 0
    while (held < vec_len($TagType, g.tags)) {
        ref marked := vec_slice($TagType, g.tags)[held]
        tag_release(marked.set)
        held = held + 1
    }
    vec_free($TagType, g.tags)
    vec_free($World, g.members)
    vec_free($GroupSlot, g.slots)
    vec_free($i64, g.free_ids)
    vec_free($Change, g.log)
}

// Adds a member and answers with its index. The order they are added in is the
// order they are numbered in, so a program naming a member by number is naming
// the order it declared them: append, never reorder.
group_add_world :: fn(mut g: Group) -> i64 {
    if (g.count >= GROUP_MEMBERS) {
        unsafe { frost_rt_error("frost: a group holds no more member worlds\n") }
        frost_rt_die()
        return -1
    }
    index := g.count
    vec_push($World, g.members, ecs_new())
    g.count = index + 1
    index
}

group_world_count :: fn(g: Group) -> i64 {
    g.count
}

// The members, so a query reaches one by reference:
//
//     ref world := group_members(g)[engine]
//     mut q := query_begin(world)
//     while (query_next(world, q)) { ... }
//
// By reference rather than by value, and this is the borrow rule showing its
// hand rather than a preference. A world holds linear storage, so a world
// handed back from a call is a value the caller has to consume, and a caller
// that only wanted to read it has nothing to do with it. A reference into the
// group's own storage is what a walk wants anyway: the tables it is about to
// read are the group's, not a copy of them.
//
// It is also why there is no group-level query cursor. The single-world one
// above needs no change to walk a member, because what it walks is a world and
// this is how you get one.
group_members :: fn(g: Group) -> []World {
    vec_slice($World, g.members)
}

// Registers a component in one member. Which member is a decision about how the
// program is layered rather than about the type, so it is written here rather
// than worked out.
group_register :: fn($T: Type, mut g: Group, member: i64) -> i64 {
    ref held := vec_slice($World, g.members)[member]
    ecs_register($T, held)
}

// Where a component lives, or no route when nothing registered it. Asked once
// when a system starts rather than once per entity.
group_route :: fn($T: Type, g: Group) -> Route {
    wanted := type_id(T)
    mut index : i64 = 0
    while (index < g.count) {
        ref held := vec_slice($World, g.members)[index]
        known := vec_slice($i64, held.registry.types)
        mut component : i64 = 0
        while (component < held.registry.count) {
            if (known[component] == wanted) {
                return Route { member = index, component = component }
            }
            component = component + 1
        }
        index = index + 1
    }
    no_route()
}

group_note :: fn(mut g: Group, kind: ChangeKind, entity: Entity) {
    if (g.logging == false) {
        return
    }
    vec_push($Change, g.log,
        Change { kind = kind, entity = entity, component = -1, tick = 0 })
}

group_log_enable :: fn(mut g: Group, on: bool) {
    g.logging = on
}

group_log :: fn(g: Group) -> []Change {
    vec_slice($Change, g.log)
}

group_log_clear :: fn(mut g: Group) {
    g.log.len = 0
}

// An identity with no rows anywhere. A member gains one the first time
// something is set on the entity there, which is what lets an entity the
// renderer knows about carry no game state at all.
group_spawn :: fn(mut g: Group) -> Entity {
    mut id : i64 = 0
    mut generation : i64 = 0
    free_count := vec_len($i64, g.free_ids)
    if (free_count > 0) {
        id = vec_get($i64, g.free_ids, free_count - 1)
        g.free_ids.len = free_count - 1
        generation = vec_slice($GroupSlot, g.slots)[id].generation
    } else {
        id = g.next_id
        g.next_id = id + 1
        vec_push($GroupSlot, g.slots,
            GroupSlot { generation = 0, alive = false })
    }
    ref slot := vec_slice($GroupSlot, g.slots)[id]
    slot.generation = generation
    slot.alive = true
    g.live = g.live + 1
    made := Entity { id = id, generation = generation }
    group_note(g, ChangeKind::Spawn, made)
    made
}

group_alive :: fn(g: Group, entity: Entity) -> bool {
    if (entity.id < 0 || entity.id >= vec_len($GroupSlot, g.slots)) {
        return false
    }
    slot := vec_slice($GroupSlot, g.slots)[entity.id]
    slot.alive && slot.generation == entity.generation
}

group_count :: fn(g: Group) -> i64 {
    g.live
}

// The row this entity has in a member, made if it has none. A member's own
// allocator never runs: the identity is the group's, and this is a member being
// told about one it has not seen.
member_adopt :: fn(mut world: World, entity: Entity) {
    while (vec_len($EntitySlot, world.slots) <= entity.id) {
        vec_push($EntitySlot, world.slots,
            EntitySlot { generation = 0, alive = false, table = 0, row = 0 })
    }
    existing := vec_slice($EntitySlot, world.slots)[entity.id]
    if (existing.alive && existing.generation == entity.generation) {
        return
    }
    // Read before the push, because pushing takes the entity: `vec_push` is
    // generic and declares its value `move` for the types that need it.
    id := entity.id
    generation := entity.generation
    ref empty := vec_slice($Table, world.tables)[0]
    row := vec_len($Entity, empty.entities)
    vec_push($Entity, empty.entities, entity)
    ref slot := vec_slice($EntitySlot, world.slots)[id]
    slot.generation = generation
    slot.alive = true
    slot.table = 0
    slot.row = row
    world.live = world.live + 1
}

// Takes the entity's row out of a member, if it has one. The generation is left
// bumped, so a handle that outlived the entity is refused here as well as at
// the group.
member_retire :: fn(mut world: World, entity: Entity) {
    if (entity.id < 0 || entity.id >= vec_len($EntitySlot, world.slots)) {
        return
    }
    held := vec_slice($EntitySlot, world.slots)[entity.id]
    if (held.alive == false || held.generation != entity.generation) {
        return
    }
    table_swap_remove(world, held.table, held.row)
    ref slot := vec_slice($EntitySlot, world.slots)[entity.id]
    slot.alive = false
    slot.generation = entity.generation + 1
    world.live = world.live - 1
}

// Every row in every member, and every group tag. One call, because an entity
// is one thing however many members hold a piece of it.
group_despawn :: fn(mut g: Group, entity: Entity) -> bool {
    if (group_alive(g, entity) == false) {
        return false
    }
    mut index : i64 = 0
    while (index < g.count) {
        ref member := vec_slice($World, g.members)[index]
        member_retire(member, entity)
        index = index + 1
    }
    mut held : i64 = 0
    while (held < vec_len($TagType, g.tags)) {
        ref marked := vec_slice($TagType, g.tags)[held]
        tag_remove(marked.set, entity)
        held = held + 1
    }
    ref slot := vec_slice($GroupSlot, g.slots)[entity.id]
    slot.alive = false
    slot.generation = entity.generation + 1
    g.live = g.live - 1
    vec_push($i64, g.free_ids, entity.id)
    group_note(g, ChangeKind::Despawn, entity)
    true
}

group_despawn_entities :: fn(mut g: Group, entities: []Entity) {
    mut index : i64 = 0
    while (index < slice_len(entities)) {
        group_despawn(g, entities[index])
        index = index + 1
    }
}

// Whether the entity holds this component, wherever it lives.
group_has :: fn($T: Type, g: Group, entity: Entity) -> bool {
    route := group_route($T, g)
    if (route_found(route) == false) {
        return false
    }
    if (group_alive(g, entity) == false) {
        return false
    }
    ref held := vec_slice($World, g.members)[route.member]
    ecs_has(held, entity, route.component)
}

// The component, from whichever member owns it.
group_get :: fn($T: Type, g: Group, entity: Entity) -> $T {
    route := group_route($T, g)
    if (route_found(route) == false) {
        no_member_holds()
    }
    ref held := vec_slice($World, g.members)[route.member]
    ecs_get($T, held, entity, route.component)
}

// Sets the component on the entity, in whichever member owns it, giving that
// member a row for the entity and the entity the component if either is
// missing. This is the whole of what an application does to an engine entity:
// name a type of its own and write it.
group_set :: fn($T: Type, mut g: Group, entity: Entity, value: $T) {
    route := group_route($T, g)
    if (route_found(route) == false) {
        no_member_holds()
        return
    }
    if (group_alive(g, entity) == false) {
        return
    }
    ref member := vec_slice($World, g.members)[route.member]
    member_adopt(member, entity)
    ecs_add($T, member, entity, route.component, value)
}

group_remove :: fn($T: Type, mut g: Group, entity: Entity) {
    route := group_route($T, g)
    if (route_found(route) == false) {
        return
    }
    ref member := vec_slice($World, g.members)[route.member]
    ecs_remove(member, entity, route.component)
}

// A tag type, registered the first time it is named. No mask bit, so nothing
// migrates when one is added and nothing has to be declared up front.
group_tag_type :: fn($T: Type, mut g: Group) -> i64 {
    wanted := type_id(T)
    mut index : i64 = 0
    while (index < vec_len($TagType, g.tags)) {
        if (vec_slice($TagType, g.tags)[index].key == wanted) {
            return index
        }
        index = index + 1
    }
    made := vec_len($TagType, g.tags)
    vec_push($TagType, g.tags, TagType { key = wanted, set = tag_new() })
    made
}

group_add_tag :: fn($T: Type, mut g: Group, entity: Entity) {
    slot := group_tag_type($T, g)
    ref held := vec_slice($TagType, g.tags)[slot]
    tag_add(held.set, entity)
}

group_remove_tag :: fn($T: Type, mut g: Group, entity: Entity) {
    slot := group_tag_type($T, g)
    ref held := vec_slice($TagType, g.tags)[slot]
    tag_remove(held.set, entity)
}

group_has_tag :: fn($T: Type, mut g: Group, entity: Entity) -> bool {
    slot := group_tag_type($T, g)
    ref held := vec_slice($TagType, g.tags)[slot]
    tag_has(held.set, entity)
}

// ---------------------------------------------------------------------------
// Tests
//
// The types here are the ones a test needs and nothing else names, so the
// module carries no component of its own into a program that imports it.
// ---------------------------------------------------------------------------

TestPosition :: struct { x: f32, y: f32 }
TestVelocity :: struct { x: f32, y: f32 }
TestHealth :: struct { points: i64 }

test_integrate :: fn(mut p: []TestPosition, mut v: []TestVelocity,
    count: i64) {
    mut i : i64 = 0
    while (i < count) {
        p[i].x = p[i].x + v[i].x
        p[i].y = p[i].y + v[i].y
        i = i + 1
    }
}

test "a handle is refused once the entity it named is gone" {
    mut world := ecs_new()
    a := ecs_spawn(world)
    assert(ecs_alive(world, a))
    assert(ecs_count(world) == 1)
    ecs_despawn(world, a)
    assert(ecs_alive(world, a) == false)
    assert(ecs_count(world) == 0)
    // The next entity takes the same id under a later generation, and the
    // handle to the one before it is still refused.
    b := ecs_spawn(world)
    assert(b.id == a.id)
    assert(b.generation != a.generation)
    assert(ecs_alive(world, a) == false)
    assert(ecs_alive(world, b))
    ecs_free(world)
}

test "a component is written and read back" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    a := ecs_spawn(world)
    assert(ecs_has(world, a, position) == false)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 1.0, y = 2.0 })
    assert(ecs_has(world, a, position))
    held := ecs_get($TestPosition, world, a, position)
    assert(held.x == 1.0)
    assert(held.y == 2.0)
    ecs_set($TestPosition, world, a, position,
        TestPosition { x = 5.0, y = 6.0 })
    again := ecs_get($TestPosition, world, a, position)
    assert(again.x == 5.0)
    ecs_free(world)
}

test "adding a component carries the ones already there" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 3.0, y = 4.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 0.5, y = 0.0 })
    ecs_add($TestHealth, world, a, health, TestHealth { points = 12 })
    // Two migrations later, the first component is still what it was.
    held := ecs_get($TestPosition, world, a, position)
    assert(held.x == 3.0)
    assert(held.y == 4.0)
    speed := ecs_get($TestVelocity, world, a, velocity)
    assert(speed.x == 0.5)
    life := ecs_get($TestHealth, world, a, health)
    assert(life.points == 12)
    // And removing the middle one leaves the others where they were.
    ecs_remove(world, a, velocity)
    assert(ecs_has(world, a, velocity) == false)
    assert(ecs_has(world, a, position))
    after := ecs_get($TestPosition, world, a, position)
    assert(after.x == 3.0)
    still := ecs_get($TestHealth, world, a, health)
    assert(still.points == 12)
    ecs_free(world)
}

test "an entity can start out in the archetype it belongs in" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)

    wanted := mask_with(mask_with(mask_empty(), position), velocity)
    a := ecs_spawn_with(world, wanted)
    assert(ecs_has(world, a, position))
    assert(ecs_has(world, a, velocity))
    assert(ecs_has(world, a, health) == false)

    // The columns are there, so writing into them migrates nothing. Reading
    // back is what says the row is the one the mask asked for.
    ecs_set($TestPosition, world, a, position, TestPosition { x = 1.0, y = 2.0 })
    ecs_set($TestVelocity, world, a, velocity, TestVelocity { x = 9.0, y = 0.0 })
    held := ecs_get($TestPosition, world, a, position)
    assert(held.x == 1.0)
    assert(held.y == 2.0)
    speed := ecs_get($TestVelocity, world, a, velocity)
    assert(speed.x == 9.0)

    // Landing there is the same archetype walking there reaches, so the two
    // share a table rather than the world holding one for each route.
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position, TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, b, velocity, TestVelocity { x = 0.0, y = 0.0 })
    slots := vec_slice($EntitySlot, world.slots)
    table_a := slots[a.id].table
    table_b := slots[b.id].table
    assert(table_a == table_b)

    // An empty mask is the entity `ecs_spawn` already gives.
    c := ecs_spawn_with(world, mask_empty())
    assert(ecs_alive(world, c))
    assert(ecs_has(world, c, position) == false)
    ecs_free(world)
}

test "a component a fresh row starts with counts as added" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    ecs_tick(world)
    before := ecs_now(world)
    ecs_tick(world)
    a := ecs_spawn_with(world, mask_with(mask_empty(), position))
    assert(ecs_added_since(world, a, position, before))
    ecs_free(world)
}

test "a despawn moves the last row into the hole it left" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    c := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_add($TestHealth, world, b, health, TestHealth { points = 2 })
    ecs_add($TestHealth, world, c, health, TestHealth { points = 3 })
    ecs_despawn(world, a)
    // `c` moved into the row `a` left, and its component came with it.
    assert(ecs_alive(world, c))
    held := ecs_get($TestHealth, world, c, health)
    assert(held.points == 3)
    other := ecs_get($TestHealth, world, b, health)
    assert(other.points == 2)
    assert(ecs_count(world) == 2)
    ecs_free(world)
}

test "a query visits the tables holding every component it asks for" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    // One entity with both, one with only a position.
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 1.0, y = 2.0 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 100.0, y = 100.0 })

    mut seen : i64 = 0
    mut q := query_begin(world)
    query_with(q, position)
    query_with(q, velocity)
    while (query_next(world, q)) {
        seen = seen + q.count
    }
    assert(seen == 1)

    // And a query over the position alone finds both, in two tables.
    mut tables : i64 = 0
    mut total : i64 = 0
    mut all := query_begin(world)
    query_with(all, position)
    while (query_next(world, all)) {
        tables = tables + 1
        total = total + all.count
    }
    assert(tables == 2)
    assert(total == 2)
    ecs_free(world)
}

test "a system writes through the columns a query hands it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 1.0, y = 1.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 0.25, y = 0.5 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 10.0, y = 10.0 })
    ecs_add($TestVelocity, world, b, velocity,
        TestVelocity { x = 1.0, y = 1.0 })

    for_each($test_integrate, world, no_filters(), $TestPosition,
        $TestVelocity)

    first := ecs_get($TestPosition, world, a, position)
    assert(first.x == 1.25)
    assert(first.y == 1.5)
    second := ecs_get($TestPosition, world, b, position)
    assert(second.x == 11.0)
    ecs_free(world)
}

test "the cursor form reaches the entity beside its components" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 7 })
    mut found : i64 = 0
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        mut points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (entities[i].id == a.id) {
                found = points[i].points
            }
            i = i + 1
        }
    }
    assert(found == 7)
    ecs_free(world)
}

test "a tag marks an entity without moving it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut selected := tag_new()
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 0.0, y = 0.0 })
    tag_add(selected, a)
    assert(tag_has(selected, a))
    assert(tag_has(selected, b) == false)
    // Both are still in the one table.
    mut tables : i64 = 0
    mut q := query_begin(world)
    query_with(q, position)
    while (query_next(world, q)) {
        tables = tables + 1
    }
    assert(tables == 1)
    tag_remove(selected, a)
    assert(tag_has(selected, a) == false)
    tag_free(selected)
    ecs_free(world)
}

test "a tag left on a freed id is not a mark on the next entity" {
    mut world := ecs_new()
    mut selected := tag_new()
    a := ecs_spawn(world)
    tag_add(selected, a)
    ecs_despawn(world, a)
    b := ecs_spawn(world)
    assert(b.id == a.id)
    assert(tag_has(selected, b) == false)
    tag_free(selected)
    ecs_free(world)
}

TestOrder :: struct { steps: i64 }
TestDamage :: struct { amount: i64 }

// The systems a schedule test runs. A system is a function of the world and
// nothing else, so what it reads it reads from a resource, which is what one in
// a program does too.
first_system :: fn(mut world: World) {
    held := ecs_resource($TestOrder, world, 0)
    ecs_resource_set($TestOrder, world, 0,
        TestOrder { steps = held.steps * 2 + 1 })
}

second_system :: fn(mut world: World) {
    held := ecs_resource($TestOrder, world, 0)
    ecs_resource_set($TestOrder, world, 0, TestOrder { steps = held.steps * 2 })
}

spawning_system :: fn(mut world: World) {
    ecs_spawn(world)
}

test "a resource is found by the type it is" {
    mut world := ecs_new()
    order := ecs_resource_register($TestOrder, world)
    damage := ecs_resource_register($TestDamage, world)
    assert(order != damage)
    // Asked for in the other order from the one they were registered in, so a
    // lookup answering with the slot it was asked at rather than the slot the
    // type sits in would agree with itself and still be wrong.
    assert(resource_of($TestDamage, world) == damage)
    assert(resource_of($TestOrder, world) == order)

    ecs_resource_set($TestOrder, world, resource_of($TestOrder, world),
        TestOrder { steps = 7 })
    ecs_resource_set($TestDamage, world, resource_of($TestDamage, world),
        TestDamage { amount = 3 })
    assert(ecs_resource($TestOrder, world,
        resource_of($TestOrder, world)).steps == 7)
    assert(ecs_resource($TestDamage, world,
        resource_of($TestDamage, world)).amount == 3)
    ecs_free(world)
}

test "registering a resource twice answers the slot it already has" {
    mut world := ecs_new()
    first := ecs_resource_register($TestOrder, world)
    ecs_resource_set($TestOrder, world, first, TestOrder { steps = 5 })
    // What a second piece of a program does when it needs the same resource: it
    // finds the one already there, so what the first piece wrote is still what
    // is read and no second column was laid over the type.
    again := ecs_resource_register($TestOrder, world)
    assert(again == first)
    assert(ecs_resource($TestOrder, world, again).steps == 5)
    assert(vec_len($Column, world.resources) == 1)
    ecs_free(world)
}

// The two halves are keyed differently on purpose, so this says which is which
// rather than leaving it to be discovered. A component index is a slot, and
// asking for a second one gets a second slot; a resource is keyed by its type,
// and asking again gets the one already there.
test "a component registers by slot where a resource registers by type" {
    mut world := ecs_new()
    first := ecs_register($TestPosition, world)
    again := ecs_register($TestPosition, world)
    assert(again != first)
    // Whichever slot a caller was handed, the by-type route answers the first,
    // which is what a query built from a type reads.
    assert(component_of($TestPosition, world) == first)

    held := ecs_resource_register($TestOrder, world)
    assert(ecs_resource_register($TestOrder, world) == held)
    ecs_free(world)
}

test "declaring a component twice reaches the one already there" {
    mut world := ecs_new()
    first := component_for($TestPosition, world)
    // Two pieces of a program each saying they need this component. The second
    // finds the first's, so an entity given one is an entity the other's query
    // matches.
    assert(component_for($TestPosition, world) == first)
    assert(world.registry.count == 1)
    // And one asked for where nothing registered cuts the slot rather than
    // stopping, which is what makes it safe to call before anything else has.
    second := component_for($TestHealth, world)
    assert(second != first)
    assert(world.registry.count == 2)
    ecs_free(world)
}

test "a write is stamped with the tick it was made at" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    made_at := ecs_now(world)
    assert(ecs_changed_since(world, a, health, made_at - 1))
    assert(ecs_added_since(world, a, health, made_at - 1))

    later := ecs_tick(world)
    // Nothing was written this tick, so nothing changed since the last one.
    assert(ecs_changed_since(world, a, health, later - 1) == false)
    ecs_set($TestHealth, world, a, health, TestHealth { points = 2 })
    assert(ecs_changed_since(world, a, health, later - 1))
    // The write is not an add: the component was already there.
    assert(ecs_added_since(world, a, health, later - 1) == false)
    ecs_free(world)
}

test "a query hands over the write times beside the components" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_add($TestHealth, world, b, health, TestHealth { points = 2 })
    watermark := ecs_tick(world)
    ecs_set($TestHealth, world, b, health, TestHealth { points = 20 })

    mut touched : i64 = 0
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        stamps := query_changed(world, q, health)
        points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (stamps[i] >= watermark) {
                touched = touched + points[i].points
            }
            i = i + 1
        }
    }
    assert(touched == 20)
    ecs_free(world)
}

test "a migration carries a row's history with it" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    position := ecs_register($TestPosition, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 5 })
    written_at := ecs_now(world)
    ecs_tick(world)
    // Gaining a second component moves the entity to another table. The health
    // was not written by that, so its stamp is still the one it had.
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    assert(ecs_changed_since(world, a, health, written_at) == false)
    assert(ecs_added_since(world, a, position, written_at))
    ecs_free(world)
}

test "a resource is one value the whole world shares" {
    mut world := ecs_new()
    order := ecs_resource_register($TestOrder, world)
    damage := ecs_resource_register($TestDamage, world)
    assert(ecs_resource($TestOrder, world, order).steps == 0)
    ecs_resource_set($TestOrder, world, order, TestOrder { steps = 7 })
    ecs_resource_set($TestDamage, world, damage, TestDamage { amount = 3 })
    assert(ecs_resource($TestOrder, world, order).steps == 7)
    assert(ecs_resource($TestDamage, world, damage).amount == 3)
    // And it is written in place through the slice, the way a system does.
    mut held := ecs_resource_slice($TestOrder, world, order)
    held[0].steps = held[0].steps + 1
    assert(ecs_resource($TestOrder, world, order).steps == 8)
    ecs_free(world)
}

test "two readers of one channel each see every event once" {
    mut channel := events_new($TestDamage)
    mut renderer := reader_new()
    mut audio := reader_new()
    events_send($TestDamage, channel, TestDamage { amount = 2 })
    events_send($TestDamage, channel, TestDamage { amount = 3 })
    assert(events_sent(channel) == 2)

    first := events_read($TestDamage, channel, renderer)
    mut total : i64 = 0
    mut i : i64 = 0
    while (i < slice_len(first)) {
        total = total + first[i].amount
        i = i + 1
    }
    assert(total == 5)
    // The same reader again sees nothing. The other reader sees both.
    assert(slice_len(events_read($TestDamage, channel, renderer)) == 0)
    assert(slice_len(events_read($TestDamage, channel, audio)) == 2)

    events_send($TestDamage, channel, TestDamage { amount = 4 })
    assert(slice_len(events_read($TestDamage, channel, renderer)) == 1)
    events_free(channel)
}

test "a reader that missed a clear is caught up rather than misled" {
    mut channel := events_new($TestDamage)
    mut late := reader_new()
    events_send($TestDamage, channel, TestDamage { amount = 1 })
    events_clear(channel)
    events_send($TestDamage, channel, TestDamage { amount = 9 })
    held := events_read($TestDamage, channel, late)
    // The one it missed is gone, and the one it did not is the one it gets.
    assert(slice_len(held) == 1)
    assert(held[0].amount == 9)
    events_free(channel)
}

test "a tree is walked from a parent to its children" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    grandchild := ecs_spawn(world)
    hierarchy_attach(tree, a, root)
    hierarchy_attach(tree, b, root)
    hierarchy_attach(tree, grandchild, a)
    assert(hierarchy_child_count(tree, root) == 2)
    assert(hierarchy_child_count(tree, a) == 1)
    assert(hierarchy_parent(tree, grandchild).id == a.id)
    assert(is_no_entity(hierarchy_parent(tree, root)))

    // Reattaching moves it rather than listing it twice.
    hierarchy_attach(tree, grandchild, root)
    assert(hierarchy_child_count(tree, root) == 3)
    assert(hierarchy_child_count(tree, a) == 0)
    hierarchy_detach(tree, grandchild)
    assert(hierarchy_child_count(tree, root) == 2)
    hierarchy_free(tree)
    ecs_free(world)
}

test "despawning a parent despawns what was under it" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    child := ecs_spawn(world)
    grandchild := ecs_spawn(world)
    other := ecs_spawn(world)
    hierarchy_attach(tree, child, root)
    hierarchy_attach(tree, grandchild, child)
    assert(ecs_count(world) == 4)
    hierarchy_despawn_tree(tree, world, root)
    assert(ecs_alive(world, root) == false)
    assert(ecs_alive(world, child) == false)
    assert(ecs_alive(world, grandchild) == false)
    assert(ecs_alive(world, other))
    assert(ecs_count(world) == 1)
    hierarchy_free(tree)
    ecs_free(world)
}

test "a schedule runs its systems in stage order" {
    mut world := ecs_new()
    ecs_resource_register($TestOrder, world)
    mut frame := schedule_new()
    // Added last, run first: the stage decides, not the order they were added.
    schedule_add(frame, Stage::Last, second_system)
    schedule_add(frame, Stage::First, first_system)
    assert(schedule_count(frame) == 2)
    schedule_run(frame, world, ANY_STATE)
    // first_system then second_system: (0 * 2 + 1) * 2.
    assert(ecs_resource($TestOrder, world, 0).steps == 2)
    schedule_free(frame)
    ecs_free(world)
}

test "a system bound to a state runs only in that state" {
    mut world := ecs_new()
    mut frame := schedule_new()
    schedule_add_in_state(frame, Stage::Update, 1, spawning_system)
    schedule_run(frame, world, 0)
    assert(ecs_count(world) == 0)
    schedule_run(frame, world, 1)
    assert(ecs_count(world) == 1)
    schedule_free(frame)
    ecs_free(world)
}

test "a state change is taken between frames rather than during one" {
    mut states := states_new(0)
    states_request(states, 2)
    // The request is not the change: the state is what it was until it is
    // applied, which is what keeps a frame running in one state throughout.
    assert(states_current(states) == 0)
    assert(states_apply(states))
    assert(states_current(states) == 2)
    // Applying again is not a change.
    assert(states_apply(states) == false)
}

test "time carries the frame and what it took" {
    mut clock := time_new()
    time_advance(clock, 0.5)
    time_advance(clock, 0.25)
    assert(clock.frame == 2)
    assert(clock.delta == 0.25)
    assert(clock.elapsed == 0.75)
}

test "a world asked to keep a log says what changed structurally" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    // Nothing is recorded until it is asked for.
    ignored := ecs_spawn(world)
    assert(slice_len(ecs_log(world)) == 0)
    ecs_log_enable(world, true)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_remove(world, a, health)
    ecs_despawn(world, a)
    held := ecs_log(world)
    assert(slice_len(held) == 4)
    assert(held[0].kind == ChangeKind::Spawn)
    assert(held[1].kind == ChangeKind::Add)
    assert(held[1].component == health)
    assert(held[2].kind == ChangeKind::Remove)
    assert(held[3].kind == ChangeKind::Despawn)
    assert(held[3].entity.id == a.id)
    ecs_log_clear(world)
    assert(slice_len(ecs_log(world)) == 0)
    ecs_free(world)
}

test "a change made during a walk is queued and applied after it" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    b := ecs_spawn(world)
    ecs_add($TestHealth, world, b, health, TestHealth { points = 0 })

    mut queued := commands_new()
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (points[i].points == 0) {
                commands_despawn(queued, entities[i])
            }
            i = i + 1
        }
    }
    assert(ecs_count(world) == 2)
    commands_apply(queued, world)
    assert(ecs_count(world) == 1)
    assert(ecs_alive(world, b) == false)
    assert(ecs_alive(world, a))
    commands_free(queued)
    ecs_free(world)
}

// ---------------------------------------------------------------------------
// What a world costs
//
// Every container here takes heap blocks and hands them back, and nothing in
// the language checks that it does. `heap_live` counts the blocks that are out,
// so a test can say the count came back to where it started. A leak is
// otherwise invisible until a program runs long enough to notice, which is how
// `column_free` came to allocate three replacement blocks nobody read.
// ---------------------------------------------------------------------------

test "a world gives back every block it took" {
    before := heap_live()
    mut world := ecs_new()
    ecs_free(world)
    assert(heap_live() == before)
}

test "a world full of components gives back every block it took" {
    before := heap_live()
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)
    mut made : i64 = 0
    while (made < 64) {
        e := ecs_spawn(world)
        ecs_add($TestPosition, world, e, position,
            TestPosition { x = 1.0, y = 2.0 })
        if (made % 2 == 0) {
            ecs_add($TestVelocity, world, e, velocity,
                TestVelocity { x = 0.5, y = 0.5 })
        }
        if (made % 3 == 0) {
            ecs_add($TestHealth, world, e, health, TestHealth { points = made })
        }
        made = made + 1
    }
    ecs_free(world)
    assert(heap_live() == before)
}

test "spawning and despawning in a loop leaks nothing" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    // One round first, so the table for this component set exists: making it is
    // what the first spawn pays for, and it is reused from then on. The count is
    // taken after that, so what the test measures is the rounds rather than the
    // table.
    first := ecs_spawn(world)
    ecs_add($TestHealth, world, first, health, TestHealth { points = 0 })
    ecs_despawn(world, first)
    settled := heap_live()
    mut round : i64 = 0
    while (round < 50) {
        e := ecs_spawn(world)
        ecs_add($TestHealth, world, e, health, TestHealth { points = round })
        ecs_despawn(world, e)
        round = round + 1
    }
    assert(heap_live() == settled)
    ecs_free(world)
}

test "resources give back what they took" {
    before := heap_live()
    mut world := ecs_new()
    ecs_resource_register($TestOrder, world)
    ecs_resource_register($TestDamage, world)
    ecs_free(world)
    assert(heap_live() == before)
}

test "a channel gives back what it took" {
    before := heap_live()
    mut channel := events_new($TestDamage)
    mut sent : i64 = 0
    while (sent < 100) {
        events_send($TestDamage, channel, TestDamage { amount = sent })
        sent = sent + 1
    }
    events_free(channel)
    assert(heap_live() == before)
}

test "a tree gives back what it took" {
    before := heap_live()
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    mut made : i64 = 0
    while (made < 32) {
        child := ecs_spawn(world)
        hierarchy_attach(tree, child, root)
        made = made + 1
    }
    hierarchy_free(tree)
    ecs_free(world)
    assert(heap_live() == before)
}

test "a schedule, a tag and a command buffer give back what they took" {
    before := heap_live()
    mut frame := schedule_new()
    schedule_add(frame, Stage::Update, spawning_system)
    schedule_free(frame)
    mut marks := tag_new()
    mut world := ecs_new()
    a := ecs_spawn(world)
    tag_add(marks, a)
    tag_free(marks)
    mut queued := commands_new()
    commands_despawn(queued, a)
    commands_free(queued)
    ecs_free(world)
    assert(heap_live() == before)
}

test "a column freed and used again holds what is put in it" {
    before := heap_live()
    mut c := column_new(8)
    column_push_zero(c, 1)
    mut held := column_of($i64, c)
    held[0] = 42
    assert(column_of($i64, c)[0] == 42)
    column_free(c)
    // Freed is empty rather than gone: nothing is read from it, and the next
    // row it is asked for allocates fresh.
    assert(c.count == 0)
    assert(c.capacity == 0)
    assert(slice_len(column_of($i64, c)) == 0)
    column_push_zero(c, 2)
    mut again := column_of($i64, c)
    again[0] = 7
    assert(column_of($i64, c)[0] == 7)
    column_free(c)
    assert(heap_live() == before)
}

// ---------------------------------------------------------------------------
// Entities, and the edges of them
// ---------------------------------------------------------------------------

test "a handle from nowhere is refused" {
    mut world := ecs_new()
    assert(ecs_alive(world, Entity { id = 0, generation = 0 }) == false)
    assert(ecs_alive(world, Entity { id = -1, generation = 0 }) == false)
    assert(ecs_alive(world, Entity { id = 4096, generation = 0 }) == false)
    assert(ecs_has(world, Entity { id = 9, generation = 0 }, 1) == false)
    ecs_free(world)
}

test "despawning twice is despawning once" {
    mut world := ecs_new()
    a := ecs_spawn(world)
    ecs_despawn(world, a)
    assert(ecs_count(world) == 0)
    ecs_despawn(world, a)
    assert(ecs_count(world) == 0)
    // The id is free once, not twice: the next two spawns are two entities.
    b := ecs_spawn(world)
    c := ecs_spawn(world)
    assert(b.id != c.id)
    assert(ecs_count(world) == 2)
    ecs_free(world)
}

test "ids come back in the order they were freed" {
    mut world := ecs_new()
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    ecs_despawn(world, a)
    ecs_despawn(world, b)
    // The free list is a stack, so the last one freed is the next one handed
    // out, which keeps a spawn from walking memory.
    next := ecs_spawn(world)
    assert(next.id == b.id)
    assert(next.generation == b.generation + 1)
    ecs_free(world)
}

test "many entities live at once" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    mut made : i64 = 0
    while (made < 200) {
        e := ecs_spawn(world)
        ecs_add($TestHealth, world, e, health, TestHealth { points = made })
        made = made + 1
    }
    assert(ecs_count(world) == 200)
    mut seen : i64 = 0
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        seen = seen + q.count
    }
    assert(seen == 200)
    ecs_free(world)
}

// ---------------------------------------------------------------------------
// The registry
// ---------------------------------------------------------------------------

test "components are given their indices in the order they registered" {
    mut world := ecs_new()
    first := ecs_register($TestPosition, world)
    second := ecs_register($TestVelocity, world)
    third := ecs_register($TestHealth, world)
    assert(first == 0)
    assert(second == 1)
    assert(third == 2)
    assert(ecs_component_size(world, first) == sizeof(TestPosition))
    assert(ecs_component_size(world, third) == sizeof(TestHealth))
    // A component nothing registered has no width.
    assert(ecs_component_size(world, 40) == 0)
    ecs_free(world)
}

test "a component past the ceiling is refused rather than given an index" {
    mut world := ecs_new()
    mut registered : i64 = 0
    while (registered < MAX_COMPONENTS) {
        assert(ecs_register($TestHealth, world) >= 0)
        registered = registered + 1
    }
    // -1 names no component, which is what says there was none left to give.
    assert(ecs_register($TestHealth, world) == -1)
    ecs_free(world)
}

// A world past the old ceiling of 64, which is the number a real program
// reaches. The last component registered behaves like the first: it takes a
// column, moves an entity to its own table, and reads back.
test "a component past the sixty-fourth still works" {
    mut world := ecs_new()
    mut registered : i64 = 0
    while (registered < 200) {
        ecs_register($TestHealth, world)
        registered = registered + 1
    }
    late := ecs_register($TestHealth, world)
    assert(late == 200)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, late, TestHealth { points = 9 })
    assert(ecs_has(world, a, late))
    assert(ecs_get($TestHealth, world, a, late).points == 9)
    // And a query finds it, which is the mask test over four words rather than
    // one.
    mut q := query_begin(world)
    query_with(q, late)
    mut seen : i64 = 0
    while (query_next(world, q)) {
        seen = seen + q.count
    }
    assert(seen == 1)
    ecs_free(world)
}

// Two components in different words of the mask, so the table test and the
// column position both cross a word boundary.
test "components in different mask words share a table" {
    mut world := ecs_new()
    mut registered : i64 = 0
    while (registered < 70) {
        ecs_register($TestHealth, world)
        registered = registered + 1
    }
    low := ecs_register($TestPosition, world)
    mut more : i64 = 0
    while (more < 60) {
        ecs_register($TestHealth, world)
        more = more + 1
    }
    high := ecs_register($TestVelocity, world)
    assert(low < 128)
    assert(high >= 128)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, low, TestPosition { x = 1, y = 2 })
    ecs_add($TestVelocity, world, a, high, TestVelocity { x = 3, y = 4 })
    assert(ecs_get($TestPosition, world, a, low).x == 1)
    assert(ecs_get($TestVelocity, world, a, high).y == 4)
    mut q := query_begin(world)
    query_with(q, low)
    query_with(q, high)
    mut seen : i64 = 0
    while (query_next(world, q)) {
        seen = seen + q.count
    }
    assert(seen == 1)
    ecs_free(world)
}

// The mask itself, as its own unit: setting, clearing, covering and
// disjointness across the word boundary.
test "a mask holds bits across its words" {
    empty := mask_empty()
    assert(mask_is_empty(empty))
    assert(mask_has(empty, 0) == false)

    low := mask_with(empty, 3)
    both := mask_with(low, 200)
    assert(mask_has(both, 3))
    assert(mask_has(both, 200))
    assert(mask_has(both, 4) == false)
    assert(mask_is_empty(both) == false)

    cleared := mask_without(both, 200)
    assert(mask_has(cleared, 3))
    assert(mask_has(cleared, 200) == false)
    // Clearing a bit that is not set changes nothing.
    assert(mask_has(mask_without(cleared, 200), 3))

    assert(mask_covers(both, low))
    assert(mask_covers(low, both) == false)
    assert(mask_covers(both, both))
    assert(mask_disjoint(low, mask_with(empty, 200)))
    assert(mask_disjoint(both, mask_with(empty, 200)) == false)

    joined := mask_or(low, mask_with(empty, 200))
    assert(mask_equal(joined, both))
    assert(mask_equal(joined, low) == false)

    // The column position counts the bits below, across words.
    assert(bits_below(both, 3) == 0)
    assert(bits_below(both, 200) == 1)
    assert(bits_below(mask_with(both, 100), 200) == 2)
}

// ---------------------------------------------------------------------------
// Components and the tables they move between
// ---------------------------------------------------------------------------

test "adding a component twice overwrites rather than moves" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    before := vec_len($Table, world.tables)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 2 })
    assert(ecs_get($TestHealth, world, a, health).points == 2)
    assert(vec_len($Table, world.tables) == before)
    ecs_free(world)
}

test "a component given to a despawned entity is not given" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_despawn(world, a)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 5 })
    assert(ecs_has(world, a, health) == false)
    ecs_remove(world, a, health)
    assert(ecs_alive(world, a) == false)
    ecs_free(world)
}

test "removing a component an entity does not hold changes nothing" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 3.0, y = 4.0 })
    ecs_remove(world, a, health)
    assert(ecs_has(world, a, position))
    assert(ecs_get($TestPosition, world, a, position).x == 3.0)
    ecs_free(world)
}

test "an entity walks back to the empty table when its last component goes" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 9 })
    ecs_remove(world, a, health)
    assert(ecs_has(world, a, health) == false)
    assert(ecs_alive(world, a))
    assert(ecs_count(world) == 1)
    // And it can be given the component again.
    ecs_add($TestHealth, world, a, health, TestHealth { points = 10 })
    assert(ecs_get($TestHealth, world, a, health).points == 10)
    ecs_free(world)
}

test "a table is made once for a set of components however many hold it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 0.0, y = 0.0 })
    settled := vec_len($Table, world.tables)
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 1.0, y = 1.0 })
    ecs_add($TestVelocity, world, b, velocity,
        TestVelocity { x = 1.0, y = 1.0 })
    assert(vec_len($Table, world.tables) == settled)
    ecs_free(world)
}

test "the row a despawn moves keeps every one of its components" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    c := ecs_spawn(world)
    mut which : i64 = 0
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 1.0, y = 1.0 })
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 2.0, y = 2.0 })
    ecs_add($TestHealth, world, b, health, TestHealth { points = 2 })
    ecs_add($TestPosition, world, c, position,
        TestPosition { x = 3.0, y = 3.0 })
    ecs_add($TestHealth, world, c, health, TestHealth { points = 3 })
    ecs_despawn(world, a)
    // `c` filled the hole, and both of its columns came with it.
    assert(ecs_get($TestPosition, world, c, position).x == 3.0)
    assert(ecs_get($TestHealth, world, c, health).points == 3)
    assert(ecs_get($TestPosition, world, b, position).x == 2.0)
    assert(ecs_get($TestHealth, world, b, health).points == 2)
    ecs_free(world)
}

// ---------------------------------------------------------------------------
// Queries, ticks, resources
// ---------------------------------------------------------------------------

test "a query over a world with nothing in it visits nothing" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    mut visits : i64 = 0
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        visits = visits + 1
    }
    assert(visits == 0)
    // And once the last holder is gone, it visits nothing again: an empty table
    // is skipped rather than handed over.
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_despawn(world, a)
    mut again : i64 = 0
    mut second := query_begin(world)
    query_with(second, health)
    while (query_next(world, second)) {
        again = again + 1
    }
    assert(again == 0)
    ecs_free(world)
}

test "the entities a query hands over line up with its columns" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    mut made : i64 = 0
    while (made < 8) {
        e := ecs_spawn(world)
        ecs_add($TestHealth, world, e, health, TestHealth { points = e.id })
        made = made + 1
    }
    mut checked : i64 = 0
    mut q := query_begin(world)
    query_with(q, health)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        points := query_column($TestHealth, world, q, health)
        stamps := query_changed(world, q, health)
        assert(slice_len(entities) == q.count)
        assert(slice_len(points) == q.count)
        assert(slice_len(stamps) == q.count)
        mut i : i64 = 0
        while (i < q.count) {
            // The component holds the id of the entity beside it, so a walk
            // that lost its place would show here.
            assert(points[i].points == entities[i].id)
            i = i + 1
        }
        checked = checked + q.count
    }
    assert(checked == 8)
    ecs_free(world)
}

test "a component nothing asked about has no change to report" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    // The entity does not hold this one, so nothing about it changed.
    assert(ecs_changed_since(world, a, health, 0) == false)
    assert(ecs_added_since(world, a, health, 0) == false)
    ecs_free(world)
}

test "removing a component and giving it back marks it added again" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_remove(world, a, health)
    watermark := ecs_tick(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 2 })
    assert(ecs_added_since(world, a, health, watermark - 1))
    assert(ecs_changed_since(world, a, health, watermark - 1))
    assert(ecs_get($TestHealth, world, a, health).points == 2)
    ecs_free(world)
}

test "the clock only moves when it is told to" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    at := ecs_now(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_set($TestHealth, world, a, health, TestHealth { points = 2 })
    assert(ecs_now(world) == at)
    assert(ecs_tick(world) == at + 1)
    assert(ecs_now(world) == at + 1)
    ecs_free(world)
}

test "a resource is written through its slice and read back whole" {
    mut world := ecs_new()
    order := ecs_resource_register($TestOrder, world)
    damage := ecs_resource_register($TestDamage, world)
    // The slots are handed out in order and stay apart.
    assert(order == 0)
    assert(damage == 1)
    mut held := ecs_resource_slice($TestOrder, world, order)
    held[0].steps = 11
    assert(ecs_resource($TestOrder, world, order).steps == 11)
    ecs_resource_set($TestDamage, world, damage, TestDamage { amount = 3 })
    assert(ecs_resource($TestOrder, world, order).steps == 11)
    assert(ecs_resource($TestDamage, world, damage).amount == 3)
    ecs_free(world)
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

test "a channel grows past what it was made with" {
    mut channel := events_new($TestDamage)
    mut sent : i64 = 0
    while (sent < 300) {
        events_send($TestDamage, channel, TestDamage { amount = sent })
        sent = sent + 1
    }
    assert(events_sent(channel) == 300)
    held := events_slice($TestDamage, channel)
    assert(slice_len(held) == 300)
    assert(held[0].amount == 0)
    assert(held[299].amount == 299)
    events_free(channel)
}

test "a reader that has caught up sees the next one sent" {
    mut channel := events_new($TestDamage)
    mut reader := reader_new()
    assert(slice_len(events_read($TestDamage, channel, reader)) == 0)
    events_send($TestDamage, channel, TestDamage { amount = 1 })
    first := events_read($TestDamage, channel, reader)
    assert(slice_len(first) == 1)
    assert(slice_len(events_read($TestDamage, channel, reader)) == 0)
    events_send($TestDamage, channel, TestDamage { amount = 2 })
    second := events_read($TestDamage, channel, reader)
    assert(slice_len(second) == 1)
    assert(second[0].amount == 2)
    events_free(channel)
}

test "clearing an empty channel leaves the sequence where it was" {
    mut channel := events_new($TestDamage)
    events_clear(channel)
    assert(events_sent(channel) == 0)
    events_send($TestDamage, channel, TestDamage { amount = 4 })
    events_clear(channel)
    assert(events_sent(channel) == 1)
    assert(slice_len(events_slice($TestDamage, channel)) == 0)
    events_free(channel)
}

// ---------------------------------------------------------------------------
// Tags, commands, hierarchy, schedules
// ---------------------------------------------------------------------------

test "a tag on a high id grows the marks to reach it" {
    mut world := ecs_new()
    mut marks := tag_new()
    mut made : i64 = 0
    mut last := ecs_spawn(world)
    while (made < 100) {
        last = ecs_spawn(world)
        made = made + 1
    }
    tag_add(marks, last)
    assert(tag_has(marks, last))
    // And an id the marks never reached is unmarked rather than out of range.
    assert(tag_has(marks, Entity { id = 5000, generation = 0 }) == false)
    tag_remove(marks, Entity { id = 5000, generation = 0 })
    tag_free(marks)
    ecs_free(world)
}

test "a command buffer applied twice does nothing the second time" {
    mut world := ecs_new()
    a := ecs_spawn(world)
    mut queued := commands_new()
    commands_spawn(queued)
    commands_despawn(queued, a)
    commands_apply(queued, world)
    after := ecs_count(world)
    assert(after == 1)
    commands_apply(queued, world)
    assert(ecs_count(world) == after)
    commands_free(queued)
    ecs_free(world)
}

test "a child taken off its parent is a child of nobody" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    parent := ecs_spawn(world)
    child := ecs_spawn(world)
    hierarchy_attach(tree, child, parent)
    hierarchy_detach(tree, child)
    assert(is_no_entity(hierarchy_parent(tree, child)))
    assert(hierarchy_child_count(tree, parent) == 0)
    assert(is_no_entity(hierarchy_first_child(tree, parent)))
    // Detaching one that is attached to nothing is not an error.
    hierarchy_detach(tree, child)
    assert(hierarchy_child_count(tree, parent) == 0)
    hierarchy_free(tree)
    ecs_free(world)
}

test "a child in the middle of a parent's list comes out of it" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    parent := ecs_spawn(world)
    first := ecs_spawn(world)
    middle := ecs_spawn(world)
    last := ecs_spawn(world)
    hierarchy_attach(tree, first, parent)
    hierarchy_attach(tree, middle, parent)
    hierarchy_attach(tree, last, parent)
    assert(hierarchy_child_count(tree, parent) == 3)
    hierarchy_detach(tree, middle)
    assert(hierarchy_child_count(tree, parent) == 2)
    // The two that are left are still reachable from the head.
    mut walk := hierarchy_first_child(tree, parent)
    mut found_first : bool = false
    mut found_last : bool = false
    while (is_no_entity(walk) == false) {
        if (walk.id == first.id) { found_first = true }
        if (walk.id == last.id) { found_last = true }
        walk = hierarchy_next_sibling(tree, walk)
    }
    assert(found_first)
    assert(found_last)
    hierarchy_free(tree)
    ecs_free(world)
}

test "a tree several deep is despawned to the root" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    // A fresh handle rather than the name: binding a struct to a second name
    // moves it, and the root is wanted again at the end.
    mut parent := Entity { id = root.id, generation = root.generation }
    mut depth : i64 = 0
    while (depth < 8) {
        child := ecs_spawn(world)
        hierarchy_attach(tree, child, parent)
        parent = child
        depth = depth + 1
    }
    assert(ecs_count(world) == 9)
    hierarchy_despawn_tree(tree, world, root)
    assert(ecs_count(world) == 0)
    hierarchy_free(tree)
    ecs_free(world)
}

test "despawning a leaf leaves the rest of the tree standing" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    keep := ecs_spawn(world)
    drop := ecs_spawn(world)
    hierarchy_attach(tree, keep, root)
    hierarchy_attach(tree, drop, root)
    hierarchy_despawn_tree(tree, world, drop)
    assert(ecs_alive(world, drop) == false)
    assert(ecs_alive(world, keep))
    assert(ecs_alive(world, root))
    assert(hierarchy_child_count(tree, root) == 1)
    hierarchy_free(tree)
    ecs_free(world)
}

test "an empty schedule runs nothing and says so" {
    mut world := ecs_new()
    mut frame := schedule_new()
    assert(schedule_count(frame) == 0)
    schedule_run(frame, world, ANY_STATE)
    assert(ecs_count(world) == 0)
    schedule_free(frame)
    ecs_free(world)
}

test "every stage runs, in the order the stages are written" {
    mut world := ecs_new()
    ecs_resource_register($TestOrder, world)
    mut frame := schedule_new()
    // Added back to front, so only the stage can put them right.
    schedule_add(frame, Stage::Last, third_system)
    schedule_add(frame, Stage::Update, second_system)
    schedule_add(frame, Stage::First, first_system)
    assert(schedule_count(frame) == 3)
    schedule_run(frame, world, ANY_STATE)
    // first: 0 * 2 + 1 = 1, second: 1 * 2 = 2, third: 2 * 3 = 6.
    assert(ecs_resource($TestOrder, world, 0).steps == 6)
    schedule_free(frame)
    ecs_free(world)
}

test "a system runs once per pass over its stage" {
    mut world := ecs_new()
    mut frame := schedule_new()
    schedule_add(frame, Stage::Update, spawning_system)
    schedule_run(frame, world, ANY_STATE)
    assert(ecs_count(world) == 1)
    schedule_run(frame, world, ANY_STATE)
    assert(ecs_count(world) == 2)
    schedule_free(frame)
    ecs_free(world)
}

test "a state that was asked for and not applied changes nothing" {
    mut states := states_new(3)
    assert(states_current(states) == 3)
    states_request(states, 3)
    assert(states_apply(states) == false)
    assert(states_current(states) == 3)
    states_request(states, 4)
    states_request(states, 5)
    // The last word wins, and one apply is what takes it.
    assert(states_apply(states))
    assert(states_current(states) == 5)
    assert(states_apply(states) == false)
}

test "time accumulates rather than replacing" {
    mut clock := time_new()
    assert(clock.frame == 0)
    assert(clock.elapsed == 0.0)
    time_advance(clock, 0.5)
    time_advance(clock, 0.5)
    time_advance(clock, 1.0)
    assert(clock.frame == 3)
    assert(clock.delta == 1.0)
    assert(clock.elapsed == 2.0)
}

third_system :: fn(mut world: World) {
    held := ecs_resource($TestOrder, world, 0)
    ecs_resource_set($TestOrder, world, 0, TestOrder { steps = held.steps * 3 })
}


// ---------------------------------------------------------------------------
// The query, and what it asks for
// ---------------------------------------------------------------------------

TestFrozen :: struct { held: i64 }

test_hold :: fn(mut p: []TestPosition, count: i64) {
    mut i : i64 = 0
    while (i < count) {
        p[i].x = p[i].x + 100.0
        i = i + 1
    }
}

test_three :: fn(mut p: []TestPosition, v: []TestVelocity, h: []TestHealth,
    count: i64) {
    mut i : i64 = 0
    while (i < count) {
        p[i].x = p[i].x + v[i].x + h[i].points
        i = i + 1
    }
}

test_one_row :: fn(mut p: []TestPosition, row: i64) {
    p[row].y = p[row].y + 1000.0
}

// One `for_each` serves any number of components, so a body taking three is a
// third element and a third parameter and nothing else.
test "a query over three components reads all three" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position, TestPosition { x = 1.0, y = 0.0 })
    ecs_add($TestVelocity, world, a, velocity, TestVelocity { x = 2.0, y = 0.0 })
    ecs_add($TestHealth, world, a, health, TestHealth { points = 3 })
    // And one that holds only two, which the query must not visit.
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position, TestPosition { x = 9.0, y = 0.0 })
    ecs_add($TestVelocity, world, b, velocity, TestVelocity { x = 9.0, y = 0.0 })

    for_each($test_three, world, no_filters(), $TestPosition, $TestVelocity,
        $TestHealth)

    assert(ecs_get($TestPosition, world, a, position).x == 6.0)
    assert(ecs_get($TestPosition, world, b, position).x == 9.0)
    ecs_free(world)
}

// `without` is a table-level test: an entity holding the excluded component is
// in another archetype, so the query never reaches its rows.
test "a query without a component skips the tables that hold it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    frozen := ecs_register($TestFrozen, world)
    moving := ecs_spawn(world)
    ecs_add($TestPosition, world, moving, position,
        TestPosition { x = 1.0, y = 0.0 })
    still := ecs_spawn(world)
    ecs_add($TestPosition, world, still, position,
        TestPosition { x = 1.0, y = 0.0 })
    ecs_add($TestFrozen, world, still, frozen, TestFrozen { held = 1 })

    for_each($test_hold, world, filter_without(no_filters(), frozen),
        $TestPosition)

    assert(ecs_get($TestPosition, world, moving, position).x == 101.0)
    assert(ecs_get($TestPosition, world, still, position).x == 1.0)
    ecs_free(world)
}

// A tag is row-level whatever else is asked, since nothing about a table says
// which of its rows carry one. Both entities are in the same archetype here,
// which is the case a table-level test could not tell apart.
test "a query for a tag visits only the rows carrying it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut chosen := tag_new()

    marked_entity := ecs_spawn(world)
    ecs_add($TestPosition, world, marked_entity, position,
        TestPosition { x = 1.0, y = 0.0 })
    plain := ecs_spawn(world)
    ecs_add($TestPosition, world, plain, position,
        TestPosition { x = 1.0, y = 0.0 })
    tag_add(chosen, marked_entity)

    for_each_row($test_one_row, world, filter_tagged(no_filters(), chosen),
        $TestPosition)

    assert(ecs_get($TestPosition, world, marked_entity, position).y == 1000.0)
    assert(ecs_get($TestPosition, world, plain, position).y == 0.0)

    // And the other way round, which visits the rows the first run skipped.
    for_each_row($test_one_row, world, filter_untagged(no_filters(), chosen),
        $TestPosition)

    assert(ecs_get($TestPosition, world, marked_entity, position).y == 1000.0)
    assert(ecs_get($TestPosition, world, plain, position).y == 1000.0)

    tag_free(chosen)
    ecs_free(world)
}

// A tag left on a despawned id is not a mark on whatever gets the id next, and
// a filter has to see that the same way `tag_has` does.
test "a query for a tag does not read a stale mark" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut chosen := tag_new()

    first := ecs_spawn(world)
    ecs_add($TestPosition, world, first, position,
        TestPosition { x = 1.0, y = 0.0 })
    tag_add(chosen, first)
    ecs_despawn(world, first)

    reused := ecs_spawn(world)
    ecs_add($TestPosition, world, reused, position,
        TestPosition { x = 1.0, y = 0.0 })
    assert(reused.id == first.id)
    assert(tag_has(chosen, reused) == false)

    for_each_row($test_one_row, world, filter_tagged(no_filters(), chosen),
        $TestPosition)

    assert(ecs_get($TestPosition, world, reused, position).y == 0.0)
    tag_free(chosen)
    ecs_free(world)
}

// `changed` is a row-level test, so the table is still walked and what it saves
// is the body.
test "a query for changed rows skips the rows nothing touched" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position, TestPosition { x = 0.0, y = 0.0 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position, TestPosition { x = 0.0, y = 0.0 })
    mark := ecs_now(world)
    ecs_tick(world)
    // Only one of them is written after the mark.
    ecs_set($TestPosition, world, a, position, TestPosition { x = 5.0, y = 0.0 })

    for_each_row($test_one_row, world,
        filter_changed(no_filters(), position, mark), $TestPosition)

    assert(ecs_get($TestPosition, world, a, position).y == 1000.0)
    assert(ecs_get($TestPosition, world, b, position).y == 0.0)
    ecs_free(world)
}

// `added` asks a different question from `changed`: when the component arrived
// rather than when it was last written.
test "a query for added rows finds the ones given the component since" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    early := ecs_spawn(world)
    ecs_add($TestPosition, world, early, position,
        TestPosition { x = 0.0, y = 0.0 })
    mark := ecs_now(world)
    ecs_tick(world)
    late := ecs_spawn(world)
    ecs_add($TestPosition, world, late, position,
        TestPosition { x = 0.0, y = 0.0 })

    for_each_row($test_one_row, world,
        filter_added(no_filters(), position, mark), $TestPosition)

    assert(ecs_get($TestPosition, world, late, position).y == 1000.0)
    assert(ecs_get($TestPosition, world, early, position).y == 0.0)
    ecs_free(world)
}

// Every kind of filter in one query: two components read, one excluded at the
// table level, and one tick tested per row.
test "with, without and changed in one query" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    frozen := ecs_register($TestFrozen, world)

    // Reads, changed since the mark: visited.
    wanted := ecs_spawn(world)
    ecs_add($TestPosition, world, wanted, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, wanted, velocity,
        TestVelocity { x = 1.0, y = 0.0 })
    // The same, but frozen: skipped with its whole table.
    held := ecs_spawn(world)
    ecs_add($TestPosition, world, held, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, held, velocity,
        TestVelocity { x = 1.0, y = 0.0 })
    ecs_add($TestFrozen, world, held, frozen, TestFrozen { held = 1 })
    // The same, unfrozen, but not written since the mark: skipped by its row.
    quiet := ecs_spawn(world)
    ecs_add($TestPosition, world, quiet, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, quiet, velocity,
        TestVelocity { x = 1.0, y = 0.0 })

    mark := ecs_now(world)
    ecs_tick(world)
    ecs_set($TestVelocity, world, wanted, velocity,
        TestVelocity { x = 1.0, y = 0.0 })
    ecs_set($TestVelocity, world, held, velocity,
        TestVelocity { x = 1.0, y = 0.0 })

    mut f := no_filters()
    f = filter_without(f, frozen)
    f = filter_changed(f, velocity, mark)
    for_each_row($test_one_row, world, f, $TestPosition)

    assert(ecs_get($TestPosition, world, wanted, position).y == 1000.0)
    assert(ecs_get($TestPosition, world, held, position).y == 0.0)
    assert(ecs_get($TestPosition, world, quiet, position).y == 0.0)
    ecs_free(world)
}

// A component named by a type it was never registered under is a query that
// would otherwise match nothing and say nothing.
test "a component is found by the type it registered under" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    assert(component_of($TestPosition, world) == position)
    assert(component_of($TestVelocity, world) == velocity)
    ecs_free(world)
}

// The pattern a game laid over an engine uses: the engine's components in one
// member, the game's in another, one identity across both. Nothing links them
// and nothing copies between them.
EngineTransform :: struct { x: f32, y: f32 }
EngineVisible :: struct { shown: bool }
GameHealth :: struct { points: i64 }
GameSpeed :: struct { rate: f32 }
GameSelected :: struct { held: i64 }

test "a member world holds what another member does not" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    entity := group_spawn(g)
    group_set($EngineTransform, g, entity, EngineTransform { x = 3.0, y = 4.0 })
    group_set($GameHealth, g, entity, GameHealth { points = 75 })

    assert(group_has($EngineTransform, g, entity))
    assert(group_has($GameHealth, g, entity))
    assert(group_get($EngineTransform, g, entity).x == 3.0)
    assert(group_get($GameHealth, g, entity).points == 75)
    group_free(g)
}

// An entity the engine knows about and the game has nothing to say about. The
// row in the game's member is never made, which is the point of the member
// being separate rather than a wider mask.
test "an entity with nothing in a member has no row there" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    bare := group_spawn(g)
    group_set($EngineTransform, g, bare, EngineTransform { x = 1.0, y = 1.0 })
    assert(group_has($GameHealth, g, bare) == false)
    ref game_world := group_members(g)[game]
    assert(ecs_count(game_world) == 0)

    both := group_spawn(g)
    group_set($GameHealth, g, both, GameHealth { points = 1 })
    assert(ecs_count(game_world) == 1)
    group_free(g)
}

// One despawn, every member. This is what makes the identity the group's: an
// entity is one thing however many members hold a piece of it.
test "one despawn takes the rows out of every member" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    entity := group_spawn(g)
    group_set($EngineTransform, g, entity, EngineTransform { x = 2.0, y = 0.0 })
    group_set($GameHealth, g, entity, GameHealth { points = 30 })
    ref engine_world := group_members(g)[engine]
    ref game_world := group_members(g)[game]
    assert(ecs_count(engine_world) == 1)
    assert(ecs_count(game_world) == 1)

    assert(group_despawn(g, entity))
    assert(group_alive(g, entity) == false)
    assert(ecs_count(engine_world) == 0)
    assert(ecs_count(game_world) == 0)
    assert(group_count(g) == 0)
    assert(group_despawn(g, entity) == false)
    group_free(g)
}

// A handle that outlived its entity is refused everywhere, not only where the
// group keeps its generation.
test "a stale handle is refused by every member" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    first := group_spawn(g)
    group_set($EngineTransform, g, first, EngineTransform { x = 5.0, y = 5.0 })
    group_set($GameHealth, g, first, GameHealth { points = 9 })
    group_despawn(g, first)

    second := group_spawn(g)
    assert(second.id == first.id)
    assert(second.generation == first.generation + 1)
    assert(group_alive(g, first) == false)
    assert(group_has($GameHealth, g, first) == false)
    ref game_world := group_members(g)[game]
    assert(ecs_alive(game_world, first) == false)
    group_free(g)
}

// The join: one member drives the walk and the other is read per entity. There
// is no cursor holding both, because a borrow cannot be stored, so what crosses
// the boundary is an entity and the read is routed.
test "a walk of one member reads what another member holds" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    transform := group_register($EngineTransform, g, engine)
    group_register($GameSpeed, g, game)

    mut made : [3]Entity = [no_entity(); 3]
    mut index : i64 = 0
    while (index < 3) {
        entity := group_spawn(g)
        held : f32 = index
        group_set($EngineTransform, g, entity,
            EngineTransform { x = held, y = 0.0 })
        group_set($GameSpeed, g, entity, GameSpeed { rate = held + 1.0 })
        made[index] = entity
        index = index + 1
    }

    // The engine's member drives, since the walk has to be over somebody's
    // tables, and the game's rate is read for each entity the walk names.
    mut total : f32 = 0.0
    ref world := group_members(g)[engine]
    mut q := query_begin(world)
    query_with(q, transform)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        placed := query_column($EngineTransform, world, q, transform)
        mut row : i64 = 0
        while (row < q.count) {
            rate := group_get($GameSpeed, g, entities[row]).rate
            total = total + placed[row].x * rate
            row = row + 1
        }
    }
    // 0*1 + 1*2 + 2*3
    assert(total == 8.0)
    group_free(g)
}

// A write through the join, which is the half a read cannot do: the driving
// walk gathers, and the routed writes happen after it, because a write into
// another member can move rows the walk is standing on.
test "a join gathers first and writes after" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    transform := group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    mut index : i64 = 0
    while (index < 4) {
        entity := group_spawn(g)
        held : f32 = index
        group_set($EngineTransform, g, entity,
            EngineTransform { x = held, y = 0.0 })
        index = index + 1
    }

    // Two passes, which is what the language asks for anyway: gathering into a
    // small buffer and then applying is how a structural change is made while
    // something is being walked.
    mut gathered := vec_new($Entity, 4)
    ref world := group_members(g)[engine]
    mut q := query_begin(world)
    query_with(q, transform)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        placed := query_column($EngineTransform, world, q, transform)
        mut row : i64 = 0
        while (row < q.count) {
            if (placed[row].x > 1.0) {
                vec_push($Entity, gathered, entities[row])
            }
            row = row + 1
        }
    }
    mut taken : i64 = 0
    while (taken < vec_len($Entity, gathered)) {
        entity := vec_get($Entity, gathered, taken)
        group_set($GameHealth, g, entity, GameHealth { points = 100 })
        taken = taken + 1
    }
    assert(vec_len($Entity, gathered) == 2)
    ref game_world := group_members(g)[game]
    assert(ecs_count(game_world) == 2)
    vec_free($Entity, gathered)
    group_free(g)
}

// A tag the group carries, which no member's mask has a bit for. Adding one
// moves no rows, and it goes when the entity does.
test "a group tag marks an entity without moving a row" {
    mut g := group_new()
    engine := group_add_world(g)
    transform := group_register($EngineTransform, g, engine)

    entity := group_spawn(g)
    group_set($EngineTransform, g, entity, EngineTransform { x = 0.0, y = 0.0 })
    ref world := group_members(g)[engine]
    before := vec_slice($EntitySlot, world.slots)[entity.id]

    assert(group_has_tag($GameSelected, g, entity) == false)
    group_add_tag($GameSelected, g, entity)
    assert(group_has_tag($GameSelected, g, entity))

    after := vec_slice($EntitySlot, world.slots)[entity.id]
    assert(before.table == after.table)
    assert(before.row == after.row)
    assert(ecs_has(world, entity, transform))

    group_remove_tag($GameSelected, g, entity)
    assert(group_has_tag($GameSelected, g, entity) == false)
    group_free(g)
}

test "a group tag is dropped when the entity dies" {
    mut g := group_new()
    engine := group_add_world(g)
    group_register($EngineTransform, g, engine)

    first := group_spawn(g)
    group_add_tag($GameSelected, g, first)
    assert(group_has_tag($GameSelected, g, first))
    group_despawn(g, first)

    second := group_spawn(g)
    assert(second.id == first.id)
    assert(group_has_tag($GameSelected, g, second) == false)
    group_free(g)
}

// Which member owns a type is where it was registered, and asking is how a
// write finds the column without anything mapping types to members by hand.
test "a component routes to the member it was registered in" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    transform := group_register($EngineTransform, g, engine)
    health := group_register($GameHealth, g, game)

    first := group_route($EngineTransform, g)
    second := group_route($GameHealth, g)
    assert(first.member == engine)
    assert(first.component == transform)
    assert(second.member == game)
    assert(second.component == health)
    // Both members number their own components from zero, which is why a route
    // is a pair rather than an index.
    assert(transform == 0)
    assert(health == 0)

    missing := group_route($GameSpeed, g)
    assert(route_found(missing) == false)
    group_free(g)
}

// The group's log says an identity came or went. What a row did inside a member
// is that member's log, and the two answer different questions.
test "the group log records identities and the member log records rows" {
    mut g := group_new()
    engine := group_add_world(g)
    transform := group_register($EngineTransform, g, engine)
    group_log_enable(g, true)
    ref member := vec_slice($World, g.members)[engine]
    ecs_log_enable(member, true)

    entity := group_spawn(g)
    group_set($EngineTransform, g, entity, EngineTransform { x = 0.0, y = 0.0 })

    identities := group_log(g)
    assert(slice_len(identities) == 1)
    assert(identities[0].kind == ChangeKind::Spawn)

    rows := ecs_log(member)
    mut added : i64 = 0
    mut held : i64 = 0
    while (held < slice_len(rows)) {
        if (rows[held].kind == ChangeKind::Add
            && rows[held].component == transform) {
            added = added + 1
        }
        held = held + 1
    }
    assert(added == 1)
    group_free(g)
}

// Three members, which is the engine's core, its interface and a game's own.
test "a group holds more than two members" {
    mut g := group_new()
    core := group_add_world(g)
    interface := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, core)
    group_register($EngineVisible, g, interface)
    group_register($GameHealth, g, game)
    assert(group_world_count(g) == 3)

    entity := group_spawn(g)
    group_set($EngineTransform, g, entity, EngineTransform { x = 7.0, y = 8.0 })
    group_set($EngineVisible, g, entity, EngineVisible { shown = true })
    group_set($GameHealth, g, entity, GameHealth { points = 12 })

    assert(group_get($EngineTransform, g, entity).y == 8.0)
    assert(group_get($EngineVisible, g, entity).shown)
    assert(group_get($GameHealth, g, entity).points == 12)

    group_despawn(g, entity)
    ref core_world := group_members(g)[core]
    ref interface_world := group_members(g)[interface]
    ref game_world := group_members(g)[game]
    assert(ecs_count(core_world) == 0)
    assert(ecs_count(interface_world) == 0)
    assert(ecs_count(game_world) == 0)
    group_free(g)
}

// A pass that reads every row and writes none should cost nothing, which is
// why a raw walk does not stamp. This is the half that says so.
// A pass that reads every row and writes none should cost nothing, which is
// why a raw walk does not stamp. This is the half that says so.
test "a raw walk leaves the write times alone" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut index : i64 = 0
    while (index < 3) {
        entity := ecs_spawn(world)
        ecs_add($TestPosition, world, entity, position,
            TestPosition { x = 0.0, y = 0.0 })
        index = index + 1
    }
    mark := ecs_now(world)
    ecs_tick(world)

    // Written through the raw slice, which reaches the bytes without going
    // past the tick beside them.
    mut q := query_begin(world)
    query_with(q, position)
    while (query_next(world, q)) {
        mut held := ecs_slice($TestPosition, world, q.table, position)
        mut row : i64 = 0
        while (row < q.count) {
            held[row].x = 5.0
            row = row + 1
        }
    }

    mut seen : i64 = 0
    mut walk := query_begin(world)
    query_with(walk, position)
    query_filter(walk, filter_changed(no_filters(), position, mark))
    while (query_next(world, walk)) {
        mut row : i64 = 0
        while (row < walk.count) {
            if (query_row_passes(world, walk, row)) {
                seen = seen + 1
            }
            row = row + 1
        }
    }
    assert(seen == 0)
    ecs_free(world)
}

// And the half that opts in. The same pass, saying afterwards which rows it
// wrote, and a watcher seeing exactly those.
test "a raw walk marks the rows it wrote" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut held : [3]Entity = [no_entity(); 3]
    mut index : i64 = 0
    while (index < 3) {
        entity := ecs_spawn(world)
        ecs_add($TestPosition, world, entity, position,
            TestPosition { x = 0.0, y = 0.0 })
        held[index] = entity
        index = index + 1
    }
    mark := ecs_now(world)
    ecs_tick(world)

    mut items := ecs_slice($TestPosition, world, 1, position)
    items[0].x = 9.0
    ecs_mark_changed(world, held[0], position)

    mut seen : i64 = 0
    mut walk := query_begin(world)
    query_with(walk, position)
    query_filter(walk, filter_changed(no_filters(), position, mark))
    while (query_next(world, walk)) {
        mut row : i64 = 0
        while (row < walk.count) {
            if (query_row_passes(world, walk, row)) {
                seen = seen + 1
            }
            row = row + 1
        }
    }
    assert(seen == 1)
    ecs_free(world)
}

test "a whole column is marked at once" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut index : i64 = 0
    while (index < 4) {
        entity := ecs_spawn(world)
        ecs_add($TestPosition, world, entity, position,
            TestPosition { x = 0.0, y = 0.0 })
        index = index + 1
    }
    mark := ecs_now(world)
    ecs_tick(world)
    ecs_mark_column(world, 1, position)

    mut seen : i64 = 0
    mut walk := query_begin(world)
    query_with(walk, position)
    query_filter(walk, filter_changed(no_filters(), position, mark))
    while (query_next(world, walk)) {
        mut row : i64 = 0
        while (row < walk.count) {
            if (query_row_passes(world, walk, row)) {
                seen = seen + 1
            }
            row = row + 1
        }
    }
    assert(seen == 4)
    ecs_free(world)
}

test "a bundle spawns straight into its archetype" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)

    entity := ecs_spawn_bundle(world, $TestPosition, $TestVelocity)
    assert(ecs_has(world, entity, position))
    assert(ecs_has(world, entity, velocity))
    assert(ecs_has(world, entity, health) == false)

    // One table for the empty archetype and one for this bundle. A walk into
    // it would have made two more on the way.
    assert(vec_len($Table, world.tables) == 2)
    ecs_free(world)
}

test "a bundle mask is the components it names" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    ecs_register($TestHealth, world)
    wanted := mask_of(world, $TestPosition, $TestVelocity)
    assert(mask_has(wanted, position))
    assert(mask_has(wanted, velocity))
    assert(mask_has(wanted, 2) == false)
    ecs_free(world)
}

// A whole bundle leaves in one migration, and what it takes off is the part the
// entity actually had.
test "a bundle comes off in one go" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)

    entity := ecs_spawn_bundle(world, $TestPosition, $TestVelocity,
        $TestHealth)
    assert(ecs_has_bundle(world, entity, $TestPosition, $TestVelocity))

    ecs_remove_bundle(world, entity, $TestPosition, $TestVelocity)
    assert(ecs_has(world, entity, position) == false)
    assert(ecs_has(world, entity, velocity) == false)
    assert(ecs_has(world, entity, health))
    assert(ecs_has_bundle(world, entity, $TestPosition, $TestVelocity)
        == false)

    // A component the entity does not hold is not an error, and what is left
    // still is.
    ecs_remove_bundle(world, entity, $TestPosition, $TestHealth)
    assert(ecs_has(world, entity, health) == false)
    assert(ecs_alive(world, entity))
    ecs_free(world)
}

// A component is found by the name the compiler knows it by, which is what an
// editor and a save file both read.
test "a component is found by its name" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)

    assert(ecs_component_by_name(world, "TestPosition") == position)
    assert(ecs_component_by_name(world, "TestHealth") == health)
    assert(ecs_component_by_name(world, "TestVelocity") == (-1))
    assert(str_eq(ecs_component_name(world, position), "TestPosition"))
    assert(str_eq(ecs_component_name(world, 99), ""))
    ecs_free(world)
}

// The singleton read: one entity answers, none and several answer with nothing,
// so a scene that grew a second one fails where it is read.
test "a single match answers and an ambiguous one does not" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    ecs_register($TestHealth, world)

    assert(is_no_entity(ecs_single(world, no_filters(), $TestPosition)))

    first := ecs_spawn(world)
    ecs_add($TestPosition, world, first, position,
        TestPosition { x = 1.0, y = 0.0 })
    found := ecs_single(world, no_filters(), $TestPosition)
    assert(found.id == first.id)

    second := ecs_spawn(world)
    ecs_add($TestPosition, world, second, position,
        TestPosition { x = 2.0, y = 0.0 })
    assert(is_no_entity(ecs_single(world, no_filters(), $TestPosition)))
    ecs_free(world)
}

// Gathering names every entity a query would visit, which is the first half of
// the two-pass shape a structural change needs. Counting agrees with it.
test "a gather names every row a walk would visit" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)

    mut made : i64 = 0
    while (made < 5) {
        entity := ecs_spawn(world)
        ecs_add($TestPosition, world, entity, position,
            TestPosition { x = 0.0, y = 0.0 })
        // Two of them land in a second archetype, so the gather is over more
        // than one table.
        if (made < 2) {
            ecs_add($TestHealth, world, entity, health,
                TestHealth { points = 1 })
        }
        made = made + 1
    }

    assert(ecs_count_matching(world, no_filters(), $TestPosition) == 5)
    assert(ecs_count_matching(world, no_filters(), $TestHealth) == 2)

    mut gathered := ecs_gather(world, no_filters(), $TestPosition)
    held := vec_slice($Entity, gathered)
    assert(slice_len(held) == 5)
    // Every one of them is alive and distinct, which is what a second pass
    // over the gather relies on.
    mut index : i64 = 0
    while (index < slice_len(held)) {
        assert(ecs_alive(world, held[index]))
        mut other := index + 1
        while (other < slice_len(held)) {
            assert(held[index].id != held[other].id)
            other = other + 1
        }
        index = index + 1
    }
    vec_free($Entity, gathered)
    ecs_free(world)
}

// Every unordered pair, once each, which is what a check between each thing and
// every other thing walks.
test "a pair walk names each pair once" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut made : i64 = 0
    while (made < 4) {
        entity := ecs_spawn(world)
        ecs_add($TestPosition, world, entity, position,
            TestPosition { x = 0.0, y = 0.0 })
        made = made + 1
    }

    mut found := ecs_pairs(world, no_filters(), $TestPosition)
    pairs := vec_slice($EntityPair, found)
    // Four things make six pairs, and neither ordering of one appears twice.
    assert(slice_len(pairs) == 6)
    mut index : i64 = 0
    while (index < slice_len(pairs)) {
        assert(pairs[index].a.id != pairs[index].b.id)
        mut other := index + 1
        while (other < slice_len(pairs)) {
            same := pairs[index].a.id == pairs[other].a.id
                && pairs[index].b.id == pairs[other].b.id
            flipped := pairs[index].a.id == pairs[other].b.id
                && pairs[index].b.id == pairs[other].a.id
            assert(same == false)
            assert(flipped == false)
            other = other + 1
        }
        index = index + 1
    }
    vec_free($EntityPair, found)
    ecs_free(world)
}

// The empty answer is a real answer, and it is the one a slice could not carry:
// the heap hands out at least one element whatever is asked for, so a gather
// that matched nothing would otherwise hand back a length nobody wrote.
test "a gather that matches nothing is empty" {
    mut world := ecs_new()
    ecs_register($TestPosition, world)
    ecs_register($TestHealth, world)

    mut empty := ecs_gather(world, no_filters(), $TestPosition)
    assert(slice_len(vec_slice($Entity, empty)) == 0)
    assert(ecs_count_matching(world, no_filters(), $TestPosition) == 0)
    vec_free($Entity, empty)

    // And so is a pair walk over fewer than two things, which is the other
    // count that multiplies out to nothing.
    lone := ecs_spawn_bundle(world, $TestPosition)
    mut pairs := ecs_pairs(world, no_filters(), $TestPosition)
    assert(slice_len(vec_slice($EntityPair, pairs)) == 0)
    vec_free($EntityPair, pairs)
    assert(ecs_alive(world, lone))
    ecs_free(world)
}

// Compaction drops the tables nothing is in and leaves the world working: every
// entity still findable, and a fresh spawn still landing in the archetype
// holding nothing, which is the table compaction is not allowed to drop.
test "compaction drops the empty tables and leaves the world working" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    health := ecs_register($TestHealth, world)

    kept := ecs_spawn(world)
    ecs_add($TestPosition, world, kept, position,
        TestPosition { x = 7.0, y = 0.0 })
    gone := ecs_spawn(world)
    ecs_add($TestHealth, world, gone, health, TestHealth { points = 3 })
    both := ecs_spawn_bundle(world, $TestPosition, $TestHealth)
    ecs_set($TestPosition, world, both, position,
        TestPosition { x = 9.0, y = 0.0 })
    ecs_despawn(world, gone)

    dropped := ecs_compact(world)
    assert(dropped > 0)
    assert(ecs_alive(world, kept))
    assert(ecs_alive(world, both))
    assert(ecs_get($TestPosition, world, kept, position).x == 7.0)
    assert(ecs_get($TestPosition, world, both, position).x == 9.0)
    assert(ecs_count_matching(world, no_filters(), $TestPosition) == 2)

    // The part that broke when table zero was dropped: a fresh entity goes in
    // the archetype holding nothing, and what it is given afterwards has to
    // reach the columns of wherever it migrates to.
    fresh := ecs_spawn(world)
    ecs_add($TestPosition, world, fresh, position,
        TestPosition { x = 4.0, y = 0.0 })
    assert(ecs_get($TestPosition, world, fresh, position).x == 4.0)
    assert(ecs_get($TestPosition, world, kept, position).x == 7.0)
    assert(ecs_count_matching(world, no_filters(), $TestPosition) == 3)

    // Nothing left to drop the second time.
    assert(ecs_compact(world) == 0)
    ecs_free(world)
}

// A reader keeps its own place, and a channel several systems read is trimmed
// to the oldest of them rather than cleared out from under the slowest.
test "a channel is read from a mark and trimmed to the slowest reader" {
    mut channel := events_new($TestHealth)
    mut fast := reader_new()
    mut slow := reader_new()

    events_send($TestHealth, channel, TestHealth { points = 1 })
    events_send($TestHealth, channel, TestHealth { points = 2 })
    assert(events_pending(channel, fast) == 2)

    seen := events_read($TestHealth, channel, fast)
    assert(slice_len(seen) == 2)
    assert(seen[0].points == 1)
    assert(events_pending(channel, fast) == 0)
    // The other reader has not moved, so what it has waiting is untouched.
    assert(events_pending(channel, slow) == 2)

    events_send($TestHealth, channel, TestHealth { points = 3 })
    assert(events_pending(channel, fast) == 1)
    assert(events_pending(channel, slow) == 3)

    // A mark rather than a reader, which is what a system keeping its own uses.
    from_start := events_since($TestHealth, channel, 0)
    assert(slice_len(from_start) == 3)
    from_second := events_since($TestHealth, channel, 1)
    assert(slice_len(from_second) == 2)
    assert(from_second[0].points == 2)

    mut readers : [2]EventReader = [EventReader { seen = fast.seen },
        EventReader { seen = slow.seen }]
    assert(readers_oldest(readers) == 0)

    // Trimming to the slowest drops nothing yet, since it has read nothing.
    events_trim(channel, readers_oldest(readers))
    assert(events_sent(channel) == 3)
    assert(events_pending(channel, slow) == 3)

    // Once it catches up, what both have passed goes, and what is left is what
    // is left: the sequence numbers carry on across the trim.
    caught := events_read($TestHealth, channel, slow)
    assert(slice_len(caught) == 3)
    readers[0] = EventReader { seen = fast.seen }
    readers[1] = EventReader { seen = slow.seen }
    events_trim(channel, readers_oldest(readers))
    assert(events_sent(channel) == 3)
    // Trimming to the oldest keeps what the fastest has not reached: the third
    // is still waiting for the reader that stopped after the second.
    assert(events_pending(channel, fast) == 1)

    events_send($TestHealth, channel, TestHealth { points = 4 })
    after := events_read($TestHealth, channel, fast)
    assert(slice_len(after) == 2)
    assert(after[0].points == 3)
    assert(after[1].points == 4)
    events_free(channel)
}

// A partial trim keeps what is past the mark, in order, which is the shifting
// the whole thing turns on.
test "a partial trim keeps what is past the mark" {
    mut channel := events_new($TestHealth)
    mut index : i64 = 0
    while (index < 5) {
        events_send($TestHealth, channel, TestHealth { points = index })
        index = index + 1
    }

    events_trim(channel, 2)
    left := events_slice($TestHealth, channel)
    assert(slice_len(left) == 3)
    assert(left[0].points == 2)
    assert(left[1].points == 3)
    assert(left[2].points == 4)
    // The numbering did not restart, so a reader that saw the first two is
    // still where it was rather than back at the beginning.
    assert(events_sent(channel) == 5)

    // Past everything empties it, and a mark already behind does nothing.
    events_trim(channel, 2)
    assert(slice_len(events_slice($TestHealth, channel)) == 3)
    events_trim(channel, 99)
    assert(slice_len(events_slice($TestHealth, channel)) == 0)
    assert(events_sent(channel) == 5)
    events_free(channel)
}

// The pieces underneath a mask: how many bits a word holds and which column a
// component's bit lands on. A table's columns are in ascending component order
// and nothing maps one to the other at run time, so this counting is what makes
// a component reach its column at all.
test "a column is found by counting the bits below it" {
    assert(bits_in(0) == 0)
    assert(bits_in(1) == 1)
    assert(bits_in(255) == 8)

    mut m := mask_empty()
    m = mask_with(m, 1)
    m = mask_with(m, 4)
    m = mask_with(m, 9)
    // Three components held, so three columns, in the order the indices run.
    assert(column_position(m, 1) == 0)
    assert(column_position(m, 4) == 1)
    assert(column_position(m, 9) == 2)
    assert(bits_in(m.words[0]) == 3)

    // Clearing a whole set at once is what a bundle leaving takes off.
    unwanted := mask_with(mask_empty(), 4)
    left := mask_without_mask(m, unwanted)
    assert(mask_has(left, 1))
    assert(mask_has(left, 4) == false)
    assert(mask_has(left, 9))
    assert(column_position(left, 9) == 1)
}

// A world emptied in place keeps the registry it was given and loses everything
// that was in it. The archetype holding nothing comes back with it, since
// `ecs_spawn` reaches that one by index and a cleared world is still a world.
test "clearing a world keeps its registry and drops its rows" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    entity := ecs_spawn(world)
    ecs_add($TestPosition, world, entity, position,
        TestPosition { x = 5.0, y = 0.0 })
    assert(ecs_count(world) == 1)

    world_clear(world)
    assert(ecs_count(world) == 0)
    assert(ecs_alive(world, entity) == false)
    // The registry survives, so the same component is still known by the same
    // index and the world is usable rather than needing building again.
    assert(world.registry.count == 1)
    assert(ecs_component_by_name(world, "TestPosition") == position)

    again := ecs_spawn(world)
    ecs_add($TestPosition, world, again, position,
        TestPosition { x = 6.0, y = 0.0 })
    assert(ecs_get($TestPosition, world, again, position).x == 6.0)
    ecs_free(world)
}

// The ticks a column carries per row, read off the table a walk stopped on.
// `query_changed` says when a row was last written and `query_added` when it
// arrived, which are different questions and different arrays.
test "a walk reads when a row arrived and when it changed" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    early := ecs_spawn(world)
    ecs_add($TestPosition, world, early, position,
        TestPosition { x = 1.0, y = 0.0 })

    mark := ecs_now(world)
    ecs_tick(world)
    ecs_set($TestPosition, world, early, position,
        TestPosition { x = 2.0, y = 0.0 })

    mut q := query_begin(world)
    query_with(q, position)
    mut found := false
    while (query_next(world, q)) {
        changed := query_changed(world, q, position)
        added := query_added(world, q, position)
        assert(slice_len(changed) == q.count)
        assert(slice_len(added) == q.count)
        mut row : i64 = 0
        while (row < q.count) {
            // Written after the mark, and put there before it.
            assert(changed[row] > mark)
            assert(added[row] <= mark)
            found = true
            row = row + 1
        }
    }
    assert(found)
    ecs_free(world)
}

// Stages run in the order they are written down, and the order is a number so
// a schedule can sort by it.
test "the stages are ordered" {
    assert(stage_order(Stage::First) == 0)
    assert(stage_order(Stage::Update) == 1)
    assert(stage_order(Stage::Last) == 2)
    assert(stage_order(Stage::First) < stage_order(Stage::Update))
    assert(stage_order(Stage::Update) < stage_order(Stage::Last))
}

// A tag named by a type rather than by a handle, kept by the group so several
// members can ask about the same mark. The tag inside it is released in place
// when the group goes, which is what `tag_release` is for: a tag held within
// another value cannot be moved out of it to be consumed.
test "a group holds tags named by type" {
    mut g := group_new()
    engine := group_add_world(g)
    group_register($EngineTransform, g, engine)

    marked_entity := group_spawn(g)
    plain := group_spawn(g)
    group_set($EngineTransform, g, marked_entity,
        EngineTransform { x = 1.0, y = 0.0 })
    group_set($EngineTransform, g, plain, EngineTransform { x = 2.0, y = 0.0 })

    // The type names the tag, so two places asking for the same one get the
    // same set without passing a handle between them.
    first := group_tag_type($GameHealth, g)
    again := group_tag_type($GameHealth, g)
    assert(first == again)
    assert(group_tag_type($GameSpeed, g) != first)

    group_add_tag($GameHealth, g, marked_entity)
    assert(group_has_tag($GameHealth, g, marked_entity))
    assert(group_has_tag($GameHealth, g, plain) == false)
    assert(group_has_tag($GameSpeed, g, marked_entity) == false)

    group_remove_tag($GameHealth, g, marked_entity)
    assert(group_has_tag($GameHealth, g, marked_entity) == false)

    // A tag on a despawned identity is not a mark on whatever gets the id next.
    group_add_tag($GameHealth, g, plain)
    group_despawn(g, plain)
    reused := group_spawn(g)
    assert(group_has_tag($GameHealth, g, reused) == false)
    group_free(g)
}

// A component taken off wherever it lives, a run of identities retired at once,
// and the log of what happened emptied. The three group operations nothing else
// here reaches.
test "a group removes, despawns a run, and clears its log" {
    mut g := group_new()
    engine := group_add_world(g)
    game := group_add_world(g)
    group_register($EngineTransform, g, engine)
    group_register($GameHealth, g, game)

    // A route asked for a component no member registered is the one that is
    // not found, and every real one is.
    assert(route_found(no_route()) == false)
    assert(route_found(group_route($EngineTransform, g)))
    assert(route_found(group_route($GameSpeed, g)) == false)

    mut made : [3]Entity = [no_entity(); 3]
    mut index : i64 = 0
    while (index < 3) {
        entity := group_spawn(g)
        held : f32 = index
        group_set($EngineTransform, g, entity,
            EngineTransform { x = held, y = 0.0 })
        group_set($GameHealth, g, entity, GameHealth { points = index })
        made[index] = entity
        index = index + 1
    }
    assert(group_count(g) == 3)

    // One component off one entity, leaving the rest of it alone.
    group_remove($GameHealth, g, made[0])
    assert(group_has($GameHealth, g, made[0]) == false)
    assert(group_has($EngineTransform, g, made[0]))
    assert(group_alive(g, made[0]))

    group_log_enable(g, true)
    mut pair : [2]Entity = [made[1], made[2]]
    group_despawn_entities(g, pair)
    assert(group_alive(g, made[1]) == false)
    assert(group_alive(g, made[2]) == false)
    assert(group_alive(g, made[0]))
    assert(group_count(g) == 1)
    assert(slice_len(group_log(g)) > 0)

    group_log_clear(g)
    assert(slice_len(group_log(g)) == 0)
    group_free(g)
}

// A world written down and read back is the same world: the same entities in
// the same tables holding the same values, and the same handles still refused.
