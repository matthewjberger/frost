// An archetype entity-component system.
//
// Entities that hold the same set of components live in one table, and a table
// keeps one contiguous column per component, so a system walks columns rather
// than chasing entities. That is the same shape `columns<T, N>` gives a fixed
// component set (docs/spec.md 10.1a); this is the version where the set is
// decided while the program runs, which is what an editor and a save file need.
//
// What a component is: plain data. No destructor, no copy constructor, nothing
// a type knows that the compiler does not. That one fact removes the table of
// per-type function pointers an ECS in another language needs, because every
// operation a column performs is a move of `item_size` bytes: growing it,
// removing a row, carrying a row to another table. The registry holds a size
// per component and nothing else.
//
// A component is named by its mask bit. A table's mask is the bits it holds,
// its columns are in ascending bit order, and the column for a bit is found by
// counting the bits below it, so nothing maps a component to a column at run
// time.
//
// The unsafe floor is the column: raw bytes with a width. Everything above it
// reaches an element through `column_of`, which hands out a bounds-checked
// `[]T`, and through generational handles that refuse a stale entity.

import "vec.frost"
import "mem.frost"

export Entity, EntitySlot, Column, Registry, Table, World, Query, Tag,
    Commands, Change, Events, EventReader,
    ecs_new, ecs_free, ecs_register, ecs_component_size,
    ecs_spawn, ecs_despawn, ecs_alive, ecs_count,
    ecs_add, ecs_remove, ecs_has, ecs_get, ecs_set, ecs_slice,
    query_begin, query_next, query_column, query_entities,
    for_each1, for_each2, for_each3,
    tag_new, tag_free, tag_add, tag_remove, tag_has,
    commands_new, commands_free, commands_spawn, commands_despawn,
    commands_apply,
    ecs_tick, ecs_now, ecs_changed_since, ecs_added_since,
    query_changed, query_added,
    ecs_resource_register, ecs_resource, ecs_resource_set,
    ecs_resource_slice,
    ecs_log_enable, ecs_log, ecs_log_clear,
    ChangeKind,
    events_new, events_free, events_send, events_sent, events_slice,
    events_clear, reader_new, events_read,
    Hierarchy, hierarchy_new, hierarchy_free, hierarchy_attach,
    hierarchy_detach, hierarchy_parent, hierarchy_first_child,
    hierarchy_next_sibling, hierarchy_child_count, hierarchy_despawn_tree,
    no_entity, is_no_entity,
    System, Schedule, schedule_new, schedule_free, schedule_add,
    schedule_add_in_state, schedule_run, schedule_count,
    Stage, stage_order, ANY_STATE,
    States, states_new, states_request, states_apply, states_current,
    Time, time_new, time_advance,
    column_of, column_position, bits_below, mask_of


// A mask is one i64, so a world holds this many component types.
MAX_COMPONENTS :: 62

// ---------------------------------------------------------------------------
// Entities
//
// A handle is an id and a generation. The id indexes the slot table; the
// generation is bumped when the id is freed, so a handle kept past a despawn
// names a generation the slot no longer has and every lookup refuses it. This
// is the same rule `Handle<T>` follows for a pool, written out here because an
// entity is not stored in one place.
// ---------------------------------------------------------------------------

Entity :: struct {
    id: i64,
    generation: i64,
}

// Where an entity is and whether it is anywhere. `table` and `row` are its
// storage; a live entity with no components at all sits in the empty table, so
// there is always a row to name.
EntitySlot :: struct {
    generation: i64,
    alive: bool,
    table: i64,
    row: i64,
}

// ---------------------------------------------------------------------------
// Columns
//
// One component's storage for one table: `count` elements of `item_size` bytes,
// end to end. The type is not held anywhere, because nothing here needs it: a
// row moves as bytes and only `column_of` ever says what those bytes are.
// ---------------------------------------------------------------------------

Column :: struct {
    data: ^u8,
    // One tick per row, in step with the data: when the row was last written to,
    // and when the entity holding it was first given the component. These are
    // what a system asking "what moved since I last ran" reads, and they are
    // kept here rather than beside the table because they move exactly when the
    // rows do, which is the one thing a column already knows how to do.
    changed: ^u8,
    added: ^u8,
    count: i64,
    capacity: i64,
    item_size: i64,
}

// A tick is an i64. The columns holding them are the same bytes-with-a-width
// the data is, so growing and moving rows is the same code.
TICK_SIZE :: 8

column_new :: fn(item_size: i64) -> Column {
    Column {
        data = heap_bytes(item_size),
        changed = heap_bytes(TICK_SIZE),
        added = heap_bytes(TICK_SIZE),
        count = 0,
        capacity = 1,
        item_size = item_size,
    }
}

column_free :: fn(mut c: Column) {
    heap_release($u8, c.data)
    heap_release($u8, c.changed)
    heap_release($u8, c.added)
    c.data = heap_bytes(1)
    c.changed = heap_bytes(TICK_SIZE)
    c.added = heap_bytes(TICK_SIZE)
    c.count = 0
    c.capacity = 0
}

// Room for one more element, doubling when full. The pointer is written back
// here rather than in a helper, since a `mut` parameter carries the header and
// a helper would grow a copy of it.
column_reserve :: fn(mut c: Column) {
    if (c.count < c.capacity) {
        return
    }
    mut room := c.capacity * 2
    if (room < 1) {
        room = 1
    }
    // The three blocks are bytes with a width decided while the program runs,
    // so they are counted in bytes rather than in elements of a type.
    c.data = heap_grow_bytes(c.data, room * c.item_size)
    c.changed = heap_grow_bytes(c.changed, room * TICK_SIZE)
    c.added = heap_grow_bytes(c.added, room * TICK_SIZE)
    c.capacity = room
}

// The two tick arrays as slices, which is how everything above reads them.
column_changed :: fn(c: Column) -> []i64 {
    bytes_as($i64, c.changed, c.count)
}

column_added :: fn(c: Column) -> []i64 {
    bytes_as($i64, c.added, c.count)
}

// The address of one element. The one place that turns an index into a pointer,
// so the arithmetic is written once.
column_at :: fn(c: Column, index: i64) -> ^u8 {
    bytes_at(c.data, index * c.item_size)
}

// A row of zeroes, which is what a component the caller has not written yet
// holds. Plain data has no other sensible default and no constructor to run.
column_push_zero :: fn(mut c: Column, tick: i64) {
    column_reserve(c)
    heap_zero(column_at(c, c.count), c.item_size)
    c.count = c.count + 1
    mut changed := column_changed(c)
    mut added := column_added(c)
    changed[c.count - 1] = tick
    added[c.count - 1] = tick
}

// Remove a row by moving the last one into its place, which is what keeps a
// column contiguous without moving everything after it. The caller is what
// knows which entity moved, so patching its slot is the caller's.
column_swap_remove :: fn(mut c: Column, index: i64) {
    last := c.count - 1
    if (index != last) {
        heap_copy(column_at(c, index), column_at(c, last), c.item_size)
        mut changed := column_changed(c)
        mut added := column_added(c)
        changed[index] = changed[last]
        added[index] = added[last]
    }
    c.count = last
}

// Carry one row to another column, which is a table migration's whole job.
column_move_row :: fn(mut to: Column, from: Column, index: i64) {
    column_reserve(to)
    heap_copy(column_at(to, to.count), column_at(from, index), from.item_size)
    to.count = to.count + 1
    // A row carries its history to the table it moves to. A migration is not a
    // write to the component, so a system watching for changes does not see one
    // where an entity merely gained a different component.
    mut to_changed := column_changed(to)
    mut to_added := column_added(to)
    from_changed := column_changed(from)
    from_added := column_added(from)
    to_changed[to.count - 1] = from_changed[index]
    to_added[to.count - 1] = from_added[index]
}

// The typed view of a column, and the end of the erasure. Everything above this
// reads and writes through a bounds-checked slice.
column_of :: fn($T: Type, c: Column) -> []T {
    bytes_as($T, c.data, c.count)
}

// ---------------------------------------------------------------------------
// The registry
//
// A component is a bit and a width. Bits are handed out in registration order,
// so a program that registers in one place, once, has a stable schema, which is
// what a save file needs.
// ---------------------------------------------------------------------------

Registry :: struct {
    count: i64,
    sizes: [MAX_COMPONENTS]i64,
}

// The bit for the nth registered component.
mask_of :: fn(index: i64) -> i64 {
    1 << index
}

// How many bits are set below this one, which is a column's position in a
// table whose columns are in ascending bit order.
bits_below :: fn(mask: i64, bit: i64) -> i64 {
    mut held := mask & (bit - 1)
    mut counted : i64 = 0
    while (held != 0) {
        held = held & (held - 1)
        counted = counted + 1
    }
    counted
}

column_position :: fn(table_mask: i64, component_mask: i64) -> i64 {
    bits_below(table_mask, component_mask)
}

// ---------------------------------------------------------------------------
// Tables
//
// One archetype: the entities holding exactly this set of components, and one
// column per bit of the mask in ascending order.
// ---------------------------------------------------------------------------

Table :: struct {
    mask: i64,
    entities: Vec<Entity>,
    columns: Vec<Column>,
}

// ---------------------------------------------------------------------------
// The mask table
//
// Mask to table index, by open addressing with linear probing. A world's own
// rather than the standard library's map because the key is a mask and the
// value is a row: two runs of i64 and nothing generic, which is the whole of
// what a lookup by archetype needs.
// ---------------------------------------------------------------------------

Lookup :: struct {
    masks: Vec<i64>,
    rows: Vec<i64>,
    cap: i64,
    count: i64,
}

// A mask of zero is the empty archetype, which is a real key, so the empty slot
// is marked by a row of -1 rather than by a mask of zero.
lookup_new :: fn(capacity: i64) -> Lookup {
    mut cap : i64 = 8
    while (cap < capacity) { cap = cap * 2 }
    mut made := Lookup { masks = vec_new($i64, cap), rows = vec_new($i64, cap),
        cap = cap, count = 0 }
    mut i : i64 = 0
    while (i < cap) {
        vec_push($i64, made.masks, 0)
        vec_push($i64, made.rows, 0 - 1)
        i = i + 1
    }
    made
}

lookup_free :: fn(move l: Lookup) {
    vec_free($i64, l.masks)
    vec_free($i64, l.rows)
}

// The slot a mask sits in, or the first empty one on its probe run. The table
// is never full, since it grows at half.
lookup_slot :: fn(l: Lookup, mask: i64) -> i64 {
    mut h := mask * 2654435761
    h = h + (h / 4096)
    mut i := h % l.cap
    if (i < 0) {
        i = 0 - i
    }
    masks := vec_slice($i64, l.masks)
    rows := vec_slice($i64, l.rows)
    while (rows[i] >= 0 && masks[i] != mask) {
        i = i + 1
        if (i >= l.cap) { i = 0 }
    }
    i
}

lookup_get :: fn(l: Lookup, mask: i64) -> i64 {
    slot := lookup_slot(l, mask)
    vec_slice($i64, l.rows)[slot]
}

lookup_put :: fn(mut l: Lookup, mask: i64, row: i64) {
    if (l.count * 2 >= l.cap) {
        lookup_grow(l)
    }
    slot := lookup_slot(l, mask)
    mut rows := vec_slice($i64, l.rows)
    if (rows[slot] < 0) {
        l.count = l.count + 1
    }
    vec_slice($i64, l.masks)[slot] = mask
    vec_slice($i64, l.rows)[slot] = row
}

lookup_grow :: fn(mut l: Lookup) {
    old_cap := l.cap
    // The old runs are read out before the new ones go in, and the new ones are
    // made here rather than by building a whole table and taking it apart: a
    // table owns two vectors, and one made only to be gutted would be a
    // resource nothing consumed.
    old_masks := l.masks
    old_rows := l.rows
    room := old_cap * 2
    mut masks := vec_new($i64, room)
    mut rows := vec_new($i64, room)
    mut k : i64 = 0
    while (k < room) {
        vec_push($i64, masks, 0)
        vec_push($i64, rows, 0 - 1)
        k = k + 1
    }
    l.masks = masks
    l.rows = rows
    l.cap = room
    l.count = 0
    mut i : i64 = 0
    while (i < old_cap) {
        held_mask := vec_slice($i64, old_masks)[i]
        held_row := vec_slice($i64, old_rows)[i]
        if (held_row >= 0) {
            lookup_put(l, held_mask, held_row)
        }
        i = i + 1
    }
    vec_free($i64, old_masks)
    vec_free($i64, old_rows)
}

// ---------------------------------------------------------------------------
// The world
// ---------------------------------------------------------------------------

// The four structural changes a world records. A component write is not one:
// that is what the per-row ticks are for.
ChangeKind :: enum { Spawn, Despawn, Add, Remove }

Change :: struct {
    kind: ChangeKind,
    entity: Entity,
    // The component the change was about, or zero for a spawn or a despawn.
    mask: i64,
    tick: i64,
}

World :: struct {
    registry: Registry,
    slots: Vec<EntitySlot>,
    free_ids: Vec<i64>,
    next_id: i64,
    tables: Vec<Table>,
    // Mask to table index, so a migration finds its destination without a scan.
    lookup: Lookup,
    live: i64,
    // The clock every write is stamped with. It starts at one so that zero,
    // which is what a freshly allocated row holds, is a time before anything.
    tick: i64,
    // A resource is a component with one row and no entity: a column of one.
    resources: Vec<Column>,
    // What changed structurally, for a program that has to hear about it: a
    // save file writing a delta, an editor keeping a list in step. Off by
    // default, since a world nobody asks pays nothing for it.
    log: Vec<Change>,
    logging: bool,
}

ecs_new :: fn() -> World {
    mut world := World {
        registry = Registry { count = 0, sizes = [0; MAX_COMPONENTS] },
        slots = vec_new($EntitySlot, 64),
        free_ids = vec_new($i64, 64),
        next_id = 0,
        tables = vec_new($Table, 16),
        lookup = lookup_new(32),
        live = 0,
        tick = 1,
        resources = vec_new($Column, 4),
        log = vec_new($Change, 16),
        logging = false,
    }
    // Table zero is the empty archetype, where an entity with no components
    // lives. Having it always exist means a spawn never has to make a table.
    vec_push(
        $Table,
        world.tables,
        Table { mask = 0, entities = vec_new($Entity, 16),
            columns = vec_new($Column, 1) },
    )
    lookup_put(world.lookup, 0, 0)
    world
}

ecs_free :: fn(move world: World) {
    mut t : i64 = 0
    while (t < vec_len($Table, world.tables)) {
        ref table := vec_slice($Table, world.tables)[t]
        mut c : i64 = 0
        while (c < vec_len($Column, table.columns)) {
            ref column := vec_slice($Column, table.columns)[c]
            column_free(column)
            c = c + 1
        }
        vec_free($Column, table.columns)
        vec_free($Entity, table.entities)
        t = t + 1
    }
    mut r : i64 = 0
    while (r < vec_len($Column, world.resources)) {
        ref resource := vec_slice($Column, world.resources)[r]
        column_free(resource)
        r = r + 1
    }
    vec_free($Column, world.resources)
    vec_free($Change, world.log)
    vec_free($Table, world.tables)
    vec_free($EntitySlot, world.slots)
    vec_free($i64, world.free_ids)
    lookup_free(world.lookup)
}

// ---------------------------------------------------------------------------
// The clock
//
// Every component write is stamped with the world's tick, and a system that
// wants to see only what moved compares against the tick it last ran at. The
// world does not advance the clock on its own: a frame does, once, so that
// everything written during it shares one time.
// ---------------------------------------------------------------------------

ecs_tick :: fn(mut world: World) -> i64 {
    world.tick = world.tick + 1
    world.tick
}

ecs_now :: fn(world: World) -> i64 {
    world.tick
}

// Record a structural change, when the world was asked to keep them.
note_change :: fn(mut world: World, kind: ChangeKind, entity: Entity,
    mask: i64) {
    if (world.logging == false) {
        return
    }
    vec_push($Change, world.log,
        Change { kind = kind, entity = Entity { id = entity.id,
            generation = entity.generation }, mask = mask, tick = world.tick })
}

ecs_log_enable :: fn(mut world: World, on: bool) {
    world.logging = on
}

ecs_log :: fn(world: World) -> []Change {
    vec_slice($Change, world.log)
}

ecs_log_clear :: fn(mut world: World) {
    vec_clear($Change, world.log)
}

// Register a component and answer its mask bit. The width comes from the type,
// which is the only thing about it this has to know.
ecs_register :: fn($T: Type, mut world: World) -> i64 {
    index := world.registry.count
    // Past the ceiling there is no bit to give, and zero is the mask that names
    // nothing, so a program that registers too many finds out at its next call
    // rather than corrupting a mask.
    if (index >= MAX_COMPONENTS) {
        return 0
    }
    world.registry.sizes[index] = sizeof(T)
    world.registry.count = index + 1
    mask_of(index)
}

// The width a mask bit was registered with.
ecs_component_size :: fn(world: World, mask: i64) -> i64 {
    mut index : i64 = 0
    while (index < world.registry.count) {
        if (mask_of(index) == mask) {
            return world.registry.sizes[index]
        }
        index = index + 1
    }
    0
}

// The table for a mask, made if this is the first entity to want it. Its
// columns are created in ascending bit order, which is the order every lookup
// assumes.
table_for :: fn(mut world: World, mask: i64) -> i64 {
    held := lookup_get(world.lookup, mask)
    if (held >= 0) {
        return held
    }
    mut table := Table { mask = mask, entities = vec_new($Entity, 8),
        columns = vec_new($Column, 4) }
    mut index : i64 = 0
    while (index < world.registry.count) {
        bit := mask_of(index)
        if ((mask & bit) != 0) {
            vec_push($Column, table.columns,
                column_new(world.registry.sizes[index]))
        }
        index = index + 1
    }
    made := vec_len($Table, world.tables)
    vec_push($Table, world.tables, table)
    lookup_put(world.lookup, mask, made)
    made
}

// ---------------------------------------------------------------------------
// Spawning and despawning
// ---------------------------------------------------------------------------

ecs_spawn :: fn(mut world: World) -> Entity {
    mut id : i64 = 0
    mut generation : i64 = 0
    free_count := vec_len($i64, world.free_ids)
    if (free_count > 0) {
        id = vec_get($i64, world.free_ids, free_count - 1)
        world.free_ids.len = free_count - 1
        generation = vec_slice($EntitySlot, world.slots)[id].generation
    } else {
        id = world.next_id
        world.next_id = id + 1
        vec_push($EntitySlot, world.slots,
            EntitySlot { generation = 0, alive = false, table = 0, row = 0 })
    }
    // Every live entity has a row, so an entity with no components sits in the
    // empty table and a component added later is a migration like any other.
    ref empty := vec_slice($Table, world.tables)[0]
    row := vec_len($Entity, empty.entities)
    vec_push($Entity, empty.entities,
        Entity { id = id, generation = generation })
    ref slot := vec_slice($EntitySlot, world.slots)[id]
    slot.generation = generation
    slot.alive = true
    slot.table = 0
    slot.row = row
    world.live = world.live + 1
    made := Entity { id = id, generation = generation }
    note_change(world, ChangeKind::Spawn, made, 0)
    made
}

// Whether a handle names the entity that holds its id now, rather than one that
// held it before.
ecs_alive :: fn(world: World, entity: Entity) -> bool {
    if (entity.id < 0 || entity.id >= vec_len($EntitySlot, world.slots)) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    slot.alive && slot.generation == entity.generation
}

ecs_count :: fn(world: World) -> i64 {
    world.live
}

// Take a row out of a table, moving the last row into its place and telling
// whichever entity was moved where it went.
table_swap_remove :: fn(mut world: World, table_index: i64, row: i64) {
    ref table := vec_slice($Table, world.tables)[table_index]
    last := vec_len($Entity, table.entities) - 1
    // Which entity moves is read before the move, since handing the value to
    // the write is what gives it away.
    moved_id := vec_slice($Entity, table.entities)[last].id
    if (row != last) {
        vec_slice($Entity, table.entities)[row] =
            vec_slice($Entity, table.entities)[last]
    }
    table.entities.len = last
    mut c : i64 = 0
    while (c < vec_len($Column, table.columns)) {
        ref column := vec_slice($Column, table.columns)[c]
        column_swap_remove(column, row)
        c = c + 1
    }
    if (row != last) {
        ref slot := vec_slice($EntitySlot, world.slots)[moved_id]
        slot.row = row
    }
}

ecs_despawn :: fn(mut world: World, entity: Entity) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    table_index := slot.table
    row := slot.row
    table_swap_remove(world, table_index, row)
    ref held := vec_slice($EntitySlot, world.slots)[entity.id]
    held.alive = false
    // The next handle for this id is a different one, which is what makes the
    // one just freed refuse every lookup from here on.
    held.generation = held.generation + 1
    vec_push($i64, world.free_ids, entity.id)
    world.live = world.live - 1
    note_change(world, ChangeKind::Despawn, entity, 0)
}

// ---------------------------------------------------------------------------
// Components
//
// Adding or removing one moves the entity to the table for its new set, which
// is one row of bytes per shared column and nothing else.
// ---------------------------------------------------------------------------

// Move an entity to the table for `target_mask`, carrying every column the two
// tables share. Answers the row it landed on.
migrate :: fn(mut world: World, entity: Entity, target_mask: i64) -> i64 {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    from_index := slot.table
    row := slot.row
    to_index := table_for(world, target_mask)
    if (from_index == to_index) {
        return row
    }
    from_mask := vec_slice($Table, world.tables)[from_index].mask
    shared := from_mask & target_mask
    // The destination row is the same for every column, since a table's columns
    // are the same length.
    landed := vec_len($Entity, vec_slice($Table, world.tables)[to_index].entities)
    mut index : i64 = 0
    while (index < world.registry.count) {
        bit := mask_of(index)
        if ((target_mask & bit) != 0) {
            to_position := column_position(target_mask, bit)
            if ((shared & bit) != 0) {
                from_position := column_position(from_mask, bit)
                held := vec_slice($Column,
                    vec_slice($Table, world.tables)[from_index].columns)[from_position]
                ref to_column := vec_slice($Column,
                    vec_slice($Table, world.tables)[to_index].columns)[to_position]
                column_move_row(to_column, held, row)
            } else {
                ref to_column := vec_slice($Column,
                    vec_slice($Table, world.tables)[to_index].columns)[to_position]
                column_push_zero(to_column, world.tick)
            }
        }
        index = index + 1
    }
    ref to_table := vec_slice($Table, world.tables)[to_index]
    // A fresh handle rather than the parameter: the push takes what it is given,
    // and the slot still has to be told where the entity landed.
    vec_push($Entity, to_table.entities,
        Entity { id = entity.id, generation = entity.generation })
    table_swap_remove(world, from_index, row)
    ref slot_again := vec_slice($EntitySlot, world.slots)[entity.id]
    slot_again.table = to_index
    slot_again.row = landed
    landed
}

ecs_has :: fn(world: World, entity: Entity, mask: i64) -> bool {
    if (ecs_alive(world, entity) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    (table.mask & mask) != 0
}

// Give an entity a component, or overwrite the one it has.
ecs_add :: fn($T: Type, mut world: World, entity: Entity, mask: i64,
    value: $T) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    current := vec_slice($Table, world.tables)[slot.table].mask
    if ((current & mask) == 0) {
        migrate(world, entity, current | mask)
        note_change(world, ChangeKind::Add, entity, mask)
    }
    ecs_set($T, world, entity, mask, value)
    // A component the entity has just been given was added now, whatever the
    // row it landed on held before.
    ref placed := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[placed.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    mut added := column_added(column)
    added[placed.row] = world.tick
}

ecs_remove :: fn(mut world: World, entity: Entity, mask: i64) {
    if (ecs_alive(world, entity) == false) {
        return
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    current := vec_slice($Table, world.tables)[slot.table].mask
    if ((current & mask) == 0) {
        return
    }
    migrate(world, entity, current & (0 - 1 - mask))
    note_change(world, ChangeKind::Remove, entity, mask)
}

// The component an entity holds, by value. A component is plain data, so a copy
// is the whole of it; `ecs_slice` is how a system reaches one to write.
ecs_get :: fn($T: Type, world: World, entity: Entity, mask: i64) -> $T {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_of($T, column)[slot.row]
}

ecs_set :: fn($T: Type, mut world: World, entity: Entity, mask: i64,
    value: $T) {
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    mut items := column_of($T, column)
    items[slot.row] = value
    mut changed := column_changed(column)
    changed[slot.row] = world.tick
}

// One table's column as a slice, which is what a system writes through.
ecs_slice :: fn($T: Type, world: World, table_index: i64, mask: i64) -> []T {
    ref table := vec_slice($Table, world.tables)[table_index]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_of($T, column)
}

// ---------------------------------------------------------------------------
// Queries
//
// A query is a cursor over the tables holding a set of components. The body
// runs per table with the columns as slices, so the inner loop is over
// contiguous memory and the language checks every index.
//
//     mut q := query_begin(world, POSITION | VELOCITY)
//     while (query_next(world, q)) {
//         mut p := query_column($Position, world, q, POSITION)
//         v := query_column($Velocity, world, q, VELOCITY)
//         mut i : i64 = 0
//         while (i < q.count) {
//             p[i].x = p[i].x + v[i].x
//             i = i + 1
//         }
//     }
//
// Written this way a query has no arity limit and needs nothing captured: the
// body is where it is written, so the resources it reads are the enclosing
// function's locals. `for_each1` and its siblings are the same walk with the
// body handed in, for a system short enough that the cursor is the longer half.
// ---------------------------------------------------------------------------

Query :: struct {
    // The components a table must hold to be visited.
    mask: i64,
    // Where the walk is, and where it stopped.
    next_table: i64,
    table: i64,
    count: i64,
}

query_begin :: fn(world: World, mask: i64) -> Query {
    Query { mask = mask, next_table = 0, table = 0 - 1, count = 0 }
}

// Step to the next table holding every component the query asks for, answering
// false when there are none left. A table with no rows is skipped rather than
// handed over, so a body never runs on nothing.
query_next :: fn(world: World, mut q: Query) -> bool {
    mut index := q.next_table
    total := vec_len($Table, world.tables)
    while (index < total) {
        ref table := vec_slice($Table, world.tables)[index]
        rows := vec_len($Entity, table.entities)
        if ((table.mask & q.mask) == q.mask && rows > 0) {
            q.table = index
            q.count = rows
            q.next_table = index + 1
            return true
        }
        index = index + 1
    }
    q.next_table = total
    q.table = 0 - 1
    q.count = 0
    false
}

query_column :: fn($T: Type, world: World, q: Query, mask: i64) -> []T {
    ecs_slice($T, world, q.table, mask)
}

// The entities of the table the cursor is on, for a body that needs the handle
// beside the components.
query_entities :: fn(world: World, q: Query) -> []Entity {
    ref table := vec_slice($Table, world.tables)[q.table]
    vec_slice($Entity, table.entities)
}

// The write times of the table's rows for one component, beside the components
// themselves, so a body can skip the rows nothing touched:
//
//     mut q := query_begin(world, TRANSFORM)
//     while (query_next(world, q)) {
//         t := query_column($Transform, world, q, TRANSFORM)
//         stamps := query_changed(world, q, TRANSFORM)
//         mut i : i64 = 0
//         while (i < q.count) {
//             if (stamps[i] > last_run) { upload(t[i]) }
//             i = i + 1
//         }
//     }
//
// This is change detection without a filter type: the ticks are data, so the
// test is written where the decision is, and a body that wants both the changed
// and the unchanged rows has them.
query_changed :: fn(world: World, q: Query, mask: i64) -> []i64 {
    ref table := vec_slice($Table, world.tables)[q.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_changed(column)
}

query_added :: fn(world: World, q: Query, mask: i64) -> []i64 {
    ref table := vec_slice($Table, world.tables)[q.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_added(column)
}

// The same question about one entity, for code holding a handle rather than
// walking a table.
ecs_changed_since :: fn(world: World, entity: Entity, mask: i64,
    since: i64) -> bool {
    if (ecs_has(world, entity, mask) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_changed(column)[slot.row] > since
}

ecs_added_since :: fn(world: World, entity: Entity, mask: i64,
    since: i64) -> bool {
    if (ecs_has(world, entity, mask) == false) {
        return false
    }
    slot := vec_slice($EntitySlot, world.slots)[entity.id]
    ref table := vec_slice($Table, world.tables)[slot.table]
    position := column_position(table.mask, mask)
    ref column := vec_slice($Column, table.columns)[position]
    column_added(column)[slot.row] > since
}

// ---------------------------------------------------------------------------
// Resources
//
// A resource is a value the whole world shares: the renderer's device, the
// input state, the frame's time. It is a component with one row and no entity,
// which is exactly a column of one, so it is stored the way everything else is
// and reached through the same typed slice.
// ---------------------------------------------------------------------------

ecs_resource_register :: fn($T: Type, mut world: World) -> i64 {
    slot := vec_len($Column, world.resources)
    mut column := column_new(sizeof(T))
    column_push_zero(column, world.tick)
    vec_push($Column, world.resources, column)
    slot
}

// The one row, as a slice, which is how a resource is written in place.
ecs_resource_slice :: fn($T: Type, world: World, slot: i64) -> []T {
    ref column := vec_slice($Column, world.resources)[slot]
    column_of($T, column)
}

ecs_resource :: fn($T: Type, world: World, slot: i64) -> $T {
    ecs_resource_slice($T, world, slot)[0]
}

ecs_resource_set :: fn($T: Type, mut world: World, slot: i64, value: $T) {
    mut held := ecs_resource_slice($T, world, slot)
    held[0] = value
    ref column := vec_slice($Column, world.resources)[slot]
    mut changed := column_changed(column)
    changed[0] = world.tick
}

// ---------------------------------------------------------------------------
// Events
//
// A channel of values one system writes and another reads. Events are held in
// a column, so sending one is a push of bytes and reading them is a slice. A
// reader keeps its own place in the stream by sequence number rather than by
// index, so clearing the channel does not make a reader re-read what it saw or
// skip what it did not.
// ---------------------------------------------------------------------------

Events :: linear struct {
    items: Column,
    // The sequence number of the first item still held. Everything before it
    // has been cleared.
    first: i64,
}

// Where one reader has got to. Two systems reading the same channel keep two of
// these, which is what makes a channel one-to-many.
EventReader :: struct {
    seen: i64,
}

events_new :: fn($T: Type) -> Events {
    Events { items = column_new(sizeof(T)), first = 0 }
}

events_free :: fn(move e: Events) {
    column_free(e.items)
}

events_send :: fn($T: Type, mut e: Events, value: $T) {
    column_push_zero(e.items, 0)
    mut held := column_of($T, e.items)
    held[e.items.count - 1] = value
}

// How many have ever been sent, which is the sequence number the next one gets.
events_sent :: fn(e: Events) -> i64 {
    e.first + e.items.count
}

// Everything the channel still holds.
events_slice :: fn($T: Type, e: Events) -> []T {
    column_of($T, e.items)
}

// Drop what has been sent. The sequence numbers carry on, so a reader that has
// not caught up finds itself past the start and reads nothing rather than
// reading the next thing sent as though it were the one it missed.
events_clear :: fn(mut e: Events) {
    e.first = e.first + e.items.count
    e.items.count = 0
}

reader_new :: fn() -> EventReader {
    EventReader { seen = 0 }
}

// What this reader has not seen, and it has seen it now. A reader behind the
// start of the channel is caught up to the start: those events are gone, and
// pretending otherwise would hand it the wrong ones.
events_read :: fn($T: Type, e: Events, mut r: EventReader) -> []T {
    if (r.seen < e.first) {
        r.seen = e.first
    }
    start := r.seen - e.first
    count := e.items.count - start
    r.seen = e.first + e.items.count
    if (count <= 0) {
        return bytes_as($T, e.items.data, 0)
    }
    bytes_as($T, column_at(e.items, start), count)
}

// The same walk with the body handed in as a compile-time argument, so the call
// inside folds to a direct one and nothing is reached through a pointer. There
// is one of these per number of components a body takes.
for_each1 :: fn($A: Type, $body: fn(mut []A, i64), mut world: World,
    a_mask: i64) {
    mut q := query_begin(world, a_mask)
    while (query_next(world, q)) {
        mut a := query_column($A, world, q, a_mask)
        body(a, q.count)
    }
}

for_each2 :: fn($A: Type, $B: Type, $body: fn(mut []A, mut []B, i64),
    mut world: World, a_mask: i64, b_mask: i64) {
    mut q := query_begin(world, a_mask | b_mask)
    while (query_next(world, q)) {
        mut a := query_column($A, world, q, a_mask)
        mut b := query_column($B, world, q, b_mask)
        body(a, b, q.count)
    }
}

for_each3 :: fn($A: Type, $B: Type, $C: Type,
    $body: fn(mut []A, mut []B, mut []C, i64), mut world: World,
    a_mask: i64, b_mask: i64, c_mask: i64) {
    mut q := query_begin(world, a_mask | b_mask | c_mask)
    while (query_next(world, q)) {
        mut a := query_column($A, world, q, a_mask)
        mut b := query_column($B, world, q, b_mask)
        mut c := query_column($C, world, q, c_mask)
        body(a, b, c, q.count)
    }
}

// ---------------------------------------------------------------------------
// Tags
//
// A marker that costs no mask bit and moves no rows. Adding one to an entity
// does not change which table it is in, so a tag can be flipped in a loop
// without the migration a component would cost. The generation is stored beside
// the mark, so a tag left on a despawned id is not read as a mark on the entity
// that gets the id next.
// ---------------------------------------------------------------------------

Tag :: struct {
    marks: Vec<i64>,
}

tag_new :: fn() -> Tag {
    Tag { marks = vec_new($i64, 64) }
}

tag_free :: fn(move t: Tag) {
    vec_free($i64, t.marks)
}

// Marks are held as the generation plus one, so zero means unmarked and no
// generation can be confused with it.
tag_add :: fn(mut t: Tag, entity: Entity) {
    while (vec_len($i64, t.marks) <= entity.id) {
        vec_push($i64, t.marks, 0)
    }
    vec_set($i64, t.marks, entity.id, entity.generation + 1)
}

tag_remove :: fn(mut t: Tag, entity: Entity) {
    if (entity.id < vec_len($i64, t.marks)) {
        vec_set($i64, t.marks, entity.id, 0)
    }
}

tag_has :: fn(t: Tag, entity: Entity) -> bool {
    if (entity.id >= vec_len($i64, t.marks)) {
        return false
    }
    vec_get($i64, t.marks, entity.id) == entity.generation + 1
}

// ---------------------------------------------------------------------------
// Commands
//
// A structural change made while a query is walking would move the rows the
// walk is holding, so it is queued instead and applied when the walk is done.
// ---------------------------------------------------------------------------

CommandKind :: enum { Spawn, Despawn }

Command :: struct {
    kind: CommandKind,
    entity: Entity,
}

Commands :: struct {
    queued: Vec<Command>,
}

commands_new :: fn() -> Commands {
    Commands { queued = vec_new($Command, 16) }
}

commands_free :: fn(move c: Commands) {
    vec_free($Command, c.queued)
}

// A queued spawn has no handle to answer with yet, since the entity does not
// exist until the queue is applied.
commands_spawn :: fn(mut c: Commands) {
    vec_push($Command, c.queued,
        Command { kind = CommandKind::Spawn,
            entity = Entity { id = 0, generation = 0 } })
}

commands_despawn :: fn(mut c: Commands, entity: Entity) {
    vec_push($Command, c.queued,
        Command { kind = CommandKind::Despawn, entity = entity })
}

// Run the queue in the order it was written and empty it.
commands_apply :: fn(mut c: Commands, mut world: World) {
    mut i : i64 = 0
    while (i < vec_len($Command, c.queued)) {
        held := vec_get($Command, c.queued, i)
        kind := held.kind
        target := held.entity
        if (kind == CommandKind::Spawn) {
            ecs_spawn(world)
        } else {
            ecs_despawn(world, target)
        }
        i = i + 1
    }
    vec_clear($Command, c.queued)
}


// ---------------------------------------------------------------------------
// Hierarchy
//
// A parent-child relation held beside the world rather than as a component,
// because it is a relation between entities and a component is a value an
// entity holds. Three arrays indexed by entity id give a tree that is walked
// without allocating per node: the parent, the first child, and the next
// sibling. A tree walk is a loop over siblings and a recursion into children.
//
// The relation stores handles, so a child whose entity was despawned is a stale
// handle and reads as no child at all, the same rule everything else follows.
// ---------------------------------------------------------------------------

Hierarchy :: struct {
    parent: Vec<Entity>,
    first_child: Vec<Entity>,
    next_sibling: Vec<Entity>,
}

// The handle that names nobody. An id of -1 is one no slot has, so nothing can
// be confused with it and no generation makes it live.
no_entity :: fn() -> Entity {
    Entity { id = 0 - 1, generation = 0 }
}

is_no_entity :: fn(entity: Entity) -> bool {
    entity.id < 0
}

hierarchy_new :: fn() -> Hierarchy {
    Hierarchy {
        parent = vec_new($Entity, 64),
        first_child = vec_new($Entity, 64),
        next_sibling = vec_new($Entity, 64),
    }
}

hierarchy_free :: fn(move h: Hierarchy) {
    vec_free($Entity, h.parent)
    vec_free($Entity, h.first_child)
    vec_free($Entity, h.next_sibling)
}

// Room for an id, since an entity is attached long after the arrays were made.
hierarchy_reserve :: fn(mut h: Hierarchy, id: i64) {
    while (vec_len($Entity, h.parent) <= id) {
        vec_push($Entity, h.parent, no_entity())
        vec_push($Entity, h.first_child, no_entity())
        vec_push($Entity, h.next_sibling, no_entity())
    }
}

hierarchy_parent :: fn(h: Hierarchy, child: Entity) -> Entity {
    if (child.id < 0 || child.id >= vec_len($Entity, h.parent)) {
        return no_entity()
    }
    vec_get($Entity, h.parent, child.id)
}

hierarchy_first_child :: fn(h: Hierarchy, parent: Entity) -> Entity {
    if (parent.id < 0 || parent.id >= vec_len($Entity, h.first_child)) {
        return no_entity()
    }
    vec_get($Entity, h.first_child, parent.id)
}

hierarchy_next_sibling :: fn(h: Hierarchy, child: Entity) -> Entity {
    if (child.id < 0 || child.id >= vec_len($Entity, h.next_sibling)) {
        return no_entity()
    }
    vec_get($Entity, h.next_sibling, child.id)
}

// Attach a child to a parent, taking it off whatever it was under first. A
// child goes at the head of its parent's list, which is what makes attaching
// one a constant-time write rather than a walk to the end.
hierarchy_attach :: fn(mut h: Hierarchy, child: Entity, parent: Entity) {
    if (child.id < 0 || parent.id < 0) {
        return
    }
    hierarchy_reserve(h, child.id)
    hierarchy_reserve(h, parent.id)
    hierarchy_detach(h, child)
    held := vec_get($Entity, h.first_child, parent.id)
    vec_set($Entity, h.next_sibling, child.id, held)
    vec_set($Entity, h.first_child, parent.id,
        Entity { id = child.id, generation = child.generation })
    vec_set($Entity, h.parent, child.id,
        Entity { id = parent.id, generation = parent.generation })
}

// Take a child out of its parent's list. Finding it is a walk of the siblings,
// which is the cost of a singly linked list and is what keeps every other
// operation a single write.
hierarchy_detach :: fn(mut h: Hierarchy, child: Entity) {
    if (child.id < 0 || child.id >= vec_len($Entity, h.parent)) {
        return
    }
    parent := vec_get($Entity, h.parent, child.id)
    if (is_no_entity(parent)) {
        return
    }
    head := vec_get($Entity, h.first_child, parent.id)
    if (head.id == child.id) {
        vec_set($Entity, h.first_child, parent.id,
            vec_get($Entity, h.next_sibling, child.id))
    } else {
        mut walk := head
        while (is_no_entity(walk) == false) {
            next := vec_get($Entity, h.next_sibling, walk.id)
            if (next.id == child.id) {
                vec_set($Entity, h.next_sibling, walk.id,
                    vec_get($Entity, h.next_sibling, child.id))
                walk = no_entity()
            } else {
                walk = next
            }
        }
    }
    vec_set($Entity, h.next_sibling, child.id, no_entity())
    vec_set($Entity, h.parent, child.id, no_entity())
}

hierarchy_child_count :: fn(h: Hierarchy, parent: Entity) -> i64 {
    mut walk := hierarchy_first_child(h, parent)
    mut counted : i64 = 0
    while (is_no_entity(walk) == false) {
        counted = counted + 1
        walk = hierarchy_next_sibling(h, walk)
    }
    counted
}

// Despawn an entity and everything under it. The children are read before the
// entity goes, since despawning it is what makes its handle stale.
hierarchy_despawn_tree :: fn(mut h: Hierarchy, mut world: World, root: Entity) {
    mut walk := hierarchy_first_child(h, root)
    while (is_no_entity(walk) == false) {
        next := hierarchy_next_sibling(h, walk)
        hierarchy_despawn_tree(h, world, walk)
        walk = next
    }
    hierarchy_detach(h, root)
    if (root.id >= 0 && root.id < vec_len($Entity, h.first_child)) {
        vec_set($Entity, h.first_child, root.id, no_entity())
    }
    ecs_despawn(world, root)
}

// ---------------------------------------------------------------------------
// Schedules
//
// A system is a function of the world. A schedule is a list of them with a
// stage each, run in ascending stage order, so ordering is a number rather than
// a graph of declared dependencies: what a frame does is read top to bottom.
//
//     mut frame := schedule_new()
//     schedule_add(frame, Stage::Update, integrate)
//     schedule_add(frame, Stage::Last, upload)
//     schedule_run(frame, world, ANY_STATE)
//
// The system is a function pointer, not a compile-time argument, because a
// schedule is built while the program runs. `for_each1` and its siblings are
// the other half of this pair, for the inner loop where the call has to fold
// away.
// ---------------------------------------------------------------------------

// When in a frame a system runs. A schedule walks these in order, so the order
// they are written in is the order a frame happens in.
Stage :: enum { First, Update, Last }

STAGE_COUNT :: 3

stage_order :: fn(s: Stage) -> i64 {
    if (s == Stage::First) {
        return 0
    }
    if (s == Stage::Update) {
        return 1
    }
    2
}

// A system with this state runs whatever the state is.
ANY_STATE :: 0 - 1

System :: struct {
    run: fn(mut World),
    stage: Stage,
    state: i64,
}

Schedule :: struct {
    systems: Vec<System>,
}

schedule_new :: fn() -> Schedule {
    Schedule { systems = vec_new($System, 16) }
}

schedule_free :: fn(move s: Schedule) {
    vec_free($System, s.systems)
}

schedule_add :: fn(mut s: Schedule, stage: Stage, run: fn(mut World)) {
    vec_push($System, s.systems,
        System { run = run, stage = stage, state = ANY_STATE })
}

// A system that runs only while the world is in one state: the pause menu's
// systems, the loading screen's.
schedule_add_in_state :: fn(mut s: Schedule, stage: Stage, state: i64,
    run: fn(mut World)) {
    vec_push($System, s.systems,
        System { run = run, stage = stage, state = state })
}

schedule_count :: fn(s: Schedule) -> i64 {
    vec_len($System, s.systems)
}

// Run every system whose state matches, stage by stage. The systems are walked
// once per stage rather than sorted, since a sort would move them out of the
// order they were added in, which is the order a stage runs them.
schedule_run :: fn(mut s: Schedule, mut world: World, state: i64) {
    mut stage : i64 = 0
    while (stage < STAGE_COUNT) {
        mut k : i64 = 0
        while (k < vec_len($System, s.systems)) {
            system := vec_get($System, s.systems, k)
            if (stage_order(system.stage) == stage
                && (system.state == ANY_STATE || system.state == state)) {
                system.run(world)
            }
            k = k + 1
        }
        stage = stage + 1
    }
}

// ---------------------------------------------------------------------------
// States and time
//
// A state change takes effect between frames rather than in the middle of one,
// so a system that asks to leave a state does not have the schedule change
// under it while it is still running.
// ---------------------------------------------------------------------------

States :: struct {
    current: i64,
    next: i64,
}

states_new :: fn(initial: i64) -> States {
    States { current = initial, next = initial }
}

states_request :: fn(mut s: States, value: i64) {
    s.next = value
}

// Take the requested state, answering whether it was a change.
states_apply :: fn(mut s: States) -> bool {
    if (s.next == s.current) {
        return false
    }
    s.current = s.next
    true
}

states_current :: fn(s: States) -> i64 {
    s.current
}

Time :: struct {
    elapsed: f64,
    delta: f64,
    frame: i64,
}

time_new :: fn() -> Time {
    Time { elapsed = 0.0, delta = 0.0, frame = 0 }
}

time_advance :: fn(mut t: Time, delta: f64) {
    t.delta = delta
    t.elapsed = t.elapsed + delta
    t.frame = t.frame + 1
}

// ---------------------------------------------------------------------------
// Tests
//
// The types here are the ones a test needs and nothing else names, so the
// module carries no component of its own into a program that imports it.
// ---------------------------------------------------------------------------

TestPosition :: struct { x: f32, y: f32 }
TestVelocity :: struct { x: f32, y: f32 }
TestHealth :: struct { points: i64 }

test_integrate :: fn(mut p: []TestPosition, mut v: []TestVelocity,
    count: i64) {
    mut i : i64 = 0
    while (i < count) {
        p[i].x = p[i].x + v[i].x
        p[i].y = p[i].y + v[i].y
        i = i + 1
    }
}

test "a handle is refused once the entity it named is gone" {
    mut world := ecs_new()
    a := ecs_spawn(world)
    assert(ecs_alive(world, a))
    assert(ecs_count(world) == 1)
    ecs_despawn(world, a)
    assert(ecs_alive(world, a) == false)
    assert(ecs_count(world) == 0)
    // The next entity takes the same id under a later generation, and the
    // handle to the one before it is still refused.
    b := ecs_spawn(world)
    assert(b.id == a.id)
    assert(b.generation != a.generation)
    assert(ecs_alive(world, a) == false)
    assert(ecs_alive(world, b))
    ecs_free(world)
}

test "a component is written and read back" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    a := ecs_spawn(world)
    assert(ecs_has(world, a, position) == false)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 1.0, y = 2.0 })
    assert(ecs_has(world, a, position))
    held := ecs_get($TestPosition, world, a, position)
    assert(held.x == 1.0)
    assert(held.y == 2.0)
    ecs_set($TestPosition, world, a, position,
        TestPosition { x = 5.0, y = 6.0 })
    again := ecs_get($TestPosition, world, a, position)
    assert(again.x == 5.0)
    ecs_free(world)
}

test "adding a component carries the ones already there" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 3.0, y = 4.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 0.5, y = 0.0 })
    ecs_add($TestHealth, world, a, health, TestHealth { points = 12 })
    // Two migrations later, the first component is still what it was.
    held := ecs_get($TestPosition, world, a, position)
    assert(held.x == 3.0)
    assert(held.y == 4.0)
    speed := ecs_get($TestVelocity, world, a, velocity)
    assert(speed.x == 0.5)
    life := ecs_get($TestHealth, world, a, health)
    assert(life.points == 12)
    // And removing the middle one leaves the others where they were.
    ecs_remove(world, a, velocity)
    assert(ecs_has(world, a, velocity) == false)
    assert(ecs_has(world, a, position))
    after := ecs_get($TestPosition, world, a, position)
    assert(after.x == 3.0)
    still := ecs_get($TestHealth, world, a, health)
    assert(still.points == 12)
    ecs_free(world)
}

test "a despawn moves the last row into the hole it left" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    c := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_add($TestHealth, world, b, health, TestHealth { points = 2 })
    ecs_add($TestHealth, world, c, health, TestHealth { points = 3 })
    ecs_despawn(world, a)
    // `c` moved into the row `a` left, and its component came with it.
    assert(ecs_alive(world, c))
    held := ecs_get($TestHealth, world, c, health)
    assert(held.points == 3)
    other := ecs_get($TestHealth, world, b, health)
    assert(other.points == 2)
    assert(ecs_count(world) == 2)
    ecs_free(world)
}

test "a query visits the tables holding every component it asks for" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    // One entity with both, one with only a position.
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 1.0, y = 2.0 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 100.0, y = 100.0 })

    mut seen : i64 = 0
    mut q := query_begin(world, position | velocity)
    while (query_next(world, q)) {
        seen = seen + q.count
    }
    assert(seen == 1)

    // And a query over the position alone finds both, in two tables.
    mut tables : i64 = 0
    mut total : i64 = 0
    mut all := query_begin(world, position)
    while (query_next(world, all)) {
        tables = tables + 1
        total = total + all.count
    }
    assert(tables == 2)
    assert(total == 2)
    ecs_free(world)
}

test "a system writes through the columns a query hands it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    velocity := ecs_register($TestVelocity, world)
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 1.0, y = 1.0 })
    ecs_add($TestVelocity, world, a, velocity,
        TestVelocity { x = 0.25, y = 0.5 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 10.0, y = 10.0 })
    ecs_add($TestVelocity, world, b, velocity,
        TestVelocity { x = 1.0, y = 1.0 })

    for_each2($TestPosition, $TestVelocity, $test_integrate, world, position,
        velocity)

    first := ecs_get($TestPosition, world, a, position)
    assert(first.x == 1.25)
    assert(first.y == 1.5)
    second := ecs_get($TestPosition, world, b, position)
    assert(second.x == 11.0)
    ecs_free(world)
}

test "the cursor form reaches the entity beside its components" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 7 })
    mut found : i64 = 0
    mut q := query_begin(world, health)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        mut points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (entities[i].id == a.id) {
                found = points[i].points
            }
            i = i + 1
        }
    }
    assert(found == 7)
    ecs_free(world)
}

test "a tag marks an entity without moving it" {
    mut world := ecs_new()
    position := ecs_register($TestPosition, world)
    mut selected := tag_new()
    a := ecs_spawn(world)
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    b := ecs_spawn(world)
    ecs_add($TestPosition, world, b, position,
        TestPosition { x = 0.0, y = 0.0 })
    tag_add(selected, a)
    assert(tag_has(selected, a))
    assert(tag_has(selected, b) == false)
    // Both are still in the one table.
    mut tables : i64 = 0
    mut q := query_begin(world, position)
    while (query_next(world, q)) {
        tables = tables + 1
    }
    assert(tables == 1)
    tag_remove(selected, a)
    assert(tag_has(selected, a) == false)
    tag_free(selected)
    ecs_free(world)
}

test "a tag left on a freed id is not a mark on the next entity" {
    mut world := ecs_new()
    mut selected := tag_new()
    a := ecs_spawn(world)
    tag_add(selected, a)
    ecs_despawn(world, a)
    b := ecs_spawn(world)
    assert(b.id == a.id)
    assert(tag_has(selected, b) == false)
    tag_free(selected)
    ecs_free(world)
}

TestOrder :: struct { steps: i64 }
TestDamage :: struct { amount: i64 }

// The systems a schedule test runs. A system is a function of the world and
// nothing else, so what it reads it reads from a resource, which is what one in
// a program does too.
first_system :: fn(mut world: World) {
    held := ecs_resource($TestOrder, world, 0)
    ecs_resource_set($TestOrder, world, 0,
        TestOrder { steps = held.steps * 2 + 1 })
}

second_system :: fn(mut world: World) {
    held := ecs_resource($TestOrder, world, 0)
    ecs_resource_set($TestOrder, world, 0, TestOrder { steps = held.steps * 2 })
}

spawning_system :: fn(mut world: World) {
    ecs_spawn(world)
}

test "a write is stamped with the tick it was made at" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    made_at := ecs_now(world)
    assert(ecs_changed_since(world, a, health, made_at - 1))
    assert(ecs_added_since(world, a, health, made_at - 1))

    later := ecs_tick(world)
    // Nothing was written this tick, so nothing changed since the last one.
    assert(ecs_changed_since(world, a, health, later - 1) == false)
    ecs_set($TestHealth, world, a, health, TestHealth { points = 2 })
    assert(ecs_changed_since(world, a, health, later - 1))
    // The write is not an add: the component was already there.
    assert(ecs_added_since(world, a, health, later - 1) == false)
    ecs_free(world)
}

test "a query hands over the write times beside the components" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_add($TestHealth, world, b, health, TestHealth { points = 2 })
    watermark := ecs_tick(world)
    ecs_set($TestHealth, world, b, health, TestHealth { points = 20 })

    mut touched : i64 = 0
    mut q := query_begin(world, health)
    while (query_next(world, q)) {
        stamps := query_changed(world, q, health)
        points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (stamps[i] >= watermark) {
                touched = touched + points[i].points
            }
            i = i + 1
        }
    }
    assert(touched == 20)
    ecs_free(world)
}

test "a migration carries a row's history with it" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    position := ecs_register($TestPosition, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 5 })
    written_at := ecs_now(world)
    ecs_tick(world)
    // Gaining a second component moves the entity to another table. The health
    // was not written by that, so its stamp is still the one it had.
    ecs_add($TestPosition, world, a, position,
        TestPosition { x = 0.0, y = 0.0 })
    assert(ecs_changed_since(world, a, health, written_at) == false)
    assert(ecs_added_since(world, a, position, written_at))
    ecs_free(world)
}

test "a resource is one value the whole world shares" {
    mut world := ecs_new()
    order := ecs_resource_register($TestOrder, world)
    damage := ecs_resource_register($TestDamage, world)
    assert(ecs_resource($TestOrder, world, order).steps == 0)
    ecs_resource_set($TestOrder, world, order, TestOrder { steps = 7 })
    ecs_resource_set($TestDamage, world, damage, TestDamage { amount = 3 })
    assert(ecs_resource($TestOrder, world, order).steps == 7)
    assert(ecs_resource($TestDamage, world, damage).amount == 3)
    // And it is written in place through the slice, the way a system does.
    mut held := ecs_resource_slice($TestOrder, world, order)
    held[0].steps = held[0].steps + 1
    assert(ecs_resource($TestOrder, world, order).steps == 8)
    ecs_free(world)
}

test "two readers of one channel each see every event once" {
    mut channel := events_new($TestDamage)
    mut renderer := reader_new()
    mut audio := reader_new()
    events_send($TestDamage, channel, TestDamage { amount = 2 })
    events_send($TestDamage, channel, TestDamage { amount = 3 })
    assert(events_sent(channel) == 2)

    first := events_read($TestDamage, channel, renderer)
    mut total : i64 = 0
    mut i : i64 = 0
    while (i < slice_len(first)) {
        total = total + first[i].amount
        i = i + 1
    }
    assert(total == 5)
    // The same reader again sees nothing; the other reader sees both.
    assert(slice_len(events_read($TestDamage, channel, renderer)) == 0)
    assert(slice_len(events_read($TestDamage, channel, audio)) == 2)

    events_send($TestDamage, channel, TestDamage { amount = 4 })
    assert(slice_len(events_read($TestDamage, channel, renderer)) == 1)
    events_free(channel)
}

test "a reader that missed a clear is caught up rather than misled" {
    mut channel := events_new($TestDamage)
    mut late := reader_new()
    events_send($TestDamage, channel, TestDamage { amount = 1 })
    events_clear(channel)
    events_send($TestDamage, channel, TestDamage { amount = 9 })
    held := events_read($TestDamage, channel, late)
    // The one it missed is gone, and the one it did not is the one it gets.
    assert(slice_len(held) == 1)
    assert(held[0].amount == 9)
    events_free(channel)
}

test "a tree is walked from a parent to its children" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    a := ecs_spawn(world)
    b := ecs_spawn(world)
    grandchild := ecs_spawn(world)
    hierarchy_attach(tree, a, root)
    hierarchy_attach(tree, b, root)
    hierarchy_attach(tree, grandchild, a)
    assert(hierarchy_child_count(tree, root) == 2)
    assert(hierarchy_child_count(tree, a) == 1)
    assert(hierarchy_parent(tree, grandchild).id == a.id)
    assert(is_no_entity(hierarchy_parent(tree, root)))

    // Reattaching moves it rather than listing it twice.
    hierarchy_attach(tree, grandchild, root)
    assert(hierarchy_child_count(tree, root) == 3)
    assert(hierarchy_child_count(tree, a) == 0)
    hierarchy_detach(tree, grandchild)
    assert(hierarchy_child_count(tree, root) == 2)
    hierarchy_free(tree)
    ecs_free(world)
}

test "despawning a parent despawns what was under it" {
    mut world := ecs_new()
    mut tree := hierarchy_new()
    root := ecs_spawn(world)
    child := ecs_spawn(world)
    grandchild := ecs_spawn(world)
    other := ecs_spawn(world)
    hierarchy_attach(tree, child, root)
    hierarchy_attach(tree, grandchild, child)
    assert(ecs_count(world) == 4)
    hierarchy_despawn_tree(tree, world, root)
    assert(ecs_alive(world, root) == false)
    assert(ecs_alive(world, child) == false)
    assert(ecs_alive(world, grandchild) == false)
    assert(ecs_alive(world, other))
    assert(ecs_count(world) == 1)
    hierarchy_free(tree)
    ecs_free(world)
}

test "a schedule runs its systems in stage order" {
    mut world := ecs_new()
    ecs_resource_register($TestOrder, world)
    mut frame := schedule_new()
    // Added last, run first: the stage decides, not the order they were added.
    schedule_add(frame, Stage::Last, second_system)
    schedule_add(frame, Stage::First, first_system)
    assert(schedule_count(frame) == 2)
    schedule_run(frame, world, ANY_STATE)
    // first_system then second_system: (0 * 2 + 1) * 2.
    assert(ecs_resource($TestOrder, world, 0).steps == 2)
    schedule_free(frame)
    ecs_free(world)
}

test "a system bound to a state runs only in that state" {
    mut world := ecs_new()
    mut frame := schedule_new()
    schedule_add_in_state(frame, Stage::Update, 1, spawning_system)
    schedule_run(frame, world, 0)
    assert(ecs_count(world) == 0)
    schedule_run(frame, world, 1)
    assert(ecs_count(world) == 1)
    schedule_free(frame)
    ecs_free(world)
}

test "a state change is taken between frames rather than during one" {
    mut states := states_new(0)
    states_request(states, 2)
    // The request is not the change: the state is what it was until it is
    // applied, which is what keeps a frame running in one state throughout.
    assert(states_current(states) == 0)
    assert(states_apply(states))
    assert(states_current(states) == 2)
    // Applying again is not a change.
    assert(states_apply(states) == false)
}

test "time carries the frame and what it took" {
    mut clock := time_new()
    time_advance(clock, 0.5)
    time_advance(clock, 0.25)
    assert(clock.frame == 2)
    assert(clock.delta == 0.25)
    assert(clock.elapsed == 0.75)
}

test "a world asked to keep a log says what changed structurally" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    // Nothing is recorded until it is asked for.
    ignored := ecs_spawn(world)
    assert(slice_len(ecs_log(world)) == 0)
    ecs_log_enable(world, true)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    ecs_remove(world, a, health)
    ecs_despawn(world, a)
    held := ecs_log(world)
    assert(slice_len(held) == 4)
    assert(held[0].kind == ChangeKind::Spawn)
    assert(held[1].kind == ChangeKind::Add)
    assert(held[1].mask == health)
    assert(held[2].kind == ChangeKind::Remove)
    assert(held[3].kind == ChangeKind::Despawn)
    assert(held[3].entity.id == a.id)
    ecs_log_clear(world)
    assert(slice_len(ecs_log(world)) == 0)
    ecs_free(world)
}

test "a change made during a walk is queued and applied after it" {
    mut world := ecs_new()
    health := ecs_register($TestHealth, world)
    a := ecs_spawn(world)
    ecs_add($TestHealth, world, a, health, TestHealth { points = 1 })
    b := ecs_spawn(world)
    ecs_add($TestHealth, world, b, health, TestHealth { points = 0 })

    mut queued := commands_new()
    mut q := query_begin(world, health)
    while (query_next(world, q)) {
        entities := query_entities(world, q)
        points := query_column($TestHealth, world, q, health)
        mut i : i64 = 0
        while (i < q.count) {
            if (points[i].points == 0) {
                commands_despawn(queued, entities[i])
            }
            i = i + 1
        }
    }
    assert(ecs_count(world) == 2)
    commands_apply(queued, world)
    assert(ecs_count(world) == 1)
    assert(ecs_alive(world, b) == false)
    assert(ecs_alive(world, a))
    commands_free(queued)
    ecs_free(world)
}
