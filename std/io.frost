// Writing to standard output.
//
// One call writes a line: `print` takes a format string and as many values as
// the line names, and each value is written the way its type is written. The
// list is a compile-time one, so the call expands to one direct step per value
// with the choice of writer already made.
//
// The line is composed before any of it leaves. A `print` is one write rather
// than one per value, and nothing is held back after the call returns: there
// is no buffer between calls, so nothing needs flushing, nothing is lost when
// a program stops partway, and `print` and the compiler's own emitted text
// cannot arrive out of order.
//
// A destination is a function taking bytes. `print` writes to standard output,
// and a program that wants its text somewhere else hands its own to `write`.
// The destination travels in the line rather than as a compile-time argument of
// every step: what happens per value is direct either way, and what goes
// through the field happens once per line.
//
// The runtime's byte writer is pinned to standard output. The emit helpers are
// not: they follow the compiler's `-o` target, so a program that opened one
// would find its own output inside the file it was writing.

import "mem.frost"

export to_stdout, print, write, LINE

// The one writer taking a pointer and a length is not `safe`: it asserts that
// `length` bytes live at `data`, which is the claim `slice_from` is gated for.
frost_rt_write_bytes :: extern fn(data: ^u8, length: i64)

// A float, spelled the way C writes `%g`, into a buffer rather than out to a
// stream, so the line it belongs to can be finished before anything leaves.
// Shortest-round-trip decimal is the one piece of formatting this does not do
// for itself: writing it again here would be a second implementation of the C
// library's, differing only where it was wrong.
//
// Not `safe`: it writes through a pointer, and how far it may write is a claim
// the caller makes rather than one the callee can check.
frost_rt_format_f64 :: extern fn(value: f64, out: ^u8, room: i64) -> i64

// How much of a line is composed before any of it goes out. A line longer than
// this leaves in pieces of this size, so nothing is lost and nothing allocates.
// It is what a `print` costs on the stack.
LINE :: 256

// A line being built. It lives for one call and is never handed out, so what it
// holds cannot outlive the write that empties it.
//
// Where it goes is not on it. A destination is named at the call and travels as
// a compile-time argument, so every step below writes to a function this build
// knows, and `out(...)` is a call to that function rather than through a field.
Line :: struct {
    bytes: [LINE]u8,
    used: i64,
}

to_stdout :: fn(text: str) {
    if (str_len(text) == 0) {
        return
    }
    // The pointer and the length come from the same `str`, so the run this
    // asserts is the run the slice already carries and the two cannot disagree.
    unsafe { frost_rt_write_bytes(ptr_to(text[0]), str_len(text)) }
}

// What has been composed, written out, and the line emptied. Nothing goes out
// for an empty line, so a destination is never called with no bytes.
drain :: fn($out: fn(str), mut line: Line) {
    if (line.used == 0) {
        return
    }
    out(slice_range(line.bytes, 0, line.used))
    line.used = 0
}

// Room for `want` more bytes, made by writing out what is already there.
// Answers how much room there is, which is less than was asked for only when
// the whole line would not hold it.
room_for :: fn($out: fn(str), mut line: Line, want: i64) -> i64 {
    if (line.used + want <= LINE) {
        return want
    }
    drain($out, line)
    if (want <= LINE) {
        return want
    }
    LINE
}

put_bytes :: fn($out: fn(str), mut line: Line, text: str) {
    mut at: i64 = 0
    while (at < str_len(text)) {
        room := room_for($out, line, str_len(text) - at)
        mut k: i64 = 0
        while (k < room) {
            line.bytes[line.used + k] = text[at + k]
            k = k + 1
        }
        line.used = line.used + room
        at = at + room
    }
}

// A signed integer in base ten. The digits come out least significant first, so
// they are made in a scratch run and copied back in order, which is what avoids
// having to know how many there will be before starting.
//
// Each digit is taken off the negative side, so the most negative i64 needs no
// negation of its own and there is no value this cannot write.
put_int :: fn($out: fn(str), mut line: Line, value: i64) {
    mut digits: [20]u8 = [0; 20]
    mut count: i64 = 0
    mut rest := value
    negative := value < 0
    if (rest == 0) {
        digits[0] = 48
        count = 1
    }
    while (rest != 0) {
        mut digit := rest % 10
        if (negative) {
            digit = 0 - digit
        }
        digits[count] = cast($u8, 48 + digit)
        count = count + 1
        rest = rest / 10
    }
    if (negative) {
        put_bytes($out, line, "-")
    }
    mut k := count
    while (k > 0) {
        k = k - 1
        room_for($out, line, 1)
        line.bytes[line.used] = digits[k]
        line.used = line.used + 1
    }
}

// A `%g` is a couple of dozen bytes at most, so a line with that much room
// takes the whole of one and a line without is emptied first. What comes back
// is how many bytes were written, which the runtime holds to the room given.
put_f64 :: fn($out: fn(str), mut line: Line, value: f64) {
    room_for($out, line, 32)
    // The pointer is one past the bytes already composed and the room is what
    // is left of this line, so the run offered is inside the buffer by
    // construction.
    written := unsafe {
        frost_rt_format_f64(
            value,
            ptr_to(line.bytes[line.used]),
            LINE - line.used
        )
    }
    line.used = line.used + written
}

span :: fn(text: str, from: i64, count: i64) -> str {
    slice_range(text, from, count)
}

// The literal from `at` up to the next hole, composed, and the index past that
// hole answered. A run holding a doubled brace is copied in pieces, one per
// brace, and a run holding none is copied in one step.
//
// A `{` that opens nothing was refused where the call is written, so what
// arrives here is either a hole, a doubled brace, or a byte that stands for
// itself. That is why nothing here reports a fault: a lone `}` is a `}`.
run_from :: fn($out: fn(str), mut line: Line, fmt: str, at: i64) -> i64 {
    length := str_len(fmt)
    mut start := at
    mut index := at
    while (index < length) {
        byte := fmt[index]
        if (byte == 123 || byte == 125) {
            if (index + 1 < length) {
                next := fmt[index + 1]
                if (byte == 123 && next == 125) {
                    put_bytes($out, line, span(fmt, start, index - start))
                    return index + 2
                }
                if (next == byte) {
                    put_bytes($out, line, span(fmt, start, index + 1 - start))
                    index = index + 2
                    start = index
                    continue
                }
            }
        }
        index = index + 1
    }
    put_bytes($out, line, span(fmt, start, index - start))
    index
}

// The values, in the order the holes come. The chain over `value` is answered
// while the body is expanded, so what a call emits is the literal walk and one
// direct step per value: the arms that would not compile for that value's type
// are gone before the body is checked.
//
// The order the arms are asked in is what routes a `bool`, which answers no to
// every predicate and lands in the last two arms.
write :: fn($out: fn(str), format fmt: str, args: $...) {
    mut line := Line { bytes = [0; LINE], used = 0 }
    mut at: i64 = 0
    for value in args {
        at = run_from($out, line, fmt, at)
        $if (is_float(value)) {
            put_f64($out, line, cast($f64, value))
        } else $if (is_slice(value)) {
            put_bytes($out, line, value)
        } else $if (is_numeric(value)) {
            put_int($out, line, cast($i64, value))
        } else if (value) {
            put_int($out, line, 1)
        } else {
            put_int($out, line, 0)
        }
    }
    at = run_from($out, line, fmt, at)
    drain($out, line)
}

// `format` on the parameter is what makes the literal's holes count against the
// list that follows it: a call naming more holes than it gives values, or a
// value nothing can write, is refused where the call is written. `write` carries
// the same word, and this hands its own literal and its own list straight on,
// which is what lets the count be checked once at the caller.
print :: fn(format fmt: str, args: $...) {
    write($to_stdout, fmt, args)
}
