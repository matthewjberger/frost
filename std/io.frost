// Writing to standard output.
//
// Without this a program declares the C function it wants itself, which is why
// so many examples open with `printf :: extern fn(fmt: ^i8, value: i64) -> i32`.
// That is honest about the FFI, but it is a strange first line for a first
// program and it carries `printf`'s format string, which is one more thing to
// get wrong when what was wanted was to print a number.
//
// These go through the runtime's emit helpers rather than through `printf`, so
// there is no format string to get wrong and nothing is variadic. Nothing here
// names a raw pointer: a writer taking a `^i8` promises the bytes end in a NUL,
// and that is a promise the caller makes silently and the compiler cannot
// check. A `str` carries its length, so there is nothing to promise.

export print_int, print_char, print_str, print_int_line, print_str_line

// Each of these takes a number, or a pointer with the length beside it, so
// there is nothing a caller can hand them that misbehaves. They are `safe` and
// need no block at their call sites. (The bare name `print` is a statement
// keyword in the language, so the writers are named for what they write.)
frost_rt_emit_bytes :: safe extern fn(data: ^u8, length: i64)
frost_rt_emit_int :: safe extern fn(value: i64)
frost_rt_emit_char :: safe extern fn(byte: i64)

print_int :: fn(value: i64) { frost_rt_emit_int(value) }

print_char :: fn(byte: i64) { frost_rt_emit_char(byte) }

// The whole run in one call rather than a byte at a time. A string literal is a
// `str`, so `print_str("hello")` is what a first program writes.
print_str :: fn(text: str) {
    if (str_len(text) == 0) {
        return
    }
    frost_rt_emit_bytes(ptr_to(text[0]), str_len(text))
}

print_int_line :: fn(value: i64) {
    frost_rt_emit_int(value)
    frost_rt_emit_char(10)
}

print_str_line :: fn(text: str) { print_str(text)  print_char(10) }
