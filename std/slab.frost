// A generational slab, fixed-capacity storage with handles that go stale when
// the slot they name is reused. Generic over element type and capacity, written
// entirely in Frost, with no allocation and no runtime call.
//
// A `Slab` is recognized by the compiler as slab-shaped because it has a
// `storage` array and a parallel `generations` array, which is what lets a
// caller write `world[handle].hp = 75`. That place-deref is the only part the
// compiler supplies, because "return a validated reference into storage" cannot
// be written in a language where references are second-class. The storage, the
// free list, and every operation below are ordinary Frost.
//
// A handle is `Handle<T>` to callers and an i64 inside, where the slot index and
// the generation are packed together. The two convert freely because a handle is
// an i64 at the ABI.

export Slab, slab_reset, slab_full, slab_insert, slab_alive, slab_slot,
    slab_release, GENERATION_LIMIT, CONTAINER_SHIFT, frost_rt_container_id

frost_rt_container_id :: safe extern fn() -> i64

// The top 32 bits of a handle are the container's number and the slot's
// generation together, seven bits and twenty-four. Comparing them is one
// comparison, which is why the container's number costs nothing where a handle
// is read: the check that was already there catches both.
//
// What the container's number is for is that a generation says a slot has been
// reused and says nothing about which container the slot is in. Two pools of
// the same element type and capacity, which is what `active` and `pending` are,
// accept each other's handles: the slot is in range on both and the generations
// coincide. They coincide most reliably right after both are reset, when every
// generation is zero, so the state with no protection at all is the one a
// program starts in.
CONTAINER_SHIFT :: 24

// The highest generation a slot can carry. Above this the count would carry
// into the container's number and the slot would start answering for a
// different container.
//
// A slot that reaches this is retired: it is not returned to the free list, so
// the slab loses one place and stays correct. Every handle to it is already
// stale by the ordinary rule, which is the answer that keeps a long-running
// program running rather than stopping it on a number nobody wrote down.
// Reaching it takes sixteen million releases of one slot.
GENERATION_LIMIT :: 16777214

Slab :: struct($T: Type, $N: usize) {
    storage: [N]T,
    generations: [N]i64,
    free_list: [N]i64,
    free_count: i64,
}

// Every slot free, every generation back to zero, and the slab stamped with a
// number of its own. A slab is created with its arrays written out and then
// reset, since construction cannot run code.
//
// The number is taken here rather than at construction for the same reason: it
// is the first point that runs code. A slab reset twice is a different
// container each time, and the handles from before the reset stop reading,
// which is what a reset means.
slab_reset :: fn($T: Type, $N: usize, mut s: Slab<T, N>) {
    stamp := frost_rt_container_id() << CONTAINER_SHIFT
    var i: i64 = 0
    while (i < N) {
        s.generations[i] = stamp
        s.free_list[i] = N - 1 - i
        i = i + 1
    }
    s.free_count = N
}

slab_full :: fn($T: Type, $N: usize, s: Slab<T, N>) -> bool {
    s.free_count == 0
}

// The caller checks `slab_full` first. There is no in-band "no handle" value,
// because a handle that means nothing is exactly the thing generations exist to
// stop being readable.
slab_insert :: fn($T: Type, $N: usize, mut s: Slab<T, N>, move value: $T) -> Handle<T> {
    s.free_count = s.free_count - 1
    index := s.free_list[s.free_count]
    s.storage[index] = value
    packed := (s.generations[index] << 32) | index
    packed
}

slab_alive :: fn($T: Type, $N: usize, s: Slab<T, N>, handle: Handle<T>) -> bool {
    raw: i64 = handle
    s.generations[raw & 4294967295] == (raw >> 32)
}

// The slot a handle names, or -1 where the handle is stale.
//
// `s[handle]` checks the generation on every read, which is what makes a stale
// handle unreadable and is the right price for a handful of them. A pass that
// walks the same elements over and over pays it once a hop for an answer that
// cannot change while it runs: measured over twenty million hops, the check is
// about a nanosecond each and sixty per cent of a loop that does nothing else.
//
// This is how that is paid once. Ask for the slot at the boundary, and then index
// `storage` with it, which is bounds-checked like any array and compares against
// no generation:
//
//     slot := slab_slot($Unit, $1024, pool, handle)
//     if (slot >= 0) {
//         mut round : i64 = 0
//         while (round < many) {
//             total = total + pool.storage[slot].hp
//             round = round + 1
//         }
//     }
//
// What it costs is that the slot is a number rather than a handle, so nothing
// says it is still the element it was. Release a slot while a loop holds its
// number and the loop reads whatever moved in, which is exactly the reading a
// handle exists to refuse. So this belongs where the walk owns its data for the
// length of the walk, and the handle belongs everywhere else. It is spelled out
// at the site for that reason, the same way leaving the range is.
slab_slot :: fn($T: Type, $N: usize, s: Slab<T, N>, handle: Handle<T>) -> i64 {
    if (slab_alive($T, $N, s, handle) == false) {
        return -1
    }
    raw: i64 = handle
    raw & 4294967295
}

// Bumping the generation is what makes every outstanding handle to this slot
// stale, so a later read through one aborts rather than seeing the next tenant.
slab_release :: fn($T: Type, $N: usize, mut s: Slab<T, N>, handle: Handle<T>) -> bool {
    raw: i64 = handle
    index := raw & 4294967295
    if (s.generations[index] != (raw >> 32)) { return false }
    s.generations[index] = s.generations[index] + 1
    // A slot whose generation is spent is retired rather than reused. One more
    // release would carry the count into the container's number and the slot
    // would answer for a container it is not in.
    if ((s.generations[index] & 16777215) > GENERATION_LIMIT) {
        return true
    }
    s.free_list[s.free_count] = index
    s.free_count = s.free_count + 1
    true
}

SlabThing :: struct { hp: i64 }

// The slot a live handle names is the one its element sits in, so indexing
// `storage` with it reads what the handle reads. A released handle names no slot,
// which is what keeps the boundary honest: the check happens here or the caller
// is told there is nothing to walk.
test "a slot stands in for a handle until the handle goes stale" {
    var s: Slab<SlabThing, 2> = Slab {
        storage = [SlabThing { hp = 0 }, SlabThing { hp = 0 }],
        generations = [0, 0],
        free_list = [0, 0],
        free_count = 0,
    }
    slab_reset($SlabThing, $2, s)
    held := slab_insert($SlabThing, $2, s, SlabThing { hp = 41 })
    slot := slab_slot($SlabThing, $2, s, held)
    assert(slot >= 0)
    assert(s.storage[slot].hp == 41)
    assert(s.storage[slot].hp == s[held].hp)
    assert(slab_release($SlabThing, $2, s, held))
    assert(slab_slot($SlabThing, $2, s, held) == (-1))
}

// A slot one release short of its bound still works, and the release that takes
// it past retires it rather than handing it back. Driven by writing the
// generation rather than by two billion releases, which is the only way to reach
// this in a test and is why the bound went unnoticed.
test "a slot whose generation is spent is retired rather than reused" {
    var s: Slab<SlabThing, 2> = Slab {
        storage = [SlabThing { hp = 0 }, SlabThing { hp = 0 }],
        generations = [0, 0],
        free_list = [0, 0],
        free_count = 0,
    }
    slab_reset($SlabThing, $2, s)

    first := slab_insert($SlabThing, $2, s, SlabThing { hp = 7 })
    raw: i64 = first
    index := raw & 4294967295
    stamp := s.generations[index] & (-16777216)
    // One short of the bound: the release puts the slot back and the handle it
    // then hands out is one its own check accepts. The slab's own number is
    // kept, since a slot that changed it would be a slot in another container.
    s.generations[index] = stamp | (GENERATION_LIMIT - 1)
    assert(slab_release($SlabThing, $2, s, (s.generations[index] << 32) | index))
    assert(s.free_count == 2)
    again := slab_insert($SlabThing, $2, s, SlabThing { hp = 8 })
    assert(slab_alive($SlabThing, $2, s, again))

    // And the release that takes it past: the slot does not come back, so the
    // slab has one fewer place rather than a handle that is stale on arrival.
    raw_again: i64 = again
    spent := raw_again & 4294967295
    s.generations[spent] = stamp | GENERATION_LIMIT
    before := s.free_count
    assert(slab_release($SlabThing, $2, s,
            (s.generations[spent] << 32) | spent))
    assert(s.free_count == before)
}
