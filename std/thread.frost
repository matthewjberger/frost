// OS threads. A thread runs a `fn(^u8)` with a context pointer the spawner
// supplies, and a join waits for it to finish. The context is a raw pointer
// because a thread crosses into C, where the body is a `void (*)(void*)` and the
// context is its `void*`. The body casts it back to the type it knows.
//
// This is the reasonable-C floor rather than a checked concurrency model. The
// spawner owns the context and must keep it alive until the join, and any state
// two threads touch at once has to go through `atomic_add` or the program races.
// `spawn`, `join` and `atomic_add` are the unsafe operations, wrapped here.

export spawn, join, atomic_add

frost_rt_thread_spawn :: extern fn(body: fn(^u8), context: ^u8) -> i64
frost_rt_thread_join :: extern fn(handle: i64)
frost_rt_atomic_add_i64 :: extern fn(cell: ^i64, amount: i64) -> i64

// Run `body` on a new thread with `context`, and answer a handle to join later.
// The context must outlive the thread, so it lives in the spawner's frame and
// the spawner holds off reading it until after the join.
spawn :: fn(body: fn(^u8), context: ^u8) -> i64 {
    unsafe { frost_rt_thread_spawn(body, context) }
}

join :: fn(handle: i64) {
    unsafe { frost_rt_thread_join(handle) }
}

// Add to a shared word and answer its value before the add. Several threads may
// call this on the same cell at once without a lock, which is how they combine
// results without racing.
atomic_add :: fn(cell: ^i64, amount: i64) -> i64 {
    unsafe { frost_rt_atomic_add_i64(cell, amount) }
}

// A body takes the context as the `void*` C hands it and casts it back, which
// is the whole of the convention. These two are what the tests below run.
bump_once :: fn(context: ^u8) {
    atomic_add(unsafe { ptr_cast($i64, context) }, 1)
}

bump_many :: fn(context: ^u8) {
    cell := unsafe { ptr_cast($i64, context) }
    var left : i64 = 0
    while (left < 1000) {
        atomic_add(cell, 1)
        left = left + 1
    }
}

test "a thread runs its body and a join waits for it" {
    var cell : i64 = 0
    handle := spawn(bump_once, unsafe { ptr_cast($u8, ptr_to(cell)) })
    join(handle)
    assert(cell == 1)
}

// Four threads adding to one word a thousand times each. Without the atomic
// this loses adds, so the count is what says the operation is one.
test "concurrent adds to one cell lose nothing" {
    var cell : i64 = 0
    var handles : [4]i64 = [0, 0, 0, 0]
    var spawned : i64 = 0
    while (spawned < 4) {
        handles[spawned] = spawn(bump_many,
            unsafe { ptr_cast($u8, ptr_to(cell)) })
        spawned = spawned + 1
    }
    var joined : i64 = 0
    while (joined < 4) {
        join(handles[joined])
        joined = joined + 1
    }
    assert(cell == 4000)
}

// What the add answers is the value before it, so a thread can tell which of
// them it was without a second read that another could land between.
test "an atomic add answers the value it found" {
    var cell : i64 = 7
    before := atomic_add(ptr_to(cell), 5)
    assert(before == 7)
    assert(cell == 12)
}
