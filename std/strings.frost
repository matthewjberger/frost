// Operations over `str`, which is a pointer and a length rather than a
// NUL-terminated buffer, so every one of these is a bounds-checked walk with no
// allocation anywhere. `str_len` and `s[i]` are the only primitives, and the
// rest is ordinary Frost over them.
//
// Nothing here builds a string, because that needs storage and this module does
// not decide where a caller's storage comes from. What it offers is answers
// about strings, and views into the one it was given: a view carries a pointer
// and a length into bytes that already exist, so it allocates nothing and lasts
// as long as what it views. Building goes through an arena the caller owns.

import "mem.frost"

export str_eq, str_starts_with, str_ends_with, str_index_of, str_contains,
    str_count, str_is_empty, str_to_i64, str_to_f64,
    str_byte_is_digit, str_byte_is_space,
    str_slice, str_span

str_is_empty :: fn(s: str) -> bool { str_len(s) == 0 }

// `count` bytes of `s` starting at `from`, viewing the same storage. `from` is
// bounds-checked because reaching it is an index, and `count` is the caller's
// word. This is what a program reaches for instead of carrying an offset and a
// length beside every string it means to look at part of.
str_slice :: fn(s: str, from: i64, count: i64) -> str {
    slice_range($u8, s, from, count)
}

// The same, stopping at the end of `s` rather than past it, so a walk that asks
// for more than is left gets what is left.
str_span :: fn(s: str, from: i64, count: i64) -> str {
    slice_span($u8, s, from, count)
}

str_eq :: fn(a: str, b: str) -> bool {
    if (str_len(a) != str_len(b)) { return false }
    for index, byte in a {
        if (byte != b[index]) { return false }
    }
    true
}

str_starts_with :: fn(s: str, prefix: str) -> bool {
    if (str_len(prefix) > str_len(s)) { return false }
    for index, byte in prefix {
        if (s[index] != byte) { return false }
    }
    true
}

str_ends_with :: fn(s: str, suffix: str) -> bool {
    if (str_len(suffix) > str_len(s)) { return false }
    offset := str_len(s) - str_len(suffix)
    for index, byte in suffix {
        if (s[offset + index] != byte) { return false }
    }
    true
}

// The index of the first occurrence, or -1. An out-of-band answer rather than
// an optional, because a caller almost always compares it to -1 immediately and
// an enum here would cost a match at every call for nothing.
str_index_of :: fn(s: str, needle: str) -> i64 {
    if (str_len(needle) == 0) { return 0 }
    if (str_len(needle) > str_len(s)) { return -1 }
    last := str_len(s) - str_len(needle)
    mut start : i64 = 0
    while (start <= last) {
        mut i : i64 = 0
        mut same := true
        while (i < str_len(needle)) {
            if (s[start + i] != needle[i]) { same = false  i = str_len(needle) }
            else { i = i + 1 }
        }
        if (same) { return start }
        start = start + 1
    }
    -1
}

str_contains :: fn(s: str, needle: str) -> bool {
    str_index_of(s, needle) >= 0
}

str_count :: fn(s: str, byte: i64) -> i64 {
    mut found : i64 = 0
    for held in s {
        if (held == byte) { found = found + 1 }
    }
    found
}

str_byte_is_digit :: fn(byte: i64) -> bool { byte >= 48 && byte <= 57 }

str_byte_is_space :: fn(byte: i64) -> bool {
    byte == 32 || byte == 9 || byte == 10 || byte == 13
}

// Reads a decimal integer, with an optional leading `-`. Answers 0 for anything
// it cannot read, which is the same thing C's `atoi` does. This does not
// distinguish "0" from "not a number". A caller that needs the difference
// checks the bytes first.
str_to_i64 :: fn(s: str) -> i64 {
    mut i : i64 = 0
    mut negative := false
    if (str_len(s) > 0 && s[0] == 45) { negative = true  i = 1 }
    mut value : i64 = 0
    while (i < str_len(s)) {
        if (str_byte_is_digit(s[i]) == false) { return 0 }
        value = value * 10 + (s[i] - 48)
        i = i + 1
    }
    if (negative) { -value } else { value }
}

// Reads a decimal number: an optional sign, digits, an optional fraction, and
// an optional `e` exponent. Answers 0.0 for anything it cannot read, the way
// `str_to_i64` answers 0, so a caller that needs to tell "0" from "not a
// number" looks at the bytes first.
//
// The digits become one integer and where the point sat becomes a power of ten,
// so a number costs one scaling rather than a rounding per digit. Where the
// integer is under 2^53 and the power is one of the twenty-three a double holds
// exactly, both sides are exact and the answer is the nearest double to what
// was written. Past that the scaling goes in steps of twenty-two and the last
// place can differ.
str_to_f64 :: fn(s: str) -> f64 {
    mut at : i64 = 0
    mut negative := false
    if (str_len(s) > 0 && (s[0] == 45 || s[0] == 43)) {
        negative = s[0] == 45
        at = 1
    }
    mut mantissa : i64 = 0
    mut digits : i64 = 0
    mut exponent : i64 = 0
    mut any := false
    while (at < str_len(s) && str_byte_is_digit(s[at])) {
        any = true
        if (digits < SIGNIFICANT) {
            mantissa = mantissa * 10 + (s[at] - 48)
            digits = digits + 1
        } else {
            // Past what an integer holds, a digit is only its place.
            exponent = exponent + 1
        }
        at = at + 1
    }
    if (at < str_len(s) && s[at] == 46) {
        at = at + 1
        while (at < str_len(s) && str_byte_is_digit(s[at])) {
            any = true
            if (digits < SIGNIFICANT) {
                mantissa = mantissa * 10 + (s[at] - 48)
                digits = digits + 1
                exponent = exponent - 1
            }
            at = at + 1
        }
    }
    if (any == false) { return 0.0 }
    if (at < str_len(s) && (s[at] == 101 || s[at] == 69)) {
        at = at + 1
        mut power_negative := false
        if (at < str_len(s) && (s[at] == 45 || s[at] == 43)) {
            power_negative = s[at] == 45
            at = at + 1
        }
        mut power : i64 = 0
        mut power_digits := false
        while (at < str_len(s) && str_byte_is_digit(s[at])) {
            power_digits = true
            // Bounded, since anything this far out is already past what a
            // double can hold and the scaling below saturates either way.
            if (power < 1000000) {
                power = power * 10 + (s[at] - 48)
            }
            at = at + 1
        }
        if (power_digits == false) { return 0.0 }
        if (power_negative) {
            exponent = exponent - power
        } else {
            exponent = exponent + power
        }
    }
    if (at != str_len(s)) { return 0.0 }
    scaled := scale_by_ten(mantissa, exponent)
    if (negative) { -scaled } else { scaled }
}

// As many digits as an integer holds without overflowing on the next one.
SIGNIFICANT :: 18

// Powers of ten a double holds exactly, which runs out after this many.
EXACT_POWERS :: 23

// The largest integer a double holds exactly, so a mantissa under it converts
// without rounding and the scaling below is the only rounding there is.
EXACT_INTEGER :: 9007199254740992

scale_by_ten :: fn(mantissa: i64, exponent: i64) -> f64 {
    mut powers : [EXACT_POWERS]f64 = [
        1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
        1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]
    held : f64 = mantissa
    if (mantissa < EXACT_INTEGER) {
        if (exponent >= 0 && exponent < EXACT_POWERS) {
            return held * powers[exponent]
        }
        if (exponent < 0 && -exponent < EXACT_POWERS) {
            return held / powers[-exponent]
        }
    }
    mut result := held
    mut left := exponent
    while (left > 0) {
        mut step := left
        if (step > EXACT_POWERS - 1) { step = EXACT_POWERS - 1 }
        result = result * powers[step]
        left = left - step
    }
    while (left < 0) {
        mut step := -left
        if (step > EXACT_POWERS - 1) { step = EXACT_POWERS - 1 }
        result = result / powers[step]
        left = left + step
    }
    result
}

test "a decimal number reads as the nearest double" {
    // Every one of these is a double exactly, so the comparison is equality
    // rather than a tolerance: a tolerance would pass on an answer that is
    // merely close, which is the thing worth catching.
    assert(str_to_f64("0") == 0.0)
    assert(str_to_f64("1") == 1.0)
    assert(str_to_f64("-1") == -1.0)
    assert(str_to_f64("0.5") == 0.5)
    assert(str_to_f64("-0.25") == -0.25)
    assert(str_to_f64("123.456") == 123.456)
    assert(str_to_f64("1e3") == 1000.0)
    assert(str_to_f64("1E3") == 1000.0)
    assert(str_to_f64("1e-3") == 0.001)
    assert(str_to_f64("1.5e2") == 150.0)
    assert(str_to_f64("-2.5e-2") == -0.025)
    assert(str_to_f64("+3") == 3.0)
    // The whole number is read, so a fraction is not dropped the way a reader
    // that stopped at the point would drop it.
    assert(str_to_f64("2.75") != 2.0)
}

test "a decimal number that is not one reads as zero" {
    assert(str_to_f64("") == 0.0)
    assert(str_to_f64("-") == 0.0)
    assert(str_to_f64("abc") == 0.0)
    assert(str_to_f64("1.2.3") == 0.0)
    assert(str_to_f64("12a") == 0.0)
    assert(str_to_f64("1e") == 0.0)
    assert(str_to_f64("1e+") == 0.0)
    assert(str_to_f64(".") == 0.0)
}

test "a number past what a double holds saturates rather than wrapping" {
    assert(str_to_f64("1e400") > 1e300)
    assert(str_to_f64("-1e400") < -1e300)
    assert(str_to_f64("1e-400") == 0.0)
    // Eighteen digits fit and the nineteenth is a place, so the value is the
    // same either way round.
    assert(str_to_f64("1234567890123456789") == 1234567890123456789.0)
}

test "equality compares bytes and length" {
    assert(str_eq("abc", "abc"))
    assert(str_eq("", ""))
    assert(str_eq("abc", "abd") == false)
    assert(str_eq("ab", "abc") == false)
}

test "prefixes and suffixes" {
    assert(str_starts_with("hello world", "hello"))
    assert(str_starts_with("hello", "hello"))
    assert(str_starts_with("hi", "hello") == false)
    assert(str_ends_with("hello world", "world"))
    assert(str_ends_with("hello", "lo"))
    assert(str_ends_with("lo", "hello") == false)
}

test "searching" {
    assert(str_index_of("hello world", "world") == 6)
    assert(str_index_of("hello", "h") == 0)
    assert(str_index_of("hello", "z") == -1)
    assert(str_index_of("hello", "") == 0)
    assert(str_index_of("ab", "abc") == -1)
    assert(str_contains("hello world", "lo w"))
    assert(str_contains("hello", "world") == false)
}

test "counting and emptiness" {
    assert(str_count("banana", 97) == 3)
    assert(str_count("banana", 122) == 0)
    assert(str_is_empty(""))
    assert(str_is_empty("a") == false)
}

test "reading an integer" {
    assert(str_to_i64("0") == 0)
    assert(str_to_i64("42") == 42)
    assert(str_to_i64("-7") == -7)
    assert(str_to_i64("1234567") == 1234567)
    assert(str_to_i64("12a") == 0)
}

test "a slice views part of a string" {
    s := "hello world"
    assert(str_eq(str_slice(s, 0, 5), "hello"))
    assert(str_eq(str_slice(s, 6, 5), "world"))
    assert(str_eq(str_slice(s, 4, 3), "o w"))
    assert(str_len(str_slice(s, 3, 0)) == 0)
}

test "a span stops at the end" {
    s := "hello"
    assert(str_eq(str_span(s, 3, 99), "lo"))
    assert(str_eq(str_span(s, 0, 99), "hello"))
    assert(str_len(str_span(s, 5, 4)) == 0)
    assert(str_len(str_span(s, 99, 4)) == 0)
    assert(str_len(str_span("", 0, 4)) == 0)
}

test "a view is the bytes it views" {
    s := "banana"
    inner := str_slice(s, 1, 3)
    assert(str_eq(inner, "ana"))
    assert(str_index_of(inner, "n") == 1)
    assert(str_contains(inner, "na"))
    assert(str_count(inner, 97) == 2)
}

test "byte classes" {
    assert(str_byte_is_digit(48))
    assert(str_byte_is_digit(57))
    assert(str_byte_is_digit(58) == false)
    assert(str_byte_is_space(32))
    assert(str_byte_is_space(65) == false)
}
