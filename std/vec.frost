// A growable array, generic over its element. Storage is one heap block that
// doubles when it fills, and the live elements are presented as a `[]T` so a
// caller reads, writes and borrows them through the bounds-checked slice path
// rather than through the raw pointer inside.
//
// The storage is a slice of the whole block rather than a raw pointer, so every
// access here is bounds-checked too and this file has no `unsafe` of its own.
// What is unchecked is the allocation, and that lives in mem.frost. `vec_slice`
// is the safe face: a caller does `vec_slice(v)[i]`, `ref e := vec_slice(v)[i]`,
// and `slice_len`.

import "mem.frost"

export Vec, vec_new, vec_free, vec_len, vec_slice, vec_push, vec_get, vec_set,
    vec_clear, vec_truncate

Vec :: linear struct($T: Type) {
    // The whole block, whose length is the capacity. The live prefix is `len`.
    storage: []T,
    len: i64,
    cap: i64,
}

// An empty vector with room reserved up front, so a known-size fill does not
// reallocate. A capacity of zero is allowed and grows on the first push.
vec_new :: fn($T: Type, capacity: i64) -> Vec<T> {
    var room := capacity
    if (room < 1) { room = 1 }
    Vec { storage = heap_slice($T, room), len = 0, cap = room }
}

// Give the block back. This frees the storage, not the elements: where `T` is a
// resource, every element has to have been consumed before this runs, and that
// is the caller's obligation rather than something the compiler checks. An
// element is reached by a number worked out while the program runs, so there is
// no place the check could name to say the obligation was discharged. The
// pattern that discharges it is a walk over `vec_slice` consuming each element
// through a `ref` borrow, and then this.
//
// It is not held back from resources the way `vec_get` and `vec_set` are.
// `Vec<T>` is itself a resource whatever `T` is, so this is the only thing that
// consumes one, and a bound here would leave a container of resources with no
// way to be discharged at all.
vec_free :: fn($T: Type, move v: Vec<T>) {
    heap_release_slice($T, v.storage)
}

vec_len :: fn($T: Type, v: Vec<T>) -> i64 {
    v.len
}

// The live elements as a bounds-checked slice. This is how everything above the
// container reaches an element: read it, assign it, or bind `ref` to it.
vec_slice :: fn($T: Type, v: Vec<T>) -> []T {
    slice_prefix($T, v.storage, v.len)
}

vec_push :: fn($T: Type, mut v: Vec<T>, move value: $T) {
    // Grow when full, doubling the storage. The reallocation is done here
    // rather than in a helper because passing this borrow on to another `mut`
    // parameter copies the header, so the new storage would be written to the
    // copy and lost.
    if (v.len >= v.cap) {
        var room := v.cap * 2
        if (room < 1) { room = 1 }
        v.storage = heap_grow_slice($T, v.storage, room)
        v.cap = room
    }
    var held := v.storage
    held[v.len] = value
    v.len = v.len + 1
}

// A copy of an element. Held to elements that are not resources: this answers
// with what it read out of a container it only borrows, and which element it
// read is a number worked out while the program runs, so a caller cannot be
// told the element went and nothing stops it asking twice and being handed the
// same one. A resource element is reached through `vec_slice`, where
// `ref e := vec_slice(v)[i]` stays a borrow and the container keeps it.
vec_get :: fn($T: Type, v: Vec<T>, index: i64) -> $T where !is_linear(T) {
    v.storage[index]
}

// Held to elements that are not resources: the write drops whatever was in the
// slot and nothing consumes it. Answering with the old element instead would
// hand a resource out of a borrowed container by an element, which is the shape
// `vec_get` is held back from, so there is no consuming form of this to reach
// for either.
vec_set :: fn($T: Type, mut v: Vec<T>, index: i64, move value: $T)
    where !is_linear(T) {
    var held := v.storage
    held[index] = value
}

// Drop every element without freeing the storage, so the vector is reused
// rather than reallocated. Held to elements that are not resources, since
// forgetting a resource is dropping it without consuming it.
vec_clear :: fn($T: Type, mut v: Vec<T>) where !is_linear(T) {
    v.len = 0
}

// Drops everything past a length. A shorter one is what is left after an
// element is taken out of the middle and the rest moved down over it.
vec_truncate :: fn($T: Type, mut v: Vec<T>, length: i64) where !is_linear(T) {
    if (length < 0 || length > v.len) {
        return
    }
    v.len = length
}

VecPoint :: struct { x: i64, y: i64 }

test "a vector holds what is pushed into it, in order" {
    var v := vec_new($i64, 2)
    assert(vec_len($i64, v) == 0)
    var i : i64 = 0
    while (i < 100) {
        vec_push($i64, v, i * 3)
        i = i + 1
    }
    assert(vec_len($i64, v) == 100)
    assert(vec_get($i64, v, 0) == 0)
    assert(vec_get($i64, v, 99) == 297)
    assert(slice_len(vec_slice($i64, v)) == 100)
    vec_set($i64, v, 50, 7)
    assert(vec_get($i64, v, 50) == 7)
    assert(vec_slice($i64, v)[50] == 7)
    vec_free($i64, v)
}

test "the slice a vector hands out is as long as the vector, not the block" {
    var v := vec_new($i64, 64)
    vec_push($i64, v, 1)
    vec_push($i64, v, 2)
    // The room is 64 and the elements are two, and a caller sees the two.
    assert(slice_len(vec_slice($i64, v)) == 2)
    vec_free($i64, v)
}

test "clearing keeps the storage and forgets the elements" {
    var v := vec_new($i64, 4)
    vec_push($i64, v, 1)
    vec_push($i64, v, 2)
    settled := heap_live()
    vec_clear($i64, v)
    assert(vec_len($i64, v) == 0)
    assert(slice_len(vec_slice($i64, v)) == 0)
    vec_push($i64, v, 9)
    assert(vec_get($i64, v, 0) == 9)
    // Reusing rather than reallocating is the whole point of clearing.
    assert(heap_live() == settled)
    vec_free($i64, v)
}

test "a vector of structs is written through its slice" {
    var v := vec_new($VecPoint, 2)
    vec_push($VecPoint, v, VecPoint { x = 1, y = 2 })
    vec_push($VecPoint, v, VecPoint { x = 3, y = 4 })
    var held := vec_slice($VecPoint, v)
    held[1].x = 30
    assert(vec_get($VecPoint, v, 1).x == 30)
    assert(vec_get($VecPoint, v, 0).y == 2)
    vec_free($VecPoint, v)
}

test "a vector gives back every block it took, however far it grew" {
    before := heap_live()
    var v := vec_new($i64, 1)
    var i : i64 = 0
    while (i < 500) {
        vec_push($i64, v, i)
        i = i + 1
    }
    vec_free($i64, v)
    assert(heap_live() == before)
}
