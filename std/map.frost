// A hash map by open addressing with linear probing, from keys of any type to
// values of any type.
//
// What it means to hash a key and to compare two of them is a value: a
// `Hashing<K>` is an ordinary struct whose two fields happen to be functions,
// and an implementation is an ordinary constant of it. A call passes the one it
// wants as a compile-time argument, so the hash and the comparison fold to
// direct calls and the map holds no function pointer. This is the shape
// `Ordering<T>` gives a sort: no registry, no lookup, no coherence rule.
//
//     mut ages := map_new($str, $i64, 16)
//     map_put($Text, $i64, $text_keys, ages, text("ada"), 36)
//     held := map_get($Text, $i64, $text_keys, ages, text("ada"), 0)
//
// `i64_keys` and `str_keys` cover the two common cases. A key of any other type
// needs a hash and an equality over it, written once and named at each call.
//
// Three parallel heap arrays: the keys, the values, and a state byte per slot
// saying empty, used, or tombstone. The table doubles when it is half full,
// which keeps probe runs short. The raw pointers and the allocation are the
// unsafe floor, wrapped here.

import "mem.frost"

export Map, Hashing, Slot, map_new, map_free, map_len, map_put, map_get, map_has,
    map_remove, map_clear,
    i64_hash, i64_same, str_hash, str_same, i64_keys,
    Text, text, text_hash, text_same, text_keys

// What a slot holds. A tombstone is a slot a key was removed from: a probe run
// passes through one rather than stopping, so the keys placed after it are
// still reached.
Slot :: enum { Empty, Used, Gone }

// The three runs are slices of the whole table, so every read and write here is
// bounds-checked and this file has no `unsafe` of its own. What is unchecked is
// the allocation, and that lives in mem.frost.
Map :: linear struct($K: Type, $V: Type) {
    keys: []K,
    values: []V,
    state: []Slot,
    cap: i64,
    count: i64,
}

// What a key type has to answer: a number, and whether two of them are the same
// key. Nothing else about the type is needed, and nothing is implicit.
Hashing :: struct($K: Type) {
    hash: fn(K) -> i64,
    equal: fn(K, K) -> bool,
}

// A scramble of the number, so keys that differ in low bits alone do not all
// land in one run of slots.
i64_hash :: fn(key: i64) -> i64 {
    mut h := key * 2654435761
    h = h + (h / 4096)
    h
}

i64_same :: fn(a: i64, b: i64) -> bool {
    a == b
}

// A multiply-and-add over the bytes. A string's hash is its contents, so two
// strings that read the same are one key however each was built. The mask keeps
// the running value positive, since the slot is a remainder of it.
str_hash :: fn(key: str) -> i64 {
    mut h : i64 = 2166136261
    for index, byte in key {
        h = ((h * 33) + byte) & 4611686018427387903
    }
    h
}

// A string as a key. The bytes are wrapped in a struct rather than used bare
// because a key is an element of a run, and a run of slices is a shape the
// self-hosted compiler does not yet hold (docs/book/src/roadmap.md).
Text :: struct {
    bytes: str,
}

text :: fn(bytes: str) -> Text {
    Text { bytes = bytes }
}

text_hash :: fn(key: Text) -> i64 {
    str_hash(key.bytes)
}

text_same :: fn(a: Text, b: Text) -> bool {
    str_same(a.bytes, b.bytes)
}

str_same :: fn(a: str, b: str) -> bool {
    if (str_len(a) != str_len(b)) {
        return false
    }
    mut i : i64 = 0
    while (i < str_len(a)) {
        if (a[i] != b[i]) {
            return false
        }
        i = i + 1
    }
    true
}

i64_keys :: Hashing<i64> { hash = i64_hash, equal = i64_same }
text_keys :: Hashing<Text> { hash = text_hash, equal = text_same }

// A power-of-two capacity, so the slot index is a mask rather than a modulo,
// and a fresh block with every slot empty.
map_new :: fn($K: Type, $V: Type, capacity: i64) -> Map<K, V> {
    mut cap : i64 = 8
    while (cap < capacity) { cap = cap * 2 }
    keys := heap_slice($K, cap)
    values := heap_slice($V, cap)
    mut state := heap_slice($Slot, cap)
    mut i : i64 = 0
    while (i < cap) {
        state[i] = Slot::Empty
        i = i + 1
    }
    Map { keys = keys, values = values, state = state, cap = cap, count = 0 }
}

map_free :: fn($K: Type, $V: Type, move m: Map<K, V>) {
    heap_release_slice($K, m.keys)
    heap_release_slice($V, m.values)
    heap_release_slice($Slot, m.state)
}

map_len :: fn($K: Type, $V: Type, m: Map<K, V>) -> i64 {
    m.count
}

// The slot a key sits in, or the first empty slot on its probe run, whichever
// comes first. A tombstone is probed past rather than stopped at, so a key put
// after a removal is still found.
map_find :: fn($K: Type, $V: Type, $ops: Hashing<K>, m: Map<K, V>,
    key: $K) -> i64 {
    mut i := ops.hash(key) % m.cap
    if (i < 0) {
        i = 0 - i
    }
    held := m.keys
    while (true) {
        s := m.state[i]
        if (s == Slot::Empty) { return i }
        if (s == Slot::Used && ops.equal(held[i], key)) {
            return i
        }
        i = i + 1
        if (i >= m.cap) { i = 0 }
    }
    0 - 1
}

// Place a key and value into a table that is known to have room, without the
// load-factor check or the growth. Both `map_put` and the rehash in `map_grow`
// insert through this, which keeps the two out of a mutual recursion.
map_insert :: fn($K: Type, $V: Type, $ops: Hashing<K>, mut m: Map<K, V>,
    key: $K, move value: $V) {
    slot := map_find($K, $V, $ops, m, key)
    if (m.state[slot] != Slot::Used) {
        m.count = m.count + 1
    }
    mut keys := m.keys
    mut values := m.values
    mut state := m.state
    keys[slot] = key
    values[slot] = value
    state[slot] = Slot::Used
}

map_grow :: fn($K: Type, $V: Type, $ops: Hashing<K>, mut m: Map<K, V>) {
    old_keys := m.keys
    old_values := m.values
    old_state := m.state
    old_cap := m.cap
    // The new runs are made here rather than by building a whole map and
    // taking it apart: a map is a resource, and one made only to have its
    // fields stolen would be a resource nothing consumed.
    room := old_cap * 2
    m.keys = heap_slice($K, room)
    m.values = heap_slice($V, room)
    mut fresh_state := heap_slice($Slot, room)
    mut s : i64 = 0
    while (s < room) {
        fresh_state[s] = Slot::Empty
        s = s + 1
    }
    m.state = fresh_state
    m.cap = room
    m.count = 0
    mut i : i64 = 0
    while (i < old_cap) {
        if (old_state[i] == Slot::Used) {
            map_insert($K, $V, $ops, m, old_keys[i], old_values[i])
        }
        i = i + 1
    }
    heap_release_slice($K, old_keys)
    heap_release_slice($V, old_values)
    heap_release_slice($Slot, old_state)
}

map_put :: fn($K: Type, $V: Type, $ops: Hashing<K>, mut m: Map<K, V>,
    key: $K, move value: $V) {
    if (m.count * 2 >= m.cap) {
        map_grow($K, $V, $ops, m)
    }
    map_insert($K, $V, $ops, m, key, value)
}

map_has :: fn($K: Type, $V: Type, $ops: Hashing<K>, m: Map<K, V>,
    key: $K) -> bool {
    slot := map_find($K, $V, $ops, m, key)
    m.state[slot] == Slot::Used
}

// The value for a key, or the supplied default when the key is absent, so a
// caller reads without a separate presence check when a default will do.
map_get :: fn($K: Type, $V: Type, $ops: Hashing<K>, m: Map<K, V>, key: $K,
    move fallback: $V) -> $V {
    slot := map_find($K, $V, $ops, m, key)
    if (m.state[slot] == Slot::Used) {
        return m.values[slot]
    }
    fallback
}

// Remove a key, leaving a tombstone so a probe run through the slot still
// reaches keys placed after it. Answers whether the key was there.
map_remove :: fn($K: Type, $V: Type, $ops: Hashing<K>, mut m: Map<K, V>,
    key: $K) -> bool {
    slot := map_find($K, $V, $ops, m, key)
    found := m.state[slot] == Slot::Used
    if (found) {
        mut state := m.state
        state[slot] = Slot::Gone
        m.count = m.count - 1
    }
    found
}

// Empty every slot without freeing the table, so it is reused rather than
// reallocated.
map_clear :: fn($K: Type, $V: Type, mut m: Map<K, V>) {
    mut state := m.state
    mut i : i64 = 0
    while (i < m.cap) {
        state[i] = Slot::Empty
        i = i + 1
    }
    m.count = 0
}

Cell :: struct { x: i64, y: i64 }

cell_hash :: fn(c: Cell) -> i64 {
    (i64_hash(c.x) + (i64_hash(c.y) * 31)) & 4611686018427387903
}

cell_same :: fn(a: Cell, b: Cell) -> bool {
    a.x == b.x && a.y == b.y
}

cell_keys :: Hashing<Cell> { hash = cell_hash, equal = cell_same }

test "a value is put and read back" {
    mut m := map_new($i64, $i64, 8)
    map_put($i64, $i64, $i64_keys, m, 1, 10)
    map_put($i64, $i64, $i64_keys, m, 2, 20)
    assert(map_len($i64, $i64, m) == 2)
    assert(map_get($i64, $i64, $i64_keys, m, 1, 0) == 10)
    assert(map_get($i64, $i64, $i64_keys, m, 2, 0) == 20)
    assert(map_get($i64, $i64, $i64_keys, m, 3, 0 - 1) == 0 - 1)
    assert(map_has($i64, $i64, $i64_keys, m, 2))
    map_free($i64, $i64, m)
}

test "a key put twice holds the second value" {
    mut m := map_new($i64, $i64, 8)
    map_put($i64, $i64, $i64_keys, m, 7, 1)
    map_put($i64, $i64, $i64_keys, m, 7, 2)
    assert(map_len($i64, $i64, m) == 1)
    assert(map_get($i64, $i64, $i64_keys, m, 7, 0) == 2)
    map_free($i64, $i64, m)
}

test "a removed key is gone and the ones after it are still found" {
    mut m := map_new($i64, $i64, 8)
    mut i : i64 = 0
    while (i < 6) {
        map_put($i64, $i64, $i64_keys, m, i, i * 100)
        i = i + 1
    }
    assert(map_remove($i64, $i64, $i64_keys, m, 3))
    assert(map_remove($i64, $i64, $i64_keys, m, 3) == false)
    assert(map_has($i64, $i64, $i64_keys, m, 3) == false)
    assert(map_get($i64, $i64, $i64_keys, m, 4, 0) == 400)
    assert(map_len($i64, $i64, m) == 5)
    map_free($i64, $i64, m)
}

test "the table grows and keeps everything it held" {
    mut m := map_new($i64, $i64, 8)
    mut i : i64 = 0
    while (i < 200) {
        map_put($i64, $i64, $i64_keys, m, i, i + 1)
        i = i + 1
    }
    assert(map_len($i64, $i64, m) == 200)
    mut k : i64 = 0
    while (k < 200) {
        assert(map_get($i64, $i64, $i64_keys, m, k, 0) == k + 1)
        k = k + 1
    }
    map_free($i64, $i64, m)
}

test "a string is a key by what it holds rather than where it is" {
    mut ages := map_new($Text, $i64, 8)
    map_put($Text, $i64, $text_keys, ages, text("ada"), 36)
    map_put($Text, $i64, $text_keys, ages, text("grace"), 45)
    assert(map_get($Text, $i64, $text_keys, ages, text("ada"), 0) == 36)
    assert(map_get($Text, $i64, $text_keys, ages, text("grace"), 0) == 45)
    assert(map_get($Text, $i64, $text_keys, ages, text("alan"), 0) == 0)
    assert(map_has($Text, $i64, $text_keys, ages, text("ad")) == false)
    map_put($Text, $i64, $text_keys, ages, text("ada"), 37)
    assert(map_len($Text, $i64, ages) == 2)
    assert(map_get($Text, $i64, $text_keys, ages, text("ada"), 0) == 37)
    map_free($Text, $i64, ages)
}

test "a string key survives the table growing" {
    mut seen := map_new($Text, $i64, 8)
    map_put($Text, $i64, $text_keys, seen, text("alpha"), 1)
    map_put($Text, $i64, $text_keys, seen, text("beta"), 2)
    map_put($Text, $i64, $text_keys, seen, text("gamma"), 3)
    map_put($Text, $i64, $text_keys, seen, text("delta"), 4)
    map_put($Text, $i64, $text_keys, seen, text("epsilon"), 5)
    map_put($Text, $i64, $text_keys, seen, text("zeta"), 6)
    assert(map_len($Text, $i64, seen) == 6)
    assert(map_get($Text, $i64, $text_keys, seen, text("alpha"), 0) == 1)
    assert(map_get($Text, $i64, $text_keys, seen, text("zeta"), 0) == 6)
    assert(map_remove($Text, $i64, $text_keys, seen, text("gamma")))
    assert(map_has($Text, $i64, $text_keys, seen, text("gamma")) == false)
    assert(map_get($Text, $i64, $text_keys, seen, text("delta"), 0) == 4)
    map_free($Text, $i64, seen)
}

test "a struct is a key when it says how it hashes" {
    mut grid := map_new($Cell, $i64, 8)
    map_put($Cell, $i64, $cell_keys, grid, Cell { x = 1, y = 2 }, 12)
    map_put($Cell, $i64, $cell_keys, grid, Cell { x = 3, y = 4 }, 34)
    assert(map_get($Cell, $i64, $cell_keys, grid, Cell { x = 1, y = 2 }, 0)
        == 12)
    assert(map_get($Cell, $i64, $cell_keys, grid, Cell { x = 3, y = 4 }, 0)
        == 34)
    assert(map_get($Cell, $i64, $cell_keys, grid, Cell { x = 9, y = 9 }, 0)
        == 0)
    map_free($Cell, $i64, grid)
}

test "a map holds a struct value" {
    mut places := map_new($i64, $Cell, 8)
    map_put($i64, $Cell, $i64_keys, places, 1, Cell { x = 5, y = 6 })
    held := map_get($i64, $Cell, $i64_keys, places, 1, Cell { x = 0, y = 0 })
    assert(held.x == 5)
    assert(held.y == 6)
    map_free($i64, $Cell, places)
}

test "a map gives back every block it took, however far it grew" {
    before := heap_live()
    mut m := map_new($i64, $i64, 8)
    mut i : i64 = 0
    while (i < 500) {
        map_put($i64, $i64, $i64_keys, m, i, i)
        i = i + 1
    }
    map_free($i64, $i64, m)
    assert(heap_live() == before)
}

test "a map of text gives back every block it took" {
    before := heap_live()
    mut m := map_new($Text, $i64, 8)
    map_put($Text, $i64, $text_keys, m, text("one"), 1)
    map_put($Text, $i64, $text_keys, m, text("two"), 2)
    map_free($Text, $i64, m)
    assert(heap_live() == before)
}

test "clearing a map keeps its storage and forgets its keys" {
    mut m := map_new($i64, $i64, 8)
    map_put($i64, $i64, $i64_keys, m, 1, 10)
    map_put($i64, $i64, $i64_keys, m, 2, 20)
    settled := heap_live()
    map_clear($i64, $i64, m)
    assert(map_len($i64, $i64, m) == 0)
    assert(map_has($i64, $i64, $i64_keys, m, 1) == false)
    map_put($i64, $i64, $i64_keys, m, 3, 30)
    assert(map_get($i64, $i64, $i64_keys, m, 3, 0) == 30)
    assert(heap_live() == settled)
    map_free($i64, $i64, m)
}

test "a tombstone is stepped over rather than stopped at" {
    mut m := map_new($i64, $i64, 8)
    mut i : i64 = 0
    while (i < 6) {
        map_put($i64, $i64, $i64_keys, m, i * 8, i)
        i = i + 1
    }
    // Every key lands on the same slot before probing, so removing the first
    // one leaves a tombstone the rest are found through.
    assert(map_remove($i64, $i64, $i64_keys, m, 0))
    mut k : i64 = 1
    while (k < 6) {
        assert(map_get($i64, $i64, $i64_keys, m, k * 8, 0 - 1) == k)
        k = k + 1
    }
    map_free($i64, $i64, m)
}
