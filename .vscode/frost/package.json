{
  "name": "frost",
  "displayName": "Frost",
  "description": "Syntax highlighting and navigation for the Frost language",
  "version": "0.2.0",
  "publisher": "frost-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:frost"
  ],
  "contributes": {
    "languages": [
      {
        "id": "frost",
        "aliases": [
          "Frost",
          "frost"
        ],
        "extensions": [
          ".frost"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "frost",
        "scopeName": "source.frost",
        "path": "./syntaxes/frost.tmLanguage.json"
      },
      {
        "scopeName": "markdown.frost.codeblock",
        "path": "./syntaxes/frost.markdown.tmLanguage.json",
        "injectTo": ["text.html.markdown"],
        "embeddedLanguages": {
          "meta.embedded.block.frost": "frost"
        }
      }
    ],
    "snippets": [
      {
        "language": "frost",
        "path": "./snippets/frost.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "frost.json",
        "url": "./schemas/frost.schema.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "frost",
        "owner": "frost",
        "source": "frost",
        "fileLocation": ["relative", "${fileDirname}"],
        "severity": "error",
        "pattern": {
          "regexp": "^\\s*(?:(warning|error):\\s*)?(?:\\d+:\\s*)?at (.+?):(\\d+):(\\d+): (.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ]
  }
}
