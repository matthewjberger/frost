{
  "name": "frost",
  "displayName": "Frost",
  "description": "The Frost language, served by the Frost compiler",
  "version": "1.0.0",
  "publisher": "frost-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:frost"
  ],
  "contributes": {
    "languages": [
      {
        "id": "frost",
        "aliases": [
          "Frost",
          "frost"
        ],
        "extensions": [
          ".frost"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "frost",
        "scopeName": "source.frost",
        "path": "./syntaxes/frost.tmLanguage.json"
      },
      {
        "scopeName": "markdown.frost.codeblock",
        "path": "./syntaxes/frost.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.frost": "frost"
        }
      }
    ],
    "snippets": [
      {
        "language": "frost",
        "path": "./snippets/frost.json"
      }
    ],
    "commands": [
      {
        "command": "frost.applyEveryFix",
        "title": "Frost: Apply every fix the reports offer",
        "enablement": "editorLangId == frost"
      },
      {
        "command": "frost.restartServer",
        "title": "Frost: Restart the language server"
      }
    ],
    "configuration": {
      "title": "Frost",
      "properties": {
        "frost.compilerPath": {
          "type": "string",
          "default": "frostc",
          "description": "The self-hosted Frost compiler, which is what `just install-self` puts on PATH as `frostc`. The extension starts it once as `frostc lsp` and asks it everything: the reports, the places, the names and the layout. A bare name is looked up on PATH."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "frost.json",
        "url": "./schemas/frost.schema.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "frost",
        "owner": "frost",
        "source": "frost",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(\\S.*?):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          },
          {
            "regexp": "^.*$"
          },
          {
            "regexp": "^\\s*\\^+ (?:(warning): )?(.*)$",
            "severity": 1,
            "message": 2
          }
        ]
      }
    ]
  }
}
