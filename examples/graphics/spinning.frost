// A field of lit primitives, each turning about its own axis.
//
//   just spinning
//
// W/A/S/D move, Q and E drop and rise, the arrow keys look, escape closes it.
//
// This is the first scene with surfaces rather than flat triangles, and what
// makes it one is the normal: a vertex says which way the surface faces there,
// a light says which way it comes from, and the two together are what makes a
// sphere look round and a cube look like it has six sides. Nothing about it is
// a texture; the geometry and one directional light are the whole of it.
//
// The shape follows the engine's. Geometry lives in a cache and a thing that is
// drawn names it. A material is an entry in a registry and a thing that is
// drawn carries the number, so thirty-six of them share four looks without
// anything walking the scene to change one. The world holds where each is and
// how it turns, read once a frame before any pass records.
//
// Two bindings rather than one, split by how often they change: the camera and
// the light are written once a frame, and each thing's own model matrix and
// material are written per thing. That is the split every renderer ends up
// making and it is worth making early, because it is the one a pass is
// organized around.
//
// The window, the device, the world, the schedule and the four tables are an
// `App`, so `main` opens one and `run` says what this demo draws. What is left
// in here is the shader, the pipeline, the two passes and the scene put in the
// world, which is the whole of what makes this demo rather than the next one.

import "../../lib/engine/camera.frost"
import "../../lib/renderer/renderer.frost"
import "../../lib/renderer/frame.frost"
import "../../lib/renderer/graph.frost"
import "../../lib/renderer/render_world.frost"
import "../../lib/renderer/uniform.frost"
import "../../lib/engine/scene_sync.frost"
import "../../lib/engine/world.frost"
import "spin.frost"
import "../../lib/engine/app.frost"
import "../../lib/renderer/geometry.frost"
import "../../lib/renderer/mesh.frost"
import "../../lib/renderer/material.frost"
import "../../lib/renderer/wgpu.frost"
import "ecs.frost"
import "math.frost"
import "io.frost"

WIDTH :: 1280
HEIGHT :: 720

GRID :: 6
INSTANCES :: 36

// How much geometry the shared buffers hold. A cube is twenty-four vertices and
// a sphere of these divisions is far more, so this is the two of them with room
// to spare rather than a number worked out from the shapes.
VERTEX_ROOM :: 4096
INDEX_ROOM :: 8192

// The camera and the light, written once a frame: a matrix, then four vectors.
FRAME_FLOATS :: 32
FRAME_BYTES :: 128

// What one thing's own uniform holds is `scene_sync`'s, since that is what
// fills it, and `OBJECT_BYTES` arrives from there.

// What a pass records with. What to draw comes out of the world every frame
// and the pass walks the run, so nothing here counts anything.
Scene :: struct {
    pipeline: RenderPipeline,
    steps: BatchPipelines,
    frame_group: BindGroup,
    render: ^RenderWorld,
    store: ^Geometry,
    frame_uniform: Buffer,
}

SHADER :: "
struct Frame {
    view_projection: mat4x4<f32>,
    camera_position: vec4<f32>,
    light_direction: vec4<f32>,
    light_color: vec4<f32>,
    ambient: vec4<f32>,
}

struct ObjectData {
    transform_index: u32,
    mesh_id: u32,
    material_id: u32,
    batch_id: u32,
    pipeline_class: u32,
    visible: u32,
    is_overlay: u32,
    pad_zero: u32,
}

struct MaterialData {
    base_color: vec4<f32>,
    roughness: f32,
    metallic: f32,
    alpha_cutoff: f32,
    flags: u32,
}

@group(0) @binding(0) var<uniform> frame: Frame;
// Every thing to draw, and which of them survived culling. Nothing is bound per
// object: the draw says how many instances it covers and each one finds itself.
@group(1) @binding(0) var<storage, read> objects: array<ObjectData>;
@group(1) @binding(1) var<storage, read> visible: array<u32>;
// Where each thing ended up and what it is made of, as tables an object names a
// row of. Two hundred things sharing a look share one row of the second.
@group(1) @binding(2) var<storage, read> transforms: array<mat4x4<f32>>;
@group(1) @binding(3) var<storage, read> materials: array<MaterialData>;

struct VertexOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) world: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) @interpolate(flat) object_index: u32,
}

@vertex
fn vs_main(@location(0) position: vec3<f32>,
           @location(1) normal: vec3<f32>,
           @builtin(instance_index) instance: u32) -> VertexOut {
    var out: VertexOut;
    // The draw's first instance is where this mesh's slice of the visible list
    // begins, and `instance_index` counts from there, so this one expression
    // covers every batch.
    let object_index = visible[instance];
    let object = objects[object_index];
    let model = transforms[object.transform_index];
    let world = model * vec4<f32>(position, 1.0);
    out.clip = frame.view_projection * world;
    out.world = world.xyz;
    out.normal = (model * vec4<f32>(normal, 0.0)).xyz;
    out.object_index = object_index;
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    let object = objects[in.object_index];
    let material = materials[object.material_id];
    let facing = normalize(in.normal);
    let toward_light = normalize(-frame.light_direction.xyz);
    let toward_eye = normalize(frame.camera_position.xyz - in.world);
    let halfway = normalize(toward_light + toward_eye);

    let lambert = max(dot(facing, toward_light), 0.0);
    let rough = clamp(material.roughness, 0.05, 1.0);
    let tightness = 2.0 / (rough * rough) - 2.0;
    let highlight = pow(max(dot(facing, halfway), 0.0), tightness)
        * (1.0 - rough) * lambert * 0.3;

    let strength = frame.light_color.w;
    let lit = material.base_color.rgb
        * (frame.ambient.rgb + frame.light_color.rgb * strength * lambert)
        + frame.light_color.rgb * strength * highlight;
    return vec4<f32>(lit, material.base_color.a);
}
"

// The whole of what a frame draws, as one node: the steps that decide what is
// drawn, then the draw itself. Nothing in it counts anything, and how many
// instances each draw covers is a number the steps above it wrote into the
// buffer the draw reads its arguments from.
//
// One node rather than a compute chain wired to a render pass, because the
// order is not something a program should have to state. Recording into one
// encoder is what puts the steps before the draw that reads what they wrote.
draw_scene :: fn(mut s: Scene, context: NodeContext) {
    held := render_world_at(s.render)
    batching_record(s.steps, held, context.encoder)
    pass := encoder_pass_into(context.encoder, context.into,
        context.color_load, context.clear, context.depth_load)
    render_pass_encoder_set_pipeline(pass, s.pipeline)
    render_pass_encoder_set_bind_group(pass, 0, s.frame_group, 0,
        no_pointer())
    render_pass_encoder_set_bind_group(pass, 1,
        render_world_group(held), 0, no_pointer())
    geometry_bind(pass, geometry_at(s.store))
    render_world_draw_all(pass, held)
    render_pass_encoder_end(pass)
    render_pass_encoder_release(pass)
}

// The camera and the light, as the bytes the shader reads them as.
write_frame :: fn(queue: Queue, uniform: Buffer, eye: Camera, w: i64, h: i64) {
    var values: [FRAME_FLOATS]f32 = [0.0; FRAME_FLOATS]
    var view_projection := camera_view_projection(eye, w, h)
    var element: i64 = 0
    while (element < 16) {
        values[element] = view_projection.m[element]
        element = element + 1
    }
    at := camera_position(eye)
    values[16] = at.x
    values[17] = at.y
    values[18] = at.z
    values[19] = 1.0
    values[20] = -0.4
    values[21] = -1.0
    values[22] = -0.5
    values[23] = 0.0
    values[24] = 1.0
    values[25] = 0.97
    values[26] = 0.9
    values[27] = 2.5
    values[28] = 0.12
    values[29] = 0.14
    values[30] = 0.18
    values[31] = 1.0
    queue_write_buffer(queue, uniform, 0,
        ptr_to(values[0]), FRAME_BYTES)
}

make_pipeline :: fn(device: Device, format: u32,
    layout: PipelineLayout) -> RenderPipeline {
    var wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    var module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    shader := device_create_shader_module(device, ptr_to(module_descriptor))

    var attributes: [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    var buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])

    var target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask :: All

    var fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    var depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_GREATER

    var descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    // Backs are thrown away, which is what the winding is for and what makes a
    // closed shape cost half of what it looks like it costs.
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

// One pass, and the two targets it writes. The graph makes the depth buffer,
// sizes it with the window and decides both load ops, so a pass says what it
// draws into and nothing about how.
//
// One node, and what runs inside it is the node's business. The steps that
// decide what is drawn write the buffer the draw reads, and both are recorded
// into the same encoder, so the graph is not asked to order them.
declare_passes :: fn(mut s: Scene, mut g: Graph, device: Device, format: u32) {
    screen := graph_backbuffer(g)
    depth := graph_depth(g, "depth", WINDOW_SIZED, WINDOW_SIZED, DEPTH_FORMAT)
    scene_pass := graph_node_pass($Scene, g, "scene", draw_scene, ptr_to(s))
    graph_writes_color(g, scene_pass, screen,
        Color { r = 0.04, g = 0.05, b = 0.07, a = 1.0 })
    graph_writes_depth(g, scene_pass, depth)
}

// What a frame does between the world and the graph. A system cannot reach a
// device, so writing the frame's uniform and filling the run are this instead.
before_frame :: fn(mut s: Scene, mut app: App) {
    write_frame(app_queue(app), s.frame_uniform, app_camera(app),
        app_width(app), app_height(app))
    ids := app_ids(app)
    app_extract(app, all_drawn(ids.global_transform, ids.transform, ids.drawn),
        app_view(app))
}

main :: fn() -> i64 {
    var config := app_config("Frost spinning primitives", WIDTH, HEIGHT)
    config.vertices = VERTEX_ROOM
    config.indices = INDEX_ROOM
    config.drawn = INSTANCES * 2
    match app_open(config) {
        case.Ok { value }: run(value)
        case.Err { error }: app_failed(error)
    }
}

// What this demo has to say, handed a window and a device that opened. The
// scene, the pipeline and the passes are all that is left once the App holds
// the rest.
run :: fn(move app: App) -> i64 {
    app_install_group(app, default_plugins())
    app_install(app, camera_controller_plugin)
    app_install(app, exit_on_escape_plugin)
    app_install(app, spin_plugin)
    // Turning is this program's, so which component it is is asked of the
    // world here rather than read off the engine's list.
    spin := component_of($Spin, app.world)
    device := app_device(app)
    queue := app_queue(app)

    // Every shape in one pair of buffers, because a draw whose arguments come
    // off the GPU cannot ask the CPU to bind the next mesh first.
    mesh_cache_insert(app.meshes, app.store, device, queue, "cube",
        cube_mesh())
    mesh_cache_insert(app.meshes, app.store, device, queue, "sphere",
        sphere_mesh(0.6, 16, 24))
    cube := mesh_cache_find(app.meshes, "cube")
    sphere := mesh_cache_find(app.meshes, "sphere")

    var looks: [4]i64 = [0; 4]
    looks[0] = materials_add(app.materials, material_of(vec4(0.85, 0.3, 0.28, 1.0), 0.35, 0.0))
    looks[1] = materials_add(app.materials, material_of(vec4(0.3, 0.75, 0.45, 1.0), 0.6, 0.0))
    looks[2] = materials_add(app.materials, material_of(vec4(0.35, 0.5, 0.9, 1.0), 0.2, 0.0))
    looks[3] = materials_add(app.materials, material_of(vec4(0.9, 0.75, 0.3, 1.0), 0.45, 0.0))

    frame_layout := uniform_layout(device, FRAME_BYTES,
        ShaderStage :: Vertex | ShaderStage :: Fragment)
    // The second group is the renderer's own: every object and the visible
    // list, bound once rather than one binding per thing.
    var layouts: [2]BindGroupLayout = [frame_layout,
        render_world_layout(app.render)]
    var pipeline_layout_descriptor := pipeline_layout_descriptor_init()
    pipeline_layout_descriptor.bind_group_layouts_count = 2
    pipeline_layout_descriptor.bind_group_layouts =
    ptr_to(layouts[0])
    pipeline_layout := device_create_pipeline_layout(device,
        ptr_to(pipeline_layout_descriptor))

    frame_uniform := uniform_buffer(device, FRAME_BYTES)
    frame_group := uniform_group(device, frame_layout, frame_uniform,
        FRAME_BYTES)

    ids := app_ids(app)
    wanted := mask_with(mask_with(mask_with(mask_with(mask_with(
                        mask_empty(),
                        ids.local_transform), spin), ids.drawn),
            ids.global_transform), ids.transform)

    half: f32 = 2.5
    var made: i64 = 0
    while (made < INSTANCES) {
        row := made / GRID
        column := made - row * GRID
        across: f32 = column
        up: f32 = row
        entity := ecs_spawn_with(app.world, wanted)
        ecs_set($LocalTransform, app.world, entity,
            ids.local_transform, LocalTransform {
                translation = vec3((across - half) * 1.8, (up - half) * 1.8, 0.0),
                rotation = quat_identity(), scale = vec3(1.0, 1.0, 1.0) })

        // An axis that differs from one to the next, so the field does not read
        // as one object drawn thirty-six times.
        turning := vec3_normalize(vec3(0.3 + row, 1.0, 0.2 + column))
        speed: f32 = 0.4 + 0.09 * made
        ecs_set($Spin, app.world, entity, spin,
            spinning(turning, speed, quat_identity()))

        var shape := cube
        if (made - (made / 2) * 2 == 1) {
            shape = sphere
        }
        ecs_set($Drawn, app.world, entity, ids.drawn, Drawn { mesh = shape,
                material = looks[made - (made / 4) * 4], layer = ONE_LAYER })

        made = made + 1
    }

    var scene := Scene {
        pipeline = make_pipeline(device, app_format(app), pipeline_layout),
        steps = render_world_batch_pipelines(device,
            render_world_batch_layout(app.render)),
        frame_group = frame_group,
        render = ptr_to(app.render),
        store = ptr_to(app.store),
        frame_uniform = frame_uniform,
    }
    var eye := camera_default()
    eye.position = vec3(0.0, 0.0, 14.0)
    eye.pitch = 0.0
    app_camera_set(app, eye)

    app_configure_graph($Scene, app, declare_passes, ptr_to(scene))
    app_before_render($Scene, app, before_frame, ptr_to(scene))
    app_run(app)
    app_close(app)
}
