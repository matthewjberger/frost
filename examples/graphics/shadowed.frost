// A lit scene where one pass writes a depth map and the next reads it.
//
//   just shadowed
//
// W/A/S/D move, Q and E drop and rise, the arrow keys look, escape closes it.
// Hold B and the second view goes: a system writes a resource, a hook reads it
// and turns two passes off, and nothing is scheduled again.
//
// This is the demo the render graph exists for. Eight passes, one of them a
// graph of its own, and a chain of
// resources between them: a compute pass works out a glow per thing that is
// drawn; the shadow pass draws the scene from where the light is and keeps only
// depth; the scene pass samples that depth to ask, for every point it lights,
// whether the light can see it, reads the glow, and draws into a target rather
// than at the window; two steps pull the bright parts out and spread them; and
// a last pass adds the two together onto the window.
//
// The second view in the corner is a sub-graph: its own target, its own depth
// and its own scene pass, run by a pass here that declares what it writes, so
// where the nested work falls in the order is decided the same way everything
// else is.
//
// What the world does each frame is a schedule of three systems rather than one
// loop: turning, then where everything ended up, then the buffers. A system is
// a `fn(mut World)` and captures nothing, so what it works on is components and
// two resources, and the shapes hang off a root in a hierarchy the world holds,
// which is why each one both spins and orbits without either saying anything
// about the other.
//
// The compute pass is written last of the six drawing passes and runs first. Nothing between
// it and the scene is an attachment: it writes a run of bytes and the scene
// reads them, and a buffer written by one pass and read by another is an
// ordering like any other.
//
// Nothing here says what runs when. Each pass declares what it reads and what
// it writes, and the order falls out: `graph_schedule` puts every writer before
// its reader, refuses a graph where two wait on each other, and refuses a read
// of a resource nothing writes. Every load op comes from the same declarations.
//
// The three targets in the middle are transient, which is the graph's word for
// written and consumed inside one frame. The graph works out when each is first
// and last touched and hands two of them the same texture wherever their
// lifetimes leave room, so the chain does not cost one full-size target per
// step. The two bloom steps are declared at `HALF`, a negative size meaning a
// share of the window rather than a count of texels.
//
// Three things are worth pointing at, because each is easy to get wrong and
// none of them looks like a bug in the code:
//
// A target sized by the window is thrown away and made again on a resize, so a
// binding naming its view would be left pointing at a texture that no longer
// exists. A pass that reads one says how it rebuilds, and the graph calls that
// after a resize; a pass that reads one and says nothing is refused.
//
// The shadow map is 1024 by 1024 and does not follow the window, because what
// it covers is a piece of the world rather than a piece of the screen.
//
// Depth in WebGPU runs from zero at the near plane to one at the far plane, not
// from minus one, which is why the light's projection is `mat4_ortho_zo`. The
// other one puts half the scene behind the near plane, and every fragment there
// reads as lit.
//
// The window, the device, the world, the schedule and the four tables are an
// `App`, and one of those tables is the run the camera's view draws from. The
// light's and the inset's are this demo's own, made and freed here, because
// three views is what this demo is about.

import "../../lib/platform/platform.frost"
import "../../lib/engine/camera.frost"
import "../../lib/renderer/renderer.frost"
import "../../lib/renderer/frame.frost"
import "../../lib/renderer/graph.frost"
import "../../lib/renderer/geometry.frost"
import "../../lib/renderer/mesh.frost"
import "../../lib/renderer/material.frost"
import "../../lib/renderer/render_world.frost"
import "../../lib/renderer/uniform.frost"
import "../../lib/engine/scene_sync.frost"
import "../../lib/engine/world.frost"
import "../../lib/engine/app.frost"
import "../../lib/renderer/wgpu.frost"
import "ecs.frost"
import "math.frost"
import "mem.frost"
import "io.frost"

WIDTH :: 1280
HEIGHT :: 720

// The post-process chain runs at a share of the window rather than at all of
// it, which is what a negative size means to the graph: -2 is half.
HALF :: -2

// How wide the shadow map is. Fixed rather than window-sized: what it covers is
// a piece of the world, which the window has nothing to do with.
SHADOW_SIZE :: 1024

// A grid of shapes over a floor, and the floor is one of them.
GRID :: 3
SHAPES :: 9
INSTANCES :: 10

// Where the floor sits and how thick it is. The cube it is made of runs from
// -0.5 to 0.5, so its top surface is half its thickness above its middle, and
// that is the height everything else is placed against.
FLOOR_Y :: -2.25
FLOOR_THICKNESS :: 0.25
FLOOR_TOP :: -2.125

// How far the lowest shape's middle sits above that surface. A cube of this
// size reaches 0.866 from its middle at the corner and turns about an axis of
// its own, so anything less than that puts a corner through the floor for part
// of every turn; a sphere of radius 0.7 reaches less. The rest is air, so the
// gap reads as a gap and the shadow under it reads as a shadow.
LOWEST_CLEARANCE :: 1.125

ROW_RISE :: 2.25
ROW_DEPTH :: 1.5
COLUMN_SPACING :: 3.25

// The inset view in the corner, and how big it is. A fixed size rather than a
// share of the window: it is a picture of the scene from somewhere else, and
// what it is worth showing does not change with how big the window got.
INSET_WIDTH :: 384
INSET_HEIGHT :: 216
INSET_MARGIN :: 24

// How many things may be drawn at once. The slot table, the draw list and the
// run of glow values are all this long, because the scene shader reads the run
// at the slot a thing was given: three numbers that have to agree, so they are
// one number.
MAX_DRAWN :: 40
GLOW_BYTES :: 160

// How much geometry the shared buffers hold, which is a cube and a sphere with
// room to spare.
VERTEX_ROOM :: 4096
INDEX_ROOM :: 8192

// The camera, the light, and the matrix the light sees the world through.
FRAME_FLOATS :: 48
FRAME_BYTES :: 192

// What one thing's own uniform holds is `scene_sync`'s, since that is what
// fills it, and `OBJECT_BYTES` arrives from there.

// What a pass records with. The shadow pass reads the first three fields and
// the scene pass reads all of them, which is why one struct serves both: the
// two are the same walk over the same slots with a different pipeline.
Scene :: struct {
    pipeline: RenderPipeline,
    frame_group: BindGroup,
    // What to draw, filled from the world once a frame. All three passes that
    // draw the scene point at the one run rather than each holding a copy: it
    // is written after the schedule and read by every one of them.
    render: ^RenderWorld,
    store: ^Geometry,
    shadow_group: BindGroup,
    glow_group: BindGroup,
    samples_shadow: i64,
    // Which resources the two bindings above name, so one hook can build
    // them again when the graph says a texture moved.
    shadow_map: ResourceId,
    glow: ResourceId,
}

// What decides which of them are drawn. Its own state, since the three drawing
// passes share one run and the culling that fills it happens once.
Culling :: struct {
    pipeline: ComputePipeline,
    render: ^RenderWorld,
}

SHADER :: "
struct Frame {
    view_projection: mat4x4<f32>,
    light_view_projection: mat4x4<f32>,
    camera_position: vec4<f32>,
    light_direction: vec4<f32>,
    light_color: vec4<f32>,
    ambient: vec4<f32>,
}

struct ObjectData {
    model: mat4x4<f32>,
    base_color: vec4<f32>,
    surface: vec4<f32>,
    batch: u32,
    radius: f32,
    material: u32,
    pad_three: u32,
}

@group(0) @binding(0) var<uniform> frame: Frame;
@group(1) @binding(0) var<storage, read> objects: array<ObjectData>;
@group(1) @binding(1) var<storage, read> visible: array<u32>;
@group(2) @binding(0) var shadow_map: texture_depth_2d;
@group(2) @binding(1) var shadow_reader: sampler_comparison;
// What the compute pass left, one value per thing drawn, read at the object's
// own index. Every thing already knows that number, since it is how it found
// itself in the run.
@group(3) @binding(0) var<storage, read> glow: array<f32>;

// The shadow pass. No colour attachment and no fragment stage: what it writes
// is depth, and depth is written whether or not anything shades.
@vertex
fn vs_shadow(@location(0) position: vec3<f32>,
             @builtin(instance_index) instance: u32)
    -> @builtin(position) vec4<f32> {
    let object = objects[visible[instance]];
    return frame.light_view_projection * object.model * vec4<f32>(position, 1.0);
}

struct VertexOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) world: vec3<f32>,
    @location(1) normal: vec3<f32>,
    @location(2) light_clip: vec4<f32>,
    @location(3) @interpolate(flat) object_index: u32,
}

@vertex
fn vs_main(@location(0) position: vec3<f32>,
           @location(1) normal: vec3<f32>,
           @builtin(instance_index) instance: u32) -> VertexOut {
    var out: VertexOut;
    let object_index = visible[instance];
    let object = objects[object_index];
    let world = object.model * vec4<f32>(position, 1.0);
    out.clip = frame.view_projection * world;
    out.world = world.xyz;
    out.normal = (object.model * vec4<f32>(normal, 0.0)).xyz;
    out.light_clip = frame.light_view_projection * world;
    out.object_index = object_index;
    return out;
}

// How much of the light reaches this point: one where all of it does, zero
// where none of it does, and the fractions between from reading nine texels
// around the one it lands on. `textureSampleCompareLevel` rather than
// `textureSampleCompare` because this is called under an `if`, and the plain
// one wants the whole workgroup to agree that it was.
fn light_reaching(light_clip: vec4<f32>) -> f32 {
    let ndc = light_clip.xyz / light_clip.w;
    // The map covers a piece of the world. Outside it there is nothing to say
    // a point is in shadow, so it is lit.
    if (ndc.z > 1.0 || ndc.z < 0.0
        || abs(ndc.x) > 1.0 || abs(ndc.y) > 1.0) {
        return 1.0;
    }
    // Clip space runs left to right and bottom to top; a texture reads top to
    // bottom, so the vertical coordinate turns over here.
    let uv = vec2<f32>(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);
    // How far one texel is, asked of the map rather than written down. A
    // number here would be a second place the map's size is decided, and the
    // two would drift.
    let texel = 1.0 / vec2<f32>(textureDimensions(shadow_map));
    var reaching = 0.0;
    for (var y = -1; y <= 1; y = y + 1) {
        for (var x = -1; x <= 1; x = x + 1) {
            let at = uv + vec2<f32>(f32(x), f32(y)) * texel;
            reaching = reaching
                + textureSampleCompareLevel(shadow_map, shadow_reader, at,
                    ndc.z);
        }
    }
    return reaching / 9.0;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    let object = objects[in.object_index];
    let facing = normalize(in.normal);
    let toward_light = normalize(-frame.light_direction.xyz);
    let toward_eye = normalize(frame.camera_position.xyz - in.world);
    let halfway = normalize(toward_light + toward_eye);

    let lambert = max(dot(facing, toward_light), 0.0);
    let rough = clamp(object.surface.x, 0.05, 1.0);
    let tightness = 2.0 / (rough * rough) - 2.0;
    let highlight = pow(max(dot(facing, halfway), 0.0), tightness)
        * (1.0 - rough) * lambert * 0.3;

    // A surface facing away from the light is dark whatever the map says, so
    // the two are multiplied rather than one of them deciding.
    let reaching = light_reaching(in.light_clip);
    let strength = frame.light_color.w * reaching;
    let lit = object.base_color.rgb
        * (frame.ambient.rgb + frame.light_color.rgb * strength * lambert)
        + frame.light_color.rgb * strength * highlight;
    // A glow of its own, from the run the compute pass wrote. It is added
    // rather than lit, so it reaches past one and is what the bloom below
    // picks up.
    // The object's own index, which is what the compute pass indexed the run
    // by. Bounded, because the run is as long as the world has room for and a
    // frame may hold fewer.
    let which = in.object_index;
    var pulse = 0.0;
    if (which < arrayLength(&glow)) {
        pulse = glow[which];
    }
    return vec4<f32>(lit + object.base_color.rgb * pulse * 0.9,
        object.base_color.a);
}
"

// One value per thing that is drawn, worked out on the device rather than on
// the way there. Nothing about a pulse needs the CPU: it is a function of the
// frame's time and the index, so it is written where it is read.
//
// This is what a buffer resource is for. The compute pass writes the run and
// the scene pass reads it, and that is the whole of what puts the compute
// first: no attachment between them, no order written down anywhere.
PULSE_SHADER :: "
struct Frame {
    view_projection: mat4x4<f32>,
    light_view_projection: mat4x4<f32>,
    camera_position: vec4<f32>,
    light_direction: vec4<f32>,
    light_color: vec4<f32>,
    ambient: vec4<f32>,
}

@group(0) @binding(0) var<uniform> frame: Frame;
@group(1) @binding(0) var<storage, read_write> glow: array<f32>;

@compute @workgroup_size(64)
fn cs_pulse(@builtin(global_invocation_id) id: vec3<u32>) {
    let index = id.x;
    if (index >= arrayLength(&glow)) {
        return;
    }
    // The seconds since the program started, carried in the one component of
    // the frame's ambient colour that nothing else reads.
    let seconds = frame.ambient.w;
    glow[index] = 0.5 + 0.5 * sin(seconds * 1.7 + f32(index) * 0.9);
}
"

// A triangle that covers the screen, built from the vertex index with no
// vertex buffer at all, and the two steps of a bloom over what the scene left.
//
// The chain is what the graph's transients are for: `bright` and `blurred` are
// written and consumed inside one frame, so the graph hands them one texture
// between them when their lifetimes allow, and both run at half the window.
POST_SHADER :: "
struct Coverage {
    @builtin(position) clip: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_cover(@builtin(vertex_index) index: u32) -> Coverage {
    var out: Coverage;
    let x = f32((index & 1u) << 1u);
    let y = f32(index & 2u);
    out.clip = vec4<f32>(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);
    out.uv = vec2<f32>(x, 1.0 - y);
    return out;
}

@group(0) @binding(0) var source: texture_2d<f32>;
@group(0) @binding(1) var reader: sampler;

// What is brighter than the scene's own range, which is what blooms.
@fragment
fn fs_bright(in: Coverage) -> @location(0) vec4<f32> {
    let held = textureSample(source, reader, in.uv).rgb;
    let strength = max(dot(held, vec3<f32>(0.2126, 0.7152, 0.0722)) - 1.0, 0.0);
    return vec4<f32>(held * strength, 1.0);
}

// The texture as it is, for putting one picture inside another.
@fragment
fn fs_blit(in: Coverage) -> @location(0) vec4<f32> {
    return textureSample(source, reader, in.uv);
}

// Nine taps across the texel grid, which at half resolution is a wide enough
// spread to read as a glow without a second pass in the other direction.
@fragment
fn fs_blur(in: Coverage) -> @location(0) vec4<f32> {
    let texel = 1.0 / vec2<f32>(textureDimensions(source));
    var total = vec3<f32>(0.0, 0.0, 0.0);
    for (var y = -1; y <= 1; y = y + 1) {
        for (var x = -1; x <= 1; x = x + 1) {
            let at = in.uv + vec2<f32>(f32(x), f32(y)) * texel * 2.0;
            total = total + textureSample(source, reader, at).rgb;
        }
    }
    return vec4<f32>(total / 9.0, 1.0);
}
"

// The scene and the glow added over it. A second group, because this one reads
// two textures rather than one.
COMPOSE_SHADER :: "
struct Coverage {
    @builtin(position) clip: vec4<f32>,
    @location(0) uv: vec2<f32>,
}

@vertex
fn vs_cover(@builtin(vertex_index) index: u32) -> Coverage {
    var out: Coverage;
    let x = f32((index & 1u) << 1u);
    let y = f32(index & 2u);
    out.clip = vec4<f32>(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);
    out.uv = vec2<f32>(x, 1.0 - y);
    return out;
}

@group(0) @binding(0) var scene: texture_2d<f32>;
@group(0) @binding(1) var scene_reader: sampler;
@group(1) @binding(0) var glow: texture_2d<f32>;
@group(1) @binding(1) var glow_reader: sampler;

@fragment
fn fs_compose(in: Coverage) -> @location(0) vec4<f32> {
    let lit = textureSample(scene, scene_reader, in.uv).rgb;
    let added = textureSample(glow, glow_reader, in.uv).rgb;
    return vec4<f32>(lit + added, 1.0);
}
"

// One walk over the slots. Which pipeline it sets and whether it binds the
// shadow map is the state's, so the two passes are this function twice with
// different state, and neither of them says what it draws into.
draw_things :: fn(mut s: Scene, pass: RenderPassEncoder) {
    render_pass_encoder_set_pipeline(pass, s.pipeline)
    render_pass_encoder_set_bind_group(pass, 0, s.frame_group, 0,
        no_pointer())
    if (s.samples_shadow == 1) {
        render_pass_encoder_set_bind_group(pass, 2,
            s.shadow_group, 0, no_pointer())
        render_pass_encoder_set_bind_group(pass, 3,
            s.glow_group, 0, no_pointer())
    }

    // What to draw came out of the world this frame, and which of it survived
    // came off the GPU. The pass binds the run once and issues one indirect
    // draw per batch, counting nothing.
    render_pass_encoder_set_bind_group(pass, 1,
        render_world_group(render_world_at(s.render)), 0, no_pointer())
    geometry_bind(pass, geometry_at(s.store))
    render_world_draw(pass, render_world_at(s.render))
}

// The pass that decides what is drawn, once for all three that draw it.
cull_things :: fn(mut s: Culling, pass: ComputePassEncoder) {
    held := render_world_at(s.render)
    compute_pass_encoder_set_pipeline(pass, s.pipeline)
    compute_pass_encoder_set_bind_group(pass, 0, render_world_cull_group(held),
        0, no_pointer())
    compute_pass_encoder_dispatch_workgroups(pass,
        render_world_dispatch(held), 1, 1)
}

// What a frame does between the world and the graph. The same world three
// times, each culled by the view that draws it: culling is a question about a
// view, and this one is drawn from the camera, from the light, and from the
// second camera in the corner. The walk is the same each time and only the
// frustum differs, which is what the three uploads are.
before_frame :: fn(mut s: Built, mut app: App) {
    queue := app_queue(app)
    light := s.light
    s.elapsed = s.elapsed + input_delta_seconds(app_input(app))
    elapsed := s.elapsed
    write_frame(queue, s.frame_uniform, app_camera(app), light,
        elapsed, app_width(app), app_height(app))
    // The second camera, looking back at the scene from the other side and fixed
    // rather than driven, so the inset shows what the first one cannot see.
    // Standing at +x and -z, so the scene is back along -x and +z. Zero yaw
    // looks down -Z and yaw turns about +Y, which puts that at -2.4 rather than
    // the +2.4 that faces the empty corner behind it.
    mut watcher := camera_default()
    watcher.position = vec3(9.0, 5.0, -9.0)
    watcher.yaw = -2.4
    watcher.pitch = -0.35
    write_frame(queue, s.inset_uniform, watcher, light, elapsed,
        INSET_WIDTH, INSET_HEIGHT)

    ids := app_ids(app)
    everything := all_drawn(ids.global_transform, ids.transform, ids.drawn)
    shadow := render_world_at(s.shadow)
    render_world_begin(shadow)
    scene_sync(app.world, shadow, app.materials, app.meshes, everything)
    // The box the light sees the world through, which is what the shadow pass
    // draws with and therefore what its run is culled by.
    render_world_upload(shadow, queue, light_view_projection(light))

    inset := render_world_at(s.inset)
    render_world_begin(inset)
    scene_sync(app.world, inset, app.materials, app.meshes, everything)
    render_world_upload(inset, queue,
        camera_view_projection(watcher, INSET_WIDTH, INSET_HEIGHT))
    app_extract(app, everything, app_view(app))
}

// Everything this demo builds, in one place because two hooks and eleven passes
// share it. A pass is handed the piece of this it records with, and the graph
// holds that piece by name rather than by copy, so what `declare_passes` writes
// into it is what the pass reads.
Built :: struct {
    shadow_scene: Scene,
    lit_scene: Scene,
    inset_scene: Scene,
    culling: Culling,
    shadow_culling: Culling,
    inset_culling: Culling,
    pulse: Pulse,
    bright_step: Step,
    blur_step: Step,
    compose_step: Step,
    inset_step: Step,
    // The pass that runs the second view's graph and the one that puts what it
    // drew in the corner, so what turns them off can name them.
    inset_pass: PassId,
    corner_pass: PassId,
    // The two runs beside the App's, one per view this demo draws from.
    shadow: ^RenderWorld,
    inset: ^RenderWorld,
    frame_uniform: Buffer,
    inset_uniform: Buffer,
    // What the passes are built against, kept because the graph hands a hook
    // only a device and a format and the bindings are made from more than that.
    map_layout: BindGroupLayout,
    written_glow: BindGroupLayout,
    read_glow: BindGroupLayout,
    light: Vec3,
    elapsed: f32,
}

// Whether the second view is drawn this frame. A resource rather than a flag on
// the demo, because what decides it is a system and a system reaches the world
// and nothing else.
ShowInset :: struct { on: bool }

// SDL's scancode for B, which the platform layer does not name because a
// program that wants a key past the handful it lists writes the number.
KEY_B :: 5

// Hold B and the corner goes. Held rather than toggled, so there is no edge to
// remember and the picture says which way round it is.
watch_inset :: fn(mut world: World) {
    held := ecs_resource($Input, world, resource_of($Input, world))
    on := input_key_pressed(held, KEY_B) == false
    ecs_resource_set($ShowInset, world, resource_of($ShowInset, world),
        ShowInset { on = on })
}

// The graph, changed for this frame. Turning a pass off is not rescheduling it:
// it keeps its place in the order and records nothing. Both the sub-graph that
// draws the second view and the step that puts it in the corner go, so nothing
// is drawn for a picture nothing shows.
update_inset :: fn(mut s: Built, mut g: Graph, world: World) {
    held := ecs_resource($ShowInset, world, resource_of($ShowInset, world))
    graph_set_enabled(g, s.inset_pass, held.on)
    graph_set_enabled(g, s.corner_pass, held.on)
}

// Where the light is looking from, as a matrix. A directional light has no
// position, so one is chosen: far enough back along the direction it shines
// that everything the scene occupies is in front of it, and an orthographic
// box wide enough to hold that.
light_view_projection :: fn(direction: Vec3) -> Mat4 {
    away := vec3_scale(vec3_normalize(direction), -22.0)
    view := mat4_look_at(away, vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
    projection := mat4_ortho_zo(-13.0, 13.0, -13.0, 13.0, 1.0, 44.0)
    mat4_mul(projection, view)
}

// The camera, the light, and the light's matrix, as the bytes the shader reads
// them as.
write_frame :: fn(queue: Queue, uniform: Buffer, eye: Camera, direction: Vec3,
    seconds: f32, w: i64, h: i64) {
    mut values : [FRAME_FLOATS]f32 = [0.0; FRAME_FLOATS]
    mut view_projection := camera_view_projection(eye, w, h)
    mut element : i64 = 0
    while (element < 16) {
        values[element] = view_projection.m[element]
        element = element + 1
    }
    mut light := light_view_projection(direction)
    mut second : i64 = 0
    while (second < 16) {
        values[16 + second] = light.m[second]
        second = second + 1
    }
    at := camera_position(eye)
    values[32] = at.x
    values[33] = at.y
    values[34] = at.z
    values[35] = 1.0
    values[36] = direction.x
    values[37] = direction.y
    values[38] = direction.z
    values[39] = 0.0
    values[40] = 1.0
    values[41] = 0.96
    values[42] = 0.88
    values[43] = 2.4
    values[44] = 0.1
    values[45] = 0.12
    values[46] = 0.16
    // The seconds since the program started. The ambient colour's fourth
    // component is the one thing in here nothing reads, so the clock rides in
    // it rather than in a second uniform bound everywhere.
    values[47] = seconds
    queue_write_buffer(queue, uniform, 0, ptr_to(values[0]), FRAME_BYTES)
}

// Which stages may read it is part of the layout, and a stage left out is a
// pipeline that will not build rather than a binding that reads nothing: the
// frame is read by the compute pass as well as by the two drawing ones, so it
// says all three.
// The map and the sampler that reads it. A comparison sampler answers how much
// of the neighbourhood passed the depth test rather than what the depth was,
// which is what makes one read give a soft edge.
shadow_layout :: fn(device: Device) -> BindGroupLayout {
    mut entries : [2]BindGroupLayoutEntry = [bind_group_layout_entry_init(); 2]
    entries[0].binding = 0
    entries[0].visibility = ShaderStage::Fragment
    entries[0].texture.sample_type = TEXTURE_SAMPLE_TYPE_DEPTH
    entries[0].texture.view_dimension = TEXTURE_VIEW_DIMENSION_2D
    entries[1].binding = 1
    entries[1].visibility = ShaderStage::Fragment
    entries[1].sampler.type = SAMPLER_BINDING_TYPE_COMPARISON
    mut descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 2
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

shadow_group_of :: fn(device: Device, layout: BindGroupLayout, view: TextureView,
    reader: Sampler) -> BindGroup {
    mut entries : [2]BindGroupEntry = [bind_group_entry_init(); 2]
    entries[0].binding = 0
    entries[0].texture_view = view
    entries[1].binding = 1
    entries[1].sampler = reader
    mut descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 2
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group(device, ptr_to(descriptor))
}

// Position and normal, which is what both pipelines read. The shadow one uses
// only the first and takes the same buffer, since one layout for one mesh is
// what lets the same geometry go through both.
vertex_layout :: fn(mut attributes: [2]VertexAttribute) -> VertexBufferLayout {
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    mut buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])
    buffer_layout
}

make_shader :: fn(device: Device) -> ShaderModule {
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    device_create_shader_module(device, ptr_to(module_descriptor))
}

// The pass that writes the map. No fragment stage and no colour target: depth
// is all of what it produces, so there is nothing to shade.
//
// The bias is what keeps a surface from shadowing itself. A depth texel covers
// a patch of surface and holds one number for it, so a sloped surface is nearer
// than its own recorded depth over half of every texel and stripes itself. The
// slope-scaled term is the one that matters; the constant handles what is flat.
make_shadow_pipeline :: fn(device: Device, shader: ShaderModule,
    layout: PipelineLayout) -> RenderPipeline {
    mut attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    mut buffer_layout := vertex_layout(attributes)

    mut depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_LESS
    depth.depth_bias = 2
    depth.depth_bias_slope_scale = 2.0

    mut descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_shadow",
        length = 9 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

make_scene_pipeline :: fn(device: Device, shader: ShaderModule, format: u32,
    layout: PipelineLayout) -> RenderPipeline {
    mut attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    mut buffer_layout := vertex_layout(attributes)

    mut target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    mut depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_LESS

    mut descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

// A step of the chain: one pipeline, the layout its input is bound through,
// and which resource that input is. The binding is remade whenever the graph
// says the texture behind it moved, which is every resize, since these follow
// the window.
Step :: struct {
    pipeline: RenderPipeline,
    layout: BindGroupLayout,
    source: ResourceId,
    group: BindGroup,
    // The compose step reads two, so it carries a second of each.
    second_layout: BindGroupLayout,
    second_source: ResourceId,
    second_group: BindGroup,
    reads_two: i64,
    // Where in the target it draws, or a width of zero for the whole of it.
    // The inset is the one step that covers part of the screen rather than all
    // of it, and a viewport is what says so without a second pipeline.
    at_x: f32,
    at_y: f32,
    at_width: f32,
    at_height: f32,
}

// One fullscreen triangle. No vertex buffer: the three corners come from the
// vertex index, so there is nothing to bind but the texture being read.
draw_cover :: fn(mut step: Step, pass: RenderPassEncoder) {
    if (step.at_width > 0.0) {
        render_pass_encoder_set_viewport(pass, step.at_x,
            step.at_y, step.at_width,
            step.at_height, 0.0, 1.0)
    }
    render_pass_encoder_set_pipeline(pass, step.pipeline)
    render_pass_encoder_set_bind_group(pass, 0, step.group, 0,
        no_pointer())
    if (step.reads_two == 1) {
        render_pass_encoder_set_bind_group(pass, 1,
            step.second_group, 0, no_pointer())
    }
    render_pass_encoder_draw(pass, 3, 1, 0, 0)
}

// What the graph calls when a texture this step reads has been made again. A
// bind group holds a view, and a resize throws the view away, so the binding is
// built afresh from what the graph now holds.
rebuild_step :: fn(mut step: Step, mut g: Graph) {
    step.group = sampled_group(graph_device(g), step.layout,
        graph_view(g, step.source), graph_sampler(g, step.source))
    if (step.reads_two == 1) {
        step.second_group = sampled_group(graph_device(g),
            step.second_layout, graph_view(g, step.second_source),
            graph_sampler(g, step.second_source))
    }
}

// The run of values the compute pass writes and the scene pass reads. Two
// layouts over the same buffer, because what may be written to it is part of
// the binding rather than of the buffer.
storage_layout :: fn(device: Device, writable: bool) -> BindGroupLayout {
    mut entry := bind_group_layout_entry_init()
    entry.binding = 0
    entry.visibility = ShaderStage::Fragment | ShaderStage::Compute
    if (writable) {
        entry.buffer.type = BUFFER_BINDING_TYPE_STORAGE
    } else {
        entry.buffer.type = BUFFER_BINDING_TYPE_READ_ONLY_STORAGE
    }
    mut descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

storage_group :: fn(device: Device, layout: BindGroupLayout, held: Buffer,
    size: i64) -> BindGroup {
    mut entry := bind_group_entry_init()
    entry.binding = 0
    entry.buffer = held
    entry.size = size
    mut descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group(device, ptr_to(descriptor))
}

// What the compute pass records with: the pipeline, the frame it reads the
// time from, and the run it writes.
Pulse :: struct {
    pipeline: ComputePipeline,
    frame_group: BindGroup,
    glow_group: BindGroup,
    groups: i64,
}

dispatch_pulse :: fn(mut held: Pulse, pass: ComputePassEncoder) {
    compute_pass_encoder_set_pipeline(pass, held.pipeline)
    compute_pass_encoder_set_bind_group(pass, 0, held.frame_group,
        0, no_pointer())
    compute_pass_encoder_set_bind_group(pass, 1, held.glow_group,
        0, no_pointer())
    // One group covers every thing that is drawn, since the shader answers for
    // an index past the end rather than being dispatched exactly.
    compute_pass_encoder_dispatch_workgroups(pass, 1, 1, 1)
}

make_pulse_pipeline :: fn(device: Device, shader: ShaderModule,
    layout: PipelineLayout) -> ComputePipeline {
    mut descriptor := compute_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.compute.module = shader
    descriptor.compute.entry_point = StringView { data = "cs_pulse",
        length = 8 }
    device_create_compute_pipeline(device, ptr_to(descriptor))
}

// A texture and the sampler that reads it, which is what every step of the
// chain binds and nothing else.
sampled_layout :: fn(device: Device) -> BindGroupLayout {
    mut entries : [2]BindGroupLayoutEntry = [bind_group_layout_entry_init(); 2]
    entries[0].binding = 0
    entries[0].visibility = ShaderStage::Fragment
    entries[0].texture.sample_type = TEXTURE_SAMPLE_TYPE_FLOAT
    entries[0].texture.view_dimension = TEXTURE_VIEW_DIMENSION_2D
    entries[1].binding = 1
    entries[1].visibility = ShaderStage::Fragment
    entries[1].sampler.type = SAMPLER_BINDING_TYPE_FILTERING
    mut descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 2
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

sampled_group :: fn(device: Device, layout: BindGroupLayout, view: TextureView,
    reader: Sampler) -> BindGroup {
    mut entries : [2]BindGroupEntry = [bind_group_entry_init(); 2]
    entries[0].binding = 0
    entries[0].texture_view = view
    entries[1].binding = 1
    entries[1].sampler = reader
    mut descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 2
    descriptor.entries = ptr_to(entries[0])
    device_create_bind_group(device, ptr_to(descriptor))
}

// A pipeline over the fullscreen triangle, with no vertex buffer and no depth.
make_cover_pipeline :: fn(device: Device, shader: ShaderModule, format: u32,
    entry: StringView, layout: PipelineLayout) -> RenderPipeline {
    mut target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = entry
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    mut descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_cover",
        length = 8 }
    descriptor.vertex.buffers_count = 0
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_NONE
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

// A pipeline layout over up to four groups, which is what the scene wants: the
// frame, the object, the shadow map and the run of pulses.
wide_layout :: fn(device: Device, groups: i64,
    mut layouts: [4]BindGroupLayout) -> PipelineLayout {
    mut descriptor := pipeline_layout_descriptor_init()
    descriptor.bind_group_layouts_count = groups
    descriptor.bind_group_layouts = ptr_to(layouts[0])
    device_create_pipeline_layout(device, ptr_to(descriptor))
}

cover_layout :: fn(device: Device, groups: i64,
    mut layouts: [2]BindGroupLayout) -> PipelineLayout {
    mut descriptor := pipeline_layout_descriptor_init()
    descriptor.bind_group_layouts_count = groups
    descriptor.bind_group_layouts = ptr_to(layouts[0])
    device_create_pipeline_layout(device, ptr_to(descriptor))
}

make_post_shader :: fn(device: Device, source: StringView) -> ShaderModule {
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = source
    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    device_create_shader_module(device, ptr_to(module_descriptor))
}

// Six resources and the eleven passes over them. Nothing here says what runs
// when: each pass declares what it reads and what it writes, and the order
// falls out.
//
// The second view is a graph of its own, built here and handed over, so where
// the nested work falls in the order comes from what its pass declares it
// writes, the same as everything else.
declare_passes :: fn(mut s: Built, mut g: Graph, device: Device, format: u32) {
    screen := graph_backbuffer(g)
    shadow_map := graph_depth(g, "shadow map", SHADOW_SIZE, SHADOW_SIZE,
        DEPTH_FORMAT)
    depth := graph_transient_depth(g, "depth", WINDOW_SIZED, WINDOW_SIZED,
        DEPTH_FORMAT)
    // The scene is drawn into a target rather than at the window, so the chain
    // has something to read. It and the two bloom steps are transient: written
    // and consumed inside one frame, so the graph hands them one texture
    // between them wherever their lifetimes leave room.
    lit := graph_transient_color(g, "lit", WINDOW_SIZED, WINDOW_SIZED, format)
    bright := graph_transient_color(g, "bright", HALF, HALF, format)
    blurred := graph_transient_color(g, "blurred", HALF, HALF, format)
    // A run of bytes rather than a picture. Nothing draws into it and nothing
    // samples it; one pass fills it and another reads it, which is the only
    // thing the graph needs to put them in order.
    glow := graph_buffer(g, "glow", GLOW_BYTES, BufferUsage::Storage)
    // What the second view is drawn into. Transient like the rest of the chain,
    // and a fixed size, so the binding that reads it is built once.
    inset := graph_transient_color(g, "inset", INSET_WIDTH, INSET_HEIGHT,
        format)

    shadow_pass := graph_pass($Scene, g, "shadow", draw_things,
        ptr_to(s.shadow_scene))
    graph_writes_depth(g, shadow_pass, shadow_map)

    // Declared second and reading what the first writes, which is the edge the
    // order follows. Declaring them the other way round changes nothing.
    lit_pass := graph_pass($Scene, g, "scene", draw_things, ptr_to(s.lit_scene))
    graph_writes_color(g, lit_pass, lit,
        Color { r = 0.05, g = 0.06, b = 0.09, a = 1.0 })
    graph_writes_depth(g, lit_pass, depth)
    graph_reads(g, lit_pass, shadow_map)
    graph_reads(g, lit_pass, glow)
    // One hook for three bindings, because the map and the run of glow values
    // are read by the scene pass and by the inset's, and the inset's graph
    // holds neither resource to rebuild from.
    s.lit_scene.shadow_map = shadow_map
    s.lit_scene.glow = glow
    graph_rebuilds($Built, g, lit_pass, rebuild_bindings, ptr_to(s))

    // What is drawn at all, decided once per view. The shadow pass, the scene
    // pass and the inset each run off their own run, so each has its own
    // culling pass and reads what that one wrote.
    arguments := graph_external_buffer(g, "draw arguments")
    graph_set_external_buffer(g, arguments,
        render_world_indirect(render_world_at(s.culling.render)))
    cull_pass := graph_compute_pass($Culling, g, "cull", cull_things,
        ptr_to(s.culling))
    graph_writes(g, cull_pass, arguments)
    graph_reads(g, lit_pass, arguments)

    // The light's own, from the box it sees the world through. An orthographic
    // projection has six planes like any other, so the same test answers it.
    shadow_arguments := graph_external_buffer(g, "shadow arguments")
    graph_set_external_buffer(g, shadow_arguments,
        render_world_indirect(render_world_at(s.shadow)))
    shadow_cull := graph_compute_pass($Culling, g, "shadow cull", cull_things,
        ptr_to(s.shadow_culling))
    graph_writes(g, shadow_cull, shadow_arguments)
    graph_reads(g, shadow_pass, shadow_arguments)

    // Declared after the pass that reads it, and it runs first: the buffer
    // between them is the whole of what says so.
    pulse_pass := graph_compute_pass($Pulse, g, "pulse", dispatch_pulse,
        ptr_to(s.pulse))
    graph_writes(g, pulse_pass, glow)

    // The chain. Each step is the same fullscreen triangle with a different
    // fragment entry and a different input, and each is declared in whatever
    // order reads well: what runs when comes from the reads and writes.
    s.bright_step.source = lit
    s.bright_step.second_source = lit
    bright_pass := graph_pass($Step, g, "bright", draw_cover,
        ptr_to(s.bright_step))
    graph_writes_color(g, bright_pass, bright,
        Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 })
    graph_reads(g, bright_pass, lit)
    graph_rebuilds($Step, g, bright_pass, rebuild_step, ptr_to(s.bright_step))

    s.blur_step.source = bright
    s.blur_step.second_source = bright
    blur_pass := graph_pass($Step, g, "blur", draw_cover, ptr_to(s.blur_step))
    graph_writes_color(g, blur_pass, blurred,
        Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 })
    graph_reads(g, blur_pass, bright)
    graph_rebuilds($Step, g, blur_pass, rebuild_step, ptr_to(s.blur_step))

    s.compose_step.source = lit
    s.compose_step.second_source = blurred
    compose_pass := graph_pass($Step, g, "compose", draw_cover,
        ptr_to(s.compose_step))
    graph_writes_color(g, compose_pass, screen,
        Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 })
    graph_reads(g, compose_pass, lit)
    graph_reads(g, compose_pass, blurred)
    graph_rebuilds($Step, g, compose_pass, rebuild_step, ptr_to(s.compose_step))

    // The second view: its own target, its own depth, its own pass.
    mut inset_graph := graph_new(device)
    inset_target := graph_external_color(inset_graph, "target")
    inset_depth := graph_depth(inset_graph, "depth", INSET_WIDTH, INSET_HEIGHT,
        DEPTH_FORMAT)
    inset_arguments := graph_external_buffer(inset_graph, "inset arguments")
    graph_set_external_buffer(inset_graph, inset_arguments,
        render_world_indirect(render_world_at(s.inset)))
    inset_cull := graph_compute_pass($Culling, inset_graph, "inset cull",
        cull_things, ptr_to(s.inset_culling))
    graph_writes(inset_graph, inset_cull, inset_arguments)

    inset_scene_pass := graph_pass($Scene, inset_graph, "inset scene",
        draw_things, ptr_to(s.inset_scene))
    graph_writes_color(inset_graph, inset_scene_pass, inset_target,
        Color { r = 0.02, g = 0.02, b = 0.04, a = 1.0 })
    graph_writes_depth(inset_graph, inset_scene_pass, inset_depth)
    graph_reads(inset_graph, inset_scene_pass, inset_arguments)
    if (graph_schedule(inset_graph) == false) {
        print_str_line("the inset graph cannot run")
    }

    sub := graph_sub(g, inset_graph)
    inset_pass := graph_sub_pass(g, "inset view", sub)
    s.inset_pass = inset_pass
    graph_writes_color(g, inset_pass, inset,
        Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 })
    // What the child draws into is what this graph holds for `inset`, given
    // again every time the child runs.
    graph_takes(g, sub, inset_target, inset)

    // Last, and over the top: the second view drawn into a corner of what the
    // compose pass left. Both write the window, and the graph keeps them in the
    // order they were declared, so this one loads rather than clears.
    s.inset_step.source = inset
    s.inset_step.second_source = inset
    corner_pass := graph_pass($Step, g, "corner", draw_cover,
        ptr_to(s.inset_step))
    s.corner_pass = corner_pass
    graph_writes_color(g, corner_pass, screen,
        Color { r = 0.0, g = 0.0, b = 0.0, a = 1.0 })
    graph_reads(g, corner_pass, inset)
    graph_rebuilds($Step, g, corner_pass, rebuild_step, ptr_to(s.inset_step))
}

// The shadow map and the run of glow values, bound again. One hook rather than
// one per pass: the scene pass and the inset's read the same two bindings, the
// compute pass writes the run the scene pass reads, and the map does not follow
// the window so nothing else would rebuild it.
rebuild_bindings :: fn(mut s: Built, mut g: Graph) {
    device := graph_device(g)
    s.lit_scene.shadow_group = shadow_group_of(device, s.map_layout,
        graph_view(g, s.lit_scene.shadow_map),
        graph_sampler(g, s.lit_scene.shadow_map))
    s.pulse.glow_group = storage_group(device, s.written_glow,
        graph_buffer_of(g, s.lit_scene.glow), GLOW_BYTES)
    s.lit_scene.glow_group = storage_group(device, s.read_glow,
        graph_buffer_of(g, s.lit_scene.glow), GLOW_BYTES)
    s.inset_scene.shadow_group = s.lit_scene.shadow_group
    s.inset_scene.glow_group = s.lit_scene.glow_group
}

main :: fn() -> i64 {
    mut config := app_config("Frost shadowed scene", WIDTH, HEIGHT)
    config.vertices = VERTEX_ROOM
    config.indices = INDEX_ROOM
    config.drawn = MAX_DRAWN
    match app_open(config) {
        case .Ok { value }: run(value)
        case .Err { error }: app_failed(error)
    }
}

run :: fn(move app: App) -> i64 {
    app_install_group(app, default_plugins())
    app_install(app, camera_controller_plugin)
    app_install(app, exit_on_escape_plugin)
    device := app_device(app)
    queue := app_queue(app)

    mesh_cache_insert(app.meshes, "cube", cube_mesh(app.store, queue))
    mesh_cache_insert(app.meshes, "sphere",
        sphere_mesh(app.store, queue, 0.7, 16, 24))
    cube := mesh_cache_find(app.meshes, "cube")
    sphere := mesh_cache_find(app.meshes, "sphere")

    mut looks : [4]i64 = [0; 4]
    looks[0] = materials_add(app.materials, Material {
        base_color = vec4(0.86, 0.33, 0.3, 1.0), roughness = 0.4,
        metallic = 0.0 })
    looks[1] = materials_add(app.materials, Material {
        base_color = vec4(0.32, 0.76, 0.48, 1.0), roughness = 0.55,
        metallic = 0.0 })
    looks[2] = materials_add(app.materials, Material {
        base_color = vec4(0.36, 0.52, 0.92, 1.0), roughness = 0.25,
        metallic = 0.0 })
    // The floor, which is matte so the shadow on it reads as a shadow rather
    // than as a change in the highlight.
    looks[3] = materials_add(app.materials, Material {
        base_color = vec4(0.68, 0.66, 0.62, 1.0), roughness = 0.9,
        metallic = 0.0 })

    // One run per view, because culling is a question about a view and this
    // demo draws the same world from three: the camera, the light, and the
    // second camera in the corner. One run culled by any of them is wrong for
    // the other two, and the shadow pass is where that shows worst: a thing
    // behind the camera can still throw a shadow into it. The App holds the
    // camera's; the other two are this demo's own.
    mut shadow_render := render_world_new(device, MAX_DRAWN)
    mut inset_render := render_world_new(device, MAX_DRAWN)

    frame_layout := uniform_layout(device, FRAME_BYTES,
        ShaderStage::Vertex | ShaderStage::Fragment | ShaderStage::Compute)
    object_layout := render_world_layout(app.render)
    map_layout := shadow_layout(device)
    // The same buffer through two bindings: the compute pass writes it, the
    // scene pass only reads it, and which of those a binding allows belongs to
    // the layout rather than to the buffer.
    written_glow := storage_layout(device, true)
    read_glow := storage_layout(device, false)

    // Two layouts, because the shadow pass has no shadow map to bind and a
    // pipeline may not name a group its shader never reads.
    mut shadow_layouts : [4]BindGroupLayout = [frame_layout, object_layout,
        map_layout, read_glow]
    shadow_pipeline_layout := wide_layout(device, 2, shadow_layouts)

    mut scene_layouts : [4]BindGroupLayout = [frame_layout, object_layout,
        map_layout, read_glow]
    scene_pipeline_layout := wide_layout(device, 4, scene_layouts)

    mut pulse_layouts : [4]BindGroupLayout = [frame_layout, written_glow,
        frame_layout, frame_layout]
    pulse_pipeline_layout := wide_layout(device, 2, pulse_layouts)

    frame_uniform := uniform_buffer(device, FRAME_BYTES)
    frame_group := uniform_group(device, frame_layout, frame_uniform,
        FRAME_BYTES)

    // Which component is which, asked of the world the App opened.
    ids := app_ids(app)
    local := ids.local_transform
    spin := ids.spin
    drawn := ids.drawn
    global := ids.global_transform
    wanted := mask_with(mask_with(mask_with(mask_with(mask_with(
        mask_empty(), local), spin), drawn), global), ids.transform)
    // The root has a place and a turn and nothing drawn, since it is what the
    // grid hangs off rather than a thing on the screen.
    root_wanted := mask_with(mask_with(mask_with(mask_empty(), local),
        spin), global)

    // One more than the things that are drawn: the last is the root every
    // shape hangs off, placed by the systems and drawn by nothing.
    mut entities := heap_slice($Entity, INSTANCES + 1)
    // A binding per thing, keyed by the entity rather than by a position, and
    // the run of draw items one frame produces. Room for more than the scene
    // starts with, since the point of keying by entity is that a thing spawned
    // later needs nothing resized.


    // The floor first, so it is the one thing under everything else, then a
    // grid of shapes above it turning about their own axes.
    floor := ecs_spawn_with(app.world, wanted)
    ecs_set($LocalTransform, app.world, floor, local, LocalTransform {
        translation = vec3(0.0, FLOOR_Y, 0.0), rotation = quat_identity(),
        scale = vec3(9.0, FLOOR_THICKNESS, 9.0) })
    ecs_set($Spin, app.world, floor, spin,
        spinning(vec3(0.0, 1.0, 0.0), 0.0, quat_identity()))
    ecs_set($Drawn, app.world, floor, drawn, Drawn { mesh = cube,
        material = looks[3], layer = ONE_LAYER })
    entities[0] = floor

    // The middle column and the middle row, so the grid is centred on the
    // floor and the bottom row is the one measured against it.
    half : f32 = 1.0
    lowest : f32 = FLOOR_TOP + LOWEST_CLEARANCE
    mut made : i64 = 0
    while (made < SHAPES) {
        row := made / GRID
        column := made - row * GRID
        across : f32 = column
        up : f32 = row
        entity := ecs_spawn_with(app.world, wanted)
        ecs_set($LocalTransform, app.world, entity, local,
            LocalTransform { translation = vec3((across - half) * COLUMN_SPACING,
                lowest + up * ROW_RISE,
                (up - half) * ROW_DEPTH),
            rotation = quat_identity(), scale = vec3(1.0, 1.0, 1.0) })

        // An axis that differs from one to the next, so the shadows underneath
        // move differently rather than as one shape.
        turning := vec3_normalize(vec3(0.3 + row, 1.0, 0.2 + column))
        speed : f32 = 0.5 + 0.11 * made
        ecs_set($Spin, app.world, entity, spin,
            spinning(turning, speed, quat_identity()))

        mut shape := cube
        if (made - (made / 2) * 2 == 1) {
            shape = sphere
        }
        ecs_set($Drawn, app.world, entity, drawn, Drawn { mesh = shape,
            material = looks[made - (made / 3) * 3], layer = ONE_LAYER })

        // Nothing here makes a buffer or a binding. What is drawn and where it
        // is are the world's; the device side of it is worked out from the
        // world once a frame.
        entities[made + 1] = entity
        made = made + 1
    }

    // The root, and the grid hung off it. Each shape keeps its own turn, and
    // the root turns too, so what a shape ends up doing is its own spin inside
    // an orbit and neither of them says anything about the other.
    root := ecs_spawn_with(app.world, root_wanted)
    ecs_set($LocalTransform, app.world, root, local, LocalTransform {
        translation = vec3(0.0, 0.0, 0.0), rotation = quat_identity(),
        scale = vec3(1.0, 1.0, 1.0) })
    ecs_set($Spin, app.world, root, spin,
        spinning(vec3(0.0, 1.0, 0.0), 0.25, quat_identity()))
    // Hung off the root before the root is put in the table, since putting it
    // there is handing it over and the name does not hold it afterwards.
    mut hung : i64 = 1
    while (hung < INSTANCES) {
        tree := world_tree(app.world)
        hierarchy_attach(tree, entities[hung], root)
        hung = hung + 1
    }
    entities[INSTANCES] = root

    shader := make_shader(device)
    post_shader := make_post_shader(device,
        StringView { data = POST_SHADER, length = str_len(POST_SHADER) })
    compose_shader := make_post_shader(device,
        StringView { data = COMPOSE_SHADER, length = str_len(COMPOSE_SHADER) })
    sampled := sampled_layout(device)
    mut one_group : [2]BindGroupLayout = [sampled, sampled]
    one_layout := cover_layout(device, 1, one_group)
    mut two_groups : [2]BindGroupLayout = [sampled, sampled]
    two_layout := cover_layout(device, 2, two_groups)

    // The second view, drawn from somewhere else with the same scene. Only the
    // frame differs: the same slots, the same meshes and the same pipeline, so
    // a second camera costs one uniform and one binding.
    inset_uniform := uniform_buffer(device, FRAME_BYTES)
    inset_frame_group := uniform_group(device, frame_layout, inset_uniform,
        FRAME_BYTES)

    culling_pipeline := render_world_cull_pipeline(device,
        render_world_cull_layout(app.render))
    scene_pipeline := make_scene_pipeline(device, shader, app_format(app),
        scene_pipeline_layout)

    // Everything the passes record with, in one place. What each pass gets is
    // the piece of this it needs, named rather than copied.
    mut built := Built {
        shadow_scene = Scene {
            pipeline = make_shadow_pipeline(device, shader,
                shadow_pipeline_layout),
            frame_group = frame_group, render = ptr_to(shadow_render),
            store = ptr_to(app.store), shadow_group = no_bind_group(),
            glow_group = no_bind_group(), samples_shadow = 0,
            shadow_map = 0, glow = 0,
        },
        lit_scene = Scene {
            pipeline = scene_pipeline, frame_group = frame_group,
            render = ptr_to(app.render), store = ptr_to(app.store),
            shadow_group = no_bind_group(), glow_group = no_bind_group(),
            samples_shadow = 1, shadow_map = 0, glow = 0,
        },
        inset_scene = Scene {
            pipeline = scene_pipeline, frame_group = inset_frame_group,
            render = ptr_to(inset_render), store = ptr_to(app.store),
            shadow_group = no_bind_group(), glow_group = no_bind_group(),
            samples_shadow = 1, shadow_map = 0, glow = 0,
        },
        culling = Culling { pipeline = culling_pipeline,
            render = ptr_to(app.render) },
        shadow_culling = Culling { pipeline = culling_pipeline,
            render = ptr_to(shadow_render) },
        inset_culling = Culling { pipeline = culling_pipeline,
            render = ptr_to(inset_render) },
        pulse = Pulse {
            pipeline = make_pulse_pipeline(device,
                make_post_shader(device,
        StringView { data = PULSE_SHADER, length = str_len(PULSE_SHADER) }), pulse_pipeline_layout),
            frame_group = frame_group, glow_group = no_bind_group(),
            groups = 2,
        },
        bright_step = Step { pipeline = no_render_pipeline(), layout = sampled,
            source = 0, group = no_bind_group(), second_layout = sampled,
            second_source = 0, second_group = no_bind_group(), reads_two = 0,
            at_x = 0.0, at_y = 0.0, at_width = 0.0, at_height = 0.0 },
        blur_step = Step { pipeline = no_render_pipeline(), layout = sampled,
            source = 0, group = no_bind_group(), second_layout = sampled,
            second_source = 0, second_group = no_bind_group(), reads_two = 0,
            at_x = 0.0, at_y = 0.0, at_width = 0.0, at_height = 0.0 },
        compose_step = Step { pipeline = no_render_pipeline(), layout = sampled,
            source = 0, group = no_bind_group(), second_layout = sampled,
            second_source = 0, second_group = no_bind_group(), reads_two = 0,
            at_x = 0.0, at_y = 0.0, at_width = 0.0, at_height = 0.0 },
        inset_step = Step { pipeline = no_render_pipeline(), layout = sampled,
            source = 0, group = no_bind_group(), second_layout = sampled,
            second_source = 0, second_group = no_bind_group(), reads_two = 0,
            at_x = 0.0, at_y = 0.0, at_width = 0.0, at_height = 0.0 },
        inset_pass = cast($PassId, 0),
        corner_pass = cast($PassId, 0),
        shadow = ptr_to(shadow_render),
        inset = ptr_to(inset_render),
        frame_uniform = frame_uniform,
        inset_uniform = inset_uniform,
        map_layout = map_layout,
        written_glow = written_glow,
        read_glow = read_glow,
        light = vec3_normalize(vec3(-0.55, -1.0, -0.4)),
        elapsed = 0.0,
    }
    built.bright_step.pipeline = make_cover_pipeline(device, post_shader,
        app_format(app), StringView { data = "fs_bright", length = 9 },
        one_layout)
    built.blur_step.pipeline = make_cover_pipeline(device, post_shader,
        app_format(app), StringView { data = "fs_blur", length = 7 },
        one_layout)
    built.compose_step.pipeline = make_cover_pipeline(device, compose_shader,
        app_format(app), StringView { data = "fs_compose", length = 10 },
        two_layout)
    built.compose_step.reads_two = 1
    built.inset_step.pipeline = make_cover_pipeline(device, post_shader,
        app_format(app), StringView { data = "fs_blit", length = 7 },
        one_layout)
    built.inset_step.at_x = INSET_MARGIN
    built.inset_step.at_y = INSET_MARGIN
    built.inset_step.at_width = INSET_WIDTH
    built.inset_step.at_height = INSET_HEIGHT

    mut eye := camera_default()
    eye.position = vec3(0.0, 1.5, 13.0)
    eye.pitch = -0.05
    app_camera_set(app, eye)

    app_insert_resource($ShowInset, app, ShowInset { on = true })
    app_add_system(app, Stage::FrameUpdate, watch_inset)
    app_configure_graph($Built, app, declare_passes, ptr_to(built))
    app_update_graph($Built, app, update_inset, ptr_to(built))
    app_before_render($Built, app, before_frame, ptr_to(built))
    app_run(app)

    render_world_free(shadow_render)
    render_world_free(inset_render)
    heap_release_slice($Entity, entities)
    app_close(app)
}
