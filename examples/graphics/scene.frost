// A world the ECS holds and two passes draw, with depth sorting between them.
//
//   just scene
//
// W/A/S/D move, Q and E drop and rise, the arrow keys look, escape closes it,
// and resizing works. Four shapes spin at different distances and different
// speeds. Two passes draw them: the near ones clear the targets, the far ones
// load and draw over. The far pass runs second and its shapes still go behind,
// because depth decides that rather than order.
//
// That is the point of drawing it this way. If the depth attachment were
// missing, or the second pass cleared depth instead of loading it, the far
// shapes would sit on top of the near ones and everything else would look
// identical. It is a thing that is either right or obviously wrong on screen.
//
// Both passes declare the same two targets and the render graph decides the
// rest: which runs first, and that the first write of a target clears it while
// the second loads what is there. Neither pass body mentions a load op.
//
// Which shapes each pass draws is decided before either records. A thing
// carries the layer it belongs to, and `scene_sync` walks the world once per
// layer and leaves a run holding only that layer's things. The two passes are
// the same function over two runs, which is what a pass being a value buys:
// nothing had to be written twice to have two of them.

import "platform.frost"
import "camera.frost"
import "renderer.frost"
import "graph.frost"
import "mesh.frost"
import "material.frost"
import "scene_sync.frost"
import "wgpu.frost"
import "ecs.frost"
import "math.frost"
import "mem.frost"
import "io.frost"

WIDTH :: 960
HEIGHT :: 540
INSTANCES :: 4

// The camera, written once a frame: one matrix and nothing else. What a thing's
// own uniform holds is `scene_sync`'s, since that is what fills it.
FRAME_BYTES :: 64

// The two layers this world is divided into, and which pass draws each.
NEAR :: 0
FAR :: 1

// What a pass records with: a pipeline and the run it was handed. Which layer
// that run came from is not here, because a run is already only what this pass
// draws.
Scene :: struct {
    pipeline: RenderPipeline,
    list: ^DrawList,
    frame_group: BindGroup,
}

SHADER :: "
struct Frame { view_projection: mat4x4<f32> }
struct Object {
    model: mat4x4<f32>,
    base_color: vec4<f32>,
    surface: vec4<f32>,
}

@group(0) @binding(0) var<uniform> frame: Frame;
@group(1) @binding(0) var<uniform> object: Object;

struct VertexOut {
    @builtin(position) position: vec4<f32>,
    @location(0) normal: vec3<f32>,
}

@vertex
fn vs_main(@location(0) position: vec3<f32>,
           @location(1) normal: vec3<f32>) -> VertexOut {
    var out: VertexOut;
    let placed = object.model * vec4<f32>(position, 1.0);
    out.position = frame.view_projection * placed;
    out.normal = (object.model * vec4<f32>(normal, 0.0)).xyz;
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    let towards = normalize(vec3<f32>(-0.4, 0.9, 0.5));
    let lambert = max(dot(normalize(in.normal), towards), 0.0);
    return vec4<f32>(object.base_color.rgb * (0.25 + 0.75 * lambert),
        object.base_color.a);
}
"

// One pass body over one run. Both passes are this function with different
// state, and neither knows there is another.
//
// What the two of them draw into, and whether each clears what is there or
// draws over it, is not written here. Both passes declare the same colour and
// depth targets, the graph puts the first writer first, and the first write of
// a target clears it while every write after loads it.
draw_layer :: fn(pass: RenderPassEncoder, state: ^u8) {
    mut s := unsafe { ptr_cast($Scene, state) }
    render_pass_encoder_set_pipeline(pass, unsafe { s^.pipeline })
    render_pass_encoder_set_bind_group(pass, 0, unsafe { s^.frame_group }, 0,
        no_pointer())

    list := unsafe { s^.list^ }
    mut index : i64 = 0
    while (index < draw_list_count(list)) {
        one := draw_list_at(list, index)
        render_pass_encoder_set_bind_group(pass, 1, one.binding, 0,
            no_pointer())
        mesh_bind(pass, one.geometry)
        render_pass_encoder_draw_indexed(pass, one.geometry.index_count, 1, 0,
            0, 0)
        index = index + 1
    }
}

// The camera, as the bytes the shader reads it as.
write_frame :: fn(queue: Queue, uniform: Buffer, eye: Camera, w: i64, h: i64) {
    mut view_projection := camera_view_projection(eye, w, h)
    queue_write_buffer(queue, uniform, 0, ptr_to(view_projection.m[0]),
        FRAME_BYTES)
}

uniform_layout :: fn(device: Device, size: i64) -> BindGroupLayout {
    mut entry := bind_group_layout_entry_init()
    entry.binding = 0
    entry.visibility = ShaderStage::Vertex | ShaderStage::Fragment
    entry.buffer.type = BUFFER_BINDING_TYPE_UNIFORM
    entry.buffer.min_binding_size = size
    mut descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

uniform_buffer :: fn(device: Device, size: i64) -> Buffer {
    mut descriptor := buffer_descriptor_init()
    descriptor.usage = BufferUsage::Uniform | BufferUsage::CopyDst
    descriptor.size = size
    device_create_buffer(device, ptr_to(descriptor))
}

uniform_group :: fn(device: Device, layout: BindGroupLayout, held: Buffer,
    size: i64) -> BindGroup {
    mut entry := bind_group_entry_init()
    entry.binding = 0
    entry.buffer = held
    entry.size = size
    mut descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group(device, ptr_to(descriptor))
}

make_pipeline :: fn(device: Device, format: u32,
    layout: PipelineLayout) -> RenderPipeline {
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    shader := device_create_shader_module(device, ptr_to(module_descriptor))

    // Where the surface faces is read and where it reads an image is not, so
    // two of the three the mesh carries are described here.
    mut attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    mut buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])

    mut target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    // Depth on: write it, and keep the fragment only where it is nearer than
    // what is already there.
    mut depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_LESS

    mut descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

main :: fn() -> i64 {
    mut p := platform_open("Frost scene", WIDTH, HEIGHT)
    if (platform_ok(p) == false) {
        print_str_line("no window")
        print_str_line(platform_error())
        return 1
    }
    mut r := renderer_open(platform_window(p), WIDTH, HEIGHT)
    if (renderer_ok(r) == false) {
        print_str_line("no device")
        platform_close(p)
        return 2
    }
    device := renderer_device(r)
    queue := renderer_queue(r)

    // A cube for the near layer and a sphere for the far one, so which pass
    // drew a thing is readable off the screen.
    mut cache := mesh_cache_new(4)
    mesh_cache_insert(cache, "cube", cube_mesh(device, queue))
    mesh_cache_insert(cache, "sphere", sphere_mesh(device, queue, 0.6, 16, 24))
    cube := mesh_cache_find(cache, "cube")
    sphere := mesh_cache_find(cache, "sphere")

    mut registry := materials_new(8)
    mut looks : [INSTANCES]i64 = [0; INSTANCES]
    looks[0] = materials_add(registry, Material {
        base_color = vec4(1.0, 0.35, 0.35, 1.0), roughness = 0.5,
        metallic = 0.0 })
    looks[1] = materials_add(registry, Material {
        base_color = vec4(0.35, 1.0, 0.45, 1.0), roughness = 0.5,
        metallic = 0.0 })
    looks[2] = materials_add(registry, Material {
        base_color = vec4(0.45, 0.55, 1.0, 1.0), roughness = 0.5,
        metallic = 0.0 })
    looks[3] = materials_add(registry, Material {
        base_color = vec4(1.0, 0.85, 0.4, 1.0), roughness = 0.5,
        metallic = 0.0 })

    frame_layout := uniform_layout(device, FRAME_BYTES)
    object_layout := uniform_layout(device, OBJECT_BYTES)
    mut layouts : [2]BindGroupLayout = [frame_layout, object_layout]
    mut pipeline_layout_descriptor := pipeline_layout_descriptor_init()
    pipeline_layout_descriptor.bind_group_layouts_count = 2
    pipeline_layout_descriptor.bind_group_layouts = ptr_to(layouts[0])
    pipeline_layout := device_create_pipeline_layout(device,
        ptr_to(pipeline_layout_descriptor))

    frame_uniform := uniform_buffer(device, FRAME_BYTES)
    frame_group := uniform_group(device, frame_layout, frame_uniform,
        FRAME_BYTES)

    mut world := ecs_new()
    ids := world_prepare(world)
    placement := ids.placement
    spin := ids.spin
    drawn := ids.drawn
    model := ids.model
    wanted := mask_with(mask_with(mask_with(mask_with(mask_empty(), placement),
        spin), drawn), model)

    // One binding per thing, whichever layer it is in, and a run per layer. The
    // slots are keyed by entity, so one table answers for both passes.
    mut slot_table := slot_table_new(INSTANCES * 2, object_layout)
    mut near_list := draw_list_new(INSTANCES)
    mut far_list := draw_list_new(INSTANCES)
    mut frame_schedule := world_schedule()

    mut spread : [INSTANCES]f32 = [-1.1, 1.1, -0.5, 0.6]
    mut depths : [INSTANCES]f32 = [0.0, 0.0, -1.6, -1.6]
    mut rates : [INSTANCES]f32 = [1.0, -1.4, 0.7, -0.5]
    mut layers : [INSTANCES]i64 = [NEAR, NEAR, FAR, FAR]

    mut made : i64 = 0
    while (made < INSTANCES) {
        // Straight into the archetype it belongs in, rather than spawning bare
        // and migrating once per component.
        held := ecs_spawn_with(world, wanted)
        ecs_set($Placement, world, held, placement, Placement {
            position = vec3(spread[made], 0.0, depths[made]),
            scale = vec3(0.6, 0.6, 0.6) })
        ecs_set($Spin, world, held, spin, Spin { axis = vec3(0.0, 1.0, 0.0),
            speed = rates[made], angle = 0.0 })
        mut shape := cube
        if (layers[made] == FAR) {
            shape = sphere
        }
        ecs_set($Drawn, world, held, drawn, Drawn { mesh = shape,
            material = looks[made], layer = layers[made] })
        made = made + 1
    }

    pipeline := make_pipeline(device, renderer_format(r), pipeline_layout)
    mut near_scene := Scene { pipeline = pipeline, list = ptr_to(near_list),
        frame_group = frame_group }
    mut far_scene := Scene { pipeline = pipeline, list = ptr_to(far_list),
        frame_group = frame_group }

    // Both passes write both targets, and nothing stands between them, so the
    // graph keeps them in the order they were declared: near clears, far draws
    // over what near left and sorts against the depth it wrote.
    mut graph := graph_new(device, 2, 2)
    screen := graph_backbuffer(graph)
    depth := graph_depth(graph, "depth", WINDOW_SIZED, WINDOW_SIZED,
        DEPTH_FORMAT)
    background := Color { r = 0.05, g = 0.05, b = 0.08, a = 1.0 }
    near_pass := graph_pass(graph, "near", draw_layer, ptr_to(near_scene))
    graph_writes_color(graph, near_pass, screen, background)
    graph_writes_depth(graph, near_pass, depth)
    far_pass := graph_pass(graph, "far", draw_layer, ptr_to(far_scene))
    graph_writes_color(graph, far_pass, screen, background)
    graph_writes_depth(graph, far_pass, depth)
    scheduled := graph_schedule(graph)
    if (scheduled == false) {
        print_str_line("the render graph cannot run")
    }
    graph_resize(graph, WIDTH, HEIGHT)

    while (scheduled && platform_poll(p)) {
        if (key_pressed(p, KEY_ESCAPE)) {
            break
        }
        if (resized(p)) {
            renderer_resize(r, width(p), height(p))
            graph_resize(graph, width(p), height(p))
        }
        world_input(world, platform_input(p))
        schedule_run(frame_schedule, world, ANY_STATE)
        write_frame(queue, frame_uniform, world_camera(world), width(p),
            height(p))
        scene_sync(world, near_list, slot_table, device, queue, registry,
            cache, drawn_in_layer(model, drawn, NEAR))
        scene_sync(world, far_list, slot_table, device, queue, registry,
            cache, drawn_in_layer(model, drawn, FAR))

        mut f := renderer_begin(r)
        if (frame_ok(f)) {
            graph_run(graph, f)
        }
        renderer_end(r, f)
    }

    graph_free(graph)
    draw_list_free(near_list)
    draw_list_free(far_list)
    slot_table_free(slot_table)
    schedule_free(frame_schedule)
    giving := ecs_resource($Hierarchy, world, TREE_SLOT)
    hierarchy_free(giving)
    materials_free(registry)
    mesh_cache_free(cache)
    ecs_free(world)
    renderer_close(r)
    platform_close(p)
    0
}
