// A world the ECS holds and two passes draw, with depth sorting between them.
//
//   just scene
//
// W/A/S/D move, Q and E drop and rise, the arrow keys look, escape closes it,
// and resizing works. Four shapes spin at different distances and different
// speeds. Two passes draw them: the near ones clear the targets, the far ones
// load and draw over. The far pass runs second and its shapes still go behind,
// because depth decides that rather than order.
//
// That is the point of drawing it this way. If the depth attachment were
// missing, or the second pass cleared depth instead of loading it, the far
// shapes would sit on top of the near ones and everything else would look
// identical. It is a thing that is either right or obviously wrong on screen.
//
// Both passes declare the same two targets and the render graph decides the
// rest: which runs first, and that the first write of a target clears it while
// the second loads what is there. Neither pass body mentions a load op.
//
// Which shapes each pass draws is decided before either records. A thing
// carries the layer it belongs to, and `scene_sync` walks the world once per
// layer and leaves a run holding only that layer's things. The two passes are
// the same function over two runs, which is what a pass being a value buys:
// nothing had to be written twice to have two of them.
//
// The App holds one of those runs, which is what a program drawing its world
// once uses. The second is this demo's own, made and freed here, because
// dividing the world is the thing this demo is about.

import "../../lib/engine/camera.frost"
import "../../lib/renderer/renderer.frost"
import "../../lib/renderer/frame.frost"
import "../../lib/renderer/graph.frost"
import "../../lib/renderer/geometry.frost"
import "../../lib/renderer/mesh.frost"
import "../../lib/renderer/material.frost"
import "../../lib/renderer/render_world.frost"
import "../../lib/renderer/uniform.frost"
import "../../lib/engine/scene_sync.frost"
import "../../lib/engine/world.frost"
import "spin.frost"
import "../../lib/engine/app.frost"
import "../../lib/renderer/wgpu.frost"
import "ecs.frost"
import "math.frost"
import "io.frost"

WIDTH :: 960
HEIGHT :: 540
INSTANCES :: 4

// How many distinct meshes and looks the run may be asked about. They measure
// the table the batch build walks, which is one counter per class per mesh per
// look, so they are the shapes of the scene rather than how many things are in
// it.
MAX_MESHES :: 4
MAX_LOOKS :: 8

// How much geometry the shared buffers hold, which is a cube and a sphere with
// room to spare.
VERTEX_ROOM :: 4096
INDEX_ROOM :: 8192

// The camera, written once a frame: one matrix and nothing else. What a thing's
// own uniform holds is `scene_sync`'s, since that is what fills it.
FRAME_BYTES :: 64

// The two layers this world is divided into, and which pass draws each.
NEAR :: 0
FAR :: 1

// What a pass records with: a pipeline and the run it was handed. Which layer
// that run came from is not here, because a run is already only what this pass
// draws.
Scene :: struct {
    pipeline: RenderPipeline,
    steps: BatchPipelines,
    frame_group: BindGroup,
    render: ^RenderWorld,
    store: ^Geometry,
}

SHADER :: "
struct Frame { view_projection: mat4x4<f32> }
struct ObjectData {
    transform_index: u32,
    mesh_id: u32,
    material_id: u32,
    batch_id: u32,
    pipeline_class: u32,
    visible: u32,
    is_overlay: u32,
    pad_zero: u32,
}

struct MaterialData {
    base_color: vec4<f32>,
    roughness: f32,
    metallic: f32,
    alpha_cutoff: f32,
    flags: u32,
}

@group(0) @binding(0) var<uniform> frame: Frame;
@group(1) @binding(0) var<storage, read> objects: array<ObjectData>;
@group(1) @binding(1) var<storage, read> visible: array<u32>;
// Where each thing ended up and what it is made of, as tables an object names a
// row of. Two hundred things sharing a look share one row of the second.
@group(1) @binding(2) var<storage, read> transforms: array<mat4x4<f32>>;
@group(1) @binding(3) var<storage, read> materials: array<MaterialData>;

struct VertexOut {
    @builtin(position) position: vec4<f32>,
    @location(0) normal: vec3<f32>,
    @location(1) @interpolate(flat) object_index: u32,
}

@vertex
fn vs_main(@location(0) position: vec3<f32>,
           @location(1) normal: vec3<f32>,
           @builtin(instance_index) instance: u32) -> VertexOut {
    var out: VertexOut;
    let object_index = visible[instance];
    let object = objects[object_index];
    let model = transforms[object.transform_index];
    let placed = model * vec4<f32>(position, 1.0);
    out.position = frame.view_projection * placed;
    out.normal = (model * vec4<f32>(normal, 0.0)).xyz;
    out.object_index = object_index;
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    let object = objects[in.object_index];
    let material = materials[object.material_id];
    let towards = normalize(vec3<f32>(-0.4, 0.9, 0.5));
    let lambert = max(dot(normalize(in.normal), towards), 0.0);
    return vec4<f32>(material.base_color.rgb * (0.25 + 0.75 * lambert),
        material.base_color.a);
}
"

// One layer, whole: the steps that decide what is drawn, then the draw. Both
// passes are this function with different state, and neither knows there is
// another.
//
// One node rather than a compute chain and a render pass, because what runs
// before what here is not something a program should have to say. The steps
// write the tables the draw reads, and they are recorded into one encoder in
// that order.
//
// What the two of them draw into, and whether each clears what is there or
// draws over it, is not written here. Both passes declare the same colour and
// depth targets, the graph puts the first writer first, and the first write of
// a target clears it while every write after loads it.
draw_layer :: fn(mut s: Scene, context: NodeContext) {
    held := render_world_at(s.render)
    batching_record(s.steps, held, context.encoder)
    pass := encoder_pass_into(context.encoder, context.into,
        context.color_load, context.clear, context.depth_load)
    render_pass_encoder_set_pipeline(pass, s.pipeline)
    render_pass_encoder_set_bind_group(pass, 0, s.frame_group, 0,
        no_pointer())
    render_pass_encoder_set_bind_group(pass, 1,
        render_world_group(held), 0, no_pointer())
    geometry_bind(pass, geometry_at(s.store))
    render_world_draw_all(pass, held)
    render_pass_encoder_end(pass)
    render_pass_encoder_release(pass)
}

// What a frame does between the world and the graph. Two runs, so the world is
// walked twice: once into the App's, which is the near layer, and once into this
// demo's own. Which layer a run holds is what the two passes differ by, and the
// view they are culled against is the same one.
before_frame :: fn(mut s: FrameState, mut app: App) {
    queue := app_queue(app)
    write_frame(queue, s.frame_uniform, app_camera(app),
        app_width(app), app_height(app))
    ids := app_ids(app)
    view := app_view(app)
    app_extract(app, drawn_in_layer(ids.global_transform, ids.transform,
            ids.drawn, NEAR), view)
    far := render_world_at(s.far)
    render_world_begin(far)
    scene_sync(app.world, far, app.materials, app.meshes,
        drawn_in_layer(ids.global_transform, ids.transform, ids.drawn, FAR))
    render_world_upload(far, queue, view, app.materials, app.meshes)
}

// What the two hooks need and the passes do not: the uniform a frame is written
// into, the run this demo keeps beside the App's, and the state each pass
// records with.
FrameState :: struct {
    frame_uniform: Buffer,
    near: ^RenderWorld,
    far: ^RenderWorld,
    near_scene: ^Scene,
    far_scene: ^Scene,
}

// Both passes write both targets and nothing stands between them, so the graph
// keeps them in the order they were declared: near clears, far draws over what
// near left and sorts against the depth it wrote.
declare_passes :: fn(mut s: FrameState, mut g: Graph, device: Device,
    format: u32) {
    screen := graph_backbuffer(g)
    depth := graph_depth(g, "depth", WINDOW_SIZED, WINDOW_SIZED, DEPTH_FORMAT)
    background := Color { r = 0.05, g = 0.05, b = 0.08, a = 1.0 }
    near_pass := graph_node_pass($Scene, g, "near", draw_layer, s.near_scene)
    graph_writes_color(g, near_pass, screen, background)
    graph_writes_depth(g, near_pass, depth)
    far_pass := graph_node_pass($Scene, g, "far", draw_layer, s.far_scene)
    graph_writes_color(g, far_pass, screen, background)
    graph_writes_depth(g, far_pass, depth)
}

// The state a pass was pointed at, read the way a run is.
scene_at :: fn(held: ^Scene) -> ref Scene {
    span : []Scene = unsafe { slice_from($Scene, held, 1) }
    ref result := span[0]
    result
}

// The camera, as the bytes the shader reads it as.
write_frame :: fn(queue: Queue, uniform: Buffer, eye: Camera, w: i64, h: i64) {
    var view_projection := camera_view_projection(eye, w, h)
    queue_write_buffer(queue, uniform, 0, ptr_to(view_projection.m[0]),
        FRAME_BYTES)
}

make_pipeline :: fn(device: Device, format: u32,
    layout: PipelineLayout) -> RenderPipeline {
    var wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    var module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    shader := device_create_shader_module(device, ptr_to(module_descriptor))

    // Where the surface faces is read and where it reads an image is not, so
    // two of the three the mesh carries are described here.
    var attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    var buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])

    var target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All

    var fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    // Depth on: write it, and keep the fragment only where it is nearer than
    // what is already there.
    var depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_GREATER

    var descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

main :: fn() -> i64 {
    var config := app_config("Frost scene", WIDTH, HEIGHT)
    config.vertices = VERTEX_ROOM
    config.indices = INDEX_ROOM
    config.drawn = INSTANCES
    match app_open(config) {
        case .Ok { value }: run(value)
        case .Err { error }: app_failed(error)
    }
}

run :: fn(move app: App) -> i64 {
    app_install_group(app, default_plugins())
    app_install(app, camera_controller_plugin)
    app_install(app, exit_on_escape_plugin)
    app_install(app, spin_plugin)
    // Turning is this program's, so which component it is is asked of the
    // world here rather than read off the engine's list.
    spin := component_of($Spin, app.world)
    device := app_device(app)
    queue := app_queue(app)

    // A cube for the near layer and a sphere for the far one, so which pass
    // drew a thing is readable off the screen.
    mesh_cache_insert(app.meshes, app.store, device, queue, "cube",
        cube_mesh())
    mesh_cache_insert(app.meshes, app.store, device, queue, "sphere",
        sphere_mesh(0.6, 16, 24))
    cube := mesh_cache_find(app.meshes, "cube")
    sphere := mesh_cache_find(app.meshes, "sphere")

    var looks : [INSTANCES]i64 = [0; INSTANCES]
    looks[0] = materials_add(app.materials, material_of(vec4(1.0, 0.35, 0.35, 1.0), 0.5, 0.0))
    looks[1] = materials_add(app.materials, material_of(vec4(0.35, 1.0, 0.45, 1.0), 0.5, 0.0))
    looks[2] = materials_add(app.materials, material_of(vec4(0.45, 0.55, 1.0, 1.0), 0.5, 0.0))
    looks[3] = materials_add(app.materials, material_of(vec4(1.0, 0.85, 0.4, 1.0), 0.5, 0.0))

    // One run per layer, and each is its own set of buffers: what a pass draws
    // is decided before it records, and two passes over two halves of a world
    // are two runs. The App holds one of them, which is what a program drawing
    // its world once uses; the second is this demo's own, because dividing the
    // world is what this demo is about.
    var far_render := render_world_new(device, INSTANCES, MAX_MESHES, MAX_LOOKS)

    frame_layout := uniform_layout(device, FRAME_BYTES,
        ShaderStage::Vertex | ShaderStage::Fragment)
    var layouts : [2]BindGroupLayout = [frame_layout,
        render_world_layout(app.render)]
    var pipeline_layout_descriptor := pipeline_layout_descriptor_init()
    pipeline_layout_descriptor.bind_group_layouts_count = 2
    pipeline_layout_descriptor.bind_group_layouts = ptr_to(layouts[0])
    pipeline_layout := device_create_pipeline_layout(device,
        ptr_to(pipeline_layout_descriptor))

    frame_uniform := uniform_buffer(device, FRAME_BYTES)
    frame_group := uniform_group(device, frame_layout, frame_uniform,
        FRAME_BYTES)

    ids := app_ids(app)
    wanted := mask_with(mask_with(mask_with(mask_with(mask_with(
                        mask_empty(),
                        ids.local_transform), spin), ids.drawn),
            ids.global_transform), ids.transform)

    var spread : [INSTANCES]f32 = [-1.1, 1.1, -0.5, 0.6]
    var depths : [INSTANCES]f32 = [0.0, 0.0, -1.6, -1.6]
    var rates : [INSTANCES]f32 = [1.0, -1.4, 0.7, -0.5]
    var layers : [INSTANCES]i64 = [NEAR, NEAR, FAR, FAR]

    var made : i64 = 0
    while (made < INSTANCES) {
        // Straight into the archetype it belongs in, rather than spawning bare
        // and migrating once per component.
        held := ecs_spawn_with(app.world, wanted)
        ecs_set($LocalTransform, app.world, held,
            ids.local_transform, LocalTransform {
                translation = vec3(spread[made], 0.0, depths[made]),
                rotation = quat_identity(), scale = vec3(0.6, 0.6, 0.6) })
        ecs_set($Spin, app.world, held, spin,
            spinning(vec3(0.0, 1.0, 0.0), rates[made], quat_identity()))
        var shape := cube
        if (layers[made] == FAR) {
            shape = sphere
        }
        ecs_set($Drawn, app.world, held, ids.drawn, Drawn { mesh = shape,
                material = looks[made], layer = layers[made] })
        made = made + 1
    }

    pipeline := make_pipeline(device, app_format(app), pipeline_layout)
    // One chain per run. They share a module and differ in the tables they
    // work on, which is what makes the two layers two answers.
    var near_scene := Scene { pipeline = pipeline,
        steps = render_world_batch_pipelines(device,
            render_world_batch_layout(app.render)),
        frame_group = frame_group, render = ptr_to(app.render),
        store = ptr_to(app.store) }
    var far_scene := Scene { pipeline = pipeline,
        steps = render_world_batch_pipelines(device,
            render_world_batch_layout(far_render)),
        frame_group = frame_group, render = ptr_to(far_render),
        store = ptr_to(app.store) }

    var frame := FrameState { frame_uniform = frame_uniform,
        near = ptr_to(app.render), far = ptr_to(far_render),
        near_scene = ptr_to(near_scene), far_scene = ptr_to(far_scene) }
    app_configure_graph($FrameState, app, declare_passes, ptr_to(frame))
    app_before_render($FrameState, app, before_frame, ptr_to(frame))
    app_run(app)

    batch_pipelines_free(scene_at(ptr_to(near_scene)).steps)
    batch_pipelines_free(scene_at(ptr_to(far_scene)).steps)
    render_world_free(far_render)
    app_close(app)
}
