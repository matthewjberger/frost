// A model read out of a file, drawn.
//
//   just gltf
//
// W/A/S/D move, Q and E drop and rise, the arrow keys look, escape closes it.
//
// Nothing here says what to draw. `gltf_read` takes a binary glTF file apart
// into geometry, materials and a tree of nodes, and `gltf_spawn` turns that
// into entities: one per node, hung off whatever the file hung it off, and one
// child per primitive under a node that draws. From there it is the same
// schedule and the same pass every other demo uses, which is the point: what a
// file loader produces is entities like any other, and the renderer never finds
// out where they came from.
//
// The file is `lib/engine/assets/shapes.glb`, written by the generator beside
// it. A cube, a pyramid and a floor, under two roots, one of which gives its
// transform as a whole matrix. The whole model is hung off one entity that
// turns, so what you see is the file's own tree carried around by something
// above it.
//
// The rest of this file is `spinning.frost`'s lit pass, unchanged. What is
// worth reading is `main`.

import "../../lib/platform/platform.frost"
import "../../lib/engine/camera.frost"
import "../../lib/renderer/renderer.frost"
import "../../lib/renderer/graph.frost"
import "../../lib/renderer/mesh.frost"
import "../../lib/renderer/material.frost"
import "../../lib/renderer/render_world.frost"
import "../../lib/engine/scene_sync.frost"
import "../../lib/engine/world.frost"
import "../../lib/engine/gltf.frost"
import "../../lib/renderer/wgpu.frost"
import "ecs.frost"
import "math.frost"
import "mem.frost"
import "io.frost"

WIDTH :: 1280
HEIGHT :: 720

// How many things the file may spawn, which is the slot table, the draw list
// and nothing else. A loaded model is as big as its file says.
MAX_DRAWN :: 64

// What is loaded, named from the root of the checkout.
MODEL :: "lib/engine/assets/shapes.glb"

// The camera and the light, written once a frame: a matrix, then four vectors.
FRAME_FLOATS :: 32
FRAME_BYTES :: 128

// What a pass records with, which is the run a frame produced and nothing else.
Scene :: struct {
    pipeline: RenderPipeline,
    frame_group: BindGroup,
    list: ^DrawList,
}

SHADER :: "
struct Frame {
    view_projection: mat4x4<f32>,
    camera_position: vec4<f32>,
    light_direction: vec4<f32>,
    light_color: vec4<f32>,
    ambient: vec4<f32>,
}

struct Object {
    model: mat4x4<f32>,
    base_color: vec4<f32>,
    surface: vec4<f32>,
}

@group(0) @binding(0) var<uniform> frame: Frame;
@group(1) @binding(0) var<uniform> object: Object;

struct VertexOut {
    @builtin(position) clip: vec4<f32>,
    @location(0) world: vec3<f32>,
    @location(1) normal: vec3<f32>,
}

@vertex
fn vs_main(@location(0) position: vec3<f32>,
           @location(1) normal: vec3<f32>) -> VertexOut {
    var out: VertexOut;
    let world = object.model * vec4<f32>(position, 1.0);
    out.clip = frame.view_projection * world;
    out.world = world.xyz;
    out.normal = (object.model * vec4<f32>(normal, 0.0)).xyz;
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    let facing = normalize(in.normal);
    let toward_light = normalize(-frame.light_direction.xyz);
    let toward_eye = normalize(frame.camera_position.xyz - in.world);
    let halfway = normalize(toward_light + toward_eye);

    let lambert = max(dot(facing, toward_light), 0.0);
    let rough = clamp(object.surface.x, 0.05, 1.0);
    let tightness = 2.0 / (rough * rough) - 2.0;
    // Scaled by how much light reaches the surface at all, and kept small.
    // Without the first, a face turned away from the light still catches a
    // highlight; without the second, the lobe carries as much energy as the
    // whole rest of the shading, and a large flat face lying along it comes
    // out white. Both show up on a loaded model long before they show up on a
    // field of spheres.
    let highlight = pow(max(dot(facing, halfway), 0.0), tightness)
        * (1.0 - rough) * lambert * 0.3;

    let strength = frame.light_color.w;
    let lit = object.base_color.rgb
        * (frame.ambient.rgb + frame.light_color.rgb * strength * lambert)
        + frame.light_color.rgb * strength * highlight;
    return vec4<f32>(lit, object.base_color.a);
}
"

// One pass over everything. Both bindings are set here and neither is built
// here: what a pass does is record, and what it records was decided before it
// ran. The encoder comes from the graph, which made the targets this draws
// into and chose their load ops from what the pass declared.
draw_scene :: fn(pass: RenderPassEncoder, state: ^u8) {
    mut s := unsafe { ptr_cast($Scene, state) }
    render_pass_encoder_set_pipeline(pass, unsafe { s^.pipeline })
    render_pass_encoder_set_bind_group(pass, 0, unsafe { s^.frame_group }, 0,
        no_pointer())

    list := unsafe { s^.list^ }
    mut index : i64 = 0
    while (index < draw_list_count(list)) {
        one := draw_list_at(list, index)
        render_pass_encoder_set_bind_group(pass, 1, one.binding, 0,
            no_pointer())
        mesh_bind(pass, one.geometry)
        render_pass_encoder_draw_indexed(pass, one.geometry.index_count, 1, 0,
            0, 0)
        index = index + 1
    }
}

// The camera and the light, as the bytes the shader reads them as.
write_frame :: fn(queue: Queue, uniform: Buffer, eye: Camera, w: i64, h: i64) {
    mut values : [FRAME_FLOATS]f32 = [0.0; FRAME_FLOATS]
    mut view_projection := camera_view_projection(eye, w, h)
    mut element : i64 = 0
    while (element < 16) {
        values[element] = view_projection.m[element]
        element = element + 1
    }
    at := camera_position(eye)
    values[16] = at.x
    values[17] = at.y
    values[18] = at.z
    values[19] = 1.0
    values[20] = -0.4
    values[21] = -1.0
    values[22] = -0.5
    values[23] = 0.0
    values[24] = 1.0
    values[25] = 0.97
    values[26] = 0.9
    // Softer than the lit demos next door, because the colours in the file are
    // an exporter's rather than ones picked to sit under a bright light: at
    // their strength these wash to white and the model reads as untextured
    // geometry rather than as three materials.
    values[27] = 1.0
    values[28] = 0.18
    values[29] = 0.2
    values[30] = 0.24
    values[31] = 1.0
    queue_write_buffer(queue, uniform, 0,
        ptr_to(values[0]), FRAME_BYTES)
}

uniform_layout :: fn(device: Device, size: i64) -> BindGroupLayout {
    mut entry := bind_group_layout_entry_init()
    entry.binding = 0
    entry.visibility = ShaderStage::Vertex | ShaderStage::Fragment
    entry.buffer.type = BUFFER_BINDING_TYPE_UNIFORM
    entry.buffer.min_binding_size = size
    mut descriptor := bind_group_layout_descriptor_init()
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group_layout(device, ptr_to(descriptor))
}

uniform_buffer :: fn(device: Device, size: i64) -> Buffer {
    mut descriptor := buffer_descriptor_init()
    descriptor.usage = BufferUsage::Uniform | BufferUsage::CopyDst
    descriptor.size = size
    device_create_buffer(device, ptr_to(descriptor))
}

uniform_group :: fn(device: Device, layout: BindGroupLayout, held: Buffer,
    size: i64) -> BindGroup {
    mut entry := bind_group_entry_init()
    entry.binding = 0
    entry.buffer = held
    entry.size = size
    mut descriptor := bind_group_descriptor_init()
    descriptor.layout = layout
    descriptor.entries_count = 1
    descriptor.entries = ptr_to(entry)
    device_create_bind_group(device, ptr_to(descriptor))
}

make_pipeline :: fn(device: Device, format: u32,
    layout: PipelineLayout) -> RenderPipeline {
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }
    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = ptr_to(wgsl)
    shader := device_create_shader_module(device, ptr_to(module_descriptor))

    mut attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X3
    attributes[0].offset = POSITION_OFFSET
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X3
    attributes[1].offset = NORMAL_OFFSET
    attributes[1].shader_location = 1

    mut buffer_layout := vertex_buffer_layout_init()
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = ptr_to(attributes[0])

    mut target := color_target_state_init()
    target.format = format
    target.write_mask = ColorWriteMask::All

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = ptr_to(target)

    mut depth := depth_stencil_state_init()
    depth.format = DEPTH_FORMAT
    depth.depth_write_enabled = OPTIONAL_BOOL_TRUE
    depth.depth_compare = COMPARE_FUNCTION_LESS

    mut descriptor := render_pipeline_descriptor_init()
    descriptor.layout = layout
    descriptor.vertex.module = shader
    descriptor.vertex.entry_point = StringView { data = "vs_main", length = 7 }
    descriptor.vertex.buffers_count = 1
    descriptor.vertex.buffers = ptr_to(buffer_layout)
    descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    descriptor.primitive.front_face = FRONT_FACE_CCW
    // Backs are thrown away, which is what the winding is for and what makes a
    // closed shape cost half of what it looks like it costs.
    descriptor.primitive.cull_mode = CULL_MODE_BACK
    descriptor.multisample.count = 1
    descriptor.multisample.mask = 4294967295
    descriptor.depth_stencil = ptr_to(depth)
    descriptor.fragment = ptr_to(fragment)
    device_create_render_pipeline(device, ptr_to(descriptor))
}

main :: fn() -> i64 {
    mut p := platform_open("Frost glTF", WIDTH, HEIGHT)
    if (platform_ok(p) == false) {
        print_str_line("no window")
        print_str_line(platform_error())
        return 1
    }
    mut r := renderer_open(platform_window(p), WIDTH, HEIGHT)
    if (renderer_ok(r) == false) {
        print_str_line("no device")
        platform_close(p)
        return 2
    }
    device := renderer_device(r)
    queue := renderer_queue(r)

    // Empty. What goes in them is whatever the file turns out to hold.
    mut cache := mesh_cache_new(MAX_DRAWN)
    mut registry := materials_new(MAX_DRAWN)

    frame_layout := uniform_layout(device, FRAME_BYTES)
    object_layout := uniform_layout(device, OBJECT_BYTES)
    mut layouts : [2]BindGroupLayout = [frame_layout, object_layout]
    mut pipeline_layout_descriptor := pipeline_layout_descriptor_init()
    pipeline_layout_descriptor.bind_group_layouts_count = 2
    pipeline_layout_descriptor.bind_group_layouts = ptr_to(layouts[0])
    pipeline_layout := device_create_pipeline_layout(device,
        ptr_to(pipeline_layout_descriptor))

    frame_uniform := uniform_buffer(device, FRAME_BYTES)
    frame_group := uniform_group(device, frame_layout, frame_uniform,
        FRAME_BYTES)

    mut world := ecs_new()
    ids := world_prepare(world)
    model := ids.model
    drawn := ids.drawn

    mut slot_table := slot_table_new(MAX_DRAWN, object_layout)
    mut list := draw_list_new(MAX_DRAWN)
    mut frame_schedule := world_schedule()

    // The whole of what this demo has to say about what is drawn. The path is
    // from the root of the checkout, which is where `just gltf` runs it.
    mut held := gltf_read(MODEL)
    loaded := gltf_ok(held)
    root := gltf_spawn(world, held, device, queue, registry, cache, ids)
    gltf_free(held)
    if (loaded == false) {
        print_str_line("no model at:")
        print_str_line(MODEL)
        print_str_line("run this from the root of the checkout, or `just gltf`")
    } else {
        // The model turns as one thing. Its own tree is untouched: this is a
        // spin on the entity everything the file spawned hangs off.
        ecs_set($Spin, world, root, ids.spin, Spin {
            axis = vec3(0.0, 1.0, 0.0), speed = 0.4, angle = 0.0 })
    }

    mut scene := Scene {
        pipeline = make_pipeline(device, renderer_format(r), pipeline_layout),
        frame_group = frame_group,
        list = ptr_to(list),
    }
    mut graph := graph_new(device, 2, 1)
    screen := graph_backbuffer(graph)
    depth := graph_depth(graph, "depth", WINDOW_SIZED, WINDOW_SIZED,
        DEPTH_FORMAT)
    scene_pass := graph_pass(graph, "scene", draw_scene, ptr_to(scene))
    graph_writes_color(graph, scene_pass, screen,
        Color { r = 0.05, g = 0.06, b = 0.09, a = 1.0 })
    graph_writes_depth(graph, scene_pass, depth)
    scheduled := graph_schedule(graph)
    if (scheduled == false) {
        print_str_line("the render graph cannot run")
    }
    graph_resize(graph, WIDTH, HEIGHT)

    mut eye := camera_default()
    eye.position = vec3(0.0, 2.0, 7.0)
    eye.pitch = -0.2
    world_camera_set(world, eye)

    while (scheduled && platform_poll(p)) {
        if (key_pressed(p, KEY_ESCAPE)) {
            break
        }
        if (resized(p)) {
            renderer_resize(r, width(p), height(p))
            graph_resize(graph, width(p), height(p))
        }
        world_input(world, platform_input(p))
        schedule_run(frame_schedule, world, ANY_STATE)
        write_frame(queue, frame_uniform, world_camera(world), width(p),
            height(p))
        scene_sync(world, list, slot_table, device, queue, registry, cache,
            all_drawn(model, drawn))

        mut f := renderer_begin(r)
        if (frame_ok(f)) {
            graph_run(graph, f)
        }
        renderer_end(r, f)
    }

    graph_free(graph)
    draw_list_free(list)
    slot_table_free(slot_table)
    schedule_free(frame_schedule)
    giving := ecs_resource($Hierarchy, world, TREE_SLOT)
    hierarchy_free(giving)
    materials_free(registry)
    mesh_cache_free(cache)
    ecs_free(world)
    renderer_close(r)
    platform_close(p)
    0
}
