// The walk from a world to what a pass draws.
//
//     scene_sync(world, list, table, device, queue, ids)
//     ...
//     draw_list(pass, list)
//
// A pass records commands and a world holds game state, and nothing should be
// both. This is the one place they meet: it queries the world for everything
// that has ended up somewhere and is drawn, gives each one a uniform buffer and
// a binding, writes the matrix and the material into that buffer, and leaves a
// flat run of draw items behind. The pass walks the run and knows nothing about
// entities, components or tables.
//
// What that buys over a pass reading the world directly is where the numbers
// come from. A binding belongs to an entity rather than to a position in an
// array the program sized up front, so a thing spawned while the program runs
// is drawn on the next frame with no table to resize and nothing to renumber.
// The renderer stops knowing how many things there are.

import "wgpu.frost"
import "renderer.frost"
import "mesh.frost"
import "material.frost"
import "ecs.frost"
import "math.frost"
import "mem.frost"

export Drawable, DrawList, SlotTable, ObjectIds,
    Placement, Spin, Drawn, Model, WorldIds,
    draw_list_new, draw_list_free, draw_list_count, draw_list_at,
    draw_list_group_by_material,
    slot_table_new, slot_table_free,
    world_prepare, world_step, world_tree, world_schedule,
    all_drawn, drawn_in_layer,
    scene_sync, OBJECT_BYTES, ONE_LAYER, WORLD_SLOT, TREE_SLOT

// One thing's own: its model matrix, its colour, and the two numbers that say
// how the surface behaves, with the fourth of those carrying which entry of a
// per-object run belongs to it.
OBJECT_FLOATS :: 24
OBJECT_BYTES :: 96

// One thing to draw, as the pass wants it: what to bind, what geometry, and
// which material it wears. Which slot of a per-object run belongs to it is
// written into the uniform rather than carried here, since the shader is what
// reads it.
//
// The material is a number rather than a binding, because what a material
// means to a pass is the pass's own business: one binds a texture for it and
// another reads only the colour already in the uniform. What this says is which
// one, and whether it changed since the last item.
Drawable :: struct {
    binding: BindGroup,
    geometry: Mesh,
    material: i64,
}

// What one frame produced. Filled from nothing every frame, because what is in
// the world is the answer and last frame's list is not.
DrawList :: struct {
    items: []Drawable,
    count: i64,
}

// A uniform buffer and its binding, and which entity they belong to. Kept
// across frames: a buffer is made once for an entity and written every frame,
// so a frame costs writes rather than allocations.
Slot :: struct {
    entity: Entity,
    uniform: Buffer,
    binding: BindGroup,
    used: bool,
}

SlotTable :: struct {
    slots: []Slot,
    count: i64,
    layout: BindGroupLayout,
}

// Which component is which, and which layer this run is for, since a system
// reaches a component by number and the numbers belong to the world that
// registered them.
//
// A layer of -1 takes everything. Two passes over different halves of a world
// are two runs built from two layers, so each pass is handed a run holding only
// what it draws: which things those are is decided here, once a frame, rather
// than in a pass on every item it records.
ObjectIds :: struct {
    model: i64,
    drawn: i64,
    layer: i64,
}

// Everything that is drawn, whatever layer it is in.
all_drawn :: fn(model: i64, drawn: i64) -> ObjectIds {
    ObjectIds { model = model, drawn = drawn, layer = -1 }
}

// One layer of what is drawn, for a program whose passes divide the world.
drawn_in_layer :: fn(model: i64, drawn: i64, layer: i64) -> ObjectIds {
    ObjectIds { model = model, drawn = drawn, layer = layer }
}

draw_list_new :: fn(room: i64) -> DrawList {
    DrawList { items = heap_slice($Drawable, room), count = 0 }
}

draw_list_free :: fn(mut list: DrawList) {
    heap_release_slice($Drawable, list.items)
    list.count = 0
}

draw_list_count :: fn(list: DrawList) -> i64 { list.count }

draw_list_at :: fn(list: DrawList, index: i64) -> Drawable {
    held := list.items
    held[index]
}

slot_table_new :: fn(room: i64, layout: BindGroupLayout) -> SlotTable {
    SlotTable { slots = heap_slice($Slot, room), count = 0, layout = layout }
}

slot_table_free :: fn(mut table: SlotTable) {
    mut held := table.slots
    mut i : i64 = 0
    while (i < table.count) {
        if (held[i].used) {
            bind_group_release(held[i].binding)
            buffer_destroy(held[i].uniform)
            buffer_release(held[i].uniform)
            held[i].used = false
        }
        i = i + 1
    }
    heap_release_slice($Slot, table.slots)
    table.count = 0
}

// The slot an entity already has, or a new one. An entity is matched by both
// halves of its handle, so a slot left behind by a despawn is not handed to
// whatever took the id: it stays until the table is released, and the new
// entity gets a slot of its own.
slot_for :: fn(mut table: SlotTable, device: Device, entity: Entity) -> i64 {
    mut held := table.slots
    mut i : i64 = 0
    while (i < table.count) {
        one := held[i]
        if (one.used && one.entity.id == entity.id
            && one.entity.generation == entity.generation) {
            return i
        }
        i = i + 1
    }
    made := table.count
    if (made >= slice_len(table.slots)) {
        print "scene: more things to draw than the slot table was made room for"
        return -1
    }
    mut descriptor := buffer_descriptor_init()
    descriptor.usage = BufferUsage::Uniform | BufferUsage::CopyDst
    descriptor.size = OBJECT_BYTES
    uniform := device_create_buffer(device, ptr_to(descriptor))

    mut entry := bind_group_entry_init()
    entry.binding = 0
    entry.buffer = uniform
    entry.size = OBJECT_BYTES
    mut group_descriptor := bind_group_descriptor_init()
    group_descriptor.layout = table.layout
    group_descriptor.entries_count = 1
    group_descriptor.entries = ptr_to(entry)

    held[made] = Slot { entity = entity, uniform = uniform,
        binding = device_create_bind_group(device, ptr_to(group_descriptor)),
        used = true }
    table.count = made + 1
    made
}

// Everything the world says is drawn, written into buffers and left as a run
// of draw items. The list is emptied first: what is in the world now is the
// answer, and a thing despawned since the last frame should stop being drawn
// without anything having to say so.
scene_sync :: fn(mut world: World, mut list: DrawList, mut table: SlotTable,
    device: Device, queue: Queue, registry: Materials, cache: MeshCache,
    ids: ObjectIds) {
    list.count = 0
    mut q := query_begin(world)
    query_with(q, ids.model)
    query_with(q, ids.drawn)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            shown := ecs_get($Drawn, world, entity, ids.drawn)
            if (ids.layer < 0 || shown.layer == ids.layer) {
                slot := slot_for(table, device, entity)
                if (slot < 0) {
                    return
                }
                model := ecs_get($Model, world, entity, ids.model).matrix
                write_object(queue, table, slot, model,
                    materials_at(registry, shown.material))
                push_drawable(list, table, slot,
                    mesh_cache_at(cache, shown.mesh), shown.material)
            }
            row = row + 1
        }
    }
}

// One thing's uniform, as the bytes the shader reads them as.
write_object :: fn(queue: Queue, mut table: SlotTable, slot: i64, model: Mat4,
    surface: Material) {
    mut values : [OBJECT_FLOATS]f32 = [0.0; OBJECT_FLOATS]
    mut element : i64 = 0
    while (element < 16) {
        values[element] = model.m[element]
        element = element + 1
    }
    colour := material_color(surface)
    values[16] = colour.x
    values[17] = colour.y
    values[18] = colour.z
    values[19] = colour.w
    behaviour := material_surface(surface)
    values[20] = behaviour.x
    values[21] = behaviour.y
    // Which entry of a per-object run belongs to this thing. Every thing is
    // drawn through its own binding and knows nothing else about the run, so
    // the index travels with it, in the component of the surface the lighting
    // does not read.
    which : f32 = slot
    values[22] = which
    values[23] = behaviour.w
    held := table.slots
    queue_write_buffer(queue, held[slot].uniform, 0, ptr_to(values[0]),
        OBJECT_BYTES)
}

// The run reordered so the things sharing a material sit together. A pass pays
// for a material once per run of them rather than once per thing, which is the
// whole reason a material is a number here. Insertion order is kept within a
// material, so what a pass draws over what does not move around under it.
//
// An insertion sort, because a run is already nearly grouped: the world hands
// things back an archetype at a time, and things sharing a material tend to
// share the rest of what they carry.
draw_list_group_by_material :: fn(mut list: DrawList) {
    mut items := list.items
    mut index : i64 = 1
    while (index < list.count) {
        held := items[index]
        mut at := index
        while (at > 0 && items[at - 1].material > held.material) {
            items[at] = items[at - 1]
            at = at - 1
        }
        items[at] = held
        index = index + 1
    }
}

push_drawable :: fn(mut list: DrawList, table: SlotTable, slot: i64,
    geometry: Mesh, material: i64) {
    if (list.count >= slice_len(list.items)) {
        print "scene: more things to draw than the list was made room for"
        return
    }
    held := table.slots
    mut items := list.items
    items[list.count] = Drawable { binding = held[slot].binding,
        geometry = geometry, material = material }
    list.count = list.count + 1
}

// Where a thing is and how big, how it turns, where it ended up, and what it is
// drawn as. Declared here because the systems below and the walk above are what
// read them; a program that wants other components on the same entity adds them
// without this knowing.
Placement :: struct { position: Vec3, scale: Vec3 }
Spin :: struct { axis: Vec3, speed: f32, angle: f32 }
Model :: struct { matrix: Mat4 }

// What a thing is drawn as, and which of a program's layers draws it. A program
// with one pass over everything gives every thing the same layer and never
// looks at it again.
Drawn :: struct { mesh: i64, material: i64, layer: i64 }

// What that one layer is called. A program dividing its world between passes
// numbers its own.
ONE_LAYER :: 0

// Which component is which, and how long the frame was. A system captures
// nothing, so this is what it reads to find its way around the world.
WorldIds :: struct {
    placement: i64,
    spin: i64,
    model: i64,
    drawn: i64,
    step: f32,
}

// Which resource slot holds what. Registered in this order by `world_prepare`,
// so a program never writes either number.
WORLD_SLOT :: 0
TREE_SLOT :: 1

// The components and resources every drawing program registers, in one call, so
// the two slot numbers above are true by construction. The tree starts empty:
// a program hangs whatever it wants off whatever it wants, and a thing attached
// to nothing is a root.
world_prepare :: fn(mut world: World) -> WorldIds {
    ids := WorldIds {
        placement = ecs_register($Placement, world),
        spin = ecs_register($Spin, world),
        model = ecs_register($Model, world),
        drawn = ecs_register($Drawn, world),
        step = 0.0,
    }
    ecs_resource_register($WorldIds, world)
    ecs_resource_register($Hierarchy, world)
    ecs_resource_set($WorldIds, world, WORLD_SLOT, ids)
    ecs_resource_set($Hierarchy, world, TREE_SLOT, hierarchy_new())
    // What the world holds, rather than the name that held it: setting a
    // resource hands it over, so this answers by asking.
    ecs_resource($WorldIds, world, WORLD_SLOT)
}

// How long this frame was, written where it lives. Handing the whole resource
// over again would move what is in it, and this is the one field that changes.
world_step :: fn(mut world: World, step: f32) {
    mut held := ecs_resource_slice($WorldIds, world, WORLD_SLOT)
    held[0].step = step
}

// The tree the world holds, for a program hanging one thing off another.
world_tree :: fn(mut world: World) -> ref Hierarchy {
    ecs_resource_ref($Hierarchy, world, TREE_SLOT)
}

// What a frame does to the world: every turn advanced, then where everything
// ended up. What comes of that is `scene_sync`, which needs a device and is
// therefore not a system.
world_schedule :: fn() -> Schedule {
    mut held := schedule_new()
    schedule_add(held, Stage::First, turn_things)
    schedule_add(held, Stage::Update, place_things)
    held
}

// Every turn advanced by the frame's step.
turn_things :: fn(mut world: World) {
    ids := ecs_resource($WorldIds, world, WORLD_SLOT)
    mut q := query_begin(world)
    query_with(q, ids.spin)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            mut turn := ecs_get($Spin, world, entity, ids.spin)
            turn.angle = turn.angle + turn.speed * ids.step
            ecs_set($Spin, world, entity, ids.spin, turn)
            row = row + 1
        }
    }
}

// Where everything ended up, walked down the tree from every root, so a thing
// is placed after whatever it hangs off however deep it hangs. A thing attached
// to nothing is a root and is placed against nothing.
place_things :: fn(mut world: World) {
    ids := ecs_resource($WorldIds, world, WORLD_SLOT)
    mut q := query_begin(world)
    query_with(q, ids.model)
    query_with(q, ids.placement)
    while (query_next(world, q)) {
        rows := query_entities(world, q)
        mut row : i64 = 0
        while (row < slice_len(rows)) {
            entity := rows[row]
            tree := ecs_resource_ref($Hierarchy, world, TREE_SLOT)
            if (is_no_entity(hierarchy_parent(tree, entity))) {
                place_subtree(world, ids.placement, ids.spin, ids.model,
                    entity, mat4_identity())
            }
            row = row + 1
        }
    }
}

// One thing and everything under it, each placed against what it hangs off.
place_subtree :: fn(mut world: World, placement: i64, spin: i64, model: i64,
    entity: Entity, above: Mat4) {
    ecs_set($Model, world, entity, model, Model {
        matrix = mat4_mul(above, local_of(world, placement, spin, entity)) })
    tree := ecs_resource_ref($Hierarchy, world, TREE_SLOT)
    mut child := hierarchy_first_child(tree, entity)
    while (is_no_entity(child) == false) {
        // Read before the walk goes down, since the tree is read again in
        // there and this is the last thing wanted from it here.
        following := hierarchy_next_sibling(tree, child)
        // Read back rather than carried, because a matrix written into a
        // component has been handed over and the name that held it does not
        // hold it for the next child.
        here := ecs_get($Model, world, entity, model)
        place_subtree(world, placement, spin, model, child, here.matrix)
        child = following
    }
}

// A thing's own placement, before anything above it is applied.
local_of :: fn(mut world: World, placement: i64, spin: i64,
    entity: Entity) -> Mat4 {
    place := ecs_get($Placement, world, entity, placement)
    turn := ecs_get($Spin, world, entity, spin)
    mat4_mul(mat4_translation(place.position),
        mat4_mul(quat_to_mat4(quat_from_axis_angle(turn.axis, turn.angle)),
            mat4_scale(place.scale)))
}
