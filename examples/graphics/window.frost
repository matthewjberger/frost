// A window, opened through SDL3 and pumped until it is closed.
//
//   just window
//
// Every line is ordinary Frost. The C library is reached through
// [sdl.frost](sdl.frost): the `extern` declarations live in the binding, a
// window is a type of its own rather than a bare pointer, and nothing here
// says `unsafe`.
//
// The source is the same on every platform, because SDL's C API is. Only the
// link flag differs, which is why the recipe is per-platform and this file is
// not. On Linux and macOS the library comes from the system (`-lSDL3`), and on
// Windows it is a path to SDL3.dll, which then has to sit beside the
// executable or on PATH when it runs.
//
// SDL3's event API is a polling loop rather than a callback. A C callback
// declared through an extern's parameter list must take its context first, so
// Win32's WNDPROC, which has no context parameter, cannot be declared that way.

import "../../lib/platform/sdl.frost"
import "io.frost"

main :: fn() -> i64 {
    if (sdl_init(InitFlags::Video) == false) {
        print_int_line(0)
        return 1
    }

    window := window_create("Frost", 960, 540, WindowFlags::Resizable)
    if (is_no_window(window)) {
        print_int_line(0)
        sdl_quit()
        return 2
    }
    print_int_line(1)

    mut running : bool = true
    while (running) {
        mut event := event_new()
        while (poll_event(event)) {
            if (event_kind(event) == EventKind::Quit) {
                running = false
            }
        }
        sdl_delay(16)
    }

    window_destroy(window)
    sdl_quit()
    0
}
