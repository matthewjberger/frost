// A window, opened through SDL3 and pumped until it is closed.
//
// Every line below the declarations is ordinary Frost. SDL is reached with
// `extern fn` and nothing else, so this is what binding any C library looks
// like: name the functions, give them the C types, and link the library with
// `--libs`.
//
//   just window
//
// The source is the same on every platform, because SDL's C API is. Only the
// link flag differs, which is why the recipe is per-platform and this file is
// not. On Linux and macOS the library comes from the system (`-lSDL3`), and on
// Windows it is a path to SDL3.dll, which then has to sit beside the
// executable or on PATH when it runs.
//
// SDL3's event API is a polling loop rather than a callback. A C callback
// declared through an extern's parameter list must take its context first, so
// Win32's WNDPROC, which has no context parameter, cannot be declared that
// way.

SDL_Init          :: extern fn(flags: u32) -> bool
SDL_Quit          :: extern fn()
SDL_CreateWindow  :: extern fn(title: ^i8, width: i32, height: i32,
    flags: u64) -> ^u8
SDL_DestroyWindow :: extern fn(window: ^u8)
// Takes the buffer as a raw pointer rather than as an `Event`. An aggregate
// handed to an `extern` is moved across the boundary, which is right for a
// value C takes ownership of and wrong for one it only fills in.
SDL_PollEvent     :: extern fn(event: ^u8) -> bool
SDL_Delay         :: extern fn(milliseconds: u32)

INIT_VIDEO :: 32

// SDL_Event is a union of every event kind. Frost has no unions, and it does
// not need one to carry it: the union is 128 bytes with the event kind in the
// first four, so the bytes are the type and the kind is read out of them.
EVENT_QUIT :: 256

Event :: struct { bytes: [128]u8 }

event_kind :: fn(e: Event) -> u32 {
    unsafe { ptr_cast($u32, ptr_to(e.bytes[0]))^ }
}

main :: fn() -> i64 {
    if (unsafe { SDL_Init(INIT_VIDEO) } == false) {
        print 0
        return 1
    }

    window := unsafe { SDL_CreateWindow("Frost", 960, 540, 0) }
    print 1

    mut running : bool = true
    while (running) {
        mut event : Event = Event { bytes = [0; 128] }
        while (unsafe { SDL_PollEvent(ptr_to(event.bytes[0])) }) {
            if (event_kind(event) == EVENT_QUIT) {
                running = false
            }
        }
        unsafe { SDL_Delay(16) }
    }

    unsafe { SDL_DestroyWindow(window) }
    unsafe { SDL_Quit() }
    0
}
