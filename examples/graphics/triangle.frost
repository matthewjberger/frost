// A spinning triangle, drawn with wgpu, in an SDL3 window.
//
//   just triangle
//
// The wgpu declarations come from `examples/graphics/wgpu.frost`, generated
// by `tools/wgpu_bindgen.frost` from the same webgpu.json that webgpu.h is
// generated from.
//
// A descriptor is passed as a pointer to a struct this program owns. A
// callback is passed as a struct holding a function pointer beside two
// userdata slots. A `value` parameter is passed as C passes a struct, which is
// what WGPUStringView needs.
//
// Three vertices go to the GPU in a buffer, and the model-view-projection
// matrix that turns them goes in a uniform rebuilt every frame. Both matrices
// and the vertex positions come from `std/math.frost`, so what the GPU is
// handed is what Frost computed rather than a table of constants.

// ---------------------------------------------------------------------------
// SDL3
// ---------------------------------------------------------------------------

SDL_Init                :: extern fn(flags: u32) -> bool
SDL_Quit                :: extern fn()
SDL_CreateWindow        :: extern fn(title: ^i8, width: i32, height: i32,
    flags: u64) -> ^u8
SDL_DestroyWindow       :: extern fn(window: ^u8)
SDL_PollEvent           :: extern fn(event: ^u8) -> bool
SDL_GetWindowProperties :: extern fn(window: ^u8) -> u32
SDL_GetPointerProperty  :: extern fn(properties: u32, name: ^i8,
    fallback: ^u8) -> ^u8
// Milliseconds since SDL started, which is what drives the rotation.
SDL_GetTicks            :: extern fn() -> u64

INIT_VIDEO :: 32
EVENT_QUIT :: 256
EVENT_SIZE :: 128

Event :: struct { bytes: [EVENT_SIZE]u8 }

event_kind :: fn(e: Event) -> u32 {
    unsafe { ptr_cast($u32, ptr_to(e.bytes[0]))^ }
}
// wgpu, from the generated bindings. `just bindgen` rebuilds wgpu.frost
// from webgpu.json, which is the same file webgpu.h is generated from.
import "wgpu.frost"
// Vectors and matrices. Found on the standard library search path, so this is
// the same `math.frost` every other example imports.
import "math.frost"

// ---------------------------------------------------------------------------
// Handing the adapter and the device back out of their callbacks
// ---------------------------------------------------------------------------

// wgpu answers asynchronously even when the answer is already known, so the
// callback writes what it was given into a slot this program owns and the
// caller pumps until the slot fills. `userdata1` is that slot's address.
Slot :: struct { handle: ^u8, ready: i64 }

// `value message: StringView` is what wgpu passes here: the struct itself, not
// a pointer to it. Windows hands a sixteen-byte struct to a callee as a pointer
// to a copy, so declaring it `^u8` worked there and would have read `userdata1`
// out of the wrong register on System V, where the struct takes two.
fill_slot :: fn(status: u32, handle: ^u8, value message: StringView,
    userdata1: ^u8, userdata2: ^u8) {
    slot := unsafe { ptr_cast($Slot, userdata1) }
    if (status == REQUEST_ADAPTER_STATUS_SUCCESS) {
        unsafe { slot^.handle = handle }
    }
    unsafe { slot^.ready = 1 }
}

// C's NULL. `ptr_cast` reinterprets an integer as an address, so the null
// pointer is the zero address and nothing in the language needs to know it is
// special. Reading through it is refused the same as any other raw pointer.
null :: fn() -> ^u8 {
    zero := 0
    unsafe { ptr_cast($u8, zero) }
}

// One vertex, laid out exactly as the shader's VertexInput reads it: a position
// and a colour, four floats each. The struct is what goes into the buffer, so
// the stride is its size and the second attribute starts at the size of the
// first.
Vertex :: struct { position: Vec4, colour: Vec4 }

VERTEX_COUNT  :: 3
VERTEX_STRIDE :: 32
VERTEX_BYTES  :: 96
UNIFORM_BYTES :: 64

// The shader. Positions and colours arrive in a vertex buffer, and the matrix
// that turns them arrives in a uniform, so both come from Frost rather than
// from a table written into the shader.
SHADER :: "
struct Uniform {
    mvp: mat4x4<f32>,
};

@group(0) @binding(0)
var<uniform> ubo: Uniform;

struct VertexIn {
    @location(0) position: vec4<f32>,
    @location(1) colour: vec4<f32>,
}

struct VertexOut {
    @builtin(position) position: vec4<f32>,
    @location(0) colour: vec4<f32>,
}

@vertex
fn vs_main(vertex: VertexIn) -> VertexOut {
    var out: VertexOut;
    out.position = ubo.mvp * vertex.position;
    out.colour = vertex.colour;
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    return in.colour;
}
"

WIDTH  :: 960
HEIGHT :: 540

main :: fn() -> i64 {
    if (unsafe { SDL_Init(INIT_VIDEO) } == false) {
        print 0
        return 1
    }
    window := unsafe { SDL_CreateWindow("Frost triangle", WIDTH, HEIGHT, 0) }

    properties := unsafe { SDL_GetWindowProperties(window) }
    hwnd := unsafe {
        SDL_GetPointerProperty(properties, "SDL.window.win32.hwnd",
            null())
    }

    instance := unsafe { wgpuCreateInstance(null()) }
    if (instance == null()) { return 21 }

    // The surface, chained off the platform window handle.
    mut source := surface_source_windows_HWND_init()
    source.chain.stype = S_TYPE_SURFACE_SOURCE_WINDOWS_HWND
    source.hwnd = hwnd

    mut surface_descriptor := surface_descriptor_init()
    surface_descriptor.next_in_chain = unsafe { ptr_cast($u8, ptr_to(source)) }
    surface := unsafe {
        wgpuInstanceCreateSurface(instance, ptr_to(surface_descriptor))
    }
    if (surface == null()) { return 22 }
    if (hwnd == null()) { return 23 }

    // The adapter.
    mut adapter_slot : Slot = Slot { handle = null(), ready = 0 }
    mut adapter_info : RequestAdapterCallbackInfo = RequestAdapterCallbackInfo {
        next_in_chain = null(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = fill_slot,
        userdata1 = unsafe { ptr_cast($u8, ptr_to(adapter_slot)) },
        userdata2 = null(),
    }
    // The adapter has to be chosen knowing which surface it will draw to, or
    // it may be one this surface cannot use, and the surface only says so when
    // it is asked for its capabilities.
    mut adapter_options := request_adapter_options_init()
    adapter_options.feature_level = FEATURE_LEVEL_CORE
    adapter_options.compatible_surface = surface
    unsafe {
        wgpuInstanceRequestAdapter(instance, ptr_to(adapter_options),
            ptr_to(adapter_info))
    }
    mut adapter_spins : i64 = 0
    while (adapter_slot.ready == 0 && adapter_spins < 2000000) {
        unsafe { wgpuInstanceProcessEvents(instance) }
        adapter_spins = adapter_spins + 1
    }
    if (adapter_slot.ready == 0) { return 11 }
    adapter := adapter_slot.handle
    if (adapter == null()) { return 24 }

    // The device.
    mut device_slot : Slot = Slot { handle = null(), ready = 0 }
    mut device_info : RequestDeviceCallbackInfo = RequestDeviceCallbackInfo {
        next_in_chain = null(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = fill_slot,
        userdata1 = unsafe { ptr_cast($u8, ptr_to(device_slot)) },
        userdata2 = null(),
    }
    unsafe {
        wgpuAdapterRequestDevice(adapter,
            null(), ptr_to(device_info))
    }
    mut device_spins : i64 = 0
    while (device_slot.ready == 0 && device_spins < 2000000) {
        unsafe { wgpuInstanceProcessEvents(instance) }
        device_spins = device_spins + 1
    }
    if (device_slot.ready == 0) { return 12 }
    device := device_slot.handle
    if (device == null()) { return 25 }
    queue := unsafe { wgpuDeviceGetQueue(device) }

    // The swapchain. The format comes from the surface rather than from a
    // guess, because which formats a surface accepts is a property of the
    // driver and the window, not of the API.
    mut capabilities := surface_capabilities_init()
    capability_status := unsafe {
        wgpuSurfaceGetCapabilities(surface, adapter, ptr_to(capabilities))
    }
    if (capability_status != 1) { return 30 }
    if (capabilities.formats_count == 0) { return 31 }
    surface_format := unsafe { ptr_cast($u32, capabilities.formats)^ }

    mut configuration := surface_configuration_init()
    configuration.device = device
    configuration.format = surface_format
    configuration.usage = TEXTURE_USAGE_RENDER_ATTACHMENT
    configuration.width = WIDTH
    configuration.height = HEIGHT
    configuration.present_mode = PRESENT_MODE_FIFO
    unsafe { wgpuSurfaceConfigure(surface, ptr_to(configuration)) }

    // The shader, chained off the module descriptor as WGSL source.
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }

    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = unsafe { ptr_cast($u8, ptr_to(wgsl)) }
    shader := unsafe {
        wgpuDeviceCreateShaderModule(device, ptr_to(module_descriptor))
    }

    // The three vertices, written once into a buffer the GPU reads. The
    // positions are what a Vec4 holds, so the bytes handed over are the bytes
    // Frost laid out.
    mut vertices : [VERTEX_COUNT]Vertex = [
        Vertex {
            position = vec4(0.0 - 1.0, 0.0 - 1.0, 0.0, 1.0),
            colour = vec4(1.0, 0.2, 0.2, 1.0),
        },
        Vertex {
            position = vec4(1.0, 0.0 - 1.0, 0.0, 1.0),
            colour = vec4(0.2, 1.0, 0.4, 1.0),
        },
        Vertex {
            position = vec4(0.0, 1.0, 0.0, 1.0),
            colour = vec4(0.3, 0.4, 1.0, 1.0),
        },
    ]

    mut vertex_buffer_descriptor := buffer_descriptor_init()
    vertex_buffer_descriptor.usage = BUFFER_USAGE_VERTEX | BUFFER_USAGE_COPY_DST
    vertex_buffer_descriptor.size = VERTEX_BYTES
    vertex_buffer := unsafe {
        wgpuDeviceCreateBuffer(device, ptr_to(vertex_buffer_descriptor))
    }
    unsafe {
        wgpuQueueWriteBuffer(queue, vertex_buffer, 0,
            ptr_cast($u8, ptr_to(vertices[0])), VERTEX_BYTES)
    }

    // The uniform holding the matrix, rewritten every frame.
    mut uniform_buffer_descriptor := buffer_descriptor_init()
    uniform_buffer_descriptor.usage =
        BUFFER_USAGE_UNIFORM | BUFFER_USAGE_COPY_DST
    uniform_buffer_descriptor.size = UNIFORM_BYTES
    uniform_buffer := unsafe {
        wgpuDeviceCreateBuffer(device, ptr_to(uniform_buffer_descriptor))
    }

    // What the shader may reach, and what it reaches there. The layout is the
    // promise, the group is the binding that keeps it.
    mut layout_entry := bind_group_layout_entry_init()
    layout_entry.binding = 0
    layout_entry.visibility = SHADER_STAGE_VERTEX
    layout_entry.buffer.type = BUFFER_BINDING_TYPE_UNIFORM
    layout_entry.buffer.min_binding_size = UNIFORM_BYTES

    mut group_layout_descriptor := bind_group_layout_descriptor_init()
    group_layout_descriptor.entries_count = 1
    group_layout_descriptor.entries = unsafe {
        ptr_cast($u8, ptr_to(layout_entry))
    }
    group_layout := unsafe {
        wgpuDeviceCreateBindGroupLayout(device, ptr_to(group_layout_descriptor))
    }

    mut group_entry := bind_group_entry_init()
    group_entry.binding = 0
    group_entry.buffer = uniform_buffer
    group_entry.size = UNIFORM_BYTES

    mut group_descriptor := bind_group_descriptor_init()
    group_descriptor.layout = group_layout
    group_descriptor.entries_count = 1
    group_descriptor.entries = unsafe { ptr_cast($u8, ptr_to(group_entry)) }
    bind_group := unsafe {
        wgpuDeviceCreateBindGroup(device, ptr_to(group_descriptor))
    }

    mut pipeline_layout_descriptor := pipeline_layout_descriptor_init()
    pipeline_layout_descriptor.bind_group_layouts_count = 1
    pipeline_layout_descriptor.bind_group_layouts = unsafe {
        ptr_cast($u8, ptr_to(group_layout))
    }
    pipeline_layout := unsafe {
        wgpuDeviceCreatePipelineLayout(device,
            ptr_to(pipeline_layout_descriptor))
    }

    // How the vertex buffer's bytes reach the shader's two inputs.
    mut attributes : [2]VertexAttribute = [vertex_attribute_init(); 2]
    attributes[0].format = VERTEX_FORMAT_FLOAT32X4
    attributes[0].offset = 0
    attributes[0].shader_location = 0
    attributes[1].format = VERTEX_FORMAT_FLOAT32X4
    attributes[1].offset = 16
    attributes[1].shader_location = 1

    mut buffer_layout := vertex_buffer_layout_init()
    buffer_layout.step_mode = VERTEX_STEP_MODE_VERTEX
    buffer_layout.array_stride = VERTEX_STRIDE
    buffer_layout.attributes_count = 2
    buffer_layout.attributes = unsafe { ptr_cast($u8, ptr_to(attributes[0])) }

    // The pipeline.
    mut target := color_target_state_init()
    target.format = surface_format

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = unsafe { ptr_cast($u8, ptr_to(target)) }
    mut pipeline_descriptor := render_pipeline_descriptor_init()
    pipeline_descriptor.layout = pipeline_layout
    pipeline_descriptor.vertex.module = shader
    pipeline_descriptor.vertex.entry_point =
        StringView { data = "vs_main", length = 7 }
    pipeline_descriptor.vertex.buffers_count = 1
    pipeline_descriptor.vertex.buffers = unsafe {
        ptr_cast($u8, ptr_to(buffer_layout))
    }
    pipeline_descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    pipeline_descriptor.multisample.count = 1
    pipeline_descriptor.multisample.mask = 4294967295
    pipeline_descriptor.fragment = ptr_to(fragment)

    pipeline := unsafe {
        wgpuDeviceCreateRenderPipeline(device, ptr_to(pipeline_descriptor))
    }

    // The camera does not move, so the two matrices in front of the model are
    // built once. WebGPU's clip space runs z from 0 to 1, not from -1 to 1, so
    // this is the zero-to-one projection.
    width : f32 = WIDTH
    height : f32 = HEIGHT
    projection := mat4_perspective_zo(radians(60.0), width / height, 0.1, 100.0)
    view := mat4_look_at(vec3(0.0, 0.0, 3.0), vec3(0.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0))
    view_projection := mat4_mul(projection, view)
    started := unsafe { SDL_GetTicks() }

    mut running : bool = true
    while (running) {
        mut event : Event = Event { bytes = [0; EVENT_SIZE] }
        while (unsafe { SDL_PollEvent(ptr_to(event.bytes[0])) }) {
            if (event_kind(event) == EVENT_QUIT) {
                running = false
            }
        }

        mut frame := surface_texture_init()
        unsafe { wgpuSurfaceGetCurrentTexture(surface, ptr_to(frame)) }
        // A surface goes stale when the window changes under it. Skipping the
        // frame is not enough, because nothing would ever make it fresh again
        // and the window would stay black for good, so it is reconfigured
        // before the frame is dropped.
        if (frame.status != SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_OPTIMAL
            && frame.status != SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_SUBOPTIMAL) {
            unsafe { wgpuSurfaceConfigure(surface, ptr_to(configuration)) }
        }
        if (frame.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_OPTIMAL
            || frame.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_SUBOPTIMAL) {
            // A third of a turn a second, from the clock rather than from a
            // frame count, so the speed does not follow the frame rate.
            // Wrapped before it becomes a float, so the value stays small
            // enough that single precision keeps every millisecond.
            elapsed := (unsafe { SDL_GetTicks() } - started) % 100000
            milliseconds : f32 = elapsed
            model := mat4_rotation_y(radians(120.0) * milliseconds / 1000.0)
            mut mvp := mat4_mul(view_projection, model)
            unsafe {
                wgpuQueueWriteBuffer(queue, uniform_buffer, 0,
                    ptr_cast($u8, ptr_to(mvp.m[0])), UNIFORM_BYTES)
            }

            texture_view := unsafe {
                wgpuTextureCreateView(frame.texture,
                    null())
            }
            encoder := unsafe {
                wgpuDeviceCreateCommandEncoder(device,
                    null())
            }

            mut attachment := render_pass_color_attachment_init()
            attachment.view = texture_view
            attachment.load_op = LOAD_OP_CLEAR
            attachment.store_op = STORE_OP_STORE
            attachment.clear_value =
                Color { r = 0.05, g = 0.05, b = 0.08, a = 1.0 }

            mut pass_descriptor := render_pass_descriptor_init()
            pass_descriptor.color_attachments_count = 1
            pass_descriptor.color_attachments =
                unsafe { ptr_cast($u8, ptr_to(attachment)) }

            pass := unsafe {
                wgpuCommandEncoderBeginRenderPass(encoder,
                    ptr_to(pass_descriptor))
            }
            unsafe {
                wgpuRenderPassEncoderSetPipeline(pass, pipeline)
                wgpuRenderPassEncoderSetBindGroup(pass, 0, bind_group, 0,
                    null())
                wgpuRenderPassEncoderSetVertexBuffer(pass, 0, vertex_buffer, 0,
                    VERTEX_BYTES)
                wgpuRenderPassEncoderDraw(pass, VERTEX_COUNT, 1, 0, 0)
                wgpuRenderPassEncoderEnd(pass)
            }

            mut command := unsafe {
                wgpuCommandEncoderFinish(encoder,
                    null())
            }
            unsafe {
                wgpuQueueSubmit(queue, 1, ptr_to(command))
                wgpuSurfacePresent(surface)
            }
        }
    }

    unsafe {
        SDL_DestroyWindow(window)
        SDL_Quit()
    }
    0
}
