// A triangle, drawn with wgpu, in an SDL3 window.
//
//   just triangle
//
// The wgpu declarations come from `examples/graphics/wgpu.frost`, generated
// by `tools/wgpu_bindgen.frost` from the same webgpu.json that webgpu.h is
// generated from.
//
// A descriptor is passed as a pointer to a struct this program owns. A
// callback is passed as a struct holding a function pointer beside two
// userdata slots.
//
// WGPUStringView is `{ pointer, length }` passed by value. A struct that size
// goes to a Windows x64 callee as a hidden pointer, so it is spelled `^u8`
// where it is a parameter, and written out as its two fields where it is a
// struct member. That spelling is correct here and would not be on System V,
// where the same struct arrives in two registers. Frost has no way to say
// "by value" to C, so this is the seam a real binding would have to close.

// ---------------------------------------------------------------------------
// SDL3
// ---------------------------------------------------------------------------

SDL_Init                :: extern fn(flags: u32) -> bool
SDL_Quit                :: extern fn()
SDL_CreateWindow        :: extern fn(title: ^i8, width: i32, height: i32,
    flags: u64) -> ^u8
SDL_DestroyWindow       :: extern fn(window: ^u8)
SDL_PollEvent           :: extern fn(event: ^u8) -> bool
SDL_GetWindowProperties :: extern fn(window: ^u8) -> u32
SDL_GetPointerProperty  :: extern fn(properties: u32, name: ^i8,
    fallback: ^u8) -> ^u8

INIT_VIDEO :: 32
EVENT_QUIT :: 256
EVENT_SIZE :: 128

Event :: struct { bytes: [EVENT_SIZE]u8 }

event_kind :: fn(e: Event) -> u32 {
    unsafe { ptr_cast($u32, ptr_to(e.bytes[0]))^ }
}
// wgpu, from the generated bindings. `just bindgen` rebuilds wgpu.frost
// from webgpu.json, which is the same file webgpu.h is generated from.
import "wgpu.frost"

// ---------------------------------------------------------------------------
// Handing the adapter and the device back out of their callbacks
// ---------------------------------------------------------------------------

// wgpu answers asynchronously even when the answer is already known, so the
// callback writes what it was given into a slot this program owns and the
// caller pumps until the slot fills. `userdata1` is that slot's address.
Slot :: struct { handle: ^u8, ready: i64 }

fill_slot :: fn(status: u32, handle: ^u8, message: ^u8, userdata1: ^u8,
    userdata2: ^u8) {
    unsafe {
        slot := ptr_cast($Slot, userdata1)
        if (status == REQUEST_ADAPTER_STATUS_SUCCESS) {
            slot^.handle = handle
        }
        slot^.ready = 1
    }
}

// C's NULL. `ptr_cast` reinterprets an integer as an address, so the null
// pointer is the zero address and nothing in the language needs to know it is
// special. Reading through it is refused the same as any other raw pointer.
null :: fn() -> ^u8 {
    zero := 0
    unsafe { ptr_cast($u8, zero) }
}

// The shader. Position and colour come from the vertex index, so the triangle
// needs no vertex buffer and no bind group.
SHADER :: "
struct VertexOut {
    @builtin(position) position: vec4<f32>,
    @location(0) colour: vec3<f32>,
}

@vertex
fn vs_main(@builtin(vertex_index) index: u32) -> VertexOut {
    var positions = array<vec2<f32>, 3>(
        vec2<f32>( 0.0,  0.5),
        vec2<f32>(-0.5, -0.5),
        vec2<f32>( 0.5, -0.5),
    );
    var colours = array<vec3<f32>, 3>(
        vec3<f32>(1.0, 0.2, 0.2),
        vec3<f32>(0.2, 1.0, 0.4),
        vec3<f32>(0.3, 0.4, 1.0),
    );
    var out: VertexOut;
    out.position = vec4<f32>(positions[index], 0.0, 1.0);
    out.colour = colours[index];
    return out;
}

@fragment
fn fs_main(in: VertexOut) -> @location(0) vec4<f32> {
    return vec4<f32>(in.colour, 1.0);
}
"

WIDTH  :: 960
HEIGHT :: 540

main :: fn() -> i64 {
    if (unsafe { SDL_Init(INIT_VIDEO) } == false) {
        print 0
        return 1
    }
    window := unsafe { SDL_CreateWindow("Frost triangle", WIDTH, HEIGHT, 0) }

    properties := unsafe { SDL_GetWindowProperties(window) }
    hwnd := unsafe {
        SDL_GetPointerProperty(properties, "SDL.window.win32.hwnd",
            null())
    }

    instance := unsafe { wgpuCreateInstance(null()) }
    if (instance == null()) { return 21 }

    // The surface, chained off the platform window handle.
    mut source := surface_source_windows_HWND_init()
    source.chain.stype = S_TYPE_SURFACE_SOURCE_WINDOWS_HWND
    source.hwnd = hwnd

    mut surface_descriptor := surface_descriptor_init()
    surface_descriptor.next_in_chain = unsafe { ptr_cast($u8, ptr_to(source)) }
    surface := unsafe {
        wgpuInstanceCreateSurface(instance, ptr_to(surface_descriptor))
    }
    if (surface == null()) { return 22 }
    if (hwnd == null()) { return 23 }

    // The adapter.
    mut adapter_slot : Slot = Slot { handle = null(), ready = 0 }
    mut adapter_info : RequestAdapterCallbackInfo = RequestAdapterCallbackInfo {
        next_in_chain = null(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = fill_slot,
        userdata1 = unsafe { ptr_cast($u8, ptr_to(adapter_slot)) },
        userdata2 = null(),
    }
    // The adapter has to be chosen knowing which surface it will draw to, or
    // it may be one this surface cannot use, and the surface only says so when
    // it is asked for its capabilities.
    mut adapter_options := request_adapter_options_init()
    adapter_options.feature_level = FEATURE_LEVEL_CORE
    adapter_options.compatible_surface = surface
    unsafe {
        wgpuInstanceRequestAdapter(instance, ptr_to(adapter_options),
            ptr_to(adapter_info))
    }
    mut adapter_spins : i64 = 0
    while (adapter_slot.ready == 0 && adapter_spins < 2000000) {
        unsafe { wgpuInstanceProcessEvents(instance) }
        adapter_spins = adapter_spins + 1
    }
    if (adapter_slot.ready == 0) { return 11 }
    adapter := adapter_slot.handle
    if (adapter == null()) { return 24 }

    // The device.
    mut device_slot : Slot = Slot { handle = null(), ready = 0 }
    mut device_info : RequestDeviceCallbackInfo = RequestDeviceCallbackInfo {
        next_in_chain = null(),
        mode = CALLBACK_MODE_ALLOW_PROCESS_EVENTS,
        callback = fill_slot,
        userdata1 = unsafe { ptr_cast($u8, ptr_to(device_slot)) },
        userdata2 = null(),
    }
    unsafe {
        wgpuAdapterRequestDevice(adapter,
            null(), ptr_to(device_info))
    }
    mut device_spins : i64 = 0
    while (device_slot.ready == 0 && device_spins < 2000000) {
        unsafe { wgpuInstanceProcessEvents(instance) }
        device_spins = device_spins + 1
    }
    if (device_slot.ready == 0) { return 12 }
    device := device_slot.handle
    if (device == null()) { return 25 }
    queue := unsafe { wgpuDeviceGetQueue(device) }

    // The swapchain. The format comes from the surface rather than from a
    // guess, because which formats a surface accepts is a property of the
    // driver and the window, not of the API.
    mut capabilities := surface_capabilities_init()
    capability_status := unsafe {
        wgpuSurfaceGetCapabilities(surface, adapter, ptr_to(capabilities))
    }
    if (capability_status != 1) { return 30 }
    if (capabilities.formats_count == 0) { return 31 }
    surface_format := unsafe { ptr_cast($u32, capabilities.formats)^ }

    mut configuration := surface_configuration_init()
    configuration.device = device
    configuration.format = surface_format
    configuration.usage = TEXTURE_USAGE_RENDER_ATTACHMENT
    configuration.width = WIDTH
    configuration.height = HEIGHT
    configuration.present_mode = PRESENT_MODE_FIFO
    unsafe { wgpuSurfaceConfigure(surface, ptr_to(configuration)) }

    // The shader, chained off the module descriptor as WGSL source.
    mut wgsl := shader_source_WGSL_init()
    wgsl.chain.stype = S_TYPE_SHADER_SOURCE_WGSL
    wgsl.code = StringView { data = SHADER, length = str_len(SHADER) }

    mut module_descriptor := shader_module_descriptor_init()
    module_descriptor.next_in_chain = unsafe { ptr_cast($u8, ptr_to(wgsl)) }
    shader := unsafe {
        wgpuDeviceCreateShaderModule(device, ptr_to(module_descriptor))
    }

    // The pipeline.
    mut target := color_target_state_init()
    target.format = surface_format

    mut fragment := fragment_state_init()
    fragment.module = shader
    fragment.entry_point = StringView { data = "fs_main", length = 7 }
    fragment.targets_count = 1
    fragment.targets = unsafe { ptr_cast($u8, ptr_to(target)) }
    mut pipeline_descriptor := render_pipeline_descriptor_init()
    pipeline_descriptor.vertex.module = shader
    pipeline_descriptor.vertex.entry_point =
        StringView { data = "vs_main", length = 7 }
    pipeline_descriptor.primitive.topology = PRIMITIVE_TOPOLOGY_TRIANGLE_LIST
    pipeline_descriptor.multisample.count = 1
    pipeline_descriptor.multisample.mask = 4294967295
    pipeline_descriptor.fragment = unsafe { ptr_to(fragment) }

    pipeline := unsafe {
        wgpuDeviceCreateRenderPipeline(device, ptr_to(pipeline_descriptor))
    }

    mut running : bool = true
    while (running) {
        mut event : Event = Event { bytes = [0; EVENT_SIZE] }
        while (unsafe { SDL_PollEvent(ptr_to(event.bytes[0])) }) {
            if (event_kind(event) == EVENT_QUIT) {
                running = false
            }
        }

        mut frame := surface_texture_init()
        unsafe { wgpuSurfaceGetCurrentTexture(surface, ptr_to(frame)) }
        // A surface goes stale when the window changes under it. Skipping the
        // frame is not enough, because nothing would ever make it fresh again
        // and the window would stay black for good, so it is reconfigured
        // before the frame is dropped.
        if (frame.status != SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_OPTIMAL
            && frame.status != SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_SUBOPTIMAL) {
            unsafe { wgpuSurfaceConfigure(surface, ptr_to(configuration)) }
        }
        if (frame.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_OPTIMAL
            || frame.status == SURFACE_GET_CURRENT_TEXTURE_STATUS_SUCCESS_SUBOPTIMAL) {
            view := unsafe {
                wgpuTextureCreateView(frame.texture,
                    null())
            }
            encoder := unsafe {
                wgpuDeviceCreateCommandEncoder(device,
                    null())
            }

            mut attachment := render_pass_color_attachment_init()
            attachment.view = view
            attachment.load_op = LOAD_OP_CLEAR
            attachment.store_op = STORE_OP_STORE
            attachment.clear_value =
                Color { r = 0.05, g = 0.05, b = 0.08, a = 1.0 }

            mut pass_descriptor := render_pass_descriptor_init()
            pass_descriptor.color_attachments_count = 1
            pass_descriptor.color_attachments =
                unsafe { ptr_cast($u8, ptr_to(attachment)) }

            pass := unsafe {
                wgpuCommandEncoderBeginRenderPass(encoder,
                    ptr_to(pass_descriptor))
            }
            unsafe { wgpuRenderPassEncoderSetPipeline(pass, pipeline) }
            unsafe { wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0) }
            unsafe { wgpuRenderPassEncoderEnd(pass) }

            mut command := unsafe {
                wgpuCommandEncoderFinish(encoder,
                    null())
            }
            unsafe { wgpuQueueSubmit(queue, 1, ptr_to(command)) }
            unsafe { wgpuSurfacePresent(surface) }
        }
    }

    unsafe { SDL_DestroyWindow(window) }
    unsafe { SDL_Quit() }
    0
}
