// The allocator interface, settled where it is named. An allocator is a
// compile-time argument: the function that takes memory, beside the state that
// memory comes from. Each `take(...)` folds to a direct call to the function
// the call named, so nothing is dispatched.
//
// The state keeps its own type rather than travelling as `^u8` beside a
// function that casts it back, which is what a table of function pointers
// costs: two `unsafe` blocks here were the cast out and the cast in, and
// neither is needed. Swapping the allocator is naming a different pair.

import "io.frost"

Bump :: struct {
    data: ^u8,
    cap: i64,
    offset: i64,
}

// The bump's take function matches the allocator shape, (state, size) -> ptr.
bump_take :: fn(mut state: Bump, size: i64) -> ^u8 {
    slot := unsafe { ptr_to(state.data[state.offset]) }
    state.offset = state.offset + size
    slot
}

alloc :: fn(
    $S: Type,
    $take: fn(mut S, i64) -> ^u8,
    mut state: S,
    size: i64
) -> ^u8 {
    take(state, size)
}

main :: fn() -> i64 {
    mut backing: [64]u8 = [0; 64]
    mut bump: Bump = Bump { data = ptr_to(backing[0]), cap = 64, offset = 0, }

    p := unsafe { ptr_cast($i64, alloc($bump_take, bump, 8)) }
    unsafe { p^ = 42 }
    q := unsafe { ptr_cast($i64, alloc($bump_take, bump, 8)) }
    unsafe { q^ = 7 }

    print("{}\n", unsafe { p^ }) // 42
    print("{}\n", unsafe { q^ }) // 7
    print("{}\n", unsafe { p^ } + unsafe { q^ }) // 49
    print("{}\n", bump.offset) // 16, two 8-byte allocations
    0
}
