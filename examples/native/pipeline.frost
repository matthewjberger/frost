import "io.frost"

double :: fn(x: i64) -> i64 { x * 2 }
negate :: fn(x: i64) -> i64 { -x }
square :: fn(x: i64) -> i64 { x * x }

// The step is a compile-time argument, so each `reduce` is one function with
// that step's body inside the loop: nothing is dispatched and nothing is loaded.
reduce :: fn($step: fn(i64) -> i64, data: [6]i64) -> i64 {
    mut total: i64 = 0
    for i in 0..6 {
        total = total + step(data[i])
    }
    total
}

main :: fn() -> i64 {
    values := [1, 2, 3, 4, 5, 6]

    print(
        "sum of doubles  = {}\nsum of negates  = {}\nsum of squares  = {}\n",
        reduce($double, values),
        reduce($negate, values),
        reduce($square, values)
    )

    defer print("done\n")
    0
}
