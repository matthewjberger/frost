// A small game world on the entity-component system: a component is plain data,
// entities holding the same set of them share a table, and a system walks that
// table's columns rather than chasing one entity at a time.
//
// An entity is an id and a generation, so a handle kept past a despawn names a
// generation the slot no longer has and every lookup refuses it.
//
// The ECS is the standard library one (std/ecs.frost), written in ordinary
// Frost.

import "io.frost"

import "ecs.frost"

Health :: struct { hp: i64 }
Threat :: struct { level: i64 }

show :: fn(flag: bool) { if (flag) { print_int_line(1) } else { print_int_line(0) } }

main :: fn() -> i64 {
    var world := ecs_new()
    health := ecs_register($Health, world)
    threat := ecs_register($Threat, world)

    hero := ecs_spawn(world)
    ecs_add($Health, world, hero, health, Health { hp = 100 })

    ogre := ecs_spawn(world)
    ecs_add($Health, world, ogre, health, Health { hp = 40 })
    ecs_add($Threat, world, ogre, threat, Threat { level = 7 })

    imp := ecs_spawn(world)
    ecs_add($Health, world, imp, health, Health { hp = 60 })
    ecs_add($Threat, world, imp, threat, Threat { level = 3 })

    // One pass over the threat column of every table that carries one. The
    // hero has no threat, so no table holding it is visited for him.
    var total: i64 = 0
    var walk := query_begin(world)
    query_with(walk, threat)
    while (query_next(world, walk)) {
        levels := query_column($Threat, world, walk, threat)
        var i: i64 = 0
        while (i < walk.count) {
            total = total + levels[i].level
            i = i + 1
        }
    }
    print_int_line(total) // 10

    wounded := ecs_get($Health, world, ogre, health)
    ecs_set($Health, world, ogre, health, Health { hp = wounded.hp - 15 })
    print_int_line(ecs_get($Health, world, ogre, health).hp) // 25

    // Despawning frees the id and bumps its generation, so the handle held here
    // stops naming anything.
    ecs_despawn(world, ogre)
    show(ecs_alive(world, ogre)) // 0
    show(ecs_alive(world, hero)) // 1
    print_int_line(ecs_count(world)) // 2

    ecs_free(world)
    0
}
