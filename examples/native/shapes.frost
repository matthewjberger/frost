import "io.frost"

Shape :: enum {
    Circle { radius: i64 },
    Rectangle { width: i64, height: i64 },
    Triangle { base: i64, height: i64 },
}

area :: fn(s: Shape) -> i64 {
    match s {
        case Shape::Circle { radius }: 3 * radius * radius
        case Shape::Rectangle { width, height }: width * height
        case Shape::Triangle { base, height }: base * height / 2
    }
}

main :: fn() -> i64 {
    c := Shape::Circle { radius = 5 }
    r := Shape::Rectangle { width = 4, height = 6 }
    t := Shape::Triangle { base = 8, height = 3 }

    print(
        "circle area    = {}\nrectangle area = {}\ntriangle area  = {}\n",
        area(c),
        area(r),
        area(t)
    )
    0
}
