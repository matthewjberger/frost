// The official tour of the language, as a program. The test suite compiles it
// and checks what it prints, so every claim in the comments holds.
//
//   frost examples/tour.frost

import "io.frost"
import "columns.frost"

Kind :: enum { Hero, Monster { damage: i64 } }
Entity :: struct { hp: i64, kind: Kind }

// `mut` borrows for the call and changes the caller's value. There is no `&`.
heal :: fn(mut e: Entity, amount: i64) {
    e.hp = e.hp + amount
}

// An unmarked parameter borrows to read. `match` reads the enum, binds the
// payload of the variant it took, and has to cover every one.
attack :: fn(e: Entity) -> i64 {
    match e.kind {
        case.Hero: 10
        case.Monster { damage }: damage
    }
}

// `for` walks a slice, an array or a `str` with no iterator to implement, and
// a return type list answers with two values without a tuple type behind them.
// Naming the values says which is which, and lets the `return` say it too.
tally :: fn(party: []Entity) -> (total: i64, strongest: i64) {
    var sum: i64 = 0
    var best: i64 = 0
    for held in party {
        hit := attack(held)
        sum = sum + hit
        if (hit > best) { best = hit }
    }
    return { total = sum, strongest = best }
}

// A `linear` value is consumed exactly once on every path out, or the program
// does not build. `move` is what consumes it, so forgetting to close a session
// is a compile error rather than a leak found later.
Session :: linear struct { id: i64 }

// One element of the columns container below.
Particle :: struct { x: i64 }

// A declaration may state its layout rather than take the one its fields
// imply. `packed struct` puts every field at the next byte, and `align(N)`
// after a field's type is what that field starts at a multiple of. Neither
// word is reserved: the `struct` after `packed` and the `(` after `align` are
// what mark them.
Header :: packed struct { magic: u32, kind: u8, length: u32 }
Block :: struct { flag: u8, weight: i64 align(16) }

// A call written where a compile-time value is read is run before the program
// is. Nothing marks the function: `round_up` is an ordinary one, and what says
// this call is worked out early is that a constant is.
round_up :: fn(value: i64, to: i64) -> i64 { (value + to - 1) / to * to }

LANES :: round_up(300, 64)

// A compile-time value may be a run of them, so a lookup table is decided
// before the program runs and a length may be read out of it. The index is
// checked where it is written.
STRIDES :: [4, 8, 16, 32]
WIDEST :: STRIDES[3]

// A fixed array of numbers is what a vector register holds, so the arithmetic
// operators are defined over one, once per lane. There is no vector type: this
// is the array the language already had.
mix :: fn(a: [4]f32, b: [4]f32) -> [4]f32 { a * b + a }

close :: fn(move s: Session) -> i64 {
    s.id
}

// `-> i64 ! Blocked` says how this can fail, and `?` hands a failure to the
// caller instead of checking it here. What comes back is an ordinary enum.
Blocked :: struct { at: i64 }

strike :: fn(e: Entity) -> i64 ! Blocked {
    if (e.hp <= 0) {
        return { at = e.hp }
    }
    attack(e)
}

// `errdefer` runs only where a failure leaves, which is what closes the session
// on the path the `?` takes. The other path consumes it as usual, and the
// checker knows the two are different paths rather than a double consumption.
round :: fn(e: Entity) -> i64 ! Blocked {
    s := Session { id = 3 }
    errdefer close(s)
    hit := strike(e) ?
    close(s)
    hit * 2
}

// The value it answered with, or the health that stopped it.
damage_of :: fn(e: Entity) -> i64 {
    match round(e) {
        case.Ok { value }: value
        case.Err { error }: error.at
    }
}

main :: fn() -> i64 {
    // A literal leaves out a type the context already carries and a variant
    // leaves out its enum. Every field is still named.
    var hero: Entity = { hp = 90, kind =.Hero }
    heal(hero, 10) // hero is borrowed and changed
    print("{}\n", hero.hp) // 100
    print("{}\n", attack(hero)) // 10

    print("{}\n", damage_of(hero)) // 20

    party: [3]Entity = [
        { hp = 100, kind =.Hero },
        { hp = 40, kind =.Monster { damage = 12 } },
        { hp = 25, kind =.Monster { damage = 30 } },
    ]
    total, strongest := tally(party)
    print("{}\n", total) // 52
    print("{}\n", strongest) // 30

    // `_` takes a value the caller has no use for. A call that can fail may not
    // be written as a statement, so this is also how an answer is meant to go
    // unread.
    _, best := tally(party)
    print("{}\n", best) // 30

    // A columns container stores each field of `Particle` in its own array, so
    // a pass over one field strides it rather than stepping over the rest.
    // `live_slots` walks the slots that hold an element, in slot order, and
    // never reaches one that was released.
    var swarm: columns<Particle, 8> = columns_new()
    columns_reset($Particle, $8, swarm)
    var made: [8]Handle<Particle> = [0; 8]
    var i: i64 = 0
    while (i < 8) {
        made[i] = columns_insert($Particle, $8, swarm, Particle { x = i })
        i = i + 1
    }
    assert(columns_release($Particle, $8, swarm, made[2]))
    var walked: i64 = 0
    for slot in live_slots(swarm) {
        walked = walked + swarm.x[slot]
    }
    print("{}\n", walked) // 26, the 0..7 that are still there without the 2

    // A handle carries which container it came from, so one from another pool
    // of the same shape is refused rather than read.
    var spare: columns<Particle, 8> = columns_new()
    columns_reset($Particle, $8, spare)
    print("{}\n", cast($i64, columns_alive($Particle, $8, spare, made[0]))) // 0

    // Nine bytes rather than twelve, and the widest field's request decides
    // the whole type.
    print("{}\n", sizeof(Header)) // 9
    print("{}\n", sizeof(Block)) // 32
    print("{}\n", LANES) // 320, worked out before this program ran
    print("{}\n", WIDEST) // 32, read out of a table the compiler holds

    left: [4]f32 = [1.0, 2.0, 3.0, 4.0]
    right: [4]f32 = [5.0, 6.0, 7.0, 8.0]
    lanes := mix(left, right) * 2.0
    print("{}\n", cast($i64, lanes[3])) // 72

    s := Session { id = 7 }
    print("{}\n", close(s)) // s cannot be named again
    0
}
