// A freestanding program: compile it with `frost --link --freestanding` and it
// links against no C standard library at all, only the operating system's own
// process-exit call. Everything it does, a static arena and pointer writes, is
// the language's own memory model with no runtime, so the safety checks trap
// instead of printing and the result comes back as the process exit code rather
// than through printf.
//
//   frost --link --freestanding -o prog examples/freestanding.frost
//   ./prog ; echo $?     # 42
//
// The resulting executable imports only the platform's exit function (ExitProcess
// on Windows, the exit syscall on Linux), nothing else. This is the payoff of a
// memory model that lives in the language: a fixed or static-arena Frost program
// reaches a libc-free target.

Arena :: struct($N: usize) {
    data: [N]u8,
    offset: i64,
}

// Reaching the byte is a checked index, so the address is inside the arena. What
// the block vouches for is the other half: that eight bytes starting there are
// an i64, which the offset stepping by `sizeof(i64)` is what makes true.
alloc_int :: fn(mut a: Arena<64>) -> ^i64 {
    slot := ptr_to(a.data[a.offset])
    a.offset = a.offset + sizeof(i64)
    unsafe { ptr_cast($i64, slot) }
}

main :: fn() -> i64 {
    mut arena : Arena<64> = Arena { data = [0; 64], offset = 0 }
    p := alloc_int(arena)
    q := alloc_int(arena)
    // Two distinct slots, eight bytes apart, both inside an arena that outlives
    // them. Writing and reading through a raw pointer is unchecked wherever it
    // is written, and this is the whole of what these vouch for.
    unsafe {
        p^ = 20
        q^ = 22
        p^ + q^             // 42, returned as the process exit code
    }
}
